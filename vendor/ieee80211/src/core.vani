// IEEE 802.11 management-frame build/parse and the WPA2-PSK/CCMP RSN
// Information Element -- the layer between "have a derived PMK" and
// "can start the 4-way handshake": a real access point won't accept
// EAPOL-Key frames from a station that hasn't first associated with
// it (Probe Request/Response, Open System Authentication, Association
// Request/Response, in that order). Deliberately does NOT include
// beacon parsing (Probe Response covers the same fields this package
// needs -- SSID, RSN IE -- without also needing to track a periodic
// broadcast), WEP/Shared-Key authentication (WPA2-PSK always uses Open
// System auth; the real "authentication" happens later, in the 4-way
// handshake itself), or any RF/USB transmit-receive plumbing (that's
// the RTL8188CU driver's own, separately-scoped job -- this package
// only builds/parses the BYTES of a frame, the same "pure wire format,
// no transport" scoping this project's own EAPOL-Key package already
// established).
//
// Field layouts (Frame Control bit assignments, frame type/subtype
// values, fixed-field order for Authentication/Association frames, the
// generic Element ID/Length/Value IE wrapper) verified directly against
// Linux's own `include/linux/ieee80211.h` (a Tier-1 reference: these
// are the exact structs `mac80211`/`cfg80211` build and parse for every
// real device Linux drives, not a derivation from prose alone). RSN IE
// field order and the WPA2-PSK/CCMP cipher-suite/AKM-suite byte values
// (00-0F-AC OUI, CCMP=4, PSK=2) verified against wpa_supplicant's own
// `src/common/wpa_common.h`/`wpa_ie.c`, cross-checked against
// Wireshark's own independent `packet-ieee80211.c` dissector tables.

const FC_STYPE_ASSOC_REQ: i64 = 0x0000;
const FC_STYPE_ASSOC_RESP: i64 = 0x0010;
const FC_STYPE_PROBE_REQ: i64 = 0x0040;
const FC_STYPE_PROBE_RESP: i64 = 0x0050;
const FC_STYPE_BEACON: i64 = 0x0080;
const FC_STYPE_AUTH: i64 = 0x00b0;
const FC_STYPE_DEAUTH: i64 = 0x00c0;

const EID_SSID: i64 = 0;
const EID_SUPP_RATES: i64 = 1;
const EID_EXT_SUPP_RATES: i64 = 50;
const EID_RSN: i64 = 48;

// This STA's own real rate capability (round 2026-11-22): the RTL8188CU
// firmware/MAC bring-up this project's own boot log confirms
// ("CCK+OFDM-enable") actually enables both CCK and OFDM, so this is
// the full 12-rate 802.11b/g set, not a CCK-only subset. Basic-rate
// flagging (bit 7, 0x80) matches the vendor driver's own documented
// mandatory set (rtw_wlan_util.c's UpdateBrateTbl: "1M, 2M, 5.5M, 11M,
// 6M, 12M, 24M are mandatory") -- those seven are Basic, the remaining
// five (9/18/36/48/54M) are supported but optional. Returns 12 (the
// count written).
fn sta_rate_capability(out: mut ref [u8; 12]) -> i64 {
  out[0] = 0x82 as u8;  // 1 Mbps CCK, Basic
  out[1] = 0x84 as u8;  // 2 Mbps CCK, Basic
  out[2] = 0x8b as u8;  // 5.5 Mbps CCK, Basic
  out[3] = 0x96 as u8;  // 11 Mbps CCK, Basic
  out[4] = 0x8c as u8;  // 6 Mbps OFDM, Basic
  out[5] = 0x12 as u8;  // 9 Mbps OFDM
  out[6] = 0x98 as u8;  // 12 Mbps OFDM, Basic
  out[7] = 0x24 as u8;  // 18 Mbps OFDM
  out[8] = 0xb0 as u8;  // 24 Mbps OFDM, Basic
  out[9] = 0x48 as u8;  // 36 Mbps OFDM
  out[10] = 0x60 as u8; // 48 Mbps OFDM
  out[11] = 0x6c as u8; // 54 Mbps OFDM
  return 12;
}

const WLAN_AUTH_OPEN: i64 = 0;
const WLAN_STATUS_SUCCESS: i64 = 0;

// A single canonical fixed-size buffer for anything RECEIVED (Probe
// Response, Authentication Response, Association Response) -- real
// 802.11 management frames this package cares about (a handful of
// small fixed fields plus a few short IEs) comfortably fit well within
// 256 bytes; anything larger is rejected as malformed by the bounds
// checks below rather than silently truncated.
const FRAME_BUF_LEN: i64 = 256;

fn zero6_bytes() -> [u8; 6] {
  return [0 as u8; 6];
}

fn zero32_bytes_80211() -> [u8; 32] {
  return [0 as u8; 32];
}

// The generic 802.11 MAC header (IEEE 802.11, Frame Control/Duration/
// Address1-3/Sequence Control) -- 24 bytes, no Address4 (management
// frames never set both ToDS and FromDS, the only case Address4 is
// used). All multi-byte fields are little-endian on the wire.
struct Mac80211Hdr { frame_control: i64, duration: i64, seq_ctrl: i64 }

fn mac_header_parse(buf: ref [u8; 256], addr1_out: mut ref [u8; 6], addr2_out: mut ref [u8; 6], addr3_out: mut ref [u8; 6]) -> Mac80211Hdr {
  let frame_control: i64 = (buf[0] as i64) | ((buf[1] as i64) << 8);
  let duration: i64 = (buf[2] as i64) | ((buf[3] as i64) << 8);
  let i: i64 = 0;
  while i < 6 {
    addr1_out[i] = buf[4 + i];
    addr2_out[i] = buf[10 + i];
    addr3_out[i] = buf[16 + i];
    i = i + 1;
  }
  let seq_ctrl: i64 = (buf[22] as i64) | ((buf[23] as i64) << 8);
  return Mac80211Hdr { frame_control: frame_control, duration: duration, seq_ctrl: seq_ctrl };
}

// Scans a generic Element-ID/Length/Value IE sequence (as found after
// any management frame's own fixed fields) for the first IE matching
// `target_eid`. Bounded by the caller-supplied `ies_len` -- an IE
// claiming a length that would run past that bound is treated as
// malformed and scanning stops (returns not-found) rather than reading
// out of the caller's own intended region.
struct IeFindResult { found: i64, data_off: i64, data_len: i64 }

fn ie_find(buf: ref [u8; 256], ies_off: i64, ies_len: i64, target_eid: i64) -> IeFindResult {
  let pos: i64 = ies_off;
  let end: i64 = ies_off + ies_len;
  while (pos + 2) <= end {
    let eid: i64 = buf[pos] as i64;
    let ie_data_len: i64 = buf[pos + 1] as i64;
    if (pos + 2 + ie_data_len) > end {
      return IeFindResult { found: 0, data_off: 0, data_len: 0 };
    }
    if eid == target_eid {
      return IeFindResult { found: 1, data_off: pos + 2, data_len: ie_data_len };
    }
    pos = pos + 2 + ie_data_len;
  }
  return IeFindResult { found: 0, data_off: 0, data_len: 0 };
}

// Builds the minimal, spec-compliant WPA2-PSK/CCMP RSN IE (Element ID
// 0x30/48): version 1, group cipher CCMP, exactly one pairwise cipher
// (CCMP), exactly one AKM (PSK), capabilities 0x0000, no PMKID list, no
// group management cipher (both optional trailing fields, only
// relevant to 802.11w/PMF -- confirmed omittable for a minimal WPA2-PSK
// IE by reading wpa_supplicant's own `wpa_gen_wpa_ie_rsn`, which only
// appends them conditionally). Fixed 22-byte output, matching a real
// worked example derived from these same confirmed constants:
// 30 14 01 00 00 0F AC 04 01 00 00 0F AC 04 01 00 00 0F AC 02 00 00.
fn rsn_ie_build_wpa2_psk_ccmp(out: mut ref [u8; 22]) -> i64 {
  out[0] = 0x30 as u8;
  out[1] = 20 as u8;
  out[2] = 0x01 as u8;
  out[3] = 0x00 as u8;
  out[4] = 0x00 as u8;
  out[5] = 0x0f as u8;
  out[6] = 0xac as u8;
  out[7] = 0x04 as u8;
  out[8] = 0x01 as u8;
  out[9] = 0x00 as u8;
  out[10] = 0x00 as u8;
  out[11] = 0x0f as u8;
  out[12] = 0xac as u8;
  out[13] = 0x04 as u8;
  out[14] = 0x01 as u8;
  out[15] = 0x00 as u8;
  out[16] = 0x00 as u8;
  out[17] = 0x0f as u8;
  out[18] = 0xac as u8;
  out[19] = 0x02 as u8;
  out[20] = 0x00 as u8;
  out[21] = 0x00 as u8;
  return 22;
}

// Checks whether an RSN IE (as located by ie_find -- `data_off`/
// `data_len` point at the IE's DATA, i.e. right after its own EID/
// Length bytes) advertises CCMP as its group cipher, CCMP among its
// pairwise ciphers, and PSK among its AKMs -- exactly the combination
// this package's own rsn_ie_build_wpa2_psk_ccmp produces, so a real AP
// advertising the same real-world-common configuration is recognized.
// Deliberately minimal: does not validate RSN Capabilities or any
// PMKID/group-management-cipher trailing fields (not needed to decide
// "can I join this network with a PSK", the only question this
// function answers). Bounds pairwise/AKM counts to 4 each -- both
// generous for any real AP and small enough to keep every array access
// provably within the 256-byte receive buffer.
fn rsn_ie_supports_wpa2_psk_ccmp(buf: ref [u8; 256], data_off: i64, data_len: i64) -> i64 {
  if data_len < 8 { return 0; }
  if !(buf[data_off + 2] == (0x00 as u8) && buf[data_off + 3] == (0x0f as u8) && buf[data_off + 4] == (0xac as u8) && buf[data_off + 5] == (0x04 as u8)) {
    return 0;
  }
  let pairwise_count: i64 = (buf[data_off + 6] as i64) | ((buf[data_off + 7] as i64) << 8);
  if pairwise_count < 1 { return 0; }
  if pairwise_count > 4 { return 0; }
  if data_len < (8 + pairwise_count * 4 + 2) { return 0; }

  let found_ccmp: i64 = 0;
  let i: i64 = 0;
  while i < pairwise_count {
    let p: i64 = data_off + 8 + i * 4;
    if buf[p] == (0x00 as u8) && buf[p + 1] == (0x0f as u8) && buf[p + 2] == (0xac as u8) && buf[p + 3] == (0x04 as u8) {
      found_ccmp = 1;
    }
    i = i + 1;
  }
  if found_ccmp == 0 { return 0; }

  let akm_count_off: i64 = data_off + 8 + pairwise_count * 4;
  let akm_count: i64 = (buf[akm_count_off] as i64) | ((buf[akm_count_off + 1] as i64) << 8);
  if akm_count < 1 { return 0; }
  if akm_count > 4 { return 0; }
  if data_len < ((akm_count_off - data_off) + 2 + akm_count * 4) { return 0; }

  let found_psk: i64 = 0;
  let akm_list_off: i64 = akm_count_off + 2;
  i = 0;
  while i < akm_count {
    let a: i64 = akm_list_off + i * 4;
    if buf[a] == (0x00 as u8) && buf[a + 1] == (0x0f as u8) && buf[a + 2] == (0xac as u8) && buf[a + 3] == (0x02 as u8) {
      found_psk = 1;
    }
    i = i + 1;
  }
  if found_psk == 0 { return 0; }

  return 1;
}

// Worst case: 24 (header) + 2+32 (SSID IE, max ssid_len) + 2+8
// (Supported Rates IE, 8 rates) + 2+4 (Extended Supported Rates IE,
// remaining 4 of this STA's own 12-rate set) = 74; 80 leaves margin.
const PROBE_REQ_MAX_LEN: i64 = 80;

// Builds a wildcard-BSSID Probe Request: Address1 (destination) and
// Address3 (BSSID) both the broadcast address, Address2 (source) the
// station's own MAC -- the standard way to actively scan for any AP on
// the current channel rather than a specific already-known one.
// Contains the SSID IE (the network being searched for) and this
// station's own real, full Supported Rates capability (sta_rate_
// capability -- round 2026-11-22: this used to be hardcoded to just
// the 4 legacy-802.11b CCK rates, omitting the OFDM rates this
// project's own RTL8188CU bring-up log confirms are actually enabled
// ("CCK+OFDM-enable"); a Probe Request is sent before the AP is known,
// so per spec this must be the STA's own full capability, not anything
// AP-dependent), split into a base Supported Rates IE (first 8) plus
// an Extended Supported Rates IE (the remaining 4) when it exceeds 8,
// matching the real vendor driver's own issue_probereq/issue_assocreq
// convention. Returns the actual frame length used.
//
// BUG FOUND 2026-11-21 (real-HW investigation: Auth/Probe Requests
// transmit cleanly at the USB/chip level -- XFERCOMPL, TXPAUSE=0,
// MACTXEN=1, EFUSE-derived TX power and PA bias both confirmed correct
// -- yet the AP never answers either, while its own Beacons are heard
// fine). Cross-checked the rtl92cu TX descriptor's own sequence-number
// field against Linux's real rtl92cu_tx_fill_desc (trx.c): it COPIES
// the Sequence Control value already sitting in the caller's own frame
// header into the descriptor (`seq_number = (hdr->seq_ctrl &
// IEEE80211_SCTL_SEQ) >> 4`) -- it does not generate one and insert it
// into the frame. The only hardware auto-insert path (HWSEQ_EN) is
// gated on firmware leisure power-save, never taken by this driver.
// This function (and auth_request_build/assoc_request_build, same
// bug) has hardcoded Sequence Control to 0x0000 in the actual frame
// bytes on every call, forever -- a spec violation (IEEE 802.11
// 9.3.2.10/9.4.1.42: Sequence Control must be a real, incrementing
// per-frame value) with a concrete, mechanistic failure path: this
// project's own own_mac is fixed (not EFUSE-derived), so every single
// management frame this driver has EVER transmitted, across this
// entire investigation's many repeated `wifi join` attempts, carried
// the IDENTICAL (source MAC, Sequence Control) tuple. A real AP's own
// duplicate-frame cache (802.11 duplicate detection keys on exactly
// (Address2, Sequence Control, Fragment Number), independent of
// association state) would silently drop every attempt after the
// first one it ever saw from this signature as a perceived
// retransmission -- consistent with the project's own live capture
// (3 consecutive `wifi join` attempts in one session, same failure
// every time) and with a real usbmon capture of a genuinely working
// Linux client on this exact AP sending its Probe Request ~24 times
// with real incrementing sequence numbers before falling back to
// Authentication, which succeeded immediately. Threading the exact
// same seq_num already passed to the TX descriptor (rtl8188cu_tx_
// frame's own seq_num parameter, kernel_main.vani) into the frame
// body too, so the descriptor and the real over-the-air bytes finally
// agree, matching a real client's own behavior instead of silently
// repeating the first frame's identity forever.
fn probe_request_build(own_mac: ref [u8; 6], ssid: ref [u8; 32], ssid_len: i64, seq_num: i64, out: mut ref [u8; 80]) -> i64 {
  let broadcast: [u8; 6] = [0xff as u8; 6];
  out[0] = (FC_STYPE_PROBE_REQ & (255 as i64)) as u8;
  out[1] = ((FC_STYPE_PROBE_REQ >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = broadcast[i];
    out[10 + i] = own_mac[i];
    out[16 + i] = broadcast[i];
    i = i + 1;
  }
  let seq_ctrl: i64 = (seq_num & 0xfff) << 4;
  out[22] = (seq_ctrl & (255 as i64)) as u8;
  out[23] = ((seq_ctrl >> 8) & (255 as i64)) as u8;

  let off: i64 = 24;
  out[off] = EID_SSID as u8;
  out[off + 1] = ssid_len as u8;
  i = 0;
  while i < ssid_len {
    out[off + 2 + i] = ssid[i];
    i = i + 1;
  }
  off = off + 2 + ssid_len;

  let sta_rates: [u8; 12] = [0 as u8; 12];
  let sta_rates_len: i64 = sta_rate_capability(mut ref sta_rates);
  let base_len: i64 = if sta_rates_len > 8 { 8 } else { sta_rates_len };
  out[off] = EID_SUPP_RATES as u8;
  out[off + 1] = base_len as u8;
  i = 0;
  while i < base_len {
    out[off + 2 + i] = sta_rates[i];
    i = i + 1;
  }
  off = off + 2 + base_len;

  if sta_rates_len > 8 {
    let ext_len: i64 = sta_rates_len - 8;
    out[off] = EID_EXT_SUPP_RATES as u8;
    out[off + 1] = ext_len as u8;
    i = 0;
    while i < ext_len {
      out[off + 2 + i] = sta_rates[8 + i];
      i = i + 1;
    }
    off = off + 2 + ext_len;
  }

  return off;
}

struct ProbeRespInfo { ok: i64, ssid_len: i64, has_rsn: i64, cap_info: i64, rates_len: i64 }

// Parses a Probe Response: fixed fields are Timestamp (8 bytes),
// Beacon Interval (2 bytes), Capability Information (2 bytes) --
// 12 bytes total, immediately after the 24-byte MAC header, before any
// IEs begin. Extracts the SSID (so the caller can confirm this is
// really the network it asked for, not a same-channel neighbor),
// whether a WPA2-PSK/CCMP-compatible RSN IE is present, the AP's own
// raw Capability Information value, and the AP's own raw Supported
// Rates (+ Extended Supported Rates, concatenated) bytes.
//
// Round 2026-11-22: both cap_info and the rate bytes exist because
// assoc_request_build must not invent either one. Ground-truthed
// against the real vendor driver (rtw_mlme_ext.c's issue_assocreq):
// Capability Information is copied verbatim from the AP's own IEs
// (`_rtw_memcpy(pframe, rtw_get_capability_from_ie(...), 2)`), not
// built from a hardcoded STA-side value -- a real AP in this
// project's own testing rejected association with status code 19
// ("does not support short preamble") when the STA's assoc request
// didn't echo the AP's own Short Preamble bit. Likewise the real
// driver's Supported Rates IE is the intersection of the STA's own
// rate capability and the AP's actually-advertised rates (same
// function, "Check if the AP's supported rates are also supported by
// STA"), not a fixed list.
fn probe_response_parse(buf: ref [u8; 256], frame_len: i64, ssid_out: mut ref [u8; 32], rates_out: mut ref [u8; 16]) -> ProbeRespInfo {
  if frame_len < 36 {
    return ProbeRespInfo { ok: 0, ssid_len: 0, has_rsn: 0, cap_info: 0, rates_len: 0 };
  }
  let cap_info: i64 = (buf[34] as i64) | ((buf[35] as i64) << 8);
  let ies_off: i64 = 36;
  let ies_len: i64 = frame_len - ies_off;

  let ssid_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_SSID);
  let ssid_len: i64 = 0;
  if ssid_ie.found == 1 {
    if ssid_ie.data_len > 32 {
      return ProbeRespInfo { ok: 0, ssid_len: 0, has_rsn: 0, cap_info: 0, rates_len: 0 };
    }
    ssid_len = ssid_ie.data_len;
    let i: i64 = 0;
    while i < ssid_len {
      ssid_out[i] = buf[ssid_ie.data_off + i];
      i = i + 1;
    }
  }

  let rsn_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_RSN);
  let has_rsn: i64 = 0;
  if rsn_ie.found == 1 {
    has_rsn = rsn_ie_supports_wpa2_psk_ccmp(buf, rsn_ie.data_off, rsn_ie.data_len);
  }

  let rates_len: i64 = 0;
  let rates_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_SUPP_RATES);
  if rates_ie.found == 1 {
    let n: i64 = if rates_ie.data_len > 16 { 16 } else { rates_ie.data_len };
    let i: i64 = 0;
    while i < n {
      rates_out[i] = buf[rates_ie.data_off + i];
      i = i + 1;
    }
    rates_len = n;
  }
  let ext_rates_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_EXT_SUPP_RATES);
  if ext_rates_ie.found == 1 {
    let room: i64 = 16 - rates_len;
    let n: i64 = if ext_rates_ie.data_len > room { room } else { ext_rates_ie.data_len };
    let i: i64 = 0;
    while i < n {
      rates_out[rates_len + i] = buf[ext_rates_ie.data_off + i];
      i = i + 1;
    }
    rates_len = rates_len + n;
  }

  return ProbeRespInfo { ok: 1, ssid_len: ssid_len, has_rsn: has_rsn, cap_info: cap_info, rates_len: rates_len };
}

// Builds an Open System Authentication Request: Algorithm Number 0
// (Open System, the only algorithm WPA2-PSK ever uses -- the real
// "authentication" happens later, in the 4-way handshake itself),
// Transaction Sequence Number 1, Status Code 0 (meaningless/ignored on
// a request, present for fixed-field-layout symmetry with the
// response), no Challenge Text (that IE only appears for Shared Key
// authentication, algorithm 1). Fixed 30-byte frame.
// Sequence Control now a real caller-supplied value, not a hardcoded
// 0x0000 -- see probe_request_build's own header comment for the full
// "why" (same bug, same fix, same investigation).
fn auth_request_build(bssid: ref [u8; 6], own_mac: ref [u8; 6], seq_num: i64, out: mut ref [u8; 30]) -> i64 {
  out[0] = (FC_STYPE_AUTH & (255 as i64)) as u8;
  out[1] = ((FC_STYPE_AUTH >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = bssid[i];
    out[10 + i] = own_mac[i];
    out[16 + i] = bssid[i];
    i = i + 1;
  }
  let seq_ctrl: i64 = (seq_num & 0xfff) << 4;
  out[22] = (seq_ctrl & (255 as i64)) as u8;
  out[23] = ((seq_ctrl >> 8) & (255 as i64)) as u8;
  out[24] = (WLAN_AUTH_OPEN & (255 as i64)) as u8;
  out[25] = ((WLAN_AUTH_OPEN >> 8) & (255 as i64)) as u8;
  out[26] = 1 as u8;
  out[27] = 0 as u8;
  out[28] = 0 as u8;
  out[29] = 0 as u8;
  return 30;
}

// Parses an Authentication Response: succeeds only if Algorithm Number
// is Open System, Transaction Sequence Number is 2 (the response's own
// fixed value), and Status Code is Success -- any other combination
// (a different algorithm, an out-of-sequence transaction number, or a
// non-zero status) is treated as a real authentication failure, not
// silently accepted.
fn auth_response_parse(buf: ref [u8; 256], frame_len: i64) -> i64 {
  if frame_len < 30 { return 0; }
  let algorithm: i64 = (buf[24] as i64) | ((buf[25] as i64) << 8);
  let transaction: i64 = (buf[26] as i64) | ((buf[27] as i64) << 8);
  let status: i64 = (buf[28] as i64) | ((buf[29] as i64) << 8);
  if algorithm != WLAN_AUTH_OPEN { return 0; }
  if transaction != 2 { return 0; }
  if status != WLAN_STATUS_SUCCESS { return 0; }
  return 1;
}

// Worst case: 24 (header) + 2 (capab) + 2 (listen interval) + 2+32
// (SSID IE, max ssid_len) + 2+8 (Supported Rates IE) + 2+4 (Extended
// Supported Rates IE, remaining 4 of the 12-rate joint set) + 22
// (RSN IE) = 100; 110 leaves margin.
const ASSOC_REQ_MAX_LEN: i64 = 110;

// Builds an Association Request: Capability Information advertises ESS
// (infrastructure BSS, bit 0) and Privacy (bit 4 -- required whenever
// the network uses RSN, per the real capability-info convention
// wpa_supplicant/mac80211 both follow), a fixed Listen Interval, the
// SSID and standard Supported Rates IEs (same values as the Probe
// Request), and finally the caller-supplied RSN IE (this station's own
// echo of the cipher/AKM choice it's asking to use -- always this
// package's own rsn_ie_build_wpa2_psk_ccmp output in practice, but
// taken as a parameter rather than called internally so a caller could
// substitute a different negotiated IE without this function needing
// to change). Returns the actual frame length used.
// Sequence Control now a real caller-supplied value, not a hardcoded
// 0x0000 -- see probe_request_build's own header comment for the full
// "why" (same bug, same fix, same investigation).
//
// ap_cap_info (round 2026-11-22, corrected): the Capability
// Information value the AP itself advertised in its Probe Response
// (ProbeRespInfo.cap_info). An earlier version of this fix copied it
// verbatim, reasoning from the 2013 Realtek vendor driver's own
// issue_assocreq (`_rtw_memcpy(pframe, rtw_get_capability_from_ie(...),
// 2)`) -- but ground-truthing against the real, current Linux
// mac80211 stack (net/mac80211/mlme.c, ieee80211_add_link_elems)
// shows that is NOT how a modern, broadly-interoperable client
// actually builds this field: mac80211 assembles it bit-by-bit from
// local state instead of copying the AP's value --
//   if (sband->band == NL80211_BAND_2GHZ) {
//     *capab |= WLAN_CAPABILITY_SHORT_SLOT_TIME;
//     *capab |= WLAN_CAPABILITY_SHORT_PREAMBLE;
//   }
// -- Short Preamble and Short Slot Time are set UNCONDITIONALLY for
// 2.4GHz (this chip's only band), never mirrored from the AP; ESS is
// unconditional (`capab |= WLAN_CAPABILITY_ESS` for pre-EHT
// connections); only Privacy is actually taken from the AP's own
// scanned capability
// (`if (cbss->capability & WLAN_CAPABILITY_PRIVACY) capab |=
// WLAN_CAPABILITY_PRIVACY;`); Spectrum Management and Radio
// Measurement are both gated on local hardware/feature flags this
// chip doesn't have, so neither is ever set. That is what this
// function now does, matching mac80211 exactly rather than the older
// vendor driver's different (and, per a real AP's status_code=19
// rejection in this project's own testing, less correct for this
// specific interop case) convention.
fn assoc_request_build(bssid: ref [u8; 6], own_mac: ref [u8; 6], ssid: ref [u8; 32], ssid_len: i64, rsn_ie: ref [u8; 22], seq_num: i64, ap_cap_info: i64, ap_rates: ref [u8; 16], ap_rates_len: i64, out: mut ref [u8; 110]) -> i64 {
  out[0] = (FC_STYPE_ASSOC_REQ & (255 as i64)) as u8;
  out[1] = ((FC_STYPE_ASSOC_REQ >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = bssid[i];
    out[10 + i] = own_mac[i];
    out[16 + i] = bssid[i];
    i = i + 1;
  }
  let seq_ctrl: i64 = (seq_num & 0xfff) << 4;
  out[22] = (seq_ctrl & (255 as i64)) as u8;
  out[23] = ((seq_ctrl >> 8) & (255 as i64)) as u8;

  let capab_info: i64 = 0x0001 | (ap_cap_info & 0x0010) | 0x0020 | 0x0400;
  out[24] = (capab_info & (255 as i64)) as u8;
  out[25] = ((capab_info >> 8) & (255 as i64)) as u8;
  let listen_interval: i64 = 10;
  out[26] = (listen_interval & (255 as i64)) as u8;
  out[27] = ((listen_interval >> 8) & (255 as i64)) as u8;

  let off: i64 = 28;
  out[off] = EID_SSID as u8;
  out[off + 1] = ssid_len as u8;
  i = 0;
  while i < ssid_len {
    out[off + 2 + i] = ssid[i];
    i = i + 1;
  }
  off = off + 2 + ssid_len;

  // Joint rate set: every rate the AP itself advertised that this STA
  // also supports, keeping the AP's own byte (and its own Basic-rate
  // flag) verbatim -- matches the real driver's own issue_assocreq
  // rate-matching loop exactly (see probe_response_parse's header
  // comment for the ground-truth citation). Compared with the Basic-
  // rate bit (0x80) masked off on both sides, same as the reference's
  // own `|IEEE80211_BASIC_RATE_MASK` comparison.
  let sta_rates: [u8; 12] = [0 as u8; 12];
  let sta_rates_len: i64 = sta_rate_capability(mut ref sta_rates);
  let matched: [u8; 16] = [0 as u8; 16];
  let matched_len: i64 = 0;
  let a: i64 = 0;
  while a < ap_rates_len {
    let ap_rate_masked: i64 = (ap_rates[a] as i64) & 0x7f;
    let b: i64 = 0;
    let found: i64 = 0;
    while b < sta_rates_len {
      if ((sta_rates[b] as i64) & 0x7f) == ap_rate_masked { found = 1; }
      b = b + 1;
    }
    if found == 1 {
      matched[matched_len] = ap_rates[a];
      matched_len = matched_len + 1;
    }
    a = a + 1;
  }
  // No rate in common with the AP: a real STA never sends this
  // Association Request at all ("don't connect to AP if no joint
  // supported rate", same reference function). 0 is otherwise
  // unreachable as a real return value (the header/capab/listen
  // fields alone already put off at 28), so it's a safe, unambiguous
  // failure sentinel for the caller to check.
  if matched_len == 0 { return 0; }

  let base_len: i64 = if matched_len > 8 { 8 } else { matched_len };
  out[off] = EID_SUPP_RATES as u8;
  out[off + 1] = base_len as u8;
  i = 0;
  while i < base_len {
    out[off + 2 + i] = matched[i];
    i = i + 1;
  }
  off = off + 2 + base_len;

  if matched_len > 8 {
    let ext_len: i64 = matched_len - 8;
    out[off] = EID_EXT_SUPP_RATES as u8;
    out[off + 1] = ext_len as u8;
    i = 0;
    while i < ext_len {
      out[off + 2 + i] = matched[8 + i];
      i = i + 1;
    }
    off = off + 2 + ext_len;
  }

  i = 0;
  while i < 22 {
    out[off + i] = rsn_ie[i];
    i = i + 1;
  }
  off = off + 22;

  return off;
}

struct AssocRespInfo { ok: i64, status_code: i64, association_id: i64 }

// Parses an Association Response: fixed fields are Capability
// Information (2 bytes), Status Code (2 bytes), Association ID
// (2 bytes) -- 6 bytes total, right after the 24-byte MAC header.
// `ok` reflects whether Status Code was Success; `association_id`
// (only meaningful when `ok == 1`) is what the station must present in
// every subsequent data frame's own Duration/ID-adjacent addressing
// (out of THIS package's own scope -- CCMP data-frame handling is
// vani-aes/AES-CCMP's own job).
fn assoc_response_parse(buf: ref [u8; 256], frame_len: i64) -> AssocRespInfo {
  if frame_len < 30 {
    return AssocRespInfo { ok: 0, status_code: 0 - 1, association_id: 0 };
  }
  let status_code: i64 = (buf[26] as i64) | ((buf[27] as i64) << 8);
  let association_id: i64 = (buf[28] as i64) | ((buf[29] as i64) << 8);
  let ok: i64 = 0;
  if status_code == WLAN_STATUS_SUCCESS { ok = 1; }
  return AssocRespInfo { ok: ok, status_code: status_code, association_id: association_id };
}

// AP-side frame build/parse (2026-10-04 follow-up): everything above
// this point is STATION-side (the frames a client sends/expects back
// from an AP it's joining). An AP needs the reverse of each: it PARSES
// Probe/Association Requests and BUILDS Probe/Association Responses
// and Beacons, using the exact same field layouts already verified
// above -- confirmed via a research fork's direct trace of Linux's
// real `rtl8xxxu` driver (`core.c`'s `rtl8xxxu_send_beacon_frame`/
// `rtl8xxxu_start_ap`) that a Beacon's own body is structurally
// identical to a Probe Response's (Timestamp+BeaconInterval+CapInfo
// fixed fields, then SSID/Rates/RSN IEs) -- it only differs in the
// 802.11 header's own subtype and destination (broadcast, not the
// specific station that asked), so `beacon_build` and
// `probe_response_build` below share one internal helper rather than
// duplicating the fixed-field+IE-writing logic twice.
const BEACON_MAX_LEN: i64 = 100;
const PROBE_RESP_MAX_LEN: i64 = 100;

// Shared by beacon_build/probe_response_build: writes the 24-byte MAC
// header (dest/addr1 given explicitly since a Beacon's is broadcast
// but a Probe Response's is the specific requesting station) plus the
// Timestamp(8, left as all-zero -- confirmed spec-safe: a real
// Beacon's Timestamp is purely informational for client power-save/
// sync, never checked for correctness by a scanning station, per the
// same research fork's trace of `rtl8xxxu_send_beacon_frame`, which
// builds this via mac80211's own generic `ieee80211_beacon_get`, not
// any RTL-specific logic), Beacon Interval(2), Capability Info(2) --
// ESS (bit 0) always set, Privacy (bit 4) set only when `has_rsn` --
// then SSID/Supported Rates/RSN IEs (RSN only if `has_rsn`). Returns
// the frame length used.
fn ap_frame_body_build(dest: ref [u8; 6], bssid: ref [u8; 6], stype: i64, ssid: ref [u8; 32], ssid_len: i64, rsn_ie: ref [u8; 22], has_rsn: i64, beacon_interval: i64, out: mut ref [u8; 100]) -> i64 {
  out[0] = (stype & (255 as i64)) as u8;
  out[1] = ((stype >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = dest[i];
    out[10 + i] = bssid[i];
    out[16 + i] = bssid[i];
    i = i + 1;
  }
  out[22] = 0 as u8;
  out[23] = 0 as u8;

  i = 0;
  while i < 8 { out[24 + i] = 0 as u8; i = i + 1; } // Timestamp
  out[32] = (beacon_interval & (255 as i64)) as u8;
  out[33] = ((beacon_interval >> 8) & (255 as i64)) as u8;
  let capab_info: i64 = if has_rsn == 1 { 0x0011 } else { 0x0001 };
  out[34] = (capab_info & (255 as i64)) as u8;
  out[35] = ((capab_info >> 8) & (255 as i64)) as u8;

  let off: i64 = 36;
  out[off] = EID_SSID as u8;
  out[off + 1] = ssid_len as u8;
  i = 0;
  while i < ssid_len {
    out[off + 2 + i] = ssid[i];
    i = i + 1;
  }
  off = off + 2 + ssid_len;

  out[off] = EID_SUPP_RATES as u8;
  out[off + 1] = 4 as u8;
  out[off + 2] = 0x82 as u8;
  out[off + 3] = 0x84 as u8;
  out[off + 4] = 0x8b as u8;
  out[off + 5] = 0x96 as u8;
  off = off + 6;

  if has_rsn == 1 {
    i = 0;
    while i < 22 { out[off + i] = rsn_ie[i]; i = i + 1; }
    off = off + 22;
  }

  return off;
}

// Broadcast (Address1=Address3=own BSSID per this package's own
// broadcast-addressing convention already used by probe_request_build
// above, Address3 is the BSSID either way since the AP IS the BSSID).
fn beacon_build(bssid: ref [u8; 6], ssid: ref [u8; 32], ssid_len: i64, rsn_ie: ref [u8; 22], has_rsn: i64, beacon_interval: i64, out: mut ref [u8; 100]) -> i64 {
  let broadcast: [u8; 6] = [0xff as u8; 6];
  return ap_frame_body_build(ref broadcast, bssid, FC_STYPE_BEACON, ssid, ssid_len, rsn_ie, has_rsn, beacon_interval, out);
}

// Unicast to the specific station that sent the Probe Request --
// real APs must answer BOTH a wildcard probe (empty SSID, "what
// networks are here") and one naming this AP's own SSID specifically;
// probe_request_parse below reports which so the caller can decide.
fn probe_response_build(sta_mac: ref [u8; 6], bssid: ref [u8; 6], ssid: ref [u8; 32], ssid_len: i64, rsn_ie: ref [u8; 22], has_rsn: i64, beacon_interval: i64, out: mut ref [u8; 100]) -> i64 {
  return ap_frame_body_build(sta_mac, bssid, FC_STYPE_PROBE_RESP, ssid, ssid_len, rsn_ie, has_rsn, beacon_interval, out);
}

struct ProbeReqInfo { ok: i64, ssid_len: i64, is_wildcard: i64 }

// A Probe Request has NO fixed fields before its IEs (unlike a Probe
// Response's extra Timestamp/BeaconInterval/CapInfo) -- confirmed by
// this same package's own probe_request_build above, which starts its
// SSID IE at offset 24, right after the MAC header. An empty (zero-
// length) SSID IE is the standard "wildcard" probe every real AP must
// answer regardless of its own configured network name; a non-empty
// SSID must match this AP's own to warrant a response.
fn probe_request_parse(buf: ref [u8; 256], frame_len: i64, ssid_out: mut ref [u8; 32]) -> ProbeReqInfo {
  if frame_len < 24 {
    return ProbeReqInfo { ok: 0, ssid_len: 0, is_wildcard: 0 };
  }
  let ies_off: i64 = 24;
  let ies_len: i64 = frame_len - ies_off;
  let ssid_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_SSID);
  if ssid_ie.found == 0 {
    return ProbeReqInfo { ok: 0, ssid_len: 0, is_wildcard: 0 };
  }
  if ssid_ie.data_len > 32 {
    return ProbeReqInfo { ok: 0, ssid_len: 0, is_wildcard: 0 };
  }
  let i: i64 = 0;
  while i < ssid_ie.data_len {
    ssid_out[i] = buf[ssid_ie.data_off + i];
    i = i + 1;
  }
  let is_wildcard: i64 = if ssid_ie.data_len == 0 { 1 } else { 0 };
  return ProbeReqInfo { ok: 1, ssid_len: ssid_ie.data_len, is_wildcard: is_wildcard };
}

struct AssocReqInfo { ok: i64, ssid_len: i64, has_rsn: i64 }

// Association Request fixed fields (Capability Info + Listen Interval,
// 4 bytes) end at offset 28, where IEs begin -- confirmed by this same
// package's own assoc_request_build above (`let off: i64 = 28;`).
// Deliberately as minimal as assoc_response_parse's own STA-side
// counterpart (which checks only Status Code, nothing else) -- an AP
// accepting the association only needs to confirm the SSID matches
// its own and, if it's running WPA2-PSK, that the station's own RSN
// IE is compatible; Capability Info/Listen Interval are not checked.
fn assoc_request_parse(buf: ref [u8; 256], frame_len: i64, ssid_out: mut ref [u8; 32]) -> AssocReqInfo {
  if frame_len < 28 {
    return AssocReqInfo { ok: 0, ssid_len: 0, has_rsn: 0 };
  }
  let ies_off: i64 = 28;
  let ies_len: i64 = frame_len - ies_off;
  let ssid_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_SSID);
  if ssid_ie.found == 0 {
    return AssocReqInfo { ok: 0, ssid_len: 0, has_rsn: 0 };
  }
  if ssid_ie.data_len > 32 {
    return AssocReqInfo { ok: 0, ssid_len: 0, has_rsn: 0 };
  }
  let i: i64 = 0;
  while i < ssid_ie.data_len {
    ssid_out[i] = buf[ssid_ie.data_off + i];
    i = i + 1;
  }
  let rsn_ie: IeFindResult = ie_find(buf, ies_off, ies_len, EID_RSN);
  let has_rsn: i64 = 0;
  if rsn_ie.found == 1 {
    has_rsn = rsn_ie_supports_wpa2_psk_ccmp(buf, rsn_ie.data_off, rsn_ie.data_len);
  }
  return AssocReqInfo { ok: 1, ssid_len: ssid_ie.data_len, has_rsn: has_rsn };
}

// Fixed 30 bytes, no trailing IEs -- deliberately matches assoc_
// response_parse's own existing minimalism (that STA-side parser
// above never looks past byte 30 either, so a real client this
// project's own code would recognize needs nothing more); some real
// client stacks additionally expect a trailing Supported Rates IE
// here, a known, documented narrowing of full interop for this first
// increment, not a limitation of the fixed-field encoding itself.
fn assoc_response_build(sta_mac: ref [u8; 6], bssid: ref [u8; 6], association_id: i64, out: mut ref [u8; 30]) -> i64 {
  out[0] = (FC_STYPE_ASSOC_RESP & (255 as i64)) as u8;
  out[1] = ((FC_STYPE_ASSOC_RESP >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = sta_mac[i];
    out[10 + i] = bssid[i];
    out[16 + i] = bssid[i];
    i = i + 1;
  }
  out[22] = 0 as u8;
  out[23] = 0 as u8;
  let capab_info: i64 = 0x0011;
  out[24] = (capab_info & (255 as i64)) as u8;
  out[25] = ((capab_info >> 8) & (255 as i64)) as u8;
  out[26] = (WLAN_STATUS_SUCCESS & (255 as i64)) as u8;
  out[27] = ((WLAN_STATUS_SUCCESS >> 8) & (255 as i64)) as u8;
  out[28] = (association_id & (255 as i64)) as u8;
  out[29] = ((association_id >> 8) & (255 as i64)) as u8;
  return 30;
}

// 802.11 DATA-frame encapsulation for EAPOL-Key frames (task #197
// follow-up, 2026-10-01): once associated, EAPOL-Key messages travel
// as ordinary 802.11 Data frames carrying an 802.2 LLC/SNAP header
// (DSAP=SSAP=0xAA, Control=0x03, OUI=00:00:00) with Ethertype 0x888E
// -- the standard EAPOL encapsulation, verified against Linux's own
// `ETH_P_PAE` (0x888E, `include/uapi/linux/if_ether.h`) and
// `ieee80211_data_to_8023` (`net/wireless/util.c`, the LLC/SNAP strip/
// add logic every real 802.11 data path implements). Deliberately
// builds a non-QoS Data frame (fixed 24-byte header) when SENDING --
// this driver has no QoS/WMM negotiation at all (rtl8188cu_set_
// channel's own comment: "no rate/HT-capability negotiation yet"), so
// claiming a QoS Control field it can't back up would be worse than
// a frame some real APs could in principle reject; a non-QoS Data
// frame is what the 802.11 standard itself requires every AP to
// accept regardless of what the BSS otherwise negotiates. PARSING an
// incoming frame (the AP's own Msg1/Msg3) checks BOTH offsets --
// every real AP sends QoS Data frames in practice (802.11n/ac/ax are
// universal now), so a parser that only understood non-QoS would
// never actually see them.
const FC_TYPE_DATA: i64 = 0x0008;
const FC_SUBTYPE_QOS_BIT: i64 = 0x0080;
const FC_TODS: i64 = 0x0100;
const DATA_HDR_LEN_NONQOS: i64 = 24;
const DATA_HDR_LEN_QOS: i64 = 26;
const LLC_SNAP_LEN: i64 = 8;
const ETHERTYPE_EAPOL: i64 = 0x888e;
// Largest EAPOL payload (EAPOL header onward) either direction.
// 2026-11-26: was 140, sized for a 99-byte Message 2 with no Key Data
// -- too small for both a correct Message 2 (99 + 22-byte RSNE = 121,
// wrapped to 153 > 140 overran `out`) and any real AP's Message 3
// (99 + wrapped RSNE+GTK KDE, typically 155+, rejected by the parser).
// 224 = the 256-byte RX frame buffer minus the smallest (24-byte
// non-QoS) header and 8-byte LLC/SNAP, so every EAPOL frame that fits
// the RX buffer at all fits here; the wrapped TX frame buffer is 256.
const DATA_FRAME_EAPOL_MAX_LEN: i64 = 224;

// Builds a non-QoS Data frame, ToDS=1 (station -> AP), ADDR1=ADDR3=
// BSSID (EAPOL is a direct STA<->AP link exchange, never routed
// beyond the AP itself -- the same reasoning this package's own
// probe_request_build uses for setting ADDR3, just without the
// broadcast case since the BSSID is already known by this point in
// the join sequence), ADDR2=own MAC, wrapping `payload` (an EAPOL-Key
// frame, as built by this project's own eapol_key package) behind the
// LLC/SNAP header above. Returns the real frame length used.
//
// seq_num (round 2026-11-22): this field was hardcoded to 0x0000 in
// the actual frame header on every single call -- the exact same bug
// class probe_request_build/auth_request_build/assoc_request_build
// all had and were already fixed for (see probe_request_build's own
// header comment for the original "why"), just never ported to this
// sibling function. Every Message 2/4 this driver ever sent carried
// Sequence Control 0, every single boot, every single retry -- a
// real AP's own duplicate-frame filter keys only on (transmitter
// address, sequence number, fragment number), never on content, so
// once it has cached seq#0 from this STA from ANY earlier frame (a
// collision is all but guaranteed this way, not a rare coincidence),
// every subsequent Message 2/4 -- regardless of how correct its own
// content/MIC/preamble/rate fields are -- gets silently discarded as
// an apparent repeat of something already processed, never even
// reaching the AP's own EAPOL state machine to be rejected loudly.
// This plausibly explains why none of this investigation's other,
// independently-verified-correct fixes (content/MIC, capability info,
// rate set, PHY preamble) ever changed the outcome.
//
// QoS (round 2026-11-22, full systematic re-audit against the
// reference driver's complete xmit path): core/rtw_xmit.c's set_qos
// tags EAPOL with UserPriority=7 (AC_VO) unconditionally, regardless
// of whether the AP negotiated WMM with this STA -- this function was
// changed to match, sending a QoS Data subtype (26-byte header).
//
// REVERTED 2026-11-23: that change was never paired with the other
// half of what a real QoS-capable client does -- advertise QoS/WMM
// support in the Association Request (a WMM Information Element, or
// at minimum the QoS capability bit; this package's own assoc_
// request_build has neither, and never has). A station that never
// negotiated WMM sending a QoS-tagged data frame is exactly the kind
// of frame a real AP's own per-TID/QoS handling can silently
// disregard without any visible protocol-level rejection -- and this
// round's own real-HW investigation found exactly that symptom: a
// byte-perfect, independently-MIC-verified, correctly-sequenced
// Message 2 that one specific AP (REG_TRXDMA_CTRL/endpoint-routing
// and every other candidate already ruled out) simply never answers,
// while visibly completing full handshakes with OTHER clients in the
// very same capture window. This restores this function's own
// original 2026-10-01 reasoning (still correct, see below) rather
// than the vendor driver's unconditional-QoS shortcut: a non-QoS Data
// frame is what 802.11 itself requires every AP to accept regardless
// of what the BSS otherwise negotiates. If WMM negotiation is ever
// added to assoc_request_build, QoS-tagging EAPOL again would then be
// a correctly-paired change, not a one-sided assumption.
fn data_frame_build_eapol(bssid: ref [u8; 6], own_mac: ref [u8; 6], payload: ref [u8; 224], payload_len: i64, seq_num: i64, out: mut ref [u8; 256]) -> i64 {
  if (payload_len < 0) || (payload_len > DATA_FRAME_EAPOL_MAX_LEN) { return 0; }
  let fc: i64 = FC_TYPE_DATA | FC_TODS;
  out[0] = (fc & (255 as i64)) as u8;
  out[1] = ((fc >> 8) & (255 as i64)) as u8;
  out[2] = 0 as u8;
  out[3] = 0 as u8;
  let i: i64 = 0;
  while i < 6 {
    out[4 + i] = bssid[i];
    out[10 + i] = own_mac[i];
    out[16 + i] = bssid[i];
    i = i + 1;
  }
  let seq_ctrl: i64 = (seq_num & 0xfff) << 4;
  out[22] = (seq_ctrl & (255 as i64)) as u8;
  out[23] = ((seq_ctrl >> 8) & (255 as i64)) as u8;

  let llc_off: i64 = DATA_HDR_LEN_NONQOS;
  out[llc_off] = 0xaa as u8;
  out[llc_off + 1] = 0xaa as u8;
  out[llc_off + 2] = 0x03 as u8;
  out[llc_off + 3] = 0x00 as u8;
  out[llc_off + 4] = 0x00 as u8;
  out[llc_off + 5] = 0x00 as u8;
  out[llc_off + 6] = ((ETHERTYPE_EAPOL >> 8) & (255 as i64)) as u8;
  out[llc_off + 7] = (ETHERTYPE_EAPOL & (255 as i64)) as u8;

  let payload_off: i64 = llc_off + LLC_SNAP_LEN;
  let j: i64 = 0;
  while j < payload_len {
    out[payload_off + j] = payload[j];
    j = j + 1;
  }
  return payload_off + payload_len;
}

struct DataFrameEapolResult { ok: i64, payload_len: i64 }

// Parses an incoming Data frame, checking both the non-QoS (24-byte)
// and QoS (26-byte) header lengths for an LLC/SNAP header carrying
// Ethertype 0x888E -- see this function's own header comment above
// for why both must be checked. `ok == 0` (not an EAPOL-carrying Data
// frame, or too short to be one) is the expected, harmless outcome
// for most frames an open RX poll loop will see -- background
// traffic on a real, busy network, not a parse failure to report
// loudly.
fn data_frame_parse_eapol(buf: ref [u8; 256], frame_len: i64, payload_out: mut ref [u8; 224]) -> DataFrameEapolResult {
  let fc: i64 = (buf[0] as i64) | ((buf[1] as i64) << 8);
  let ftype: i64 = (fc >> 2) & (3 as i64);
  if ftype != 2 {
    return DataFrameEapolResult { ok: 0, payload_len: 0 };
  }
  let subtype: i64 = fc & (0x00f0 as i64);
  let is_qos: i64 = if (subtype & FC_SUBTYPE_QOS_BIT) != 0 { 1 } else { 0 };
  let hdr_len: i64 = if is_qos == 1 { DATA_HDR_LEN_QOS } else { DATA_HDR_LEN_NONQOS };
  let llc_off: i64 = hdr_len;
  if frame_len < (llc_off + LLC_SNAP_LEN) {
    return DataFrameEapolResult { ok: 0, payload_len: 0 };
  }
  let ethertype: i64 = ((buf[llc_off + 6] as i64) << 8) | (buf[llc_off + 7] as i64);
  if ethertype != ETHERTYPE_EAPOL {
    return DataFrameEapolResult { ok: 0, payload_len: 0 };
  }
  let payload_off: i64 = llc_off + LLC_SNAP_LEN;
  let payload_len: i64 = frame_len - payload_off;
  if (payload_len < 0) || (payload_len > DATA_FRAME_EAPOL_MAX_LEN) || (frame_len > 256) {
    return DataFrameEapolResult { ok: 0, payload_len: 0 };
  }
  let i: i64 = 0;
  while i < payload_len {
    payload_out[i] = buf[payload_off + i];
    i = i + 1;
  }
  return DataFrameEapolResult { ok: 1, payload_len: payload_len };
}
