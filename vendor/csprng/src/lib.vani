use "../../crypto_hash/src/core.vani";

// A minimal hash-based (SHA-256) generator: reseed-then-generate-then-
// ratchet. NOT a NIST SP 800-90A DRBG (Hash_DRBG/HMAC_DRBG/CTR_DRBG) --
// deliberately simpler, closer in spirit to Fortuna's own generator
// (hash/cipher the running state with a counter, then ratchet the
// state forward for forward secrecy) than to a fully-specified NIST
// construction, matching this project's own "smallest real increment,
// not the whole surface" discipline. Genuinely a CSPRNG in the sense
// that matters here: its output is computationally indistinguishable
// from random PROVIDED the seed itself carries real entropy (supplied
// by a board-specific hardware entropy source -- BCM2835's own RNG
// peripheral on Pi 1 -- kept deliberately OUTSIDE this package, same
// separation this project's own AES/CCMP-vs-vani-aes split already
// established: hardware register access lives in the board-specific
// kernel, algorithm logic lives in a hardware-agnostic kosh package).

fn zero32_bytes() -> [u8; 32] {
  return [0 as u8; 32];
}

fn csprng_zero8_bytes() -> [u8; 8] {
  return [0 as u8; 8];
}

// Fixed 32-byte domain-separation constant for the post-generate
// ratchet step. All 0xFF -- distinct from the all-zero initial state
// and from any real counter value, so ratchet/reseed/generate can
// never accidentally collide on the same hash input by construction.
// Forward secrecy rationale: after `csprng_generate` ratchets state
// via SHA256(state || this constant), an attacker who later obtains
// only the POST-ratchet state cannot recompute this call's own output
// blocks -- each was SHA256(PRE-ratchet-state || a *different* input,
// the block counter) -- since SHA-256 is one-way, the post-ratchet
// state doesn't reveal the pre-ratchet state it was derived from.
fn csprng_ratchet_const() -> [u8; 32] {
  return [0xff as u8; 32];
}

// Big-endian 8-byte counter increment (byte 7 is the LSB) -- the same
// byte-array increment shape this project's own EAPOL-Key replay
// counter already uses elsewhere, applied here to the CSPRNG's own
// internal per-block counter instead.
fn csprng_counter_increment(counter: mut ref [u8; 8]) -> i64 {
  let i: i64 = 7;
  let carry: i64 = 1;
  while i >= 0 {
    let v: i64 = (counter[i] as i64) + carry;
    counter[i] = (v & 255) as u8;
    if v > 255 {
      carry = 1;
    } else {
      carry = 0;
    }
    i = i - 1;
  }
  return 0;
}

// Mixes 32 bytes of fresh entropy into the 32-byte state: state =
// SHA256(state || entropy). Deliberately MIXES rather than replaces --
// even entropy an attacker could predict or influence can't move the
// state to an attacker-chosen value outright, only combine with
// whatever the state already held.
fn csprng_reseed(state: mut ref [u8; 32], entropy: ref [u8; 32]) -> i64 {
  let msg: [u8; 256] = zero256_bytes();
  let i: i64 = 0;
  while i < 32 {
    msg[i] = state[i];
    i = i + 1;
  }
  i = 0;
  while i < 32 {
    msg[32 + i] = entropy[i];
    i = i + 1;
  }
  let ctx: Sha256Ctx = sha256_init();
  let ctx2: Sha256Ctx = sha256_update(ref ctx, mut ref msg, 64);
  let digest: [u8; 32] = sha256_finalize(ref ctx2);
  i = 0;
  while i < 32 {
    state[i] = digest[i];
    i = i + 1;
  }
  return 0;
}

const CSPRNG_MAX_OUTPUT: i64 = 64;

// Generates `n` (<= CSPRNG_MAX_OUTPUT) pseudo-random bytes into `out`.
// Each 32-byte block is SHA256(state || counter); counter is
// incremented after every block (whether fully consumed or the last
// one truncated) -- the same "hash the state with a running counter"
// principle as CTR-mode block-cipher keystreams, just with SHA-256
// standing in for the cipher. After the requested bytes are produced,
// `state` is ratcheted forward (see csprng_ratchet_const's own
// comment). Returns 0 on success, 0 - 1 if `n` is out of range.
fn csprng_generate(state: mut ref [u8; 32], counter: mut ref [u8; 8], out: mut ref [u8; 64], n: i64) -> i64 {
  if n < 0 { return 0 - 1; }
  if n > CSPRNG_MAX_OUTPUT { return 0 - 1; }

  let produced: i64 = 0;
  while produced < n {
    let msg: [u8; 256] = zero256_bytes();
    let i: i64 = 0;
    while i < 32 {
      msg[i] = state[i];
      i = i + 1;
    }
    i = 0;
    while i < 8 {
      msg[32 + i] = counter[i];
      i = i + 1;
    }
    let ctx: Sha256Ctx = sha256_init();
    let ctx2: Sha256Ctx = sha256_update(ref ctx, mut ref msg, 40);
    let block: [u8; 32] = sha256_finalize(ref ctx2);
    let _ = csprng_counter_increment(counter);

    let remaining: i64 = n - produced;
    let take: i64 = 32;
    if remaining < 32 { take = remaining; }
    i = 0;
    while i < take {
      out[produced + i] = block[i];
      i = i + 1;
    }
    produced = produced + take;
  }

  let ratchet: [u8; 32] = csprng_ratchet_const();
  let rmsg: [u8; 256] = zero256_bytes();
  let ri: i64 = 0;
  while ri < 32 {
    rmsg[ri] = state[ri];
    ri = ri + 1;
  }
  ri = 0;
  while ri < 32 {
    rmsg[32 + ri] = ratchet[ri];
    ri = ri + 1;
  }
  let rctx: Sha256Ctx = sha256_init();
  let rctx2: Sha256Ctx = sha256_update(ref rctx, mut ref rmsg, 64);
  let rdigest: [u8; 32] = sha256_finalize(ref rctx2);
  let i2: i64 = 0;
  while i2 < 32 {
    state[i2] = rdigest[i2];
    i2 = i2 + 1;
  }

  return 0;
}

// Verifies the exact reseed/generate/ratchet construction above against
// values independently computed via Python's `hashlib.sha256`,
// replaying this exact algorithm step by step (state0 = all-zero,
// entropy = bytes 0x00..0x1f, generate 40 bytes then 16 more,
// confirming the ratchet in between actually changes what the second
// generate call produces) -- not derived from this same vani code.
// Also checks two structural properties any real CSPRNG needs:
// different entropy inputs must reseed to different states, and two
// successive generate calls (with the ratchet between them) must never
// produce identical output.
fn csprng_self_test() -> i64 {
  let ok: i64 = 1;

  let state: [u8; 32] = zero32_bytes();
  let entropy: [u8; 32] = [
    0x00 as u8, 0x01 as u8, 0x02 as u8, 0x03 as u8, 0x04 as u8, 0x05 as u8, 0x06 as u8, 0x07 as u8,
    0x08 as u8, 0x09 as u8, 0x0a as u8, 0x0b as u8, 0x0c as u8, 0x0d as u8, 0x0e as u8, 0x0f as u8,
    0x10 as u8, 0x11 as u8, 0x12 as u8, 0x13 as u8, 0x14 as u8, 0x15 as u8, 0x16 as u8, 0x17 as u8,
    0x18 as u8, 0x19 as u8, 0x1a as u8, 0x1b as u8, 0x1c as u8, 0x1d as u8, 0x1e as u8, 0x1f as u8
  ];
  let _ = csprng_reseed(mut ref state, ref entropy);

  let exp_state1: [u8; 32] = [
    0xbb as u8, 0x22 as u8, 0x75 as u8, 0xc4 as u8, 0x9f as u8, 0x28 as u8, 0xad as u8, 0x52 as u8,
    0xca as u8, 0xe6 as u8, 0xd5 as u8, 0x5e as u8, 0x34 as u8, 0xa9 as u8, 0x74 as u8, 0xa5 as u8,
    0x8c as u8, 0x7a as u8, 0x3b as u8, 0xa2 as u8, 0x6f as u8, 0x97 as u8, 0x6e as u8, 0x8e as u8,
    0xcb as u8, 0xbe as u8, 0x7a as u8, 0x53 as u8, 0x69 as u8, 0x18 as u8, 0xdc as u8, 0x73 as u8
  ];
  let i: i64 = 0;
  while i < 32 {
    if state[i] != exp_state1[i] { ok = 0; }
    i = i + 1;
  }

  let counter: [u8; 8] = csprng_zero8_bytes();
  let out40: [u8; 64] = [0 as u8; 64];
  let _ = csprng_generate(mut ref state, mut ref counter, mut ref out40, 40);

  let exp_out40: [u8; 64] = [
    0xf3 as u8, 0x94 as u8, 0x45 as u8, 0x1f as u8, 0x39 as u8, 0xc1 as u8, 0x71 as u8, 0xae as u8,
    0x83 as u8, 0x3d as u8, 0x87 as u8, 0x48 as u8, 0x5e as u8, 0x4f as u8, 0x46 as u8, 0x91 as u8,
    0x26 as u8, 0x77 as u8, 0xc8 as u8, 0x1b as u8, 0xa6 as u8, 0x89 as u8, 0x7d as u8, 0x67 as u8,
    0x20 as u8, 0x52 as u8, 0x81 as u8, 0xa6 as u8, 0xc9 as u8, 0xfb as u8, 0xc4 as u8, 0x25 as u8,
    0x8d as u8, 0xd6 as u8, 0x8d as u8, 0xd3 as u8, 0xbe as u8, 0xd5 as u8, 0xef as u8, 0xaa as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  i = 0;
  while i < 40 {
    if out40[i] != exp_out40[i] { ok = 0; }
    i = i + 1;
  }

  let exp_counter2: [u8; 8] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 2 as u8];
  i = 0;
  while i < 8 {
    if counter[i] != exp_counter2[i] { ok = 0; }
    i = i + 1;
  }

  let exp_state2: [u8; 32] = [
    0xba as u8, 0x8e as u8, 0x2a as u8, 0x27 as u8, 0x21 as u8, 0x45 as u8, 0x1e as u8, 0x37 as u8,
    0x34 as u8, 0xa9 as u8, 0xff as u8, 0x3c as u8, 0x7f as u8, 0xd8 as u8, 0xcd as u8, 0xff as u8,
    0x44 as u8, 0x4b as u8, 0x7d as u8, 0xb0 as u8, 0x48 as u8, 0x01 as u8, 0x55 as u8, 0x49 as u8,
    0xba as u8, 0x9b as u8, 0x3f as u8, 0xe0 as u8, 0x3d as u8, 0x53 as u8, 0xbd as u8, 0xd3 as u8
  ];
  i = 0;
  while i < 32 {
    if state[i] != exp_state2[i] { ok = 0; }
    i = i + 1;
  }

  // Second generate call, from the ratcheted state -- proves the
  // ratchet genuinely moved the state (a bug that forgot to ratchet, or
  // ratcheted with the wrong input, would still coincidentally pass the
  // FIRST generate's own check above but diverge here).
  let out16: [u8; 64] = [0 as u8; 64];
  let _ = csprng_generate(mut ref state, mut ref counter, mut ref out16, 16);

  let exp_out16: [u8; 64] = [
    0x24 as u8, 0x93 as u8, 0x18 as u8, 0x4b as u8, 0x53 as u8, 0x2e as u8, 0x72 as u8, 0x38 as u8,
    0x4a as u8, 0xea as u8, 0xf4 as u8, 0xe5 as u8, 0x48 as u8, 0x5c as u8, 0x6b as u8, 0xbc as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  i = 0;
  while i < 16 {
    if out16[i] != exp_out16[i] { ok = 0; }
    i = i + 1;
  }

  // Structural check: two DIFFERENT entropy inputs, reseeded from the
  // SAME fresh all-zero state, must land on different states.
  let state_a: [u8; 32] = zero32_bytes();
  let state_b: [u8; 32] = zero32_bytes();
  let entropy_b: [u8; 32] = [0xab as u8; 32];
  let _ = csprng_reseed(mut ref state_a, ref entropy);
  let _ = csprng_reseed(mut ref state_b, ref entropy_b);
  let differ: i64 = 0;
  i = 0;
  while i < 32 {
    if state_a[i] != state_b[i] { differ = 1; }
    i = i + 1;
  }
  if differ == 0 { ok = 0; }

  // Structural check: the first and second generate calls above must
  // not have produced identical output (would indicate the counter/
  // ratchet isn't actually advancing the stream).
  let same: i64 = 1;
  i = 0;
  while i < 16 {
    if out40[i] != out16[i] { same = 0; }
    i = i + 1;
  }
  if same == 1 { ok = 0; }

  if ok == 1 {
    print "csprng: reseed/generate/ratchet vs an independently-computed reference + distinct-entropy/distinct-output checks (PASS)";
  } else {
    print "csprng: self-test FAILED";
  }
  return ok;
}
