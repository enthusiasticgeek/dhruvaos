// chacha20-poly1305's own core.vani -- the SAME primitives/one-shot
// convenience layer `src/lib.vani` has, MINUS its 3 self-test
// functions (chacha20_self_test/poly1305_self_test/chacha20_poly1305_
// self_test). For a consumer whose own code already defines a
// function of one of those exact names -- e.g. DhruvaOS's Pi 1
// kernel, which has its own pre-existing chacha20_self_test/
// poly1305_self_test -- and would otherwise collide when `use`-ing
// this package, matching the identical core.vani/lib.vani split
// vani-crypto-hash (round 99) and vani-curve25519 (round 100) each
// needed for the same reason. Kept in sync with lib.vani by
// construction (a line-range subset, not a separately maintained
// implementation).

// chacha20-poly1305 v0.1.0 -- ChaCha20 (RFC 8439 section 2.3/2.4) and
// Poly1305 (RFC 8439 section 2.5), plus the ChaCha20-Poly1305 AEAD
// construction (RFC 8439 section 2.8), pure vani, hardware-agnostic
// and heap-free.
//
// Extracted from DhruvaOS's Pi 1 kernel (round 44's own ChaCha20 +
// later rounds' Poly1305/AEAD/TLS work) -- the only crypto primitive
// in this project's roadmap that existed on Pi 1 with NO Pi 4/5-side
// counterpart to extract from (unlike crypto_hash/curve25519/pki,
// which all started as Pi 4/5 code moved outward). REDESIGNED around
// the same two vani-language facts crypto_hash/curve25519's own
// header comments document (heap-free by-value convention; the
// aliasing XOR rule), plus a THIRD one specific to this package:
//
// 3. `let` requires a full initializer and there is no `[expr; N]`
//    array-repeat literal (see vani-compiler/docs/
//    DHRUVAOS_ERGONOMICS_TODO.md items #1/#2) -- confirmed as a real,
//    already-hit constraint by curve25519's own Ed25519 `msg` cap
//    (raised only to 512 bytes in round 100, "chosen specifically
//    because of this gap," not higher). Rather than pick a single
//    large fixed array cap for ChaCha20/Poly1305's own genuinely
//    variable-length real use (Pi 1's TLS records currently run up
//    to 2048 bytes; DharaFS-shaped future users could need more),
//    this package's PRIMARY api is a true streaming design with NO
//    hand-typed literal anywhere near message-length size:
//
//    - `chacha20_xor_chunk` processes one caller-supplied chunk (up
//      to 64 bytes) against one keystream block; ChaCha20's own
//      block-independent CTR-mode construction (RFC 8439 section
//      2.4) means the caller can loop this over an arbitrarily long
//      message just by incrementing the block counter each call --
//      no accumulating state needed at all, unlike a hash.
//    - `Poly1305Ctx`/`poly1305_init`/`update`/`finalize` mirror
//      crypto_hash's own Sha256Ctx/Sha512Ctx streaming design exactly
//      (same carry-buffer-for-a-partial-block technique), since
//      Poly1305's polynomial evaluation genuinely does need
//      accumulating state across the whole message, unlike ChaCha20.
//
//    A smaller CAPPED one-shot convenience layer (chacha20_encrypt/
//    poly1305_mac/chacha20_poly1305_encrypt/decrypt, all bounded at
//    512 bytes -- the same practical ceiling curve25519's Ed25519
//    `msg` settled on) sits on top of the streaming primitives, for
//    simple/small callers and this file's own self-tests. A future
//    consumer with a longer message (Pi 1's own real TLS records,
//    round 102) is expected to call the streaming primitives
//    directly against its own heap buffer in a chunked loop, exactly
//    like crypto_hash's own `sha256_hash` heap adapter in DhruvaOS's
//    `kernel_main.vani` already does (`ctx = sha256_update(ref ctx,
//    mut ref chunk, chunk_n);` inside a `while offset < msg_len`
//    loop) -- this package's design is deliberately built to make
//    that same adapter shape apply here too, verified by construction
//    since `chacha20_poly1305_encrypt`/`poly1305_mac` below are
//    themselves ALREADY written on top of the streaming primitives
//    with a fixed cap, not a separate one-shot implementation.
//
// Every KAT below (RFC 8439 section 2.3.2's ChaCha20 block vector,
// section 2.5.2's Poly1305 vector, and a DhruvaOS-original AEAD
// vector) was independently re-verified against the real
// `cryptography` Python library's `ChaCha20`/`Poly1305`/
// `ChaCha20Poly1305` primitives before being ported here -- not just
// copied from Pi 1's own already-passing self-test unverified.

struct WordBytesLE { b0: u8, b1: u8, b2: u8, b3: u8 }

fn cp_word_le(b0: u8, b1: u8, b2: u8, b3: u8) -> u32 {
  return (b0 as u32) | ((b1 as u32) << (8 as u32)) | ((b2 as u32) << (16 as u32)) | ((b3 as u32) << (24 as u32));
}

fn cp_word_to_bytes_le(w: u32) -> WordBytesLE {
  return WordBytesLE {
    b0: (w & (255 as u32)) as u8,
    b1: ((w >> (8 as u32)) & (255 as u32)) as u8,
    b2: ((w >> (16 as u32)) & (255 as u32)) as u8,
    b3: ((w >> (24 as u32)) & (255 as u32)) as u8
  };
}

fn cp_zero16_bytes() -> [u8; 16] {
  return [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
}

fn cp_zero32_bytes() -> [u8; 32] {
  return [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
}

fn cp_zero64_bytes() -> [u8; 64] {
  return [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
}

