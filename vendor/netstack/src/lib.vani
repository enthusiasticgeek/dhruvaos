    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63]
  ];
  return out;
}


// Direct port of both boards' own `filter_self_test`/`filter_self_
// test_rpi4` (6 scenarios: no-rule default, specific-deny-overrides-
// allow, protocol specificity, first-match-wins ordering, portless-
// protocol never matches a port rule, non-IPv4 passthrough) plus
// scenario 1 of `filter_outgoing_self_test`/`_rpi4` (directional
// src/dst semantics for outgoing frames -- the real netif egress-hook
// integration itself, scenario 2 of that test, is inherently board-
// specific and stays in each kernel's own self-test).
fn netstack_filter_self_test() -> i64 {
  let ok: i64 = 1;
  let ip_a: u32 = 0x0A000001 as u32; // 10.0.0.1
  let ip_b: u32 = 0x0A000002 as u32; // 10.0.0.2

  // 1. No rules at all: falls through to the default policy.
  let cfg0: FilterConfig = netstack_filter_empty();
  let cfg1: FilterConfig = netstack_filter_set_default_policy(cfg0, 0 as u32);
  let f1: [u8; 512] = netstack_zero_frame();
  let l1: i64 = netstack_filter_build_test_frame(mut ref f1, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f1, l1, 0 as u32, ref cfg1) != (0 as u32) { ok = 0; }

  // 2. A specific deny rule overrides a permissive default, but only
  // for the src_ip it actually names.
  let cfg2: FilterConfig = netstack_filter_set_default_policy(cfg1, 1 as u32);
  let add2: FilterAddResult = netstack_filter_add_rule(cfg2, 6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32);
  let cfg3: FilterConfig = add2.cfg;
  let f2: [u8; 512] = netstack_zero_frame();
  let l2: i64 = netstack_filter_build_test_frame(mut ref f2, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f2, l2, 0 as u32, ref cfg3) != (0 as u32) { ok = 0; }
  let f3: [u8; 512] = netstack_zero_frame();
  let l3: i64 = netstack_filter_build_test_frame(mut ref f3, 6 as u32, ip_b, 80 as u32);
  if netstack_filter_check_frame(ref f3, l3, 0 as u32, ref cfg3) != (1 as u32) { ok = 0; }

  // 3. Protocol specificity: the same rule must not match UDP traffic
  // on the identical src_ip/port.
  let f4: [u8; 512] = netstack_zero_frame();
  let l4: i64 = netstack_filter_build_test_frame(mut ref f4, 17 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f4, l4, 0 as u32, ref cfg3) != (1 as u32) { ok = 0; }

  // 4. First-match-wins: an earlier wildcard deny must shadow a later,
  // more specific allow rule.
  let cfg4: FilterConfig = netstack_filter_flush(cfg3);
  let add4a: FilterAddResult = netstack_filter_add_rule(cfg4, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32); // deny everything
  let add4b: FilterAddResult = netstack_filter_add_rule(add4a.cfg, 6 as u32, 0 as u32, 0 as u32, 443 as u32, 1 as u32, 1 as u32); // allow TCP/443 (shadowed)
  let cfg5: FilterConfig = add4b.cfg;
  let f5: [u8; 512] = netstack_zero_frame();
  let l5: i64 = netstack_filter_build_test_frame(mut ref f5, 6 as u32, ip_a, 443 as u32);
  if netstack_filter_check_frame(ref f5, l5, 0 as u32, ref cfg5) != (0 as u32) { ok = 0; }

  // 5. A rule naming a specific dst_port must never match a portless
  // protocol (ICMP).
  let cfg6: FilterConfig = netstack_filter_flush(cfg5);
  let add6: FilterAddResult = netstack_filter_add_rule(cfg6, 0 as u32, 0 as u32, 0 as u32, 80 as u32, 1 as u32, 0 as u32); // deny port 80
  let cfg7: FilterConfig = netstack_filter_set_default_policy(add6.cfg, 1 as u32);
  let f6: [u8; 512] = netstack_zero_frame();
  let l6: i64 = netstack_filter_build_test_frame(mut ref f6, 1 as u32, ip_a, 80 as u32); // ICMP
  if netstack_filter_check_frame(ref f6, l6, 0 as u32, ref cfg7) != (1 as u32) { ok = 0; }

  // 6. Non-IPv4 traffic (e.g. ARP) passes through untouched regardless
  // of policy or rules.
  let cfg8: FilterConfig = netstack_filter_set_default_policy(cfg7, 0 as u32);
  let f7: [u8; 512] = netstack_zero_frame();
  f7[12] = 0x08 as u8;
  f7[13] = 0x06 as u8; // ethertype: ARP
  if netstack_filter_check_frame(ref f7, 38, 0 as u32, ref cfg8) != (1 as u32) { ok = 0; }

  // 7. Directional src/dst semantics: a rule naming ip_a must match an
  // OUTGOING frame whose DESTINATION is ip_a, not its (usually unset)
  // literal source-IP field -- and the identical frame checked as
  // INCOMING must NOT match.
  let cfg9: FilterConfig = netstack_filter_flush(cfg8);
  let cfg10: FilterConfig = netstack_filter_set_default_policy(cfg9, 1 as u32);
  let add10: FilterAddResult = netstack_filter_add_rule(cfg10, 6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32); // deny TCP/80 to ip_a
  let cfg11: FilterConfig = add10.cfg;
  let f8: [u8; 512] = netstack_zero_frame();
  let l8: i64 = netstack_filter_build_test_frame_dst(mut ref f8, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f8, l8, 1 as u32, ref cfg11) != (0 as u32) { ok = 0; }
  if netstack_filter_check_frame(ref f8, l8, 0 as u32, ref cfg11) != (1 as u32) { ok = 0; }
  let f9: [u8; 512] = netstack_zero_frame();
  let l9: i64 = netstack_filter_build_test_frame_dst(mut ref f9, 6 as u32, ip_b, 80 as u32);
  if netstack_filter_check_frame(ref f9, l9, 1 as u32, ref cfg11) != (1 as u32) { ok = 0; }

  return ok;
}
