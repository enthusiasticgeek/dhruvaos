// netstack v0.1.0 -- hardware-agnostic network protocol stack, pure
// vani, heap-free. v0.1.0 covers the packet filter only; ARP, IPv4,
// UDP, TCP, and DHCP (client + server) are planned additions in the
// same package (kept as ONE bundled package rather than several
// separate ones, deliberately -- IPv4/UDP/TCP/DHCP have real
// interdependencies (DHCP needs UDP needs IPv4), and splitting them
// into separately-vendored packages would need [deps]-style cross-
// package `use` the way vani-curve25519/vani-pki needed for
// vani-crypto-hash -- avoidable complexity here since it's all one
// cohesive stack, matching how a single real-world netstack crate
// like smoltcp covers the same scope in one crate rather than many).
//
// Extracted from DhruvaOS's Pi 1 (`kernel_main.vani`, `fw_*`-prefixed)
// and Pi 4/5 (`kernel_main_rpi4.vani`, `filter_*_rpi4`-suffixed)
// kernels -- confirmed byte-for-byte identical algorithms on both
// sides before porting (the only difference was buffer-access style:
// `buf_read_u16_be` heap-pointer reads on Pi 1 vs plain array
// indexing on Pi 4/5).
//
// Design principle, extending the Sha256Ctx/Poly1305Ctx precedent
// from vani-crypto-hash/vani-chacha20-poly1305 to LONG-LIVED protocol
// state (a filter's rule table persists across the whole boot
// session, not just one function call): `FilterConfig` is a plain
// value-type struct, threaded through by value, with NO extern
// accessors or persistent storage inside this package at all. Both
// DhruvaOS kernels already keep their OWN persistent rule-table
// storage (`boot/fw_state.S` on Pi 1, `boot/rpi4/filter_state.S` on
// Pi 4/5 -- both pre-existing, unchanged by this package) behind a
// small set of extern accessors; a consumer's own thin adapter reads
// its board's current state into a `FilterConfig`, calls this
// package's pure functions, and writes the result back. This is the
// SAME shape every stateful kosh package in this project uses, just
// applied to a rule table instead of a hash/MAC accumulator -- proves
// the pattern scales before the bigger ARP-cache/TCP-connection/
// DHCP-lease-table state structs planned for later versions.

// 8 rule slots, matching BOTH existing boards' own fixed capacity
// (`boot/fw_state.S`/`boot/rpi4/filter_state.S`, "8-slot fixed
// array" by original design, not a limit this package introduces).
struct FilterConfig {
  rule_count: i64,
  default_policy: u32,
  proto: [u32; 8],
  src_ip: [u32; 8],
  src_ip_valid: [u32; 8],
  dst_port: [u32; 8],
  dst_port_valid: [u32; 8],
  action: [u32; 8]
}

struct FilterAddResult { cfg: FilterConfig, ok: i64 }

fn netstack_filter_empty() -> FilterConfig {
  return FilterConfig {
    rule_count: 0,
    default_policy: 0 as u32,
    proto: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    src_ip: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    src_ip_valid: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    dst_port: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    dst_port_valid: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    action: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32]
  };
}

// Appends a rule (first-match-wins order, matching both boards' own
// semantics). Returns `ok: 0` on success, `ok: -1` if the table is
// already full (8 rules) -- same convention as the original `fw_add_
// rule`/`filter_add_rule` extern accessors this replaces.
fn netstack_filter_add_rule(cfg_in: FilterConfig, proto: u32, src_ip: u32, src_ip_valid: u32, dst_port: u32, dst_port_valid: u32, action: u32) -> FilterAddResult {
  let cfg: FilterConfig = cfg_in;
  if cfg.rule_count >= 8 {
    return FilterAddResult { cfg: cfg, ok: 0 - 1 };
  }
  let slot: i64 = cfg.rule_count;
  // vani has no `struct_var.array_field[index] = value` lvalue form
  // (confirmed via a standalone probe -- reading `f.vals[i]` works,
  // assigning through it does not), so each array field is copied out
  // to a local, mutated there, and the whole struct rebuilt via a
  // fresh literal -- same pattern crypto_hash's own `sha256_update`
  // already uses for its `ctx.h`/`ctx.carry` fields.
  let proto_arr: [u32; 8] = [cfg.proto[0], cfg.proto[1], cfg.proto[2], cfg.proto[3], cfg.proto[4], cfg.proto[5], cfg.proto[6], cfg.proto[7]];
  let src_ip_arr: [u32; 8] = [cfg.src_ip[0], cfg.src_ip[1], cfg.src_ip[2], cfg.src_ip[3], cfg.src_ip[4], cfg.src_ip[5], cfg.src_ip[6], cfg.src_ip[7]];
  let src_ip_valid_arr: [u32; 8] = [cfg.src_ip_valid[0], cfg.src_ip_valid[1], cfg.src_ip_valid[2], cfg.src_ip_valid[3], cfg.src_ip_valid[4], cfg.src_ip_valid[5], cfg.src_ip_valid[6], cfg.src_ip_valid[7]];
  let dst_port_arr: [u32; 8] = [cfg.dst_port[0], cfg.dst_port[1], cfg.dst_port[2], cfg.dst_port[3], cfg.dst_port[4], cfg.dst_port[5], cfg.dst_port[6], cfg.dst_port[7]];
  let dst_port_valid_arr: [u32; 8] = [cfg.dst_port_valid[0], cfg.dst_port_valid[1], cfg.dst_port_valid[2], cfg.dst_port_valid[3], cfg.dst_port_valid[4], cfg.dst_port_valid[5], cfg.dst_port_valid[6], cfg.dst_port_valid[7]];
  let action_arr: [u32; 8] = [cfg.action[0], cfg.action[1], cfg.action[2], cfg.action[3], cfg.action[4], cfg.action[5], cfg.action[6], cfg.action[7]];

  proto_arr[slot] = proto;
  src_ip_arr[slot] = src_ip;
  src_ip_valid_arr[slot] = src_ip_valid;
  dst_port_arr[slot] = dst_port;
  dst_port_valid_arr[slot] = dst_port_valid;
  action_arr[slot] = action;

  let new_cfg: FilterConfig = FilterConfig {
    rule_count: slot + 1,
    default_policy: cfg.default_policy,
    proto: proto_arr,
    src_ip: src_ip_arr,
    src_ip_valid: src_ip_valid_arr,
    dst_port: dst_port_arr,
    dst_port_valid: dst_port_valid_arr,
    action: action_arr
  };
  return FilterAddResult { cfg: new_cfg, ok: 0 };
}

fn netstack_filter_flush(cfg_in: FilterConfig) -> FilterConfig {
  let cfg: FilterConfig = cfg_in;
  cfg.rule_count = 0;
  return cfg;
}

fn netstack_filter_set_default_policy(cfg_in: FilterConfig, policy: u32) -> FilterConfig {
  let cfg: FilterConfig = cfg_in;
  cfg.default_policy = policy;
  return cfg;
}

// Read-only frame-field helpers, scoped to exactly what the filter
// itself needs (ethertype, IPv4 protocol/src/dst, TCP/UDP dst_port)
// -- deliberately NOT the full IPv4/TCP/UDP modules planned for a
// later package version, matching the exact reasoning Pi 4/5's own
// `tcp_get_dst_port_rpi4`/`udp_get_dst_port_rpi4` already documented
// ("deliberately tiny stub accessors, not full protocol modules...
// the filter only ever needs the 2-byte dst_port field").
fn netstack_read_u16_be(buf: ref [u8; 512], off: i64) -> u32 {
  let b0: u32 = buf[off] as u32;
  let b1: u32 = buf[off + 1] as u32;
  return (b0 << (8 as u32)) | b1;
}

fn netstack_read_u32_be(buf: ref [u8; 512], off: i64) -> u32 {
  let b0: u32 = buf[off] as u32;
  let b1: u32 = buf[off + 1] as u32;
  let b2: u32 = buf[off + 2] as u32;
  let b3: u32 = buf[off + 3] as u32;
  return (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3;
}

fn netstack_write_u16_be(buf: mut ref [u8; 512], off: i64, v: u32) -> i64 {
  buf[off] = ((v >> (8 as u32)) & (255 as u32)) as u8;
  buf[off + 1] = (v & (255 as u32)) as u8;
  return 0;
}

fn netstack_write_u32_be(buf: mut ref [u8; 512], off: i64, v: u32) -> i64 {
  buf[off] = ((v >> (24 as u32)) & (255 as u32)) as u8;
  buf[off + 1] = ((v >> (16 as u32)) & (255 as u32)) as u8;
  buf[off + 2] = ((v >> (8 as u32)) & (255 as u32)) as u8;
  buf[off + 3] = (v & (255 as u32)) as u8;
  return 0;
}

// Checks one frame (Ethernet header at offset 0, IPv4 header at
// offset 14 when present) against `cfg`'s rule table, first-match-
// wins, falling through to `cfg.default_policy`. `is_outgoing`
// flips which IP field plays the rule's own "src_ip" role: a rule's
// `src_ip` field always means "the other party," so for an OUTGOING
// frame that's the frame's own DESTINATION IP, not its (usually
// unset) source IP. Non-IPv4 frames (e.g. ARP) and frames too short
// to parse always return 1 (allow) -- not this filter's job to
// bounds-check or filter what it can't parse.
fn netstack_filter_check_frame(frame: ref [u8; 512], frame_len: i64, is_outgoing: u32, cfg: ref FilterConfig) -> u32 {
  if frame_len < 34 {
    return 1 as u32;
  }
  if netstack_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 1 as u32;
  }
  let proto: u32 = frame[14 + 9] as u32;
  let src_ip: u32 = if is_outgoing == (1 as u32) { netstack_read_u32_be(frame, 14 + 16) } else { netstack_read_u32_be(frame, 14 + 12) };
  let dst_port: u32 = 0 as u32;
  let has_port: u32 = 0 as u32;
  if (proto == (6 as u32)) && (frame_len >= 38) {
    dst_port = netstack_read_u16_be(frame, 34 + 2);
    has_port = 1 as u32;
  }
  if (proto == (17 as u32)) && (frame_len >= 38) {
    dst_port = netstack_read_u16_be(frame, 34 + 2);
    has_port = 1 as u32;
  }

  let count: i64 = cfg.rule_count;
  let i: i64 = 0;
  while i < count {
    let rule_proto: u32 = cfg.proto[i];
    let proto_matches: u32 = if (rule_proto == (0 as u32)) || (rule_proto == proto) { 1 as u32 } else { 0 as u32 };
    let rule_src_valid: u32 = cfg.src_ip_valid[i];
    let src_matches: u32 = if (rule_src_valid == (0 as u32)) || (cfg.src_ip[i] == src_ip) { 1 as u32 } else { 0 as u32 };
    let rule_port_valid: u32 = cfg.dst_port_valid[i];
    let port_matches: u32 = if (rule_port_valid == (0 as u32)) || ((has_port == (1 as u32)) && (cfg.dst_port[i] == dst_port)) { 1 as u32 } else { 0 as u32 };
    if (proto_matches == (1 as u32)) && (src_matches == (1 as u32)) && (port_matches == (1 as u32)) {
      return cfg.action[i];
    }
    i = i + 1;
  }
  return cfg.default_policy;
}

fn netstack_filter_build_test_frame(frame: mut ref [u8; 512], proto: u32, src_ip: u32, dst_port: u32) -> i64 {
  let hi: u32 = (0x0800 as u32 >> (8 as u32)) & (255 as u32);
  let lo: u32 = 0x0800 as u32 & (255 as u32);
  frame[12] = hi as u8;
  frame[13] = lo as u8;
  frame[23] = proto as u8; // ip_offset(14)+9
  frame[26] = ((src_ip >> (24 as u32)) & (255 as u32)) as u8;
  frame[27] = ((src_ip >> (16 as u32)) & (255 as u32)) as u8;
  frame[28] = ((src_ip >> (8 as u32)) & (255 as u32)) as u8;
  frame[29] = (src_ip & (255 as u32)) as u8;
  frame[36] = ((dst_port >> (8 as u32)) & (255 as u32)) as u8; // tcp/udp_offset(34)+2
  frame[37] = (dst_port & (255 as u32)) as u8;
  return 38;
}

fn netstack_filter_build_test_frame_dst(frame: mut ref [u8; 512], proto: u32, dst_ip: u32, dst_port: u32) -> i64 {
  frame[12] = 0x08 as u8;
  frame[13] = 0x00 as u8;
  frame[23] = proto as u8;
  frame[30] = ((dst_ip >> (24 as u32)) & (255 as u32)) as u8; // ip_offset(14)+16
  frame[31] = ((dst_ip >> (16 as u32)) & (255 as u32)) as u8;
  frame[32] = ((dst_ip >> (8 as u32)) & (255 as u32)) as u8;
  frame[33] = (dst_ip & (255 as u32)) as u8;
  frame[36] = ((dst_port >> (8 as u32)) & (255 as u32)) as u8;
  frame[37] = (dst_port & (255 as u32)) as u8;
  return 38;
}

fn netstack_zero_frame() -> [u8; 512] {
  let a: [u8; 64] = [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let out: [u8; 512] = [
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63]
  ];
  return out;
}


// Direct port of both boards' own `filter_self_test`/`filter_self_
// test_rpi4` (6 scenarios: no-rule default, specific-deny-overrides-
// allow, protocol specificity, first-match-wins ordering, portless-
// protocol never matches a port rule, non-IPv4 passthrough) plus
// scenario 1 of `filter_outgoing_self_test`/`_rpi4` (directional
// src/dst semantics for outgoing frames -- the real netif egress-hook
// integration itself, scenario 2 of that test, is inherently board-
// specific and stays in each kernel's own self-test).
fn netstack_filter_self_test() -> i64 {
  let ok: i64 = 1;
  let ip_a: u32 = 0x0A000001 as u32; // 10.0.0.1
  let ip_b: u32 = 0x0A000002 as u32; // 10.0.0.2

  // 1. No rules at all: falls through to the default policy.
  let cfg0: FilterConfig = netstack_filter_empty();
  let cfg1: FilterConfig = netstack_filter_set_default_policy(cfg0, 0 as u32);
  let f1: [u8; 512] = netstack_zero_frame();
  let l1: i64 = netstack_filter_build_test_frame(mut ref f1, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f1, l1, 0 as u32, ref cfg1) != (0 as u32) { ok = 0; }

  // 2. A specific deny rule overrides a permissive default, but only
  // for the src_ip it actually names.
  let cfg2: FilterConfig = netstack_filter_set_default_policy(cfg1, 1 as u32);
  let add2: FilterAddResult = netstack_filter_add_rule(cfg2, 6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32);
  let cfg3: FilterConfig = add2.cfg;
  let f2: [u8; 512] = netstack_zero_frame();
  let l2: i64 = netstack_filter_build_test_frame(mut ref f2, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f2, l2, 0 as u32, ref cfg3) != (0 as u32) { ok = 0; }
  let f3: [u8; 512] = netstack_zero_frame();
  let l3: i64 = netstack_filter_build_test_frame(mut ref f3, 6 as u32, ip_b, 80 as u32);
  if netstack_filter_check_frame(ref f3, l3, 0 as u32, ref cfg3) != (1 as u32) { ok = 0; }

  // 3. Protocol specificity: the same rule must not match UDP traffic
  // on the identical src_ip/port.
  let f4: [u8; 512] = netstack_zero_frame();
  let l4: i64 = netstack_filter_build_test_frame(mut ref f4, 17 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f4, l4, 0 as u32, ref cfg3) != (1 as u32) { ok = 0; }

  // 4. First-match-wins: an earlier wildcard deny must shadow a later,
  // more specific allow rule.
  let cfg4: FilterConfig = netstack_filter_flush(cfg3);
  let add4a: FilterAddResult = netstack_filter_add_rule(cfg4, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32); // deny everything
  let add4b: FilterAddResult = netstack_filter_add_rule(add4a.cfg, 6 as u32, 0 as u32, 0 as u32, 443 as u32, 1 as u32, 1 as u32); // allow TCP/443 (shadowed)
  let cfg5: FilterConfig = add4b.cfg;
  let f5: [u8; 512] = netstack_zero_frame();
  let l5: i64 = netstack_filter_build_test_frame(mut ref f5, 6 as u32, ip_a, 443 as u32);
  if netstack_filter_check_frame(ref f5, l5, 0 as u32, ref cfg5) != (0 as u32) { ok = 0; }

  // 5. A rule naming a specific dst_port must never match a portless
  // protocol (ICMP).
  let cfg6: FilterConfig = netstack_filter_flush(cfg5);
  let add6: FilterAddResult = netstack_filter_add_rule(cfg6, 0 as u32, 0 as u32, 0 as u32, 80 as u32, 1 as u32, 0 as u32); // deny port 80
  let cfg7: FilterConfig = netstack_filter_set_default_policy(add6.cfg, 1 as u32);
  let f6: [u8; 512] = netstack_zero_frame();
  let l6: i64 = netstack_filter_build_test_frame(mut ref f6, 1 as u32, ip_a, 80 as u32); // ICMP
  if netstack_filter_check_frame(ref f6, l6, 0 as u32, ref cfg7) != (1 as u32) { ok = 0; }

  // 6. Non-IPv4 traffic (e.g. ARP) passes through untouched regardless
  // of policy or rules.
  let cfg8: FilterConfig = netstack_filter_set_default_policy(cfg7, 0 as u32);
  let f7: [u8; 512] = netstack_zero_frame();
  f7[12] = 0x08 as u8;
  f7[13] = 0x06 as u8; // ethertype: ARP
  if netstack_filter_check_frame(ref f7, 38, 0 as u32, ref cfg8) != (1 as u32) { ok = 0; }

  // 7. Directional src/dst semantics: a rule naming ip_a must match an
  // OUTGOING frame whose DESTINATION is ip_a, not its (usually unset)
  // literal source-IP field -- and the identical frame checked as
  // INCOMING must NOT match.
  let cfg9: FilterConfig = netstack_filter_flush(cfg8);
  let cfg10: FilterConfig = netstack_filter_set_default_policy(cfg9, 1 as u32);
  let add10: FilterAddResult = netstack_filter_add_rule(cfg10, 6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32); // deny TCP/80 to ip_a
  let cfg11: FilterConfig = add10.cfg;
  let f8: [u8; 512] = netstack_zero_frame();
  let l8: i64 = netstack_filter_build_test_frame_dst(mut ref f8, 6 as u32, ip_a, 80 as u32);
  if netstack_filter_check_frame(ref f8, l8, 1 as u32, ref cfg11) != (0 as u32) { ok = 0; }
  if netstack_filter_check_frame(ref f8, l8, 0 as u32, ref cfg11) != (1 as u32) { ok = 0; }
  let f9: [u8; 512] = netstack_zero_frame();
  let l9: i64 = netstack_filter_build_test_frame_dst(mut ref f9, 6 as u32, ip_b, 80 as u32);
  if netstack_filter_check_frame(ref f9, l9, 1 as u32, ref cfg11) != (1 as u32) { ok = 0; }

  return ok;
}

// ---------------------------------------------------------------
// ARP (RFC 826). Field layout within the full 42-byte frame, after
// the 14-byte Ethernet dst/src/ethertype header:
//   14-15 hwtype(1=Ethernet)  16-17 ptype(0x0800=IPv4)
//   18 hwlen(6)  19 plen(4)  20-21 op(1=request,2=reply)
//   22-27 sender_mac  28-31 sender_ip
//   32-37 target_mac  38-41 target_ip
// Extracted from DhruvaOS's Pi 1 (`kernel_main.vani`, `arp_*`) and
// Pi 4/5 (`kernel_main_rpi4.vani`, `arp_*_rpi4`) kernels -- both
// already direct ports of each other per their own header comments,
// confirmed identical algorithms before porting here.
//
// `ArpCache` extends the same value-type-state design `FilterConfig`
// established: an 8-slot cache (matching both boards' own existing
// `boot/arp_state.S`/`boot/rpi4/arp_state.S` capacity), MAC bytes
// flattened into one `[u8; 48]` array (slot i's MAC at indices
// `i*6..i*6+6`) matching the same flattened representation the
// extern accessors this replaces already use.
// ---------------------------------------------------------------

struct ArpCache { count: i64, next_slot: i64, ip: [u32; 8], mac_bytes: [u8; 48] }
struct ArpLookupResult { found: i64, mac: [u8; 6] }

fn netstack_arp_cache_empty() -> ArpCache {
  return ArpCache {
    count: 0,
    next_slot: 0,
    ip: [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32],
    mac_bytes: [
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
    ]
  };
}

// Looks up `ip` in the cache; `found: 1` and `mac` populated if
// present, `found: 0` (mac left as zeros) otherwise.
fn netstack_arp_cache_lookup(cache: ref ArpCache, ip: u32) -> ArpLookupResult {
  let i: i64 = 0;
  while i < cache.count {
    if cache.ip[i] == ip {
      let mac: [u8; 6] = [
        cache.mac_bytes[i * 6], cache.mac_bytes[i * 6 + 1], cache.mac_bytes[i * 6 + 2],
        cache.mac_bytes[i * 6 + 3], cache.mac_bytes[i * 6 + 4], cache.mac_bytes[i * 6 + 5]
      ];
      return ArpLookupResult { found: 1, mac: mac };
    }
    i = i + 1;
  }
  return ArpLookupResult { found: 0, mac: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8] };
}

// Inserts/updates an IP -> MAC mapping. Updates in place if the IP is
// already cached; otherwise appends while there's room (8 slots), or
// overwrites the oldest entry round-robin once full -- a demo-scoped
// cache, not a production one with real aging/timeouts (matching both
// boards' own original design).
fn netstack_arp_cache_insert(cache_in: ArpCache, ip: u32, mac: ref [u8; 6]) -> ArpCache {
  let cache: ArpCache = cache_in;
  let ip_arr: [u32; 8] = [cache.ip[0], cache.ip[1], cache.ip[2], cache.ip[3], cache.ip[4], cache.ip[5], cache.ip[6], cache.ip[7]];
  let mac_arr: [u8; 48] = [
    cache.mac_bytes[0], cache.mac_bytes[1], cache.mac_bytes[2], cache.mac_bytes[3], cache.mac_bytes[4], cache.mac_bytes[5],
    cache.mac_bytes[6], cache.mac_bytes[7], cache.mac_bytes[8], cache.mac_bytes[9], cache.mac_bytes[10], cache.mac_bytes[11],
    cache.mac_bytes[12], cache.mac_bytes[13], cache.mac_bytes[14], cache.mac_bytes[15], cache.mac_bytes[16], cache.mac_bytes[17],
    cache.mac_bytes[18], cache.mac_bytes[19], cache.mac_bytes[20], cache.mac_bytes[21], cache.mac_bytes[22], cache.mac_bytes[23],
    cache.mac_bytes[24], cache.mac_bytes[25], cache.mac_bytes[26], cache.mac_bytes[27], cache.mac_bytes[28], cache.mac_bytes[29],
    cache.mac_bytes[30], cache.mac_bytes[31], cache.mac_bytes[32], cache.mac_bytes[33], cache.mac_bytes[34], cache.mac_bytes[35],
    cache.mac_bytes[36], cache.mac_bytes[37], cache.mac_bytes[38], cache.mac_bytes[39], cache.mac_bytes[40], cache.mac_bytes[41],
    cache.mac_bytes[42], cache.mac_bytes[43], cache.mac_bytes[44], cache.mac_bytes[45], cache.mac_bytes[46], cache.mac_bytes[47]
  ];

  let i: i64 = 0;
  while i < cache.count {
    if ip_arr[i] == ip {
      mac_arr[i * 6] = mac[0];
      mac_arr[i * 6 + 1] = mac[1];
      mac_arr[i * 6 + 2] = mac[2];
      mac_arr[i * 6 + 3] = mac[3];
      mac_arr[i * 6 + 4] = mac[4];
      mac_arr[i * 6 + 5] = mac[5];
      return ArpCache { count: cache.count, next_slot: cache.next_slot, ip: ip_arr, mac_bytes: mac_arr };
    }
    i = i + 1;
  }

  let slot: i64 = 0;
  let new_count: i64 = cache.count;
  let new_next_slot: i64 = cache.next_slot;
  if cache.count < 8 {
    slot = cache.count;
    new_count = cache.count + 1;
  } else {
    slot = cache.next_slot;
    new_next_slot = (cache.next_slot + 1) % 8;
  }
  ip_arr[slot] = ip;
  mac_arr[slot * 6] = mac[0];
  mac_arr[slot * 6 + 1] = mac[1];
  mac_arr[slot * 6 + 2] = mac[2];
  mac_arr[slot * 6 + 3] = mac[3];
  mac_arr[slot * 6 + 4] = mac[4];
  mac_arr[slot * 6 + 5] = mac[5];
  return ArpCache { count: new_count, next_slot: new_next_slot, ip: ip_arr, mac_bytes: mac_arr };
}

fn netstack_arp_build_request(out_frame: mut ref [u8; 512], my_mac: ref [u8; 6], my_ip: u32, target_ip: u32) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    out_frame[i] = 0xFF as u8; // dst: broadcast
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    out_frame[6 + j] = my_mac[j];
    j = j + 1;
  }
  let _ = netstack_write_u16_be(out_frame, 12, 0x0806 as u32); // ethertype: ARP
  let _ = netstack_write_u16_be(out_frame, 14, 1 as u32);      // hwtype: Ethernet
  let _ = netstack_write_u16_be(out_frame, 16, 0x0800 as u32); // ptype: IPv4
  out_frame[18] = 6 as u8;
  out_frame[19] = 4 as u8;
  let _ = netstack_write_u16_be(out_frame, 20, 1 as u32); // op: request
  let k: i64 = 0;
  while k < 6 {
    out_frame[22 + k] = my_mac[k]; // sender mac
    k = k + 1;
  }
  let _ = netstack_write_u32_be(out_frame, 28, my_ip);
  let m: i64 = 0;
  while m < 6 {
    out_frame[32 + m] = 0 as u8; // target mac: unknown
    m = m + 1;
  }
  let _ = netstack_write_u32_be(out_frame, 38, target_ip);
  return 42;
}

fn netstack_arp_build_reply(out_frame: mut ref [u8; 512], my_mac: ref [u8; 6], my_ip: u32, requester_mac: ref [u8; 6], requester_ip: u32) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    out_frame[i] = requester_mac[i]; // dst: the requester
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    out_frame[6 + j] = my_mac[j];
    j = j + 1;
  }
  let _ = netstack_write_u16_be(out_frame, 12, 0x0806 as u32);
  let _ = netstack_write_u16_be(out_frame, 14, 1 as u32);
  let _ = netstack_write_u16_be(out_frame, 16, 0x0800 as u32);
  out_frame[18] = 6 as u8;
  out_frame[19] = 4 as u8;
  let _ = netstack_write_u16_be(out_frame, 20, 2 as u32); // op: reply
  let k: i64 = 0;
  while k < 6 {
    out_frame[22 + k] = my_mac[k]; // sender: us
    k = k + 1;
  }
  let _ = netstack_write_u32_be(out_frame, 28, my_ip);
  let m: i64 = 0;
  while m < 6 {
    out_frame[32 + m] = requester_mac[m]; // target: the requester
    m = m + 1;
  }
  let _ = netstack_write_u32_be(out_frame, 38, requester_ip);
  return 42;
}

fn netstack_arp_get_ethertype(frame: ref [u8; 512]) -> u32 {
  return netstack_read_u16_be(frame, 12);
}

fn netstack_arp_is_arp_frame(frame: ref [u8; 512]) -> i64 {
  if netstack_arp_get_ethertype(frame) == (0x0806 as u32) {
    return 1;
  }
  return 0;
}

fn netstack_arp_get_operation(frame: ref [u8; 512]) -> u32 {
  return netstack_read_u16_be(frame, 20);
}

fn netstack_arp_get_sender_ip(frame: ref [u8; 512]) -> u32 {
  return netstack_read_u32_be(frame, 28);
}

fn netstack_arp_get_target_ip(frame: ref [u8; 512]) -> u32 {
  return netstack_read_u32_be(frame, 38);
}

fn netstack_arp_get_sender_mac(frame: ref [u8; 512], out_mac: mut ref [u8; 6]) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    out_mac[i] = frame[22 + i];
    i = i + 1;
  }
  return 0;
}

// Direct port of both boards' own `arp_self_test`/`arp_self_test_
// rpi4`: build+parse a request and a reply (round-tripping every
// field), then exercise the cache (insert, lookup, lookup-miss, and
// update-in-place).
fn netstack_arp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x01 as u8];
  let my_ip: u32 = 0xC0A80101 as u32;     // 192.168.1.1
  let target_ip: u32 = 0xC0A80102 as u32; // 192.168.1.2

  let req_frame: [u8; 512] = netstack_zero_frame();
  let req_len: i64 = netstack_arp_build_request(mut ref req_frame, ref my_mac, my_ip, target_ip);
  if req_len != 42 { ok = 0; }
  if netstack_arp_is_arp_frame(ref req_frame) != 1 { ok = 0; }
  if netstack_arp_get_operation(ref req_frame) != (1 as u32) { ok = 0; }
  if netstack_arp_get_sender_ip(ref req_frame) != my_ip { ok = 0; }
  if netstack_arp_get_target_ip(ref req_frame) != target_ip { ok = 0; }
  let req_sender_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netstack_arp_get_sender_mac(ref req_frame, mut ref req_sender_mac);
  let si: i64 = 0;
  while si < 6 {
    if req_sender_mac[si] != my_mac[si] { ok = 0; }
    si = si + 1;
  }

  let peer_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x02 as u8];
  let reply_frame: [u8; 512] = netstack_zero_frame();
  let reply_len: i64 = netstack_arp_build_reply(mut ref reply_frame, ref peer_mac, target_ip, ref my_mac, my_ip);
  if reply_len != 42 { ok = 0; }
  if netstack_arp_get_operation(ref reply_frame) != (2 as u32) { ok = 0; }
  if netstack_arp_get_sender_ip(ref reply_frame) != target_ip { ok = 0; }
  if netstack_arp_get_target_ip(ref reply_frame) != my_ip { ok = 0; }

  // Cache exercise: miss, insert, hit, update-in-place.
  let cache0: ArpCache = netstack_arp_cache_empty();
  let miss: ArpLookupResult = netstack_arp_cache_lookup(ref cache0, target_ip);
  if miss.found != 0 { ok = 0; }

  let cache1: ArpCache = netstack_arp_cache_insert(cache0, target_ip, ref peer_mac);
  let hit: ArpLookupResult = netstack_arp_cache_lookup(ref cache1, target_ip);
  if hit.found != 1 { ok = 0; }
  if hit.mac[5] != (0x02 as u8) { ok = 0; }

  let updated_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x09 as u8];
  let cache2: ArpCache = netstack_arp_cache_insert(cache1, target_ip, ref updated_mac);
  let updated: ArpLookupResult = netstack_arp_cache_lookup(ref cache2, target_ip);
  if updated.found != 1 { ok = 0; }
  if updated.mac[5] != (0x09 as u8) { ok = 0; }
  if cache2.count != 1 { ok = 0; } // update-in-place, not a 2nd entry

  return ok;
}

// ---------------------------------------------------------------
// IPv4 (RFC 791, header only -- no options, no fragmentation).
// Deliberately operates on a STANDALONE 20-byte header buffer, not
// an offset within a larger Ethernet frame the way the original Pi 1
// (`ipv4_*`) and Pi 4/5 (`ipv4_*_rpi4`) functions this replaces did
// -- those took the WHOLE frame (`ip_offset` locating the header
// within it) purely as an artifact of being ported inline into each
// board's own send/receive path, even though the algorithm itself
// only ever reads/writes the 20 bytes at that offset. Splitting the
// header codec out as its own `[u8; 20]` buffer removes any
// dependency on the caller's overall frame size entirely -- avoiding
// the exact class of "package's fixed array cap too small for a real
// board's frame" problem `curve25519`'s own Ed25519 `msg` cap hit in
// round 100 (Pi 1's own real frames run up to 1514 bytes, Pi 4/5's
// only to 512 -- a header codec has no reason to care about either
// number). Each board's own adapter copies its 20-byte header window
// out of its real (differently-sized) frame buffer, calls these
// functions, and copies the result back -- the actual frame-level
// send/receive path (which DOES need to know its own frame size)
// stays entirely board-specific, unmigrated, same as ARP's own
// `arp_resolve_start`/`poll`.
//
// Header layout (RFC 791 section 3.1, no options -- IHL always 5):
//   0 version(4 bits)+IHL(4 bits)   1 DSCP+ECN (unused, 0)
//   2-3 total length (header+payload)   4-5 identification (unused, 0)
//   6-7 flags+fragment offset (unused, 0 -- no fragmentation support)
//   8 TTL   9 protocol (1=ICMP, 6=TCP, 17=UDP)
//   10-11 header checksum   12-15 source IP   16-19 destination IP
// ---------------------------------------------------------------

fn netstack_zero20_bytes() -> [u8; 20] {
  return [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
}

// Internet checksum (RFC 791 section 3.1/RFC 1071): one's-complement
// sum of the header's 10 big-endian 16-bit words, folded to 16 bits.
fn netstack_ipv4_checksum(hdr: ref [u8; 20]) -> u32 {
  let sum: u32 = 0 as u32;
  let i: i64 = 0;
  while i < 20 {
    let hi: u32 = hdr[i] as u32;
    let lo: u32 = hdr[i + 1] as u32;
    let word: u32 = (hi << (8 as u32)) | lo;
    sum = sum + word;
    i = i + 2;
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  return sum & (0xFFFF as u32);
}

fn netstack_ipv4_build_header(total_len: i64, protocol: u32, src_ip: u32, dst_ip: u32) -> [u8; 20] {
  let hdr: [u8; 20] = netstack_zero20_bytes();
  hdr[0] = 0x45 as u8; // version 4, IHL 5
  hdr[1] = 0 as u8;
  let tl0: u32 = (total_len as u32 >> (8 as u32)) & (255 as u32);
  let tl1: u32 = total_len as u32 & (255 as u32);
  hdr[2] = tl0 as u8;
  hdr[3] = tl1 as u8;
  hdr[4] = 0 as u8;
  hdr[5] = 0 as u8;
  hdr[6] = 0 as u8;
  hdr[7] = 0 as u8;
  hdr[8] = 64 as u8; // TTL
  hdr[9] = protocol as u8;
  hdr[10] = 0 as u8; // checksum placeholder
  hdr[11] = 0 as u8;
  hdr[12] = ((src_ip >> (24 as u32)) & (255 as u32)) as u8;
  hdr[13] = ((src_ip >> (16 as u32)) & (255 as u32)) as u8;
  hdr[14] = ((src_ip >> (8 as u32)) & (255 as u32)) as u8;
  hdr[15] = (src_ip & (255 as u32)) as u8;
  hdr[16] = ((dst_ip >> (24 as u32)) & (255 as u32)) as u8;
  hdr[17] = ((dst_ip >> (16 as u32)) & (255 as u32)) as u8;
  hdr[18] = ((dst_ip >> (8 as u32)) & (255 as u32)) as u8;
  hdr[19] = (dst_ip & (255 as u32)) as u8;
  // One's complement of the sum, computed with the checksum field
  // itself still zero -- standard IPv4 checksum construction.
  let checksum: u32 = (netstack_ipv4_checksum(ref hdr) ^ (0xFFFF as u32)) & (0xFFFF as u32);
  hdr[10] = ((checksum >> (8 as u32)) & (255 as u32)) as u8;
  hdr[11] = (checksum & (255 as u32)) as u8;
  return hdr;
}

fn netstack_ipv4_get_total_len(hdr: ref [u8; 20]) -> u32 {
  return ((hdr[2] as u32) << (8 as u32)) | (hdr[3] as u32);
}

fn netstack_ipv4_get_protocol(hdr: ref [u8; 20]) -> u32 {
  return hdr[9] as u32;
}

fn netstack_ipv4_get_src_ip(hdr: ref [u8; 20]) -> u32 {
  return ((hdr[12] as u32) << (24 as u32)) | ((hdr[13] as u32) << (16 as u32)) | ((hdr[14] as u32) << (8 as u32)) | (hdr[15] as u32);
}

fn netstack_ipv4_get_dst_ip(hdr: ref [u8; 20]) -> u32 {
  return ((hdr[16] as u32) << (24 as u32)) | ((hdr[17] as u32) << (16 as u32)) | ((hdr[18] as u32) << (8 as u32)) | (hdr[19] as u32);
}

// A correctly-checksummed header sums (as transmitted, checksum
// field included) to all-ones -- avoids needing to zero the field
// out again to re-check it.
fn netstack_ipv4_verify_checksum(hdr: ref [u8; 20]) -> i64 {
  if netstack_ipv4_checksum(hdr) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

// Build + field round trip + checksum verify + tamper-detection --
// the header-codec-only subset of both boards' own `ipv4_self_test`/
// `ipv4_self_test_rpi4` (their own frame-level send/recv/payload
// checks stay in each kernel's own self-test, since this package has
// no frame/netif concept at all).
fn netstack_ipv4_self_test() -> i64 {
  let ok: i64 = 1;
  let src_ip: u32 = 0xC0A80101 as u32; // 192.168.1.1
  let dst_ip: u32 = 0xC0A80102 as u32; // 192.168.1.2

  let hdr: [u8; 20] = netstack_ipv4_build_header(22, 17 as u32, src_ip, dst_ip);
  if netstack_ipv4_get_total_len(ref hdr) != (22 as u32) { ok = 0; }
  if netstack_ipv4_get_protocol(ref hdr) != (17 as u32) { ok = 0; }
  if netstack_ipv4_get_src_ip(ref hdr) != src_ip { ok = 0; }
  if netstack_ipv4_get_dst_ip(ref hdr) != dst_ip { ok = 0; }
  if netstack_ipv4_verify_checksum(ref hdr) != 1 { ok = 0; }

  // A tampered header (single flipped bit in the TTL field) must fail
  // checksum verification -- the actual integrity property, not just
  // "produces *a* checksum".
  let bad_hdr: [u8; 20] = [
    hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5], hdr[6], hdr[7], hdr[8] ^ (1 as u8), hdr[9],
    hdr[10], hdr[11], hdr[12], hdr[13], hdr[14], hdr[15], hdr[16], hdr[17], hdr[18], hdr[19]
  ];
  if netstack_ipv4_verify_checksum(ref bad_hdr) == 1 { ok = 0; }

  return ok;
}

// ---------------------------------------------------------------
// UDP (RFC 768). Unlike the filter/ARP (fixed 8-slot state) and
// IPv4 (fixed 20-byte header), UDP's own checksum covers the WHOLE
// datagram -- header plus payload, genuinely variable length (up to
// a board's own real MTU: Pi 1's own real frames allow up to ~1472
// bytes of UDP payload, Pi 4/5's loopback-only netif only ~470).
// Rather than pick a package-side array cap sized to either number
// (repeating the exact class of problem `curve25519`'s own Ed25519
// `msg` cap hit before its round-100 streaming rewrite), this module
// uses a genuine streaming checksum -- `UdpChecksumCtx`/`init`/
// `update`/`finalize` -- mirroring `chacha20_poly1305`'s own
// `Poly1305Ctx` design exactly (same running-sum-plus-one-pending-
// byte-of-carry technique, since UDP's checksum is also a 16-bit
// one's-complement running sum over 16-bit words with an odd
// trailing byte needing special handling, just simpler arithmetic
// than Poly1305's own modular polynomial). No cap anywhere in this
// module -- a caller streams a datagram of any length through
// `update` in <=256-byte chunks.
//
// The 8-byte UDP header itself (src_port/dst_port/length/checksum)
// IS small and fixed, so `netstack_udp_header_only`/getters DO use a
// standalone `[u8;8]` buffer, matching IPv4's own header-codec
// precedent -- only the checksum (which spans the payload too) needs
// to stream.
// ---------------------------------------------------------------

struct UdpChecksumCtx { sum: u32, carry_byte: u8, has_carry: i64 }

fn netstack_zero256_bytes() -> [u8; 256] {
  let a: [u8; 64] = [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let out: [u8; 256] = [
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63],
    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
    a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23], a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31],
    a[32], a[33], a[34], a[35], a[36], a[37], a[38], a[39], a[40], a[41], a[42], a[43], a[44], a[45], a[46], a[47],
    a[48], a[49], a[50], a[51], a[52], a[53], a[54], a[55], a[56], a[57], a[58], a[59], a[60], a[61], a[62], a[63]
  ];
  return out;
}

fn netstack_udp_header_only(src_port: u32, dst_port: u32, udp_len: i64) -> [u8; 8] {
  let hdr: [u8; 8] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  hdr[0] = ((src_port >> (8 as u32)) & (255 as u32)) as u8;
  hdr[1] = (src_port & (255 as u32)) as u8;
  hdr[2] = ((dst_port >> (8 as u32)) & (255 as u32)) as u8;
  hdr[3] = (dst_port & (255 as u32)) as u8;
  hdr[4] = ((udp_len as u32 >> (8 as u32)) & (255 as u32)) as u8;
  hdr[5] = (udp_len as u32 & (255 as u32)) as u8;
  hdr[6] = 0 as u8; // checksum placeholder -- caller fills this in
  hdr[7] = 0 as u8; // after streaming the checksum separately
  return hdr;
}

fn netstack_udp_get_src_port(hdr: ref [u8; 8]) -> u32 {
  return ((hdr[0] as u32) << (8 as u32)) | (hdr[1] as u32);
}

fn netstack_udp_get_dst_port(hdr: ref [u8; 8]) -> u32 {
  return ((hdr[2] as u32) << (8 as u32)) | (hdr[3] as u32);
}

fn netstack_udp_get_length(hdr: ref [u8; 8]) -> u32 {
  return ((hdr[4] as u32) << (8 as u32)) | (hdr[5] as u32);
}

fn netstack_udp_encode_checksum(checksum: u32) -> [u8; 2] {
  return [((checksum >> (8 as u32)) & (255 as u32)) as u8, (checksum & (255 as u32)) as u8];
}

// Seeds the running sum with the IPv4 pseudo-header (RFC 768):
// src_ip + dst_ip + protocol(17, UDP) + udp_len (header+payload).
fn netstack_udp_checksum_init(src_ip: u32, dst_ip: u32, udp_len: i64) -> UdpChecksumCtx {
  let sum: u32 = 0 as u32;
  sum = sum + ((src_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (src_ip & (0xFFFF as u32));
  sum = sum + ((dst_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (dst_ip & (0xFFFF as u32));
  sum = sum + (17 as u32);
  sum = sum + (udp_len as u32);
  return UdpChecksumCtx { sum: sum, carry_byte: 0 as u8, has_carry: 0 };
}

// Feeds `chunk_len` bytes (0 <= chunk_len <= 256) of the ACTUAL
// datagram (8-byte header, as-transmitted checksum field included,
// then payload) into the running sum. Call as many times as needed
// -- chunk boundaries don't matter to the result, only the total
// byte sequence across all calls does (same convention as
// crypto_hash's own `sha256_update`). A trailing odd byte from one
// call correctly carries over and pairs with the next call's first
// byte.
fn netstack_udp_checksum_update(ctx_in: UdpChecksumCtx, chunk: ref [u8; 256], chunk_len: i64) -> UdpChecksumCtx {
  let sum: u32 = ctx_in.sum;
  let has_carry: i64 = ctx_in.has_carry;
  let carry_byte: u8 = ctx_in.carry_byte;
  let i: i64 = 0;
  if (has_carry == 1) && (chunk_len > 0) {
    let hi: u32 = carry_byte as u32;
    let lo: u32 = chunk[0] as u32;
    sum = sum + ((hi << (8 as u32)) | lo);
    has_carry = 0;
    i = 1;
  }
  while (i + 1) < chunk_len {
    let hi2: u32 = chunk[i] as u32;
    let lo2: u32 = chunk[i + 1] as u32;
    sum = sum + ((hi2 << (8 as u32)) | lo2);
    i = i + 2;
  }
  if i < chunk_len {
    carry_byte = chunk[i];
    has_carry = 1;
  }
  return UdpChecksumCtx { sum: sum, carry_byte: carry_byte, has_carry: has_carry };
}

// Folds any pending odd trailing byte in, reduces to 16 bits, and
// applies RFC 768's own "never transmit a literal 0, send 0xFFFF
// instead" substitution -- so a valid, as-transmitted datagram
// (checksum field included) always re-sums to exactly 0xFFFF, never
// 0, matching `netstack_ipv4_verify_checksum`'s own convention (NOT
// the same criterion TCP's own checksum uses).
fn netstack_udp_checksum_finalize(ctx: ref UdpChecksumCtx) -> u32 {
  let sum: u32 = ctx.sum;
  if ctx.has_carry == 1 {
    sum = sum + ((ctx.carry_byte as u32) << (8 as u32));
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  let result: u32 = (sum ^ (0xFFFF as u32)) & (0xFFFF as u32);
  if result == (0 as u32) {
    return 0xFFFF as u32;
  }
  return result;
}

// Direct port of both boards' own `udp_self_test`/`udp_self_test_
// rpi4`'s own header-codec-and-checksum-only subset: build a small
// datagram (8-byte header + tiny payload), stream its checksum,
// verify it re-sums to 0xFFFF, then confirm a single flipped payload
// bit breaks that. Frame-level send/recv (this package has no
// netif/frame concept) stays in each kernel's own self-test.
fn netstack_udp_self_test() -> i64 {
  let ok: i64 = 1;
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let src_port: u32 = 12345 as u32;
  let dst_port: u32 = 53 as u32;

  let payload: [u8; 4] = [104 as u8, 105 as u8, 33 as u8, 33 as u8]; // "hi!!"
  let payload_len: i64 = 4;
  let udp_len: i64 = 8 + payload_len;

  let hdr: [u8; 8] = netstack_udp_header_only(src_port, dst_port, udp_len);
  if netstack_udp_get_src_port(ref hdr) != src_port { ok = 0; }
  if netstack_udp_get_dst_port(ref hdr) != dst_port { ok = 0; }
  if netstack_udp_get_length(ref hdr) != (udp_len as u32) { ok = 0; }

  // Stream header (checksum field still 0) + payload through the
  // checksum, in two separate `update` calls -- exercises the
  // cross-call carry path too (8-byte header is even, so no carry
  // actually crosses here, but the 2-call shape itself is the point:
  // proves chunk boundaries don't have to align to anything).
  let ctx0: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let hdr_chunk: [u8; 256] = netstack_zero256_bytes();
  let hi: i64 = 0;
  while hi < 8 {
    hdr_chunk[hi] = hdr[hi];
    hi = hi + 1;
  }
  let ctx1: UdpChecksumCtx = netstack_udp_checksum_update(ctx0, ref hdr_chunk, 8);
  let payload_chunk: [u8; 256] = netstack_zero256_bytes();
  let pi: i64 = 0;
  while pi < payload_len {
    payload_chunk[pi] = payload[pi];
    pi = pi + 1;
  }
  let ctx2: UdpChecksumCtx = netstack_udp_checksum_update(ctx1, ref payload_chunk, payload_len);
  let checksum: u32 = netstack_udp_checksum_finalize(ref ctx2);
  let checksum_bytes: [u8; 2] = netstack_udp_encode_checksum(checksum);

  // Verify: re-stream the FULL as-transmitted datagram (header now
  // with its real checksum filled in) and confirm it folds to
  // 0xFFFF.
  let full_hdr: [u8; 8] = [hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5], checksum_bytes[0], checksum_bytes[1]];
  let vctx0: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let full_hdr_chunk: [u8; 256] = netstack_zero256_bytes();
  let fi: i64 = 0;
  while fi < 8 {
    full_hdr_chunk[fi] = full_hdr[fi];
    fi = fi + 1;
  }
  let vctx1: UdpChecksumCtx = netstack_udp_checksum_update(vctx0, ref full_hdr_chunk, 8);
  let vctx2: UdpChecksumCtx = netstack_udp_checksum_update(vctx1, ref payload_chunk, payload_len);
  let verify_result: u32 = netstack_udp_checksum_finalize(ref vctx2);
  if verify_result != (0xFFFF as u32) { ok = 0; }

  // A tampered payload must fail to re-sum to 0xFFFF.
  let bad_payload_chunk: [u8; 256] = netstack_zero256_bytes();
  let bi: i64 = 0;
  while bi < payload_len {
    bad_payload_chunk[bi] = payload_chunk[bi];
    bi = bi + 1;
  }
  bad_payload_chunk[0] = bad_payload_chunk[0] ^ (1 as u8);
  let bctx0: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let bctx1: UdpChecksumCtx = netstack_udp_checksum_update(bctx0, ref full_hdr_chunk, 8);
  let bctx2: UdpChecksumCtx = netstack_udp_checksum_update(bctx1, ref bad_payload_chunk, payload_len);
  let bad_result: u32 = netstack_udp_checksum_finalize(ref bctx2);
  if bad_result == (0xFFFF as u32) { ok = 0; } // must NOT verify

  return ok;
}

// ---------------------------------------------------------------
// DHCP (RFC 2131/2132) -- BOOTP fixed header build/parse, common
// options (53 Message Type, 50 Requested IP, 54 Server Identifier,
// 51 Lease Time), and the server's own 4-slot lease table. Every
// real DHCP message this stack ever builds is small and fixed-size
// (240-byte header + at most ~16 bytes of options, 256 bytes total
// max) -- unlike UDP's own genuinely-variable-length payload, so
// this module operates on a standalone `[u8;512]` buffer (comfortably
// larger than any real message) plus a `dhcp_offset`, matching the
// filter/ARP precedent (round 106a/106b) rather than IPv4/UDP's own
// offset-independent/streaming designs (round 106c/106d) -- the
// right choice depends on whether the real data is bounded-and-
// small (filter/ARP/DHCP) or genuinely variable-length (IPv4's own
// payload, UDP's own checksum scope), not a fixed rule.
//
// Extracted from DhruvaOS's Pi 1 (`kernel_main.vani`, `dhcp_*`, the
// CLIENT only -- Pi 1 has never had a DHCP server) and Pi 4/5
// (`kernel_main_rpi4.vani`, `dhcp_*_rpi4`, BOTH client and server,
// round 91/92) -- confirmed byte-for-byte identical algorithms
// between the two boards' own client-side code before porting. The
// server-side builders/lease-table below have no Pi 1 counterpart to
// compare against (Pi 1 has no server at all) -- migrated anyway so
// a future Pi 1 server can consume the same primitives Pi 4/5 already
// does, rather than needing its own hand-port later.
//
// NOT migrated (stays board-specific, matching every prior round's
// own "real netif/socket integration stays put" posture): `dhcp_
// client_start`/`poll`/`check_lease` and `dhcp_server_handle_
// discover`/`handle_request`/`poll`/`send_reply` -- all genuinely
// depend on each board's own socket/netif API and timer, not pure
// algorithm.
// ---------------------------------------------------------------

fn netstack_dhcp_op_bootrequest() -> u32 { return 1 as u32; }
fn netstack_dhcp_op_bootreply() -> u32 { return 2 as u32; }
fn netstack_dhcp_htype_ethernet() -> u32 { return 1 as u32; }
fn netstack_dhcp_hlen_ethernet() -> u32 { return 6 as u32; }
fn netstack_dhcp_msgtype_discover() -> u32 { return 1 as u32; }
fn netstack_dhcp_msgtype_offer() -> u32 { return 2 as u32; }
fn netstack_dhcp_msgtype_request() -> u32 { return 3 as u32; }
fn netstack_dhcp_msgtype_ack() -> u32 { return 5 as u32; }
fn netstack_dhcp_msgtype_nak() -> u32 { return 6 as u32; }
fn netstack_dhcp_client_port() -> u32 { return 68 as u32; }
fn netstack_dhcp_server_port() -> u32 { return 67 as u32; }
fn netstack_dhcp_lease_state_free() -> u32 { return 0 as u32; }
fn netstack_dhcp_lease_state_offered() -> u32 { return 1 as u32; }
fn netstack_dhcp_lease_state_bound() -> u32 { return 2 as u32; }

fn netstack_dhcp_zero_range(buf: mut ref [u8; 512], offset: i64, count: i64) -> i64 {
  let i: i64 = 0;
  while i < count {
    buf[offset + i] = 0 as u8;
    i = i + 1;
  }
  return 0;
}

// Writes the 240-byte fixed BOOTP header + magic cookie every DHCP
// message shares, at buf[dhcp_offset..). Shared by both the client's
// own DISCOVER/REQUEST builders (op=BOOTREQUEST) and the server's own
// OFFER/ACK/NAK builders (op=BOOTREPLY) -- one function, not
// duplicated per message type or per role.
fn netstack_dhcp_build_fixed_header(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, op: u32, ciaddr: u32, yiaddr: u32, siaddr: u32) -> i64 {
  buf[dhcp_offset] = op as u8;
  buf[dhcp_offset + 1] = netstack_dhcp_htype_ethernet() as u8;
  buf[dhcp_offset + 2] = netstack_dhcp_hlen_ethernet() as u8;
  buf[dhcp_offset + 3] = 0 as u8; // hops
  let _ = netstack_write_u32_be(buf, dhcp_offset + 4, xid);
  let _ = netstack_write_u16_be(buf, dhcp_offset + 8, 0 as u32); // secs
  let _ = netstack_write_u16_be(buf, dhcp_offset + 10, 0x8000 as u32); // flags: broadcast
  let _ = netstack_write_u32_be(buf, dhcp_offset + 12, ciaddr);
  let _ = netstack_write_u32_be(buf, dhcp_offset + 16, yiaddr);
  let _ = netstack_write_u32_be(buf, dhcp_offset + 20, siaddr);
  let _ = netstack_write_u32_be(buf, dhcp_offset + 24, 0 as u32); // giaddr: no relay agent
  let i: i64 = 0;
  while i < 6 {
    buf[dhcp_offset + 28 + i] = mac[i];
    i = i + 1;
  }
  let _ = netstack_dhcp_zero_range(buf, dhcp_offset + 34, 10); // chaddr padding (16 - 6)
  let _ = netstack_dhcp_zero_range(buf, dhcp_offset + 44, 64); // sname
  let _ = netstack_dhcp_zero_range(buf, dhcp_offset + 108, 128); // file
  buf[dhcp_offset + 236] = 99 as u8;
  buf[dhcp_offset + 237] = 130 as u8;
  buf[dhcp_offset + 238] = 83 as u8;
  buf[dhcp_offset + 239] = 99 as u8;
  return 240;
}

fn netstack_dhcp_build_discover(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32) -> i64 {
  let _ = netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, netstack_dhcp_op_bootrequest(), 0 as u32, 0 as u32, 0 as u32);
  buf[dhcp_offset + 240] = 53 as u8;
  buf[dhcp_offset + 241] = 1 as u8;
  buf[dhcp_offset + 242] = netstack_dhcp_msgtype_discover() as u8;
  buf[dhcp_offset + 243] = 255 as u8; // End
  return 244;
}

// RFC 2131 s4.3.2: the REQUEST following an OFFER echoes the offered
// address back via option 50 and names which server it's accepting
// via option 54.
fn netstack_dhcp_build_request(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, requested_ip: u32, server_ip: u32) -> i64 {
  let _ = netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, netstack_dhcp_op_bootrequest(), 0 as u32, 0 as u32, 0 as u32);
  buf[dhcp_offset + 240] = 53 as u8;
  buf[dhcp_offset + 241] = 1 as u8;
  buf[dhcp_offset + 242] = netstack_dhcp_msgtype_request() as u8;
  buf[dhcp_offset + 243] = 50 as u8;
  buf[dhcp_offset + 244] = 4 as u8;
  let _ = netstack_write_u32_be(buf, dhcp_offset + 245, requested_ip);
  buf[dhcp_offset + 249] = 54 as u8;
  buf[dhcp_offset + 250] = 4 as u8;
  let _ = netstack_write_u32_be(buf, dhcp_offset + 251, server_ip);
  buf[dhcp_offset + 255] = 255 as u8; // End
  return 256;
}

// RFC 2131 s4.3.2: RENEWING/REBINDING's own REQUEST shape -- ciaddr
// set to the already-leased address, no option 50/54.
fn netstack_dhcp_build_renew_request(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, ciaddr: u32) -> i64 {
  let _ = netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, netstack_dhcp_op_bootrequest(), ciaddr, 0 as u32, 0 as u32);
  buf[dhcp_offset + 240] = 53 as u8;
  buf[dhcp_offset + 241] = 1 as u8;
  buf[dhcp_offset + 242] = netstack_dhcp_msgtype_request() as u8;
  buf[dhcp_offset + 243] = 255 as u8; // End
  return 244;
}

// OFFER and ACK share the same option layout (msg type + lease time +
// server identifier); NAK gets its own builder since a real NAK
// carries neither yiaddr nor a lease time.
fn netstack_dhcp_server_build_offer_ack(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, msg_type: u32, yiaddr: u32, server_ip: u32, lease_time: u32) -> i64 {
  let _ = netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, netstack_dhcp_op_bootreply(), 0 as u32, yiaddr, server_ip);
  buf[dhcp_offset + 240] = 53 as u8;
  buf[dhcp_offset + 241] = 1 as u8;
  buf[dhcp_offset + 242] = msg_type as u8;
  buf[dhcp_offset + 243] = 51 as u8;
  buf[dhcp_offset + 244] = 4 as u8;
  let _ = netstack_write_u32_be(buf, dhcp_offset + 245, lease_time);
  buf[dhcp_offset + 249] = 54 as u8;
  buf[dhcp_offset + 250] = 4 as u8;
  let _ = netstack_write_u32_be(buf, dhcp_offset + 251, server_ip);
  buf[dhcp_offset + 255] = 255 as u8; // End
  return 256;
}

fn netstack_dhcp_server_build_nak(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, server_ip: u32) -> i64 {
  let _ = netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, netstack_dhcp_op_bootreply(), 0 as u32, 0 as u32, server_ip);
  buf[dhcp_offset + 240] = 53 as u8;
  buf[dhcp_offset + 241] = 1 as u8;
  buf[dhcp_offset + 242] = netstack_dhcp_msgtype_nak() as u8;
  buf[dhcp_offset + 243] = 54 as u8;
  buf[dhcp_offset + 244] = 4 as u8;
  let _ = netstack_write_u32_be(buf, dhcp_offset + 245, server_ip);
  buf[dhcp_offset + 249] = 255 as u8; // End
  return 250;
}

fn netstack_dhcp_get_op(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return buf[dhcp_offset] as u32;
}
fn netstack_dhcp_get_xid(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_read_u32_be(buf, dhcp_offset + 4);
}
fn netstack_dhcp_get_yiaddr(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_read_u32_be(buf, dhcp_offset + 16);
}
fn netstack_dhcp_get_ciaddr(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_read_u32_be(buf, dhcp_offset + 12);
}

fn netstack_dhcp_verify_magic_cookie(buf: ref [u8; 512], dhcp_offset: i64) -> i64 {
  let c0: u32 = buf[dhcp_offset + 236] as u32;
  let c1: u32 = buf[dhcp_offset + 237] as u32;
  let c2: u32 = buf[dhcp_offset + 238] as u32;
  let c3: u32 = buf[dhcp_offset + 239] as u32;
  if (c0 == (99 as u32)) && (c1 == (130 as u32)) && (c2 == (83 as u32)) && (c3 == (99 as u32)) {
    return 1;
  }
  return 0;
}

// Scans buf[dhcp_offset+240 .. dhcp_offset+dhcp_len) for `want_code`'s
// single-byte value (option 53, DHCP Message Type). Bounded (max 64
// options); every length read is checked against `end` before being
// trusted as a skip distance.
fn netstack_dhcp_find_option_byte(buf: ref [u8; 512], dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> i64 {
  let pos: i64 = dhcp_offset + 240;
  let end: i64 = dhcp_offset + dhcp_len;
  let iter: i64 = 0;
  while (pos < end) && (iter < 64) {
    let code: u32 = buf[pos] as u32;
    if code == (255 as u32) {
      return 0 - 1;
    }
    if code == (0 as u32) {
      pos = pos + 1;
    } else {
      if (pos + 1) >= end {
        return 0 - 1;
      }
      let opt_len: u32 = buf[pos + 1] as u32;
      if code == want_code {
        if (opt_len != (1 as u32)) || ((pos + 2) >= end) {
          return 0 - 1;
        }
        return buf[pos + 2] as i64;
      }
      pos = pos + 2 + (opt_len as i64);
    }
    iter = iter + 1;
  }
  return 0 - 1;
}

// Same shape as netstack_dhcp_find_option_byte, for a 4-byte option
// value (50=Requested IP, 54=Server Identifier, 51=Lease Time).
// Returns 0 if not found.
fn netstack_dhcp_find_option_u32(buf: ref [u8; 512], dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> u32 {
  let pos: i64 = dhcp_offset + 240;
  let end: i64 = dhcp_offset + dhcp_len;
  let iter: i64 = 0;
  while (pos < end) && (iter < 64) {
    let code: u32 = buf[pos] as u32;
    if code == (255 as u32) {
      return 0 as u32;
    }
    if code == (0 as u32) {
      pos = pos + 1;
    } else {
      if (pos + 1) >= end {
        return 0 as u32;
      }
      let opt_len: u32 = buf[pos + 1] as u32;
      if code == want_code {
        if (opt_len != (4 as u32)) || ((pos + 2 + 4) > end) {
          return 0 as u32;
        }
        return netstack_read_u32_be(buf, pos + 2);
      }
      pos = pos + 2 + (opt_len as i64);
    }
    iter = iter + 1;
  }
  return 0 as u32;
}

fn netstack_dhcp_broadcast_mac() -> [u8; 6] {
  return [0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8];
}

// The server's own 4-slot lease table (matching both boards' real
// fixed capacity, `boot/rpi4/dhcp_server_state.S`'s own "small FIXED
// lease table (4 slots)" design) -- same value-type-state pattern as
// `ArpCache`, MAC bytes flattened the same way.
struct DhcpLeaseTable { state: [u32; 4], ip: [u32; 4], xid: [u32; 4], start_tick: [u32; 4], mac_bytes: [u8; 24] }
struct DhcpLeaseFindResult { found: i64, index: i64 }

fn netstack_dhcp_lease_table_empty() -> DhcpLeaseTable {
  return DhcpLeaseTable {
    state: [0 as u32, 0 as u32, 0 as u32, 0 as u32],
    ip: [0 as u32, 0 as u32, 0 as u32, 0 as u32],
    xid: [0 as u32, 0 as u32, 0 as u32, 0 as u32],
    start_tick: [0 as u32, 0 as u32, 0 as u32, 0 as u32],
    mac_bytes: [
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
      0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
    ]
  };
}

// Finds an existing (non-free) lease for `mac`, if any -- lets a
// client that DISCOVERs again before completing the handshake get
// re-offered the SAME address, matching real DHCP server behavior.
fn netstack_dhcp_find_lease_by_mac(table: ref DhcpLeaseTable, mac: ref [u8; 6]) -> DhcpLeaseFindResult {
  let i: i64 = 0;
  while i < 4 {
    if table.state[i] != netstack_dhcp_lease_state_free() {
      let matches: i64 = 1;
      let j: i64 = 0;
      while j < 6 {
        if table.mac_bytes[i * 6 + j] != mac[j] {
          matches = 0;
        }
        j = j + 1;
      }
      if matches == 1 {
        return DhcpLeaseFindResult { found: 1, index: i };
      }
    }
    i = i + 1;
  }
  return DhcpLeaseFindResult { found: 0, index: 0 - 1 };
}

// Returns the index of the first FREE slot, or -1 if the table (4
// slots) is already full -- pool exhaustion is a real, honest -1,
// not a crash, same posture as the packet filter's own 8-rule table.
fn netstack_dhcp_find_free_slot(table: ref DhcpLeaseTable) -> i64 {
  let i: i64 = 0;
  while i < 4 {
    if table.state[i] == netstack_dhcp_lease_state_free() {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// Direct port of both boards' own `dhcp_self_test`/`dhcp_self_test_
// rpi4`'s own build/parse-only subset: build a DISCOVER, verify its
// fields and magic cookie round-trip, build a REQUEST and a RENEW
// REQUEST and verify option 50/54/ciaddr, build a server OFFER/ACK
// and a NAK and verify their own fields, then exercise the lease
// table (miss, insert-equivalent via direct field construction,
// hit). Client/server polling and real netif/socket integration stay
// in each kernel's own self-test, since this package has no netif
// concept at all.
fn netstack_dhcp_self_test() -> i64 {
  let ok: i64 = 1;
  let mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x01 as u8];
  let xid: u32 = 0xDEADBEEF as u32;
  let dhcp_offset: i64 = 42;

  // DISCOVER
  let discover: [u8; 512] = netstack_zero_frame();
  let discover_len: i64 = netstack_dhcp_build_discover(mut ref discover, dhcp_offset, ref mac, xid);
  if discover_len != 244 { ok = 0; }
  if netstack_dhcp_get_op(ref discover, dhcp_offset) != netstack_dhcp_op_bootrequest() { ok = 0; }
  if netstack_dhcp_get_xid(ref discover, dhcp_offset) != xid { ok = 0; }
  if netstack_dhcp_verify_magic_cookie(ref discover, dhcp_offset) != 1 { ok = 0; }
  if netstack_dhcp_find_option_byte(ref discover, dhcp_offset, discover_len, 53 as u32) != (netstack_dhcp_msgtype_discover() as i64) { ok = 0; }

  // REQUEST (SELECTING)
  let offered_ip: u32 = 0xC0A80164 as u32; // 192.168.1.100
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let request: [u8; 512] = netstack_zero_frame();
  let request_len: i64 = netstack_dhcp_build_request(mut ref request, dhcp_offset, ref mac, xid, offered_ip, server_ip);
  if request_len != 256 { ok = 0; }
  if netstack_dhcp_find_option_byte(ref request, dhcp_offset, request_len, 53 as u32) != (netstack_dhcp_msgtype_request() as i64) { ok = 0; }
  if netstack_dhcp_find_option_u32(ref request, dhcp_offset, request_len, 50 as u32) != offered_ip { ok = 0; }
  if netstack_dhcp_find_option_u32(ref request, dhcp_offset, request_len, 54 as u32) != server_ip { ok = 0; }

  // RENEW REQUEST (RENEWING/REBINDING)
  let renew: [u8; 512] = netstack_zero_frame();
  let renew_len: i64 = netstack_dhcp_build_renew_request(mut ref renew, dhcp_offset, ref mac, xid, offered_ip);
  if renew_len != 244 { ok = 0; }
  if netstack_dhcp_get_ciaddr(ref renew, dhcp_offset) != offered_ip { ok = 0; }
  if netstack_dhcp_find_option_u32(ref renew, dhcp_offset, renew_len, 50 as u32) != (0 as u32) { ok = 0; } // no option 50 here

  // Server OFFER/ACK
  let lease_time: u32 = 3600 as u32;
  let offer: [u8; 512] = netstack_zero_frame();
  let offer_len: i64 = netstack_dhcp_server_build_offer_ack(mut ref offer, dhcp_offset, ref mac, xid, netstack_dhcp_msgtype_offer(), offered_ip, server_ip, lease_time);
  if offer_len != 256 { ok = 0; }
  if netstack_dhcp_get_op(ref offer, dhcp_offset) != netstack_dhcp_op_bootreply() { ok = 0; }
  if netstack_dhcp_get_yiaddr(ref offer, dhcp_offset) != offered_ip { ok = 0; }
  if netstack_dhcp_find_option_byte(ref offer, dhcp_offset, offer_len, 53 as u32) != (netstack_dhcp_msgtype_offer() as i64) { ok = 0; }
  if netstack_dhcp_find_option_u32(ref offer, dhcp_offset, offer_len, 51 as u32) != lease_time { ok = 0; }
  if netstack_dhcp_find_option_u32(ref offer, dhcp_offset, offer_len, 54 as u32) != server_ip { ok = 0; }

  // Server NAK
  let nak: [u8; 512] = netstack_zero_frame();
  let nak_len: i64 = netstack_dhcp_server_build_nak(mut ref nak, dhcp_offset, ref mac, xid, server_ip);
  if nak_len != 250 { ok = 0; }
  if netstack_dhcp_find_option_byte(ref nak, dhcp_offset, nak_len, 53 as u32) != (netstack_dhcp_msgtype_nak() as i64) { ok = 0; }
  if netstack_dhcp_find_option_u32(ref nak, dhcp_offset, nak_len, 54 as u32) != server_ip { ok = 0; }

  // Lease table: miss, "insert" (direct field construction, matching
  // how a real server writes each field individually via its own
  // extern accessors), hit, free-slot search, pool-full detection.
  let table0: DhcpLeaseTable = netstack_dhcp_lease_table_empty();
  let miss: DhcpLeaseFindResult = netstack_dhcp_find_lease_by_mac(ref table0, ref mac);
  if miss.found != 0 { ok = 0; }
  if netstack_dhcp_find_free_slot(ref table0) != 0 { ok = 0; }

  let state1: [u32; 4] = [netstack_dhcp_lease_state_offered(), 0 as u32, 0 as u32, 0 as u32];
  let ip1: [u32; 4] = [offered_ip, 0 as u32, 0 as u32, 0 as u32];
  let mac_bytes1: [u8; 24] = [
    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5],
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let table1: DhcpLeaseTable = DhcpLeaseTable { state: state1, ip: ip1, xid: table0.xid, start_tick: table0.start_tick, mac_bytes: mac_bytes1 };
  let hit: DhcpLeaseFindResult = netstack_dhcp_find_lease_by_mac(ref table1, ref mac);
  if hit.found != 1 { ok = 0; }
  if hit.index != 0 { ok = 0; }
  if table1.ip[hit.index] != offered_ip { ok = 0; }
  if netstack_dhcp_find_free_slot(ref table1) != 1 { ok = 0; } // slot 0 taken, slot 1 next

  // Pool exhaustion: fill all 4 slots, confirm -1.
  let state_full: [u32; 4] = [netstack_dhcp_lease_state_bound(), netstack_dhcp_lease_state_bound(), netstack_dhcp_lease_state_bound(), netstack_dhcp_lease_state_bound()];
  let table_full: DhcpLeaseTable = DhcpLeaseTable { state: state_full, ip: table1.ip, xid: table1.xid, start_tick: table1.start_tick, mac_bytes: table1.mac_bytes };
  if netstack_dhcp_find_free_slot(ref table_full) != (0 - 1) { ok = 0; }

  return ok;
}
