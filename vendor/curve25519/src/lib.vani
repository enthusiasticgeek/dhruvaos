// out = (a << 1), 8 limbs -- the final carry-out is always 0 in every
// real caller here (the scalar reduction below only ever shifts a
// running remainder that's already < L < 2^253, so doubling it never
// exceeds 2^254, well inside 256 bits) -- same "provably always 0"
// simplification round 95's own bignum_add8/sub8 already
// apply for the same reason.
fn bignum_shl1_8(a: ref [u32; 8]) -> [u32; 8] {
  let out: [u32; 8] = fe_zero();
  let carry: u32 = 0 as u32;
  let i: i64 = 0;
  while i < 8 {
    let v: u32 = a[i];
    let new_carry: u32 = v >> (31 as u32);
    let shifted: u32 = (v << (1 as u32)) | carry;
    out[i] = shifted;
    carry = new_carry;
    i = i + 1;
  }
  return out;
}

// A 64-byte little-endian byte buffer (a SHA-512 digest) reinterpreted
// as 16 u32 limbs -- feeds ed25519_scalar_mod_l's own reduction.
fn bytes64_to_limbs16_le(bytes: ref [u8; 64]) -> [u32; 16] {
  let out: [u32; 16] = fe16_zero();
  let i: i64 = 0;
  while i < 16 {
    let b0: u32 = bytes[i * 4] as u32;
    let b1: u32 = bytes[i * 4 + 1] as u32;
    let b2: u32 = bytes[i * 4 + 2] as u32;
    let b3: u32 = bytes[i * 4 + 3] as u32;
    out[i] = b0 | (b1 << (8 as u32)) | (b2 << (16 as u32)) | (b3 << (24 as u32));
    i = i + 1;
  }
  return out;
}

// MSB-first bit `bit_index_from_msb` of a 512-bit (16-limb) value --
// ed25519_scalar_mod_l's own long division needs to process its
// input from the most-significant bit down.
fn ed25519_get_bit_msb_first_limbs16(buf: ref [u32; 16], bit_index_from_msb: i64) -> u32 {
  let bit_from_lsb: i64 = 511 - bit_index_from_msb;
  let limb_idx: i64 = bit_from_lsb / 32;
  let bit_in_limb: u32 = (bit_from_lsb - (limb_idx * 32)) as u32;
  return (buf[limb_idx] >> bit_in_limb) & (1 as u32);
}

// Reduces an arbitrary 512-bit value modulo L via genuine bit-by-bit
// long division (shift the running remainder left 1 bit, OR in the
// next input bit MSB-first, conditionally subtract L) -- see this
// section's own header comment for why L's own modulus doesn't admit
// field25519_reduce16's fold trick. Used both to reduce a raw
// SHA-512 digest (via bytes64_to_limbs16_le first) and to reduce
// a wide k*a product (bignum_mul8's own 16-limb output).
fn ed25519_scalar_mod_l(input16: ref [u32; 16]) -> [u32; 8] {
  let remainder: [u32; 8] = fe_zero();
  let l_const: [u32; 8] = ed25519_l();
  let i: i64 = 0;
  while i < 512 {
    remainder = bignum_shl1_8(ref remainder);
    let bit: u32 = ed25519_get_bit_msb_first_limbs16(input16, i);
    if bit == (1 as u32) {
      remainder[0] = remainder[0] | (1 as u32);
    }
    if bignum_cmp8(ref remainder, ref l_const) >= 0 {
      remainder = bignum_sub8(ref remainder, ref l_const);
    }
    i = i + 1;
  }
  return remainder;
}

// (x + y) mod L, for x, y already < L -- bignum_add8's own
// discarded carry is provably 0 here too (x+y < 2L < 2^254).
fn ed25519_scalar_add_mod_l(x: ref [u32; 8], y: ref [u32; 8]) -> [u32; 8] {
  let sum: [u32; 8] = bignum_add8(x, y);
  let l_const: [u32; 8] = ed25519_l();
  if bignum_cmp8(ref sum, ref l_const) >= 0 {
    sum = bignum_sub8(ref sum, ref l_const);
  }
  return sum;
}

// (k * a) mod L -- k, a need not themselves be < L (Ed25519's own
// clamped secret scalar `a` can be up to just under 2^255, genuinely
// larger than L); the wide product is computed first, THEN reduced.
fn ed25519_scalar_mul_mod_l(k: ref [u32; 8], a: ref [u32; 8]) -> [u32; 8] {
  let product16: [u32; 16] = bignum_mul8(k, a);
  return ed25519_scalar_mod_l(ref product16);
}

// Unified twisted-Edwards point addition (also point doubling, when P
// and Q are the same point/variable) -- add-2008-hwcd-3 formula. Every
// intermediate is bound to its own named local (never `ref`-ed
// straight off a call result -- round 95's own confirmed restriction)
// so this reads as a flat sequence of field ops, same shape as
// kernel_main.vani's own version, just without its 8 named persistent
// scratch buffers (ed25519_tmp1_get..tmp8_get) -- owned locals plus
// the return-by-value convention make those unnecessary here.
fn ed25519_point_add(p: ref Ed25519Point, q: ref Ed25519Point) -> Ed25519Point {
  let py_minus_px: [u32; 8] = field25519_sub(ref p.y, ref p.x);
  let qy_minus_qx: [u32; 8] = field25519_sub(ref q.y, ref q.x);
  let a_val: [u32; 8] = field25519_mul(ref py_minus_px, ref qy_minus_qx);

  let py_plus_px: [u32; 8] = field25519_add(ref p.y, ref p.x);
  let qy_plus_qx: [u32; 8] = field25519_add(ref q.y, ref q.x);
  let b_val: [u32; 8] = field25519_mul(ref py_plus_px, ref qy_plus_qx);

  let two_d: [u32; 8] = ed25519_2d();
  let pt_2d: [u32; 8] = field25519_mul(ref p.t, ref two_d);
  let c_val: [u32; 8] = field25519_mul(ref pt_2d, ref q.t);

  let pz_plus_pz: [u32; 8] = field25519_add(ref p.z, ref p.z);
  let d_val: [u32; 8] = field25519_mul(ref pz_plus_pz, ref q.z);

  let e_val: [u32; 8] = field25519_sub(ref b_val, ref a_val);
  let f_val: [u32; 8] = field25519_sub(ref d_val, ref c_val);
  let g_val: [u32; 8] = field25519_add(ref d_val, ref c_val);
  let h_val: [u32; 8] = field25519_add(ref b_val, ref a_val);

  let out_x: [u32; 8] = field25519_mul(ref e_val, ref f_val);
  let out_y: [u32; 8] = field25519_mul(ref g_val, ref h_val);
  let out_t: [u32; 8] = field25519_mul(ref e_val, ref h_val);
  let out_z: [u32; 8] = field25519_mul(ref f_val, ref g_val);
  return Ed25519Point { x: out_x, y: out_y, z: out_z, t: out_t };
}

// [scalar]P, scalar a 256-bit little-endian integer (any value, not
// required to be < L -- e.g. Ed25519's own clamped secret scalar
// isn't). Plain LSB-first double-and-add; `ed25519_point_add(ref
// b, ref b)` doubling passes the same owned local as both arguments,
// confirmed legal (see this section's own header comment).
fn ed25519_point_mul(scalar: ref [u32; 8], p: ref Ed25519Point) -> Ed25519Point {
  let q: Ed25519Point = ed25519_identity_point();
  let b: Ed25519Point = Ed25519Point { x: fe_copy(ref p.x), y: fe_copy(ref p.y), z: fe_copy(ref p.z), t: fe_copy(ref p.t) };
  let i: i64 = 0;
  while i < 256 {
    let bit: u32 = x25519_get_bit(scalar, i);
    if bit == (1 as u32) {
      q = ed25519_point_add(ref q, ref b);
    }
    b = ed25519_point_add(ref b, ref b);
    i = i + 1;
  }
  return q;
}

// True iff P == Q as projective points ((X1*Z2 == X2*Z1) and
// (Y1*Z2 == Y2*Z1) mod p) -- comparing raw coordinates directly would
// be wrong since the same affine point has infinitely many valid
// (X,Y,Z,T) representations.
fn ed25519_point_equal(p: ref Ed25519Point, q: ref Ed25519Point) -> i64 {
  let lhs1: [u32; 8] = field25519_mul(ref p.x, ref q.z);
  let rhs1: [u32; 8] = field25519_mul(ref q.x, ref p.z);
  if bignum_cmp8(ref lhs1, ref rhs1) != 0 {
    return 0;
  }
  let lhs2: [u32; 8] = field25519_mul(ref p.y, ref q.z);
  let rhs2: [u32; 8] = field25519_mul(ref q.y, ref p.z);
  if bignum_cmp8(ref lhs2, ref rhs2) != 0 {
    return 0;
  }
  return 1;
}

// x = (x2)^((p+3)/8) mod p -- the standard Ed25519/RFC 8032 candidate
// square root (valid because p = 5 mod 8). Plain left-to-right binary
// square-and-multiply over the fixed, precomputed exponent (see this
// section's own header comment for why it's a constant here, not
// derived at runtime the way kernel_main.vani's own version does).
fn ed25519_sqrt_candidate(x2: ref [u32; 8]) -> [u32; 8] {
  let exponent: [u32; 8] = ed25519_pm2_over8();
  let result: [u32; 8] = fe_one();
  let base: [u32; 8] = fe_copy(x2);
  let bit_i: i64 = 0;
  while bit_i < 255 {
    if x25519_get_bit(ref exponent, bit_i) == (1 as u32) {
      result = field25519_mul(ref result, ref base);
    }
    base = field25519_sqr(ref base);
    bit_i = bit_i + 1;
  }
  return result;
}

// Recovers x from y and a target parity bit `sign`, per RFC 8032
// section 5.1.3. `ok` is 0 (with `x` left as all-zero) if y is out of
// range or no valid x exists -- "reject, don't guess," same posture
// as the rest of this codebase's bounds/format checks.
fn ed25519_recover_x(y: ref [u32; 8], sign: u32) -> Ed25519RecoverXResult {
  let p_const: [u32; 8] = x25519_p();
  if bignum_cmp8(y, ref p_const) >= 0 {
    return Ed25519RecoverXResult { ok: 0, x: fe_zero() };
  }

  let y2: [u32; 8] = field25519_sqr(y);
  let one_val: [u32; 8] = fe_one();
  let num: [u32; 8] = field25519_sub(ref y2, ref one_val); // num = y^2 - 1
  let d_const: [u32; 8] = ed25519_d();
  let dy2: [u32; 8] = field25519_mul(ref d_const, ref y2); // dy2 = d*y^2
  let den: [u32; 8] = field25519_add(ref dy2, ref one_val); // den = d*y^2 + 1
  let deninv: [u32; 8] = field25519_invert(ref den);
  let x2: [u32; 8] = field25519_mul(ref num, ref deninv); // x2 = num/den

  let is_zero: i64 = 1;
  let zci: i64 = 0;
  while zci < 8 {
    if x2[zci] != (0 as u32) {
      is_zero = 0;
    }
    zci = zci + 1;
  }
  if is_zero == 1 {
    if sign == (1 as u32) {
      return Ed25519RecoverXResult { ok: 0, x: fe_zero() };
    }
    return Ed25519RecoverXResult { ok: 1, x: fe_zero() };
  }

  let candidate: [u32; 8] = ed25519_sqrt_candidate(ref x2);
  let check: [u32; 8] = field25519_sqr(ref candidate);
  if bignum_cmp8(ref check, ref x2) != 0 {
    let sqrt_m1_const: [u32; 8] = ed25519_sqrt_m1();
    candidate = field25519_mul(ref candidate, ref sqrt_m1_const);
    check = field25519_sqr(ref candidate);
    if bignum_cmp8(ref check, ref x2) != 0 {
      return Ed25519RecoverXResult { ok: 0, x: fe_zero() };
    }
  }

  let cand_parity: u32 = candidate[0] & (1 as u32);
  if cand_parity != sign {
    candidate = field25519_sub(ref p_const, ref candidate);
  }
  return Ed25519RecoverXResult { ok: 1, x: candidate };
}

fn ed25519_point_compress(p: ref Ed25519Point) -> [u8; 32] {
  let zinv: [u32; 8] = field25519_invert(ref p.z);
  let x: [u32; 8] = field25519_mul(ref p.x, ref zinv);
  let y: [u32; 8] = field25519_mul(ref p.y, ref zinv);
  let out: [u8; 32] = fe_to_bytes_le(ref y);
  let xbit: u32 = x[0] & (1 as u32);
  let top: u32 = (out[31] as u32) & (127 as u32);
  let newtop: u32 = top | (xbit << (7 as u32));
  out[31] = newtop as u8;
  return out;
}

// Decompresses a 32-byte encoded point. `ok` is 0 (with x/y/z/t left
// as all-zero) on a malformed/invalid encoding.
fn ed25519_point_decompress(s: ref [u8; 32]) -> Ed25519DecompressResult {
  let sign: u32 = ((s[31] as u32) >> (7 as u32)) & (1 as u32);
  let y_bytes: [u8; 32] = ed25519_zero32_bytes();
  let i: i64 = 0;
  while i < 32 {
    y_bytes[i] = s[i];
    i = i + 1;
  }
  let top_masked: u32 = (y_bytes[31] as u32) & (127 as u32);
  y_bytes[31] = top_masked as u8;
  let y: [u32; 8] = fe_from_bytes_le(ref y_bytes);

  let rec: Ed25519RecoverXResult = ed25519_recover_x(ref y, sign);
  if rec.ok == 0 {
    return Ed25519DecompressResult { ok: 0, x: fe_zero(), y: fe_zero(), z: fe_zero(), t: fe_zero() };
  }
  let z_val: [u32; 8] = fe_one();
  let t_val: [u32; 8] = field25519_mul(ref rec.x, ref y);
  return Ed25519DecompressResult { ok: 1, x: rec.x, y: y, z: z_val, t: t_val };
}

// SHA-512(secret) split into a clamped scalar `a` (RFC 8032 section
// 5.1.5 clamping: clear the low 3 bits, clear bit 255, set bit 254)
// and a `prefix` used only to derive the per-message nonce below.
fn ed25519_secret_expand(secret: ref [u8; 32]) -> Ed25519ExpandResult {
  let scratch: [u8; 256] = ed25519_zero256_bytes();
  let i: i64 = 0;
  while i < 32 {
    scratch[i] = secret[i];
    i = i + 1;
  }
  // Streaming SHA-512 (init/update/finalize), not the one-shot
  // sha512_hash -- this is curve25519's ONLY remaining use of
  // crypto_hash beyond the streaming primitives, and removing it
  // means curve25519 depends only on crypto_hash's core.vani (the
  // primitives-only file), not its full lib.vani (one-shot wrappers +
  // self-tests). That matters for any consumer with a pre-existing
  // function literally named sha256_hash/sha512_hash/etc of its own
  // (e.g. DhruvaOS's Pi 1 kernel, which defines its own adapter of
  // that exact name) -- see crypto_hash's own core.vani header
  // comment for the full BUG-234 story this avoids.
  let sctx: Sha512Ctx = sha512_init();
  let sctx2: Sha512Ctx = sha512_update(ref sctx, mut ref scratch, 32);
  let hash_out: [u8; 64] = sha512_finalize(ref sctx2);

  let a_bytes: [u8; 32] = ed25519_zero32_bytes();
  let j: i64 = 0;
  while j < 32 {
    a_bytes[j] = hash_out[j];
    j = j + 1;
  }
  let a0: u32 = (a_bytes[0] as u32) & (248 as u32);
  a_bytes[0] = a0 as u8;
  let a31: u32 = ((a_bytes[31] as u32) & (127 as u32)) | (64 as u32);
  a_bytes[31] = a31 as u8;
  let a_scalar: [u32; 8] = fe_from_bytes_le(ref a_bytes);

  let prefix: [u8; 32] = ed25519_zero32_bytes();
  let k: i64 = 0;
  while k < 32 {
    prefix[k] = hash_out[32 + k];
    k = k + 1;
  }
  return Ed25519ExpandResult { a: a_scalar, prefix: prefix };
}

fn ed25519_secret_to_public(secret: ref [u8; 32]) -> [u8; 32] {
  let expanded: Ed25519ExpandResult = ed25519_secret_expand(secret);
  let g: Ed25519Point = ed25519_base_point();
  let apoint: Ed25519Point = ed25519_point_mul(ref expanded.a, ref g);
  return ed25519_point_compress(ref apoint);
}

// out = H(block1 (32 bytes) || block2 (32 bytes, only if
// `has_block2` == 1) || msg (`msg_len` bytes)), computed via
// streaming SHA-512 (no fixed total-length cap -- see this section's
// own note on why `ed25519_sign`/`ed25519_verify` moved off the
// one-shot `sha512_hash` they originally used: real callers (TLS
// 1.3's own CertificateVerify signed-content construction, ~130
// bytes) exceed a small one-shot buffer's practical cap). Covers
// both of RFC 8032's own two hash shapes: prefix||msg
// (`has_block2`=0, `ed25519_sign`'s own r) and R||A||msg
// (`has_block2`=1, both sign's own k and verify's own k).
fn ed25519_hash_2block_msg(block1: ref [u8; 32], block2: ref [u8; 32], has_block2: i64, msg: ref [u8; 512], msg_len: i64) -> [u8; 64] {
  let ctx: Sha512Ctx = sha512_init();
  let chunk1: [u8; 256] = ed25519_zero256_bytes();
  let ci: i64 = 0;
  while ci < 32 {
    chunk1[ci] = block1[ci];
    ci = ci + 1;
  }
  let prefix_len: i64 = 32;
  if has_block2 == 1 {
    let cj: i64 = 0;
    while cj < 32 {
      chunk1[32 + cj] = block2[cj];
      cj = cj + 1;
    }
    prefix_len = 64;
  }
  let ctx2: Sha512Ctx = sha512_update(ref ctx, mut ref chunk1, prefix_len);

  let offset: i64 = 0;
  let ctx3: Sha512Ctx = ctx2;
  while offset < msg_len {
    let remaining: i64 = msg_len - offset;
    let n: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = ed25519_zero256_bytes();
    let mi: i64 = 0;
    while mi < n {
      chunk[mi] = msg[offset + mi];
      mi = mi + 1;
    }
    ctx3 = sha512_update(ref ctx3, mut ref chunk, n);
    offset = offset + n;
  }
  return sha512_finalize(ref ctx3);
}

// RFC 8032 section 5.1.6. `out_sig` is 64 bytes (R || s). `msg` is
// capped at 512 bytes (comfortable headroom over TLS 1.3's own
// CertificateVerify signed-content, ~130 bytes) -- hashing itself has
// no length cap at all (see `ed25519_hash_prefix_b_msg` above), so
// this bound is purely "how big a single stack array to reserve," not
// an algorithmic limit. A consumer signing something larger needs its
// own pre-hash step (hash the real message first, sign the digest).
fn ed25519_sign(secret: ref [u8; 32], msg: ref [u8; 512], msg_len: i64) -> [u8; 64] {
  let expanded: Ed25519ExpandResult = ed25519_secret_expand(secret);
  let g: Ed25519Point = ed25519_base_point();
  let apoint: Ed25519Point = ed25519_point_mul(ref expanded.a, ref g);
  let apub: [u8; 32] = ed25519_point_compress(ref apoint);

  // r = H(prefix || msg) mod L
  let unused_block2: [u8; 32] = ed25519_zero32_bytes();
  let hash_out1: [u8; 64] = ed25519_hash_2block_msg(ref expanded.prefix, ref unused_block2, 0, msg, msg_len);
  let hash_out1_limbs: [u32; 16] = bytes64_to_limbs16_le(ref hash_out1);
  let r: [u32; 8] = ed25519_scalar_mod_l(ref hash_out1_limbs);

  let rpoint: Ed25519Point = ed25519_point_mul(ref r, ref g);
  let rs: [u8; 32] = ed25519_point_compress(ref rpoint);

  // k = H(R || A || msg) mod L
  let hash_out2: [u8; 64] = ed25519_hash_2block_msg(ref rs, ref apub, 1, msg, msg_len);
  let hash_out2_limbs: [u32; 16] = bytes64_to_limbs16_le(ref hash_out2);
  let k: [u32; 8] = ed25519_scalar_mod_l(ref hash_out2_limbs);

  let ka: [u32; 8] = ed25519_scalar_mul_mod_l(ref k, ref expanded.a);
  let s: [u32; 8] = ed25519_scalar_add_mod_l(ref r, ref ka);
  let s_bytes: [u8; 32] = fe_to_bytes_le(ref s);

  let out_sig: [u8; 64] = ed25519_zero64_bytes();
  let oi: i64 = 0;
  while oi < 32 {
    out_sig[oi] = rs[oi];
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 32 {
    out_sig[32 + oj] = s_bytes[oj];
    oj = oj + 1;
  }
  return out_sig;
}

// RFC 8032 section 5.1.7. Returns 1 if `sig` (64 bytes) is a valid
// Ed25519 signature over `msg` by `pubkey` (32 bytes), 0 otherwise --
// covers every rejection path explicitly (malformed public key,
// malformed R, s >= L) rather than letting any fall through to an
// ambiguous result.
fn ed25519_verify(pubkey: ref [u8; 32], msg: ref [u8; 512], msg_len: i64, sig: ref [u8; 64]) -> i64 {
  let dec_a: Ed25519DecompressResult = ed25519_point_decompress(pubkey);
  if dec_a.ok == 0 {
    return 0;
  }
  let apoint: Ed25519Point = Ed25519Point { x: dec_a.x, y: dec_a.y, z: dec_a.z, t: dec_a.t };

  let rs: [u8; 32] = ed25519_zero32_bytes();
  let ri: i64 = 0;
  while ri < 32 {
    rs[ri] = sig[ri];
    ri = ri + 1;
  }
  let dec_r: Ed25519DecompressResult = ed25519_point_decompress(ref rs);
  if dec_r.ok == 0 {
    return 0;
  }
  let rpoint: Ed25519Point = Ed25519Point { x: dec_r.x, y: dec_r.y, z: dec_r.z, t: dec_r.t };

  let s_bytes: [u8; 32] = ed25519_zero32_bytes();
  let si: i64 = 0;
  while si < 32 {
    s_bytes[si] = sig[32 + si];
    si = si + 1;
  }
  let s: [u32; 8] = fe_from_bytes_le(ref s_bytes);
  let l_const: [u32; 8] = ed25519_l();
  if bignum_cmp8(ref s, ref l_const) >= 0 {
    return 0;
  }

  let hash_out: [u8; 64] = ed25519_hash_2block_msg(ref rs, pubkey, 1, msg, msg_len);
  let hash_out_limbs: [u32; 16] = bytes64_to_limbs16_le(ref hash_out);
  let k: [u32; 8] = ed25519_scalar_mod_l(ref hash_out_limbs);

  let g: Ed25519Point = ed25519_base_point();
  let sb: Ed25519Point = ed25519_point_mul(ref s, ref g);
  let ka_point: Ed25519Point = ed25519_point_mul(ref k, ref apoint);
  let rhs: Ed25519Point = ed25519_point_add(ref ka_point, ref rpoint);

  return ed25519_point_equal(ref sb, ref rhs);
}

// RFC 8032-shaped known-answer check reusing kernel_main.vani's own
// already-independently-verified seed/message/expected-pubkey/
// expected-signature (see this section's header comment for the full
// provenance) -- same algorithm, same constants -> byte-identical
// expected output. Covers pubkey derivation, signing, self-
// verification, AND both tamper-rejection paths (flipped signature
// bit, flipped message bit) -- the actual security property, not just
// "produces something."
fn ed25519_self_test() -> i64 {
  let ok: i64 = 1;

  let seed: [u8; 32] = [
    0x00 as u8, 0x01 as u8, 0x02 as u8, 0x03 as u8, 0x04 as u8, 0x05 as u8, 0x06 as u8, 0x07 as u8,
    0x08 as u8, 0x09 as u8, 0x0a as u8, 0x0b as u8, 0x0c as u8, 0x0d as u8, 0x0e as u8, 0x0f as u8,
    0x10 as u8, 0x11 as u8, 0x12 as u8, 0x13 as u8, 0x14 as u8, 0x15 as u8, 0x16 as u8, 0x17 as u8,
    0x18 as u8, 0x19 as u8, 0x1a as u8, 0x1b as u8, 0x1c as u8, 0x1d as u8, 0x1e as u8, 0x1f as u8
  ];

  let msg_str: Str = "Dhruva Ed25519 test message";
  let msg_len: i64 = str_len_bytes(msg_str);
  let msg: [u8; 512] = ed25519_zero512_bytes();
  let mi: i64 = 0;
  while mi < msg_len {
    msg[mi] = str_byte_at(msg_str, mi) as u8;
    mi = mi + 1;
  }

  let expected_pub: [u8; 32] = [
    0x03 as u8, 0xa1 as u8, 0x07 as u8, 0xbf as u8, 0xf3 as u8, 0xce as u8, 0x10 as u8, 0xbe as u8,
    0x1d as u8, 0x70 as u8, 0xdd as u8, 0x18 as u8, 0xe7 as u8, 0x4b as u8, 0xc0 as u8, 0x99 as u8,
    0x67 as u8, 0xe4 as u8, 0xd6 as u8, 0x30 as u8, 0x9b as u8, 0xa5 as u8, 0x0d as u8, 0x5f as u8,
    0x1d as u8, 0xdc as u8, 0x86 as u8, 0x64 as u8, 0x12 as u8, 0x55 as u8, 0x31 as u8, 0xb8 as u8
  ];
  let expected_sig: [u8; 64] = [
    0xbb as u8, 0x89 as u8, 0x59 as u8, 0x11 as u8, 0x1f as u8, 0xc8 as u8, 0x7b as u8, 0xf9 as u8,
    0x3c as u8, 0x54 as u8, 0xde as u8, 0x30 as u8, 0xfc as u8, 0x11 as u8, 0xf0 as u8, 0x09 as u8,
    0x7d as u8, 0x8c as u8, 0xf7 as u8, 0x58 as u8, 0x64 as u8, 0xa2 as u8, 0x7c as u8, 0xb7 as u8,
    0x6c as u8, 0x5a as u8, 0x97 as u8, 0x24 as u8, 0x50 as u8, 0x4d as u8, 0x70 as u8, 0x80 as u8,
    0xe4 as u8, 0x72 as u8, 0xf9 as u8, 0x86 as u8, 0x71 as u8, 0x16 as u8, 0x1d as u8, 0xb0 as u8,
    0x08 as u8, 0x60 as u8, 0xe8 as u8, 0x78 as u8, 0x85 as u8, 0x79 as u8, 0xa0 as u8, 0x63 as u8,
    0xa1 as u8, 0x2a as u8, 0x1a as u8, 0xb1 as u8, 0x7a as u8, 0x3e as u8, 0x3f as u8, 0xc7 as u8,
    0x08 as u8, 0xb9 as u8, 0x77 as u8, 0xae as u8, 0xd5 as u8, 0xf1 as u8, 0x02 as u8, 0x01 as u8
  ];

  let pub_out: [u8; 32] = ed25519_secret_to_public(ref seed);
  if sha256_digest_equal(ref pub_out, ref expected_pub) == 0 {
    ok = 0;
  }

  let sig_out: [u8; 64] = ed25519_sign(ref seed, ref msg, msg_len);
  if sha512_digest_equal(ref sig_out, ref expected_sig) == 0 {
    ok = 0;
  }

  if ed25519_verify(ref pub_out, ref msg, msg_len, ref sig_out) == 0 {
    ok = 0; // must accept its own valid signature
  }

  let bad_sig: [u8; 64] = ed25519_zero64_bytes();
  let bi: i64 = 0;
  while bi < 64 {
    bad_sig[bi] = sig_out[bi];
    bi = bi + 1;
  }
  bad_sig[0] = ((bad_sig[0] as u32) ^ (1 as u32)) as u8;
  if ed25519_verify(ref pub_out, ref msg, msg_len, ref bad_sig) == 1 {
    ok = 0;
  }

  let bad_msg: [u8; 512] = ed25519_zero512_bytes();
  let ci: i64 = 0;
  while ci < msg_len {
    bad_msg[ci] = msg[ci];
    ci = ci + 1;
  }
  bad_msg[0] = ((bad_msg[0] as u32) ^ (1 as u32)) as u8;
  if ed25519_verify(ref pub_out, ref bad_msg, msg_len, ref sig_out) == 1 {
    ok = 0;
  }

  // A 130-byte message (over the OLD 64-byte cap this API had before
  // moving to streaming SHA-512 internally -- see ed25519_hash_2block
  // _msg's own header comment) -- proves the real motivating case
  // (TLS 1.3's own CertificateVerify signed-content, ~130 bytes)
  // works, not just that small messages still do. Same seed as above
  // (so the expected pubkey is already verified); message and
  // signature independently generated via the real `cryptography`
  // Python library, not derived from this same vani code.
  let big_msg: [u8; 512] = ed25519_zero512_bytes();
  let bmi: i64 = 0;
  while bmi < 130 {
    big_msg[bmi] = (((bmi * 7 + 3) as u32) & (255 as u32)) as u8;
    bmi = bmi + 1;
  }
  let big_sig: [u8; 64] = ed25519_sign(ref seed, ref big_msg, 130);
  let expected_big_sig: [u8; 64] = [
    0x7d as u8, 0xe1 as u8, 0x57 as u8, 0x85 as u8, 0x78 as u8, 0x88 as u8, 0x38 as u8, 0x6f as u8,
    0x02 as u8, 0x43 as u8, 0xfe as u8, 0x47 as u8, 0xaa as u8, 0xef as u8, 0x5b as u8, 0xdb as u8,
    0x6a as u8, 0x39 as u8, 0xef as u8, 0x07 as u8, 0xc5 as u8, 0x32 as u8, 0xe5 as u8, 0x5e as u8,
    0x5b as u8, 0x23 as u8, 0xda as u8, 0xdf as u8, 0xa0 as u8, 0x71 as u8, 0xb0 as u8, 0xf3 as u8,
    0xfc as u8, 0x90 as u8, 0xe4 as u8, 0xa5 as u8, 0x22 as u8, 0xa4 as u8, 0xd9 as u8, 0x5e as u8,
    0xd4 as u8, 0x89 as u8, 0xf4 as u8, 0x5d as u8, 0x1a as u8, 0x3c as u8, 0xc6 as u8, 0x5e as u8,
    0xcd as u8, 0x9c as u8, 0x3b as u8, 0x26 as u8, 0xec as u8, 0x17 as u8, 0x02 as u8, 0x54 as u8,
    0xe1 as u8, 0xca as u8, 0xe5 as u8, 0x57 as u8, 0xe6 as u8, 0xb3 as u8, 0x30 as u8, 0x05 as u8
  ];
  if sha512_digest_equal(ref big_sig, ref expected_big_sig) == 0 {
    ok = 0;
  }
  if ed25519_verify(ref pub_out, ref big_msg, 130, ref big_sig) == 0 {
    ok = 0;
  }

  return ok;
}

