// Loopback's own placeholder MAC -- a locally-administered address
// (bit 1 of the first octet set, IEEE 802 convention for non-vendor
// addresses), the exact same address kernel_main.vani's own
// netif_get_mac falls back to when no real hardware backend was
// enumerated. No real backend exists on this port at all yet, so
// this is the only address this function will ever return.
fn netif_get_mac_rpi4(out: mut ref [u8; 6]) -> i64 {
  out[0] = 0x02 as u8;
  out[1] = 0x00 as u8;
  out[2] = 0x00 as u8;
  out[3] = 0x00 as u8;
  out[4] = 0x00 as u8;
  out[5] = 0x01 as u8;
  return 0;
}

// Sends a raw frame (frame[0..frame_len)) by staging it byte-by-byte
// then committing it as a whole. Returns 0 on success, -1 if the
// frame is too big for a slot or the queue's 4 slots are already
// full (dropped, matching real best-effort networking behavior under
// congestion -- same semantics as kernel_main.vani's own
// netif_send_frame).
fn netif_send_frame_rpi4(frame: ref [u8; 512], frame_len: i64) -> i64 {
  if frame_len > NETIF_SLOT_SIZE_RPI4 {
    return 0 - 1;
  }
  // Round 88: packet filtering's egress hook -- the SAME single choke
  // point every outgoing frame (ARP/IPv4) already passes through,
  // mirroring netif_recv_frame_rpi4's own ingress hook below. A
  // denied frame is silently dropped and reported as success --
  // deliberately the same "the sender never learns" shape
  // kernel_main.vani's own netif_send_frame already establishes for
  // this exact hook.
  if filter_check_frame_rpi4(frame, frame_len, 1 as u32) == (0 as u32) {
    return 0;
  }
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = frame[i] as u32;
    let _ = netif_state_stage_byte(i as u32, b);
    i = i + 1;
  }
  return netif_state_commit_send(frame_len as u32);
}

// Receives the next queued frame into out[0..max_len). Returns the
// frame's real length, or -1 if the queue is empty OR the frame is
// bigger than the caller's buffer (dropped either way -- a frame too
// big to fit is still consumed off the queue, matching
// kernel_main.vani's own netif_recv_frame oversized-frame handling,
// not left stuck blocking every later poll).
fn netif_recv_frame_rpi4(out: mut ref [u8; 512], max_len: i64) -> i64 {
  let frame_len: i64 = netif_state_recv_len();
  if frame_len < 0 {
    return 0 - 1;
  }
  if frame_len > max_len {
    let _ = netif_state_recv_advance();
    return 0 - 1;
  }
  // Round 88: read into a local, owned array first rather than `out`
  // directly -- vani has no reborrow from `mut ref T` to `ref T` (a
  // `mut ref` parameter can't be passed where a plain `ref` is wanted,
  // confirmed via a standalone `vanic check` probe: "must be
  // assignable to ref [u8; 512], got mut ref [u8; 512]"), and
  // filter_check_frame_rpi4 below only ever reads, so it takes `ref`.
  // An owned local can be passed either way, so it's the one shape
  // that satisfies both this function's `mut ref out` write and the
  // filter's `ref` read.
  let local: [u8; 512] = netif_zero_frame_rpi4();
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = netif_state_recv_byte(i as u32);
    local[i] = b as u8;
    i = i + 1;
  }
  let _ = netif_state_recv_advance();
  // Packet filtering's ingress hook. The frame is already dequeued
  // above regardless of the verdict (matching how a real NIC would
  // also have already delivered the frame off the wire by the time
  // filtering happens) -- a denied frame is simply dropped and
  // reported as "nothing ready" this call.
  if filter_check_frame_rpi4(ref local, frame_len, 0 as u32) == (0 as u32) {
    return 0 - 1;
  }
  let j: i64 = 0;
  while j < frame_len {
    out[j] = local[j];
    j = j + 1;
  }
  return frame_len;
}

// Boot-time (and on-demand, via the `netif` shell command) self-test:
// builds a tiny synthetic Ethernet frame (broadcast destination, our
// own loopback MAC as source, ethertype 0x0800 = IPv4, payload "hi"),
// sends it, receives it back, and checks every field round-tripped
// correctly -- plus the empty-queue and full-queue (4 real slots)
// edge cases, the same shape kernel_main.vani's own netif_self_test
// already established.
fn netif_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let _ = netif_state_reset();

  let empty_buf: [u8; 512] = netif_zero_frame_rpi4();
  let empty_len: i64 = netif_recv_frame_rpi4(mut ref empty_buf, 512);
  if empty_len != (0 - 1) {
    ok = 0;
  }

  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref mac);
  let i: i64 = 0;
  while i < 6 {
    frame[i] = 0xFF as u8; // dst: broadcast
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    frame[6 + j] = mac[j]; // src: our own MAC
    j = j + 1;
  }
  frame[12] = 0x08 as u8; // ethertype hi (IPv4)
  frame[13] = 0x00 as u8; // ethertype lo
  frame[14] = 104 as u8;  // 'h'
  frame[15] = 105 as u8;  // 'i'

  let send_status: i64 = netif_send_frame_rpi4(ref frame, 16);
  if send_status != 0 {
    ok = 0;
  }

  let recv_buf: [u8; 512] = netif_zero_frame_rpi4();
  let recv_len: i64 = netif_recv_frame_rpi4(mut ref recv_buf, 512);
  if recv_len != 16 {
    ok = 0;
  }
  if (recv_buf[12] != (0x08 as u8)) || (recv_buf[13] != (0x00 as u8)) {
    ok = 0;
  }
  if (recv_buf[14] != (104 as u8)) || (recv_buf[15] != (105 as u8)) {
    ok = 0;
  }

  // Queue-full: 4 slots total, all empty after the drain above -- send
  // 4 more then a 5th, which must be dropped.
  let k: i64 = 0;
  while k < 4 {
    let _ = netif_send_frame_rpi4(ref frame, 16);
    k = k + 1;
  }
  let overflow_status: i64 = netif_send_frame_rpi4(ref frame, 16);
  if overflow_status != (0 - 1) {
    ok = 0;
  }
  // Drain the 4 real frames so this self-test doesn't leave stale
  // frames behind for a later on-demand `netif` shell-command rerun.
  let m: i64 = 0;
  while m < 4 {
    let drain_buf: [u8; 512] = netif_zero_frame_rpi4();
    let _ = netif_recv_frame_rpi4(mut ref drain_buf, 512);
    m = m + 1;
  }

  let _ = uart_puts_rpi4_vani("NET: loopback netif send/recv + empty/full queue edge cases");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 87 -- Phase A step 2 of the networking/SSH/WiFi scope: ARP
// (RFC 826), built on round 86's netif. Field layout, exactly
// kernel_main.vani's own (offsets within the full 42-byte frame,
// after netif's own 14-byte dst/src/ethertype header):
//   14-15 hwtype(1=Ethernet)  16-17 ptype(0x0800=IPv4)
//   18 hwlen(6)  19 plen(4)  20-21 op(1=request,2=reply)
//   22-27 sender_mac  28-31 sender_ip
//   32-37 target_mac  38-41 target_ip
// A loopback link doesn't need real address resolution (no separate
// "other host" on the wire), but the packet format and cache logic
// are real and directly testable without one -- same reasoning
// kernel_main.vani's own ARP comment already gives.
//
// The cache itself lives in boot/rpi4/arp_state.S (its own header
// comment has the full design); the lookup/insert ALGORITHM below is
// a direct port of kernel_main.vani's own arp_cache_lookup/insert,
// just calling per-byte accessors instead of that side's raw-pointer-
// into-a-heap-buffer.

extern "C" fn arp_cache_reset() -> u32;
extern "C" fn arp_cache_get_count() -> u32;
extern "C" fn arp_cache_set_count(count: u32) -> u32;
extern "C" fn arp_cache_get_next_slot() -> u32;
extern "C" fn arp_cache_set_next_slot(slot: u32) -> u32;
extern "C" fn arp_cache_get_ip(index: u32) -> u32;
extern "C" fn arp_cache_set_ip(index: u32, value: u32) -> u32;
extern "C" fn arp_cache_get_mac_byte(index: u32, byte_idx: u32) -> u32;
extern "C" fn arp_cache_set_mac_byte(index: u32, byte_idx: u32, value: u32) -> u32;

fn arp_write_u16_be_rpi4(buf: mut ref [u8; 512], off: i64, v: u32) -> i64 {
  buf[off] = ((v >> (8 as u32)) & (255 as u32)) as u8;
  buf[off + 1] = (v & (255 as u32)) as u8;
  return 0;
}

fn arp_write_u32_be_rpi4(buf: mut ref [u8; 512], off: i64, v: u32) -> i64 {
  buf[off] = ((v >> (24 as u32)) & (255 as u32)) as u8;
  buf[off + 1] = ((v >> (16 as u32)) & (255 as u32)) as u8;
  buf[off + 2] = ((v >> (8 as u32)) & (255 as u32)) as u8;
  buf[off + 3] = (v & (255 as u32)) as u8;
  return 0;
}

fn arp_read_u16_be_rpi4(buf: ref [u8; 512], off: i64) -> u32 {
  let b0: u32 = buf[off] as u32;
  let b1: u32 = buf[off + 1] as u32;
  return (b0 << (8 as u32)) | b1;
}

fn arp_read_u32_be_rpi4(buf: ref [u8; 512], off: i64) -> u32 {
  let b0: u32 = buf[off] as u32;
  let b1: u32 = buf[off + 1] as u32;
  let b2: u32 = buf[off + 2] as u32;
  let b3: u32 = buf[off + 3] as u32;
  return (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3;
}

// Round 106b: ARP's own build/parse ALGORITHM now lives in the
// shared `netstack` package (`netstack_arp_*`), confirmed a direct
// port of this file's own former body before extraction. Thin
// pass-throughs kept under their original names since they're used
// throughout this file's own IPv4/ARP integration -- `arp_write_
// u16_be_rpi4`/`arp_read_u32_be_rpi4`/etc. stay untouched (IPv4/TCP/
// UDP/DHCP haven't migrated yet and still depend on them directly).
fn arp_build_request_rpi4(out_frame: mut ref [u8; 512], my_mac: ref [u8; 6], my_ip: u32, target_ip: u32) -> i64 {
  return netstack_arp_build_request(out_frame, my_mac, my_ip, target_ip);
}

fn arp_build_reply_rpi4(out_frame: mut ref [u8; 512], my_mac: ref [u8; 6], my_ip: u32, requester_mac: ref [u8; 6], requester_ip: u32) -> i64 {
  return netstack_arp_build_reply(out_frame, my_mac, my_ip, requester_mac, requester_ip);
}

fn arp_get_ethertype_rpi4(frame: ref [u8; 512]) -> u32 {
  return netstack_arp_get_ethertype(frame);
}

fn arp_is_arp_frame_rpi4(frame: ref [u8; 512]) -> i64 {
  return netstack_arp_is_arp_frame(frame);
}

fn arp_get_operation_rpi4(frame: ref [u8; 512]) -> u32 {
  return netstack_arp_get_operation(frame);
}

fn arp_get_sender_ip_rpi4(frame: ref [u8; 512]) -> u32 {
  return netstack_arp_get_sender_ip(frame);
}

fn arp_get_target_ip_rpi4(frame: ref [u8; 512]) -> u32 {
  return netstack_arp_get_target_ip(frame);
}

fn arp_get_sender_mac_rpi4(frame: ref [u8; 512], out_mac: mut ref [u8; 6]) -> i64 {
  return netstack_arp_get_sender_mac(frame, out_mac);
}

// Round 106b: the cache's own lookup/insert ALGORITHM now lives in
// the shared `netstack` package (`ArpCache`/`netstack_arp_cache_
// lookup`/`insert`) -- a value-type struct with no persistent state
// of its own, matching `FilterConfig`'s own design. This file's rule
// TABLE storage (`boot/rpi4/arp_state.S`, the extern accessors above)
// is untouched; these two functions' only job is round-tripping that
// real state through an `ArpCache`.
fn arp_cache_from_state_rpi4() -> ArpCache {
  let count: u32 = arp_cache_get_count();
  let ip: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let mac_bytes: [u8; 48] = [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let i: u32 = 0 as u32;
  while i < count {
    ip[i as i64] = arp_cache_get_ip(i);
    let j: u32 = 0 as u32;
    while j < (6 as u32) {
      mac_bytes[(i * (6 as u32) + j) as i64] = arp_cache_get_mac_byte(i, j) as u8;
      j = j + (1 as u32);
    }
    i = i + (1 as u32);
  }
  return ArpCache { count: count as i64, next_slot: arp_cache_get_next_slot() as i64, ip: ip, mac_bytes: mac_bytes };
}

fn arp_cache_lookup_rpi4(ip: u32, out_mac: mut ref [u8; 6]) -> i64 {
  let cache: ArpCache = arp_cache_from_state_rpi4();
  let result: ArpLookupResult = netstack_arp_cache_lookup(ref cache, ip);
  if result.found == 1 {
    let i: i64 = 0;
    while i < 6 {
      out_mac[i] = result.mac[i];
      i = i + 1;
    }
  }
  return result.found;
}

fn arp_cache_insert_rpi4(ip: u32, mac: ref [u8; 6]) -> i64 {
  let cache: ArpCache = arp_cache_from_state_rpi4();
  let new_cache: ArpCache = netstack_arp_cache_insert(cache, ip, mac);
  let _ = arp_cache_set_count(new_cache.count as u32);
  let _ = arp_cache_set_next_slot(new_cache.next_slot as u32);
  let i: i64 = 0;
  while i < new_cache.count {
    let _ = arp_cache_set_ip(i as u32, new_cache.ip[i]);
    let j: i64 = 0;
    while j < 6 {
      let _ = arp_cache_set_mac_byte(i as u32, j as u32, new_cache.mac_bytes[i * 6 + j] as u32);
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

// Boot-time self-test: build+parse a request and a reply (round-
// tripping every field), then exercise the cache (insert, lookup,
// lookup-miss, and update-in-place) -- direct port of
// kernel_main.vani's own arp_self_test.
fn arp_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let _ = arp_cache_reset();
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;     // 192.168.1.1
  let target_ip: u32 = 0xC0A80102 as u32; // 192.168.1.2

  let req_frame: [u8; 512] = netif_zero_frame_rpi4();
  let req_len: i64 = arp_build_request_rpi4(mut ref req_frame, ref my_mac, my_ip, target_ip);
  if req_len != 42 { ok = 0; }
  if arp_is_arp_frame_rpi4(ref req_frame) != 1 { ok = 0; }
  if arp_get_operation_rpi4(ref req_frame) != (1 as u32) { ok = 0; }
  if arp_get_sender_ip_rpi4(ref req_frame) != my_ip { ok = 0; }
  if arp_get_target_ip_rpi4(ref req_frame) != target_ip { ok = 0; }
  let req_sender_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = arp_get_sender_mac_rpi4(ref req_frame, mut ref req_sender_mac);
  let si: i64 = 0;
  while si < 6 {
    if req_sender_mac[si] != my_mac[si] { ok = 0; }
    si = si + 1;
  }

  let peer_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x02 as u8];
  let reply_frame: [u8; 512] = netif_zero_frame_rpi4();
  let reply_len: i64 = arp_build_reply_rpi4(mut ref reply_frame, ref peer_mac, target_ip, ref my_mac, my_ip);
  if reply_len != 42 { ok = 0; }
  if arp_get_operation_rpi4(ref reply_frame) != (2 as u32) { ok = 0; }
  if arp_get_sender_ip_rpi4(ref reply_frame) != target_ip { ok = 0; }
  if arp_get_target_ip_rpi4(ref reply_frame) != my_ip { ok = 0; }

  // Cache exercise: miss, insert, hit, update-in-place.
  let miss_out: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  if arp_cache_lookup_rpi4(target_ip, mut ref miss_out) != 0 { ok = 0; }

  let _ = arp_cache_insert_rpi4(target_ip, ref peer_mac);
  let hit_out: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  if arp_cache_lookup_rpi4(target_ip, mut ref hit_out) != 1 { ok = 0; }
  if hit_out[5] != (0x02 as u8) { ok = 0; }

  let updated_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x09 as u8];
  let _ = arp_cache_insert_rpi4(target_ip, ref updated_mac);
  let updated_out: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  if arp_cache_lookup_rpi4(target_ip, mut ref updated_out) != 1 { ok = 0; }
  if updated_out[5] != (0x09 as u8) { ok = 0; }
  if arp_cache_get_count() != (1 as u32) { ok = 0; } // update-in-place, not a 2nd entry

  let _ = uart_puts_rpi4_vani("ARP: build/parse round trip + cache insert/lookup/update");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

fn arp_resolve_start_rpi4(my_mac: ref [u8; 6], my_ip: u32, target_ip: u32) -> i64 {
  let req_frame: [u8; 512] = netif_zero_frame_rpi4();
  let req_len: i64 = arp_build_request_rpi4(mut ref req_frame, my_mac, my_ip, target_ip);
  return netif_send_frame_rpi4(ref req_frame, req_len);
}

// Dequeues the next queued frame and checks whether it's an ARP
// reply resolving target_ip -- if so, caches it and returns 1.
// Returns 0 otherwise (nothing queued, not ARP, not a reply, or a
// different address) -- same "not every queued frame is mine, drop
// it and move on" tolerance kernel_main.vani's own arp_resolve_poll
// already documents.
fn arp_resolve_poll_rpi4(target_ip: u32) -> i64 {
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let frame_len: i64 = netif_recv_frame_rpi4(mut ref frame, 512);
  if frame_len < 0 {
    return 0;
  }
  if arp_is_arp_frame_rpi4(ref frame) != 1 {
    return 0;
  }
  if arp_get_operation_rpi4(ref frame) != (2 as u32) {
    return 0;
  }
  if arp_get_sender_ip_rpi4(ref frame) != target_ip {
    return 0;
  }
  let sender_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = arp_get_sender_mac_rpi4(ref frame, mut ref sender_mac);
  let _ = arp_cache_insert_rpi4(target_ip, ref sender_mac);
  return 1;
}

// Boot-time self-test: no real second host exists in this loopback-
// only environment, so this drains the request arp_resolve_start_
// rpi4 queues on the real netif and sanity-checks it, then manually
// builds a synthetic reply exactly as a real peer would and queues it
// via the real netif, proving arp_resolve_poll_rpi4 picks it up and
// updates the cache correctly -- plus the "nothing arrived yet" case.
// Direct port of kernel_main.vani's own arp_resolve_self_test.
fn arp_resolve_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;
  let target_ip: u32 = 0xC0A80105 as u32; // .5, not touched by arp_self_test_rpi4

  let none_yet: i64 = arp_resolve_poll_rpi4(target_ip);
  if none_yet != 0 {
    ok = 0;
  }

  let start_status: i64 = arp_resolve_start_rpi4(ref my_mac, my_ip, target_ip);
  if start_status != 0 {
    ok = 0;
  }

  let req_check: [u8; 512] = netif_zero_frame_rpi4();
  let req_check_len: i64 = netif_recv_frame_rpi4(mut ref req_check, 512);
  if req_check_len < 0 { ok = 0; }
  if arp_is_arp_frame_rpi4(ref req_check) != 1 { ok = 0; }
  if arp_get_operation_rpi4(ref req_check) != (1 as u32) { ok = 0; }
  if arp_get_target_ip_rpi4(ref req_check) != target_ip { ok = 0; }

  // A peer (192.168.1.5) replying to our request.
  let peer_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x05 as u8];
  let reply_frame: [u8; 512] = netif_zero_frame_rpi4();
  let reply_len: i64 = arp_build_reply_rpi4(mut ref reply_frame, ref peer_mac, target_ip, ref my_mac, my_ip);
  let send_status: i64 = netif_send_frame_rpi4(ref reply_frame, reply_len);
  if send_status != 0 { ok = 0; }

  let resolved: i64 = arp_resolve_poll_rpi4(target_ip);
  if resolved != 1 { ok = 0; }
  let looked_up: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let found: i64 = arp_cache_lookup_rpi4(target_ip, mut ref looked_up);
  if found != 1 { ok = 0; }
  if looked_up[5] != (0x05 as u8) { ok = 0; }

  let _ = uart_puts_rpi4_vani("ARP: arp_resolve_start/poll live round trip");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 88 -- Phase A step 3 of the networking/SSH/WiFi scope: a real
// shared IPv4 header module (kernel_main.vani has one -- ipv4_* --
// despite this scope's own earlier note assuming otherwise; TCP calls
// it directly for header construction, only DHCP/UDP build inline).
// Direct port, unabridged: same 20-byte header layout, no IP options,
// same checksum construction/verification trick. Header layout
// (offsets relative to ip_offset, i.e. 14 bytes into the full
// Ethernet frame):
//   0 version(4 bits)+IHL(4 bits)   1 DSCP+ECN (unused, 0)
//   2-3 total length (header+payload)   4-5 identification (unused, 0)
//   6-7 flags+fragment offset (unused, 0 -- no fragmentation support)
//   8 TTL   9 protocol (1=ICMP, 6=TCP, 17=UDP)
//   10-11 header checksum   12-15 source IP   16-19 destination IP
//
// Reuses round 87's arp_read/write_u16/u32_be_rpi4 as plain generic
// big-endian buffer accessors (their `arp_` prefix is a round-87
// naming artifact, not a real ARP dependency -- writing a second,
// identical pair of helpers under an `ipv4_` name would be pure
// duplication for zero behavioral difference).

// Takes `mut ref`, not `ref`, and reads bytes directly by index
// rather than delegating to arp_read_u16_be_rpi4 -- its only caller,
// ipv4_build_header_rpi4, holds `frame` as a `mut ref` PARAMETER (it
// just wrote the header fields this function needs to sum), and vani
// has no reborrow from `mut ref T` to `ref T` (confirmed via a
// standalone `vanic check` probe -- an already-wrapped `mut ref`
// value can't be passed where a plain `ref` is wanted, only an owned
// local can supply either kind at its own call site). Delegating to
// arp_read_u16_be_rpi4 (which takes `ref`) would hit the exact same
// mismatch one level down, so the read is inlined here instead.
// Round 106c: the header codec's own real ALGORITHM (checksum/build/
// parse) now lives in the shared `netstack` package (`netstack_ipv4_
// *`), confirmed a direct port of this file's own former body before
// extraction. Unlike `filter`/`arp` (which took the caller's real
// frame buffer directly), the package operates on a standalone
// `[u8;20]` header window instead -- so every one of these functions
// copies its own `ip_offset..ip_offset+20` slice out of `frame` (into
// the package), and (for `build_header`) back in, rather than passing
// `frame` itself through.
// No shared extraction helper here (unlike a first draft) -- vani
// has no reborrow from a `mut ref T` parameter to a plain `ref T`
// (the exact limitation this file's own pre-migration `ipv4_
// checksum_rpi4` header comment already documented), so a helper
// taking `ref [u8;512]` can't be called from a function that only
// holds `frame` as `mut ref`. Each function below inlines its own
// 20-byte extraction instead, matching that same pre-existing
// reasoning.
fn ipv4_checksum_rpi4(frame: mut ref [u8; 512], ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_checksum(ref hdr);
}

fn ipv4_build_header_rpi4(frame: mut ref [u8; 512], ip_offset: i64, total_len: i64, protocol: u32, src_ip: u32, dst_ip: u32) -> i64 {
  let hdr: [u8; 20] = netstack_ipv4_build_header(total_len, protocol, src_ip, dst_ip);
  let i: i64 = 0;
  while i < 20 {
    frame[ip_offset + i] = hdr[i];
    i = i + 1;
  }
  return 20;
}

fn ipv4_get_total_len_rpi4(frame: ref [u8; 512], ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_get_total_len(ref hdr);
}

fn ipv4_get_protocol_rpi4(frame: ref [u8; 512], ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_get_protocol(ref hdr);
}

fn ipv4_get_src_ip_rpi4(frame: ref [u8; 512], ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_get_src_ip(ref hdr);
}

fn ipv4_get_dst_ip_rpi4(frame: ref [u8; 512], ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_get_dst_ip(ref hdr);
}

fn ipv4_verify_checksum_rpi4(frame: mut ref [u8; 512], ip_offset: i64) -> i64 {
  let hdr: [u8; 20] = [
    frame[ip_offset], frame[ip_offset + 1], frame[ip_offset + 2], frame[ip_offset + 3], frame[ip_offset + 4],
    frame[ip_offset + 5], frame[ip_offset + 6], frame[ip_offset + 7], frame[ip_offset + 8], frame[ip_offset + 9],
    frame[ip_offset + 10], frame[ip_offset + 11], frame[ip_offset + 12], frame[ip_offset + 13], frame[ip_offset + 14],
    frame[ip_offset + 15], frame[ip_offset + 16], frame[ip_offset + 17], frame[ip_offset + 18], frame[ip_offset + 19]
  ];
  return netstack_ipv4_verify_checksum(ref hdr);
}

// Builds a full Ethernet+IPv4 frame around payload[0..payload_len)
// and sends it via netif. Frame layout: [14-byte Ethernet header]
// [20-byte IP header][payload]. Unlike kernel_main.vani's own
// ipv4_send, there is no persistent net_send_scratch buffer to reuse
// here -- this port has no heap, so a plain local `[u8; 512]` array
// (round 86's netif_zero_frame_rpi4) is built fresh on the stack each
// call instead, same tradeoff every other Pi 4/5 send path already
// makes.
fn ipv4_send_rpi4(my_mac: ref [u8; 6], dst_mac: ref [u8; 6], src_ip: u32, dst_ip: u32, protocol: u32, payload: ref [u8; 512], payload_len: i64) -> i64 {
  let ipv4_max_payload: i64 = netif_get_mtu_rpi4() - 20; // netif's own payload budget, minus the 20-byte IP header
  if (payload_len < 0) || (payload_len > ipv4_max_payload) {
    return 0 - 1;
  }
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let i: i64 = 0;
  while i < 6 {
    frame[i] = dst_mac[i];
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    frame[6 + j] = my_mac[j];
    j = j + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref frame, 12, 0x0800 as u32); // ethertype: IPv4
  let total_len: i64 = 20 + payload_len;
  let _ = ipv4_build_header_rpi4(mut ref frame, 14, total_len, protocol, src_ip, dst_ip);
  let k: i64 = 0;
  while k < payload_len {
    frame[34 + k] = payload[k]; // 14 + 20 = 34
    k = k + 1;
  }
  return netif_send_frame_rpi4(ref frame, 34 + payload_len);
}

// Boot-time (and on-demand, via the `ip` shell command) self-test:
// send an IPv4 packet over the loopback netif, receive it back, and
// verify every header field plus the checksum and payload
// round-tripped correctly. Direct port of kernel_main.vani's own
// ipv4_self_test.
fn ipv4_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let payload: [u8; 512] = netif_zero_frame_rpi4();
  payload[0] = 104 as u8; // 'h'
  payload[1] = 105 as u8; // 'i'

  let send_status: i64 = ipv4_send_rpi4(ref my_mac, ref my_mac, src_ip, dst_ip, 17 as u32, ref payload, 2);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: [u8; 512] = netif_zero_frame_rpi4();
  let recv_len: i64 = netif_recv_frame_rpi4(mut ref recv_frame, 512);
  if recv_len != 36 {
    ok = 0;
  }
  if ipv4_get_total_len_rpi4(ref recv_frame, 14) != (22 as u32) {
    ok = 0;
  }
  if ipv4_get_protocol_rpi4(ref recv_frame, 14) != (17 as u32) {
    ok = 0;
  }
  if ipv4_get_src_ip_rpi4(ref recv_frame, 14) != src_ip {
    ok = 0;
  }
  if ipv4_get_dst_ip_rpi4(ref recv_frame, 14) != dst_ip {
    ok = 0;
  }
  if ipv4_verify_checksum_rpi4(mut ref recv_frame, 14) != 1 {
    ok = 0;
  }
  if (recv_frame[34] != (104 as u8)) || (recv_frame[35] != (105 as u8)) {
    ok = 0;
  }

  let _ = uart_puts_rpi4_vani("IPV4: build/send/recv + checksum verify");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Packet filter, direct port of kernel_main.vani's own filter_* +
// boot/fw_state.S -- see boot/rpi4/filter_state.S's own header
// comment for the rule-table design (unchanged from Pi 1 except the
// AAPCS64-vs-AAPCS32 storage-access detail that comment explains).
// `tcp_get_dst_port_rpi4`/`udp_get_dst_port_rpi4` are deliberately
// tiny stub accessors, not full protocol modules (neither TCP nor UDP
// exist on this port yet, per the scope's own step ordering) -- the
// filter only ever needs the 2-byte dst_port field at a fixed offset,
// exactly what kernel_main.vani's own filter_check_frame calls
// tcp_get_dst_port/udp_get_dst_port for, nothing else.

extern "C" fn filter_get_rule_count() -> u32;
extern "C" fn filter_get_default_policy() -> u32;
extern "C" fn filter_set_default_policy(value: u32) -> u32;
extern "C" fn filter_flush() -> u32;
extern "C" fn filter_add_rule(proto: u32, src_ip: u32, src_ip_valid: u32, dst_port: u32, dst_port_valid: u32, action: u32) -> i64;
extern "C" fn filter_get_rule_proto(index: u32) -> u32;
extern "C" fn filter_get_rule_src_ip(index: u32) -> u32;
extern "C" fn filter_get_rule_src_ip_valid(index: u32) -> u32;
extern "C" fn filter_get_rule_dst_port(index: u32) -> u32;
extern "C" fn filter_get_rule_dst_port_valid(index: u32) -> u32;
extern "C" fn filter_get_rule_action(index: u32) -> u32;

// Round 106a: the packet filter's own real rule-matching ALGORITHM
// (this file's own former `filter_check_frame_rpi4` body) now lives
// in the shared `netstack` kosh package (`netstack_filter_check_
// frame`), confirmed byte-for-byte identical to kernel_main.vani's
// own `filter_check_frame` before extraction. This file's own rule
// TABLE storage (`boot/rpi4/filter_state.S`, the extern accessors
// just above) is untouched -- the package has no persistent state of
// its own (a `FilterConfig` value-type struct threaded through pure
// functions instead, extending the Sha256Ctx/Poly1305Ctx precedent
// from the crypto packages to long-lived protocol state), so this
// function's only job is reading the real board state into a
// `FilterConfig` and handing it to the package.
use "../vendor/netstack/src/lib.vani";
// Round 109: MQTT over plain TCP (Pi 4/5 has no TLS at all -- round
// 108's own finding) -- zero name collisions confirmed via grep
// first, same check performed before every prior vendored package.
use "../vendor/mqtt/src/lib.vani";

fn tcp_get_dst_port_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  return arp_read_u16_be_rpi4(frame, tcp_offset + 2);
}

fn udp_get_dst_port_rpi4(frame: ref [u8; 512], udp_offset: i64) -> u32 {
  return arp_read_u16_be_rpi4(frame, udp_offset + 2);
}

fn filter_config_from_state_rpi4() -> FilterConfig {
  let count: u32 = filter_get_rule_count();
  let proto: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let src_ip: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let src_ip_valid: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let dst_port: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let dst_port_valid: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let action: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let i: u32 = 0 as u32;
  while i < count {
    proto[i] = filter_get_rule_proto(i);
    src_ip[i] = filter_get_rule_src_ip(i);
    src_ip_valid[i] = filter_get_rule_src_ip_valid(i);
    dst_port[i] = filter_get_rule_dst_port(i);
    dst_port_valid[i] = filter_get_rule_dst_port_valid(i);
    action[i] = filter_get_rule_action(i);
    i = i + (1 as u32);
  }
  return FilterConfig {
    rule_count: count as i64,
    default_policy: filter_get_default_policy(),
    proto: proto,
    src_ip: src_ip,
    src_ip_valid: src_ip_valid,
    dst_port: dst_port,
    dst_port_valid: dst_port_valid,
    action: action
  };
}

fn filter_check_frame_rpi4(frame: ref [u8; 512], frame_len: i64, is_outgoing: u32) -> u32 {
  let cfg: FilterConfig = filter_config_from_state_rpi4();
  return netstack_filter_check_frame(frame, frame_len, is_outgoing, ref cfg);
}

fn filter_build_test_frame_rpi4(frame: mut ref [u8; 512], proto: u32, src_ip: u32, dst_port: u32) -> i64 {
  let _ = arp_write_u16_be_rpi4(frame, 12, 0x0800 as u32); // ethertype: IPv4
  frame[23] = proto as u8;                                 // ip_offset(14)+9
  let _ = arp_write_u32_be_rpi4(frame, 26, src_ip);        // ip_offset(14)+12
  let _ = arp_write_u16_be_rpi4(frame, 36, dst_port);      // tcp/udp_offset(34)+2
  return 38;
}

fn filter_build_test_frame_dst_rpi4(frame: mut ref [u8; 512], proto: u32, dst_ip: u32, dst_port: u32) -> i64 {
  let _ = arp_write_u16_be_rpi4(frame, 12, 0x0800 as u32); // ethertype: IPv4
  frame[23] = proto as u8;                                 // ip_offset(14)+9
  let _ = arp_write_u32_be_rpi4(frame, 30, dst_ip);        // ip_offset(14)+16
  let _ = arp_write_u16_be_rpi4(frame, 36, dst_port);      // tcp/udp_offset(34)+2
  return 38;
}

// Boot-time (and on-demand, via the `filter` shell command) self-test
// for filter_check_frame_rpi4's rule-matching logic against synthetic
// frames. Saves/restores the real global filter state (default policy
// + rule table) around itself. Direct port of kernel_main.vani's own
// filter_self_test.
fn filter_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let saved_policy: u32 = filter_get_default_policy();
  let _ = filter_flush();

  let ip_a: u32 = 0x0A000001 as u32; // 10.0.0.1
  let ip_b: u32 = 0x0A000002 as u32; // 10.0.0.2

  // 1. No rules at all: every frame falls through to the default
  // policy. Set default to deny and confirm a TCP frame is denied.
  let _ = filter_set_default_policy(0 as u32);
  let f1: [u8; 512] = netif_zero_frame_rpi4();
  let l1: i64 = filter_build_test_frame_rpi4(mut ref f1, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame_rpi4(ref f1, l1, 0 as u32) != (0 as u32) { ok = 0; }

  // 2. A specific deny rule overrides a permissive default, but only
  // for the src_ip it actually names.
  let _ = filter_set_default_policy(1 as u32);
  let _ = filter_add_rule(6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32);
  let f2: [u8; 512] = netif_zero_frame_rpi4();
  let l2: i64 = filter_build_test_frame_rpi4(mut ref f2, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame_rpi4(ref f2, l2, 0 as u32) != (0 as u32) { ok = 0; }
  let f3: [u8; 512] = netif_zero_frame_rpi4();
  let l3: i64 = filter_build_test_frame_rpi4(mut ref f3, 6 as u32, ip_b, 80 as u32);
  if filter_check_frame_rpi4(ref f3, l3, 0 as u32) != (1 as u32) { ok = 0; }

  // 3. Protocol specificity: the same rule must not match UDP traffic
  // on the identical src_ip/port.
  let f4: [u8; 512] = netif_zero_frame_rpi4();
  let l4: i64 = filter_build_test_frame_rpi4(mut ref f4, 17 as u32, ip_a, 80 as u32);
  if filter_check_frame_rpi4(ref f4, l4, 0 as u32) != (1 as u32) { ok = 0; }

  // 4. First-match-wins: an earlier wildcard deny must shadow a later,
  // more specific allow rule.
  let _ = filter_flush();
  let _ = filter_add_rule(0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32); // deny everything
  let _ = filter_add_rule(6 as u32, 0 as u32, 0 as u32, 443 as u32, 1 as u32, 1 as u32); // allow TCP/443 (shadowed)
  let f5: [u8; 512] = netif_zero_frame_rpi4();
  let l5: i64 = filter_build_test_frame_rpi4(mut ref f5, 6 as u32, ip_a, 443 as u32);
  if filter_check_frame_rpi4(ref f5, l5, 0 as u32) != (0 as u32) { ok = 0; }

  // 5. A rule naming a specific dst_port must never match a portless
  // protocol (ICMP).
  let _ = filter_flush();
  let _ = filter_add_rule(0 as u32, 0 as u32, 0 as u32, 80 as u32, 1 as u32, 0 as u32); // deny port 80
  let _ = filter_set_default_policy(1 as u32);
  let f6: [u8; 512] = netif_zero_frame_rpi4();
  let l6: i64 = filter_build_test_frame_rpi4(mut ref f6, 1 as u32, ip_a, 80 as u32); // ICMP
  if filter_check_frame_rpi4(ref f6, l6, 0 as u32) != (1 as u32) { ok = 0; }

  // 6. Non-IPv4 traffic (e.g. ARP) passes through untouched regardless
  // of policy or rules.
  let _ = filter_set_default_policy(0 as u32);
  let f7: [u8; 512] = netif_zero_frame_rpi4();
  let _ = arp_write_u16_be_rpi4(mut ref f7, 12, 0x0806 as u32); // ethertype: ARP
  if filter_check_frame_rpi4(ref f7, 38, 0 as u32) != (1 as u32) { ok = 0; }

  let _ = filter_flush();
  let _ = filter_set_default_policy(saved_policy);

  let _ = uart_puts_rpi4_vani("FW: packet filter rule matching (default/specific/proto/order/port/non-ip)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Outgoing packet filtering -- both filter_check_frame_rpi4's own
// directional logic (a rule's src_ip field means "the other party,"
// so it must match an outgoing frame's DESTINATION) and the real
// netif_send_frame_rpi4 integration (a denied frame must never reach
// the loopback queue at all, while reporting success -- the sender
// never learns). Direct port of kernel_main.vani's own
// filter_outgoing_self_test.
fn filter_outgoing_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let saved_policy: u32 = filter_get_default_policy();
  let _ = filter_flush();

  let ip_a: u32 = 0x0A000003 as u32; // 10.0.0.3
  let ip_b: u32 = 0x0A000004 as u32; // 10.0.0.4

  // 1. A rule naming ip_a must match an OUTGOING frame whose
  // DESTINATION is ip_a, even though that same frame's own literal
  // source-IP field (never written here, reads as 0) would never
  // match it.
  let _ = filter_set_default_policy(1 as u32);
  let _ = filter_add_rule(6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32); // deny TCP/80 to ip_a
  let f1: [u8; 512] = netif_zero_frame_rpi4();
  let l1: i64 = filter_build_test_frame_dst_rpi4(mut ref f1, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame_rpi4(ref f1, l1, 1 as u32) != (0 as u32) { ok = 0; }
  // The SAME frame checked as INCOMING must NOT match.
  if filter_check_frame_rpi4(ref f1, l1, 0 as u32) != (1 as u32) { ok = 0; }
  // A different destination still falls through to the (allow) default.
  let f2: [u8; 512] = netif_zero_frame_rpi4();
  let l2: i64 = filter_build_test_frame_dst_rpi4(mut ref f2, 6 as u32, ip_b, 80 as u32);
  if filter_check_frame_rpi4(ref f2, l2, 1 as u32) != (1 as u32) { ok = 0; }

  // 2. Real integration: netif_send_frame_rpi4 must actually drop a
  // filtered outgoing frame (never queued) while still queuing a
  // non-denied one normally.
  let before_count: u32 = netif_state_count();
  let send_denied: i64 = netif_send_frame_rpi4(ref f1, l1);
  if send_denied != 0 { ok = 0; }
  if netif_state_count() != before_count { ok = 0; } // never queued

  let send_allowed: i64 = netif_send_frame_rpi4(ref f2, l2);
  if send_allowed != 0 { ok = 0; }
  if netif_state_count() != (before_count + (1 as u32)) { ok = 0; } // queued normally
  let drain: [u8; 512] = netif_zero_frame_rpi4();
  let _ = netif_recv_frame_rpi4(mut ref drain, 512); // don't leave it queued for a later test

  let _ = filter_flush();
  let _ = filter_set_default_policy(saved_policy);

  let _ = uart_puts_rpi4_vani("FW: outgoing packet filtering (netif_send_frame egress hook, directional src/dst semantics)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 89 -- Phase A step 4 of the networking/SSH/WiFi scope: TCP,
// built on rounds 86-88's netif/ARP/IPv4+filter. Direct port of
// kernel_main.vani's own stateless header layer (`tcp_flag_*`/
// `tcp_checksum`/`tcp_build_header`/`tcp_get_*`/`tcp_verify_checksum`/
// `tcp_send_segment`/`tcp_self_test`), same 20-byte header (no
// options), same pseudo-header checksum construction.
//
// Reuses round 88's `tcp_get_dst_port_rpi4` as-is (identical
// signature and behavior to what this module needs) rather than
// redefining it under the same name -- it was already the real,
// canonical accessor, just introduced early for the packet filter's
// own narrow need.
//
// Ref-kind design decided UP FRONT this round, not reactively, per
// round 88's own reborrow-gap lesson (`vani-compiler/docs/DHRUVAOS_
// ERGONOMICS_TODO.md` gap #3): every `tcp_get_*_rpi4`/`tcp_checksum_
// rpi4`/`tcp_verify_checksum_rpi4` below takes plain `ref [u8; 512]`
// (matching the whole IPv4/ARP read-only chain from prior rounds),
// since their real callers (`tcp_self_test_rpi4`, `tcp_conn_handle_
// segment_rpi4`) only ever hold `ref` frames. The ONE place that
// genuinely needs `mut ref` (`tcp_build_header_rpi4`, which writes
// the header then must read it back to checksum it) computes that
// checksum with an INLINE loop instead of delegating to `tcp_
// checksum_rpi4` -- the same fix shape round 88 already used for
// `ipv4_build_header_rpi4`, applied proactively here instead of
// discovered via a `vanic check` error this time.

// Round 106f: TCP's own header codec/checksum ALGORITHM now lives in
// the shared `netstack` package (`netstack_tcp_*`/`UdpChecksumCtx`
// reused), confirmed a direct port of this file's own former body.
// TCP's checksum spans the whole segment (header+payload, genuinely
// variable length like UDP's own scope) so it streams; the 20-byte
// header itself is fixed, so it gets its own standalone codec
// matching IPv4's own precedent. Same `mut ref`->`ref` no-reborrow
// limitation as every prior round's own header codecs -- each
// function inlines its own header-window extraction.
fn tcp_flag_fin_rpi4() -> u32 { return netstack_tcp_flag_fin(); }
fn tcp_flag_syn_rpi4() -> u32 { return netstack_tcp_flag_syn(); }
fn tcp_flag_rst_rpi4() -> u32 { return netstack_tcp_flag_rst(); }
fn tcp_flag_psh_rpi4() -> u32 { return netstack_tcp_flag_psh(); }
fn tcp_flag_ack_rpi4() -> u32 { return netstack_tcp_flag_ack(); }

fn tcp_checksum_rpi4(src_ip: u32, dst_ip: u32, frame: ref [u8; 512], tcp_offset: i64, tcp_len: i64) -> u32 {
  let ctx: UdpChecksumCtx = netstack_tcp_checksum_init(src_ip, dst_ip, tcp_len);
  let pos: i64 = 0;
  while pos < tcp_len {
    let remaining: i64 = tcp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let i: i64 = 0;
    while i < take {
      chunk[i] = frame[tcp_offset + pos + i];
      i = i + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  return netstack_tcp_checksum_finalize(ref ctx);
}

fn tcp_verify_checksum_rpi4(src_ip: u32, dst_ip: u32, frame: ref [u8; 512], tcp_offset: i64, tcp_len: i64) -> i64 {
  if tcp_checksum_rpi4(src_ip, dst_ip, frame, tcp_offset, tcp_len) == (0 as u32) {
    return 1;
  }
  return 0;
}

fn tcp_build_header_rpi4(frame: mut ref [u8; 512], tcp_offset: i64, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: ref [u8; 512], payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let tcp_len: i64 = 20 + payload_len;
  let hdr: [u8; 20] = netstack_tcp_header_only(src_port, dst_port, seq, ack, flags, window);
  let hi: i64 = 0;
  while hi < 20 {
    frame[tcp_offset + hi] = hdr[hi];
    hi = hi + 1;
  }
  let j: i64 = 0;
  while j < payload_len {
    frame[tcp_offset + 20 + j] = payload[j];
    j = j + 1;
  }

  let ctx: UdpChecksumCtx = netstack_tcp_checksum_init(src_ip, dst_ip, tcp_len);
  let pos: i64 = 0;
  while pos < tcp_len {
    let remaining: i64 = tcp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let k: i64 = 0;
    while k < take {
      chunk[k] = frame[tcp_offset + pos + k];
      k = k + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  let checksum: u32 = netstack_tcp_checksum_finalize(ref ctx);
  let checksum_bytes: [u8; 2] = netstack_tcp_encode_checksum(checksum);
  frame[tcp_offset + 16] = checksum_bytes[0];
  frame[tcp_offset + 17] = checksum_bytes[1];
  return tcp_len;
}

fn tcp_get_src_port_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_src_port(ref hdr);
}
fn tcp_get_seq_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_seq(ref hdr);
}
fn tcp_get_ack_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_ack(ref hdr);
}
fn tcp_get_flags_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_flags(ref hdr);
}
fn tcp_get_window_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_window(ref hdr);
}
fn tcp_get_data_offset_bytes_rpi4(frame: ref [u8; 512], tcp_offset: i64) -> i64 {
  let hdr: [u8; 20] = [
    frame[tcp_offset], frame[tcp_offset + 1], frame[tcp_offset + 2], frame[tcp_offset + 3], frame[tcp_offset + 4],
    frame[tcp_offset + 5], frame[tcp_offset + 6], frame[tcp_offset + 7], frame[tcp_offset + 8], frame[tcp_offset + 9],
    frame[tcp_offset + 10], frame[tcp_offset + 11], frame[tcp_offset + 12], frame[tcp_offset + 13], frame[tcp_offset + 14],
    frame[tcp_offset + 15], frame[tcp_offset + 16], frame[tcp_offset + 17], frame[tcp_offset + 18], frame[tcp_offset + 19]
  ];
  return netstack_tcp_get_data_offset_bytes(ref hdr);
}

// Builds a full Ethernet+IPv4+TCP segment and sends it via netif.
// Fixed offsets (14 for IP, 34 for TCP) since this stack never sends
// IP options, matching kernel_main.vani's own tcp_send_segment.
fn tcp_send_segment_rpi4(my_mac: ref [u8; 6], dst_mac: ref [u8; 6], src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: ref [u8; 512], payload_len: i64) -> i64 {
  let tcp_max_payload: i64 = netif_get_mtu_rpi4() - 20 - 20; // minus IP header, minus TCP header (no options)
  if (payload_len < 0) || (payload_len > tcp_max_payload) {
    return 0 - 1;
  }
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let i: i64 = 0;
  while i < 6 {
    frame[i] = dst_mac[i];
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    frame[6 + j] = my_mac[j];
    j = j + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref frame, 12, 0x0800 as u32); // ethertype: IPv4
  let tcp_len: i64 = tcp_build_header_rpi4(mut ref frame, 34, src_port, dst_port, seq, ack, flags, window, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + tcp_len;
  let _ = ipv4_build_header_rpi4(mut ref frame, 14, total_len, 6 as u32, src_ip, dst_ip);
  return netif_send_frame_rpi4(ref frame, 14 + total_len);
}

// Boot-time (and on-demand, via the `tcp` shell command) self-test:
// build/send/receive a single SYN segment over the loopback netif and
// verify every TCP header field, the checksum, and the (empty, for a
// SYN) payload round-tripped correctly. Direct port of
// kernel_main.vani's own tcp_self_test.
fn tcp_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let src_port: u32 = 54321 as u32;
  let dst_port: u32 = 80 as u32;
  let seq: u32 = 1000 as u32;
  let ack: u32 = 0 as u32;
  let empty_payload: [u8; 512] = netif_zero_frame_rpi4();

  let send_status: i64 = tcp_send_segment_rpi4(ref my_mac, ref my_mac, src_ip, dst_ip, src_port, dst_port, seq, ack, tcp_flag_syn_rpi4(), 65535 as u32, ref empty_payload, 0);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: [u8; 512] = netif_zero_frame_rpi4();
  let recv_len: i64 = netif_recv_frame_rpi4(mut ref recv_frame, 512);
  if recv_len != 54 { // 14 (eth) + 20 (ip) + 20 (tcp), no payload
    ok = 0;
  }
  if tcp_get_src_port_rpi4(ref recv_frame, 34) != src_port {
    ok = 0;
  }
  if tcp_get_dst_port_rpi4(ref recv_frame, 34) != dst_port {
    ok = 0;
  }
  if tcp_get_seq_rpi4(ref recv_frame, 34) != seq {
    ok = 0;
  }
  if tcp_get_ack_rpi4(ref recv_frame, 34) != ack {
    ok = 0;
  }
  if tcp_get_flags_rpi4(ref recv_frame, 34) != tcp_flag_syn_rpi4() {
    ok = 0;
  }
  if tcp_get_data_offset_bytes_rpi4(ref recv_frame, 34) != 20 {
    ok = 0;
  }
  if tcp_verify_checksum_rpi4(src_ip, dst_ip, ref recv_frame, 34, 20) != 1 {
    ok = 0;
  }
  if ipv4_get_protocol_rpi4(ref recv_frame, 14) != (6 as u32) {
    ok = 0;
  }

  let _ = uart_puts_rpi4_vani("TCP: header build/send/recv + checksum verify (SYN)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// TCP's stateful connection layer -- three-way handshake, data
// transfer, and a simplified close. Direct port of kernel_main.vani's
// own `tcp_conn_*` family onto round 86's netif, exactly two fixed
// connection slots (0=client/active-open, 1=server/passive-open),
// same as Pi 1 -- this single-threaded environment has no second task
// to run "the other side" concurrently, so `tcp_conn_self_test_rpi4`
// below plays traffic cop between both slots itself, exactly like
// kernel_main.vani's own tcp_conn_self_test.
//
// Scoped like Pi 1's own TCP: a real, correctly-sequenced connection
// lifecycle (handshake, simultaneous open, data transfer, one-sided
// AND simultaneous close, retransmission timers, advertised-window
// enforcement -- every branch below is a direct, unabridged port, not
// a subset), not spec-complete (no urgent pointer, no zero-window
// probing). **Not ported this round**: kernel_main.vani's own
// dedicated regression self-tests for a few of these branches
// (tcp_conn_recv_bounds_self_test, tcp_conn_simultaneous_open_self_
// test, tcp_conn_simultaneous_close_self_test, tcp_conn_window_
// enforcement_self_test) -- the underlying logic they each exercise
// IS fully present and live in the state machine below (nothing is
// stubbed or truncated), just not independently re-verified via its
// own dedicated synthetic fixture this round. A real, honest scope
// boundary for a single round on the largest single port in this
// scope, not an oversight -- see this round's own project memory.
extern "C" fn tcp_conn_reset(conn_id: u32) -> u32;
extern "C" fn tcp_conn_get_state(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_state(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_local_seq(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_local_seq(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_remote_seq(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_remote_seq(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_local_port(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_local_port(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_remote_port(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_remote_port(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_local_ip(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_local_ip(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_remote_ip(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_remote_ip(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_rtx_deadline(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_rtx_deadline(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_rtx_count(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_rtx_count(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_rtx_seq(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_rtx_seq(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_rtx_len(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_rtx_len(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_remote_window(conn_id: u32) -> u32;
extern "C" fn tcp_conn_set_remote_window(conn_id: u32, value: u32) -> u32;
extern "C" fn tcp_conn_get_rtx_byte(conn_id: u32, byte_idx: u32) -> u32;
extern "C" fn tcp_conn_set_rtx_byte(conn_id: u32, byte_idx: u32, value: u32) -> u32;
extern "C" fn rpi4_timer_tick_count_get() -> i64;

fn tcp_state_closed_rpi4() -> u32 { return 0 as u32; }
fn tcp_state_syn_sent_rpi4() -> u32 { return 1 as u32; }
fn tcp_state_syn_rcvd_rpi4() -> u32 { return 2 as u32; }
fn tcp_state_established_rpi4() -> u32 { return 3 as u32; }
fn tcp_state_fin_wait_rpi4() -> u32 { return 4 as u32; }
fn tcp_state_closed_final_rpi4() -> u32 { return 5 as u32; }
fn tcp_state_closing_rpi4() -> u32 { return 6 as u32; }

fn tcp_rtx_timeout_ticks_rpi4() -> u32 { return 4 as u32; }
fn tcp_rtx_max_retries_rpi4() -> u32 { return 3 as u32; }

// Active open (the connecting/"client" side): records connection
// identity, picks an initial sequence number, and sends the opening
// SYN. Conn moves to SYN_SENT; the handshake only completes once the
// caller feeds a matching SYN-ACK segment into
// tcp_conn_handle_segment_rpi4. Also arms the SYN's own
// retransmission timer (rtx_len=0 marks a bare-SYN retransmission).
fn tcp_conn_active_open_rpi4(conn_id: u32, my_mac: ref [u8; 6], dst_mac: ref [u8; 6], local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, initial_seq: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_remote_port(conn_id, remote_port);
  let _ = tcp_conn_set_local_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_remote_seq(conn_id, 0 as u32);
  let _ = tcp_conn_set_remote_window(conn_id, 65535 as u32); // sane default until the peer's first real segment says otherwise
  let _ = tcp_conn_set_state(conn_id, tcp_state_syn_sent_rpi4());
  let _ = tcp_conn_set_rtx_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_rtx_len(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_deadline(conn_id, (rpi4_timer_tick_count_get() as u32) + tcp_rtx_timeout_ticks_rpi4());
  let empty_payload: [u8; 512] = netif_zero_frame_rpi4();
  return tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, initial_seq, 0 as u32, tcp_flag_syn_rpi4(), 65535 as u32, ref empty_payload, 0);
}

// Passive open (the listening/"server" side): records only the local
// identity it's willing to accept a connection on -- remote identity
// and sequence numbers get filled in once tcp_conn_handle_segment_
// rpi4 sees the actual incoming SYN. Conn stays CLOSED until then
// (no separate LISTEN state, matching kernel_main.vani's own scope).
fn tcp_conn_passive_open_rpi4(conn_id: u32, local_ip: u32, local_port: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_remote_window(conn_id, 65535 as u32);
  let _ = tcp_conn_set_state(conn_id, tcp_state_closed_rpi4());
  return 0;
}

// The core state-machine step: given one already-received TCP segment
// (frame, with its IPv4/Ethernet headers still in place at their
// usual fixed offsets) addressed to this connection, takes whatever
// single reaction the current state calls for and returns:
//   >= 0  a data segment was accepted; return value is the payload
//         length copied into out_payload (0 for a control-only
//         segment, the common case)
//   -1    the segment didn't match anything this state expects
// Direct port of kernel_main.vani's own tcp_conn_handle_segment,
// including its own round-8-audit checksum verification and
// round-8-audit data-segment bounds checks.
fn tcp_conn_handle_segment_rpi4(conn_id: u32, frame: ref [u8; 512], recv_len: i64, my_mac: ref [u8; 6], dst_mac: ref [u8; 6], out_payload: mut ref [u8; 512], max_payload_len: i64) -> i64 {
  let tcp_seg_len: i64 = recv_len - 34;
  let checksum_src_ip: u32 = ipv4_get_src_ip_rpi4(frame, 14);
  let checksum_dst_ip: u32 = ipv4_get_dst_ip_rpi4(frame, 14);
  if tcp_verify_checksum_rpi4(checksum_src_ip, checksum_dst_ip, frame, 34, tcp_seg_len) != 1 {
    return 0 - 1;
  }
  let state: u32 = tcp_conn_get_state(conn_id);
  let flags: u32 = tcp_get_flags_rpi4(frame, 34);
  let seg_seq: u32 = tcp_get_seq_rpi4(frame, 34);
  let seg_ack: u32 = tcp_get_ack_rpi4(frame, 34);
  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);

  let has_syn: i64 = 0;
  if (flags & tcp_flag_syn_rpi4()) != (0 as u32) { has_syn = 1; }
  let has_ack: i64 = 0;
  if (flags & tcp_flag_ack_rpi4()) != (0 as u32) { has_ack = 1; }
  let has_fin: i64 = 0;
  if (flags & tcp_flag_fin_rpi4()) != (0 as u32) { has_fin = 1; }
  let has_psh: i64 = 0;
  if (flags & tcp_flag_psh_rpi4()) != (0 as u32) { has_psh = 1; }

  let _ = tcp_conn_set_remote_window(conn_id, tcp_get_window_rpi4(frame, 34));

  let empty_payload: [u8; 512] = netif_zero_frame_rpi4();

  // Passive open, first SYN arriving.
  if (state == tcp_state_closed_rpi4()) && (has_syn == 1) && (tcp_get_dst_port_rpi4(frame, 34) == local_port) {
    let _ = tcp_conn_set_remote_ip(conn_id, ipv4_get_src_ip_rpi4(frame, 14));
    let _ = tcp_conn_set_remote_port(conn_id, tcp_get_src_port_rpi4(frame, 34));
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // SYN consumes one seq number
    let server_isn: u32 = 5000 as u32;
    let _ = tcp_conn_set_local_seq(conn_id, server_isn);
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd_rpi4());
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), server_isn, tcp_conn_get_remote_seq(conn_id), tcp_flag_syn_rpi4() | tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
    return 0;
  }

  // Active-open side receiving the SYN-ACK: completes with our own
  // final ACK, moving straight to ESTABLISHED.
  if (state == tcp_state_syn_sent_rpi4()) && (has_syn == 1) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let new_local_seq: u32 = tcp_conn_get_local_seq(conn_id) + (1 as u32); // our own SYN consumed one
    let _ = tcp_conn_set_local_seq(conn_id, new_local_seq);
    let _ = tcp_conn_set_state(conn_id, tcp_state_established_rpi4());
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), new_local_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
    return 0;
  }

  // Simultaneous open: both sides issue active_open at roughly the
  // same time, so this side is still in SYN_SENT when the peer's own
  // bare SYN (no ACK) arrives instead of a SYN-ACK. Answer with
  // SYN+ACK and move to SYN_RCVD -- the exact state passive_open's
  // own first-SYN branch above already produces.
  if (state == tcp_state_syn_sent_rpi4()) && (has_syn == 1) && (has_ack == 0) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32); // peer answered
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd_rpi4());
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_syn_rpi4() | tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
    return 0;
  }

  // Passive-open side receiving the final ACK of the handshake.
  if (state == tcp_state_syn_rcvd_rpi4()) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_established_rpi4());
    return 0;
  }

  // Established, a data segment arrives in order: copy the payload
  // out, advance what we expect next, and acknowledge it. Same
  // round-8-audit bounds checks as kernel_main.vani's own version
  // (reject a negative length, a declared extent past recv_len, a
  // payload bigger than the caller's own buffer, or a data_offset
  // under 20 bytes).
  if (state == tcp_state_established_rpi4()) && (has_psh == 1) && (seg_seq == tcp_conn_get_remote_seq(conn_id)) {
    let tcp_len: i64 = (ipv4_get_total_len_rpi4(frame, 14) as i64) - 20;
    let data_offset: i64 = tcp_get_data_offset_bytes_rpi4(frame, 34);
    let payload_len: i64 = tcp_len - data_offset;
    if data_offset < 20 {
      return 0 - 1;
    }
    if payload_len < 0 {
      return 0 - 1;
    }
    if (34 + data_offset + payload_len) > recv_len {
      return 0 - 1;
    }
    if payload_len > max_payload_len {
      return 0 - 1;
    }
    let i: i64 = 0;
    while i < payload_len {
      out_payload[i] = frame[34 + data_offset + i];
      i = i + 1;
    }
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (payload_len as u32));
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
    return payload_len;
  }

  // Established, a pure ACK for data we sent -- cancel a pending
  // retransmission if this ACK covers it.
  if (state == tcp_state_established_rpi4()) && (has_ack == 1) && (has_fin == 0) && (has_psh == 0) && (has_syn == 0) {
    if tcp_conn_get_rtx_deadline(conn_id) != (0 as u32) {
      let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
      let rtx_len: u32 = tcp_conn_get_rtx_len(conn_id);
      if seg_ack >= (rtx_seq + rtx_len) {
        let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
      }
    }
    return 0;
  }

  // Established, the peer starts closing: piggyback our own FIN onto
  // the ACK and move to FIN_WAIT for the final ACK.
  if (state == tcp_state_established_rpi4()) && (has_fin == 1) {
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // FIN consumes one seq number
    let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait_rpi4());
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack_rpi4() | tcp_flag_fin_rpi4(), 65535 as u32, ref empty_payload, 0);
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // our own FIN
    return 0;
  }

  // The initiating closer receiving the peer's response to its own
  // FIN -- may carry the peer's own piggybacked FIN too (one-sided
  // close) or arrive as a separate, independent FIN (simultaneous
  // close, RFC 793 CLOSING) if the peer never saw ours first.
  // our_fin_acked checks seg_ack against our own local_seq (already
  // advanced past our FIN's own sequence number by tcp_conn_close_
  // rpi4) rather than assuming any ack qualifies.
  if (state == tcp_state_fin_wait_rpi4()) && (has_ack == 1) {
    let our_fin_acked: i64 = if seg_ack == tcp_conn_get_local_seq(conn_id) { 1 } else { 0 };
    if has_fin == 1 {
      let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
      let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
      if our_fin_acked == 1 {
        let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final_rpi4());
      } else {
        // Simultaneous close: the peer's FIN arrived independently,
        // before it had seen ours. We've just ACKed its FIN above;
        // now wait in CLOSING for it to separately ACK ours.
        let _ = tcp_conn_set_state(conn_id, tcp_state_closing_rpi4());
      }
    } else {
      if our_fin_acked == 1 {
        let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final_rpi4());
      }
    }
    return 0;
  }

  // CLOSING (simultaneous close only reaches this state via the
  // FIN_WAIT branch above) -- we already ACKed the peer's own FIN;
  // this is specifically waiting for the peer's separate ACK of ours.
  if (state == tcp_state_closing_rpi4()) && (has_ack == 1) && (seg_ack == tcp_conn_get_local_seq(conn_id)) {
    let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final_rpi4());
    return 0;
  }

  return 0 - 1;
}

// Sends one data segment on an ESTABLISHED connection. local_seq
// advances immediately (this project's own segments are never split/
// coalesced). Buffers the segment (its starting seq + payload bytes)
// into this connection's own retransmit slot and arms the retransmit
// timer. payload_len is capped at 64 bytes, tcp_conn_rtx_buf's real
// per-connection capacity (boot/rpi4/tcp_state.S). Refuses to send
// more than the peer's own last-advertised window -- no zero-window
// probe/retry, a real, honest scope boundary matching kernel_main
// .vani's own.
fn tcp_conn_send_data_rpi4(conn_id: u32, my_mac: ref [u8; 6], dst_mac: ref [u8; 6], payload: ref [u8; 512], payload_len: i64) -> i64 {
  if (payload_len < 0) || (payload_len > (64 as i64)) {
    return 0 - 1;
  }
  if payload_len > (tcp_conn_get_remote_window(conn_id) as i64) {
    return 0 - 1;
  }
  let seq_before: u32 = tcp_conn_get_local_seq(conn_id);
  let status: i64 = tcp_send_segment_rpi4(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), seq_before, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh_rpi4() | tcp_flag_ack_rpi4(), 65535 as u32, payload, payload_len);
  let _ = tcp_conn_set_local_seq(conn_id, seq_before + (payload_len as u32));
  if status == 0 {
    let i: i64 = 0;
    while i < payload_len {
      let _ = tcp_conn_set_rtx_byte(conn_id, i as u32, payload[i] as u32);
      i = i + 1;
    }
    let _ = tcp_conn_set_rtx_seq(conn_id, seq_before);
    let _ = tcp_conn_set_rtx_len(conn_id, payload_len as u32);
    let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
    let _ = tcp_conn_set_rtx_deadline(conn_id, (rpi4_timer_tick_count_get() as u32) + tcp_rtx_timeout_ticks_rpi4());
  }
  return status;
}

// Starts closing an ESTABLISHED connection from this side: sends FIN,
// moves to FIN_WAIT. Teardown completes once the caller feeds the
// peer's own FIN+ACK (or separate FIN) back into
// tcp_conn_handle_segment_rpi4.
fn tcp_conn_close_rpi4(conn_id: u32, my_mac: ref [u8; 6], dst_mac: ref [u8; 6]) -> i64 {
  let empty_payload: [u8; 512] = netif_zero_frame_rpi4();
  let status: i64 = tcp_send_segment_rpi4(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_fin_rpi4() | tcp_flag_ack_rpi4(), 65535 as u32, ref empty_payload, 0);
  let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // FIN consumes one
  let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait_rpi4());
  return status;
}

// Fires whenever a connection's own pending retransmission (armed by
// active_open for a SYN, or send_data for a data segment) is actually
// due. Returns 0 if nothing was due, 1 if a retransmission was just
// sent, -1 if this connection just gave up (exceeded
// tcp_rtx_max_retries_rpi4) -- a SYN give-up resets to CLOSED; a data
// give-up leaves the connection's own state alone.
fn tcp_conn_check_retransmit_rpi4(conn_id: u32, my_mac: ref [u8; 6], dst_mac: ref [u8; 6]) -> i64 {
  let deadline: u32 = tcp_conn_get_rtx_deadline(conn_id);
  if deadline == (0 as u32) {
    return 0;
  }
  if (rpi4_timer_tick_count_get() as u32) < deadline {
    return 0;
  }
  let count: u32 = tcp_conn_get_rtx_count(conn_id);
  if count >= tcp_rtx_max_retries_rpi4() {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    if tcp_conn_get_state(conn_id) == tcp_state_syn_sent_rpi4() {
      let _ = tcp_conn_set_state(conn_id, tcp_state_closed_rpi4());
    }
    return 0 - 1;
  }

  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);
  let remote_ip: u32 = tcp_conn_get_remote_ip(conn_id);
  let remote_port: u32 = tcp_conn_get_remote_port(conn_id);
  let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
  let rtx_len: i64 = tcp_conn_get_rtx_len(conn_id) as i64;
  if rtx_len == 0 {
    // Bare-SYN retransmission -- active_open's own SYN never got a
    // reply.
    let empty_payload: [u8; 512] = netif_zero_frame_rpi4();
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, 0 as u32, tcp_flag_syn_rpi4(), 65535 as u32, ref empty_payload, 0);
  } else {
    // Data-segment retransmission -- rebuild the payload from this
    // connection's own byte-level rtx storage (boot/rpi4/tcp_state.S)
    // into a fresh local array, then resend it.
    let rtx_payload: [u8; 512] = netif_zero_frame_rpi4();
    let i: i64 = 0;
    while i < rtx_len {
      rtx_payload[i] = tcp_conn_get_rtx_byte(conn_id, i as u32) as u8;
      i = i + 1;
    }
    let _ = tcp_send_segment_rpi4(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh_rpi4() | tcp_flag_ack_rpi4(), 65535 as u32, ref rtx_payload, rtx_len);
  }
  let _ = tcp_conn_set_rtx_count(conn_id, count + (1 as u32));
  let _ = tcp_conn_set_rtx_deadline(conn_id, (rpi4_timer_tick_count_get() as u32) + tcp_rtx_timeout_ticks_rpi4());
  return 1;
}

// The live counterpart to tcp_conn_self_test_rpi4's own hand-driven
// "traffic cop" role: dequeues the next queued frame and, if it's TCP
// addressed to either connection slot, routes it to tcp_conn_handle_
// segment_rpi4. Also the live echo-service responder: if the SERVER
// connection (slot 1) just received real data, echoes it straight
// back via tcp_conn_send_data_rpi4, returning -2 (matching kernel_
// main.vani's own "handled a request, not a reply for you"
// convention).
fn tcp_conn_poll_rpi4(my_mac: ref [u8; 6], out_payload: mut ref [u8; 512], max_payload_len: i64) -> i64 {
  let _ = tcp_conn_check_retransmit_rpi4(0 as u32, my_mac, my_mac);
  let _ = tcp_conn_check_retransmit_rpi4(1 as u32, my_mac, my_mac);

  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let frame_len: i64 = netif_recv_frame_rpi4(mut ref frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if arp_read_u16_be_rpi4(ref frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol_rpi4(ref frame, 14) != (6 as u32) {
    return 0 - 1;
  }
  let dst_port: u32 = tcp_get_dst_port_rpi4(ref frame, 34);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let target_conn: u32 = client_id;
  let matched: i64 = 0;
  if dst_port == tcp_conn_get_local_port(client_id) {
    target_conn = client_id;
    matched = 1;
  }
  if dst_port == tcp_conn_get_local_port(server_id) {
    target_conn = server_id;
    matched = 1;
  }
  if matched == 0 {
    return 0 - 1;
  }
  let result: i64 = tcp_conn_handle_segment_rpi4(target_conn, ref frame, frame_len, my_mac, my_mac, out_payload, max_payload_len);
  if (target_conn == server_id) && (result > 0) {
    // Echo the just-received data straight back. out_payload is a
    // `mut ref` PARAMETER here (it was just written into above), and
    // vani has no reborrow to a plain `ref` for tcp_conn_send_data_
    // rpi4's own read-only payload param (see round 88's own gap #3
    // in vani-compiler/docs/DHRUVAOS_ERGONOMICS_TODO.md) -- copy into
    // a fresh owned local first, which can supply either kind.
    let echo_payload: [u8; 512] = netif_zero_frame_rpi4();
    let i: i64 = 0;
    while i < result {
      echo_payload[i] = out_payload[i];
      i = i + 1;
    }
    let _ = tcp_conn_send_data_rpi4(server_id, my_mac, my_mac, ref echo_payload, result);
    return 0 - 2;
  }
  return result;
}

// Boot-time (and on-demand, via the `tcp` shell command) self-test: a
// complete, real connection lifecycle -- three-way handshake, one
// direction of data transfer, and a full close -- driven entirely by
// this function acting as traffic cop between connection slot 0
// (client/active open) and slot 1 (server/passive open). Direct port
// of kernel_main.vani's own tcp_conn_self_test.
fn tcp_conn_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let _ = tcp_conn_reset(0 as u32);
  let _ = tcp_conn_reset(1 as u32);
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let client_ip: u32 = 0xC0A80101 as u32;
  let server_ip: u32 = 0xC0A80102 as u32;
  let client_port: u32 = 54321 as u32;
  let server_port: u32 = 7 as u32;

  let _ = tcp_conn_passive_open_rpi4(server_id, server_ip, server_port);
  let _ = tcp_conn_active_open_rpi4(client_id, ref my_mac, ref my_mac, client_ip, server_ip, client_port, server_port, 1000 as u32);

  // Handshake: client's SYN -> server; server's SYN-ACK -> client;
  // client's final ACK -> server.
  let scratch: [u8; 512] = netif_zero_frame_rpi4();
  let f1: [u8; 512] = netif_zero_frame_rpi4();
  let l1: i64 = netif_recv_frame_rpi4(mut ref f1, 512); // client's SYN
  let s1: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f1, l1, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }

  let f2: [u8; 512] = netif_zero_frame_rpi4();
  let l2: i64 = netif_recv_frame_rpi4(mut ref f2, 512); // server's SYN-ACK
  let s2: i64 = tcp_conn_handle_segment_rpi4(client_id, ref f2, l2, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }

  let f3: [u8; 512] = netif_zero_frame_rpi4();
  let l3: i64 = netif_recv_frame_rpi4(mut ref f3, 512); // client's final ACK
  let s3: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f3, l3, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }

  if tcp_conn_get_state(client_id) != tcp_state_established_rpi4() { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_established_rpi4() { ok = 0; }

  // Data transfer: client sends "hi", server receives + ACKs it.
  let payload: [u8; 512] = netif_zero_frame_rpi4();
  payload[0] = 104 as u8; // 'h'
  payload[1] = 105 as u8; // 'i'
  let send_status: i64 = tcp_conn_send_data_rpi4(client_id, ref my_mac, ref my_mac, ref payload, 2);
  if send_status != 0 { ok = 0; }

  let f4: [u8; 512] = netif_zero_frame_rpi4();
  let l4: i64 = netif_recv_frame_rpi4(mut ref f4, 512); // client's data segment
  let recv_payload: [u8; 512] = netif_zero_frame_rpi4();
  let recv_len: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f4, l4, ref my_mac, ref my_mac, mut ref recv_payload, 2);
  if (l4 <= 0) || (recv_len != 2) { ok = 0; }
  if (recv_payload[0] != (104 as u8)) || (recv_payload[1] != (105 as u8)) {
    ok = 0;
  }

  let f5: [u8; 512] = netif_zero_frame_rpi4();
  let l5: i64 = netif_recv_frame_rpi4(mut ref f5, 512); // server's ACK of the data
  let s5: i64 = tcp_conn_handle_segment_rpi4(client_id, ref f5, l5, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l5 <= 0) || (s5 != 0) { ok = 0; }

  // Close: client sends FIN+ACK; server piggybacks its own FIN onto
  // the ACK; client sends the final ACK.
  let close_status: i64 = tcp_conn_close_rpi4(client_id, ref my_mac, ref my_mac);
  if close_status != 0 { ok = 0; }

  let f6: [u8; 512] = netif_zero_frame_rpi4();
  let l6: i64 = netif_recv_frame_rpi4(mut ref f6, 512); // client's FIN+ACK
  let s6: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f6, l6, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l6 <= 0) || (s6 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_fin_wait_rpi4() { ok = 0; }

  let f7: [u8; 512] = netif_zero_frame_rpi4();
  let l7: i64 = netif_recv_frame_rpi4(mut ref f7, 512); // server's FIN+ACK (piggybacked)
  let s7: i64 = tcp_conn_handle_segment_rpi4(client_id, ref f7, l7, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l7 <= 0) || (s7 != 0) { ok = 0; }
  if tcp_conn_get_state(client_id) != tcp_state_closed_final_rpi4() { ok = 0; }

  let f8: [u8; 512] = netif_zero_frame_rpi4();
  let l8: i64 = netif_recv_frame_rpi4(mut ref f8, 512); // client's final ACK
  let s8: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f8, l8, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l8 <= 0) || (s8 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_closed_final_rpi4() { ok = 0; }

  let _ = uart_puts_rpi4_vani("TCP: connection lifecycle (handshake + data + close)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 109: MQTT over plain TCP -- Pi 4/5 has no TLS at all (round
// 108's own finding), so unlike Pi 1's own `mqttecho` (MQTT over real
// TLS 1.3), this pairs the same `mqtt` kosh package directly with
// plain TCP, the typical unencrypted embedded-broker deployment.
// Sends one application-data segment and drains BOTH frames it
// produces on the wire: the data segment itself (handled by the
// receiver, which auto-ACKs per tcp_conn_handle_segment_rpi4's own
// established-data branch) and that ACK (handled by the sender, which
// just cancels its own pending retransmit) -- otherwise the next send
// would find a stale ACK sitting first in the loopback frame queue
// instead of real data.
fn mqtt_send_and_drain_rpi4(sender_id: u32, receiver_id: u32, my_mac: ref [u8; 6], payload: ref [u8; 512], payload_len: i64, out_payload: mut ref [u8; 512]) -> i64 {
  let _ = tcp_conn_send_data_rpi4(sender_id, my_mac, my_mac, payload, payload_len);
  let data_frame: [u8; 512] = netif_zero_frame_rpi4();
  let data_frame_len: i64 = netif_recv_frame_rpi4(mut ref data_frame, 512);
  let recv_len: i64 = tcp_conn_handle_segment_rpi4(receiver_id, ref data_frame, data_frame_len, my_mac, my_mac, out_payload, 512);
  let ack_frame: [u8; 512] = netif_zero_frame_rpi4();
  let ack_frame_len: i64 = netif_recv_frame_rpi4(mut ref ack_frame, 512);
  let ack_scratch: [u8; 512] = netif_zero_frame_rpi4();
  let _ = tcp_conn_handle_segment_rpi4(sender_id, ref ack_frame, ack_frame_len, my_mac, my_mac, mut ref ack_scratch, 512);
  return recv_len;
}

// Boot-time (and on-demand, via the `mqtt` shell command) self-test:
// a full MQTT v3.1.1 QoS 1 lifecycle -- CONNECT/CONNACK, SUBSCRIBE/
// SUBACK, PUBLISH/PUBACK, PINGREQ/PINGRESP, DISCONNECT -- driven over
// a real hand-shaken plain-TCP connection between connection slot 0
// (client) and slot 1 (server), same both-roles-in-one-instance shape
// as tcp_conn_self_test_rpi4's own handshake+data+close lifecycle.
fn mqtt_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let _ = tcp_conn_reset(0 as u32);
  let _ = tcp_conn_reset(1 as u32);
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let client_ip: u32 = 0xC0A80101 as u32;
  let server_ip: u32 = 0xC0A80102 as u32;
  let client_port: u32 = 54329 as u32;
  let server_port: u32 = 1883 as u32; // MQTT's own conventional plain-TCP port

  let _ = tcp_conn_passive_open_rpi4(server_id, server_ip, server_port);
  let _ = tcp_conn_active_open_rpi4(client_id, ref my_mac, ref my_mac, client_ip, server_ip, client_port, server_port, 6000 as u32);

  // Three-way handshake, hand-driven exactly like tcp_conn_self_test_
  // rpi4's own.
  let scratch: [u8; 512] = netif_zero_frame_rpi4();
  let f1: [u8; 512] = netif_zero_frame_rpi4();
  let l1: i64 = netif_recv_frame_rpi4(mut ref f1, 512); // client's SYN
  let s1: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f1, l1, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }
  let f2: [u8; 512] = netif_zero_frame_rpi4();
  let l2: i64 = netif_recv_frame_rpi4(mut ref f2, 512); // server's SYN-ACK
  let s2: i64 = tcp_conn_handle_segment_rpi4(client_id, ref f2, l2, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }
  let f3: [u8; 512] = netif_zero_frame_rpi4();
  let l3: i64 = netif_recv_frame_rpi4(mut ref f3, 512); // client's final ACK
  let s3: i64 = tcp_conn_handle_segment_rpi4(server_id, ref f3, l3, ref my_mac, ref my_mac, mut ref scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }
  if tcp_conn_get_state(client_id) != tcp_state_established_rpi4() { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_established_rpi4() { ok = 0; }

  // A single build buffer and a single receive buffer, reused across
  // all five exchanges below -- same stack-economy reasoning as Pi 1's
  // own mqttecho.
  let pkt: [u8; 512] = mqtt_zero512_bytes();
  let out: [u8; 512] = netif_zero_frame_rpi4();

  // --- CONNECT / CONNACK. ---
  let plen: i64 = mqtt_build_connect(mut ref pkt, "dhruva-mqtt-rpi4", 60);
  let recv_len: i64 = mqtt_send_and_drain_rpi4(client_id, server_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  let fh: MqttFixedHeader = mqtt_parse_fixed_header(ref out);
  if fh.packet_type != mqtt_packet_type_connect() { ok = 0; }
  if mqtt_parse_connect(ref out, fh.variable_header_start).ok != 1 { ok = 0; }

  plen = mqtt_build_connack(mut ref pkt, 0, mqtt_connack_accepted());
  recv_len = mqtt_send_and_drain_rpi4(server_id, client_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  let connack_parsed: MqttConnackResult = mqtt_parse_connack(ref out, fh.variable_header_start);
  if connack_parsed.return_code != mqtt_connack_accepted() { ok = 0; }

  // --- SUBSCRIBE / SUBACK (QoS 1). ---
  plen = mqtt_build_subscribe(mut ref pkt, 1, "dhruva/status", 1);
  recv_len = mqtt_send_and_drain_rpi4(client_id, server_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  let sub_parsed: MqttSubscribeResult = mqtt_parse_subscribe(ref out, fh.variable_header_start);
  if (sub_parsed.packet_id != 1) || (sub_parsed.qos != 1) { ok = 0; }

  plen = mqtt_build_suback(mut ref pkt, sub_parsed.packet_id, sub_parsed.qos);
  recv_len = mqtt_send_and_drain_rpi4(server_id, client_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  let suback_parsed: MqttSubackResult = mqtt_parse_suback(ref out, fh.variable_header_start);
  if (suback_parsed.packet_id != 1) || (suback_parsed.granted_qos != 1) { ok = 0; }

  // --- PUBLISH (QoS 1) / PUBACK. ---
  let publish_text: Str = "hello-mqtt-rpi4";
  let publish_text_len: i64 = str_len_bytes(publish_text);
  let pub_header_len: i64 = mqtt_build_publish(mut ref pkt, "dhruva/status", 1, 2, 0, 0, publish_text_len);
  let cpi: i64 = 0;
  while cpi < publish_text_len {
    pkt[pub_header_len + cpi] = str_byte_at(publish_text, cpi) as u8;
    cpi = cpi + 1;
  }
  plen = pub_header_len + publish_text_len;
  recv_len = mqtt_send_and_drain_rpi4(client_id, server_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  if fh.packet_type != mqtt_packet_type_publish() { ok = 0; }
  let pub_parsed: MqttPublishResult = mqtt_parse_publish(ref out, fh.variable_header_start, fh.remaining_length, fh.variable_header_start, mqtt_publish_qos_from_flags(fh.flags));
  if pub_parsed.payload_len != publish_text_len { ok = 0; }
  cpi = 0;
  while cpi < publish_text_len {
    if out[pub_parsed.payload_start + cpi] != (str_byte_at(publish_text, cpi) as u8) { ok = 0; }
    cpi = cpi + 1;
  }

  plen = mqtt_build_puback(mut ref pkt, pub_parsed.packet_id);
  recv_len = mqtt_send_and_drain_rpi4(server_id, client_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  if mqtt_parse_puback(ref out, fh.variable_header_start) != pub_parsed.packet_id { ok = 0; }

  // --- PINGREQ / PINGRESP. ---
  plen = mqtt_build_pingreq(mut ref pkt);
  recv_len = mqtt_send_and_drain_rpi4(client_id, server_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  if fh.packet_type != mqtt_packet_type_pingreq() { ok = 0; }

  plen = mqtt_build_pingresp(mut ref pkt);
  recv_len = mqtt_send_and_drain_rpi4(server_id, client_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  if fh.packet_type != mqtt_packet_type_pingresp() { ok = 0; }

  // --- DISCONNECT (client-initiated, no reply expected per spec). ---
  plen = mqtt_build_disconnect(mut ref pkt);
  recv_len = mqtt_send_and_drain_rpi4(client_id, server_id, ref my_mac, ref pkt, plen, mut ref out);
  if recv_len != plen { ok = 0; }
  fh = mqtt_parse_fixed_header(ref out);
  if fh.packet_type != mqtt_packet_type_disconnect() { ok = 0; }

  let _ = uart_puts_rpi4_vani("MQTT over plain TCP: CONNECT->CONNACK, SUBSCRIBE(QoS1)->SUBACK, PUBLISH(QoS1)->PUBACK, PINGREQ->PINGRESP, DISCONNECT");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 90 -- UDP, a real prerequisite for DHCP discovered while
// reading kernel_main.vani's own DHCP code to scope that round: DHCP
// is built directly on `udp_send`, not raw IP -- a genuine missing
// step this scope's own original ordering didn't account for (it
// only listed netif/ARP/IP+filter/TCP/DHCP, silently skipping the UDP
// layer DHCP actually sits on). Inserted here, corrected in
// project_dhruva_networking_ssh_wifi_scope_2026_09_06.md, before
// DHCP is attempted.
//
// Direct port of kernel_main.vani's own stateless `udp_*` header
// layer plus its minimal `socket_udp_send`/`socket_udp_recv` API
// (DHRUVA_ARCHITECTURE.md §4's "small socket-style API," exactly one
// implicit socket, no per-port binding/filtering table -- the same
// honest scope Pi 1 itself accepted). No persistent state needed at
// all (unlike TCP's connection table) -- UDP is genuinely stateless,
// so this needs no new `boot/rpi4/*.S` file.
//
// Same ref-planning discipline as round 89: every `udp_get_*_rpi4`/
// `udp_checksum_rpi4`/`udp_verify_checksum_rpi4` takes plain `ref
// [u8; 512]`; only `udp_build_rpi4` (write then must read back to
// checksum) computes its checksum inline instead of delegating.
// Reuses round 88's `udp_get_dst_port_rpi4` as-is (identical
// signature to what this module needs).

// Round 106d: UDP's own checksum/header-codec ALGORITHM now lives in
// the shared `netstack` package (`netstack_udp_*`/`UdpChecksumCtx`),
// confirmed a direct port of this file's own former body before
// extraction. Unlike IPv4's own fixed 20-byte header, UDP's checksum
// spans the WHOLE datagram (header+payload, genuinely variable
// length) -- the package streams it (`UdpChecksumCtx`/`update`/
// `finalize`, mirroring `chacha20_poly1305`'s own `Poly1305Ctx`) with
// no length cap, so each function here loops its own real `udp_len`
// through the package in <=256-byte chunks rather than passing the
// whole frame through.
fn udp_checksum_rpi4(src_ip: u32, dst_ip: u32, frame: ref [u8; 512], udp_offset: i64, udp_len: i64) -> u32 {
  let ctx: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let pos: i64 = 0;
  while pos < udp_len {
    let remaining: i64 = udp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let i: i64 = 0;
    while i < take {
      chunk[i] = frame[udp_offset + pos + i];
      i = i + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  return netstack_udp_checksum_finalize(ref ctx);
}

fn udp_verify_checksum_rpi4(src_ip: u32, dst_ip: u32, frame: ref [u8; 512], udp_offset: i64, udp_len: i64) -> i64 {
  if udp_checksum_rpi4(src_ip, dst_ip, frame, udp_offset, udp_len) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

fn udp_build_rpi4(frame: mut ref [u8; 512], udp_offset: i64, src_port: u32, dst_port: u32, payload: ref [u8; 512], payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let udp_len: i64 = 8 + payload_len;
  let hdr: [u8; 8] = netstack_udp_header_only(src_port, dst_port, udp_len);
  let hi: i64 = 0;
  while hi < 8 {
    frame[udp_offset + hi] = hdr[hi];
    hi = hi + 1;
  }
  let j: i64 = 0;
  while j < payload_len {
    frame[udp_offset + 8 + j] = payload[j];
    j = j + 1;
  }

  let ctx: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let pos: i64 = 0;
  while pos < udp_len {
    let remaining: i64 = udp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let k: i64 = 0;
    while k < take {
      chunk[k] = frame[udp_offset + pos + k];
      k = k + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  let checksum: u32 = netstack_udp_checksum_finalize(ref ctx);
  let checksum_bytes: [u8; 2] = netstack_udp_encode_checksum(checksum);
  frame[udp_offset + 6] = checksum_bytes[0];
  frame[udp_offset + 7] = checksum_bytes[1];
  return udp_len;
}

fn udp_get_src_port_rpi4(frame: ref [u8; 512], udp_offset: i64) -> u32 {
  let hdr: [u8; 8] = [
    frame[udp_offset], frame[udp_offset + 1], frame[udp_offset + 2], frame[udp_offset + 3],
    frame[udp_offset + 4], frame[udp_offset + 5], frame[udp_offset + 6], frame[udp_offset + 7]
  ];
  return netstack_udp_get_src_port(ref hdr);
}
fn udp_get_length_rpi4(frame: ref [u8; 512], udp_offset: i64) -> u32 {
  let hdr: [u8; 8] = [
    frame[udp_offset], frame[udp_offset + 1], frame[udp_offset + 2], frame[udp_offset + 3],
    frame[udp_offset + 4], frame[udp_offset + 5], frame[udp_offset + 6], frame[udp_offset + 7]
  ];
  return netstack_udp_get_length(ref hdr);
}

// Builds and sends a full Ethernet+IPv4+UDP frame. Fixed offsets (14
// for IP, 34 for UDP), matching kernel_main.vani's own udp_send.
fn udp_send_rpi4(my_mac: ref [u8; 6], dst_mac: ref [u8; 6], src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, payload: ref [u8; 512], payload_len: i64) -> i64 {
  let udp_max_payload: i64 = netif_get_mtu_rpi4() - 20 - 8; // minus IP header, minus UDP header
  if (payload_len < 0) || (payload_len > udp_max_payload) {
    return 0 - 1;
  }
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let i: i64 = 0;
  while i < 6 {
    frame[i] = dst_mac[i];
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    frame[6 + j] = my_mac[j];
    j = j + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref frame, 12, 0x0800 as u32); // ethertype: IPv4
  let udp_len: i64 = udp_build_rpi4(mut ref frame, 34, src_port, dst_port, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + udp_len;
  let _ = ipv4_build_header_rpi4(mut ref frame, 14, total_len, 17 as u32, src_ip, dst_ip);
  return netif_send_frame_rpi4(ref frame, 14 + total_len);
}

// Phase 6's "small socket-style API": a thin wrapper hiding the raw
// Ethernet/IP/UDP plumbing above. Requires remote_ip to already be
// ARP-resolved (a cache hit) before sending -- a cache miss is a
// real, honest failure (-1, "no route to host"), matching
// kernel_main.vani's own round-21 fix (never silently substitute a
// MAC that's certain to be wrong for any real off-loopback
// destination).
fn socket_udp_send_rpi4(my_mac: ref [u8; 6], local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, payload: ref [u8; 512], payload_len: i64) -> i64 {
  let dst_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  if arp_cache_lookup_rpi4(remote_ip, mut ref dst_mac) != 1 {
    return 0 - 1;
  }
  return udp_send_rpi4(my_mac, ref dst_mac, local_ip, remote_ip, local_port, remote_port, payload, payload_len);
}

// Receives the next queued frame; if it's UDP, copies its payload
// into out_payload and writes [src_ip(4, BE)][src_port(2, BE)][dst_
// port(2, BE)] into out_meta (8 bytes), returning the payload length.
// Returns -1 if nothing is queued, the frame isn't UDP, or the
// segment fails the same three-fold bounds/checksum guard
// kernel_main.vani's own round-8/round-21 audits already established
// (reject a negative length, a declared extent past what netif
// actually received, a payload bigger than the caller's own buffer,
// or a failed checksum -- never silently truncate).
fn socket_udp_recv_rpi4(out_payload: mut ref [u8; 512], out_meta: mut ref [u8; 8], max_payload_len: i64) -> i64 {
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let frame_len: i64 = netif_recv_frame_rpi4(mut ref frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if arp_read_u16_be_rpi4(ref frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol_rpi4(ref frame, 14) != (17 as u32) {
    return 0 - 1;
  }
  let udp_len: u32 = udp_get_length_rpi4(ref frame, 34);
  let payload_len: i64 = (udp_len as i64) - 8;
  if payload_len < 0 {
    return 0 - 1;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0 - 1;
  }
  if payload_len > max_payload_len {
    return 0 - 1;
  }
  let src_ip_for_checksum: u32 = ipv4_get_src_ip_rpi4(ref frame, 14);
  let dst_ip_for_checksum: u32 = ipv4_get_dst_ip_rpi4(ref frame, 14);
  if udp_verify_checksum_rpi4(src_ip_for_checksum, dst_ip_for_checksum, ref frame, 34, udp_len as i64) != 1 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < payload_len {
    out_payload[i] = frame[42 + i]; // 14 + 20 + 8
    i = i + 1;
  }
  let src_ip: u32 = ipv4_get_src_ip_rpi4(ref frame, 14);
  let src_port: u32 = udp_get_src_port_rpi4(ref frame, 34);
  let dst_port: u32 = udp_get_dst_port_rpi4(ref frame, 34);
  out_meta[0] = ((src_ip >> (24 as u32)) & (255 as u32)) as u8;
  out_meta[1] = ((src_ip >> (16 as u32)) & (255 as u32)) as u8;
  out_meta[2] = ((src_ip >> (8 as u32)) & (255 as u32)) as u8;
  out_meta[3] = (src_ip & (255 as u32)) as u8;
  out_meta[4] = ((src_port >> (8 as u32)) & (255 as u32)) as u8;
  out_meta[5] = (src_port & (255 as u32)) as u8;
  out_meta[6] = ((dst_port >> (8 as u32)) & (255 as u32)) as u8;
  out_meta[7] = (dst_port & (255 as u32)) as u8;
  return payload_len;
}

// Boot-time (and on-demand, via the `udp` shell command) self-test:
// send a UDP datagram over the loopback netif, receive it back
// through the socket API, and verify the payload, port/address
// metadata, and the empty-queue case afterward. Direct port of
// kernel_main.vani's own udp_self_test. Depends on ARP's own cache
// already being initialized this boot (round 87's arp_self_test_
// rpi4/arp_resolve_self_test_rpi4 already ran by this point in
// kmain_rpi4_vani).
fn udp_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;
  let local_port: u32 = 12345 as u32;
  let remote_port: u32 = 7 as u32;

  let payload: [u8; 512] = netif_zero_frame_rpi4();
  payload[0] = 104 as u8; // "hello"
  payload[1] = 101 as u8;
  payload[2] = 108 as u8;
  payload[3] = 108 as u8;
  payload[4] = 111 as u8;

  let _ = arp_cache_insert_rpi4(remote_ip, ref my_mac);
  let send_status: i64 = socket_udp_send_rpi4(ref my_mac, local_ip, remote_ip, local_port, remote_port, ref payload, 5);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: [u8; 512] = netif_zero_frame_rpi4();
  let recv_meta: [u8; 8] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let recv_len: i64 = socket_udp_recv_rpi4(mut ref recv_payload, mut ref recv_meta, 512);
  if recv_len != 5 {
    ok = 0;
  }
  let i: i64 = 0;
  while i < 5 {
    if payload[i] != recv_payload[i] {
      ok = 0;
    }
    i = i + 1;
  }

  let got_src_ip: u32 = ((recv_meta[0] as u32) << (24 as u32)) | ((recv_meta[1] as u32) << (16 as u32)) | ((recv_meta[2] as u32) << (8 as u32)) | (recv_meta[3] as u32);
  let got_src_port: u32 = ((recv_meta[4] as u32) << (8 as u32)) | (recv_meta[5] as u32);
  let got_dst_port: u32 = ((recv_meta[6] as u32) << (8 as u32)) | (recv_meta[7] as u32);
  if got_src_ip != local_ip {
    ok = 0;
  }
  if got_src_port != local_port {
    ok = 0;
  }
  if got_dst_port != remote_port {
    ok = 0;
  }

  let empty_status: i64 = socket_udp_recv_rpi4(mut ref recv_payload, mut ref recv_meta, 512);
  if empty_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts_rpi4_vani("UDP: socket send/recv over loopback + checksum");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 91 -- DHCP CLIENT only (the server is new work, a separate
// later step per the user's own request to split it out -- this
// scope's own step 6 originally lumped both together). Built on
// round 90's UDP: `dhcp_client_start`/`poll` call `udp_send_rpi4`
// directly, the same real dependency that made round 90 necessary in
// the first place.
//
// Direct port of kernel_main.vani's own `dhcp_*` client family: the
// same 240-byte fixed BOOTP header + magic cookie, the same options
// scan (max 64 iterations, every length checked against the buffer's
// own end before being trusted as a skip distance), and the same
// client state machine (INIT -> SELECTING -> REQUESTING -> BOUND,
// plus RFC 2131 s4.4's post-BOUND lease lifecycle: RENEWING at T1,
// REBINDING at T2, full re-acquisition on NAK or final expiry).
// Persistent state (`boot/rpi4/dhcp_state.S`) is a single scalar
// instance, not a table -- this port has exactly one DHCP client,
// same as Pi 1.
//
// No heap on this port, so every one of Pi 1's `dhcp_*_scratch_get`
// persistent buffers (payload/broadcast-MAC/server-MAC/frame) is
// replaced by a plain local `[u8; 512]` built fresh each call, same
// tradeoff every other Pi 4/5 send/receive path already makes.
//
// Ref-kind planning done up front (rounds 88-90's own lesson):
// builders (`dhcp_build_*_rpi4`) take `mut ref [u8; 512]`; every
// reader/parser (`dhcp_get_*_rpi4`, `dhcp_verify_magic_cookie_rpi4`,
// `dhcp_find_option_*_rpi4`) takes plain `ref [u8; 512]`, since their
// real callers (`dhcp_client_poll_rpi4`, `dhcp_self_test_rpi4`) only
// ever hold `ref` frames.
//
// **Not ported this round, a real scope boundary**: kernel_main
// .vani's own `dhcp_renewal_self_test` (drives the RENEWING/
// REBINDING/expiry thresholds by backdating lease_start_tick) and
// `dhcp_nak_self_test`. The underlying logic both exercise
// (`dhcp_client_check_lease_rpi4`'s full T1/T2/expiry state machine,
// and `dhcp_client_poll_rpi4`'s NAK-resets-to-INIT branch) IS fully
// present and live, just not independently re-verified via a
// dedicated fixture this round -- same reasoning as TCP/UDP's own
// equivalent notes. Also genuinely can't be exercised as a
// SYNCHRONOUS self-test the way `dhcp_self_test_rpi4` below is on
// this port specifically: `rpi4_timer_tick_count_get()` only
// advances once boot.S reaches its own later `wfi` loop, AFTER
// `kmain_rpi4_vani`'s entire self-test sequence has already run
// synchronously to completion (confirmed by this port's own boot
// log ordering) -- so a lease-threshold test would need real,
// elapsed timer ticks a boot-time self-test call can't produce here.

// Round 106e: the message-format constants/build/parse ALGORITHM now
// lives in the shared `netstack` package (`netstack_dhcp_*`),
// confirmed a direct port of this file's own former body. Client
// FSM-state constants (`dhcp_state_*_rpi4`) stay here unmigrated --
// pure per-role bookkeeping, not message-format logic, matching
// every prior round's own "only migrate real duplicated algorithm"
// scope.
fn dhcp_op_bootrequest_rpi4() -> u32 { return netstack_dhcp_op_bootrequest(); }
fn dhcp_op_bootreply_rpi4() -> u32 { return netstack_dhcp_op_bootreply(); }
fn dhcp_htype_ethernet_rpi4() -> u32 { return netstack_dhcp_htype_ethernet(); }
fn dhcp_hlen_ethernet_rpi4() -> u32 { return netstack_dhcp_hlen_ethernet(); }
fn dhcp_msgtype_discover_rpi4() -> u32 { return netstack_dhcp_msgtype_discover(); }
fn dhcp_msgtype_offer_rpi4() -> u32 { return netstack_dhcp_msgtype_offer(); }
fn dhcp_msgtype_request_rpi4() -> u32 { return netstack_dhcp_msgtype_request(); }
fn dhcp_msgtype_ack_rpi4() -> u32 { return netstack_dhcp_msgtype_ack(); }
fn dhcp_msgtype_nak_rpi4() -> u32 { return netstack_dhcp_msgtype_nak(); }
fn dhcp_state_init_rpi4() -> u32 { return 0 as u32; }
fn dhcp_state_selecting_rpi4() -> u32 { return 1 as u32; }
fn dhcp_state_requesting_rpi4() -> u32 { return 2 as u32; }
fn dhcp_state_bound_rpi4() -> u32 { return 3 as u32; }
fn dhcp_state_renewing_rpi4() -> u32 { return 4 as u32; }
fn dhcp_state_rebinding_rpi4() -> u32 { return 5 as u32; }
fn dhcp_client_port_rpi4() -> u32 { return netstack_dhcp_client_port(); }
fn dhcp_server_port_rpi4() -> u32 { return netstack_dhcp_server_port(); }

extern "C" fn dhcp_state_get_client_state() -> u32;
extern "C" fn dhcp_state_set_client_state(value: u32) -> u32;
extern "C" fn dhcp_state_get_xid() -> u32;
extern "C" fn dhcp_state_set_xid(value: u32) -> u32;
extern "C" fn dhcp_state_get_offered_ip() -> u32;
extern "C" fn dhcp_state_set_offered_ip(value: u32) -> u32;
extern "C" fn dhcp_state_get_server_ip() -> u32;
extern "C" fn dhcp_state_set_server_ip(value: u32) -> u32;
extern "C" fn dhcp_state_get_leased_ip() -> u32;
extern "C" fn dhcp_state_set_leased_ip(value: u32) -> u32;
extern "C" fn dhcp_state_get_lease_time() -> u32;
extern "C" fn dhcp_state_set_lease_time(value: u32) -> u32;
extern "C" fn dhcp_state_get_lease_start_tick() -> u32;
extern "C" fn dhcp_state_set_lease_start_tick(value: u32) -> u32;

// Round 106e: DHCP's own message build/parse ALGORITHM now lives in
// the shared `netstack` package (`netstack_dhcp_*`), confirmed a
// direct port of this file's own former body before extraction.
fn dhcp_zero_range_rpi4(buf: mut ref [u8; 512], offset: i64, count: i64) -> i64 {
  return netstack_dhcp_zero_range(buf, offset, count);
}

fn dhcp_build_fixed_header_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, op: u32, ciaddr: u32, yiaddr: u32, siaddr: u32) -> i64 {
  return netstack_dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, op, ciaddr, yiaddr, siaddr);
}

fn dhcp_build_discover_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32) -> i64 {
  return netstack_dhcp_build_discover(buf, dhcp_offset, mac, xid);
}

fn dhcp_build_request_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, requested_ip: u32, server_ip: u32) -> i64 {
  return netstack_dhcp_build_request(buf, dhcp_offset, mac, xid, requested_ip, server_ip);
}

fn dhcp_build_renew_request_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, ciaddr: u32) -> i64 {
  return netstack_dhcp_build_renew_request(buf, dhcp_offset, mac, xid, ciaddr);
}

fn dhcp_get_op_rpi4(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_dhcp_get_op(buf, dhcp_offset);
}
fn dhcp_get_xid_rpi4(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_dhcp_get_xid(buf, dhcp_offset);
}
fn dhcp_get_yiaddr_rpi4(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_dhcp_get_yiaddr(buf, dhcp_offset);
}
fn dhcp_get_ciaddr_rpi4(buf: ref [u8; 512], dhcp_offset: i64) -> u32 {
  return netstack_dhcp_get_ciaddr(buf, dhcp_offset);
}

fn dhcp_verify_magic_cookie_rpi4(buf: ref [u8; 512], dhcp_offset: i64) -> i64 {
  return netstack_dhcp_verify_magic_cookie(buf, dhcp_offset);
}

fn dhcp_find_option_byte_rpi4(buf: ref [u8; 512], dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> i64 {
  return netstack_dhcp_find_option_byte(buf, dhcp_offset, dhcp_len, want_code);
}

fn dhcp_find_option_u32_rpi4(buf: ref [u8; 512], dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> u32 {
  return netstack_dhcp_find_option_u32(buf, dhcp_offset, dhcp_len, want_code);
}

fn dhcp_broadcast_mac_rpi4(out_mac: mut ref [u8; 6]) -> i64 {
  let mac: [u8; 6] = netstack_dhcp_broadcast_mac();
  let i: i64 = 0;
  while i < 6 {
    out_mac[i] = mac[i];
    i = i + 1;
  }
  return 0;
}

// Starts (or restarts) address acquisition: broadcasts a DHCPDISCOVER
// and moves to SELECTING. Direct port of kernel_main.vani's own
// dhcp_client_start.
fn dhcp_client_start_rpi4(my_mac: ref [u8; 6], xid: u32) -> i64 {
  let _ = dhcp_state_set_client_state(dhcp_state_selecting_rpi4());
  let _ = dhcp_state_set_xid(xid);
  let _ = dhcp_state_set_offered_ip(0 as u32);
  let _ = dhcp_state_set_server_ip(0 as u32);
  let _ = dhcp_state_set_lease_time(0 as u32);
  let _ = dhcp_state_set_lease_start_tick(0 as u32);

  let payload: [u8; 512] = netif_zero_frame_rpi4();
  let payload_len: i64 = dhcp_build_discover_rpi4(mut ref payload, 0, my_mac, xid);
  let bcast_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = dhcp_broadcast_mac_rpi4(mut ref bcast_mac);
  let no_ip: u32 = 0 as u32;
  let bcast_ip: u32 = 0xFFFFFFFF as u32;
  return udp_send_rpi4(my_mac, ref bcast_mac, no_ip, bcast_ip, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref payload, payload_len);
}

// Dequeues and processes the next queued frame if it's a DHCP reply
// relevant to this client's current attempt. Direct port of
// kernel_main.vani's own dhcp_client_poll, including its own
// round-8/round-22 checksum/bounds checks and NAK handling.
fn dhcp_client_poll_rpi4(my_mac: ref [u8; 6]) -> i64 {
  let lease_transition: i64 = dhcp_client_check_lease_rpi4(my_mac);
  if lease_transition == 1 {
    return 1;
  }

  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let frame_len: i64 = netif_recv_frame_rpi4(mut ref frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if arp_read_u16_be_rpi4(ref frame, 12) != (0x0800 as u32) {
    return 0;
  }
  if ipv4_get_protocol_rpi4(ref frame, 14) != (17 as u32) {
    return 0;
  }
  if udp_get_dst_port_rpi4(ref frame, 34) != dhcp_client_port_rpi4() {
    return 0;
  }
  let udp_len: u32 = udp_get_length_rpi4(ref frame, 34);
  let dhcp_len: i64 = (udp_len as i64) - 8;
  if dhcp_len < 240 {
    return 0;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0;
  }
  let src_ip: u32 = ipv4_get_src_ip_rpi4(ref frame, 14);
  let dst_ip: u32 = ipv4_get_dst_ip_rpi4(ref frame, 14);
  if udp_verify_checksum_rpi4(src_ip, dst_ip, ref frame, 34, udp_len as i64) != 1 {
    return 0;
  }
  let dhcp_offset: i64 = 42; // 14 (Ethernet) + 20 (IP) + 8 (UDP)
  if dhcp_verify_magic_cookie_rpi4(ref frame, dhcp_offset) != 1 {
    return 0;
  }
  if dhcp_get_op_rpi4(ref frame, dhcp_offset) != dhcp_op_bootreply_rpi4() {
    return 0;
  }
  if dhcp_get_xid_rpi4(ref frame, dhcp_offset) != dhcp_state_get_xid() {
    return 0;
  }
  let msg_type: i64 = dhcp_find_option_byte_rpi4(ref frame, dhcp_offset, dhcp_len, 53 as u32);
  let client_state: u32 = dhcp_state_get_client_state();

  if (client_state == dhcp_state_selecting_rpi4()) && (msg_type == (dhcp_msgtype_offer_rpi4() as i64)) {
    let offered_ip: u32 = dhcp_get_yiaddr_rpi4(ref frame, dhcp_offset);
    let server_ip: u32 = dhcp_find_option_u32_rpi4(ref frame, dhcp_offset, dhcp_len, 54 as u32);
    if (offered_ip == (0 as u32)) || (server_ip == (0 as u32)) {
      return 0; // malformed offer, missing what's needed to request it
    }
    let _ = dhcp_state_set_offered_ip(offered_ip);
    let _ = dhcp_state_set_server_ip(server_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_requesting_rpi4());

    let payload: [u8; 512] = netif_zero_frame_rpi4();
    let xid: u32 = dhcp_state_get_xid();
    let payload_len: i64 = dhcp_build_request_rpi4(mut ref payload, 0, my_mac, xid, offered_ip, server_ip);
    let bcast_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    let _ = dhcp_broadcast_mac_rpi4(mut ref bcast_mac);
    let no_ip: u32 = 0 as u32;
    let bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send_rpi4(my_mac, ref bcast_mac, no_ip, bcast_ip, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref payload, payload_len);
    return 1;
  }

  // An ACK is expected fresh out of REQUESTING, or as the (re)answer
  // to a RENEWING/REBINDING lease-renewal attempt (RFC 2131 s4.4
  // treats all three the same way, back to BOUND with a refreshed
  // lease).
  let ack_expected: i64 = if (client_state == dhcp_state_requesting_rpi4()) || (client_state == dhcp_state_renewing_rpi4()) || (client_state == dhcp_state_rebinding_rpi4()) { 1 } else { 0 };
  if (ack_expected == 1) && (msg_type == (dhcp_msgtype_ack_rpi4() as i64)) {
    let leased_ip: u32 = dhcp_get_yiaddr_rpi4(ref frame, dhcp_offset);
    if leased_ip == (0 as u32) {
      return 0;
    }
    let _ = dhcp_state_set_leased_ip(leased_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_bound_rpi4());

    let lease_time: u32 = dhcp_find_option_u32_rpi4(ref frame, dhcp_offset, dhcp_len, 51 as u32);
    let _ = dhcp_state_set_lease_time(lease_time);
    let _ = dhcp_state_set_lease_start_tick((rpi4_timer_tick_count_get() as u32));

    // Learn the server's MAC for free from this ACK's own Ethernet
    // source address, for a later unicast renewal REQUEST.
    let server_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    let mi: i64 = 0;
    while mi < 6 {
      server_mac[mi] = frame[6 + mi];
      mi = mi + 1;
    }
    let _ = arp_cache_insert_rpi4(dhcp_state_get_server_ip(), ref server_mac);

    return 1;
  }

  // A real server can NAK a REQUEST -- RFC 2131 s4.4: "If the client
  // receives a DHCPNAK message, it cannot reuse its remembered lease
  // and MUST return to INIT," for a NAK'd RENEWING/REBINDING attempt
  // too. Resets to INIT rather than auto-retrying (this driver has no
  // random-number source or backoff policy of its own) -- the caller
  // decides when to call dhcp_client_start_rpi4 again.
  let nak_expected: i64 = if (client_state == dhcp_state_requesting_rpi4()) || (client_state == dhcp_state_renewing_rpi4()) || (client_state == dhcp_state_rebinding_rpi4()) { 1 } else { 0 };
  if (nak_expected == 1) && (msg_type == (dhcp_msgtype_nak_rpi4() as i64)) {
    let _ = dhcp_state_set_client_state(dhcp_state_init_rpi4());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// RFC 2131 s4.4's lease lifecycle past BOUND, entirely time-driven.
// Direct port of kernel_main.vani's own dhcp_client_check_lease
// (same T1=lease/2, T2=lease*7/8 thresholds, 2 ticks/second). See
// this section's own header comment for why this can't be exercised
// as a synchronous self-test on this port -- the logic itself is
// unchanged from Pi 1's own.
fn dhcp_client_check_lease_rpi4(my_mac: ref [u8; 6]) -> i64 {
  let lease_time: u32 = dhcp_state_get_lease_time();
  if lease_time == (0 as u32) {
    return 0;
  }
  let client_state: u32 = dhcp_state_get_client_state();
  if (client_state != dhcp_state_bound_rpi4()) && (client_state != dhcp_state_renewing_rpi4()) && (client_state != dhcp_state_rebinding_rpi4()) {
    return 0;
  }

  let ticks_per_second: i64 = 2;
  let lease_ticks: i64 = (lease_time as i64) * ticks_per_second;
  let t1_ticks: i64 = lease_ticks / 2;
  let t2_ticks: i64 = (lease_ticks * 7) / 8;
  let elapsed_ticks: i64 = rpi4_timer_tick_count_get() - (dhcp_state_get_lease_start_tick() as i64);

  // Note: the T1 (renew) and T2 (rebind) branches below deliberately
  // use distinctly-named locals throughout (renew_* / rebind_*)
  // rather than reusing names across these two sibling `if` blocks --
  // vani's LLVM backend can crash-collide ("multiple definition of
  // local value") when the same local name is reused in two non-
  // overlapping blocks of one function, a known codegen quirk (see
  // [[feedback_vani_llvm_local_name_collision]]), not caught by
  // `vanic check` (only by the real `emit --backend=llvm` + `llc`
  // pipeline `build_rpi4.sh` runs) -- hit live during this round's
  // own build and fixed by this renaming, not a new discovery.
  if (client_state == dhcp_state_bound_rpi4()) && (elapsed_ticks >= t1_ticks) {
    let server_ip: u32 = dhcp_state_get_server_ip();
    let renew_dst_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    if arp_cache_lookup_rpi4(server_ip, mut ref renew_dst_mac) == 1 {
      let renew_payload: [u8; 512] = netif_zero_frame_rpi4();
      let renew_xid: u32 = dhcp_state_get_xid();
      let renew_leased_ip: u32 = dhcp_state_get_leased_ip();
      let renew_payload_len: i64 = dhcp_build_renew_request_rpi4(mut ref renew_payload, 0, my_mac, renew_xid, renew_leased_ip);
      let _ = udp_send_rpi4(my_mac, ref renew_dst_mac, renew_leased_ip, server_ip, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref renew_payload, renew_payload_len);
    }
    let _ = dhcp_state_set_client_state(dhcp_state_renewing_rpi4());
    return 1;
  }

  if (client_state == dhcp_state_renewing_rpi4()) && (elapsed_ticks >= t2_ticks) {
    let rebind_payload: [u8; 512] = netif_zero_frame_rpi4();
    let rebind_xid: u32 = dhcp_state_get_xid();
    let rebind_leased_ip: u32 = dhcp_state_get_leased_ip();
    let rebind_payload_len: i64 = dhcp_build_renew_request_rpi4(mut ref rebind_payload, 0, my_mac, rebind_xid, rebind_leased_ip);
    let rebind_bcast_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    let _ = dhcp_broadcast_mac_rpi4(mut ref rebind_bcast_mac);
    let rebind_bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send_rpi4(my_mac, ref rebind_bcast_mac, rebind_leased_ip, rebind_bcast_ip, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref rebind_payload, rebind_payload_len);
    let _ = dhcp_state_set_client_state(dhcp_state_rebinding_rpi4());
    return 1;
  }

  if (client_state == dhcp_state_rebinding_rpi4()) && (elapsed_ticks >= lease_ticks) {
    let _ = dhcp_state_set_client_state(dhcp_state_init_rpi4());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// Boot-time (and on-demand, via the `dhcp` shell command) self-test:
// no real DHCP server exists in this loopback-only environment, so
// this drives the client through a full DISCOVER -> OFFER -> REQUEST
// -> ACK -> BOUND cycle by manually building the server's two replies
// exactly as a real server would and queuing them via the real netif.
// Direct port of kernel_main.vani's own dhcp_self_test.
fn dhcp_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let xid: u32 = 0x12345678 as u32;
  let offered_ip: u32 = 0xC0A80164 as u32; // 192.168.1.100
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  let start_status: i64 = dhcp_client_start_rpi4(ref my_mac, xid);
  if start_status != 0 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_selecting_rpi4() { ok = 0; }

  // Drain the client's own broadcast DISCOVER and sanity-check it.
  let discover_frame: [u8; 512] = netif_zero_frame_rpi4();
  let discover_len: i64 = netif_recv_frame_rpi4(mut ref discover_frame, 512);
  if discover_len < 240 { ok = 0; }
  if dhcp_get_op_rpi4(ref discover_frame, 42) != dhcp_op_bootrequest_rpi4() { ok = 0; }
  if dhcp_find_option_byte_rpi4(ref discover_frame, 42, discover_len - 42, 53 as u32) != (dhcp_msgtype_discover_rpi4() as i64) { ok = 0; }

  // Build the synthetic DHCPOFFER.
  let offer_msg: [u8; 512] = netif_zero_frame_rpi4();
  let _ = dhcp_build_fixed_header_rpi4(mut ref offer_msg, 0, ref my_mac, xid, dhcp_op_bootreply_rpi4(), 0 as u32, offered_ip, server_ip);
  offer_msg[240] = 53 as u8;
  offer_msg[241] = 1 as u8;
  offer_msg[242] = dhcp_msgtype_offer_rpi4() as u8;
  offer_msg[243] = 54 as u8;
  offer_msg[244] = 4 as u8;
  let _ = arp_write_u32_be_rpi4(mut ref offer_msg, 245, server_ip);
  offer_msg[249] = 255 as u8; // End
  let offer_dhcp_len: i64 = 250;

  let offer_frame: [u8; 512] = netif_zero_frame_rpi4();
  let oi: i64 = 0;
  while oi < 6 {
    offer_frame[oi] = my_mac[oi]; // dst: us
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 6 {
    offer_frame[6 + oj] = 0xAA as u8; // src: arbitrary "server" MAC
    oj = oj + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref offer_frame, 12, 0x0800 as u32);
  let offer_udp_len: i64 = udp_build_rpi4(mut ref offer_frame, 34, dhcp_server_port_rpi4(), dhcp_client_port_rpi4(), ref offer_msg, offer_dhcp_len, server_ip, bcast_ip);
  let offer_total_len: i64 = 20 + offer_udp_len;
  let _ = ipv4_build_header_rpi4(mut ref offer_frame, 14, offer_total_len, 17 as u32, server_ip, bcast_ip);
  let offer_frame_len: i64 = 14 + offer_total_len;

  let send_status1: i64 = netif_send_frame_rpi4(ref offer_frame, offer_frame_len);
  if send_status1 != 0 { ok = 0; }

  let poll1: i64 = dhcp_client_poll_rpi4(ref my_mac);
  if poll1 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_requesting_rpi4() { ok = 0; }
  if dhcp_state_get_offered_ip() != offered_ip { ok = 0; }
  if dhcp_state_get_server_ip() != server_ip { ok = 0; }

  // Drain the client's own broadcast DHCPREQUEST and confirm it.
  let request_frame: [u8; 512] = netif_zero_frame_rpi4();
  let request_len: i64 = netif_recv_frame_rpi4(mut ref request_frame, 512);
  if request_len < 240 { ok = 0; }
  if dhcp_find_option_byte_rpi4(ref request_frame, 42, request_len - 42, 53 as u32) != (dhcp_msgtype_request_rpi4() as i64) { ok = 0; }
  if dhcp_find_option_u32_rpi4(ref request_frame, 42, request_len - 42, 50 as u32) != offered_ip { ok = 0; }
  if dhcp_find_option_u32_rpi4(ref request_frame, 42, request_len - 42, 54 as u32) != server_ip { ok = 0; }

  // Build and queue the synthetic DHCPACK.
  let ack_msg: [u8; 512] = netif_zero_frame_rpi4();
  let _ = dhcp_build_fixed_header_rpi4(mut ref ack_msg, 0, ref my_mac, xid, dhcp_op_bootreply_rpi4(), 0 as u32, offered_ip, server_ip);
  ack_msg[240] = 53 as u8;
  ack_msg[241] = 1 as u8;
  ack_msg[242] = dhcp_msgtype_ack_rpi4() as u8;
  ack_msg[243] = 54 as u8;
  ack_msg[244] = 4 as u8;
  let _ = arp_write_u32_be_rpi4(mut ref ack_msg, 245, server_ip);
  ack_msg[249] = 255 as u8; // End
  let ack_dhcp_len: i64 = 250;

  let ack_frame: [u8; 512] = netif_zero_frame_rpi4();
  let ai: i64 = 0;
  while ai < 6 {
    ack_frame[ai] = my_mac[ai];
    ai = ai + 1;
  }
  let aj: i64 = 0;
  while aj < 6 {
    ack_frame[6 + aj] = 0xAA as u8;
    aj = aj + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref ack_frame, 12, 0x0800 as u32);
  let ack_udp_len: i64 = udp_build_rpi4(mut ref ack_frame, 34, dhcp_server_port_rpi4(), dhcp_client_port_rpi4(), ref ack_msg, ack_dhcp_len, server_ip, bcast_ip);
  let ack_total_len: i64 = 20 + ack_udp_len;
  let _ = ipv4_build_header_rpi4(mut ref ack_frame, 14, ack_total_len, 17 as u32, server_ip, bcast_ip);
  let ack_frame_len: i64 = 14 + ack_total_len;

  let send_status2: i64 = netif_send_frame_rpi4(ref ack_frame, ack_frame_len);
  if send_status2 != 0 { ok = 0; }

  let poll2: i64 = dhcp_client_poll_rpi4(ref my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound_rpi4() { ok = 0; }
  if dhcp_state_get_leased_ip() != offered_ip { ok = 0; }

  let _ = uart_puts_rpi4_vani("DHCP: client DISCOVER->OFFER->REQUEST->ACK->BOUND");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 92 -- DHCP SERVER. Brand-new design, no kernel_main.vani
// precedent to port (Pi 1 never built one) -- see project memory
// project_dhruva_dhcp_server_scope_2026_09_06.md for the full
// rationale. A separate persistent-state file from round 91's client
// (`boot/rpi4/dhcp_server_state.S`), a small 4-slot fixed lease table
// (mac/ip/xid/state/lease_start_tick per slot) plus server-wide
// config (server_ip/pool_base_ip/pool_size/lease_time) set once via
// dhcp_server_init_rpi4.
//
// Reuses round 91's `dhcp_build_fixed_header_rpi4` directly for every
// server reply (BOOTREPLY), and -- the concrete payoff of the client
// having shipped first -- reuses round 91's own `dhcp_build_
// discover_rpi4`/`dhcp_build_request_rpi4` UNCHANGED in this round's
// own self-test below to synthesize realistic fake-client traffic,
// rather than hand-building synthetic messages the way round 91 had
// to for its own fake-server replies (no server code existed yet to
// reuse at that point).
//
// Sibling-if-block locals below are all given distinct, block-
// specific prefixes throughout (not just where round 91 already hit
// the bug) -- proactively avoiding [[feedback_vani_llvm_local_name_collision]]
// rather than discovering it again live.
//
// **Out of scope this round** (see the scope memory for the full
// list): DHCPDECLINE/RELEASE/INFORM, lease expiry/GC (a BOUND lease
// stays bound forever; also can't be tested synchronously here for
// the same timer-advancement reason round 91's own renewal self-test
// was skipped), relay-agent (giaddr), conflict detection, dynamic
// pool reconfiguration, and any admin CLI beyond a self-test rerun.

fn dhcp_lease_state_free_rpi4() -> u32 { return 0 as u32; }
fn dhcp_lease_state_offered_rpi4() -> u32 { return 1 as u32; }
fn dhcp_lease_state_bound_rpi4() -> u32 { return 2 as u32; }

extern "C" fn dhcp_server_set_config(server_ip: u32, pool_base_ip: u32, pool_size: u32, lease_time: u32) -> u32;
extern "C" fn dhcp_server_get_server_ip() -> u32;
extern "C" fn dhcp_server_get_pool_base_ip() -> u32;
extern "C" fn dhcp_server_get_pool_size() -> u32;
extern "C" fn dhcp_server_get_lease_time() -> u32;
extern "C" fn dhcp_server_reset() -> u32;
extern "C" fn dhcp_server_get_lease_state(index: u32) -> u32;
extern "C" fn dhcp_server_set_lease_state(index: u32, value: u32) -> u32;
extern "C" fn dhcp_server_get_lease_ip(index: u32) -> u32;
extern "C" fn dhcp_server_set_lease_ip(index: u32, value: u32) -> u32;
extern "C" fn dhcp_server_get_lease_xid(index: u32) -> u32;
extern "C" fn dhcp_server_set_lease_xid(index: u32, value: u32) -> u32;
extern "C" fn dhcp_server_get_lease_start_tick(index: u32) -> u32;
extern "C" fn dhcp_server_set_lease_start_tick(index: u32, value: u32) -> u32;
extern "C" fn dhcp_server_get_lease_mac_byte(index: u32, byte_idx: u32) -> u32;
extern "C" fn dhcp_server_set_lease_mac_byte(index: u32, byte_idx: u32, value: u32) -> u32;

fn dhcp_server_init_rpi4(server_ip: u32, pool_base_ip: u32, pool_size: u32, lease_time: u32) -> i64 {
  let _ = dhcp_server_reset();
  let _ = dhcp_server_set_config(server_ip, pool_base_ip, pool_size, lease_time);
  return 0;
}

// Round 106e: the lease table's own lookup ALGORITHM now lives in
// the shared `netstack` package (`DhcpLeaseTable`/`find_lease_by_mac`/
// `find_free_slot`), a value-type struct with no persistent state of
// its own -- this file's own lease TABLE storage (`boot/rpi4/dhcp_
// server_state.S`, the extern accessors above) is untouched.
fn dhcp_lease_table_from_state_rpi4() -> DhcpLeaseTable {
  let state: [u32; 4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let ip: [u32; 4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let xid: [u32; 4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let start_tick: [u32; 4] = [0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let mac_bytes: [u8; 24] = [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let i: u32 = 0 as u32;
  while i < (4 as u32) {
    state[i as i64] = dhcp_server_get_lease_state(i);
    ip[i as i64] = dhcp_server_get_lease_ip(i);
    xid[i as i64] = dhcp_server_get_lease_xid(i);
    start_tick[i as i64] = dhcp_server_get_lease_start_tick(i);
    let j: u32 = 0 as u32;
    while j < (6 as u32) {
      mac_bytes[(i * (6 as u32) + j) as i64] = dhcp_server_get_lease_mac_byte(i, j) as u8;
      j = j + (1 as u32);
    }
    i = i + (1 as u32);
  }
  return DhcpLeaseTable { state: state, ip: ip, xid: xid, start_tick: start_tick, mac_bytes: mac_bytes };
}

fn dhcp_server_find_lease_by_mac_rpi4(mac: ref [u8; 6]) -> i64 {
  let table: DhcpLeaseTable = dhcp_lease_table_from_state_rpi4();
  let result: DhcpLeaseFindResult = netstack_dhcp_find_lease_by_mac(ref table, mac);
  return result.index;
}

fn dhcp_server_find_free_slot_rpi4() -> i64 {
  let table: DhcpLeaseTable = dhcp_lease_table_from_state_rpi4();
  return netstack_dhcp_find_free_slot(ref table);
}

fn dhcp_server_build_offer_ack_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, msg_type: u32, yiaddr: u32, server_ip: u32, lease_time: u32) -> i64 {
  return netstack_dhcp_server_build_offer_ack(buf, dhcp_offset, mac, xid, msg_type, yiaddr, server_ip, lease_time);
}

fn dhcp_server_build_nak_rpi4(buf: mut ref [u8; 512], dhcp_offset: i64, mac: ref [u8; 6], xid: u32, server_ip: u32) -> i64 {
  return netstack_dhcp_server_build_nak(buf, dhcp_offset, mac, xid, server_ip);
}

// Every server reply is broadcast -- this client (round 91) always
// sets the BOOTP broadcast flag, and with no relay agent (giaddr)
// support there's no other address a reply to a still-unconfigured
// client could safely go to anyway.
fn dhcp_server_send_reply_rpi4(my_mac: ref [u8; 6], server_ip: u32, payload: ref [u8; 512], payload_len: i64) -> i64 {
  let bcast_mac: [u8; 6] = [0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8, 0xFF as u8];
  let bcast_ip: u32 = 0xFFFFFFFF as u32;
  return udp_send_rpi4(my_mac, ref bcast_mac, server_ip, bcast_ip, dhcp_server_port_rpi4(), dhcp_client_port_rpi4(), payload, payload_len);
}

// DISCOVER: reuse an existing lease for this MAC if one exists
// (re-offering the same address, matching real DHCP server behavior
// for a client that DISCOVERs again before completing the handshake),
// otherwise allocate the next free pool slot. Pool exhaustion (no
// free slot) is silently ignored -- a real, honest scope boundary
// matching this project's own established "table full -> no room,
// not a crash" posture elsewhere (the packet filter's own 8-rule
// table, ARP's round-robin cache).
fn dhcp_server_handle_discover_rpi4(frame: ref [u8; 512], my_mac: ref [u8; 6]) -> i64 {
  let dhcp_offset: i64 = 42;
  let xid: u32 = dhcp_get_xid_rpi4(frame, dhcp_offset);
  let client_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let dmi: i64 = 0;
  while dmi < 6 {
    client_mac[dmi] = frame[dhcp_offset + 28 + dmi];
    dmi = dmi + 1;
  }

  let existing_slot: i64 = dhcp_server_find_lease_by_mac_rpi4(ref client_mac);
  let slot: i64 = existing_slot;
  if slot < 0 {
    slot = dhcp_server_find_free_slot_rpi4();
    if slot < 0 {
      return 0; // pool exhausted
    }
    let pool_base: u32 = dhcp_server_get_pool_base_ip();
    let alloc_ip: u32 = pool_base + (slot as u32);
    let _ = dhcp_server_set_lease_ip(slot as u32, alloc_ip);
    let dmj: i64 = 0;
    while dmj < 6 {
      let _ = dhcp_server_set_lease_mac_byte(slot as u32, dmj as u32, client_mac[dmj] as u32);
      dmj = dmj + 1;
    }
  }
  let _ = dhcp_server_set_lease_state(slot as u32, dhcp_lease_state_offered_rpi4());
  let _ = dhcp_server_set_lease_xid(slot as u32, xid);

  let server_ip: u32 = dhcp_server_get_server_ip();
  let lease_time: u32 = dhcp_server_get_lease_time();
  let offered_ip: u32 = dhcp_server_get_lease_ip(slot as u32);
  let discover_reply: [u8; 512] = netif_zero_frame_rpi4();
  let discover_reply_len: i64 = dhcp_server_build_offer_ack_rpi4(mut ref discover_reply, 0, ref client_mac, xid, dhcp_msgtype_offer_rpi4(), offered_ip, server_ip, lease_time);
  let _ = dhcp_server_send_reply_rpi4(my_mac, server_ip, ref discover_reply, discover_reply_len);
  return 1;
}

// REQUEST: ACK only if this MAC already has a lease (from a prior
// DISCOVER) AND the requested address (option 50, or ciaddr for a
// renewal) matches what THIS server actually has on record for it --
// otherwise NAK. An unknown MAC (never DISCOVERed) always NAKs.
fn dhcp_server_handle_request_rpi4(frame: ref [u8; 512], dhcp_len: i64, my_mac: ref [u8; 6]) -> i64 {
  let dhcp_offset: i64 = 42;
  let xid: u32 = dhcp_get_xid_rpi4(frame, dhcp_offset);
  let client_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let rmi: i64 = 0;
  while rmi < 6 {
    client_mac[rmi] = frame[dhcp_offset + 28 + rmi];
    rmi = rmi + 1;
  }

  let requested_ip_opt: u32 = dhcp_find_option_u32_rpi4(frame, dhcp_offset, dhcp_len, 50 as u32);
  let ciaddr: u32 = dhcp_get_ciaddr_rpi4(frame, dhcp_offset);
  let want_ip: u32 = if requested_ip_opt != (0 as u32) { requested_ip_opt } else { ciaddr };

  let server_ip: u32 = dhcp_server_get_server_ip();
  let slot: i64 = dhcp_server_find_lease_by_mac_rpi4(ref client_mac);
  let ok_to_ack: i64 = if (slot >= 0) && (dhcp_server_get_lease_ip(slot as u32) == want_ip) { 1 } else { 0 };

  let request_reply: [u8; 512] = netif_zero_frame_rpi4();
  if ok_to_ack == 1 {
    let _ = dhcp_server_set_lease_state(slot as u32, dhcp_lease_state_bound_rpi4());
    let _ = dhcp_server_set_lease_xid(slot as u32, xid);
    let lease_time: u32 = dhcp_server_get_lease_time();
    let ack_reply_len: i64 = dhcp_server_build_offer_ack_rpi4(mut ref request_reply, 0, ref client_mac, xid, dhcp_msgtype_ack_rpi4(), want_ip, server_ip, lease_time);
    let _ = dhcp_server_send_reply_rpi4(my_mac, server_ip, ref request_reply, ack_reply_len);
  } else {
    let nak_reply_len: i64 = dhcp_server_build_nak_rpi4(mut ref request_reply, 0, ref client_mac, xid, server_ip);
    let _ = dhcp_server_send_reply_rpi4(my_mac, server_ip, ref request_reply, nak_reply_len);
  }
  return 1;
}

// Dequeues the next queued frame and, if it's a DHCP client message
// (dst_port 67, valid magic cookie, op=BOOTREQUEST) addressed to this
// server, dispatches by message type. Same round-8/round-22-style
// checksum/bounds guard as round 91's own dhcp_client_poll_rpi4.
fn dhcp_server_poll_rpi4(my_mac: ref [u8; 6]) -> i64 {
  let frame: [u8; 512] = netif_zero_frame_rpi4();
  let frame_len: i64 = netif_recv_frame_rpi4(mut ref frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if arp_read_u16_be_rpi4(ref frame, 12) != (0x0800 as u32) {
    return 0;
  }
  if ipv4_get_protocol_rpi4(ref frame, 14) != (17 as u32) {
    return 0;
  }
  if udp_get_dst_port_rpi4(ref frame, 34) != dhcp_server_port_rpi4() {
    return 0;
  }
  let udp_len: u32 = udp_get_length_rpi4(ref frame, 34);
  let dhcp_len: i64 = (udp_len as i64) - 8;
  if dhcp_len < 240 {
    return 0;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0;
  }
  let src_ip: u32 = ipv4_get_src_ip_rpi4(ref frame, 14);
  let dst_ip: u32 = ipv4_get_dst_ip_rpi4(ref frame, 14);
  if udp_verify_checksum_rpi4(src_ip, dst_ip, ref frame, 34, udp_len as i64) != 1 {
    return 0;
  }
  let dhcp_offset: i64 = 42;
  if dhcp_verify_magic_cookie_rpi4(ref frame, dhcp_offset) != 1 {
    return 0;
  }
  if dhcp_get_op_rpi4(ref frame, dhcp_offset) != dhcp_op_bootrequest_rpi4() {
    return 0;
  }
  let msg_type: i64 = dhcp_find_option_byte_rpi4(ref frame, dhcp_offset, dhcp_len, 53 as u32);
  if msg_type == (dhcp_msgtype_discover_rpi4() as i64) {
    return dhcp_server_handle_discover_rpi4(ref frame, my_mac);
  }
  if msg_type == (dhcp_msgtype_request_rpi4() as i64) {
    return dhcp_server_handle_request_rpi4(ref frame, dhcp_len, my_mac);
  }
  return 0;
}

// Boot-time (and on-demand, via the `dhcps` shell command) self-test:
// no real DHCP client exists in this loopback-only environment, so
// this plays "fake client" using round 91's OWN `dhcp_build_
// discover_rpi4`/`dhcp_build_request_rpi4` builders (they already
// produce exactly the wire format a real client sends) wrapped in a
// manually-built Ethernet+IP+UDP frame, exercising DISCOVER->OFFER,
// a matching REQUEST->ACK, and an unknown-MAC REQUEST->NAK.
fn dhcp_server_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let my_mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netif_get_mac_rpi4(mut ref my_mac);
  let server_ip: u32 = 0x0A000001 as u32;    // 10.0.0.1
  let pool_base_ip: u32 = 0x0A00000A as u32; // 10.0.0.10
  let _ = dhcp_server_init_rpi4(server_ip, pool_base_ip, 4 as u32, 3600 as u32);

  let no_ip: u32 = 0 as u32;
  let bcast_ip: u32 = 0xFFFFFFFF as u32;
  let fake_client_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x42 as u8];
  let xid: u32 = 0xABCD1234 as u32;

  // --- DISCOVER -> OFFER ---
  let discover_msg: [u8; 512] = netif_zero_frame_rpi4();
  let discover_dhcp_len: i64 = dhcp_build_discover_rpi4(mut ref discover_msg, 0, ref fake_client_mac, xid);
  let discover_frame: [u8; 512] = netif_zero_frame_rpi4();
  let dfi: i64 = 0;
  while dfi < 6 {
    discover_frame[dfi] = 0xFF as u8; // dst: broadcast
    dfi = dfi + 1;
  }
  let dfj: i64 = 0;
  while dfj < 6 {
    discover_frame[6 + dfj] = fake_client_mac[dfj]; // src: fake client
    dfj = dfj + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref discover_frame, 12, 0x0800 as u32);
  let discover_udp_len: i64 = udp_build_rpi4(mut ref discover_frame, 34, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref discover_msg, discover_dhcp_len, no_ip, bcast_ip);
  let discover_total_len: i64 = 20 + discover_udp_len;
  let _ = ipv4_build_header_rpi4(mut ref discover_frame, 14, discover_total_len, 17 as u32, no_ip, bcast_ip);
  let discover_frame_len: i64 = 14 + discover_total_len;
  let send1: i64 = netif_send_frame_rpi4(ref discover_frame, discover_frame_len);
  if send1 != 0 { ok = 0; }

  let poll1: i64 = dhcp_server_poll_rpi4(ref my_mac);
  if poll1 != 1 { ok = 0; }

  let slot_after_discover: i64 = dhcp_server_find_lease_by_mac_rpi4(ref fake_client_mac);
  if slot_after_discover < 0 { ok = 0; }
  if dhcp_server_get_lease_state(slot_after_discover as u32) != dhcp_lease_state_offered_rpi4() { ok = 0; }
  let offered_ip: u32 = dhcp_server_get_lease_ip(slot_after_discover as u32);
  if offered_ip != pool_base_ip { ok = 0; } // first free slot -> pool_base + 0

  let offer_recv: [u8; 512] = netif_zero_frame_rpi4();
  let offer_recv_len: i64 = netif_recv_frame_rpi4(mut ref offer_recv, 512);
  if offer_recv_len < 240 { ok = 0; }
  if dhcp_find_option_byte_rpi4(ref offer_recv, 42, offer_recv_len - 42, 53 as u32) != (dhcp_msgtype_offer_rpi4() as i64) { ok = 0; }
  if dhcp_get_yiaddr_rpi4(ref offer_recv, 42) != offered_ip { ok = 0; }
  if dhcp_find_option_u32_rpi4(ref offer_recv, 42, offer_recv_len - 42, 54 as u32) != server_ip { ok = 0; }

  // --- matching REQUEST -> ACK ---
  let request_msg: [u8; 512] = netif_zero_frame_rpi4();
  let request_dhcp_len: i64 = dhcp_build_request_rpi4(mut ref request_msg, 0, ref fake_client_mac, xid, offered_ip, server_ip);
  let request_frame: [u8; 512] = netif_zero_frame_rpi4();
  let rfi: i64 = 0;
  while rfi < 6 {
    request_frame[rfi] = 0xFF as u8;
    rfi = rfi + 1;
  }
  let rfj: i64 = 0;
  while rfj < 6 {
    request_frame[6 + rfj] = fake_client_mac[rfj];
    rfj = rfj + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref request_frame, 12, 0x0800 as u32);
  let request_udp_len: i64 = udp_build_rpi4(mut ref request_frame, 34, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref request_msg, request_dhcp_len, no_ip, bcast_ip);
  let request_total_len: i64 = 20 + request_udp_len;
  let _ = ipv4_build_header_rpi4(mut ref request_frame, 14, request_total_len, 17 as u32, no_ip, bcast_ip);
  let request_frame_len: i64 = 14 + request_total_len;
  let send2: i64 = netif_send_frame_rpi4(ref request_frame, request_frame_len);
  if send2 != 0 { ok = 0; }

  let poll2: i64 = dhcp_server_poll_rpi4(ref my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_server_get_lease_state(slot_after_discover as u32) != dhcp_lease_state_bound_rpi4() { ok = 0; }

  let ack_recv: [u8; 512] = netif_zero_frame_rpi4();
  let ack_recv_len: i64 = netif_recv_frame_rpi4(mut ref ack_recv, 512);
  if ack_recv_len < 240 { ok = 0; }
  if dhcp_find_option_byte_rpi4(ref ack_recv, 42, ack_recv_len - 42, 53 as u32) != (dhcp_msgtype_ack_rpi4() as i64) { ok = 0; }
  if dhcp_get_yiaddr_rpi4(ref ack_recv, 42) != offered_ip { ok = 0; }

  // --- unknown-MAC REQUEST -> NAK ---
  let stranger_mac: [u8; 6] = [0x02 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0x99 as u8];
  let stranger_xid: u32 = 0x55667788 as u32;
  let stranger_msg: [u8; 512] = netif_zero_frame_rpi4();
  let stranger_dhcp_len: i64 = dhcp_build_request_rpi4(mut ref stranger_msg, 0, ref stranger_mac, stranger_xid, pool_base_ip, server_ip);
  let stranger_frame: [u8; 512] = netif_zero_frame_rpi4();
  let sfi: i64 = 0;
  while sfi < 6 {
    stranger_frame[sfi] = 0xFF as u8;
    sfi = sfi + 1;
  }
  let sfj: i64 = 0;
  while sfj < 6 {
    stranger_frame[6 + sfj] = stranger_mac[sfj];
    sfj = sfj + 1;
  }
  let _ = arp_write_u16_be_rpi4(mut ref stranger_frame, 12, 0x0800 as u32);
  let stranger_udp_len: i64 = udp_build_rpi4(mut ref stranger_frame, 34, dhcp_client_port_rpi4(), dhcp_server_port_rpi4(), ref stranger_msg, stranger_dhcp_len, no_ip, bcast_ip);
  let stranger_total_len: i64 = 20 + stranger_udp_len;
  let _ = ipv4_build_header_rpi4(mut ref stranger_frame, 14, stranger_total_len, 17 as u32, no_ip, bcast_ip);
  let stranger_frame_len: i64 = 14 + stranger_total_len;
  let send3: i64 = netif_send_frame_rpi4(ref stranger_frame, stranger_frame_len);
  if send3 != 0 { ok = 0; }

  let poll3: i64 = dhcp_server_poll_rpi4(ref my_mac);
  if poll3 != 1 { ok = 0; }

  let nak_recv: [u8; 512] = netif_zero_frame_rpi4();
  let nak_recv_len: i64 = netif_recv_frame_rpi4(mut ref nak_recv, 512);
  if nak_recv_len < 240 { ok = 0; }
  if dhcp_find_option_byte_rpi4(ref nak_recv, 42, nak_recv_len - 42, 53 as u32) != (dhcp_msgtype_nak_rpi4() as i64) { ok = 0; }

  let _ = uart_puts_rpi4_vani("DHCPS: server DISCOVER->OFFER, REQUEST->ACK, unknown-MAC REQUEST->NAK");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

// Round 93 -- static IP configuration, the DHCP-alternative path from
// the user's own original networking vision. Brand-new design, no
// kernel_main.vani precedent (Pi 1's own DHCP was always the only way
// this project ever acquired an address). New `boot/rpi4/netconfig_
// state.S` holds a single scalar network configuration (ip/netmask/
// gateway/source), same shape as round 91's DHCP client state.
//
// `netconfig_apply_from_dhcp_rpi4` is a generic setter any acquisition
// path can call -- written and self-tested here, but deliberately
// NOT wired into round 91's `dhcp_client_poll_rpi4` this round. Doing
// that live would need that function to also parse DHCP options 1
// (subnet mask) and 3 (router) from the ACK, which it doesn't today,
// and round 92's own DHCP server would need to start sending them
// too -- a real, small, well-scoped follow-up, not done here so this
// round stays focused on the actually-requested capability (a genuine
// static-IP alternative to running the DHCP handshake at all).
//
// Sibling-if/multi-block locals below use distinct names throughout,
// same proactive discipline round 92 already applied against
// [[feedback_vani_llvm_local_name_collision]].

fn netconfig_source_none_rpi4() -> u32 { return 0 as u32; }
fn netconfig_source_static_rpi4() -> u32 { return 1 as u32; }
fn netconfig_source_dhcp_rpi4() -> u32 { return 2 as u32; }

extern "C" fn netconfig_get_ip() -> u32;
extern "C" fn netconfig_set_ip(value: u32) -> u32;
extern "C" fn netconfig_get_netmask() -> u32;
extern "C" fn netconfig_set_netmask(value: u32) -> u32;
extern "C" fn netconfig_get_gateway() -> u32;
extern "C" fn netconfig_set_gateway(value: u32) -> u32;
extern "C" fn netconfig_get_source() -> u32;
extern "C" fn netconfig_set_source(value: u32) -> u32;
extern "C" fn netconfig_reset() -> u32;

fn netconfig_is_configured_rpi4() -> i64 {
  if netconfig_get_source() != netconfig_source_none_rpi4() {
    return 1;
  }
  return 0;
}

// Configures this device's network identity directly, bypassing DHCP
// entirely -- the actual "static IP" capability the user asked for.
// Rejects 0.0.0.0 and 255.255.255.255 for the address itself (never
// real values here, matching arp_cache's own "0 means unused"
// convention and the broadcast address's own reserved meaning
// elsewhere in this project) -- netmask/gateway are NOT validated
// against the address (e.g. gateway-outside-subnet), a real, honest
// scope boundary: this project's own IP/TCP/UDP layers never consult
// netmask/gateway for a routing decision today, so there is nothing
// downstream yet that a stricter check would actually protect.
fn netconfig_set_static_rpi4(ip: u32, netmask: u32, gateway: u32) -> i64 {
  if (ip == (0 as u32)) || (ip == (0xFFFFFFFF as u32)) {
    return 0 - 1;
  }
  let _ = netconfig_set_ip(ip);
  let _ = netconfig_set_netmask(netmask);
  let _ = netconfig_set_gateway(gateway);
  let _ = netconfig_set_source(netconfig_source_static_rpi4());
  return 0;
}

// Generic acquisition-path setter -- see this section's own header
// comment for why DHCP doesn't call this live yet.
fn netconfig_apply_from_dhcp_rpi4(ip: u32, netmask: u32, gateway: u32) -> i64 {
  let _ = netconfig_set_ip(ip);
  let _ = netconfig_set_netmask(netmask);
  let _ = netconfig_set_gateway(gateway);
  let _ = netconfig_set_source(netconfig_source_dhcp_rpi4());
  return 0;
}

// Boot-time (and on-demand, via the `netcfg` shell command) self-test:
// starts unconfigured, sets a static config and verifies every field
// + is_configured, rejects an invalid address (0.0.0.0), resets back
// to unconfigured, then proves the generic DHCP-facing path also
// works correctly (source tracking in particular) even though nothing
// calls it live yet.
fn netconfig_self_test_rpi4() -> i64 {
  let ok: i64 = 1;
  let _ = netconfig_reset();

  if netconfig_is_configured_rpi4() != 0 { ok = 0; }

  let static_ip: u32 = 0xC0A80164 as u32;    // 192.168.1.100
  let static_netmask: u32 = 0xFFFFFF00 as u32; // 255.255.255.0
  let static_gateway: u32 = 0xC0A80101 as u32; // 192.168.1.1
  let static_status: i64 = netconfig_set_static_rpi4(static_ip, static_netmask, static_gateway);
  if static_status != 0 { ok = 0; }
  if netconfig_is_configured_rpi4() != 1 { ok = 0; }
  if netconfig_get_ip() != static_ip { ok = 0; }
  if netconfig_get_netmask() != static_netmask { ok = 0; }
  if netconfig_get_gateway() != static_gateway { ok = 0; }
  if netconfig_get_source() != netconfig_source_static_rpi4() { ok = 0; }

  let invalid_status: i64 = netconfig_set_static_rpi4(0 as u32, static_netmask, static_gateway);
  if invalid_status != (0 - 1) { ok = 0; }
  // Rejected -- the earlier valid static config must be untouched.
  if netconfig_get_ip() != static_ip { ok = 0; }

  let _ = netconfig_reset();
  if netconfig_is_configured_rpi4() != 0 { ok = 0; }
  if netconfig_get_ip() != (0 as u32) { ok = 0; }

  let dhcp_ip: u32 = 0x0A00000A as u32;      // 10.0.0.10
  let dhcp_netmask: u32 = 0xFFFFFF00 as u32; // 255.255.255.0
  let dhcp_gateway: u32 = 0x0A000001 as u32; // 10.0.0.1
  let _ = netconfig_apply_from_dhcp_rpi4(dhcp_ip, dhcp_netmask, dhcp_gateway);
  if netconfig_is_configured_rpi4() != 1 { ok = 0; }
  if netconfig_get_ip() != dhcp_ip { ok = 0; }
  if netconfig_get_source() != netconfig_source_dhcp_rpi4() { ok = 0; }

  let _ = uart_puts_rpi4_vani("NETCFG: static IP config + unconfigured/invalid rejection + DHCP-path setter");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

#[no_mangle]
fn kmain_rpi4_vani() -> i64 {
  let _ = uart_puts_rpi4_vani("\nDHRUVA RPI4: first vani-compiled code running on real AArch64 codegen\n");
  let _ = rpi4_vani_self_test();
  let _ = gpio_self_check_rpi4();
  let _ = rpi4_uart_rx_irq_init();
  let _ = uart_puts_rpi4_vani("DHRUVA RPI4: UART0 RX interrupt armed, echoing input\n");
  let _ = task_switch_self_test();
  let _ = preempt_yield_self_test();
  let _ = preempt_init();
  let _ = sha256_self_test_rpi4();
  let _ = sha512_self_test_rpi4();
  let _ = x25519_self_test_rpi4();
  let _ = ed25519_self_test_rpi4();
  let _ = pki_self_test_rpi4();
  // BLOCKED (round 166, 2026-09-10): tls_self_test_rpi4() is fully
  // written and passes on the host LLVM JIT, but is disabled here
  // pending a real AArch64-codegen bug in the shared chacha20_
  // poly1305 package -- isolated to a SINGLE minimal encrypt+decrypt
  // round trip with a short (<64-byte) plaintext, which corrupts
  // unrelated memory (TCP/UDP/DHCP break, eventually a real fault)
  // specifically when cross-compiled to AArch64 and run under real
  // QEMU. Pi 1 (ARM32) has used this exact package correctly in
  // production all session, including for genuinely short messages,
  // so this is NOT a logic bug in the package's own vani source --
  // something about AArch64 instruction selection/register
  // allocation for this code path is the suspect. See project memory
  // project_dhruva_round166_tls13_scoping_and_bug_2026_09_10.md for
  // the full bisection trail. Re-enable once root-caused and fixed.
  // let _ = tls_self_test_rpi4();
  // Round 88: packet filtering's own default policy -- .bss's own
  // zero-init would otherwise leave it at 0 (deny), which would
  // silently break every self-test below that touches netif (all of
  // them now go through filter_check_frame_rpi4's ingress/egress
  // hooks) before a single rule has ever been added. Explicitly allow
  // by default, matching kernel_main.vani's own identical boot-time
  // fix and its identical reasoning -- must run before netif_self_
  // test_rpi4, not just before the filter's own self-tests.
  let _ = filter_set_default_policy(1 as u32);
  let _ = netif_self_test_rpi4();
  let _ = arp_self_test_rpi4();
  let _ = arp_resolve_self_test_rpi4();
  let _ = ipv4_self_test_rpi4();
  let _ = filter_self_test_rpi4();
  let _ = filter_outgoing_self_test_rpi4();
  let _ = tcp_self_test_rpi4();
  let _ = tcp_conn_self_test_rpi4();
  let _ = udp_self_test_rpi4();
  let _ = dhcp_self_test_rpi4();
  let _ = dhcp_server_self_test_rpi4();
  let _ = netconfig_self_test_rpi4();
  let _ = mqtt_self_test_rpi4();
  return 0;
}

// Round 75 -- the second concrete increment of "port kernel_main.vani
// (or its boot-facing pieces) to Pi 4/5" (docs/TODO.md, marked
// [PARTIAL, round 74] until now): real vani-compiled code now runs on
// EVERY timer tick, not just once at boot. Round 74 proved the
// toolchain with a one-shot, boot-time-only computation; this proves
// the same pipeline works from a genuinely repeated, interrupt-driven
// call site too -- the natural next step, mirroring how Pi 1's own
// irq_dispatch was this whole project's original seed.
//
// Called from boot/rpi4/vectors.S's aarch64_irq_handler via a plain
// `bl rpi4_handle_timer_irq`, found by this fn's own #[no_mangle]
// bare name -- same convention kmain_rpi4_vani above and Pi 1's
// irq_dispatch/kernel_main already use. Safe to call ANY AArch64 C-ABI
// function here with zero extra register-preservation work on this
// side: aarch64_irq_handler already unconditionally saves the FULL
// x0-x30 register file (it must, since it resumes the interrupted
// context via `eret`) before ever branching here, so whatever this
// function or anything it calls clobbers is already backed up and
// restored on the way out regardless -- unlike Pi 1's own irq_dispatch
// call site (which only saves what a normal AAPCS32 call needs,
// relying on irq_dispatch's own #[interrupt] tag to enforce safe
// behavior), there is no equivalent AAPCS-boundary hazard to get
// wrong here (see [[feedback_aapcs_callee_saved_registers_asm]] for
// why that class of bug keeps recurring elsewhere in this project --
// this call site is a structurally different, safer shape).
//
// Deliberately untagged ((no #[interrupt]/#[wcet]/#[bounded_stack])),
// matching kmain_rpi4_vani's own precedent above -- establishing a
// real WCET/interrupt-safety story for this brand-new target is its
// own separate future increment, not needed to prove basic
// interrupt-context correctness here. Also deliberately does NOT use
// #[bounded(N)] recursion anywhere in its own call chain (see uart_
// put_u64_rpi4_vani_digits's own comment on why that specific
// attribute is unsafe on this target today).
extern "C" fn gic_timer_rearm() -> i64;
extern "C" fn gic_timer_disable() -> i64;
extern "C" fn rpi4_timer_tick_count_increment() -> i64;

#[no_mangle]
// Round 79: return value is now a real signal, not always 0 --
// boot/rpi4/vectors.S's irq_timer branch passes it straight to
// rpi4_preempt_switch as `force_boot` (1 = this was the halting
// tick, switch back to the boot context and stay there; 0 = keep
// alternating between the two preemptible tasks).
fn rpi4_handle_timer_irq() -> i64 {
  let tick: i64 = rpi4_timer_tick_count_increment();
  let _ = uart_puts_rpi4_vani("\nDHRUVA RPI4: real timer IRQ handled, tick=");
  let _ = uart_put_i64_rpi4_vani(tick);
  if tick >= 5 {
    let _ = gic_timer_disable();
    let _ = uart_puts_rpi4_vani("\nDHRUVA RPI4: 5 real timer IRQs handled, halting\n");
    return 1;
  } else {
    let _ = gic_timer_rearm();
    return 0;
  }
}

// Round 79 -- interrupt-driven preemption, built directly on top of
// round 78's proven "two stacks can be swapped between correctly"
// primitive, but now via a genuinely different mechanism:
// boot/rpi4/preempt_switch.S's own header comment has the full
// design (why the frame format, the fake-frame construction, and the
// switch itself all had to change from round 78's cooperative,
// `ret`-based shape to an interrupt/`eret`-based one). NOT the real
// scheduler (no priorities, no more than 2 tasks, no voluntary
// sleep/mutex primitives) -- proves the timer can genuinely preempt
// and resume a DIFFERENT task's saved context, the one piece round 78
// deliberately left unproven.
extern "C" fn preempt_init() -> i64;
extern "C" fn heartbeat_already_printed() -> i64;
// Round 82: a real time-based voluntary sleep, the prerequisite
// priorities would need anyway (round 81's own generic voluntary
// switch could hand off to an EXPLICIT target, but pure round robin
// plus priorities would just mean the highest-priority task never
// gives up the CPU -- a task needs a way to remove ITSELF from
// rotation for a while first). preempt_sleep_ticks marks the caller
// not-ready in pt_sleep_until and picks the next READY task
// dynamically -- see boot/rpi4/preempt_switch.S's own comment for
// the full design.
extern "C" fn preempt_sleep_ticks(n: i64) -> i64;

// Pure busy-wait between prints -- not a real sleep/yield primitive
// (none exists at this scope), just enough to keep each task's
// per-tick output legible. Without it, QEMU's TCG emulation runs
// these trivial loops so many times per ~500ms real-time tick that a
// single slice produces hundreds of thousands of characters (found
// live: an early version of this demo printed 400KB+ of output
// before this was added) -- not wrong, just impractically chatty for
// a demo whose entire point is showing the alternation, not stress-
// testing UART throughput.
fn preempt_delay() -> i64 {
  let i: i64 = 0;
  while i < 2000000 {
    i = i + 1;
  }
  return 0;
}

// task_b/task_c never explicitly yield -- exactly like round 79/80's
// original design, relying ENTIRELY on the timer to preempt them.
// task_a is different as of round 82: it voluntarily sleeps for 2
// real ticks after each print instead of busy-waiting, demonstrating
// voluntary sleep and involuntary preemption coexisting in the SAME
// live demo (not just each proven in its own isolated self-test).
// How many characters task_b/task_c print per ~500ms slice is
// inherently timing-dependent (a real preemptive switch doesn't
// produce a clean deterministic count) -- what's checkable is that
// all three letters appear, task_a specifically appears only once
// per turn (since it always sleeps right after printing), and that
// the whole demo ends cleanly (see rpi4_heartbeat_tick below).
#[no_mangle]
fn preempt_task_a_entry() -> i64 {
  while true {
    let _ = uart_putc_rpi4_vani(65); // 'A'
    let _ = preempt_sleep_ticks(2);
  }
  return 0;
}

// Round 83: task_b also sleeps now (1 tick, shorter than task_a's 2)
// instead of busy-waiting -- gives task_c (the only task that never
// sleeps, priority NUM_TASKS-1/lowest, effectively this demo's idle
// task) genuine gaps to run in, rather than task_b (priority 1,
// always ready) permanently starving it out. See boot/rpi4/
// preempt_switch.S's own header comment for why task index doubles
// as priority (lower index = higher priority) instead of a separate
// priority table.
#[no_mangle]
fn preempt_task_b_entry() -> i64 {
  while true {
    let _ = uart_putc_rpi4_vani(66); // 'B'
    let _ = preempt_sleep_ticks(1);
  }
  return 0;
}

// Round 80: third task, generalizing round 79's hardcoded A<->B
// toggle into real NUM_TASKS-way round robin (boot/rpi4/preempt_
// switch.S's own header comment has the full design).
#[no_mangle]
fn preempt_task_c_entry() -> i64 {
  while true {
    let _ = uart_putc_rpi4_vani(67); // 'C'
    let _ = preempt_delay();
  }
  return 0;
}

// Called from boot.S's own heartbeat_loop, right after every `wfi`
// wakeup. During ticks 1-4, this instruction never actually executes
// -- rpi4_preempt_switch's `eret` on those ticks resumes task_a/
// task_b directly, not boot's own saved context, so control never
// returns here. It runs exactly once: when tick 5's force_boot=1
// switches back to boot's own saved frame, which -- since boot was
// interrupted mid-`wfi` -- resumes precisely at the instruction right
// after that `wfi`, landing here. The one-shot flag is what makes
// this a genuinely different, checkable signal from "the demo didn't
// crash": explicit, printed evidence that boot's own context was
// correctly preserved through the ENTIRE preemption demo (saved once
// on tick 1, never touched again, then correctly restored on tick 5)
// and not merely abandoned in favor of task_a/task_b.
#[no_mangle]
fn rpi4_heartbeat_tick() -> i64 {
  let already: i64 = heartbeat_already_printed();
  if already == 0 {
    let _ = uart_puts_rpi4_vani("DHRUVA RPI4: boot context resumed after preemption demo (PASS)\n");
  }
  let ready: u32 = shell_get_line_ready();
  if ready != (0 as u32) {
    let _ = rpi4_shell_dispatch();
    let _ = shell_clear_line();
  }
  return 0;
}

// Round 84 -- the smallest possible interactive shell on the Pi 4/5
// port (boot/rpi4/shell_state.S's own header comment has the full
// design). Deliberately reuses rpi4_heartbeat_tick's ALREADY-PROVEN
// once-per-wfi-wakeup call site above rather than any new scheduler
// integration -- UART0 RX stays enabled forever (round 77), so this
// keeps working indefinitely regardless of the round 79-83 demo's own
// bounded lifetime.
extern "C" fn shell_get_line_len() -> u32;
extern "C" fn shell_get_line_ready() -> u32;
extern "C" fn shell_get_line_byte(offset: u32) -> u32;
extern "C" fn shell_clear_line() -> u32;

// Whole-line exact match against a known command -- length AND every
// byte must agree, matching kernel_main.vani's own shell_word_matches
// in spirit (that one also handles a start/end sub-range for
// splitting a command from its arguments; this minimal version only
// ever needs to compare the WHOLE line, so it's simpler).
fn rpi4_shell_line_matches(word: Str) -> u32 {
  let linelen: u32 = shell_get_line_len();
  let wlen: i64 = str_len_bytes(word);
  if (linelen as i64) != wlen {
    return 0 as u32;
  }
  let i: i64 = 0;
  while i < wlen {
    let a: u32 = shell_get_line_byte(i as u32);
    let b: i64 = str_byte_at(word, i);
    if (a as i64) != b {
      return 0 as u32;
    }
    i = i + 1;
  }
  return 1 as u32;
}

fn rpi4_shell_starts_with(prefix: Str) -> u32 {
  let linelen: u32 = shell_get_line_len();
  let plen: i64 = str_len_bytes(prefix);
  if (linelen as i64) < plen {
    return 0 as u32;
  }
  let i: i64 = 0;
  while i < plen {
    let a: u32 = shell_get_line_byte(i as u32);
    let b: i64 = str_byte_at(prefix, i);
    if (a as i64) != b {
      return 0 as u32;
    }
    i = i + 1;
  }
  return 1 as u32;
}

// Deliberately tiny command set for a first, minimal shell: help,
// ver, test (reuses rpi4_vani_self_test's own real computation --
// not a placeholder), and echo <text>. No prompt is printed (matches
// kernel_main.vani's own task_f, which is purely reactive) -- output
// is only ever what a command itself prints.
fn rpi4_shell_dispatch() -> i64 {
  if rpi4_shell_line_matches("help") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\ncommands: help, ver, test, sha256, sha512, x25519, ed25519, pki, netif, arp, ip, filter, tcp, udp, dhcp, dhcps, netcfg, mqtt, echo <text>\n");
    return 0;
  }
  if rpi4_shell_line_matches("ver") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\nDhruva OS -- Pi 4/5 port, round 109 minimal shell + crypto + netif + arp + ip + filter + tcp + udp + dhcp + dhcps + netcfg + mqtt\n");
    return 0;
  }
  if rpi4_shell_line_matches("test") == (1 as u32) {
    let _ = rpi4_vani_self_test();
    return 0;
  }
  if rpi4_shell_line_matches("sha256") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = sha256_self_test_rpi4();
    return 0;
  }
  if rpi4_shell_line_matches("sha512") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = sha512_self_test_rpi4();
    return 0;
  }
  if rpi4_shell_line_matches("x25519") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = x25519_self_test_rpi4();
    return 0;
  }
  if rpi4_shell_line_matches("ed25519") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = ed25519_self_test_rpi4();
    return 0;
  }
  if rpi4_shell_line_matches("pki") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = pki_self_test_rpi4();
    return 0;
  }
  if rpi4_shell_line_matches("tls") == (1 as u32) {
    let _ = uart_puts_rpi4_vani("\n");
    let _ = tls_self_test_rpi4();
    return 0;
  }
