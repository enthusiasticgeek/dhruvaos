// crypto self-test's own convention (sha256_self_test_rpi4 etc.).
fn tls_self_test_rpi4() -> i64 {
  let ok: i64 = tls13_self_test();
  let _ = uart_puts_rpi4_vani("CRYPTO: TLS 1.3 (TLS_CHACHA20_POLY1305_SHA256, x25519, RFC 7250 raw pubkeys) live handshake + app data round trip");
  if ok == 1 {
