}

fn x25519_self_test_rpi4() -> i64 {
  let ok: i64 = x25519_self_test();
  let _ = uart_puts_rpi4_vani("CRYPTO: X25519 vs kernel_main.vani's own verified reference (base-point + DH agreement)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
  }
  return ok;
}

fn ed25519_self_test_rpi4() -> i64 {
  let ok: i64 = ed25519_self_test();
  let _ = uart_puts_rpi4_vani("CRYPTO: Ed25519 vs kernel_main.vani's own verified reference (pubkey+sign+verify+tamper)");
  if ok == 1 {
    let _ = uart_puts_rpi4_vani(" (PASS)\n");
  } else {
    let _ = uart_puts_rpi4_vani(" (FAIL)\n");
