  let _ = buf_write_byte(salt, 6 as u32, 0x06 as u32);
  let _ = buf_write_byte(salt, 7 as u32, 0x07 as u32);
  let _ = buf_write_byte(salt, 8 as u32, 0x08 as u32);
  let _ = buf_write_byte(salt, 9 as u32, 0x09 as u32);
