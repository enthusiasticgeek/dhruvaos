// Round 54: general task-creation API -- generalizes the fixed 6-task
// scheduler (boot/context_switch.S) to a real, callable API. Takes any
// vani fn() -> i64 as a genuine runtime value (verified vani supports
// this end to end through both backends before writing the assembly
// side). Returns the new task's slot index, or 0xFFFFFFFF (u32 -1) if
// all 10 free slots (indices 6-15) are already taken -- there is no
// task-deletion API yet, so slots are never reclaimed.
extern "C" fn task_create(entry_fn: fn() -> i64, stack_base: mut ref i64, stack_bytes: u32, priority: u32) -> u32;
// Must be called exactly once, before the first task_create() call and
// before start_multitasking -- see its own comment in context_switch.S.
extern "C" fn task_table_init() -> i64;
// Round 55: a real, second synchronization primitive alongside the
// existing priority-CEILING protocol (dhruva_prio_lock/unlock, below) --
// a genuine blocking mutex with priority inheritance. See
// dhruva_mutex_lock's own comment in context_switch.S for the full
// design (direct ownership handoff, no recursion, no nested-mutex
// inheritance stacking -- all deliberate scope limits, not oversights).
extern "C" fn dhruva_mutex_lock(mutex_id: u32) -> u32;
extern "C" fn dhruva_mutex_unlock(mutex_id: u32) -> u32;
// Reads eff_prio_table[current_task] -- lets a task observe its own
// effective priority live, e.g. to prove a dhruva_mutex_lock inheritance
// boost actually happened.
extern "C" fn current_eff_prio() -> u32;
// task_a=HIGH(priority 0), task_b=MEDIUM(priority 1), task_c=LOW(priority 2),
// task_d=IDLE (priority 4, moved up from 3 back in Phase 3 to make
// room for GC -- always ready, never sleeps) -- the standard RTOS
// answer to "what runs when nothing else is," and load-bearing for a
// subtler reason too: it guarantees scheduler_pick_next's scan always
// has at least one genuinely ready task to fall back to, so "nobody
// else happens to be ready" can never silently re-select a task that
// just called task_sleep_ticks to stop running, ignoring its own
// sleep request entirely (see boot/context_switch.S's own header
// comment on scheduler_pick_next for the full, current tie-
// breaking policy, including round 75's fairness fix).
// task_sleep_ticks/dhruva_prio_lock/dhruva_prio_unlock are boot/context_switch.S's
// scheduler primitives -- see that file for why dhruva_prio_lock/unlock need
// no lock-state of their own (the Immediate Priority Ceiling Protocol's
// whole point is that a correctly-assigned ceiling makes an explicit
// lock/wait-queue unnecessary for a single shared resource) while
// task_sleep_ticks needs a full context save (giving up the CPU
// voluntarily is just as real a suspension as being preempted).
// scheduler_switch_from_irq has no vani-side declaration: it's called
// only from hand-written assembly (boot/irq_entry.S), never from a
// vani call chain.
extern "C" fn task_sleep_ticks(ticks: i64) -> i64;
extern "C" fn dhruva_prio_lock(ceiling: i64) -> i64;
extern "C" fn dhruva_prio_unlock(base_priority: i64) -> i64;
