// श्री।
intent "Dhruva Phase 0-2 -- bare-metal boot + UART hello on BCM2835 (Pi 1 Model B / QEMU raspi1ap), fixed-priority preemptive scheduling across three tasks plus a minimal Immediate Priority Ceiling Protocol mutex demonstrating bounded (not unbounded) priority inversion. Entered from boot/rpi1/boot.S's _start after the stack pointer is set up and BSS is cleared.";

// BCM2835 (Pi 1 Model B / QEMU raspi1ap) MMIO register map. Every
// address below used to be a `let name: i64 = 0x...;` re-declared
// locally in each function that touched it (up to 3x for the busiest
// registers) -- ordinary copy-pasted literals with no cross-check
// that two different peripherals hadn't been given overlapping
// addresses. Ported to vani-compiler's DHDL v0.1 `#[mmio(size=N)]`
// MVP (see ~/dhruvaos-device-tree.md / the "DHDL v0.1" design
// artifact): each register is its own tagged const, and `vanic
// check` now verifies at compile time that none of these 32
// addresses overlap another's `[base, base+size)` range -- a real
// check that didn't exist before, not just a style cleanup. Every
// call site below still declares its own local `let` (unchanged
// variable names, unchanged function bodies) but now assigns it
// from the checked const instead of a bare hex literal.
//
// GPIO (base 0x20200000)
// Round 76 follow-up, 2026-09-06: gpio_fsel_reg_for/gpio_write/
// gpio_read/gpio_set_pull (below) computed their addresses via raw
// arithmetic/inline literals instead of these consts, a real gap in
// the port above -- found while using this exact GPIO code as the
// Pi 4/5 GPIO port's own template. Closed by adding every register
// those 4 functions touch (GPFSEL0/2/3, GPSET0/1, GPCLR0/1, GPLEV0/1,
// GPPUDCLK1) and rewriting them to reference named consts, matching
// gpio_uart_alt_init's own (already-correct) style.
#[mmio(size=4)]
const GPFSEL0: i64 = 0x20200000;
#[mmio(size=4)]
const GPFSEL1: i64 = 0x20200004;
#[mmio(size=4)]
const GPFSEL2: i64 = 0x20200008;
#[mmio(size=4)]
const GPFSEL3: i64 = 0x2020000C;
#[mmio(size=4)]
const GPFSEL4: i64 = 0x20200010;
#[mmio(size=4)]
const GPFSEL5: i64 = 0x20200014;
#[mmio(size=4)]
const GPSET0: i64 = 0x2020001C;
#[mmio(size=4)]
const GPSET1: i64 = 0x20200020;
#[mmio(size=4)]
const GPCLR0: i64 = 0x20200028;
#[mmio(size=4)]
const GPCLR1: i64 = 0x2020002C;
#[mmio(size=4)]
const GPLEV0: i64 = 0x20200034;
#[mmio(size=4)]
const GPLEV1: i64 = 0x20200038;
#[mmio(size=4)]
const GPPUD: i64 = 0x20200094;
#[mmio(size=4)]
const GPPUDCLK0: i64 = 0x20200098;
#[mmio(size=4)]
const GPPUDCLK1: i64 = 0x2020009C;
// UART0 / PL011 (base 0x20201000)
#[mmio(size=4)]
const UART_DR: i64 = 0x20201000;
#[mmio(size=4)]
const UART_FR: i64 = 0x20201018;
#[mmio(size=4)]
const UART_IBRD: i64 = 0x20201024;
#[mmio(size=4)]
const UART_FBRD: i64 = 0x20201028;
#[mmio(size=4)]
const UART_LCRH: i64 = 0x2020102C;
#[mmio(size=4)]
const UART_CR: i64 = 0x20201030;
#[mmio(size=4)]
const UART_IMSC: i64 = 0x20201038;
#[mmio(size=4)]
const UART_ICR: i64 = 0x20201044;
// System Timer (base 0x20003000)
#[mmio(size=4)]
const TIMER_CS: i64 = 0x20003000;
#[mmio(size=4)]
const TIMER_CLO: i64 = 0x20003004;
#[mmio(size=4)]
const TIMER_C1: i64 = 0x20003010;
// Interrupt controller (base 0x2000B000)
#[mmio(size=4)]
const IC_PENDING1: i64 = 0x2000B204;
#[mmio(size=4)]
const IC_PENDING2: i64 = 0x2000B208;
#[mmio(size=4)]
const IC_ENABLE1: i64 = 0x2000B210;
#[mmio(size=4)]
const IC_ENABLE2: i64 = 0x2000B214;
// Power management / watchdog (base 0x20100000)
#[mmio(size=4)]
const PM_RSTC: i64 = 0x2010001C;
#[mmio(size=4)]
const PM_WDOG: i64 = 0x20100024;
// SD host controller (base 0x20202000)
#[mmio(size=4)]
const SDCMD: i64 = 0x20202000;
#[mmio(size=4)]
const SDARG: i64 = 0x20202004;
#[mmio(size=4)]
const SDTOUT: i64 = 0x20202008;
#[mmio(size=4)]
const SDCDIV: i64 = 0x2020200C;
#[mmio(size=4)]
const SDRSP0: i64 = 0x20202010;
#[mmio(size=4)]
const SDHSTS: i64 = 0x20202020;
#[mmio(size=4)]
const SDVDD: i64 = 0x20202030;
#[mmio(size=4)]
const SDEDM: i64 = 0x20202034;
#[mmio(size=4)]
const SDHCFG: i64 = 0x20202038;
#[mmio(size=4)]
const SDHBCT: i64 = 0x2020203C;
#[mmio(size=4)]
const SDHBLC: i64 = 0x20202050;

// Context-switch mechanics (boot/context_switch.S) and the tiny amount
// of raw memory allocation they need (boot/rpi1/runtime_stubs.c) are
// necessarily outside vani: a task-to-task context switch needs to save/
// restore raw CPU registers and swap the live stack pointer mid-function,
// which no high-level language's normal control flow can express.
//
// Every address crossing this boundary is `mut ref i64`, not a bare
// `i64` -- corrected 2026-08-25 after finding this was never actually a
// vani limitation. Initial versions of this file used plain `i64`
// because of two wrong assumptions, both disproven by testing the real
// LLVM IR/ARM codegen directly rather than guessing from the first error
// message: (1) that raw pointer types can't cross extern "C" at all --
// false, `ref T`/`mut ref T` cross cleanly as single-register pointers
// (confirmed: `mut ref i64` params/returns lower to plain `i64*` in LLVM
// IR, always exactly one register on this 32-bit target); (2) that a
// second-class reference can't be stored in a `let` and reused across
// several later calls within the same function -- also false, only
// escaping the *enclosing function's* scope is disallowed, and nothing
// here needs that.
//
// This isn't just cleaner -- it fixes a real bug class. vani's `i64` is
// a genuine 64-bit value, and AAPCS passes a 64-bit *scalar* argument as
// a register PAIR (with alignment padding that can silently shift a
// later argument by a register). A pointer never has that problem: it's
// always exactly one register, on any 32-bit target, regardless of how
// many other arguments precede it. Using `mut ref i64` for every
// address here removes the entire "which register is this actually in"
// risk class the earlier plain-i64 version had to work around by hand.
extern "C" fn dhruva_alloc_bytes(n: i64) -> mut ref i64;
// Round 76: per-task stack guard pages (docs/RTOS_GAP_ANALYSIS.md's
// "No per-task memory or stack protection" gap) -- see boot/rpi1/
// runtime_stubs.c's own comment for the full design. Used ONLY for
// the 10 real task-stack allocations below, never for ordinary
// scratch buffers.
extern "C" fn dhruva_alloc_stack_guarded(n: i64) -> mut ref i64;
extern "C" fn dhruva_heap_used_bytes() -> i64;
// Round 51: total dhruva_alloc_bytes call count (distinct from bytes
// used above) + fault-injection arming -- see runtime_stubs.c's own
// comment on dhruva_fault_inject_alloc_arm.
extern "C" fn dhruva_alloc_count_get() -> i64;
extern "C" fn dhruva_fault_inject_alloc_arm(after_n: i64) -> i64;

// Shared, persistent scratch buffers -- see scratch_state.S's own doc
// comment for why these exist (dharafs_compact wasn't the only place a
// dhruva_alloc_bytes call was hiding inside something called every GC
// wake or every shell command instead of once at boot).
