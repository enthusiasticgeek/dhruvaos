  let _ = buf_write_byte(exp3, 23 as u32, 0x45 as u32);
  let _ = buf_write_byte(exp3, 24 as u32, 0x43 as u32);
  let _ = buf_write_byte(exp3, 25 as u32, 0xab as u32);
  let _ = buf_write_byte(exp3, 26 as u32, 0x16 as u32);
  let _ = buf_write_byte(exp3, 27 as u32, 0x6c as u32);
  let _ = buf_write_byte(exp3, 28 as u32, 0x54 as u32);
  let _ = buf_write_byte(exp3, 29 as u32, 0x15 as u32);
  let _ = buf_write_byte(exp3, 30 as u32, 0xec as u32);
  let _ = buf_write_byte(exp3, 31 as u32, 0x73 as u32);
  let _ = buf_write_byte(exp3, 32 as u32, 0x2e as u32);
  let _ = buf_write_byte(exp3, 33 as u32, 0xcb as u32);
  let _ = buf_write_byte(exp3, 34 as u32, 0xac as u32);
  let _ = buf_write_byte(exp3, 35 as u32, 0x7f as u32);
  let _ = buf_write_byte(exp3, 36 as u32, 0x48 as u32);
  let _ = buf_write_byte(exp3, 37 as u32, 0xa9 as u32);
  let _ = buf_write_byte(exp3, 38 as u32, 0xa7 as u32);
  let _ = buf_write_byte(exp3, 39 as u32, 0x18 as u32);
  let _ = buf_write_byte(exp3, 40 as u32, 0x56 as u32);
  let _ = buf_write_byte(exp3, 41 as u32, 0x0c as u32);
  let _ = buf_write_byte(exp3, 42 as u32, 0x8e as u32);
  let _ = buf_write_byte(exp3, 43 as u32, 0x37 as u32);
  let _ = buf_write_byte(exp3, 44 as u32, 0x84 as u32);
  let _ = buf_write_byte(exp3, 45 as u32, 0x8d as u32);
  let _ = buf_write_byte(exp3, 46 as u32, 0xce as u32);
  let _ = buf_write_byte(exp3, 47 as u32, 0xe5 as u32);
  let _ = buf_write_byte(exp3, 48 as u32, 0x96 as u32);
  let _ = buf_write_byte(exp3, 49 as u32, 0xea as u32);
  let _ = buf_write_byte(exp3, 50 as u32, 0xfb as u32);
  let _ = buf_write_byte(exp3, 51 as u32, 0xc8 as u32);
  let _ = buf_write_byte(exp3, 52 as u32, 0xa8 as u32);
  let _ = buf_write_byte(exp3, 53 as u32, 0x3d as u32);
  let _ = buf_write_byte(exp3, 54 as u32, 0x2c as u32);
  let _ = buf_write_byte(exp3, 55 as u32, 0x8b as u32);
  let _ = buf_write_byte(exp3, 56 as u32, 0x38 as u32);
  let _ = buf_write_byte(exp3, 57 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp3, 58 as u32, 0xe5 as u32);
  let _ = buf_write_byte(exp3, 59 as u32, 0xdd as u32);
  let _ = buf_write_byte(exp3, 60 as u32, 0x60 as u32);
  let _ = buf_write_byte(exp3, 61 as u32, 0xb1 as u32);
  let _ = buf_write_byte(exp3, 62 as u32, 0x36 as u32);
  let _ = buf_write_byte(exp3, 63 as u32, 0x2f as u32);
  if sha512_bytes_equal(out3, exp3, 64) == 0 {
    ok = 0;
  }

  let _ = uart_puts("CRYPTO: SHA-512 vs Python hashlib KATs (empty, \"abc\", 111-byte, 112-byte block-boundary)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Two checks: RFC 8439 section 2.3.2's own worked block-function
// example (a real external oracle -- the exact 64-byte keystream a
// correct implementation must produce for a fixed key/nonce/counter,
// byte-verified against this implementation on the host via a
// standalone spike before ever being ported into the kernel), and an
// encrypt-then-decrypt round trip (ChaCha20's own symmetric-XOR
// property -- applying the identical keystream twice must recover the
// original plaintext exactly), which exercises chacha20_encrypt's
// multi-block counter-increment logic the single-block KAT alone
// can't reach (the KAT is exactly one block; the round trip below
// spans three).
fn chacha20_self_test() -> i64 {
  let ok: i64 = 1;

  // RFC 8439 section 2.3.2's own worked example.
  let key: [u8; 32] = [
    0 as u8, 1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8, 6 as u8, 7 as u8,
    8 as u8, 9 as u8, 10 as u8, 11 as u8, 12 as u8, 13 as u8, 14 as u8, 15 as u8,
    16 as u8, 17 as u8, 18 as u8, 19 as u8, 20 as u8, 21 as u8, 22 as u8, 23 as u8,
    24 as u8, 25 as u8, 26 as u8, 27 as u8, 28 as u8, 29 as u8, 30 as u8, 31 as u8
  ];
  let nonce: [u8; 12] = [
    0 as u8, 0 as u8, 0 as u8, 9 as u8, 0 as u8, 0 as u8, 0 as u8, 0x4a as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let block_out: [u8; 64] = chacha20_block(ref key, 1 as u32, ref nonce);
  let expected: [u8; 64] = [
    16 as u8, 241 as u8, 231 as u8, 228 as u8, 209 as u8, 59 as u8, 89 as u8, 21 as u8, 80 as u8, 15 as u8, 221 as u8, 31 as u8,
    163 as u8, 32 as u8, 113 as u8, 196 as u8, 199 as u8, 209 as u8, 244 as u8, 199 as u8, 51 as u8, 192 as u8, 104 as u8, 3 as u8,
    4 as u8, 34 as u8, 170 as u8, 154 as u8, 195 as u8, 212 as u8, 108 as u8, 78 as u8, 210 as u8, 130 as u8, 100 as u8, 70 as u8,
    7 as u8, 159 as u8, 170 as u8, 9 as u8, 20 as u8, 194 as u8, 215 as u8, 5 as u8, 217 as u8, 139 as u8, 2 as u8, 162 as u8,
    181 as u8, 18 as u8, 156 as u8, 209 as u8, 222 as u8, 22 as u8, 78 as u8, 185 as u8, 203 as u8, 208 as u8, 131 as u8, 232 as u8,
    162 as u8, 80 as u8, 60 as u8, 78 as u8
  ];
  let bi: i64 = 0;
  while bi < 64 {
    if block_out[bi] != expected[bi] {
      ok = 0;
    }
    bi = bi + 1;
  }

  // Encrypt-then-decrypt round trip, 192 bytes (3 blocks) -- exercises
  // chacha20_encrypt's own counter-increment loop, which the 1-block
  // KAT above never touches.
  let msg_len: i64 = 192;
  let plaintext: [u8; 512] = cp_zero512_bytes();
  let pi: i64 = 0;
  while pi < msg_len {
    plaintext[pi] = ((pi * 7) & 0xFF) as u8;
    pi = pi + 1;
  }
  let ciphertext: [u8; 512] = chacha20_encrypt(ref key, ref nonce, 1 as u32, ref plaintext, msg_len);
  // A real ciphertext must not equal the plaintext byte-for-byte
  // (would indicate the XOR never actually happened).
  let same: i64 = 1;
  let ci: i64 = 0;
  while ci < msg_len {
    if ciphertext[ci] != plaintext[ci] {
      same = 0;
    }
    ci = ci + 1;
  }
  if same == 1 {
    ok = 0;
  }
  let decrypted: [u8; 512] = chacha20_encrypt(ref key, ref nonce, 1 as u32, ref ciphertext, msg_len);
  let di: i64 = 0;
  while di < msg_len {
    if decrypted[di] != plaintext[di] {
      ok = 0;
    }
    di = di + 1;
  }

  let _ = uart_puts("CRYPTO: ChaCha20 vs RFC 8439 KAT + 3-block encrypt/decrypt round trip");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// RFC 8439 section 2.5.2's own worked example -- a real external
// oracle, verified byte-exact before ever writing any vani code (see
// this function's own header comment above poly1305_mac for the full
// host-side spike methodology). Also checks: an altered message
// produces a DIFFERENT tag (the actual security property this
// primitive exists for -- a MAC that ignored its input would still
// pass a same-input KAT), and poly1305_verify_constant_time correctly
// accepts a matching tag and rejects a mismatched one.
fn poly1305_self_test() -> i64 {
  let ok: i64 = 1;

  // RFC 8439 section 2.5.2's own worked example.
  let key: [u8; 32] = [
    133 as u8, 214 as u8, 190 as u8, 120 as u8, 87 as u8, 85 as u8, 109 as u8, 51 as u8,
    127 as u8, 68 as u8, 82 as u8, 254 as u8, 66 as u8, 213 as u8, 6 as u8, 168 as u8,
    1 as u8, 3 as u8, 128 as u8, 138 as u8, 251 as u8, 13 as u8, 178 as u8, 253 as u8,
    74 as u8, 191 as u8, 246 as u8, 175 as u8, 65 as u8, 73 as u8, 245 as u8, 27 as u8
  ];
  let msg: [u8; 512] = cp_zero512_bytes();
  // "Cryptographic Forum Research Group" (35 bytes).
  msg[0] = 67 as u8; msg[1] = 114 as u8; msg[2] = 121 as u8; msg[3] = 112 as u8; msg[4] = 116 as u8;
  msg[5] = 111 as u8; msg[6] = 103 as u8; msg[7] = 114 as u8; msg[8] = 97 as u8; msg[9] = 112 as u8;
  msg[10] = 104 as u8; msg[11] = 105 as u8; msg[12] = 99 as u8; msg[13] = 32 as u8; msg[14] = 70 as u8;
  msg[15] = 111 as u8; msg[16] = 114 as u8; msg[17] = 117 as u8; msg[18] = 109 as u8; msg[19] = 32 as u8;
  msg[20] = 82 as u8; msg[21] = 101 as u8; msg[22] = 115 as u8; msg[23] = 101 as u8; msg[24] = 97 as u8;
  msg[25] = 114 as u8; msg[26] = 99 as u8; msg[27] = 104 as u8; msg[28] = 32 as u8; msg[29] = 71 as u8;
  msg[30] = 114 as u8; msg[31] = 111 as u8; msg[32] = 117 as u8; msg[33] = 112 as u8;
  let msg_len: i64 = 34;

  let expected: [u8; 16] = [
    168 as u8, 6 as u8, 29 as u8, 193 as u8, 48 as u8, 81 as u8, 54 as u8, 198 as u8,
    194 as u8, 43 as u8, 139 as u8, 175 as u8, 12 as u8, 1 as u8, 39 as u8, 169 as u8
  ];

  let tag: [u8; 16] = poly1305_mac(ref key, ref msg, msg_len);
  let ti: i64 = 0;
  while ti < 16 {
    if tag[ti] != expected[ti] {
      ok = 0;
    }
    ti = ti + 1;
  }
  if poly1305_verify_constant_time(ref tag, ref expected) == 0 {
    ok = 0;
  }

  // Empty-message edge case: h stays 0 the whole time, so mac must
  // equal s (key[16..32)) exactly -- a real, independently-derivable
  // expected value, not just "doesn't crash".
  let empty_tag: [u8; 16] = poly1305_mac(ref key, ref msg, 0);
  let ei: i64 = 0;
  while ei < 16 {
    if empty_tag[ei] != key[16 + ei] {
      ok = 0;
    }
    ei = ei + 1;
  }

  // Altered message must produce a DIFFERENT tag -- the actual
  // security property, not just "produces *a* tag".
  let msg2: [u8; 512] = cp_zero512_bytes();
  let m2i: i64 = 0;
  while m2i < msg_len {
    msg2[m2i] = msg[m2i];
    m2i = m2i + 1;
  }
  msg2[0] = msg2[0] ^ (1 as u8);
  let tag2: [u8; 16] = poly1305_mac(ref key, ref msg2, msg_len);
  let same: i64 = 1;
  let si: i64 = 0;
  while si < 16 {
    if tag2[si] != tag[si] {
      same = 0;
    }
    si = si + 1;
  }
  if same == 1 {
    ok = 0; // a single flipped bit produced the SAME tag -- broken
  }
  if poly1305_verify_constant_time(ref tag, ref tag2) == 1 {
    ok = 0; // constant-time verify incorrectly accepted a mismatched tag
  }

  let _ = uart_puts("CRYPTO: Poly1305 vs RFC 8439 KAT + altered-message + verify");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Media (at-rest) encryption for DharaFS's own on-disk blocks, layered
// on the existing ChaCha20 stream cipher above rather than adding a
// new cipher primitive (AES stays a separate, independent backlog
// item if ever wanted for spec/interop reasons -- there's no reason
// to block a working encryption feature on it when a real, KAT-
// verified cipher already exists). Hooked in at dharafs_block_read/
// dharafs_block_write -- the single, backend-agnostic (SDHOST/USB-MSD/
// host-virtual-disk) choke point round 36's own block-device
// abstraction created -- so every higher FS layer (checksums, headers,
// journaling, compaction, permissions) keeps operating on plaintext;
// only the physical bytes that actually reach storage are ciphertext.
//
// ROUND 69 UPDATE: the two-time-pad weakness described just below is
// FIXED, and this feature now has real tamper detection, both via the
// per-block metadata region introduced here. The original honest-
// limitation writeup is kept (next paragraph) as the historical
// record of exactly what was wrong and why, per this project's own
// documentation discipline -- see dharafs_crypto_encrypt_block/
// decrypt_block below for the actual current scheme.
//
// ORIGINAL (round 62) design: nonce = 12 bytes, all zero except the
// low 4 bytes holding block_num (big-endian) -- unique per block
// under a fixed key, matching a classic sector-tweak scheme. HONEST,
// DELIBERATE LIMITATION (not an oversight): because the nonce was a
// pure function of block_num, not a fresh value per WRITE, overwriting
// the SAME block twice under the SAME key reused the SAME keystream --
// an attacker holding two on-disk snapshots of that block could
// recover plaintext_old XOR plaintext_new (the classic stream-cipher
// "two-time pad" problem). There was also no MAC/tag anywhere, so a
// bit-flipped or swapped on-disk block decrypted "successfully" into
// silent garbage instead of being detected.
//
// Off by default (dharafs_crypto_enabled starts at 0): every existing
// test (phase4_milestone.py, heap_stress.py, power_yank.py, the host
// harness) keeps running against plaintext blocks completely
// unchanged unless something explicitly turns this on -- matching
// round 36's own dharafs_block_dev toggle precedent.

// Per-block AEAD metadata (write-counter + Poly1305 tag): fixes both
// weaknesses above at once. A dedicated region starting at block 4000
// (clear of DharaFS's own log region, blocks 1-2048, and the pre-
// existing self-check's own test_block=3000), 16 fixed 32-byte
// entries packed per 512-byte sector -- one entry per tracked data
// block: 4-byte write-counter (big-endian) + 4-byte magic ("DHAC",
// distinguishes a real entry from an uninitialized/garbage sector on
// a fresh or foreign SD card) + 16-byte tag + 8 reserved bytes. A
// missing/absent-magic entry means "this block has never been AEAD-
// protected" (predates encryption being turned on, or was written
// while it was off) -- the read path falls through to plain
// passthrough for it rather than rejecting genuine, pre-existing
// plaintext. This metadata is itself stored in the clear (it holds no
// secret, only a public counter and a MAC tag) -- keeping it
// unencrypted avoids a chicken-and-egg dependency on itself.
fn dharafs_crypto_meta_sector_for(block_num: i64) -> i64 {
  return 4000 + (block_num / 16);
}

fn dharafs_crypto_meta_offset_for(block_num: i64) -> i64 {
  return (block_num % 16) * 32;
}

// Returns the block's current write-counter, or 0 if this block has
// never been AEAD-protected (no entry, or a garbage/foreign sector
// whose magic doesn't match).
fn dharafs_crypto_meta_read_counter(block_num: i64) -> i64 {
  let sector: mut ref i64 = dharafs_crypto_meta_sector_scratch_ptr();
  let status: i64 = dharafs_block_read_raw(dharafs_crypto_meta_sector_for(block_num), sector);
  if status != 0 {
    return 0;
  }
  let off: i64 = dharafs_crypto_meta_offset_for(block_num);
  let magic: u32 = buf_read_u32_be(sector, off + 4);
  if magic != (0x44484143 as u32) {
    return 0;
  }
  return buf_read_u32_be(sector, off) as i64;
}

// Reads the block's stored tag into out_tag (16 bytes). Only
// meaningful when dharafs_crypto_meta_read_counter(block_num) != 0 --
// callers must check that first.
fn dharafs_crypto_meta_read_tag(block_num: i64, out_tag: mut ref i64) -> i64 {
  let sector: mut ref i64 = dharafs_crypto_meta_sector_scratch_ptr();
  let status: i64 = dharafs_block_read_raw(dharafs_crypto_meta_sector_for(block_num), sector);
  if status != 0 {
    return status;
  }
  let off: i64 = dharafs_crypto_meta_offset_for(block_num);
  let i: i64 = 0;
  while i < 16 {
    let _ = buf_write_byte(out_tag, i as u32, buf_read_byte(sector, (off + 8 + i) as u32));
    i = i + 1;
  }
  return 0;
}

// Read-modify-write: updates one 32-byte entry within its 512-byte
// metadata sector, leaving the other 15 entries in that sector
// untouched. Zeroes the sector first on its very first use (read
// failure) rather than writing a new entry through uninitialized
// storage that would corrupt the other 15 slots.
fn dharafs_crypto_meta_write_entry(block_num: i64, counter: i64, tag: mut ref i64) -> i64 {
  let sector: mut ref i64 = dharafs_crypto_meta_sector_scratch_ptr();
  let sector_num: i64 = dharafs_crypto_meta_sector_for(block_num);
  let read_status: i64 = dharafs_block_read_raw(sector_num, sector);
  if read_status != 0 {
    let z: i64 = 0;
    while z < 512 {
      let _ = buf_write_byte(sector, z as u32, 0 as u32);
      z = z + 1;
    }
  }
  let off: i64 = dharafs_crypto_meta_offset_for(block_num);
  let _ = buf_write_u32_be(sector, off, counter as u32);
  let _ = buf_write_u32_be(sector, off + 4, 0x44484143 as u32);
  let i: i64 = 0;
  while i < 16 {
    let _ = buf_write_byte(sector, (off + 8 + i) as u32, buf_read_byte(tag, i as u32));
    i = i + 1;
  }
  return dharafs_block_write_raw(sector_num, sector);
}

// Derives the 32-byte media-encryption key via PBKDF2-HMAC-SHA256 from
// a fixed passphrase -- this project has no hardware key store/TPM
// (same honest limitation as auth's own salts and the DHCP client's
// own xid). Runs once at boot, single-threaded, before
// start_multitasking -- outside the still-not-fully-root-caused long-
// running-computation bug's own observed conditions (that bug has only
// ever been observed under the REAL post-multitasking scheduler), so a
// real, security-appropriate iteration count is safe to use here,
// unlike pbkdf2_auth_iterations's own per-request, in-shell call.
fn dharafs_crypto_key_init() -> i64 {
  let passphrase: mut ref i64 = dharafs_crypto_scratch_ptr();
  let pass_len: i64 = str_len_bytes("dhruva-media-encryption-key-v1");
  let _ = str_copy_to_buf("dhruva-media-encryption-key-v1", passphrase);
  let salt: mut ref i64 = dharafs_crypto_keystream_ptr(); // scratch; overwritten on first real use
  let salt_len: i64 = str_len_bytes("dhruva-dharafs-media-salt");
  let _ = str_copy_to_buf("dhruva-dharafs-media-salt", salt);
  let key: mut ref i64 = dharafs_crypto_key_ptr();
  let _ = pbkdf2_hmac_sha256(passphrase, pass_len, salt, salt_len, 10000, key);
  return 0;
}

// Encrypts one 512-byte block for on-disk storage with ChaCha20-
// Poly1305 AEAD. Nonce = block_num (4 bytes, BE) || per-block write-
// counter (4 bytes, BE, read from and re-persisted to the metadata
// region, incremented on every call) || 4 zero bytes -- unlike the
// original scheme, the SAME block written twice now gets a DIFFERENT
// nonce each time (the counter always advances), closing the two-
// time-pad weakness documented above. AAD = block_num (8 bytes, BE,
// zero-padded) -- binds the tag to this specific block number, so an
// attacker can't undetectably move a valid ciphertext+tag pair from
// one block to another. Persists the new counter and tag to the
// metadata region as part of this same call; a caller never touches
// metadata directly.
fn dharafs_crypto_encrypt_block(block_num: i64, plaintext: mut ref i64, out_ciphertext: mut ref i64) -> i64 {
  let counter: i64 = dharafs_crypto_meta_read_counter(block_num) + 1;

  let nonce: mut ref i64 = dharafs_crypto_nonce_ptr();
  let _ = buf_write_u32_be(nonce, 0, block_num as u32);
  let _ = buf_write_u32_be(nonce, 4, counter as u32);
  let _ = buf_write_u32_be(nonce, 8, 0 as u32);

  let aad: mut ref i64 = dharafs_crypto_aad_scratch_ptr();
  let _ = buf_write_u32_be(aad, 0, 0 as u32);
  let _ = buf_write_u32_be(aad, 4, block_num as u32);

  let key: mut ref i64 = dharafs_crypto_key_ptr();
  let tag: mut ref i64 = dharafs_crypto_tag_scratch_ptr();

  let _ = chacha20_poly1305_encrypt_heap(key, nonce, aad, 8, plaintext, 512, out_ciphertext, tag);

  return dharafs_crypto_meta_write_entry(block_num, counter, tag);
}

// Decrypts one 512-byte on-disk block. Fails CLOSED: returns -1 (and
// leaves out_plaintext untouched) on ANY tag mismatch, whether from
// real corruption or deliberate tampering -- "reject, don't guess,"
// matching chacha20_poly1305_decrypt's own posture and this
// codebase's other integrity checks. A write-counter of 0 (no
// metadata entry, or a garbage/foreign sector) is a deliberate,
// honest exception, not a failure: it means this block was never
// AEAD-protected (predates encryption being enabled, or was written
// while it was off), so there is no tag to check, and the bytes are
// passed through unchanged as plaintext -- matching dharafs_block_
// read/write's own pre-existing "encryption off" passthrough for the
// not-yet-encrypted portion of a disk.
fn dharafs_crypto_decrypt_block(block_num: i64, ciphertext: mut ref i64, out_plaintext: mut ref i64) -> i64 {
  let counter: i64 = dharafs_crypto_meta_read_counter(block_num);
  if counter == 0 {
    let i: i64 = 0;
    while i < 512 {
      let _ = buf_write_byte(out_plaintext, i as u32, buf_read_byte(ciphertext, i as u32));
      i = i + 1;
    }
    return 0;
  }

  let tag: mut ref i64 = dharafs_crypto_tag_scratch_ptr();
  let meta_status: i64 = dharafs_crypto_meta_read_tag(block_num, tag);
  if meta_status != 0 {
    return 0 - 1;
  }

  let nonce: mut ref i64 = dharafs_crypto_nonce_ptr();
  let _ = buf_write_u32_be(nonce, 0, block_num as u32);
  let _ = buf_write_u32_be(nonce, 4, counter as u32);
  let _ = buf_write_u32_be(nonce, 8, 0 as u32);

  let aad: mut ref i64 = dharafs_crypto_aad_scratch_ptr();
  let _ = buf_write_u32_be(aad, 0, 0 as u32);
  let _ = buf_write_u32_be(aad, 4, block_num as u32);

  let key: mut ref i64 = dharafs_crypto_key_ptr();

  return chacha20_poly1305_decrypt_heap(key, nonce, aad, 8, ciphertext, 512, tag, out_plaintext);
}

// An earlier version of this self-check only exercised the bare
// transform in memory -- no dharafs_block_write, no sdhost_read_block,
// no real SD access at all -- because an even earlier attempt to
// exercise the real SD path found a genuine, serious, PRE-EXISTING
// bug: doing even ONE extra real SD block read or write during boot
// intermittently (~20-30%) left some later, unrelated state
// corrupted, surfacing minutes later as a genuine Data Abort deep
// inside task_e's own background DharaFS compaction. NOT a bug in
// this feature's own crypto logic -- a real, general, timing-
// dependent hazard in the existing SD/boot-sequencing code, the same
// "IRQ lands at an unlucky moment" bug class as the task_f runtime-
// trap investigation.
//
// ROUND 66 (2026-09-01): the hazard above is fixed (round 65's task_f
// fix turned out to fix this SD-corruption bug too, as a side effect,
// confirmed via 20/20 clean repro boots), so the real SD path is
// exercised on every boot below rather than only checked manually.
//
// ROUND 69 (2026-09-04): rewritten for the AEAD upgrade -- covers (1)
// a basic encrypt/decrypt round trip, (2) the two-time-pad fix
// (writing the SAME block twice now produces two DIFFERENT
// ciphertexts, because the per-block counter advances), (3) tamper
// detection (a corrupted on-disk block/tag is REJECTED, not silently
// "decrypted" into garbage), and (4) the real, backend-integrated SD
// round trip via dharafs_block_write/dharafs_block_read. Crypto-
// enabled state is saved and restored around all of this so a normal
// boot's OWN encryption setting (off, by default, today) is
// unaffected once this self-check returns.
fn dharafs_encryption_self_check() -> i64 {
  let ok: i64 = 1;
  let test_block: i64 = 3000;
  let plaintext: mut ref i64 = dhruva_alloc_bytes(512);
  let i: i64 = 0;
  while i < 512 {
    let _ = buf_write_byte(plaintext, i as u32, ((i * 7 + 11) & 255) as u32);
    i = i + 1;
  }

  let ciphertext: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = dharafs_crypto_encrypt_block(test_block, plaintext, ciphertext);
  if chacha20_bytes_equal(ciphertext, plaintext, 512) == 1 {
    // AEAD encrypt is the identity on this input -- encryption did
    // NOT actually happen; this would be a real bug, not a pass.
    ok = 0;
  }

  let decrypted: mut ref i64 = dhruva_alloc_bytes(512);
  let decrypt_status: i64 = dharafs_crypto_decrypt_block(test_block, ciphertext, decrypted);
  if (decrypt_status != 0) || (chacha20_bytes_equal(decrypted, plaintext, 512) == 0) {
    ok = 0;
  }

  let _ = uart_puts("CRYPTO: DharaFS AEAD encrypt/decrypt round trip (in-memory: ciphertext != plaintext, decrypt reproduces plaintext)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }

  // Two-time-pad fix: encrypt the SAME plaintext into the SAME block
  // a second time. Under the old scheme (nonce = f(block_num) only)
  // this would reproduce the exact same ciphertext; the per-block
  // write-counter now in the nonce must make it differ.
  let ciphertext2: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = dharafs_crypto_encrypt_block(test_block, plaintext, ciphertext2);
  let two_time_pad_fixed: i64 = if chacha20_bytes_equal(ciphertext, ciphertext2, 512) == 0 { 1 } else { 0 };
  let decrypted2: mut ref i64 = dhruva_alloc_bytes(512);
  let decrypt2_status: i64 = dharafs_crypto_decrypt_block(test_block, ciphertext2, decrypted2);
  if (decrypt2_status != 0) || (chacha20_bytes_equal(decrypted2, plaintext, 512) == 0) {
    two_time_pad_fixed = 0;
  }

  let _ = uart_puts("CRYPTO: DharaFS two-time-pad fix (same block written twice yields different ciphertext, both still decrypt correctly)");
  if two_time_pad_fixed == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }

  // Tamper detection: flip one bit in the ciphertext and confirm
  // decrypt_block fails CLOSED (-1), never returning corrupted bytes
  // as if they were trustworthy plaintext.
  let tampered: mut ref i64 = dhruva_alloc_bytes(512);
  let t: i64 = 0;
  while t < 512 {
    let _ = buf_write_byte(tampered, t as u32, buf_read_byte(ciphertext2, t as u32));
    t = t + 1;
  }
  let _ = buf_write_byte(tampered, 0 as u32, (buf_read_byte(tampered, 0 as u32) ^ (1 as u32)) & (255 as u32));
  let tampered_out: mut ref i64 = dhruva_alloc_bytes(512);
  let tamper_status: i64 = dharafs_crypto_decrypt_block(test_block, tampered, tampered_out);
  let tamper_ok: i64 = if tamper_status != 0 { 1 } else { 0 };

  let _ = uart_puts("CRYPTO: DharaFS tamper detection (corrupted ciphertext is rejected, not silently decrypted)");
  if tamper_ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }

  let sd_ok: i64 = 1;
  let prev_enabled: u32 = dharafs_crypto_get_enabled();
  let _ = dharafs_crypto_set_enabled(1 as u32);

  let write_status: i64 = dharafs_block_write(test_block, plaintext);
  if write_status != 0 {
    sd_ok = 0;
  }

  let raw_readback: mut ref i64 = dhruva_alloc_bytes(512);
  let raw_status: i64 = dharafs_block_read_raw(test_block, raw_readback);
  if (raw_status != 0) || (chacha20_bytes_equal(raw_readback, plaintext, 512) == 1) {
    // On-disk bytes came back readable, or came back identical to
    // plaintext -- either way, real encryption-at-rest didn't happen.
    sd_ok = 0;
  }

  let sd_readback: mut ref i64 = dhruva_alloc_bytes(512);
  let read_status: i64 = dharafs_block_read(test_block, sd_readback);
  if (read_status != 0) || (chacha20_bytes_equal(sd_readback, plaintext, 512) == 0) {
    sd_ok = 0;
  }

  // Corrupt the real on-disk block directly (bypassing the crypto
  // layer, as a real bit-flip or tampering attempt would) and confirm
  // dharafs_block_read -- the actual path every FS read uses --
  // fails closed instead of handing back garbage as if it were valid.
  let on_disk_corrupt: mut ref i64 = dhruva_alloc_bytes(512);
  let c: i64 = 0;
  while c < 512 {
    let _ = buf_write_byte(on_disk_corrupt, c as u32, buf_read_byte(raw_readback, c as u32));
    c = c + 1;
  }
  let _ = buf_write_byte(on_disk_corrupt, 0 as u32, (buf_read_byte(on_disk_corrupt, 0 as u32) ^ (1 as u32)) & (255 as u32));
  let _ = dharafs_block_write_raw(test_block, on_disk_corrupt);
  let corrupt_readback: mut ref i64 = dhruva_alloc_bytes(512);
  let corrupt_read_status: i64 = dharafs_block_read(test_block, corrupt_readback);
  if corrupt_read_status == 0 {
    sd_ok = 0;
  }

  let _ = dharafs_crypto_set_enabled(prev_enabled);

  let _ = uart_puts("CRYPTO: DharaFS media encryption real SD round trip (on-disk bytes != plaintext, decrypt reproduces plaintext, corrupted on-disk block is rejected)");
  if sd_ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 62 (fault-injection framework completion): checks and
// decrements a fault-injection countdown, returning 1 exactly on the
// call where it reaches 0 (the "inject now" signal), matching round
// 51's own dhruva_fault_inject_alloc_arm contract. 0 (disarmed) always
// returns 0. Shared shape for all three of write/irqburst/netdrop
// below -- each has its own get/set pair (boot/fault_inject_state.S)
// since vani has no way to pass "a reference to a specific global
// counter" as an argument.
fn fault_write_maybe_inject() -> u32 {
  let c: u32 = fault_write_countdown_get();
  if c == (0 as u32) {
    return 0 as u32;
  }
  let c2: u32 = c - (1 as u32);
  let _ = fault_write_countdown_set(c2);
  if c2 == (0 as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

// Different shape from the "Nth call" pattern above: irqburst has no
// analogous "Nth tick" concept worth having (a burst is logically
// "right now"), so `fault irqburst <n>` arms the burst SIZE directly,
// takes effect on the very next real timer tick, and self-disarms.
// Safe to read-then-clear in two steps rather than a single atomic
// op: this is only ever called from irq_dispatch, and this single-
// core system only ever runs one IRQ at a time.
fn fault_irqburst_take() -> u32 {
  let n: u32 = fault_irqburst_countdown_get();
  if n > (0 as u32) {
    let _ = fault_irqburst_countdown_set(0 as u32);
  }
  return n;
}

fn fault_netdrop_maybe_inject() -> u32 {
  let c: u32 = fault_netdrop_countdown_get();
  if c == (0 as u32) {
    return 0 as u32;
  }
  let c2: u32 = c - (1 as u32);
  let _ = fault_netdrop_countdown_set(c2);
  if c2 == (0 as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

// Round 100 -- X25519 (and the bignum/field25519 foundation it and
// Ed25519 both used) migrated to the shared `curve25519` kosh
// package -- same migration as Ed25519 above, same reasoning. Deleted
// this file's own bignum foundation (bignum_add_raw/sub_raw/mul_raw/
// mul_small_raw/shl1_raw/cmp_raw/limbs_equal/set_limbs4/self_test)
// and field25519 arithmetic (field25519_init/get_bit/add/sub/
// reduce16/mul/sqr/invert) and x25519_clamp_scalar -- all internal-
// only, zero external callers, all now living in `curve25519/src/
// core.vani` instead (already `use`d above, for Ed25519 -- one `use`
// covers both, since they're one package).
//
// `x25519_scalarmult` kept as a `_heap`-suffixed adapter (11 external
// TLS 1.3 call sites updated to the new name -- see those call
// sites' own diffs), same collision reasoning as Ed25519's own
// adapters above. `x25519_self_test` keeps its ORIGINAL name --
// `core.vani` excludes its own same-named self-test, so no collision.
fn x25519_scalarmult_heap(k: mut ref i64, u_in: mut ref i64, out: mut ref i64) -> i64 {
  let k_arr: [u8; 32] = ed25519_zero32_bytes();
  let i: i64 = 0;
  while i < 32 {
    k_arr[i] = buf_read_byte(k, i as u32) as u8;
    i = i + 1;
  }
  let u_arr: [u8; 32] = ed25519_zero32_bytes();
  let ui: i64 = 0;
  while ui < 32 {
    u_arr[ui] = buf_read_byte(u_in, ui as u32) as u8;
    ui = ui + 1;
  }
  let out_arr: [u8; 32] = x25519_scalarmult(ref k_arr, ref u_arr);
  let j: i64 = 0;
  while j < 32 {
    let _ = buf_write_byte(out, j as u32, out_arr[j] as u32);
    j = j + 1;
  }
  return 0;
}

// RFC 7748-shaped known-answer check against a real, independently-
// verified (cryptography library) run -- same discipline as Ed25519's
// own self-test.
fn x25519_self_test() -> i64 {
  let ok: i64 = 1;

  // Test 1: base-point scalar multiplication (public key derivation).
  // k, expected1 generated by a real, independently-verified Python
  // run (see this section's own header comment) -- not typed from an
  // external document.
  let k: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(k, 0 as u32, 0x60 as u32);
  let _ = buf_write_byte(k, 1 as u32, 0xb7 as u32);
  let _ = buf_write_byte(k, 2 as u32, 0xb2 as u32);
  let _ = buf_write_byte(k, 3 as u32, 0xc0 as u32);
  let _ = buf_write_byte(k, 4 as u32, 0xd9 as u32);
  let _ = buf_write_byte(k, 5 as u32, 0x51 as u32);
  let _ = buf_write_byte(k, 6 as u32, 0x1c as u32);
  let _ = buf_write_byte(k, 7 as u32, 0xbd as u32);
  let _ = buf_write_byte(k, 8 as u32, 0x53 as u32);
  let _ = buf_write_byte(k, 9 as u32, 0x2b as u32);
  let _ = buf_write_byte(k, 10 as u32, 0xda as u32);
  let _ = buf_write_byte(k, 11 as u32, 0xdd as u32);
  let _ = buf_write_byte(k, 12 as u32, 0xdf as u32);
  let _ = buf_write_byte(k, 13 as u32, 0xd5 as u32);
  let _ = buf_write_byte(k, 14 as u32, 0xb5 as u32);
  let _ = buf_write_byte(k, 15 as u32, 0xa8 as u32);
  let _ = buf_write_byte(k, 16 as u32, 0x5d as u32);
  let _ = buf_write_byte(k, 17 as u32, 0x0b as u32);
  let _ = buf_write_byte(k, 18 as u32, 0x49 as u32);
  let _ = buf_write_byte(k, 19 as u32, 0xab as u32);
  let _ = buf_write_byte(k, 20 as u32, 0x55 as u32);
  let _ = buf_write_byte(k, 21 as u32, 0x03 as u32);
  let _ = buf_write_byte(k, 22 as u32, 0x9f as u32);
  let _ = buf_write_byte(k, 23 as u32, 0xd3 as u32);
  let _ = buf_write_byte(k, 24 as u32, 0x21 as u32);
  let _ = buf_write_byte(k, 25 as u32, 0xba as u32);
  let _ = buf_write_byte(k, 26 as u32, 0x87 as u32);
  let _ = buf_write_byte(k, 27 as u32, 0xda as u32);
  let _ = buf_write_byte(k, 28 as u32, 0xe8 as u32);
  let _ = buf_write_byte(k, 29 as u32, 0x63 as u32);
  let _ = buf_write_byte(k, 30 as u32, 0x8e as u32);
  let _ = buf_write_byte(k, 31 as u32, 0x4c as u32);

  let basepoint: mut ref i64 = dhruva_alloc_bytes(32);
  let bi: i64 = 0;
  while bi < 32 {
    let _ = buf_write_byte(basepoint, bi as u32, 0 as u32);
    bi = bi + 1;
  }
  let _ = buf_write_byte(basepoint, 0 as u32, 9 as u32);

  let expected1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(expected1, 0 as u32, 0xe0 as u32);
  let _ = buf_write_byte(expected1, 1 as u32, 0x7a as u32);
  let _ = buf_write_byte(expected1, 2 as u32, 0xe4 as u32);
  let _ = buf_write_byte(expected1, 3 as u32, 0x20 as u32);
  let _ = buf_write_byte(expected1, 4 as u32, 0x24 as u32);
  let _ = buf_write_byte(expected1, 5 as u32, 0x0d as u32);
  let _ = buf_write_byte(expected1, 6 as u32, 0x20 as u32);
  let _ = buf_write_byte(expected1, 7 as u32, 0xa2 as u32);
