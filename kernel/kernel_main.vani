  let _ = buf_write_byte(expected_prk, 31 as u32, 0xc5 as u32);
  if chacha20_bytes_equal(prk_out, expected_prk, 32) == 0 {
    ok = 0;
  }

  let t_scratch: mut ref i64 = hkdf_t_scratch_get();
  let hmac_input_scratch: mut ref i64 = hkdf_hmac_input_scratch_get();
  let okm_out: mut ref i64 = dhruva_alloc_bytes(48);
  let _ = hkdf_expand(prk_out, 32, info, info_len, 48, t_scratch, hmac_input_scratch, okm_out);
  let expected_okm: mut ref i64 = dhruva_alloc_bytes(48);
  let _ = buf_write_byte(expected_okm, 0 as u32, 0xa6 as u32);
