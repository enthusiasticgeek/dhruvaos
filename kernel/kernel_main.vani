  let _ = buf_write_byte(expected_okm, 45 as u32, 0xa1 as u32);
  let _ = buf_write_byte(expected_okm, 46 as u32, 0x8f as u32);
  let _ = buf_write_byte(expected_okm, 47 as u32, 0xc4 as u32);
  if chacha20_bytes_equal(okm_out, expected_okm, 48) == 0 {
    ok = 0;
  }

  let _ = uart_puts("CRYPTO: ChaCha20-Poly1305 AEAD + HKDF vs a real, independently-verified reference");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

fn keccak_init() -> i64 {
  let rc: mut ref i64 = keccak_rc_get();
  let _ = buf_write_u32(rc, 0 as u32, 0x00000001 as u32);
  let _ = buf_write_u32(rc, 4 as u32, 0x00000000 as u32);
  let _ = buf_write_u32(rc, 8 as u32, 0x00008082 as u32);
  let _ = buf_write_u32(rc, 12 as u32, 0x00000000 as u32);
  let _ = buf_write_u32(rc, 16 as u32, 0x0000808a as u32);
