  if keccak_bytes_equal(out4, exp4, 32) == 0 { ok = 0; }

  // A longer message crossing multiple rate-sized blocks for the
  // smallest rate variant (SHA3-512, rate=72) -- 150 bytes needs 3
  // absorb blocks, exercising the multi-block absorb loop the
  // single-block "abc" cases above never touch.
  let long_str: Str = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps ov";
  let long_len: i64 = str_len_bytes(long_str);
  let long_msg: mut ref i64 = dhruva_alloc_bytes(long_len);
  let li: i64 = 0;
  while li < long_len {
    let _ = buf_write_byte(long_msg, li as u32, str_byte_at(long_str, li) as u32);
    li = li + 1;
  }
  let out5: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = sha3_512_hash(long_msg, long_len, out5);
  // No external oracle needed for this one beyond internal
  // consistency: hashing the SAME long message twice must produce
  // the SAME digest (rules out any state-not-reset-between-calls bug
  // the single-block cases above wouldn't expose).
  let out5b: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = sha3_512_hash(long_msg, long_len, out5b);
  if keccak_bytes_equal(out5, out5b, 64) == 0 { ok = 0; }
  // And it must differ from the short "abc" digest.
  if keccak_bytes_equal(out5, exp2, 64) == 1 { ok = 0; }

  let _ = uart_puts("CRYPTO: Keccak/SHA3-256/SHA3-512/SHAKE128/SHAKE256 vs Python hashlib KATs");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}





// Signed with the private key matching pki_init's own compile-time-
// pinned public key -- generated once via the same verified Python
// run as ed25519_self_test's own vector (see that function's header
// comment for the full methodology), the PRIVATE key itself never
// appears anywhere in this codebase, matching real trust-anchor
// provisioning practice (only the public half is ever baked in).
fn mlkem_init() -> i64 {
  let zetas: mut ref i64 = mlkem_zetas_get();
  let _ = buf_write_u32(zetas, 0 as u32, 1 as u32);
