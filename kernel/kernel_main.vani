  let _ = buf_write_byte(expected_ct, 4 as u32, 0x5f as u32);
  let _ = buf_write_byte(expected_ct, 5 as u32, 0x76 as u32);
  let _ = buf_write_byte(expected_ct, 6 as u32, 0x85 as u32);
  let _ = buf_write_byte(expected_ct, 7 as u32, 0x14 as u32);
  let _ = buf_write_byte(expected_ct, 8 as u32, 0xfb as u32);
