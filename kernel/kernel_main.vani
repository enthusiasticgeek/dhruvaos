  let _ = buf_write_byte(key, 28 as u32, 0x1c as u32);
  let _ = buf_write_byte(key, 29 as u32, 0x1d as u32);
  let _ = buf_write_byte(key, 30 as u32, 0x1e as u32);
  let _ = buf_write_byte(key, 31 as u32, 0x1f as u32);
  let nonce: mut ref i64 = dhruva_alloc_bytes(12);
  let _ = buf_write_byte(nonce, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(nonce, 1 as u32, 0x01 as u32);
  let _ = buf_write_byte(nonce, 2 as u32, 0x02 as u32);
  let _ = buf_write_byte(nonce, 3 as u32, 0x03 as u32);
  let _ = buf_write_byte(nonce, 4 as u32, 0x04 as u32);
  let _ = buf_write_byte(nonce, 5 as u32, 0x05 as u32);
  let _ = buf_write_byte(nonce, 6 as u32, 0x06 as u32);
  let _ = buf_write_byte(nonce, 7 as u32, 0x07 as u32);
  let _ = buf_write_byte(nonce, 8 as u32, 0x08 as u32);
  let _ = buf_write_byte(nonce, 9 as u32, 0x09 as u32);
  let _ = buf_write_byte(nonce, 10 as u32, 0x0a as u32);
  let _ = buf_write_byte(nonce, 11 as u32, 0x0b as u32);
  let aad: mut ref i64 = dhruva_alloc_bytes(6);
  let _ = buf_write_byte(aad, 0 as u32, 0x68 as u32);
  let _ = buf_write_byte(aad, 1 as u32, 0x65 as u32);
  let _ = buf_write_byte(aad, 2 as u32, 0x61 as u32);
  let _ = buf_write_byte(aad, 3 as u32, 0x64 as u32);
  let _ = buf_write_byte(aad, 4 as u32, 0x65 as u32);
  let _ = buf_write_byte(aad, 5 as u32, 0x72 as u32);

  let plaintext_str: Str = "Dhruva TLS-shaped AEAD test payload, exercising the pad16 boundary too!";
  let plaintext_len: i64 = str_len_bytes(plaintext_str);
  let plaintext: mut ref i64 = dhruva_alloc_bytes(plaintext_len);
  let pi: i64 = 0;
  while pi < plaintext_len {
    let _ = buf_write_byte(plaintext, pi as u32, str_byte_at(plaintext_str, pi) as u32);
    pi = pi + 1;
