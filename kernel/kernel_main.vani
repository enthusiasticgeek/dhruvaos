  let _ = buf_write_byte(expected_ct, 12 as u32, 0xf0 as u32);
  let _ = buf_write_byte(expected_ct, 13 as u32, 0x7c as u32);
  let _ = buf_write_byte(expected_ct, 14 as u32, 0x7e as u32);
  let _ = buf_write_byte(expected_ct, 15 as u32, 0x06 as u32);
  let _ = buf_write_byte(expected_ct, 16 as u32, 0xad as u32);
  let _ = buf_write_byte(expected_ct, 17 as u32, 0x50 as u32);
  let _ = buf_write_byte(expected_ct, 18 as u32, 0xf3 as u32);
  let _ = buf_write_byte(expected_ct, 19 as u32, 0xa2 as u32);
  let _ = buf_write_byte(expected_ct, 20 as u32, 0x10 as u32);
  let _ = buf_write_byte(expected_ct, 21 as u32, 0x30 as u32);
  let _ = buf_write_byte(expected_ct, 22 as u32, 0x8d as u32);
  let _ = buf_write_byte(expected_ct, 23 as u32, 0xcd as u32);
  let _ = buf_write_byte(expected_ct, 24 as u32, 0x83 as u32);
  let _ = buf_write_byte(expected_ct, 25 as u32, 0xe4 as u32);
  let _ = buf_write_byte(expected_ct, 26 as u32, 0x5b as u32);
  let _ = buf_write_byte(expected_ct, 27 as u32, 0xe5 as u32);
  let _ = buf_write_byte(expected_ct, 28 as u32, 0x05 as u32);
  let _ = buf_write_byte(expected_ct, 29 as u32, 0xa1 as u32);
