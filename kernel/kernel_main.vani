  let _ = buf_write_byte(expected1, 9 as u32, 0xf3 as u32);
  let _ = buf_write_byte(expected1, 10 as u32, 0xc1 as u32);
  let _ = buf_write_byte(expected1, 11 as u32, 0x96 as u32);
  let _ = buf_write_byte(expected1, 12 as u32, 0xf7 as u32);
  let _ = buf_write_byte(expected1, 13 as u32, 0x3b as u32);
