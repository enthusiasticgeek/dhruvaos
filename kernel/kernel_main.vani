extern "C" fn gatt_char_set_properties_at(index: u32, value: u32) -> i64;
extern "C" fn gatt_char_get_value_handle_at(index: u32) -> i64;
extern "C" fn gatt_char_set_value_handle_at(index: u32, value: u32) -> i64;
extern "C" fn gatt_char_get_uuid16_at(index: u32) -> i64;
extern "C" fn gatt_char_set_uuid16_at(index: u32, value: u32) -> i64;
