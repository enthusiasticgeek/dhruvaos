fn delay(count: i64) -> i64 {
  let i: i64 = 0;
  while i < count {
    i = i + 1;
  }
  return 0;
}

// GPIO alt-function setup for UART0 TXD/RXD on pins 14/15 (BCM2835).
// Real hardware needs this before the PL011 UART will actually drive
// the pins; QEMU's emulated PL011 likely doesn't care, but doing it
// right from the start means this same code works unmodified when this
// boots on the real Model B, not just under QEMU.
fn gpio_uart_alt_init() -> i64 {
  let gpfsel1: i64 = GPFSEL1;
  let gppud: i64 = GPPUD;
  let gppudclk0: i64 = GPPUDCLK0;

  let ra: u32 = mmio_read_u32(gpfsel1);
  // Clear bits 12-17 (pin14 + pin15 function-select fields), then set
  // both to ALT0 (0b100) -- UART0 TXD/RXD.
  let clear_mask: u32 = 0xFFFC0FFF as u32;
  let alt0_bits: u32 = 0x00024000 as u32;
  let ra2: u32 = (ra & clear_mask) | alt0_bits;
  let _ = mmio_write_u32(gpfsel1, ra2);

  let _ = mmio_write_u32(gppud, 0 as u32);
  let _ = delay(150);
  let _ = mmio_write_u32(gppudclk0, 0x0000C000 as u32);
  let _ = delay(150);
  let _ = mmio_write_u32(gppudclk0, 0 as u32);
  return 0;
}

// Round 71: general-purpose GPIO -- direct BCM2835 register access,
// the same "no dedicated state file, just mmio_read/write_u32 with a
// literal peripheral address" pattern gpio_uart_alt_init above already
// established for pin muxing. This is the first PUBLIC-facing use of
// this peripheral (a `gpio` shell command, not just internal setup for
// another peripheral), covering pins 0-53 (the SoC's full real
// register width -- which of those a specific Pi board's header
// actually exposes is a wiring question, not this code's concern).
//
// Real-hardware safety note, not enforced in code: pins 14/15 are the
// console UART (gpio_uart_alt_init above) and 48-53 are the SD card
// (see the SDHOST/DWC2 pin-mux code elsewhere) -- reconfiguring those
// through this same general API would break the running console or
// storage. Not blocked here (an incomplete blocklist would be a false
// sense of safety, and low-level GPIO control being "dangerous if
// misused" is inherent to the feature), but worth knowing before
// wiring real hardware to arbitrary pins.
//
// Confirmed against QEMU 10.0.0's own hw/gpio/bcm2835_gpio.c: GPFSELn/
// GPSET/GPCLR/GPLEV are genuinely modeled (GPFSELn readback returns
// what was actually written; GPSET/GPCLR both update the GPLEV-visible
// level unconditionally, regardless of the pin's function-select
// state -- a real hardware simplification, but sufficient to verify
// this driver's own register-address/bit-mask arithmetic is correct).
// GPPUD/GPPUDCLK0/1 (pull-up/down control) are explicitly marked
// "Not implemented" in that same source -- gpio_set_pull below is
// real, spec-correct code, but its actual effect is unverifiable
// under QEMU, same honest limitation class as EDID in docs/TODO.md.

// Function-select encoding is 3 bits per pin packed 10-per-register,
// architectural (BCM2835 datasheet section 6.1), not a simple binary
// progression: 0b000=input, 0b001=output, 0b100=ALT0, 0b101=ALT1,
// 0b110=ALT2, 0b111=ALT3, 0b011=ALT4, 0b010=ALT5.
// Round 76 follow-up: was `return 0x20200000 + (pin / 10) * 4;` --
// one elegant line, but a raw literal the mmio overlap checker never
// saw. A 6-way branch over the named consts instead, so every
// address this function can ever return is checked.
fn gpio_fsel_reg_for(pin: i64) -> i64 {
  if pin < 10 {
    return GPFSEL0;
  }
  if pin < 20 {
    return GPFSEL1;
  }
  if pin < 30 {
    return GPFSEL2;
  }
  if pin < 40 {
    return GPFSEL3;
  }
  if pin < 50 {
    return GPFSEL4;
  }
  return GPFSEL5;
}

fn gpio_fsel_shift_for(pin: i64) -> i64 {
  return (pin % 10) * 3;
}

// Sets pin's 3-bit function-select field, leaving the other 9 pins
// packed into the same register untouched (read-modify-write, not a
// blind overwrite).
fn gpio_set_function(pin: i64, func: u32) -> i64 {
  let reg: i64 = gpio_fsel_reg_for(pin);
  let shift: u32 = gpio_fsel_shift_for(pin) as u32;
  let mask: u32 = ((7 as u32) << shift) ^ (0xFFFFFFFF as u32);
  let bits: u32 = (func & (7 as u32)) << shift;
  let cur: u32 = mmio_read_u32(reg);
  let _ = mmio_write_u32(reg, (cur & mask) | bits);
  return 0;
}

// Reads pin's current 3-bit function-select field back.
fn gpio_get_function(pin: i64) -> u32 {
  let reg: i64 = gpio_fsel_reg_for(pin);
  let shift: u32 = gpio_fsel_shift_for(pin) as u32;
  let cur: u32 = mmio_read_u32(reg);
  return (cur >> shift) & (7 as u32);
}

// Drives pin high (value != 0) via GPSET, or low via GPCLR -- these
// are one-shot "set exactly these bits" registers (writing a 0 bit is
// a no-op, not "clear"), never read-modify-write, matching the
// hardware's own design.
fn gpio_write(pin: i64, value: u32) -> i64 {
  let bit: u32 = (pin % 32) as u32;
  let set_reg: i64 = if pin < 32 { GPSET0 } else { GPSET1 };
  let clr_reg: i64 = if pin < 32 { GPCLR0 } else { GPCLR1 };
  let reg: i64 = if value != (0 as u32) { set_reg } else { clr_reg };
  let _ = mmio_write_u32(reg, (1 as u32) << bit);
  return 0;
}

// Reads pin's current level (0 or 1) via GPLEV.
fn gpio_read(pin: i64) -> u32 {
  let reg: i64 = if pin < 32 { GPLEV0 } else { GPLEV1 };
  let bit: u32 = (pin % 32) as u32;
  let val: u32 = mmio_read_u32(reg);
  return (val >> bit) & (1 as u32);
}

// Pull-up/down/none control (0=none, 1=pull-down, 2=pull-up per the
// BCM2835 GPPUD encoding) -- same GPPUD-then-clock-pulse-then-clear
// sequence gpio_uart_alt_init above already uses for pins 14/15,
// generalized to any pin. See this section's own header comment: real,
// spec-correct code, but its actual effect is unverifiable under QEMU
// (GPPUD/GPPUDCLK are stubbed "Not implemented" in QEMU's own GPIO
// model) -- only real hardware can confirm this actually configures a
// pull resistor.
fn gpio_set_pull(pin: i64, pull: u32) -> i64 {
  let gppud: i64 = GPPUD;
  let clk_reg: i64 = if pin < 32 { GPPUDCLK0 } else { GPPUDCLK1 };
  let bit: u32 = (pin % 32) as u32;
  let _ = mmio_write_u32(gppud, pull);
  let _ = delay(150);
  let _ = mmio_write_u32(clk_reg, (1 as u32) << bit);
  let _ = delay(150);
  let _ = mmio_write_u32(clk_reg, 0 as u32);
  let _ = mmio_write_u32(gppud, 0 as u32);
  return 0;
}

// Self-test, run once at boot: verifies the register-address/bit-mask
// arithmetic above against QEMU's real, genuinely-modeled GPFSEL/
// GPSET/GPCLR/GPLEV registers (confirmed via QEMU's own source, see
// this section's header comment) -- not GPPUD/GPPUDCLK, which that
// same source confirms QEMU does not implement at all.
// Function-select read/write round trip for one pin, saving and
// restoring its original function so the self-test leaves no lasting
// side effect on boot state. Returns 1 if the round trip was correct,
// 0 otherwise. Factored out of gpio_self_check so the same check can
// run against 3 pins spanning 3 different GPFSELn registers without
// needing an array (this codebase has no established array-type
// usage anywhere else -- straight-line/helper-function repetition
// matches its own consistent style instead).
fn gpio_self_check_one_pin(pin: i64) -> i64 {
  let orig: u32 = gpio_get_function(pin);
  let ok: i64 = 1;
  let _ = gpio_set_function(pin, 1 as u32);
  if gpio_get_function(pin) != (1 as u32) {
    ok = 0;
  }
  let _ = gpio_set_function(pin, 0 as u32);
  if gpio_get_function(pin) != (0 as u32) {
    ok = 0;
  }
  let _ = gpio_set_function(pin, orig);
  return ok;
}

fn gpio_self_check() -> i64 {
  let ok: i64 = 1;

  // Pins 0, 10, and 53 span 3 different GPFSELn registers -- 53 is
  // also GPFSEL5's own top pin, a real boundary.
  if gpio_self_check_one_pin(0) == 0 {
    ok = 0;
  }
  if gpio_self_check_one_pin(10) == 0 {
    ok = 0;
  }
  if gpio_self_check_one_pin(53) == 0 {
    ok = 0;
  }

  // Setting one pin's function must NOT disturb its neighbor packed
  // into the same register (the read-modify-write mask's own
  // correctness) -- pins 5 and 6 share GPFSEL0.
  let orig5: u32 = gpio_get_function(5);
  let orig6: u32 = gpio_get_function(6);
  let _ = gpio_set_function(5, 1 as u32);
  let _ = gpio_set_function(6, 0 as u32);
  if gpio_get_function(5) != (1 as u32) {
    ok = 0;
  }
  let _ = gpio_set_function(6, 1 as u32);
  if gpio_get_function(5) != (1 as u32) {
    // Setting pin 6 must not have clobbered pin 5's own field.
    ok = 0;
  }
  let _ = gpio_set_function(5, orig5);
  let _ = gpio_set_function(6, orig6);

  // GPSET/GPCLR/GPLEV round trip across the GPSET0/GPSET1 (pin
  // 31/32) boundary -- confirmed live-modeled by QEMU regardless of
  // the pin's function-select state (see header comment), so no
  // function-select change is needed for this half of the test.
  let _ = gpio_write(31, 1 as u32);
  if gpio_read(31) != (1 as u32) {
    ok = 0;
  }
  let _ = gpio_write(31, 0 as u32);
  if gpio_read(31) != (0 as u32) {
    ok = 0;
  }
  let _ = gpio_write(32, 1 as u32);
  if gpio_read(32) != (1 as u32) {
    ok = 0;
  }
  let _ = gpio_write(32, 0 as u32);
  if gpio_read(32) != (0 as u32) {
    ok = 0;
  }

  let _ = uart_puts("GPIO: function-select read/write + GPSET/GPCLR/GPLEV round trip (BCM2835 registers, QEMU-modeled)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 71: HDMI output via the VideoCore mailbox property-channel
// interface (boot/fb_state.S's mbox_property_call, generalized from
// governor_apply_freq_mhz's own already-verified transport). Real
// hardware note: the GPU firmware does the actual HDMI signal
// generation -- this code only asks it, via the mailbox, to allocate
// a pixel buffer at a given resolution/depth and report back where
// that buffer lives and how it's laid out; software then just writes
// pixels into that buffer directly (plain RAM, not a device register
// -- see fb_fill_pixel below).
//
// Builds ONE combined mailbox call with 6 tags -- SET_PHYSICAL_
// WIDTH_HEIGHT, SET_VIRTUAL_WIDTH_HEIGHT, SET_DEPTH, SET_PIXEL_ORDER,
// FRAMEBUFFER_ALLOCATE, FRAMEBUFFER_GET_PITCH -- matching the common
// bare-metal-Pi convention of bundling all mode-setup tags into one
// round trip. This is safe specifically because of how QEMU (and, per
// the standard property-interface spec, real firmware too) processes
// a buffer's tags strictly in order against one shared, in-progress
// config: by the time the ALLOCATE tag runs, the SET_* tags earlier
// in this SAME buffer have already updated the pending config, so
// ALLOCATE's own size response and the trailing GET_PITCH tag both
// correctly reflect the just-requested resolution/depth, not a stale
// previous one. Confirmed directly against QEMU 10.0.0's own
// hw/misc/bcm2835_property.c source (bcm2835_property_mbox_push's own
// single local `fbconfig`, mutated tag-by-tag across one pass before
// any of it is applied) before relying on this ordering.
//
// Byte layout (all little-endian, the mailbox's own wire format):
//   [0] total size (120) | [4] request code (0)
//   [8] tag=SET_PHYSICAL_WIDTH_HEIGHT | [12] bufsize=8 | [16] 0 | [20] width | [24] height
//   [28] tag=SET_VIRTUAL_WIDTH_HEIGHT | [32] bufsize=8 | [36] 0 | [40] width | [44] height
//   [48] tag=SET_DEPTH | [52] bufsize=4 | [56] 0 | [60] bpp
//   [64] tag=SET_PIXEL_ORDER | [68] bufsize=4 | [72] 0 | [76] 1 (RGB)
//   [80] tag=FRAMEBUFFER_ALLOCATE | [84] bufsize=8 | [88] 0 | [92] alignment(in)/base(out) | [96] size(out)
//   [100] tag=FRAMEBUFFER_GET_PITCH | [104] bufsize=4 | [108] 0 | [112] pitch(out)
//   [116] end tag (0)
fn fb_init(width: i64, height: i64, bpp: i64) -> i64 {
  let buf: mut ref i64 = fb_mbox_buf_ptr();

  let _ = buf_write_u32_le(buf, 0, 120 as u32);
  let _ = buf_write_u32_le(buf, 4, 0 as u32);

  let _ = buf_write_u32_le(buf, 8, 0x00048003 as u32);
  let _ = buf_write_u32_le(buf, 12, 8 as u32);
  let _ = buf_write_u32_le(buf, 16, 0 as u32);
  let _ = buf_write_u32_le(buf, 20, width as u32);
  let _ = buf_write_u32_le(buf, 24, height as u32);

  let _ = buf_write_u32_le(buf, 28, 0x00048004 as u32);
  let _ = buf_write_u32_le(buf, 32, 8 as u32);
  let _ = buf_write_u32_le(buf, 36, 0 as u32);
  let _ = buf_write_u32_le(buf, 40, width as u32);
  let _ = buf_write_u32_le(buf, 44, height as u32);

  let _ = buf_write_u32_le(buf, 48, 0x00048005 as u32);
  let _ = buf_write_u32_le(buf, 52, 4 as u32);
  let _ = buf_write_u32_le(buf, 56, 0 as u32);
  let _ = buf_write_u32_le(buf, 60, bpp as u32);

  let _ = buf_write_u32_le(buf, 64, 0x00048006 as u32);
  let _ = buf_write_u32_le(buf, 68, 4 as u32);
  let _ = buf_write_u32_le(buf, 72, 0 as u32);
  let _ = buf_write_u32_le(buf, 76, 1 as u32);

  let _ = buf_write_u32_le(buf, 80, 0x00040001 as u32);
  let _ = buf_write_u32_le(buf, 84, 8 as u32);
  let _ = buf_write_u32_le(buf, 88, 0 as u32);
  let _ = buf_write_u32_le(buf, 92, 16 as u32);
  let _ = buf_write_u32_le(buf, 96, 0 as u32);

  let _ = buf_write_u32_le(buf, 100, 0x00040008 as u32);
  let _ = buf_write_u32_le(buf, 104, 4 as u32);
  let _ = buf_write_u32_le(buf, 108, 0 as u32);
  let _ = buf_write_u32_le(buf, 112, 0 as u32);

  let _ = buf_write_u32_le(buf, 116, 0 as u32);

  let status: i64 = mbox_property_call(buf);
  if status != 0 {
    return status;
  }

  let base: u32 = buf_read_u32_le(buf, 92);
  let size: u32 = buf_read_u32_le(buf, 96);
  let pitch: u32 = buf_read_u32_le(buf, 112);

  let _ = fb_base_set(base as i64);
  let _ = fb_size_set(size as i64);
  let _ = fb_pitch_set(pitch as i64);
  return 0;
}

// Writes one 32-bit-per-pixel value directly into the allocated
// framebuffer -- plain RAM once fb_init has run, not a device
// register, so a literal mmio_write_u32 (which just needs SOME
// integer address, hardware or not) is the right tool, matching the
// convention this codebase already uses for "write a raw word to a
// literal address" everywhere else. Out-of-range x/y is a silent
// no-op (never writes outside the allocated buffer) rather than a
// crash -- this project's own "reject, don't guess" posture applied
// to a caller error here specifically means "don't corrupt adjacent
// memory," not "return an error code" (no caller currently checks
// one, and a wild write would be far worse than a dropped pixel).
fn fb_fill_pixel(x: i64, y: i64, color: u32) -> i64 {
  let width_px: i64 = fb_pitch_get() / 4;
  if (x < 0) || (x >= width_px) || (y < 0) {
    return 0;
  }
  if (y * fb_pitch_get()) >= fb_size_get() {
    return 0;
  }
  let addr: i64 = fb_base_get() + (y * fb_pitch_get()) + (x * 4);
  let _ = mmio_write_u32(addr, color);
  return 0;
}

// Self-test, run once at boot: verifies fb_init's own arithmetic
// against QEMU's real, genuinely-modeled framebuffer property tags
// (confirmed via QEMU's own source, see fb_init's header comment) --
// unlike EDID (docs/TODO.md), every tag used here is actually
// implemented, so pitch/size can be checked against real expected
// values, not just "the call didn't hang."
fn fb_self_check() -> i64 {
  let ok: i64 = 1;
  let status: i64 = fb_init(640, 480, 32);
  if status != 0 {
    ok = 0;
  }
  // 32bpp = 4 bytes/pixel; pitch must be exactly width*4, size exactly
  // pitch*height -- real arithmetic QEMU's own device model computes
  // from the resolution/depth this call just requested (see fb_init's
  // header comment for why this isn't a stale/previous value).
  if fb_pitch_get() != (640 * 4) {
    ok = 0;
  }
  if fb_size_get() != (fb_pitch_get() * 480) {
    ok = 0;
  }
  if fb_base_get() == 0 {
    ok = 0;
  }

  let _ = uart_puts("FB: mailbox framebuffer allocate (640x480x32, real pitch/size arithmetic verified, QEMU-modeled)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }

  // Round 71 FIX (2026-09-05): a real pixel-write round trip, not just
  // mode-set arithmetic -- this is the specific check that would have
  // caught the actual bug this round found live (fb_fill_pixel's
  // target address, real VideoCore RAM at ~0x1C000000+, was outside
  // every range boot/mmu_init.S's own MMU table mapped, so the very
  // first real pixel write anywhere in this project took a Data
  // Abort; the checks above never wrote a single pixel, so they
  // passed the whole time regardless). Two corners, two different
  // colors, so a wrong pitch/stride calculation that happened to work
  // for (0,0) couldn't hide behind it.
  // This exact check (writing then reading back a real pixel) is what
  // actually caught the round-71 bug below -- initially misdiagnosed
  // one level too shallow as a vani/LLVM compiler bug (an `if
  // mmio_read_u32(addr) != const` comparison seemed to miscompile,
  // reproducibly, depending on unrelated code shape nearby). GDB
  // against the real failing build proved otherwise: fb_pitch_get/
  // fb_base_get/fb_size_get (boot/fb_state.S) are declared `-> i64`
  // here but their assembly only ever set r0, leaving the AAPCS
  // 64-bit return's high word (r1) as leftover garbage from whatever
  // call happened before. `last_x = fb_pitch_get() / 4 - 1` performs
  // genuine 64-bit division, correctly trusting r1 per the ABI
  // contract -- garbage there corrupted the result into a huge
  // positive number, which fb_fill_pixel's own bounds check then
  // correctly (and silently) rejected, so the far-corner pixel write
  // never happened. Different code shapes nearby just changed which
  // stale value happened to be sitting in r1, which is why the
  // symptom looked tied to "let vs. inline" rather than to its real
  // cause. Fixed at the source (boot/fb_state.S now explicitly zeros
  // r1 in all three getters); no workaround needed here once the real
  // bug was found. See project memory for the fuller writeup and the
  // sweep this prompted across the rest of the codebase for the same
  // bug class.
  let pix_ok: i64 = 1;
  let _ = fb_fill_pixel(0, 0, 0x00112233 as u32);
  let corner_addr: i64 = fb_base_get();
  if mmio_read_u32(corner_addr) != (0x00112233 as u32) {
    pix_ok = 0;
  }
  let last_x: i64 = (fb_pitch_get() / 4) - 1;
  let last_y: i64 = 479;
  let _ = fb_fill_pixel(last_x, last_y, 0x00445566 as u32);
  let far_addr: i64 = fb_base_get() + (last_y * fb_pitch_get()) + (last_x * 4);
  if mmio_read_u32(far_addr) != (0x00445566 as u32) {
    pix_ok = 0;
  }

  let _ = uart_puts("FB: pixel write/readback round trip at two corners of the allocated buffer (real VideoCore RAM, mapped by boot/mmu_init.S)");
  if pix_ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

fn uart_init() -> i64 {
  let _ = gpio_uart_alt_init();

  // BUG (round 18 audit, 2026-08-28): gpio_uart_alt_init() just wrote
  // GPIO peripheral registers (GPFSEL1/GPPUD/GPPUDCLK0, base
  // 0x20200000) to mux pins 14/15 onto the PL011 UART -- the writes
  // immediately below are the first access to a genuinely DIFFERENT
  // peripheral (PL011 UART, base 0x20201000). Round 17's "same
  // peripheral always arrives in-order" finding does NOT cover this:
  // that finding only applies WITHIN one peripheral's own registers;
  // this is exactly the case Broadcom's own BCM2835 guidance (see
  // context_switch.S's mem_barrier comment) says DOES need a barrier
  // -- "a memory write barrier before the first write to a
  // peripheral" when switching from one peripheral to another. On
  // real hardware, nothing guaranteed the GPIO mux write had actually
  // landed before UART_CR/IBRD/FBRD/LCRH start programming a
  // peripheral whose pins might not be routed yet. Invisible under
  // QEMU for the same reason every other barrier gap in this project
  // is: TCG never reorders anything.
  let _ = mem_barrier();

  let uart_cr: i64 = UART_CR;
  let uart_icr: i64 = UART_ICR;
  let uart_ibrd: i64 = UART_IBRD;
  let uart_fbrd: i64 = UART_FBRD;
  let uart_lcrh: i64 = UART_LCRH;

  let _ = mmio_write_u32(uart_cr, 0 as u32);
  let _ = mmio_write_u32(uart_icr, 0x7FF as u32);
  // 115200 baud @ assumed 3MHz UART clock: IBRD=1, FBRD=40.
  let _ = mmio_write_u32(uart_ibrd, 1 as u32);
  let _ = mmio_write_u32(uart_fbrd, 40 as u32);
  // 8 bits, no parity, 1 stop bit, FIFOs enabled.
  let _ = mmio_write_u32(uart_lcrh, 0x70 as u32);
  // Enable UART + TX + RX.
  let _ = mmio_write_u32(uart_cr, 0x301 as u32);
  return 0;
}

// Phase 4 -- UART0's own interrupt (RX FIFO non-empty), routed through
// the same BCM2835 interrupt controller as the Phase 2 timer, but a
// different GPU IRQ line (57, not 1) landing in the controller's
// SECOND pending/enable register (IRQs 32-63), not the first --
// confirmed against QEMU's own hw/arm/raspi_platform.h source rather
// than assumed, the same discipline every other MMIO peripheral in
// this project has needed. PL011 register offsets (IMSC/RIS/MIS/ICR)
// are the standard ARM PrimeCell UART layout, not BCM2835-specific --
// already load-bearing elsewhere in this file (uart_icr at the same
// 0x44 offset used here, from uart_init/the existing TX path).
fn uart_rx_irq_init() -> i64 {
  let uart_imsc: i64 = UART_IMSC;
  // RXIM (bit 4): interrupt whenever the RX FIFO is above its trigger
  // level -- left at the PL011 default (1/8 full), close enough to
  // "every keystroke" for interactive typing at human speed.
  let _ = mmio_write_u32(uart_imsc, 0x10 as u32);

  let ic_enable2: i64 = IC_ENABLE2;
  // GPU IRQ 57 (UART0) is bit 25 of the controller's second
  // enable/pending register group (IRQs 32-63).
  let _ = mmio_write_u32(ic_enable2, 0x02000000 as u32);
  return 0;
}

fn uart_putc(c: i64) -> i64 {
  let uart_fr: i64 = UART_FR;
  let uart_dr: i64 = UART_DR;
  // Wait while the TX FIFO is full (FR bit 5).
  while true {
    let fr: u32 = mmio_read_u32(uart_fr);
    if (fr & (0x20 as u32)) == (0 as u32) {
      break;
    }
  }
  let _ = mmio_write_u8(uart_dr, c as u8);
  return 0;
}

// Best-effort, WCET-safe single-char write for hard-RT contexts:
// uart_putc's own FIFO-full wait loop has no compile-time-provable
// iteration bound (the estimator correctly rejects it under
// #[wcet(...)] for exactly that reason), so this checks the FIFO
// status once and silently drops the byte if it's full rather than
// spinning -- a genuine tradeoff (an occasional missed debug
// character), not a workaround: an ISR that MUST make forward
// progress can never afford to block on a shared peripheral no matter
// how unlikely the wait would be in practice.
fn uart_putc_nonblocking(c: i64) -> i64 {
  let uart_fr: i64 = UART_FR;
  let uart_dr: i64 = UART_DR;
  let fr: u32 = mmio_read_u32(uart_fr);
  if (fr & (0x20 as u32)) == (0 as u32) {
    let _ = mmio_write_u8(uart_dr, c as u8);
  }
  return 0;
}

// Bounded, non-blocking hex-digit printer for hard-RT contexts (this
// project's own irq_dispatch's stack-canary check is the only caller
// as of round 68). uart_put_hex32 below deliberately uses blocking
// uart_putc inside a `while` loop -- exactly the "unbounded under
// #[wcet(...)]" problem irq_dispatch's own UART RX FIFO drain comment
// already documents in full (only a `for i from LOW to HIGH` range
// loop, not `while`, carries a statically-known trip count the WCET
// estimator can multiply through), so it can't be reused here. Same
// best-effort trade-off as uart_putc_nonblocking itself: a nibble is
// silently dropped if the UART's TX FIFO happens to be full at that
// exact instant -- already accepted project-wide for anything printed
// from IRQ context.
fn uart_put_hex32_irq(v: u32) -> i64 {
  for shift_idx from 0 to 8 {
    let shift: u32 = (28 - (shift_idx * 4)) as u32;
    let nibble: u32 = (v >> shift) & (0xF as u32);
    let n: i64 = nibble as i64;
    if n < 10 {
      let _ = uart_putc_nonblocking(48 + n);
    } else {
      let _ = uart_putc_nonblocking(55 + n);
    }
  }
  return 0;
}

fn uart_puts(s: Str) -> i64 {
  let n: i64 = str_len_bytes(s);
  let i: i64 = 0;
  while i < n {
    let b: i64 = str_byte_at(s, i);
    let _ = uart_putc(b);
    i = i + 1;
  }
  return 0;
}

// Debug helper for bringing up new MMIO peripherals (Phase 3's SD
// driver first): print a u32 as 8 hex digits, most-significant nibble
// first. Not on any hard-RT path, so plain uart_putc's blocking wait
// is fine here (unlike irq_dispatch's uart_putc_nonblocking).
fn uart_put_hex32(v: u32) -> i64 {
  let shift: i64 = 28;
  while shift >= 0 {
    let nibble: u32 = (v >> (shift as u32)) & (0xF as u32);
    let n: i64 = nibble as i64;
    if n < 10 {
      let _ = uart_putc(48 + n);
    } else {
      let _ = uart_putc(55 + n);
    }
    shift = shift - 4;
  }
  return 0;
}

// Round 38: called directly from vectors.S's fault_data_abort/
// fault_prefetch_abort -- see that file's own comment on why these
// exist now (MMU permission faults, this round's own W^X enforcement,
// are a genuinely expected event rather than an unrecoverable bug,
// and a silent halt would make any real page-table mistake here
// undebuggable). #[no_mangle] so assembly can `bl` these by plain
// name, the same convention irq_dispatch/scheduler_switch_from_irq
// already establish. #[no_heap]: both only ever call uart_puts/
// uart_put_hex32 (already proven not to allocate, used from task_d's
// own #[no_heap] idle loop), and a fault handler is exactly the place
// that must never depend on heap state being sane -- the fault itself
// could have been caused by heap corruption. Neither function ever
// returns in practice (the assembly caller always follows with `b .`
// regardless of what these do), so the return value is unused.
//
// Status bits[3:0] == 0b1101 (0xD) identifies a section permission
// fault under the plain (non-remapped, non-LPAE) ARMv6 short-
// descriptor format this project's page table uses -- called out
// explicitly here since it's the ONE fault type this round's own live
// verification deliberately triggers (a write to the read-only code
// section, or an execute attempt from an XN-marked data section) to
// prove W^X is actually enforced, not just present in the table.
fn abort_fault_is_section_permission(status: u32) -> i64 {
  if (status & (0xF as u32)) == (0xD as u32) {
    return 1;
  }
  return 0;
}

#[no_mangle]
#[no_heap]
fn abort_report_data(addr: u32, status: u32, fault_pc: u32, orig_r0: u32, orig_r1: u32, orig_r2: u32, orig_r3: u32, orig_lr: u32) -> i64 {
  let _ = uart_puts("\nFATAL: Data Abort at address ");
  let _ = uart_put_hex32(addr);
  let _ = uart_puts(" status=");
  let _ = uart_put_hex32(status);
  if abort_fault_is_section_permission(status) == 1 {
    let _ = uart_puts(" (section permission fault)");
  }
  let _ = uart_puts(" pc=");
  let _ = uart_put_hex32(fault_pc);
  let _ = uart_puts(" current_task=");
  let _ = uart_put_hex32(current_task_get());
  // Round 62c (task #154): the faulting instruction's own r0-r3 at the
  // moment of the abort -- for this codebase's overwhelmingly common
  // `str rD, [rBASE, rOFFSET]`/`ldr ...` fault shape, r0 is very
  // frequently the base pointer and r1 the byte offset (buf_write_u32/
  // buf_read_byte/etc.'s own AAPCS argument order) -- seeing the ACTUAL
  // register values (not just the computed fault address) is what can
  // finally distinguish "the base pointer itself was zeroed" from "a
  // corrupted offset was added to an otherwise-valid base," which this
  // investigation has not yet been able to tell apart.
  let _ = uart_puts(" r0=");
  let _ = uart_put_hex32(orig_r0);
  let _ = uart_puts(" r1=");
  let _ = uart_put_hex32(orig_r1);
  let _ = uart_puts(" r2=");
  let _ = uart_put_hex32(orig_r2);
  let _ = uart_puts(" r3=");
  let _ = uart_put_hex32(orig_r3);
  // Round 68: lr_svc at the moment of the fault -- see vectors.S's own
  // comment for why this is exactly the faulting function's real
  // return address (its caller's call site), not the fault_pc's own
  // +8-offset abort-mode convention above. addr2line this directly.
  let _ = uart_puts(" lr=");
  let _ = uart_put_hex32(orig_lr);
  let _ = uart_puts(" ctxsw=");
  let _ = uart_put_i64(context_switch_count_get());
  let _ = uart_puts(" irqs=");
  let _ = uart_put_i64(irq_count_get());
  let _ = uart_puts(" -- halting\n");
  return 0;
}

#[no_mangle]
#[no_heap]
fn abort_report_prefetch(addr: u32, status: u32) -> i64 {
  let _ = uart_puts("\nFATAL: Prefetch Abort at address ");
  let _ = uart_put_hex32(addr);
  let _ = uart_puts(" status=");
  let _ = uart_put_hex32(status);
  if abort_fault_is_section_permission(status) == 1 {
    let _ = uart_puts(" (section permission fault)");
  }
  let _ = uart_puts(" -- halting\n");
  return 0;
}

// Round 28: same nibble-printing logic as uart_put_hex32 right above,
// just two digits instead of eight -- needed for MAC address
// formatting (AA:BB:CC:DD:EE:FF), where a full 32-bit-wide print
// would be wrong for a single byte.
fn uart_put_hex_byte(v: u32) -> i64 {
  let shift: i64 = 4;
  while shift >= 0 {
    let nibble: u32 = (v >> (shift as u32)) & (0xF as u32);
    let n: i64 = nibble as i64;
    if n < 10 {
      let _ = uart_putc(48 + n);
    } else {
      let _ = uart_putc(55 + n);
    }
    shift = shift - 4;
  }
  return 0;
}

// Task #10: decimal (not hex) printer for eval's results -- a
// calculator that only ever prints hex isn't a useful demo. Iterative,
// not recursive (build the digit string in reverse into a scratch
// buffer, then print it forwards): this project's vani v1 checkers
// have already shown real friction with anything not statically
// bounded (see eval_expr_raw's own header comment), so a fixed-size
// scratch buffer (24 bytes -- comfortably more than i64's own max 20
// decimal digits plus a sign) sidesteps the question entirely rather
// than relying on however deep vani's recursion support actually goes.
// BUG (round 6 audit, 2026-08-27): this function used to negate the
// whole value up front (`value = 0 - value`) to convert a negative
// input into the positive domain before building its digit string.
// i64::MIN is the one i64 value whose own negation overflows -- its
// magnitude (9223372036854775808) is one more than i64::MAX can hold
// -- and unconditionally executing an operation that can overflow,
// rather than checking first, is the exact bug class round 2's audit
// spent a whole pass closing in eval_apply (see i64_mul_would_overflow's
// own comment): confirmed live against the real vani-compiler on this
// target that negating i64::MIN panics ("integer overflow in int64_t
// sub") in `vanic run`'s own interpreter, and this project has already
// separately confirmed that same trap's firing behavior is inconsistent
// between that interpreted context and the actual llc-compiled ARM
// object code this kernel ships as -- meaning the realistic outcomes
// here were either a silent wrong answer (a wraparound negation stays
// negative, so the digit loop below would never run, printing "-0"
// instead of "-9223372036854775808") or a full kernel hang
// (runtime_stubs.c's exit() is an infinite halt loop with no OS to
// return to). No caller passes i64::MIN today, but this is a general-
// purpose print helper used throughout the codebase -- worth closing
// before some future caller does.
//
// Fixed by working in the NEGATIVE domain throughout instead: a
// negative value's own quotient and remainder by 10 always shrink in
// magnitude (never grow), so neither can ever land on something i64
// can't represent, and the single-digit remainder negated at the very
// end (`0 - d`, d always in [-9, 0]) never comes close to overflowing
// either. This avoids ever negating the full value, so i64::MIN prints
// correctly with no special-case needed.
fn uart_put_i64(v: i64) -> i64 {
  let is_neg: i64 = 0;
  if v < 0 {
    is_neg = 1;
  }
  let neg_value: i64 = v;
  if v > 0 {
    neg_value = 0 - v;
  }
  let digits: mut ref i64 = uart_digits_scratch_get();
  let n: i64 = 0;
  if neg_value == 0 {
    let _ = buf_write_byte(digits, 0 as u32, 48 as u32);
    n = 1;
  } else {
    while neg_value < 0 {
      let d: i64 = 0 - (neg_value - ((neg_value / 10) * 10));
      let _ = buf_write_byte(digits, n as u32, (48 + d) as u32);
      n = n + 1;
      neg_value = neg_value / 10;
    }
  }
  if is_neg == 1 {
    let _ = uart_putc(45); // '-'
  }
  let i: i64 = n - 1;
  while i >= 0 {
    let c: u32 = buf_read_byte(digits, i as u32);
    let _ = uart_putc(c as i64);
    i = i - 1;
  }
  return 0;
}

// Phase 2 -- BCM2835 system timer (base 0x20003000) + interrupt
// controller (base 0x2000B000). Timer channel 1 (C1) is free for ARM
// use on real hardware (channels 0 and 2 are reserved for the GPU
// firmware); its compare-match interrupt is IRQ line 1, i.e. bit 1 of
// the IC's "pending 1" / "enable 1" registers. The timer free-runs at
// 1MHz (1 tick = 1 microsecond) -- a fixed property of this peripheral,
// not something Dhruva configures.
extern "C" fn enable_irqs() -> i64;

fn timer_ic_init() -> i64 {
  let timer_cs: i64 = TIMER_CS;
  let timer_clo: i64 = TIMER_CLO;
  let timer_c1: i64 = TIMER_C1;
  let ic_enable1: i64 = IC_ENABLE1;

  // Arm the first compare match 500ms out (500000 us @ 1MHz).
  let now: u32 = mmio_read_u32(timer_clo);
  let interval: u32 = 500000 as u32;
  let first: u32 = now + interval;
  let _ = mmio_write_u32(timer_c1, first);

  // Clear any stale match flag for channel 1 before enabling its IRQ.
  let _ = mmio_write_u32(timer_cs, 2 as u32);

  // BUG (round 19 audit, 2026-08-28): the write above is this
  // function's own stated guarantee ("clear any stale match flag...
  // before enabling its IRQ") -- but timer_cs (system timer, base
  // 0x20003000) and ic_enable1 (interrupt controller, base
  // 0x2000B000) are two different peripherals, and nothing enforced
  // that the clear had actually landed before the enable below
  // reached the IC. A genuinely stale match flag left over from
  // whatever ran before this (or simply a slow-draining posted write)
  // could let IC line 1 come up already pending, firing IRQ1 the
  // instant interrupts are unmasked (start_multitasking's restore,
  // much later in boot) rather than at the first real compare match.
  // In practice CPSR's I-bit stays set for the rest of kernel_main
  // (see this function's own two call sites and start_multitasking's
  // comment), so a huge amount of intervening work almost certainly
  // drains any posted write long before that matters -- but "almost
  // certainly, given how much code runs after this" is exactly the
  // kind of reasoning rounds 16-18 already found isn't a substitute
  // for the barrier Broadcom's own BCM2835 guidance calls for at a
  // cross-peripheral switch (see context_switch.S's mem_barrier
  // comment). uart_rx_irq_init's own IMSC-then-IC_ENABLE2 switch,
  // right next to this one, does NOT need the same fix -- PL011's
  // interrupt line is level-sensitive, re-evaluated live from IMSC &
  // RIS, not a one-shot flag a race could permanently corrupt, so
  // write order between those two specific registers can't lose an
  // event the way it can here.
  let _ = mem_barrier();

  // Enable IC line 1 (timer channel 1's compare-match interrupt).
  let _ = mmio_write_u32(ic_enable1, 2 as u32);
  return 0;
}

// BCM2835 power-management watchdog (base 0x20100000) -- the same
// peripheral real Pi firmware/Linux use to reboot the board on demand
// (bcm2835_wdt) and to recover from a genuinely wedged system. This is
// the *last-resort* answer to "the scheduler locked up and irq_dispatch
// stopped running at all," a failure mode nothing at the vani/scheduler
// level can protect against once it happens -- the intent is exactly
// what Linux's own driver uses it for: arm a countdown, kick it once
// per tick, let the SoC reset itself the instant the kicks stop.
//
// Implemented per the real, documented register semantics (matches
// bcm2835_wdt.c's constants exactly), but NOT wired into kernel_main/
// irq_dispatch's live path -- confirmed empirically that QEMU's
// raspi1ap machine model does not honor PM_WDOG's timeout field at
// all: writing PM_RSTC with WRCFG=FULL_RESET resets the emulated
// machine immediately, regardless of what's in PM_WDOG (tested at both
// a 2-second timeout and the maximum possible 20-bit value, 0xFFFFF --
// both reset within milliseconds; disabling only the PM_RSTC write,
// leaving PM_WDOG alone, restores completely normal operation, which
// isolates the immediate-reset behavior to that one write). Since this
// project tests exclusively via QEMU's raspi1ap, arming this for real
// would make the one and only test method permanently unable to boot
// the system at all -- a hardware-verification gap, not a Dhruva or
// vani-compiler bug, tracked here rather than silently worked around.
// PM_WDOG/PM_RSTC both require a magic password in their top byte on
// every write, or the write is silently ignored -- not optional, not
// a Dhruva convention, this is how the peripheral itself is gated
// against accidental writes.
fn watchdog_arm(timeout_ticks: u32) -> i64 {
  let pm_password: u32 = 0x5A000000 as u32;
  let pm_rstc: i64 = PM_RSTC;
  let pm_wdog: i64 = PM_WDOG;
  let wrcfg_clr: u32 = 0xFFFFFFCF as u32;
  let wrcfg_full_reset: u32 = 0x00000020 as u32;

  let _ = mmio_write_u32(pm_wdog, pm_password | (timeout_ticks & (0xFFFFF as u32)));
  let cur: u32 = mmio_read_u32(pm_rstc);
  let _ = mmio_write_u32(pm_rstc, pm_password | (cur & wrcfg_clr) | wrcfg_full_reset);
  return 0;
}

// Ticks run at 65536 Hz (a fixed property of this peripheral, same
// SECS_TO_WDOG_TICKS(x) = x << 16 constant Linux's bcm2835_wdt driver
// uses) -- 2 seconds gives four missed 500ms ticks of margin before a
// reset, generous for jitter but still tight enough to prove the
// watchdog actually does something if irq_dispatch ever stops running.
fn watchdog_init() -> i64 {
  let two_seconds_in_ticks: u32 = 131072 as u32; // 2 << 16
  let _ = watchdog_arm(two_seconds_in_ticks);
  return 0;
}

fn watchdog_kick() -> i64 {
  let two_seconds_in_ticks: u32 = 131072 as u32;
  let _ = watchdog_arm(two_seconds_in_ticks);
  return 0;
}

// Phase 3 -- BCM2835 SDHOST controller (base 0x20202000), the real SD
// interface Pi 1 (and every earlier/simpler Pi) uses -- not the newer
// EMMC/SDHCI interface later boards have. Register semantics are the
// real, documented bcm2835-sdhost hardware protocol (same one Linux's
// own bcm2835-sdhost.c targets), confirmed empirically against QEMU
// before writing any of this: SDEDM/SDHSTS/SDCMD all read back sane,
// documented reset-state values at this exact base before any driver
// code touches them. Unlike the PM watchdog (Phase 2), this peripheral
// is genuinely modeled under QEMU's raspi1ap, not just accepted and
// simplified -- confirmed via the emulator binary itself carrying full
// bcm2835-sdhost read/write/IRQ trace events, not just a stub.
//
// Bring-up only so far: CMD0 (GO_IDLE_STATE), polled rather than
// interrupt-driven, no timeout error path yet. Deliberately not
// wcet-annotated -- sdhost_cmd's poll loop has a real iteration cap
// (unlike Phase 2's uart_putc, which had none and got caught by
// exactly this class of check) but the full init/read/write state
// machine isn't done enough yet to annotate meaningfully; that lands
// once the driver is complete, not incrementally per bring-up step.
fn sdhost_cmd(cmd_and_flags: u32, arg: u32) -> u32 {
  let sdarg: i64 = SDARG;
  let sdcmd: i64 = SDCMD;
  let sdcmd_new_flag: u32 = 0x8000 as u32;
  let _ = mmio_write_u32(sdarg, arg);
  let _ = mmio_write_u32(sdcmd, sdcmd_new_flag | cmd_and_flags);

  // Poll until the controller clears NEW_FLAG (command, and its
  // response if any, complete) or the iteration cap is hit -- capped,
  // not `while true`, specifically so a wedged card can never hang
  // the caller forever the way an unbounded wait would.
  let iter: i64 = 0;
  while iter < 1000000 {
    let v: u32 = mmio_read_u32(sdcmd);
    if (v & sdcmd_new_flag) == (0 as u32) {
      break;
    }
    iter = iter + 1;
  }
  return mmio_read_u32(sdcmd);
}

// BUG (round 15 audit, 2026-08-28): sdhost_init's own command sequence
// below used to discard every sdhost_cmd return value outright (`let
// _ = sdhost_cmd(...)`), self-documented at the time as "no timeout
// error path yet" -- an acknowledged gap, but still a real one. Round
// 5's audit fixed exactly this class of bug one layer up
// (sdhost_read_block/write_block silently treating a software-level
// poll timeout as success, because SDHSTS's own error bits can't
// distinguish "the card genuinely errored" from "sdhost_cmd's own
// 1,000,000-iteration poll gave up before the command ever completed,
// well before the hardware's own much-longer SDTOUT-based timeout
// would have fired"). That exact same gap was still open here, in the
// one-shot commands that bring the card up in the first place --
// arguably higher-stakes than the read/write path, since a wedged
// controller during INIT means every later read/write is operating on
// top of a card that was never actually brought up correctly at all,
// with nothing anywhere in the boot log to say so. This helper is
// sdhost_init's own version of the same check.
fn sdhost_cmd_timed_out(status: u32) -> i64 {
  if (status & (0x8000 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

// Boot-time self-test for the pure detection logic itself. Actually
// triggering a genuine sdhost_cmd timeout under QEMU would mean making
// the emulated card wedge, which isn't something this project has a
// way to simulate (unlike, say, a corrupted network packet, which is
// just bytes this driver builds itself) -- but sdhost_cmd_timed_out is
// a pure function of the raw SDCMD value, directly testable with
// synthetic inputs exactly like governor_desired_freq_mhz or
// eval_apply already are, regardless of whether a real timeout can be
// staged live.
fn sdhost_cmd_timed_out_self_test() -> i64 {
  let ok: i64 = 1;
  if sdhost_cmd_timed_out(0x8000 as u32) != 1 { ok = 0; } // NEW_FLAG still set -> timed out
  if sdhost_cmd_timed_out(0 as u32) != 0 { ok = 0; }      // NEW_FLAG clear -> completed
  if sdhost_cmd_timed_out(0x8001 as u32) != 1 { ok = 0; } // NEW_FLAG set + other bits -> still timed out
  if sdhost_cmd_timed_out(1 as u32) != 0 { ok = 0; }      // other bits set, NEW_FLAG clear -> completed
  let _ = uart_puts("SD: sdhost_cmd_timed_out detects NEW_FLAG correctly");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// BCM2835 GPIO 48-53 (the "SD_*_R" pins) are shared, muxed pins: on
// THESE SPECIFIC pins, hardware alt-function encoding 0b100 (ALT0)
// routes the card to SDHOST, while function-select 0b000 (plain GPIO
// input, the post-reset default) routes it to SDHCI/EMMC instead --
// the same real-hardware pin-muxing GPU firmware configures via
// config.txt before jumping to the ARM kernel on real boards. Nothing
// in this project's boot path plays that firmware role, so the mux
// stays at its SDHCI-routed default until this runs.
//
// Found by reading QEMU's own hw/gpio/bcm2835_gpio.c source after
// sdhost_init's CMD8/ACMD41 sequence kept timing out for no reason
// visible from the SDHOST registers alone: SDCMD/SDHSTS both looked
// completely correct mechanically (real bit values, real semantics,
// confirmed against QEMU's own hw/sd/bcm2835_sdhost.c source too),
// because the actual bug was one level up the emulated hardware
// stack -- the drive attached via `-drive if=sd` was reparented onto
// SDHCI by default, so SDHOST was issuing every command to a bus with
// no card on it at all. First attempt at this fix used bit pattern
// 0b011 (going by the generic "ALT4" naming convention used
// elsewhere, e.g. UART's ALT0=0b100 on GPIO14/15) and still failed --
// QEMU's own gpfsel_set() checks the raw fsel value against a literal
// 4 (0b100) for these pins specifically, which Broadcom's datasheet
// calls "ALT0" here, not "ALT4"; alt-function-number-to-bit-pattern
// mapping is per-pin-group, not a single global convention, and
// re-reading the emulator source directly (not guessing from another
// peripheral's pin group) is what caught the mismatch.
fn gpio_sdhost_alt_init() -> i64 {
  let gpfsel4: i64 = GPFSEL4;
  let gpfsel5: i64 = GPFSEL5;

  // Pins 48 (bits 24-26) and 49 (bits 27-29) live in GPFSEL4.
  let r4: u32 = mmio_read_u32(gpfsel4);
  let clear_mask4: u32 = 0xC0FFFFFF as u32;
  let sd_alt_bits4: u32 = 0x24000000 as u32; // 0b100 on both pins
  let _ = mmio_write_u32(gpfsel4, (r4 & clear_mask4) | sd_alt_bits4);

  // Pins 50-53 (bits 0-11, 3 bits each) live in GPFSEL5.
  let r5: u32 = mmio_read_u32(gpfsel5);
  let clear_mask5: u32 = 0xFFFFF000 as u32;
  let sd_alt_bits5: u32 = 0x00000924 as u32; // 0b100 on all four pins
  let _ = mmio_write_u32(gpfsel5, (r5 & clear_mask5) | sd_alt_bits5);
  return 0;
}

fn sdhost_init() -> i64 {
  let _ = gpio_sdhost_alt_init();

  // BUG (round 18 audit, 2026-08-28): same real gap uart_init's own
  // comment explains in full -- gpio_sdhost_alt_init() just wrote
  // GPIO peripheral registers (GPFSEL4/GPFSEL5, base 0x20200000) to
  // mux pins 48-53 onto SDHOST, and the writes immediately below are
  // the first access to a genuinely different peripheral (SDHOST,
  // base 0x20202000). This is a real cross-peripheral switch, not the
  // same-peripheral case round 17 already confirmed is safe without a
  // barrier -- higher-stakes here than UART, since this project has
  // already hit a real bug from this exact mux (see
  // gpio_sdhost_alt_init's own header comment: SDHOST issuing
  // commands to a bus with no card on it because the mux was wrong)
  // -- a timing gap on top of a correct mux value would fail the same
  // way, just intermittently instead of always, on real hardware.
  let _ = mem_barrier();

  let sdvdd: i64 = SDVDD;
  let sdcdiv: i64 = SDCDIV;
  let sdtout: i64 = SDTOUT;
  let sdhcfg: i64 = SDHCFG;
  let sdhbct: i64 = SDHBCT;
  let sdhblc: i64 = SDHBLC;
  let sdhsts: i64 = SDHSTS;
  let sdedm: i64 = SDEDM;

  // Power off, then back on -- a clean, known starting FSM state
  // rather than trusting whatever QEMU's reset default happens to be.
  let _ = mmio_write_u32(sdvdd, 0 as u32);
  let _ = delay(10000);
  let _ = mmio_write_u32(sdvdd, 1 as u32);
  let _ = delay(10000);

  // Identification-speed clock divisor and a generous command
  // timeout -- real-hardware bcm2835-sdhost values, not QEMU-specific
  // tuning.
  let _ = mmio_write_u32(sdcdiv, 0x148 as u32);
  let _ = mmio_write_u32(sdtout, 0xF00000 as u32);
  let _ = mmio_write_u32(sdhbct, 0 as u32);
  let _ = mmio_write_u32(sdhblc, 0 as u32);
  // Interrupts stay disabled -- this driver polls SDCMD/SDHSTS
  // directly, the same way Phase 0-2's own peripherals were brought
  // up before anything needed a real IRQ line.
  let _ = mmio_write_u32(sdhcfg, 0 as u32);

  let sdcmd_no_response: u32 = 0x400 as u32;
  let sdcmd_long_response: u32 = 0x200 as u32;
  let sdcmd_busywait: u32 = 0x800 as u32;
  let sdrsp0: i64 = SDRSP0;

  // CMD0: GO_IDLE_STATE. No response expected.
  let cmd0_status: u32 = sdhost_cmd(sdcmd_no_response, 0 as u32);
  if sdhost_cmd_timed_out(cmd0_status) == 1 {
    let _ = uart_puts("SD: CMD0 (GO_IDLE_STATE) timed out\n");
    return 0 - 1;
  }

  // CMD8: SEND_IF_COND -- 0x1AA = 2.7-3.6V range + the 0xAA check
  // pattern. A card that doesn't echo it back either doesn't
  // implement CMD8 (an old SDSC card -- not supported by this driver
  // yet) or something's wrong with the link; not checked yet, just
  // logged, since the only card this needs to handle right now is
  // QEMU's own `-drive if=sd` image. A genuine software-level timeout
  // (the controller itself wedged, not just an old card that doesn't
  // implement this command) is still a real, distinct failure worth
  // catching -- an unresponsive CMD8 either way means nothing later in
  // this sequence stands a real chance either.
  let cmd8_status: u32 = sdhost_cmd(8 as u32, 0x1AA as u32);
  if sdhost_cmd_timed_out(cmd8_status) == 1 {
    let _ = uart_puts("SD: CMD8 (SEND_IF_COND) timed out\n");
    return 0 - 1;
  }
  let _ = uart_puts("SD: CMD8 RSP0=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdrsp0));
  let _ = uart_puts("\n");

  // ACMD41 loop: CMD55 (APP_CMD) then CMD41 (SD_SEND_OP_COND) with
  // the HCS bit set (this driver only supports SDHC/SDXC-style
  // block-addressed cards) until the card's busy bit (bit 31 of the
  // OCR response) sets, meaning it finished its own internal power-up
  // sequence. Capped iteration count, not `while true` -- same
  // reasoning as sdhost_cmd's own poll loop.
  let ocr_busy: u32 = 0x80000000 as u32;
  let hcs: u32 = 0x40000000 as u32;
  let voltage_window: u32 = 0x00FF8000 as u32;
  let acmd_iter: i64 = 0;
  let ocr: u32 = 0 as u32;
  let acmd41_wedged: i64 = 0;
  while (acmd_iter < 1000) && (acmd41_wedged == 0) {
    let cmd55_status: u32 = sdhost_cmd(55 as u32, 0 as u32);
    let cmd41_status: u32 = sdhost_cmd(41 as u32, hcs | voltage_window);
    // A software-level timeout on either command here is a different,
    // more severe condition than the ordinary "OCR busy bit not set
    // yet" retry this loop already exists to tolerate -- that's the
    // card correctly reporting it isn't ready; a timeout means the
    // controller itself never even completed the command, and
    // retrying against a wedged controller for the remaining
    // iterations would just be a long wait for something that was
    // never going to succeed. Distinguished from the ordinary retry
    // path so it fails fast instead.
    if (sdhost_cmd_timed_out(cmd55_status) == 1) || (sdhost_cmd_timed_out(cmd41_status) == 1) {
      acmd41_wedged = 1;
    } else {
      ocr = mmio_read_u32(sdrsp0);
      if (ocr & ocr_busy) != (0 as u32) {
        break;
      }
      acmd_iter = acmd_iter + 1;
    }
  }
  if acmd41_wedged == 1 {
    let _ = uart_puts("SD: ACMD41 (CMD55/CMD41) timed out\n");
    return 0 - 1;
  }
  let _ = uart_puts("SD: ACMD41 done, OCR=0x");
  let _ = uart_put_hex32(ocr);
  let _ = uart_puts("\n");

  // CMD2: ALL_SEND_CID -- long (136-bit) response. No addressing yet
  // (this is the one open-drain-style "every card on the bus
  // responds" command) -- fine here since exactly one card exists.
  let cmd2_status: u32 = sdhost_cmd(sdcmd_long_response | (2 as u32), 0 as u32);
  if sdhost_cmd_timed_out(cmd2_status) == 1 {
    let _ = uart_puts("SD: CMD2 (ALL_SEND_CID) timed out\n");
    return 0 - 1;
  }

  // CMD3: SEND_RELATIVE_ADDR -- the card publishes its own RCA in the
  // top 16 bits of the (short) response; every later addressed
  // command needs it in that same position, so no shift is needed
  // between reading it here and using it below.
  let cmd3_status: u32 = sdhost_cmd(3 as u32, 0 as u32);
  if sdhost_cmd_timed_out(cmd3_status) == 1 {
    let _ = uart_puts("SD: CMD3 (SEND_RELATIVE_ADDR) timed out\n");
    return 0 - 1;
  }
  let rca: u32 = mmio_read_u32(sdrsp0) & (0xFFFF0000 as u32);

  // CMD9: SEND_CSD -- long response, addressed by the RCA just
  // published. Not parsed yet (card capacity/speed class live here on
  // real hardware) -- deferred until the driver actually needs it.
  let cmd9_status: u32 = sdhost_cmd(sdcmd_long_response | (9 as u32), rca);
  if sdhost_cmd_timed_out(cmd9_status) == 1 {
    let _ = uart_puts("SD: CMD9 (SEND_CSD) timed out\n");
    return 0 - 1;
  }

  // CMD7: SELECT_CARD -- moves the card from stand-by to transfer
  // state; every data command (CMD17/CMD24 etc., task #3) requires
  // this first.
  let cmd7_status: u32 = sdhost_cmd(sdcmd_busywait | (7 as u32), rca);
  if sdhost_cmd_timed_out(cmd7_status) == 1 {
    let _ = uart_puts("SD: CMD7 (SELECT_CARD) timed out\n");
    return 0 - 1;
  }

  // CMD16: SET_BLOCKLEN -- this driver only ever uses 512-byte
  // blocks, set once here rather than before every single read/write.
  let cmd16_status: u32 = sdhost_cmd(16 as u32, 512 as u32);
  if sdhost_cmd_timed_out(cmd16_status) == 1 {
    let _ = uart_puts("SD: CMD16 (SET_BLOCKLEN) timed out\n");
    return 0 - 1;
  }

  // OCR bit 30 (CCS, Card Capacity Status) is only meaningful once
  // ACMD41 reported busy=0 (ready) above -- 1 means SDHC/SDXC
  // (block-addressed), 0 means SDSC (byte-addressed, block_num*512).
  // QEMU's generic SD card model derives this from the attached
  // image's size, not anything this driver controls.
  let ccs_bit: u32 = 0x40000000 as u32;
  let is_sdhc: i64 = if (ocr & ccs_bit) != (0 as u32) { 1 } else { 0 };
  let _ = sd_state_set(rca as i64, is_sdhc);

  let _ = uart_puts("SD: init done, RCA=0x");
  let _ = uart_put_hex32(rca);
  let _ = uart_puts(" is_sdhc=");
  let _ = uart_put_hex32(is_sdhc as u32);
  let _ = uart_puts(" SDHSTS=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdhsts));
  let _ = uart_puts(" SDEDM=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdedm));
  let _ = uart_puts("\n");
  return rca as i64;
}

// CMD17 (READ_SINGLE_BLOCK) / CMD24 (WRITE_BLOCK). block_num is a
// logical 512-byte block index regardless of the card's own
// addressing mode -- SDSC cards want a byte address (block_num*512)
// on the wire, SDHC/SDXC cards want the block number directly; the
// distinction is handled here, once, so nothing above this layer
// (the Phase 3 filesystem, task #4) ever needs to care which kind of
// card it's talking to.
fn sdhost_card_addr(block_num: i64) -> u32 {
  let is_sdhc: i64 = sd_state_get_is_sdhc();
  if is_sdhc != 0 {
    return block_num as u32;
  }
  return (block_num * 512) as u32;
}

// BUG (round 5 audit, 2026-08-27): both functions below computed
// `status`, sdhost_cmd's own return value, then explicitly discarded
// it (`let _ = status;`) and relied purely on SDHSTS's error bits
// (0xF8: REW_TIME_OUT/CMD_TIME_OUT/CRC16/CRC7/FIFO_ERROR) to detect a
// failed transfer. That mask genuinely does cover the hardware's own
// SDTOUT-driven CMD_TIME_OUT condition -- but SDTOUT is configured to
// 0xF00000 (sdhost_init), a real-hardware-timescale value (tens of
// seconds' worth of card-clock cycles at identification speed), while
// sdhost_cmd's own SOFTWARE poll loop gives up after a fixed 1,000,000
// MMIO-read iterations -- far fewer wall-clock seconds under QEMU's
// own MMIO emulation. A card that genuinely never responds would hit
// that software cap and return with NEW_FLAG (bit 0x8000) still SET,
// well before the hardware's own CMD_TIME_OUT bit ever fires --
// meaning `errs` would read 0 (no hardware error yet) and the caller
// would treat a read/write that never actually happened as a success,
// handing the FS layer either a stale/garbage buffer (read) or silent
// data loss with no error reported at all (write). Fixed by checking
// NEW_FLAG in `status` too: still set means sdhost_cmd's own poll gave
// up before the command ever completed, a failure regardless of what
// SDHSTS shows.
fn sdhost_read_block(block_num: i64, buf: mut ref i64) -> i64 {
  let sdhbct: i64 = SDHBCT;
  let sdhblc: i64 = SDHBLC;
  let sdhsts: i64 = SDHSTS;
  let sdcmd_read: u32 = 0x40 as u32;
  let sdcmd_new_flag: u32 = 0x8000 as u32;

  let addr: u32 = sdhost_card_addr(block_num);
  let status: u32 = sdhost_cmd(sdcmd_read | (17 as u32), addr);
  let _ = mmio_write_u32(sdhbct, 512 as u32);
  let _ = mmio_write_u32(sdhblc, 1 as u32);
  let _ = sdhost_drain_fifo_to_buffer(buf, 128);
  let errs: u32 = mmio_read_u32(sdhsts) & (0xF8 as u32);
  let _ = mmio_write_u32(sdhsts, errs);
  if (status & sdcmd_new_flag) != (0 as u32) {
    return 1;
  }
  if errs != (0 as u32) {
    return 1;
  }
  return 0;
}

fn sdhost_write_block(block_num: i64, buf: mut ref i64) -> i64 {
  // Round 62 (fault injection): `fault write <n>` -- see
  // fault_write_maybe_inject's own comment. Checked before touching
  // any hardware register at all, so an injected failure has zero
  // side effects on the real SD controller state.
  if fault_write_maybe_inject() == (1 as u32) {
    return 1;
  }
  let sdhbct: i64 = SDHBCT;
  let sdhblc: i64 = SDHBLC;
  let sdhsts: i64 = SDHSTS;
  let sdcmd_write: u32 = 0x80 as u32;
  let sdcmd_new_flag: u32 = 0x8000 as u32;

  let addr: u32 = sdhost_card_addr(block_num);
  let status: u32 = sdhost_cmd(sdcmd_write | (24 as u32), addr);
  let _ = mmio_write_u32(sdhbct, 512 as u32);
  let _ = mmio_write_u32(sdhblc, 1 as u32);
  let _ = sdhost_fill_fifo_from_buffer(buf, 128);
  let errs: u32 = mmio_read_u32(sdhsts) & (0xF8 as u32);
  let _ = mmio_write_u32(sdhsts, errs);
  if (status & sdcmd_new_flag) != (0 as u32) {
    return 1;
  }
  if errs != (0 as u32) {
    return 1;
  }
  return 0;
}

// Round 36: block-device abstraction the FS layer's own raw block I/O
// goes through, rather than calling sdhost_read_block/write_block
// directly -- the "block-device abstraction" docs/TODO.md called for,
// built now that a real second backend (USB mass storage's
// usb_msd_read10/write10, rounds 33-35) actually exists to shape it
// against, not speculatively ahead of one. Dispatches on dharafs_state_
// get_block_dev() (0=SDHOST, the permanent default for every real FS
// operation -- boot self-tests, shell ls/cat/write, phase4_
// milestone.py, all unchanged; 1=USB mass storage, flipped only by
// dharafs_block_dev_self_check below to prove the abstraction genuinely
// works for both backends without ever touching a real FS operation's
// own backend). dwc2_downstream_addr() is correct here for the same
// reason it's correct everywhere else USB mass storage is used in
// this project: exactly one real device has ever been tested attached
// to the one hub port this driver enumerates.
fn dharafs_block_read_raw(block_num: i64, buf: mut ref i64) -> i64 {
  if dharafs_state_get_block_dev() == (2 as u32) {
    return host_virtual_disk_read(block_num, buf);
  }
  if dharafs_state_get_block_dev() == (1 as u32) {
    return usb_msd_read10(dwc2_downstream_addr(), block_num as u32, buf);
  }
  return sdhost_read_block(block_num, buf);
}

fn dharafs_block_write_raw(block_num: i64, buf: mut ref i64) -> i64 {
  let status: i64 = if dharafs_state_get_block_dev() == (2 as u32) {
    host_virtual_disk_write(block_num, buf)
  } else {
    if dharafs_state_get_block_dev() == (1 as u32) {
      usb_msd_write10(dwc2_downstream_addr(), block_num as u32, buf)
    } else {
      sdhost_write_block(block_num, buf)
    }
  };
  // Round 51: counts every successful commit, across all three
  // backends, for kernel_main.vani's `diagnose` command -- the one
  // choke point every real FS write already passes through regardless
  // of which backend is active.
  if status == 0 {
    let _ = dharafs_commit_count_increment();
  }
  return status;
}

// Media (at-rest) encryption's own choke point (see the full design
// comment above dharafs_crypto_encrypt_block, near the ChaCha20-
// Poly1305 AEAD section): transparently encrypts/decrypts through the
// *_raw functions above when dharafs_crypto_enabled is on, using
// dharafs_crypto_scratch_ptr() to hold the raw ciphertext -- distinct
// from the buffers dharafs_crypto_encrypt_block/decrypt_block use
// internally, so no aliasing. Passthrough, byte-for-byte unchanged,
// when encryption is off (the default) -- every existing test keeps
// working exactly as before. Round 69: dharafs_block_read now fails
// CLOSED (returns -1, buf left untouched) on a tamper/corruption
// detection from decrypt_block -- callers already treat any non-zero
// status as a read failure, so this is a plain extension of the
// existing error contract, not a new one.
fn dharafs_block_read(block_num: i64, buf: mut ref i64) -> i64 {
  if dharafs_crypto_get_enabled() == (1 as u32) {
    let scratch: mut ref i64 = dharafs_crypto_scratch_ptr();
    let status: i64 = dharafs_block_read_raw(block_num, scratch);
    if status != 0 {
      return status;
    }
    return dharafs_crypto_decrypt_block(block_num, scratch, buf);
  }
  return dharafs_block_read_raw(block_num, buf);
}

fn dharafs_block_write(block_num: i64, buf: mut ref i64) -> i64 {
  if dharafs_crypto_get_enabled() == (1 as u32) {
    let scratch: mut ref i64 = dharafs_crypto_scratch_ptr();
    let _ = dharafs_crypto_encrypt_block(block_num, buf, scratch);
    return dharafs_block_write_raw(block_num, scratch);
  }
  return dharafs_block_write_raw(block_num, buf);
}

// DharaFS ("dhara" - धर, Sanskrit for "bearer/holder", the thing that
// carries/holds Dhruva's data) -- Phase 3 task #4's minimal log-
// structured filesystem, named as its own component distinct from
// Dhruva itself (rounds 39/42 grew it well past "task #4" into
// multi-block files, journaling, owner/group/other permissions, and
// directory hierarchy). NOT a general POSIX filesystem (per
// DHRUVA_ARCHITECTURE.md's own framing): a
// flat, append-only log of fixed-size (one SD block, 512 bytes),
// checksummed, path-keyed records. Overwriting a path just appends a
// newer record with the same path and a higher sequence number --
// the older one is left in place (reclaiming it is task #5's job,
// running as a low-priority background task, never touching this
// hard-real-time-adjacent append/read path). Block 0 is reserved
// (unused for now -- a natural home for a future superblock, not
// needed yet since dharafs_init's recovery scan reconstructs everything
// from the log itself).
//
// Record layout (512 bytes):
//   [0:4)   checksum   -- covers [4:512) only, computed fresh on
//                         every read and compared against this
//   [4:8)   seq_num    -- monotonically increasing across every
//                         record ever appended; ties never happen,
//                         so ">=" during recovery is really "the
//                         first one wins if this ever changes"
//   [8:12)  path_len   -- Round 39: 0 is a reserved sentinel marking
//                         this record as a CONTINUATION block, not an
//                         independently-addressable head (dharafs_append
//                         now rejects a genuine empty path outright,
//                         so this can never collide with a real
//                         record) -- see below.
//   [12:44) path bytes (32-byte max path; enforced on append; unused/
//                       zero on a continuation block)
//   [44:48) data_len   -- on a HEAD block (path_len > 0): the file's
//                         TOTAL logical length across every chained
//                         block. On a CONTINUATION block (path_len ==
//                         0): just THIS block's own chunk length.
//   [48:52) next_block -- Round 39: 0 = this is the last block in the
//                         chain; otherwise the block number of the
//                         next chunk. A file whose data fits in one
//                         block (the common case, and the only case
//                         before this round) is a single head block
//                         with next_block=0, byte-identical in spirit
//                         to the pre-round-39 format.
//   [52:56) owner_uid  -- Round 42: the file's owning user ID (on a
//                         HEAD block; zero/unused on a continuation
//                         block, same convention as path). 0 = root/
//                         superuser -- Dhruva has no login yet, so
//                         everything runs as uid 0 by default; see
//                         dharafs_user_get_uid()/dharafs_user_set() for the
//                         current-user context this is checked
//                         against.
//   [56:60) owner_gid  -- Round 42: the file's owning group ID, same
//                         zero-on-continuation convention as owner_uid.
//   [60:64) mode       -- Round 42: Unix-style owner/group/other rwx
//                         permission bits (bit 8 = owner-read down to
//                         bit 0 = other-execute; see
//                         dharafs_check_permission()). Zero/unused on a
//                         continuation block. New files default to
//                         0x1A4 (0o644, rw-r--r--) via dharafs_default_
//                         mode() unless dharafs_append_raw is called with
//                         an explicit mode.
//   [64:512) data bytes (448-byte max payload PER BLOCK; enforced on
//                        append -- a file's own TOTAL length can be up
//                        to dharafs_file_max_len(), spread across multiple
//                        chained blocks)
//
// Multi-block files (round 39): dharafs_append_raw writes a chain's blocks
// in REVERSE order -- every continuation chunk first, the head block
// LAST -- so the head's own single-block write is the one atomic
// "commit point" for the whole file. A crash/power-loss before that
// final write leaves only orphaned, unreachable continuation blocks
// (nothing ever finds them without a head pointing in) -- the OLD
// version of the file (or no file at all, if this was the first
// write) is still exactly what dharafs_find_latest_block_raw returns,
// completely unaffected, the same guarantee single-block writes have
// always had. A crash DURING the head block's own write is caught by
// its own checksum exactly like any other torn write already is. This
// is the actual new crash-consistency risk class docs/TODO.md flagged
// multi-block files as introducing -- solved by never making a new
// chain reachable until it's entirely durable, not by anything new at
// the single-block level.
//
// Why a checksum, not just trusting the write succeeded: this is
// exactly the property test/power_yank.py exists to test -- a write
// interrupted mid-block (power lost, or here, QEMU killed) leaves
// SOME bytes updated and others not, and the checksum is what turns
// "silently corrupt, half-old half-new data" into "this record fails
// validation, ignore it and use whatever the previous valid record
// for this path was." Genuinely torn writes are rejected, not just
// unlikely -- provable by the sweep, not merely hoped for.
fn dharafs_block_payload_cap() -> i64 {
  return 448;
}
fn dharafs_file_max_len() -> i64 {
  return 4096;
}

// Round 42: default permission bits for a newly-created file --
// 0x1A4 = 0o644 = rw-r--r-- (owner read+write, group/other read-only).
// A conservative, ordinary default; callers needing something else
// (e.g. an executable or a group-writable shared file) pass an
// explicit mode to dharafs_append_raw instead.
fn dharafs_default_mode() -> u32 {
  return 0x1A4 as u32;
}

// Round 42: Unix-style rwx permission check. `mode`'s bit layout
// matches traditional octal permissions: bit 8 = owner-read, 7 =
// owner-write, 6 = owner-execute, 5/4/3 = group r/w/x, 2/1/0 =
// other r/w/x. uid 0 (root) always passes -- Dhruva has no login yet,
// so uid 0 is both "the superuser" and "the only user that exists
// today" (see dharafs_user_get_uid()/dharafs_user_set()); real enforcement
// still applies to any other uid a caller explicitly sets, which is
// what the self-test below exercises. Exactly one of want_read/
// want_write/want_exec should be 1 per call (checked independently,
// not combined, so a caller needing both read+write makes two calls).
fn dharafs_check_permission(owner_uid: u32, owner_gid: u32, mode: u32, req_uid: u32, req_gid: u32, want_read: i64, want_write: i64, _want_exec: i64) -> i64 {
  if req_uid == (0 as u32) {
    return 1;
  }
  let shift: u32 = if req_uid == owner_uid {
    6 as u32
  } else {
    if req_gid == owner_gid { 3 as u32 } else { 0 as u32 }
  };
  let bit: u32 = if want_read == 1 {
    (4 as u32) << shift
  } else {
    if want_write == 1 { (2 as u32) << shift } else { (1 as u32) << shift }
  };
  if (mode & bit) != (0 as u32) {
    return 1;
  }
  return 0;
}
fn dirindex_max_slots() -> i64 { return 256; }
fn dirindex_max_path_bytes() -> i64 { return 32; }

fn dharafs_dirindex_reset() -> i64 {
  let i: i64 = 0;
  while i < dirindex_max_slots() {
    let _ = dirindex_set_valid_at(i as u32, 0 as u32);
    i = i + 1;
  }
  return 0;
}

// FNV-1a over path bytes read from `buf` starting at `path_offset` --
// callers pass path_offset=0 for a bare path_buf (dharafs_append_raw's
// own convention) or path_offset=12 to hash a path embedded directly
// in a full 512-byte on-disk record (dharafs_init's own scan buffer),
// so the index can be built/queried from either shape without a copy.
fn dharafs_dirindex_hash(buf: mut ref i64, path_offset: i64, path_len: i64) -> u32 {
  let hash: u32 = 2166136261 as u32;
  let k: i64 = 0;
  while k < path_len {
    let b: u32 = buf_read_byte(buf, (path_offset + k) as u32);
    hash = hash ^ b;
    hash = wrapping_mul(hash, 16777619 as u32);
    k = k + 1;
  }
  return hash;
}

fn dharafs_dirindex_path_matches(slot: i64, buf: mut ref i64, path_offset: i64, path_len: i64) -> i64 {
  if dirindex_get_pathlen_at(slot as u32) != path_len {
    return 0;
  }
  let k: i64 = 0;
  let matches: i64 = 1;
  while k < path_len {
    let want: u32 = buf_read_byte(buf, (path_offset + k) as u32);
    let got: u32 = dirindex_get_path_byte((slot * dirindex_max_path_bytes() + k) as u32) as u32;
    if got != want {
      matches = 0;
    }
    k = k + 1;
  }
  return matches;
}

// Standard open-addressing probe with no deletion (entries are only
// ever added or have their block field updated, never removed --
// see this file's own dirindex_state.S header comment for why that
// keeps "hit an empty slot => not present" a safe stopping rule for
// the whole table's lifetime). Returns the matching slot index, or -1
// if the path isn't indexed yet.
fn dharafs_dirindex_find_slot(buf: mut ref i64, path_offset: i64, path_len: i64, h: u32) -> i64 {
  let start: i64 = (h % (dirindex_max_slots() as u32)) as i64;
  let i: i64 = 0;
  while i < dirindex_max_slots() {
    let idx: i64 = (start + i) % dirindex_max_slots();
    if dirindex_get_valid_at(idx as u32) == 0 {
      return 0 - 1;
    }
    if (dirindex_get_hash_at(idx as u32) as u32) == h {
      if dharafs_dirindex_path_matches(idx, buf, path_offset, path_len) == 1 {
        return idx;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

fn dharafs_dirindex_lookup_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  let h: u32 = dharafs_dirindex_hash(path_buf, 0, path_len);
  let slot: i64 = dharafs_dirindex_find_slot(path_buf, 0, path_len, h);
  if slot < 0 {
    return 0 - 1;
  }
  return dirindex_get_block_at(slot as u32);
}

// Shared upsert core -- path_offset lets both dharafs_append_raw
// (bare path_buf, offset 0) and dharafs_init's scan (path embedded in
// a full record, offset 12) call the same logic. If the path is
// already indexed, only its block field changes; block numbers only
// ever increase within one boot (the log is append-only), so an
// unconditional overwrite always reflects the latest write. If the
// table is completely full (well beyond this project's realistic
// file counts), the insert is silently skipped -- correctness is
// unaffected, that one path just stays on dharafs_find_latest_block_raw's
// linear-scan fallback instead of the fast path.
fn dharafs_dirindex_upsert(buf: mut ref i64, path_offset: i64, path_len: i64, block: i64) -> i64 {
  let h: u32 = dharafs_dirindex_hash(buf, path_offset, path_len);
  let existing: i64 = dharafs_dirindex_find_slot(buf, path_offset, path_len, h);
  if existing >= 0 {
    let _ = dirindex_set_block_at(existing as u32, block as u32);
    return 0;
  }
  let start: i64 = (h % (dirindex_max_slots() as u32)) as i64;
  let i: i64 = 0;
  while i < dirindex_max_slots() {
    let idx: i64 = (start + i) % dirindex_max_slots();
    if dirindex_get_valid_at(idx as u32) == 0 {
      let _ = dirindex_set_valid_at(idx as u32, 1 as u32);
      let _ = dirindex_set_hash_at(idx as u32, h);
      let _ = dirindex_set_pathlen_at(idx as u32, path_len as u32);
      let k: i64 = 0;
      while k < path_len {
        let b: u32 = buf_read_byte(buf, (path_offset + k) as u32);
        let _ = dirindex_set_path_byte((idx * dirindex_max_path_bytes() + k) as u32, b);
        k = k + 1;
      }
      let _ = dirindex_set_block_at(idx as u32, block as u32);
      return 0;
    }
    i = i + 1;
  }
  return 0 - 1; // table full -- see this fn's own doc comment above
}

fn dharafs_dirindex_upsert_raw(path_buf: mut ref i64, path_len: i64, block: i64) -> i64 {
  return dharafs_dirindex_upsert(path_buf, 0, path_len, block);
}

fn dharafs_init() -> i64 {
  let _ = dharafs_dirindex_reset();
  let _ = dharafs_snapshot_reset();
  let buf: mut ref i64 = dhruva_alloc_bytes(512);
  let blk: i64 = 1;
  let max_blk: i64 = 2048; // 1MB log region for this v1 -- keeps a
                            // fresh/large device's recovery scan
                            // bounded rather than reading the whole
                            // disk looking for the first free block.
  let highest_seq: u32 = 0 as u32;
  while blk < max_blk {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status != 0 {
      break;
    }
    let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
    let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let this_seq: u32 = buf_read_u32(buf, 4 as u32);
    // A checksum match ALONE isn't enough: buf_checksum's rotate-mix
    // of an all-zero region is itself exactly 0, matching the
    // all-zero stored-checksum field a genuinely unwritten (fresh
    // device, never appended to) block already has -- so an empty
    // block would otherwise look like a perfectly valid, trivially
    // empty record, and recovery would silently scan straight past
    // every real free block instead of stopping at the first one.
    // Every genuine record's sequence number is >= 1 (dharafs_append never
    // hands out 0), so requiring seq_num != 0 too is what actually
    // distinguishes "real record" from "blank space that happens to
    // checksum-match its own all-zero checksum field." Found by the
    // append cursor landing at block 2040 on a device where nothing
    // had ever been written below that -- exactly where an unrelated
    // test (task #3's SD round-trip sweep) happens to write raw,
    // non-record data, which is what finally failed the checksum
    // check and looked like where the log "ended."
    if (stored_checksum != computed_checksum) || (this_seq == (0 as u32)) {
      break;
    }

    let this_path_len: u32 = buf_read_u32(buf, 8 as u32);
    if this_path_len == dharafs_tx_begin_sentinel() {
      // Round 52: a transaction marker -- see dharafs_tx_begin_raw's
      // own comment for why "are the next block_count blocks all
      // present and checksum-valid" is a complete completion proof.
      // buf's own contents (this_seq, block_count) are already
      // captured into locals below before this loop starts reusing
      // buf for each follow-up block's own read.
      let block_count: i64 = buf_read_u32(buf, 44 as u32) as i64;
      let tx_ok: i64 = 1;
      let j: i64 = 1;
      while j <= block_count {
        let check_blk: i64 = blk + j;
        if check_blk >= max_blk {
          tx_ok = 0;
        } else {
          let rd2: i64 = dharafs_block_read(check_blk, buf);
          if rd2 != 0 {
            tx_ok = 0;
          } else {
            let sc2: u32 = buf_read_u32(buf, 0 as u32);
            let cc2: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
            let seq2: u32 = buf_read_u32(buf, 4 as u32);
            if (sc2 != cc2) || (seq2 == (0 as u32)) {
              tx_ok = 0;
            }
          }
        }
        j = j + 1;
      }
      if tx_ok == 1 {
        // Every block's seq is assigned sequentially (dharafs_state_
        // set always advances by exactly the number of blocks just
        // written), so the group's own highest seq is this_seq +
        // block_count without needing to re-read each one.
        highest_seq = this_seq + (block_count as u32);
        // Index every block this confirmed-complete transaction
        // covers -- these are real file records too (e.g. dharafs_
        // rename's own append+tombstone pair), just as eligible for
        // the fast lookup path as any standalone record. Re-read
        // rather than reuse buf from the verification loop above,
        // since that loop only left the LAST checked block's bytes
        // in buf, not every one of them.
        let jj: i64 = 1;
        while jj <= block_count {
          let idx_blk: i64 = blk + jj;
          let rd3: i64 = dharafs_block_read(idx_blk, buf);
          if rd3 == 0 {
            let plen3: u32 = buf_read_u32(buf, 8 as u32);
            let _ = dharafs_dirindex_upsert(buf, 12, plen3 as i64, idx_blk);
          }
          jj = jj + 1;
        }
        blk = blk + 1 + block_count;
      } else {
        // Incomplete -- stop scanning HERE, before even counting the
        // tx_begin record itself. Nothing after this point in the log
        // can be trusted (a crash stops everything; no further real
        // append could have happened after an incomplete transaction
        // within this same boot), so this is also just where the scan
        // would need to stop anyway, not an extra restriction.
        break;
      }
    } else {
      if this_seq > highest_seq {
        highest_seq = this_seq;
      }
      let _ = dharafs_dirindex_upsert(buf, 12, this_path_len as i64, blk);
      blk = blk + 1;
    }
  }
  let _ = dharafs_state_set(blk as u32, highest_seq + (1 as u32));
  // log_start always resets to 1 on boot -- it's an in-RAM-only
  // optimization task #5's compaction earns back within a session
  // (fewer blocks to scan), not something persisted across reboots.
  // Recovery has no other safe starting point to trust anyway: with
  // nothing on the card recording where a prior compaction left off,
  // block 1 is the only assumption that can't be wrong.
  let _ = dharafs_state_set_log_start(1 as u32);
  return 0;
}

// Core append logic against raw buffers, not Str -- shared by
// dharafs_append (the normal Str-based path) and task #5's compaction,
// which only ever has raw record bytes already read from the card
// (a path/data value living inside someone else's log record has no
// Str form to hand over; there's no vani-level operation that builds
// one from arbitrary bytes, same reasoning as every other raw-buffer
// gap this project has hit at its extern "C" boundaries).
fn dharafs_append_raw(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, owner_uid: u32, owner_gid: u32, mode: u32) -> i64 {
  if path_len <= 0 {
    return 1; // reserved as the continuation-block sentinel, see
              // dharafs_init's own header comment -- a genuine empty path
              // is rejected outright so it can never collide with one
  }
  if path_len > 32 {
    return 1;
  }
  if data_len > dharafs_file_max_len() {
    return 1;
  }

  let cap: i64 = dharafs_block_payload_cap();
  if data_len <= cap {
    // Single block -- byte-identical in spirit to every pre-round-39
    // record: one head block, next_block=0.
    let buf: mut ref i64 = dharafs_sd_scratch_get();
    let next_block: u32 = dharafs_state_get_next_block();
    let next_seq: u32 = dharafs_state_get_next_seq();

    let _ = buf_write_u32(buf, 4 as u32, next_seq);
    let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
    let i: i64 = 0;
    while i < path_len {
      let b: u32 = buf_read_byte(path_buf, i as u32);
      let _ = buf_write_byte(buf, (12 + i) as u32, b);
      i = i + 1;
    }
    let _ = buf_write_u32(buf, 44 as u32, data_len as u32);
    let _ = buf_write_u32(buf, 48 as u32, 0 as u32); // next_block: none
    let _ = buf_write_u32(buf, 52 as u32, owner_uid);
    let _ = buf_write_u32(buf, 56 as u32, owner_gid);
    let _ = buf_write_u32(buf, 60 as u32, mode);
    let j: i64 = 0;
    while j < data_len {
      let b2: u32 = buf_read_byte(data_buf, j as u32);
      let _ = buf_write_byte(buf, (64 + j) as u32, b2);
      j = j + 1;
    }

    // Checksum last, over everything written above -- covers exactly
    // what a torn write could have left half-updated.
    let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let _ = buf_write_u32(buf, 0 as u32, checksum);

    let wr_status: i64 = dharafs_block_write(next_block as i64, buf);
    if wr_status != 0 {
      return 1;
    }

    let _ = dharafs_state_set(next_block + (1 as u32), next_seq + (1 as u32));
    let _ = dharafs_dirindex_upsert_raw(path_buf, path_len, next_block as i64);
    return 0;
  }

  // Multi-block: split into ceil(data_len/cap) chunks, block numbers
  // and sequence numbers allocated up front (chunk i lands at
  // base_block+i regardless of write order), then WRITTEN IN REVERSE
  // -- every continuation chunk first, the head block last -- so the
  // head's own single-block write is the one atomic point at which
  // the whole chain becomes reachable at all. See dharafs_init's own header
  // comment for the full crash-consistency reasoning.
  let num_chunks: i64 = (data_len + cap - 1) / cap;
  let base_block: u32 = dharafs_state_get_next_block();
  let base_seq: u32 = dharafs_state_get_next_seq();

  let chunk_idx: i64 = num_chunks - 1;
  while chunk_idx >= 0 {
    let this_block: u32 = base_block + (chunk_idx as u32);
    let this_seq: u32 = base_seq + (chunk_idx as u32);
    let is_head: i64 = if chunk_idx == 0 { 1 } else { 0 };
    let chunk_offset: i64 = chunk_idx * cap;
    let remaining_from_here: i64 = data_len - chunk_offset;
    let chunk_len: i64 = if remaining_from_here < cap { remaining_from_here } else { cap };
    let is_last_chunk: i64 = if chunk_idx == (num_chunks - 1) { 1 } else { 0 };
    let next_block_field: u32 = if is_last_chunk == 1 { 0 as u32 } else { base_block + ((chunk_idx + 1) as u32) };

    let buf: mut ref i64 = dharafs_sd_scratch_get();
    let _ = buf_write_u32(buf, 4 as u32, this_seq);
    if is_head == 1 {
      let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
      let i: i64 = 0;
      while i < path_len {
        let b: u32 = buf_read_byte(path_buf, i as u32);
        let _ = buf_write_byte(buf, (12 + i) as u32, b);
        i = i + 1;
      }
      let _ = buf_write_u32(buf, 44 as u32, data_len as u32); // TOTAL length
      let _ = buf_write_u32(buf, 52 as u32, owner_uid);
      let _ = buf_write_u32(buf, 56 as u32, owner_gid);
      let _ = buf_write_u32(buf, 60 as u32, mode);
    } else {
      let _ = buf_write_u32(buf, 8 as u32, 0 as u32); // continuation marker
      let z: i64 = 0;
      while z < 32 {
        let _ = buf_write_byte(buf, (12 + z) as u32, 0 as u32);
        z = z + 1;
      }
      let _ = buf_write_u32(buf, 44 as u32, chunk_len as u32); // THIS chunk's own length
      let _ = buf_write_u32(buf, 52 as u32, 0 as u32);
      let _ = buf_write_u32(buf, 56 as u32, 0 as u32);
      let _ = buf_write_u32(buf, 60 as u32, 0 as u32);
    }
    let _ = buf_write_u32(buf, 48 as u32, next_block_field);
    let j: i64 = 0;
    while j < chunk_len {
      let b2: u32 = buf_read_byte(data_buf, (chunk_offset + j) as u32);
      let _ = buf_write_byte(buf, (64 + j) as u32, b2);
      j = j + 1;
    }

    let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let _ = buf_write_u32(buf, 0 as u32, checksum);

    let wr_status: i64 = dharafs_block_write(this_block as i64, buf);
    if wr_status != 0 {
      // Stop without advancing state -- the next real append reuses
      // base_block and overwrites whatever partial chain was left,
      // same "state only advances on full success" posture as the
      // single-block path above.
      return 1;
    }
    chunk_idx = chunk_idx - 1;
  }

  let _ = dharafs_state_set(base_block + (num_chunks as u32), base_seq + (num_chunks as u32));
  let _ = dharafs_dirindex_upsert_raw(path_buf, path_len, base_block as i64);
  return 0;
}

// Round 42: preserve-on-overwrite semantics, matching ordinary Unix
// behavior -- writing to an existing file doesn't change its owner/
// group/mode. Looks up the file's current metadata first (dharafs_stat);
// a genuinely new path gets the current user context (dharafs_user_get_
// uid/gid) and dharafs_default_mode() instead. Callers needing full control
// (a specific owner/mode regardless of what a caller session's uid
// is, or task #5's compaction re-carrying an existing record forward
// unchanged) call dharafs_append_raw directly.
fn dharafs_append(path: Str, data: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  let data_len: i64 = str_len_bytes(data);
  // Checked here too, not just inside dharafs_append_raw: these fixed-size
  // temp buffers are sized exactly to the record format's own limits,
  // and the copy loops below would overrun them before dharafs_append_raw
  // ever got a chance to reject an oversized path/data itself.
  if path_len <= 0 {
    return 1;
  }
  if path_len > 32 {
    return 1;
  }
  if data_len > dharafs_file_max_len() {
    return 1;
  }
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat(path, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { dharafs_user_get_uid() };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { dharafs_user_get_gid() };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { dharafs_default_mode() };
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let j: i64 = 0;
  while j < data_len {
    let _ = buf_write_byte(data_buf, j as u32, str_byte_at(data, j) as u32);
    j = j + 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

// Round 42: permission-enforcing entry points. dharafs_read_raw/
// dharafs_append_raw/dharafs_delete_raw themselves stay UNCHECKED, trusted
// primitives -- dharafs_compact and dharafs_list both need to operate across
// every file regardless of ownership for their own housekeeping
// (GC, listing), exactly like a real filesystem's kernel-internal
// paths bypass permission checks that only apply at the user-facing
// syscall boundary. These _checked wrappers are that boundary here;
// the shell's cat/write/rm commands go through them (using dharafs_user_
// get_uid/gid as the requester), not the raw primitives directly.
//
// Return convention: -1 not found (same as the unchecked functions),
// -2 permission denied (new), else success (data length for read, 0
// for write/delete) -- callers that only cared about "-1 or success"
// before still work unchanged as long as they don't mistake -2 for
// -1's meaning.
fn dharafs_read_raw_checked(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  let allowed: i64 = dharafs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 1, 0, 0);
  if allowed == 0 {
    return 0 - 2;
  }
  return dharafs_read_raw(path_buf, path_len, out_buf);
}

// A brand-new path (dharafs_stat_raw returns "not found") is always
// writable -- Dhruva has no real directory objects to hold a
// directory-level "who may create files here" permission the way a
// real Unix filesystem would; allowing creation freely is the
// honestly-scoped v1 simplification (noted here rather than silently
// assumed). An EXISTING path's write permission is enforced normally.
// Round 50: immutable/append-only/system file attributes (docs/
// TODO.md's own backlog item). Stored in the EXISTING `mode` u32's
// otherwise-unused high bits (only the low 9 bits are real rwx
// permission bits, per dharafs_check_permission's own shift-by-6/3/0
// logic) -- no on-disk record format change needed, matching the same
// "don't touch the 512-byte record layout without a real consumer
// forcing it" reasoning round 48's companion-file digest already
// established. Same precedent as real Unix's own setuid/setgid/sticky
// bits living above the base 0777 permission bits in a single mode
// word.
fn dharafs_attr_immutable() -> u32 {
  return 0x200 as u32;
}
fn dharafs_attr_append_only() -> u32 {
  return 0x400 as u32;
}
fn dharafs_attr_system() -> u32 {
  return 0x800 as u32;
}
fn dharafs_attr_mask() -> u32 {
  return 0xE00 as u32;
}

fn dharafs_mode_is_immutable(mode: u32) -> i64 {
  return if (mode & dharafs_attr_immutable()) != (0 as u32) { 1 } else { 0 };
}
fn dharafs_mode_is_append_only(mode: u32) -> i64 {
  return if (mode & dharafs_attr_append_only()) != (0 as u32) { 1 } else { 0 };
}

// Both immutable and append-only forbid deleting the file outright --
// matches real chattr +i/+a semantics.
fn dharafs_mode_blocks_delete(mode: u32) -> i64 {
  return if (dharafs_mode_is_immutable(mode) == 1) || (dharafs_mode_is_append_only(mode) == 1) { 1 } else { 0 };
}
// Only immutable blocks being the SOURCE of a rename -- an append-only
// file's content protection travels with it across a rename (real
// chattr +a allows renaming; only +i blocks it).
fn dharafs_mode_blocks_rename_source(mode: u32) -> i64 {
  return dharafs_mode_is_immutable(mode);
}
// Both attributes forbid this record being silently replaced wholesale
// -- an ordinary overwriting write(), or being the DESTINATION of a
// rename -- both are a full content swap, exactly what either
// attribute exists to prevent.
fn dharafs_mode_blocks_overwrite(mode: u32) -> i64 {
  return dharafs_mode_blocks_delete(mode);
}

// True if `new_buf[0:new_len)` is a valid append-only write against
// `old_buf[0:old_len)` -- i.e. the OLD content is an exact byte prefix
// of the new content (this project's storage is log-structured
// "replace with newest full content", not a literal incremental
// write, so "append-only" for a regular file means "the new full
// content still starts with everything that was already there").
fn dharafs_is_valid_append_only_write(old_buf: mut ref i64, old_len: i64, new_buf: mut ref i64, new_len: i64) -> i64 {
  if new_len < old_len {
    return 0;
  }
  let i: i64 = 0;
  while i < old_len {
    if buf_read_byte(old_buf, i as u32) != buf_read_byte(new_buf, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Shared by dharafs_write_raw_checked/dharafs_write_verified_checked
// (both duplicate the same permission-check shape already, see their
// own comments) -- returns 0 - 4 if the write is blocked by an
// attribute, 0 if it's allowed to proceed, leaving the actual
// permission check to the caller. Uses dharafs_appendonly_check_
// scratch (persistent, boot/scratch_state.S) to read the old content
// for the append-only prefix check -- deliberately NOT dharafs_data_
// scratch, which callers already use for the NEW data being written;
// aliasing the two would corrupt the very buffer being compared
// against.
fn dharafs_attr_check_write(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, mode: u32) -> i64 {
  if dharafs_mode_is_immutable(mode) == 1 {
    return 0 - 4;
  }
  if dharafs_mode_is_append_only(mode) == 1 {
    let old_content: mut ref i64 = dharafs_appendonly_check_scratch_get();
    let old_len: i64 = dharafs_read_raw(path_buf, path_len, old_content);
    if old_len < 0 {
      return 0 - 4;
    }
    if dharafs_is_valid_append_only_write(old_content, old_len, data_buf, data_len) == 0 {
      return 0 - 4;
    }
  }
  return 0;
}

fn dharafs_write_raw_checked(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { req_uid };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { req_gid };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { dharafs_default_mode() };
  if stat_status == 0 {
    let attr_status: i64 = dharafs_attr_check_write(path_buf, path_len, data_buf, data_len, mode);
    if attr_status != 0 {
      return attr_status;
    }
    let allowed: i64 = dharafs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
    if allowed == 0 {
      return 0 - 2;
    }
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

fn dharafs_delete_raw_checked(path_buf: mut ref i64, path_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  if dharafs_mode_blocks_delete(mode) == 1 {
    return 0 - 4;
  }
  // Deletion needs write permission, same simplified-from-real-Unix
  // rule dharafs_write_raw_checked's own comment already explains (a real
  // system checks the containing DIRECTORY's write bit, not the
  // file's own -- Dhruva has no directory objects to check instead).
  let allowed: i64 = dharafs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
  if allowed == 0 {
    return 0 - 2;
  }
  return dharafs_delete_raw(path_buf, path_len);
}

// Round 47: permission-enforcing entry point for dharafs_rename_raw (below).
// Renaming removes the OLD path's identity -- same "needs write
// permission" rule dharafs_delete_raw_checked already applies to a plain
// delete. The NEW path gets the SAME check dharafs_write_raw_checked
// already applies when overwriting an existing file: if new_path
// already exists, the caller must have write permission on IT too,
// not just on old_path -- otherwise a user could clobber someone
// else's differently-permissioned file just by renaming their own
// file onto its path. A genuinely new path is always writable (no
// separate check), same policy dharafs_write_raw_checked documents.
// Round 50: also blocked by attributes -- see dharafs_mode_blocks_
// rename_source/dharafs_mode_blocks_overwrite's own comments for
// exactly which attribute blocks which side of a rename.
fn dharafs_rename_raw_checked(old_path_buf: mut ref i64, old_path_len: i64, new_path_buf: mut ref i64, new_path_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(old_path_buf, old_path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  if dharafs_mode_blocks_rename_source(mode) == 1 {
    return 0 - 4;
  }
  let allowed: i64 = dharafs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
  if allowed == 0 {
    return 0 - 2;
  }

  // meta_buf is reused here -- old_path's owner/gid/mode were already
  // captured into the locals above, so overwriting it with new_path's
  // metadata (if any) is safe.
  let new_stat_status: i64 = dharafs_stat_raw(new_path_buf, new_path_len, meta_buf);
  if new_stat_status == 0 {
    let new_owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
    let new_owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
    let new_mode: u32 = buf_read_u32(meta_buf, 8 as u32);
    if dharafs_mode_blocks_overwrite(new_mode) == 1 {
      return 0 - 4;
    }
    let new_allowed: i64 = dharafs_check_permission(new_owner_uid, new_owner_gid, new_mode, req_uid, req_gid, 0, 1, 0);
    if new_allowed == 0 {
      return 0 - 2;
    }
  }

  return dharafs_rename_raw(old_path_buf, old_path_len, new_path_buf, new_path_len);
}

// dharafs_chmod/dharafs_chown: read the file's full current content + whichever
// half of its metadata isn't changing, then re-append with the new
// metadata -- same "read whole, re-append whole" shape dharafs_compact's
// own re-carry already uses, not a new mechanism. Returns -1 if the
// path doesn't exist.
fn dharafs_chmod(path: Str, mode: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat(path, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read(path, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  let path_len: i64 = str_len_bytes(path);
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

fn dharafs_chown(path: Str, uid: u32, gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat(path, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read(path, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  let path_len: i64 = str_len_bytes(path);
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, uid, gid, mode);
}

// BUG (found via a post-round-51 sweep, real security gap, not just a
// heap-safety one): dharafs_chmod/dharafs_chown above have NO
// permission check at all -- any uid could change any file's mode or
// ownership. Both stay unchecked, trusted primitives, same "raw/Str-
// level entry points are unchecked, a real _checked wrapper is the
// enforcement boundary" architecture dharafs_write_raw_checked/
// dharafs_delete_raw_checked/dharafs_rename_raw_checked already
// establish for write/delete/rename -- these two are the same fix for
// the one pair of mutating operations that never got it.
//
// chmod is owner-or-root, matching real POSIX chmod() semantics --
// deliberately NOT governed by the rwx bits themselves (a file's own
// write permission says nothing about who may change ITS permission
// bits).
fn dharafs_chmod_checked(path_buf: mut ref i64, path_len: i64, new_mode: u32, req_uid: u32, _req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  if (req_uid != owner_uid) && (req_uid != (0 as u32)) {
    return 0 - 2;
  }
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read_raw(path_buf, path_len, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, new_mode);
}

// chown is ROOT-ONLY, real strict POSIX default -- unlike chmod, even
// the current owner may not unilaterally give a file away to someone
// else or claim someone else's file, so there's no owner exemption
// here the way chmod has one.
fn dharafs_chown_checked(path_buf: mut ref i64, path_len: i64, new_uid: u32, new_gid: u32, req_uid: u32, _req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  if req_uid != (0 as u32) {
    return 0 - 2;
  }
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read_raw(path_buf, path_len, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, new_uid, new_gid, mode);
}

// Round 50: set/query the immutable/append-only/system attribute bits
// (dharafs_attr_immutable/_append_only/_system) packed into the
// existing `mode` field's high bits. Unlike dharafs_chmod/dharafs_chown
// above (which have NO permission check at all -- a pre-existing gap,
// left alone here since fixing it is out of this round's own scope),
// attribute changes ARE permission-checked: only the file's owner or
// uid 0 (root) may change them at all, and a non-root owner may only
// ADD immutable/append-only, never CLEAR them once set -- matches real
// chattr's own CAP_LINUX_IMMUTABLE requirement to remove +i/+a (root
// can always undo either). The SYSTEM attribute has no enforcement
// behavior of its own in this v1 (informational/identification only),
// so it's exempt from the no-clearing rule.
// req_gid is intentionally unused -- matches real chattr's own model,
// which grants attribute-change rights to the file's OWNER or root
// only, never via group membership (unlike the rwx permission model
// dharafs_check_permission implements elsewhere).
fn dharafs_set_attr_raw(path_buf: mut ref i64, path_len: i64, new_attr_bits: u32, req_uid: u32, _req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  let is_owner: i64 = if req_uid == owner_uid { 1 } else { 0 };
  let is_root: i64 = if req_uid == (0 as u32) { 1 } else { 0 };
  if (is_owner == 0) && (is_root == 0) {
    return 0 - 2;
  }
  let current_attr: u32 = mode & dharafs_attr_mask();
  let requested_attr: u32 = new_attr_bits & dharafs_attr_mask();
  if is_root == 0 {
    let clearing_immutable: i64 = if ((current_attr & dharafs_attr_immutable()) != (0 as u32)) && ((requested_attr & dharafs_attr_immutable()) == (0 as u32)) { 1 } else { 0 };
    let clearing_append: i64 = if ((current_attr & dharafs_attr_append_only()) != (0 as u32)) && ((requested_attr & dharafs_attr_append_only()) == (0 as u32)) { 1 } else { 0 };
    if (clearing_immutable == 1) || (clearing_append == 1) {
      return 0 - 2;
    }
  }
  let not_attr_mask: u32 = dharafs_attr_mask() ^ (0xFFFFFFFF as u32);
  let new_mode: u32 = (mode & not_attr_mask) | requested_attr;

  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read_raw(path_buf, path_len, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  return dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, new_mode);
}

fn dharafs_get_attr_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  return (mode & dharafs_attr_mask()) as i64;
}

// Core lookup against a raw path buffer, not Str -- same reasoning as
// dharafs_append_raw: task #5's compaction only ever has a path it just
// read out of someone else's record, with no Str form to construct
// from arbitrary bytes.  The block number of the newest valid record
// matching the path at path_buf[0:path_len), or -1 if none exists.
fn dharafs_find_latest_block_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  // Fast path: the hashed directory index (boot/dirindex_state.S) is
  // kept exactly in sync with every write that reaches this path
  // (dharafs_append_raw/dharafs_delete_raw upsert on success,
  // dharafs_init rebuilds it at boot) -- a HIT is always correct and
  // returned directly, no scan needed. A MISS falls through to the
  // exact same linear scan this function has always done (never a
  // regression), which then self-heals the index below so the same
  // path is fast on every subsequent lookup.
  let cached_block: i64 = dharafs_dirindex_lookup_raw(path_buf, path_len);
  if cached_block >= 0 {
    return cached_block;
  }

  let next_block: u32 = dharafs_state_get_next_block();
  let log_start: u32 = dharafs_state_get_log_start();
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let best_block: i64 = 0 - 1;
  let best_seq: u32 = 0 as u32;
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      // Same "checksum match alone isn't enough" reasoning as
      // dharafs_init's recovery scan -- see that comment for why seq_num
      // != 0 is required too.
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        if (rec_path_len as i64) == path_len {
          let matches: i64 = 1;
          let k: i64 = 0;
          while k < path_len {
            let want: u32 = buf_read_byte(path_buf, k as u32);
            let got: u32 = buf_read_byte(buf, (12 + k) as u32);
            if got != want {
              matches = 0;
            }
            k = k + 1;
          }
          if matches == 1 {
            if rec_seq >= best_seq {
              best_seq = rec_seq;
              best_block = blk;
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  if best_block >= 0 {
    // Self-heal: this path wasn't indexed yet (a table-full skip, or
    // simply never written through a hook that upserts) -- now that
    // the scan found it the honest way, index it so next time is fast.
    let _ = dharafs_dirindex_upsert_raw(path_buf, path_len, best_block);
  }
  return best_block;
}

// Shared by dharafs_read and task #5's compaction -- exactly the "what's
// actually live" query compaction needs to know what's safe to
// reclaim.
fn dharafs_find_latest_block(path: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  // No record could ever have a path this long (dharafs_append rejects it
  // at write time) -- reject here too, before the copy below would
  // overrun the fixed 32-byte temp buffer.
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_find_latest_block_raw(path_buf, path_len);
}

// Same scan as dharafs_find_latest_block_raw, but (a) constrained to
// records with rec_seq <= max_seq (the "as of this snapshot" filter)
// and (b) starting at block 1, not dharafs_state_get_log_start() --
// see boot/snapshot_state.S's own header comment for why that's safe
// and necessary: log_start hides old blocks from ORDINARY lookups
// once compaction runs, but never actually erases them, and a
// snapshot's whole point is to still be able to see what compaction
// has since hidden. Deliberately does NOT consult the hashed
// directory index (dirindex only ever tracks the single current
// latest block per path, not historical versions) -- always a full
// scan, which is fine for a cold, infrequent snapshot-query
// operation, unlike the hot path dirindex accelerates.
fn dharafs_find_block_as_of_raw(path_buf: mut ref i64, path_len: i64, max_seq: u32) -> i64 {
  let next_block: u32 = dharafs_state_get_next_block();
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let best_block: i64 = 0 - 1;
  let best_seq: u32 = 0 as u32;
  let blk: i64 = 1;
  while (blk as u32) < next_block {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) && (rec_seq <= max_seq) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        if (rec_path_len as i64) == path_len {
          let matches: i64 = 1;
          let k: i64 = 0;
          while k < path_len {
            let want: u32 = buf_read_byte(path_buf, k as u32);
            let got: u32 = buf_read_byte(buf, (12 + k) as u32);
            if got != want {
              matches = 0;
            }
            k = k + 1;
          }
          if matches == 1 {
            if rec_seq >= best_seq {
              best_seq = rec_seq;
              best_block = blk;
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return best_block;
}

fn snapshot_max_slots() -> i64 { return 8; }
fn snapshot_max_name_bytes() -> i64 { return 32; }

fn dharafs_snapshot_reset() -> i64 {
  let i: i64 = 0;
  while i < snapshot_max_slots() {
    let _ = snapshot_valid_set_at(i as u32, 0 as u32);
    i = i + 1;
  }
  return 0;
}

fn dharafs_snapshot_find_by_name_raw(name_buf: mut ref i64, name_len: i64) -> i64 {
  let i: i64 = 0;
  while i < snapshot_max_slots() {
    if snapshot_valid_get_at(i as u32) == 1 {
      if snapshot_name_len_get_at(i as u32) == name_len {
        let matches: i64 = 1;
        let k: i64 = 0;
        while k < name_len {
          let want: u32 = buf_read_byte(name_buf, k as u32);
          let got: u32 = snapshot_get_name_byte((i * snapshot_max_name_bytes() + k) as u32) as u32;
          if got != want {
            matches = 0;
          }
          k = k + 1;
        }
        if matches == 1 {
          return i;
        }
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

// Pins `name` to the highest sequence number that genuinely exists
// right now (dharafs_state_get_next_seq() - 1; 0 on a completely
// empty filesystem, matching the "every real record's seq is >= 1"
// convention already established elsewhere). Rejects a duplicate
// name outright (reject, don't guess which one the caller meant) --
// dharafs_snapshot_delete_raw first if the intent is to replace it.
// Returns the slot index on success, -1 on a bad name / duplicate /
// full table (8 slots).
fn dharafs_snapshot_create_raw(name_buf: mut ref i64, name_len: i64) -> i64 {
  if (name_len <= 0) || (name_len > snapshot_max_name_bytes()) {
    return 0 - 1;
  }
  if dharafs_snapshot_find_by_name_raw(name_buf, name_len) >= 0 {
    return 0 - 1;
  }
  let slot: i64 = 0 - 1;
  let i: i64 = 0;
  while i < snapshot_max_slots() {
    if (slot < 0) && (snapshot_valid_get_at(i as u32) == 0) {
      slot = i;
    }
    i = i + 1;
  }
  if slot < 0 {
    return 0 - 1;
  }
  let next_seq: u32 = dharafs_state_get_next_seq();
  let pinned_seq: u32 = if next_seq > (0 as u32) { next_seq - (1 as u32) } else { 0 as u32 };
  let _ = snapshot_pinned_seq_set_at(slot as u32, pinned_seq);
  let _ = snapshot_name_len_set_at(slot as u32, name_len as u32);
  let k: i64 = 0;
  while k < name_len {
    let b: u32 = buf_read_byte(name_buf, k as u32);
    let _ = snapshot_set_name_byte((slot * snapshot_max_name_bytes() + k) as u32, b);
    k = k + 1;
  }
  let _ = snapshot_valid_set_at(slot as u32, 1 as u32);
  return slot;
}

fn dharafs_snapshot_delete_raw(name_buf: mut ref i64, name_len: i64) -> i64 {
  let slot: i64 = dharafs_snapshot_find_by_name_raw(name_buf, name_len);
  if slot < 0 {
    return 0 - 1;
  }
  let _ = snapshot_valid_set_at(slot as u32, 0 as u32);
  return 0;
}

// -1 if `name` isn't a known snapshot, else its pinned sequence
// number -- exposed mainly for introspection/tests; real callers
// normally go straight through dharafs_snapshot_read_raw below.
fn dharafs_snapshot_pinned_seq_raw(name_buf: mut ref i64, name_len: i64) -> i64 {
  let slot: i64 = dharafs_snapshot_find_by_name_raw(name_buf, name_len);
  if slot < 0 {
    return 0 - 1;
  }
  return snapshot_pinned_seq_get_at(slot as u32);
}

// Reads `path`'s content exactly AS OF the moment `name` was created
// -- -1 if the snapshot name is unknown, or if `path` had no live
// (non-tombstoned) record for it at that moment (never written yet
// by then, or already deleted by then -- both indistinguishable from
// "doesn't exist as of this snapshot," same posture dharafs_read_raw
// already takes for the current-time case). A later write or delete
// to `path` after the snapshot was taken never changes what this
// returns -- that's the entire point.
fn dharafs_snapshot_read_raw(path_buf: mut ref i64, path_len: i64, name_buf: mut ref i64, name_len: i64, out_buf: mut ref i64) -> i64 {
  let slot: i64 = dharafs_snapshot_find_by_name_raw(name_buf, name_len);
  if slot < 0 {
    return 0 - 1;
  }
  let pinned_seq: u32 = snapshot_pinned_seq_get_at(slot as u32) as u32;
  let blk: i64 = dharafs_find_block_as_of_raw(path_buf, path_len, pinned_seq);
  if blk < 0 {
    return 0 - 1;
  }
  return dharafs_read_from_block_raw(blk, out_buf);
}

// Str convenience wrappers, same relationship to the _raw functions
// above as dharafs_append has to dharafs_append_raw.
fn dharafs_snapshot_create(name: Str) -> i64 {
  let name_len: i64 = str_len_bytes(name);
  if (name_len <= 0) || (name_len > 32) {
    return 0 - 1;
  }
  let name_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < name_len {
    let _ = buf_write_byte(name_buf, i as u32, str_byte_at(name, i) as u32);
    i = i + 1;
  }
  return dharafs_snapshot_create_raw(name_buf, name_len);
}

fn dharafs_snapshot_delete(name: Str) -> i64 {
  let name_len: i64 = str_len_bytes(name);
  if (name_len <= 0) || (name_len > 32) {
    return 0 - 1;
  }
  let name_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < name_len {
    let _ = buf_write_byte(name_buf, i as u32, str_byte_at(name, i) as u32);
    i = i + 1;
  }
  return dharafs_snapshot_delete_raw(name_buf, name_len);
}

// Reads path's content as of snapshot `name` into out_buf, returning
// the data length or -1 (see dharafs_snapshot_read_raw). Uses TWO
// independent scratch buffers (path and name are both live at once
// here, unlike every other Str wrapper in this file) -- dharafs_path_
// scratch for path, dharafs_dir_scratch for name (borrowed: same
// "stable across one whole call, no other concurrent user" reasoning
// scratch_state.S's own header comment already established for it,
// and this function never calls anything that itself uses dharafs_
// dir_scratch).
fn dharafs_snapshot_read(path: Str, name: Str, out_buf: mut ref i64) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  let name_len: i64 = str_len_bytes(name);
  if (path_len <= 0) || (path_len > 32) {
    return 0 - 1;
  }
  if (name_len <= 0) || (name_len > 32) {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  let name_buf: mut ref i64 = dharafs_dir_scratch_get();
  let j: i64 = 0;
  while j < name_len {
    let _ = buf_write_byte(name_buf, j as u32, str_byte_at(name, j) as u32);
    j = j + 1;
  }
  return dharafs_snapshot_read_raw(path_buf, path_len, name_buf, name_len, out_buf);
}

// Task #5: garbage collection / log compaction, run periodically from
// a dedicated low-priority background task (task_gc), never on the
// hard-RT path. Scans the current live region [log_start, next_block)
// -- round 77: across as many resumed calls as it takes, at most
// dharafs_compact_blocks_per_call() blocks of real work each call, see
// this function's own "Round 77" comment below for the full resumable
// design; a short region still finishes in one call exactly as before.
// Any record that ISN'T the latest for its path (dharafs_find_latest_
// block_raw returns some OTHER block) is dead -- superseded by a
// later write already in the log. Every record that IS still live
// gets re-appended (through the exact same crash-safe dharafs_append_raw
// every normal write goes through) into fresh blocks past the
// current end of the log, and only once every live record has been
// safely re-appended does log_start move forward past the entire
// old region -- at that point everything before it is provably dead
// (an equivalent live copy exists beyond it) and stops being scanned
// by dharafs_read/dharafs_find_latest_block_raw for the rest of this boot.
//
// Deliberately NOT free-space reuse: blocks before log_start are
// abandoned, never reclaimed for new writes, in this v1 -- turning
// this into a true circular log (wrapping around to actually reuse
// that space) is real future work, not needed to demonstrate the
// architectural property DHRUVA_ARCHITECTURE.md actually asks for
// here (compaction running safely off the hard-RT path). Also NOT
// persisted across reboots (see dharafs_state.S's dharafs_log_start comment) --
// a crash between this compaction's re-appends finishing and its
// final log_start update just means one boot's recovery rescans a
// prefix it didn't strictly need to, never a correctness problem,
// since "latest wins" already tolerates the old and new copies of a
// record coexisting.
// buf/path_buf/data_buf are caller-owned scratch space (512/32/4096
// bytes respectively -- data_buf's cap raised in round 39 to hold a
// full multi-block file's reconstructed content, see dharafs_read_raw),
// not allocated in here.
//
// BUG (found via a real crash-and-reboot loop under Phase 6's
// checkpoint regression test, not by inspection): this function used
// to call dhruva_alloc_bytes for all three buffers itself, on every
// single call. dhruva_alloc_bytes is a bump allocator that never
// frees (see runtime_stubs.c's own doc comment -- by design, for
// once-at-boot task-stack allocation) -- fine for a function called
// once, but dharafs_compact() is task_e/GC's main per-pass work, called
// every 20 ticks for as long as the system runs. Once the log grew
// past the "not worth compacting yet" threshold below, every
// subsequent pass leaked another 512+32+464 = 1008 bytes permanently.
// Against the 64KB kernel heap, a long-running session (tens of
// seconds of continuous GC wakeups, easily reached once Phase 6 added
// enough boot-time work to make longer test runs routine) eventually
// exhausted it; dhruva_alloc_bytes returned null, and this function
// wrote straight through it with zero null check -- corrupting
// address 0 (the vector table), so the next interrupt jumped through
// garbage and the whole system reset. Passing the same three buffers
// in from each caller (task_e allocates its copy once, alongside its
// existing gc_buf; kernel_main's own one-off self-test call does the
// same) makes this function's heap footprint bounded regardless of
// how many times it runs.
//
// Round 77: the per-call block budget for dharafs_compact's own
// resumable scan (see that function's own comment) -- a named
// constant rather than a bare literal so the bound is self-documenting
// at every call site that might reason about it (e.g. a future WCET
// annotation). 8 blocks of real SD I/O per call, chosen the same way
// this function's own pre-existing "not worth it below 4 blocks"
// threshold was: small enough that even several tick's worth of
// compaction work stays a bounded, short slice of task_e's own 20-tick
// period, large enough that a typical pass (this project's own
// exercised scale: tens of blocks between passes) still finishes in a
// small handful of calls, not dozens.
fn dharafs_compact_blocks_per_call() -> i64 {
  return 8;
}

fn dharafs_compact(buf: mut ref i64, path_buf: mut ref i64, data_buf: mut ref i64) -> i64 {
  let log_start: u32 = dharafs_state_get_log_start();
  let old_next_block: u32 = dharafs_state_get_next_block();

  // Not worth the SD traffic on a short log -- stay genuinely
  // low-cost when there's nothing meaningful to reclaim yet. Only
  // checked when NOT already resuming a partial pass -- see the
  // resume-cursor logic just below for why a resumed pass must run
  // even if this specific check would otherwise skip it.
  let resume_block: u32 = dharafs_compact_get_resume_block();
  if resume_block == (0 as u32) {
    if (old_next_block - log_start) < (4 as u32) {
      return 0;
    }
  }

  // Round 77: docs/RTOS_GAP_ANALYSIS.md's own "dharafs_compact() has
  // unbounded worst-case cost" gap -- this used to scan every block
  // from log_start to next_block in ONE call, a real SD I/O operation
  // per block, with cost scaling however much log had accumulated
  // since the last pass. task_e calls this every 20 ticks
  // unconditionally, so an unbounded single pass directly undermines
  // any WCET claim for whatever else is scheduled around it.
  //
  // Now resumable and bounded to DHARAFS_COMPACT_BLOCKS_PER_CALL
  // blocks of real work per call: resume_block (0 = no partial pass in
  // progress, start fresh from log_start; block 0 is reserved and
  // never a real scan target, see dharafs_next_block's own comment,
  // so it's a safe sentinel) picks up exactly where a prior call's own
  // budget ran out. old_next_block itself is re-read fresh (above)
  // every call, including resumed ones -- it only ever grows (real
  // writes keep advancing it), so a resumed pass simply covers
  // slightly more ground by the time it finishes, never less; the
  // underlying carry-forward logic is naturally safe to interrupt and
  // resume this way, since it re-checks "is THIS block still the
  // CURRENT latest copy" every time rather than working off a
  // once-computed table -- a block already carried forward by an
  // earlier partial call is simply found no-longer-latest (its new
  // copy lives past old_next_block) and skipped harmlessly if
  // re-scanned.
  //
  // dharafs_compact_failed is the STICKY equivalent of the local
  // all_ok below, persisted ACROSS resumed calls (unlike all_ok
  // itself, which only lives for one call's own partial scan) --
  // reset to 0 only when a genuinely fresh pass starts (resume_block
  // was 0), so a failure from an old, already-finished pass can never
  // leak into blocking a new one from advancing log_start.
  if resume_block == (0 as u32) {
    let _ = dharafs_compact_set_failed(0 as u32);
  }
  let start_blk: u32 = if resume_block == (0 as u32) { log_start } else { resume_block };

  // BUG (round 7 audit, 2026-08-27): every carry-forward write below
  // used to discard its own return status (`let _ = dharafs_append_raw(...)`
  // / `let _ = dharafs_delete_raw(...)`), and log_start advanced past
  // old_next_block unconditionally once the scan finished -- regardless
  // of whether any of those re-appends actually succeeded. Once
  // log_start moves forward, the old copy of a record stops being
  // scanned by dharafs_read/dharafs_find_latest_block_raw/dharafs_list for the rest
  // of this boot (see this function's own header comment on why that's
  // normally safe: an equivalent live copy exists beyond it). If a
  // single SD write genuinely failed mid-pass -- round 5's audit fixed
  // sdhost_write_block to actually detect that instead of silently
  // reporting success, so this is now a real, live-detectable failure
  // mode, not a hypothetical one -- the "equivalent live copy" premise
  // is false: the new copy was never written, the old copy is about to
  // become unreachable anyway, and that record's data is gone for good.
  // Fixed by tracking every carry-forward's actual result and only
  // advancing log_start if the whole pass was clean; a single failure
  // leaves log_start where it was, so the old (still valid) copies stay
  // reachable and the next compaction pass gets another chance.
  let all_ok: i64 = if dharafs_compact_get_failed() == (0 as u32) { 1 } else { 0 };
  let blk: i64 = start_blk as i64;
  let scanned: i64 = 0;
  while ((blk as u32) < old_next_block) && (scanned < dharafs_compact_blocks_per_call()) {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        // BUG (found via audit, 2026-08-27): rec_path_len/rec_data_len
        // are on-disk fields covered by the checksum just verified
        // above, so a random bit-flip or torn write is already very
        // likely to be caught there -- but buf_checksum is a simple
        // rotate-mix, not a cryptographic/collision-resistant hash,
        // so a checksum match is strong evidence, not a proof, that
        // these fields weren't corrupted into something out of range.
        // Both used to feed straight into a copy-loop bound with only
        // the tombstone-sentinel check below, no explicit range check
        // against path_buf/data_buf's own real capacity -- the exact
        // same "trust a length field, no bound" shape as the
        // networking-layer bugs found earlier the same day, just with
        // corrupted disk data playing the untrusted-input role instead
        // of a hostile network segment. Skip the record entirely (same
        // as failing the checksum check) rather than guess at
        // truncating it.
        //
        // Round 39: rec_path_len == 0 marks a CONTINUATION block (see
        // dharafs_init's own header comment) -- skip it here unconditionally.
        // It's never independently live/dead; it gets carried forward
        // correctly as part of its own HEAD block's dharafs_read_raw/
        // dharafs_append_raw round trip below, not by being re-appended on
        // its own (which would be meaningless -- a continuation has no
        // path to look up or preserve identity for).
        if (rec_path_len > (0 as u32)) && (rec_path_len <= (32 as u32)) {
        let k: i64 = 0;
        while (k as u32) < rec_path_len {
          let pb: u32 = buf_read_byte(buf, (12 + k) as u32);
          let _ = buf_write_byte(path_buf, k as u32, pb);
          k = k + 1;
        }
        let latest_blk: i64 = dharafs_find_latest_block_raw(path_buf, rec_path_len as i64);
        if latest_blk == blk {
          // This IS the live copy for its path -- carry it forward.
          // dharafs_append_raw always targets dharafs_state_get_next_block(),
          // which by now is already past old_next_block (every
          // earlier iteration's re-append only ever grows it), so
          // this can never write back into the region still being
          // scanned.
          let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
          if rec_data_len == (0xFFFFFFFF as u32) {
            // A live tombstone (dharafs_delete's newest record for this
            // path) -- carry it forward AS a tombstone, not as a
            // 4-billion-byte "data" copy. Missing this case doesn't
            // just mis-handle a delete: rec_data_len is read directly
            // into the loop bound below when it's a real record, so
            // treating the sentinel as a genuine length turns this
            // into an unbounded copy loop that reads/writes far past
            // data_buf's real allocation -- a real hang (found by GC
            // silently never completing a pass again once this path
            // was ever exercised), not merely a logic error that
            // happens to still terminate wrong.
            let del_status: i64 = dharafs_delete_raw(path_buf, rec_path_len as i64);
            if del_status != 0 {
              all_ok = 0;
            }
          } else {
            // Round 39: this HEAD block may chain across several
            // blocks now -- reconstruct the FULL logical content via
            // dharafs_read_raw (the same chain-following, checksum-
            // verifying logic every other caller uses) rather than
            // copying just this one block's own up-to-448-byte chunk,
            // which would silently truncate any multi-block record.
            // dharafs_read_raw's own internal dharafs_sd_scratch use doesn't
            // conflict with `buf` here -- separate, caller-owned
            // buffers, and this block's own fields have already been
            // read out above before this call.
            let full_len: i64 = dharafs_read_raw(path_buf, rec_path_len as i64, data_buf);
            if full_len < 0 {
              all_ok = 0;
            } else {
              // Round 42: preserve the existing owner/group/mode --
              // compaction relocates a record's storage, it must never
              // change who owns it or what it's permitted for. `buf`
              // here is still this HEAD block as read off the card
              // (rec_path_len/etc. above were read from it directly),
              // so its owner_uid/owner_gid/mode fields are still the
              // real, current ones.
              let rec_uid: u32 = buf_read_u32(buf, 52 as u32);
              let rec_gid: u32 = buf_read_u32(buf, 56 as u32);
              let rec_mode: u32 = buf_read_u32(buf, 60 as u32);
              let append_status: i64 = dharafs_append_raw(path_buf, rec_path_len as i64, data_buf, full_len, rec_uid, rec_gid, rec_mode);
              if append_status != 0 {
                all_ok = 0;
              }
            }
          }
        }
        }
      }
    }
    blk = blk + 1;
    scanned = scanned + 1;
  }

  if all_ok == 0 {
    let _ = dharafs_compact_set_failed(1 as u32);
  }

  if (blk as u32) >= old_next_block {
    // The whole [log_start, old_next_block) range has now been
    // scanned -- possibly across several resumed calls. Everything
    // before old_next_block now has an equivalent live copy at or
    // beyond it (or was already dead) -- safe to stop scanning. Only
    // true if every carry-forward across the WHOLE pass actually
    // succeeded (dharafs_compact_failed, not just this one call's own
    // all_ok) -- a single failure anywhere in the pass leaves its only
    // copy in the region about to be abandoned, so log_start must stay
    // put in that case rather than orphan it. Either way, the pass is
    // now genuinely done: reset both persisted fields so the next
    // dharafs_compact call starts a fresh pass rather than "resuming"
    // a finished one.
    if all_ok == 1 {
      let _ = dharafs_state_set_log_start(old_next_block);
    }
    let _ = dharafs_compact_set_resume_block(0 as u32);
    let _ = dharafs_compact_set_failed(0 as u32);
  } else {
    // Hit this call's own block budget before reaching old_next_block
    // -- remember exactly where to pick up next time. log_start does
    // NOT move yet; dharafs_compact_failed already persisted above if
    // this call found a problem, so a later call's own success can't
    // paper over it.
    let _ = dharafs_compact_set_resume_block(blk as u32);
  }
  return 0;
}

// Round 77: live proof that dharafs_compact's own per-call budget is
// genuinely enforced -- not just that the code type-checks. Writes the
// SAME path 20 times (each dharafs_append call to an already-written
// path leaves the PREVIOUS record dead the instant a newer one
// supersedes it, per this whole log's own "latest wins" design -- see
// dharafs_compact's own header comment), guaranteeing a compaction
// range of at least 20 blocks, comfortably past
// dharafs_compact_blocks_per_call()'s own budget of 8.
fn dharafs_compact_resumable_self_test() -> i64 {
  let ok: i64 = 1;

  let writes: i64 = 0;
  while writes < 20 {
    let _ = dharafs_append("/compacttest/file", "x");
    writes = writes + 1;
  }
  let target_next_block: u32 = dharafs_state_get_next_block();

  let buf: mut ref i64 = dhruva_alloc_bytes(512);
  let path_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let data_buf: mut ref i64 = dhruva_alloc_bytes(4096);

  // First call: with >= 20 blocks of range and an 8-block budget, this
  // must NOT finish the whole pass in one call.
  let _ = dharafs_compact(buf, path_buf, data_buf);
  if dharafs_compact_get_resume_block() == (0 as u32) {
    ok = 0; // finished in one call -- the budget isn't actually enforced
  }
  if dharafs_state_get_log_start() == target_next_block {
    ok = 0; // log_start shouldn't have reached the final target yet
  }

  // Keep calling until the pass genuinely finishes (resume cursor
  // returns to 0), bounded generously so a real non-progress bug fails
  // this self-test instead of hanging boot forever.
  let calls: i64 = 1;
  while (dharafs_compact_get_resume_block() != (0 as u32)) && (calls < 10) {
    let _ = dharafs_compact(buf, path_buf, data_buf);
    calls = calls + 1;
  }
  if dharafs_compact_get_resume_block() != (0 as u32) {
    ok = 0; // never finished within a generous call budget
  }
  if calls <= 1 {
    ok = 0; // sanity: this whole test is meaningless if it somehow
            // only took the one call already checked above
  }

  // Data must still be correct after a multi-call compaction pass --
  // the whole point is bounding cost, never losing or corrupting data
  // along the way.
  let read_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let read_len: i64 = dharafs_read("/compacttest/file", read_buf);
  if read_len != 1 {
    ok = 0;
  } else {
    let c: u32 = buf_read_byte(read_buf, 0 as u32);
    if c != (120 as u32) { // 'x'
      ok = 0;
    }
  }

  let _ = uart_puts("DharaFS: dharafs_compact resumes across multiple bounded calls for a log larger than its per-call budget");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Raw-buffer core, shared by dharafs_read (below) and anything else that
// only has a path as raw bytes (task #9's shell, over UART into
// shell_line_buf, with no Str form to build from arbitrary runtime
// bytes) -- same reasoning as dharafs_append_raw/dharafs_find_latest_block_raw.
// Copies the newest valid record's FULL logical data for `path` into
// out_buf, following the record's own next_block chain (round 39) if
// it spans more than one block, returning the total data length, or
// -1 if no valid record exists at all (never written, its newest
// record is a tombstone, or the chain is corrupt/broken -- reject the
// whole read rather than silently return a truncated prefix, same
// "reject, don't guess" posture as every other bounds check this
// project's storage/networking layers use).
// Round 42: writes the newest valid record's owner_uid/owner_gid/mode
// into meta_buf ([0:4)/[4:8)/[8:12)), or returns -1 if no valid record
// for that path exists. Shares dharafs_find_latest_block_raw's own lookup
// with dharafs_read_raw -- deliberately NOT folded into dharafs_read_raw itself
// (which already has plenty of parameters and a hot, chain-following
// loop); most callers need data OR metadata, rarely both in the same
// call, so a second small lookup here is simpler than threading an
// optional out-param through the read path for the common case that
// doesn't need it.
fn dharafs_stat_raw(path_buf: mut ref i64, path_len: i64, meta_buf: mut ref i64) -> i64 {
  let blk: i64 = dharafs_find_latest_block_raw(path_buf, path_len);
  if blk < 0 {
    return 0 - 1;
  }
  let tmp: mut ref i64 = dharafs_sd_scratch_get();
  let rd_status: i64 = dharafs_block_read(blk, tmp);
  if rd_status != 0 {
    return 0 - 1;
  }
  let data_len: u32 = buf_read_u32(tmp, 44 as u32);
  if data_len == (0xFFFFFFFF as u32) {
    return 0 - 1; // tombstone -- deleted, same as dharafs_read_raw's own check
  }
  let _ = buf_write_u32(meta_buf, 0 as u32, buf_read_u32(tmp, 52 as u32));
  let _ = buf_write_u32(meta_buf, 4 as u32, buf_read_u32(tmp, 56 as u32));
  let _ = buf_write_u32(meta_buf, 8 as u32, buf_read_u32(tmp, 60 as u32));
  return 0;
}

fn dharafs_stat(path: Str, meta_buf: mut ref i64) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len <= 0 {
    return 0 - 1;
  }
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_stat_raw(path_buf, path_len, meta_buf);
}

fn dharafs_read_raw(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64) -> i64 {
  let blk: i64 = dharafs_find_latest_block_raw(path_buf, path_len);
  if blk < 0 {
    return 0 - 1;
  }
  return dharafs_read_from_block_raw(blk, out_buf);
}

// Extracted from dharafs_read_raw (round 66 follow-up, snapshots):
// everything after "which block is this?" is resolved -- reads and
// chain-follows the FULL logical record starting at a caller-supplied
// block number, instead of always deriving it from dharafs_find_
// latest_block_raw. dharafs_read_raw itself is now a thin wrapper
// (unchanged behavior, verified against the full existing read/chain
// test suite); dharafs_snapshot_read_raw is the other caller, handing
// it a HISTORICAL block found via dharafs_find_block_as_of_raw
// instead of the current latest.
fn dharafs_read_from_block_raw(blk: i64, out_buf: mut ref i64) -> i64 {
  let tmp: mut ref i64 = dharafs_sd_scratch_get();
  let rd_status: i64 = dharafs_block_read(blk, tmp);
  if rd_status != 0 {
    return 0 - 1;
  }
  let total_len: u32 = buf_read_u32(tmp, 44 as u32);
  if total_len == (0xFFFFFFFF as u32) {
    return 0 - 1;
  }
  // BUG (found via audit, 2026-08-27): data_len is an on-disk field
  // covered by dharafs_find_latest_block_raw's own checksum validation,
  // but a checksum match is strong evidence, not proof, against
  // corruption (buf_checksum is a simple rotate-mix, not collision-
  // resistant) -- and out_buf's own real capacity is entirely up to
  // the caller regardless. Reject rather than trust an out-of-range
  // length as a copy-loop bound.
  if (total_len as i64) > dharafs_file_max_len() {
    return 0 - 1;
  }
  let cap: i64 = dharafs_block_payload_cap();
  let total_len_i: i64 = total_len as i64;
  let head_chunk: i64 = if total_len_i < cap { total_len_i } else { cap };
  let i: i64 = 0;
  while i < head_chunk {
    let b: u32 = buf_read_byte(tmp, (64 + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let copied: i64 = head_chunk;
  let remaining: i64 = total_len_i - head_chunk;
  let next_blk: i64 = buf_read_u32(tmp, 48 as u32) as i64;

  // Round 39: follow the chain for anything past the head's own
  // 448-byte chunk (Round 42 shrank the per-block payload cap from
  // 460 to make room for owner_uid/owner_gid/mode). Every continuation
  // block gets the SAME "reject,
  // don't guess" checksum/sentinel validation as any other record --
  // a broken or corrupted chain fails the whole read rather than
  // silently handing back a truncated prefix.
  while remaining > 0 {
    if next_blk == 0 {
      return 0 - 1; // chain ended early -- corrupt/broken, reject
    }
    let cont: mut ref i64 = dharafs_sd_scratch_get();
    if dharafs_block_read(next_blk, cont) != 0 {
      return 0 - 1;
    }
    let stored_checksum: u32 = buf_read_u32(cont, 0 as u32);
    let computed_checksum: u32 = buf_checksum(cont, 4 as u32, 508 as u32);
    let cont_seq: u32 = buf_read_u32(cont, 4 as u32);
    if (stored_checksum != computed_checksum) || (cont_seq == (0 as u32)) {
      return 0 - 1;
    }
    let cont_path_len: u32 = buf_read_u32(cont, 8 as u32);
    if cont_path_len != (0 as u32) {
      return 0 - 1; // not a continuation marker -- chain is wrong
    }
    let cont_len: i64 = buf_read_u32(cont, 44 as u32) as i64;
    // BUG (found via host-side ASAN/UBSAN harness, 2026-08-29): this used
    // to accept cont_len == 0 (the `< 0` half of this check is dead code
    // in the first place -- a u32-read-then-cast-to-i64 can never be
    // negative). No REAL append path ever writes a zero-length
    // continuation chunk (every genuine chunk's own length is > 0 by
    // construction in dharafs_append_raw's multi-block split), but a
    // corrupted or deliberately adversarial disk image can contain one
    // -- and `this_chunk` below would then be 0, `remaining` would never
    // decrease, and a `next_block` field pointing back into the chain
    // (even at just this same block) turns this loop into a genuine
    // infinite loop / hang, not merely a logic error that still
    // terminates wrong. Rejecting cont_len <= 0 closes it: every real
    // chain still reads correctly (see this comment's own reasoning for
    // why a real chunk is always > 0), and a malformed one now fails
    // the read instead of hanging the caller forever.
    if (cont_len <= 0) || (cont_len > cap) {
      return 0 - 1;
    }
    let this_chunk: i64 = if cont_len < remaining { cont_len } else { remaining };
    let k: i64 = 0;
    while k < this_chunk {
      let b2: u32 = buf_read_byte(cont, (64 + k) as u32);
      let _ = buf_write_byte(out_buf, (copied + k) as u32, b2);
      k = k + 1;
    }
    copied = copied + this_chunk;
    remaining = remaining - this_chunk;
    next_blk = buf_read_u32(cont, 48 as u32) as i64;
  }
  return total_len_i;
}

// Copies the newest valid record's data bytes for `path` into
// out_buf, returning the data length, or -1 if no valid record for
// that path exists at all (never written, or its newest record is a
// tombstone -- see dharafs_delete). Thin Str-to-raw-buffer wrapper around
// dharafs_read_raw -- the two used to duplicate the entire read/chain-
// follow logic; consolidated once round 39's chain-following made
// that duplication a real maintenance risk, not just a stylistic one.
fn dharafs_read(path: Str, out_buf: mut ref i64) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len <= 0 {
    return 0 - 1;
  }
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_read_raw(path_buf, path_len, out_buf);
}

// dharafs_delete: appends a tombstone record for `path` -- a normal,
// crash-safe log entry (same checksum/sequence-number machinery as
// any other write) whose data_len field is the sentinel 0xFFFFFFFF,
// a value no genuine record can ever have (a file's total length is
// capped at dharafs_file_max_len(), 4096 bytes as of round 39). dharafs_read/
// dharafs_list treat the newest tombstone for a path
// exactly like the path never existed; compaction (dharafs_compact) can
// still find and re-carry a tombstone forward as "the latest record"
// for its path like any other -- deleting something, then compacting,
// correctly keeps it deleted rather than resurrecting an older
// pre-delete version.
fn dharafs_delete_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  if path_len <= 0 {
    return 1; // same reserved-sentinel reasoning as dharafs_append_raw
  }
  if path_len > 32 {
    return 1;
  }
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let next_block: u32 = dharafs_state_get_next_block();
  let next_seq: u32 = dharafs_state_get_next_seq();

  let _ = buf_write_u32(buf, 4 as u32, next_seq);
  let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
  let i: i64 = 0;
  while i < path_len {
    let b: u32 = buf_read_byte(path_buf, i as u32);
    let _ = buf_write_byte(buf, (12 + i) as u32, b);
    i = i + 1;
  }
  let _ = buf_write_u32(buf, 44 as u32, 0xFFFFFFFF as u32);
  // Round 39: a tombstone never chains -- but buf is dharafs_sd_scratch, a
  // PERSISTENT reused buffer, so this field must be written explicitly
  // rather than assumed zero; a stale next_block from whatever this
  // buffer last held would otherwise leak into a brand-new record.
  let _ = buf_write_u32(buf, 48 as u32, 0 as u32);
  // Round 42: same stale-scratch-buffer reasoning as next_block above
  // -- a tombstone has no meaningful owner/mode, but dharafs_sd_scratch is
  // reused, so these must be zeroed explicitly rather than assumed.
  let _ = buf_write_u32(buf, 52 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 56 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 60 as u32, 0 as u32);

  let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
  let _ = buf_write_u32(buf, 0 as u32, checksum);

  let wr_status: i64 = dharafs_block_write(next_block as i64, buf);
  if wr_status != 0 {
    return 1;
  }
  let _ = dharafs_state_set(next_block + (1 as u32), next_seq + (1 as u32));
  let _ = dharafs_dirindex_upsert_raw(path_buf, path_len, next_block as i64);
  return 0;
}

fn fsqueue_max_slots() -> i64 { return 8; }
fn fsqueue_max_data_bytes() -> i64 { return 448; } // must match dharafs_block_payload_cap()
fn fsqueue_max_path_bytes() -> i64 { return 32; }

fn dharafs_queue_reset() -> i64 {
  let i: i64 = 0;
  while i < fsqueue_max_slots() {
    let _ = fsqueue_valid_set_at(i as u32, 0 as u32);
    i = i + 1;
  }
  let _ = fsqueue_next_seq_set(0 as u32);
  return 0;
}

fn dharafs_queue_find_free_slot() -> i64 {
  let i: i64 = 0;
  while i < fsqueue_max_slots() {
    if fsqueue_valid_get_at(i as u32) == 0 {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// Enqueues a write/append request tagged with `priority` (this
// project's own "0 is highest" scheduler convention -- callers
// normally pass current_eff_prio()) instead of running it inline.
// Returns the slot index on success, -1 if the path/data is oversized
// or the queue (8 slots) is full. A full queue is never silently
// dropped for the caller -- -1 tells them to fall back to calling
// dharafs_append_raw directly, exactly what every existing call site
// still does.
fn dharafs_queue_submit_write_raw(priority: u32, task_id: u32, path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, owner_uid: u32, owner_gid: u32, mode: u32) -> i64 {
  if (path_len <= 0) || (path_len > fsqueue_max_path_bytes()) {
    return 0 - 1;
  }
  if (data_len < 0) || (data_len > fsqueue_max_data_bytes()) {
    return 0 - 1;
  }
  let slot: i64 = dharafs_queue_find_free_slot();
  if slot < 0 {
    return 0 - 1;
  }
  let seq: u32 = fsqueue_next_seq_get() as u32;
  let _ = fsqueue_next_seq_set(seq + (1 as u32));
  let _ = fsqueue_priority_set_at(slot as u32, priority);
  let _ = fsqueue_task_id_set_at(slot as u32, task_id);
  let _ = fsqueue_op_type_set_at(slot as u32, 1 as u32); // 1 = write/append
  let _ = fsqueue_path_len_set_at(slot as u32, path_len as u32);
  let _ = fsqueue_data_len_set_at(slot as u32, data_len as u32);
  let _ = fsqueue_owner_uid_set_at(slot as u32, owner_uid);
  let _ = fsqueue_owner_gid_set_at(slot as u32, owner_gid);
  let _ = fsqueue_mode_set_at(slot as u32, mode);
  let _ = fsqueue_seq_set_at(slot as u32, seq);
  let _ = fsqueue_result_set_at(slot as u32, 2 as u32); // 2 = pending (not yet dispatched)
  let k: i64 = 0;
  while k < path_len {
    let b: u32 = buf_read_byte(path_buf, k as u32);
    let _ = fsqueue_set_path_byte((slot * fsqueue_max_path_bytes() + k) as u32, b);
    k = k + 1;
  }
  let j: i64 = 0;
  while j < data_len {
    let b2: u32 = buf_read_byte(data_buf, j as u32);
    let _ = fsqueue_set_data_byte((slot * fsqueue_max_data_bytes() + j) as u32, b2);
    j = j + 1;
  }
  let _ = fsqueue_valid_set_at(slot as u32, 1 as u32);
  return slot;
}

// Same as dharafs_queue_submit_write_raw, but for a delete (tombstone)
// request -- mirrors dharafs_delete_raw's own argument shape.
fn dharafs_queue_submit_delete_raw(priority: u32, task_id: u32, path_buf: mut ref i64, path_len: i64) -> i64 {
  if (path_len <= 0) || (path_len > fsqueue_max_path_bytes()) {
    return 0 - 1;
  }
  let slot: i64 = dharafs_queue_find_free_slot();
  if slot < 0 {
    return 0 - 1;
  }
  let seq: u32 = fsqueue_next_seq_get() as u32;
  let _ = fsqueue_next_seq_set(seq + (1 as u32));
  let _ = fsqueue_priority_set_at(slot as u32, priority);
  let _ = fsqueue_task_id_set_at(slot as u32, task_id);
  let _ = fsqueue_op_type_set_at(slot as u32, 2 as u32); // 2 = delete
  let _ = fsqueue_path_len_set_at(slot as u32, path_len as u32);
  let _ = fsqueue_data_len_set_at(slot as u32, 0 as u32);
  let _ = fsqueue_seq_set_at(slot as u32, seq);
  let _ = fsqueue_result_set_at(slot as u32, 2 as u32);
  let k: i64 = 0;
  while k < path_len {
    let b: u32 = buf_read_byte(path_buf, k as u32);
    let _ = fsqueue_set_path_byte((slot * fsqueue_max_path_bytes() + k) as u32, b);
    k = k + 1;
  }
  let _ = fsqueue_valid_set_at(slot as u32, 1 as u32);
  return slot;
}

// Str convenience wrapper, same relationship to dharafs_queue_submit_
// write_raw as dharafs_append has to dharafs_append_raw. Tags the
// request with the CALLING task's own current_eff_prio()/
// current_task_get() automatically -- the whole point of this queue
// is "let the caller's real scheduling priority decide FS ordering,"
// so the common case shouldn't require the caller to look those up
// itself.
fn dharafs_queue_submit(path: Str, data: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  let data_len: i64 = str_len_bytes(data);
  if (path_len <= 0) || (path_len > 32) {
    return 0 - 1;
  }
  if data_len > fsqueue_max_data_bytes() {
    return 0 - 1;
  }
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat(path, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { dharafs_user_get_uid() };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { dharafs_user_get_gid() };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { dharafs_default_mode() };
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let j: i64 = 0;
  while j < data_len {
    let _ = buf_write_byte(data_buf, j as u32, str_byte_at(data, j) as u32);
    j = j + 1;
  }
  return dharafs_queue_submit_write_raw(current_eff_prio(), current_task_get(), path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

// Scans every valid slot, returns the index of the one with the
// numerically LOWEST priority (highest real priority, this project's
// own scheduler convention), oldest submission (seq) breaking ties --
// FIFO fairness among equal-priority requests rather than an
// arbitrary/undefined tie order. -1 if the queue is empty.
fn dharafs_queue_pick_next() -> i64 {
  let best: i64 = 0 - 1;
  let best_priority: u32 = 0 as u32;
  let best_seq: u32 = 0 as u32;
  let i: i64 = 0;
  while i < fsqueue_max_slots() {
    if fsqueue_valid_get_at(i as u32) == 1 {
      let p: u32 = fsqueue_priority_get_at(i as u32) as u32;
      let s: u32 = fsqueue_seq_get_at(i as u32) as u32;
      let is_better: i64 = if best < 0 { 1 } else { if (p < best_priority) || ((p == best_priority) && (s < best_seq)) { 1 } else { 0 } };
      if is_better == 1 {
        best = i;
        best_priority = p;
        best_seq = s;
      }
    }
    i = i + 1;
  }
  return best;
}

// Processes exactly the ONE highest-priority pending request (via
// dharafs_queue_pick_next), through the exact same dharafs_append_raw/
// dharafs_delete_raw every synchronous caller already uses -- same
// crash-consistency guarantees, same dharafs_dirindex integration,
// nothing queue-specific about the actual FS operation itself. Meant
// to be called repeatedly by a dedicated background task (task_fsq)
// until it returns -1 (queue drained). Returns the FS op's own result
// (0 = success, 1 = failure) or -1 if the queue was already empty.
fn dharafs_queue_dispatch_one() -> i64 {
  let slot: i64 = dharafs_queue_pick_next();
  if slot < 0 {
    return 0 - 1;
  }
  let op: u32 = fsqueue_op_type_get_at(slot as u32) as u32;
  let path_len: i64 = fsqueue_path_len_get_at(slot as u32);
  let path_buf: mut ref i64 = fsqueue_path_scratch_get();
  let k: i64 = 0;
  while k < path_len {
    let b: u32 = fsqueue_get_path_byte((slot * fsqueue_max_path_bytes() + k) as u32) as u32;
    let _ = buf_write_byte(path_buf, k as u32, b);
    k = k + 1;
  }
  let result: i64 = 0 - 1;
  if op == (2 as u32) {
    result = dharafs_delete_raw(path_buf, path_len);
  } else {
    let data_len: i64 = fsqueue_data_len_get_at(slot as u32);
    let data_buf: mut ref i64 = fsqueue_data_scratch_get();
    let j: i64 = 0;
    while j < data_len {
      let b2: u32 = fsqueue_get_data_byte((slot * fsqueue_max_data_bytes() + j) as u32) as u32;
      let _ = buf_write_byte(data_buf, j as u32, b2);
      j = j + 1;
    }
    let owner_uid: u32 = fsqueue_owner_uid_get_at(slot as u32) as u32;
    let owner_gid: u32 = fsqueue_owner_gid_get_at(slot as u32) as u32;
    let mode: u32 = fsqueue_mode_get_at(slot as u32) as u32;
    result = dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
  }
  let _ = fsqueue_result_set_at(slot as u32, result as u32);
  let _ = fsqueue_valid_set_at(slot as u32, 0 as u32);
  return result;
}

fn dharafs_queue_pending_count() -> i64 {
  let count: i64 = 0;
  let i: i64 = 0;
  while i < fsqueue_max_slots() {
    if fsqueue_valid_get_at(i as u32) == 1 {
      count = count + 1;
    }
    i = i + 1;
  }
  return count;
}

// Round 66 follow-up: dedicated background task draining the priority
// queue above -- every existing dharafs_* call site is untouched, this
// only serves callers that opt in via dharafs_queue_submit(_raw). Low
// priority (task_gc's own priority tier), same "sleep, then do a
// bounded burst of work" shape as task_e's compaction loop, drains
// the ENTIRE queue each wake (not just one entry) so a burst of
// submissions during one sleep interval doesn't pile up indefinitely.
fn task_fsq() -> i64 {
  while true {
    let _ = task_sleep_ticks(5);
    // Round 76: matches task_e/task_f's own dhruva_prio_lock(2) around
    // their DharaFS-touching code (see task_e's own comment for the
    // full "No concurrency lock protecting DharaFS's own shared state"
    // rationale). task_fsq's own real priority (2) is already the
    // highest of the three real DharaFS-calling tasks, so a LOWER-
    // priority task_e/task_f can never actually preempt it mid-drain
    // under plain fixed-priority scheduling even without this lock --
    // included anyway for symmetry with the other two call sites and
    // as a defensive guard against any future task added at priority
    // 0 or 1 that also touches DharaFS, not because this exact 3-task
    // scenario strictly requires it on this side.
    let _ = dhruva_prio_lock(2);
    let drained: i64 = 0;
    let keep_going: i64 = 1;
    while (keep_going == 1) && (drained < fsqueue_max_slots()) {
      let r: i64 = dharafs_queue_dispatch_one();
      if r < 0 {
        keep_going = 0;
      } else {
        drained = drained + 1;
      }
    }
    let _ = dhruva_prio_unlock(2);
  }
  return 0;
}

fn dharafs_delete(path: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len > 32 {
    return 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return dharafs_delete_raw(path_buf, path_len);
}

// Round 47: DharaFS had no rename at all until now -- docs/TODO.md's
// own "dharafs_rename_raw + a real multi-file transaction primitive"
// backlog item's first increment. Implemented as read-old + append-
// under-new (preserving owner/mode) + delete-old, reusing dharafs_
// stat_raw/dharafs_read_raw/dharafs_append_raw/dharafs_delete_raw
// entirely -- no new on-disk record shape needed.
//
// NOT yet atomic across the two records the way a single dharafs_
// append_raw call is atomic across ITS OWN blocks (reverse-order
// continuation writes, head committed last): a crash between the
// append below and the delete below leaves BOTH the new and old
// copies live and independently readable. Not silent data loss, but
// not a clean atomic rename either -- a real dharafs_tx_begin/
// dharafs_tx_commit wrapping both operations is the documented
// follow-up in docs/TODO.md, deliberately out of scope here.
// Round 52 (docs/TODO.md's own "dharafs_rename_raw + a real multi-file
// transaction primitive" backlog item, increment 2 -- increment 1 was
// dharafs_rename itself, round 47): a real multi-block atomicity
// primitive, closing the "crash between the append and the delete
// leaves both copies live" gap dharafs_rename_raw's own increment-1
// comment flagged.
//
// Design: a TX_BEGIN record (path_len field set to the sentinel
// below, data_len field repurposed to hold block_count) is appended
// BEFORE the N blocks it covers. Deliberately no separate TX_COMMIT
// record -- a crash can only ever happen either before all N
// following blocks are written (incomplete) or after (complete), and
// block numbers in this log are strictly increasing and never reused
// within one boot session (dharafs_append_raw/dharafs_delete_raw
// always target dharafs_state_get_next_block(), which only ever
// grows), so "are blocks [tx_block+1, tx_block+block_count] all
// present and checksum-valid" is itself a complete, sufficient proof
// of completion -- nothing else could have produced valid records at
// exactly those block numbers. dharafs_init's own recovery scan
// (below) is the other half: an INCOMPLETE transaction found at the
// tail of the log (the only place a crash could ever leave one) rolls
// the append cursor back to the transaction's own starting block,
// abandoning every half-written block after it -- old data intact,
// new data simply never existed, same "old OR new, never mixed"
// guarantee dharafs_append_raw's own single-record atomicity already
// gives, now extended across multiple records.
fn dharafs_tx_begin_sentinel() -> u32 {
  return 0xFFFFFFF0 as u32; // distinct from the continuation marker
                            // (0) and every real path_len (1-32)
}

fn dharafs_tx_begin_raw(block_count: i64) -> i64 {
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let next_block: u32 = dharafs_state_get_next_block();
  let next_seq: u32 = dharafs_state_get_next_seq();
  let _ = buf_write_u32(buf, 4 as u32, next_seq);
  let _ = buf_write_u32(buf, 8 as u32, dharafs_tx_begin_sentinel());
  let z: i64 = 0;
  while z < 32 {
    let _ = buf_write_byte(buf, (12 + z) as u32, 0 as u32);
    z = z + 1;
  }
  let _ = buf_write_u32(buf, 44 as u32, block_count as u32); // repurposed as block_count
  let _ = buf_write_u32(buf, 48 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 52 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 56 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 60 as u32, 0 as u32);
  let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
  let _ = buf_write_u32(buf, 0 as u32, checksum);
  let wr_status: i64 = dharafs_block_write(next_block as i64, buf);
  if wr_status != 0 {
    return 1;
  }
  let _ = dharafs_state_set(next_block + (1 as u32), next_seq + (1 as u32));
  return 0;
}

fn dharafs_rename_raw(old_path_buf: mut ref i64, old_path_len: i64, new_path_buf: mut ref i64, new_path_len: i64) -> i64 {
  if (old_path_len <= 0) || (old_path_len > 32) || (new_path_len <= 0) || (new_path_len > 32) {
    return 1;
  }

  // Renaming a path to itself must be a no-op success, checked BEFORE
  // anything else below: without this, appending under new_path
  // (identical to old_path) would immediately be tombstoned by the
  // delete-old step that follows it.
  if old_path_len == new_path_len {
    let same: i64 = 1;
    let si: i64 = 0;
    while si < old_path_len {
      if buf_read_byte(old_path_buf, si as u32) != buf_read_byte(new_path_buf, si as u32) {
        same = 0;
      }
      si = si + 1;
    }
    if same == 1 {
      return 0;
    }
  }

  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(old_path_buf, old_path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1; // old path not found
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);

  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read_raw(old_path_buf, old_path_len, data_buf);
  if data_len < 0 {
    return 0 - 1; // tombstone or corrupt -- nothing real to rename
  }

  // The append below may itself span multiple blocks for a large
  // file (dharafs_append_raw's own multi-block path) -- the tx_begin
  // marker's block_count only needs to cover the delete's own single
  // tombstone block PLUS however many blocks the append consumes.
  // dharafs_block_payload_cap() is the per-block data capacity; ceil-
  // divide data_len by it the same way dharafs_append_raw's own
  // multi-block path already computes num_chunks.
  let cap: i64 = dharafs_block_payload_cap();
  let append_block_count: i64 = if data_len <= cap { 1 } else { (data_len + cap - 1) / cap };
  let tx_status: i64 = dharafs_tx_begin_raw(append_block_count + 1);
  if tx_status != 0 {
    return 1;
  }

  let append_status: i64 = dharafs_append_raw(new_path_buf, new_path_len, data_buf, data_len, owner_uid, owner_gid, mode);
  if append_status != 0 {
    return 1; // new path write failed -- old path is untouched
  }

  let del_status: i64 = dharafs_delete_raw(old_path_buf, old_path_len);
  if del_status != 0 {
    return 1;
  }
  return 0;
}

fn dharafs_rename(old_path: Str, new_path: Str) -> i64 {
  let old_len: i64 = str_len_bytes(old_path);
  let new_len: i64 = str_len_bytes(new_path);
  if (old_len <= 0) || (old_len > 32) || (new_len <= 0) || (new_len > 32) {
    return 1;
  }
  let old_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < old_len {
    let _ = buf_write_byte(old_buf, i as u32, str_byte_at(old_path, i) as u32);
    i = i + 1;
  }
  // dharafs_path_scratch is the one shared path buffer every other
  // Str-based DharaFS entry point above already uses -- a rename needs
  // a SECOND path live at once, so new_path gets its own dedicated
  // PERSISTENT scratch buffer (dharafs_rename_new_path_scratch) rather
  // than contending for the same slot old_path just filled. BUG FIX:
  // this used to be a fresh dhruva_alloc_bytes(32) here, leaking 32
  // bytes on every single call -- the exact bug class round 49's own
  // audit already found once in round 48's code, found again here via
  // a follow-up sweep.
  let new_buf: mut ref i64 = dharafs_rename_new_path_scratch_get();
  let j: i64 = 0;
  while j < new_len {
    let _ = buf_write_byte(new_buf, j as u32, str_byte_at(new_path, j) as u32);
    j = j + 1;
  }
  return dharafs_rename_raw(old_buf, old_len, new_buf, new_len);
}

// Round 48: opt-in stronger integrity for security-critical paths
// (docs/TODO.md's own backlog item). buf_checksum's rotate-mix (32
// bits, not collision-resistant) already catches torn/partial writes
// -- what it can't meaningfully catch is deliberate tampering. Round
// 41's sha256_hash already exists; this wires it in WITHOUT touching
// the 512-byte on-disk record format at all (every existing call site
// hardcodes that record's field offsets -- dharafs_append_raw/
// dharafs_read_raw/dharafs_compact/dharafs_find_latest_block_raw/
// dharafs_list_dir_raw/dharafs_init/dharafs_stat_raw, plus the host
// harness's own write_raw_record helper -- changing it to make room
// for a stored digest would be a real, invasive format migration for
// a feature that's opt-in and has no current PKI/secure-boot consumer
// yet to justify that cost). Instead, the digest for `path` lives in
// its own ordinary DharaFS file at `path` + ".sha256" -- a companion
// record using the SAME existing primitives, no format change.
//
// A path already at the 32-byte cap has no room left for a 7-byte
// ".sha256" companion path -- dharafs_verified_companion_path_raw
// reports that explicitly (-1) rather than silently truncating or
// colliding with an unrelated path.
fn dharafs_verified_companion_path_raw(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64) -> i64 {
  if (path_len + 7) > 32 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < path_len {
    let b: u32 = buf_read_byte(path_buf, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let _ = buf_write_byte(out_buf, (path_len + 0) as u32, 46 as u32);  // '.'
  let _ = buf_write_byte(out_buf, (path_len + 1) as u32, 115 as u32); // 's'
  let _ = buf_write_byte(out_buf, (path_len + 2) as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(out_buf, (path_len + 3) as u32, 97 as u32);  // 'a'
  let _ = buf_write_byte(out_buf, (path_len + 4) as u32, 50 as u32);  // '2'
  let _ = buf_write_byte(out_buf, (path_len + 5) as u32, 53 as u32);  // '5'
  let _ = buf_write_byte(out_buf, (path_len + 6) as u32, 54 as u32);  // '6'
  return path_len + 7;
}

// Writes `path` normally, then a SHA-256 digest of its data under the
// companion path above. Both writes use the given owner/mode -- the
// digest record is never independently owner/permission-managed, it
// always mirrors whatever the data file it protects has.
// BUG FIX (found during round 49's own scratch-buffer audit, before
// this ever shipped further): companion_buf/digest originally called
// dhruva_alloc_bytes fresh on every call -- the exact "never dhruva_
// alloc_bytes on every call" bug boot/scratch_state.S exists to
// prevent, and writev is meant to be called repeatedly. Now uses
// dharafs_verified_companion_scratch/dharafs_verified_digest_a_scratch,
// persistent buffers allocated once at boot.
//
// KNOWN remaining cost, deliberately not fixed here (see docs/
// TODO.md): sha256_hash ITSELF still allocates its own internal
// working buffers (padded message, H/K/W tables) fresh on every call
// -- up to ~4.7KB per call for a file near dharafs_file_max_len().
// Every writev/catv call permanently costs that much heap. Bounded
// and safely handled (round 45's dhruva_alloc_bytes OOM-fatal path
// halts cleanly rather than corrupting memory if the heap is ever
// actually exhausted this way), not unbounded or silent -- but a
// real, documented limitation: this feature is not suited to
// high-frequency verified I/O within a single boot session. Giving
// sha256_hash the same persistent-scratch treatment is real, separate
// follow-up work, not a small addition to this round.
fn dharafs_write_verified_raw(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, owner_uid: u32, owner_gid: u32, mode: u32) -> i64 {
  let companion_buf: mut ref i64 = dharafs_verified_companion_scratch_get();
  let companion_len: i64 = dharafs_verified_companion_path_raw(path_buf, path_len, companion_buf);
  if companion_len < 0 {
    // -1 is otherwise unused by the write path (dharafs_write_raw_checked's
    // own convention has no "not found" case -- any path is writable),
    // so it's free to mean "path too long for a companion digest" here
    // specifically, distinct from a generic write failure (1).
    return 0 - 1;
  }
  let write_status: i64 = dharafs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
  if write_status != 0 {
    return write_status;
  }
  let digest: mut ref i64 = dharafs_verified_digest_a_scratch_get();
  let _ = sha256_hash(data_buf, data_len, digest);
  return dharafs_append_raw(companion_buf, companion_len, digest, 32, owner_uid, owner_gid, mode);
}

// Permission-enforcing entry point -- IDENTICAL preserve-on-overwrite
// and write-permission logic to dharafs_write_raw_checked, just also
// carrying the digest write through dharafs_write_verified_raw above.
fn dharafs_write_verified_checked(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = dharafs_stat_scratch_get();
  let stat_status: i64 = dharafs_stat_raw(path_buf, path_len, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { req_uid };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { req_gid };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { dharafs_default_mode() };
  if stat_status == 0 {
    let attr_status: i64 = dharafs_attr_check_write(path_buf, path_len, data_buf, data_len, mode);
    if attr_status != 0 {
      return attr_status;
    }
    let allowed: i64 = dharafs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
    if allowed == 0 {
      return 0 - 2;
    }
  }
  return dharafs_write_verified_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

// Reads `path` (permission-checked, same as dharafs_read_raw_checked)
// then, if a companion digest was ever written for it, recomputes
// SHA-256 over the data just read and compares. Return convention
// extends dharafs_read_raw_checked's own (-1 not found, -2 permission
// denied, else data length) with one more case: -3 means the read
// itself succeeded but the companion digest exists and does NOT
// match -- tamper or corruption beyond what the per-block checksum
// alone catches. No companion digest at all is NOT an error --
// verification is opt-in per path, so that case just returns the
// plain data length, same as an unverified read.
fn dharafs_read_verified_checked(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64, req_uid: u32, req_gid: u32) -> i64 {
  let data_len: i64 = dharafs_read_raw_checked(path_buf, path_len, out_buf, req_uid, req_gid);
  if data_len < 0 {
    return data_len;
  }
  let companion_buf: mut ref i64 = dharafs_verified_companion_scratch_get();
  let companion_len: i64 = dharafs_verified_companion_path_raw(path_buf, path_len, companion_buf);
  if companion_len < 0 {
    return data_len;
  }
  let stored_digest: mut ref i64 = dharafs_verified_digest_b_scratch_get();
  // Unchecked read of the companion digest -- the caller already
  // passed the real permission check on the DATA file above, and
  // nothing in this project ever gives the sidecar digest record a
  // different owner/mode than the file it protects (see dharafs_
  // write_verified_raw), so a separate permission grant on it would
  // only make verification silently fail closed for no real reason.
  let digest_len: i64 = dharafs_read_raw(companion_buf, companion_len, stored_digest);
  if digest_len != 32 {
    return data_len; // no companion digest was ever written for this path
  }
  let computed_digest: mut ref i64 = dharafs_verified_digest_a_scratch_get();
  let _ = sha256_hash(out_buf, data_len, computed_digest);
  let matches: i64 = sha256_bytes_equal(stored_digest, computed_digest, 32);
  if matches == 0 {
    return 0 - 3;
  }
  return data_len;
}

// Round 49: append-only log convenience API (docs/TODO.md's own
// backlog item) -- the embedded sensor-logging shape ("sensor ->
// record -> append -> record -> append", not desktop-style create/
// delete/rename) this project's storage layer never had ergonomics
// for. Built entirely on existing primitives (dharafs_append_raw/
// dharafs_read_raw), no new on-disk record format: a log named `name`
// lives as numbered files /logs/<name>-0001.log, /logs/<name>-0002.log,
// ... plus a small /logs/<name>.hdr header (8 bytes: u32 current_file_
// index, u32 current_file_size) tracking where the next record goes.
// Every working buffer is PERSISTENT scratch (boot/scratch_state.S),
// never dhruva_alloc_bytes per call -- this is exactly the "called
// repeatedly at runtime" shape that file's own header comment warns
// about, doubly so for a logging feature whose entire point is being
// called often over a session's lifetime.
fn dharafs_log_rollover_threshold() -> i64 {
  return 3584; // headroom under dharafs_file_max_len() (4096) --
               // combined with the 512-byte per-record cap below,
               // dharafs_log_combined_scratch (sized exactly 4096)
               // can never overflow: 3584 + 512 = 4096 exactly.
}

fn dharafs_log_record_max_len() -> i64 {
  return 512; // one "reasonable log line" -- generous for a sensor
              // reading or short structured record, small enough that
              // the rollover-threshold math above stays exact.
}

// Round 66: how many numbered generations of one log to keep on disk
// (current file plus this many prior ones) before dharafs_log_append_
// raw's own rollover step starts reclaiming the oldest. Without this,
// every rollover left the previous file behind forever -- fine for a
// short-lived demo, a real permanent problem for the sensor-logging
// use case this API exists for (bounded storage, indefinite runtime).
// 5 is arbitrary but generous for the embedded file counts this
// project targets (tens to low hundreds, not thousands) -- see the
// directory-index TODO entry's own reasoning for why this project
// doesn't scale-design ahead of a real need.
fn dharafs_log_retention_count() -> i64 {
  return 5;
}

// Writes exactly 4 ASCII decimal digits (zero-padded, 0000-9999) for
// `index` starting at out_buf[offset).
fn dharafs_log_write_index_digits(out_buf: mut ref i64, offset: i64, index: u32) -> i64 {
  let d0: u32 = (index / (1000 as u32)) % (10 as u32);
  let d1: u32 = (index / (100 as u32)) % (10 as u32);
  let d2: u32 = (index / (10 as u32)) % (10 as u32);
  let d3: u32 = index % (10 as u32);
  let _ = buf_write_byte(out_buf, offset as u32, (48 as u32) + d0);
  let _ = buf_write_byte(out_buf, (offset + 1) as u32, (48 as u32) + d1);
  let _ = buf_write_byte(out_buf, (offset + 2) as u32, (48 as u32) + d2);
  let _ = buf_write_byte(out_buf, (offset + 3) as u32, (48 as u32) + d3);
  return 0;
}

// Builds "/logs/" + name + "-" + 4-digit index + ".log" into out_buf,
// returning its length, or -1 if the combined path would exceed the
// 32-byte path cap (6 + name_len + 1 + 4 + 4 = 15 + name_len).
fn dharafs_log_path_raw(name_buf: mut ref i64, name_len: i64, index: u32, out_buf: mut ref i64) -> i64 {
  let total_len: i64 = 15 + name_len;
  if total_len > 32 {
    return 0 - 1;
  }
  let _ = buf_write_byte(out_buf, 0 as u32, 47 as u32);  // '/'
  let _ = buf_write_byte(out_buf, 1 as u32, 108 as u32); // 'l'
  let _ = buf_write_byte(out_buf, 2 as u32, 111 as u32); // 'o'
  let _ = buf_write_byte(out_buf, 3 as u32, 103 as u32); // 'g'
  let _ = buf_write_byte(out_buf, 4 as u32, 115 as u32); // 's'
  let _ = buf_write_byte(out_buf, 5 as u32, 47 as u32);  // '/'
  let i: i64 = 0;
  while i < name_len {
    let b: u32 = buf_read_byte(name_buf, i as u32);
    let _ = buf_write_byte(out_buf, (6 + i) as u32, b);
    i = i + 1;
  }
  let dash_off: i64 = 6 + name_len;
  let _ = buf_write_byte(out_buf, dash_off as u32, 45 as u32); // '-'
  let _ = dharafs_log_write_index_digits(out_buf, dash_off + 1, index);
  let ext_off: i64 = dash_off + 5;
  let _ = buf_write_byte(out_buf, ext_off as u32, 46 as u32);      // '.'
  let _ = buf_write_byte(out_buf, (ext_off + 1) as u32, 108 as u32); // 'l'
  let _ = buf_write_byte(out_buf, (ext_off + 2) as u32, 111 as u32); // 'o'
  let _ = buf_write_byte(out_buf, (ext_off + 3) as u32, 103 as u32); // 'g'
  return total_len;
}

// Builds "/logs/" + name + ".hdr" into out_buf, returning its length,
// or -1 if the combined path would exceed the 32-byte path cap.
fn dharafs_log_header_path_raw(name_buf: mut ref i64, name_len: i64, out_buf: mut ref i64) -> i64 {
  let total_len: i64 = 10 + name_len;
  if total_len > 32 {
    return 0 - 1;
  }
  let _ = buf_write_byte(out_buf, 0 as u32, 47 as u32);
  let _ = buf_write_byte(out_buf, 1 as u32, 108 as u32);
  let _ = buf_write_byte(out_buf, 2 as u32, 111 as u32);
  let _ = buf_write_byte(out_buf, 3 as u32, 103 as u32);
  let _ = buf_write_byte(out_buf, 4 as u32, 115 as u32);
  let _ = buf_write_byte(out_buf, 5 as u32, 47 as u32);
  let i: i64 = 0;
  while i < name_len {
    let b: u32 = buf_read_byte(name_buf, i as u32);
    let _ = buf_write_byte(out_buf, (6 + i) as u32, b);
    i = i + 1;
  }
  let ext_off: i64 = 6 + name_len;
  let _ = buf_write_byte(out_buf, ext_off as u32, 46 as u32);       // '.'
  let _ = buf_write_byte(out_buf, (ext_off + 1) as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(out_buf, (ext_off + 2) as u32, 100 as u32); // 'd'
  let _ = buf_write_byte(out_buf, (ext_off + 3) as u32, 114 as u32); // 'r'
  return total_len;
}

// Appends `record` to the currently active numbered file for log
// `name`, rolling over to a new file automatically once the current
// one would exceed dharafs_log_rollover_threshold(). This project's
// storage layer has no true byte-level append to an existing path
// (dharafs_append_raw always replaces a path's visible content with a
// new full version) -- so a non-rollover append here reads the
// current file's existing content, concatenates the new record, and
// writes the whole thing back, same "read whole, re-append whole"
// shape dharafs_compact's own carry-forward and dharafs_chmod/
// dharafs_chown already use elsewhere in this file.
fn dharafs_log_append_raw(name_buf: mut ref i64, name_len: i64, record_buf: mut ref i64, record_len: i64, owner_uid: u32, owner_gid: u32, mode: u32) -> i64 {
  if (name_len <= 0) || (record_len <= 0) {
    return 1;
  }
  if record_len > dharafs_log_record_max_len() {
    return 1;
  }
  let header_buf: mut ref i64 = dharafs_log_header_path_scratch_get();
  let header_len: i64 = dharafs_log_header_path_raw(name_buf, name_len, header_buf);
  if header_len < 0 {
    return 0 - 1; // log name too long
  }
  let header_data: mut ref i64 = dharafs_log_header_data_scratch_get();
  let hdr_read_len: i64 = dharafs_read_raw(header_buf, header_len, header_data);
  let current_index: u32 = if hdr_read_len == 8 { buf_read_u32(header_data, 0 as u32) } else { 0 as u32 };
  let current_size: i64 = if hdr_read_len == 8 { buf_read_u32(header_data, 4 as u32) as i64 } else { 0 };

  let log_path_buf: mut ref i64 = dharafs_log_path_scratch_get();
  let needs_rollover: i64 = if current_index == (0 as u32) { 1 } else {
    if (current_size + record_len) > dharafs_log_rollover_threshold() { 1 } else { 0 }
  };

  if needs_rollover == 1 {
    let new_index: u32 = current_index + (1 as u32);
    if new_index > (9999 as u32) {
      return 1; // exhausted the 4-digit rollover space
    }
    let log_path_len: i64 = dharafs_log_path_raw(name_buf, name_len, new_index, log_path_buf);
    if log_path_len < 0 {
      return 0 - 1; // log name too long once combined with the file suffix
    }
    let write_status: i64 = dharafs_append_raw(log_path_buf, log_path_len, record_buf, record_len, owner_uid, owner_gid, mode);
    if write_status != 0 {
      return write_status;
    }
    let _ = buf_write_u32(header_data, 0 as u32, new_index);
    let _ = buf_write_u32(header_data, 4 as u32, record_len as u32);
    let header_write_status: i64 = dharafs_append_raw(header_buf, header_len, header_data, 8, owner_uid, owner_gid, mode);

    // Round 66: GC the oldest generation now that the new file AND its
    // header are both safely durable -- reclaiming before the header
    // commits would risk pointing at a deleted file if a crash landed
    // between the two, the same "old OR new, never mixed" ordering
    // discipline this project's own transaction primitive already
    // established elsewhere. Best-effort: a delete failure here (e.g.
    // the old generation was already gone) doesn't fail the append that
    // already genuinely succeeded, so this function's own return value
    // still reflects only the part the caller actually asked for.
    if header_write_status == 0 {
      let retention: i64 = dharafs_log_retention_count();
      if (new_index as i64) > retention {
        let old_index: u32 = new_index - (retention as u32);
        let old_path_len: i64 = dharafs_log_path_raw(name_buf, name_len, old_index, log_path_buf);
        if old_path_len > 0 {
          let _ = dharafs_delete_raw(log_path_buf, old_path_len);
        }
      }
    }
    return header_write_status;
  }

  let log_path_len: i64 = dharafs_log_path_raw(name_buf, name_len, current_index, log_path_buf);
  if log_path_len < 0 {
    return 0 - 1;
  }
  let existing_data: mut ref i64 = dharafs_log_existing_scratch_get();
  let existing_len_raw: i64 = dharafs_read_raw(log_path_buf, log_path_len, existing_data);
  // Self-heals from an inconsistent header (e.g. the file it points at
  // is somehow missing/corrupt) by treating the existing content as
  // empty rather than failing the whole append -- the new record still
  // gets written, just as if it were the first in a fresh file.
  let existing_len: i64 = if existing_len_raw < 0 { 0 } else { existing_len_raw };
  let combined_buf: mut ref i64 = dharafs_log_combined_scratch_get();
  let i: i64 = 0;
  while i < existing_len {
    let b: u32 = buf_read_byte(existing_data, i as u32);
    let _ = buf_write_byte(combined_buf, i as u32, b);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < record_len {
    let b2: u32 = buf_read_byte(record_buf, j as u32);
    let _ = buf_write_byte(combined_buf, (existing_len + j) as u32, b2);
    j = j + 1;
  }
  let combined_len: i64 = existing_len + record_len;
  let write_status2: i64 = dharafs_append_raw(log_path_buf, log_path_len, combined_buf, combined_len, owner_uid, owner_gid, mode);
  if write_status2 != 0 {
    return write_status2;
  }
  let _ = buf_write_u32(header_data, 0 as u32, current_index);
  let _ = buf_write_u32(header_data, 4 as u32, combined_len as u32);
  return dharafs_append_raw(header_buf, header_len, header_data, 8, owner_uid, owner_gid, mode);
}

fn dharafs_log_append(name: Str, line: Str) -> i64 {
  let name_len: i64 = str_len_bytes(name);
  let line_len_s: i64 = str_len_bytes(line);
  if (name_len <= 0) || (line_len_s <= 0) {
    return 1;
  }
  let name_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < name_len {
    let _ = buf_write_byte(name_buf, i as u32, str_byte_at(name, i) as u32);
    i = i + 1;
  }
  let record_buf: mut ref i64 = dharafs_data_scratch_get();
  let j: i64 = 0;
  while j < line_len_s {
    let _ = buf_write_byte(record_buf, j as u32, str_byte_at(line, j) as u32);
    j = j + 1;
  }
  return dharafs_log_append_raw(name_buf, name_len, record_buf, line_len_s, dharafs_user_get_uid(), dharafs_user_get_gid(), dharafs_default_mode());
}

// Round 39's live milestone: write a payload well past the 448-byte
// per-block cap (Round 42 shrank it from 460 to make room for
// owner_uid/owner_gid/mode), confirm it round-trips byte-for-byte
// through dharafs_append_raw's own chaining (reverse-order write) and
// dharafs_read_raw's own chain-following read. 1000 bytes needs 3 chunks
// (448+448+104) --
// comfortably past the "needs exactly one continuation" minimum case,
// enough to prove the loop over MULTIPLE chained blocks, not just a
// head-plus-one edge case. Reuses test_fill_pattern/test_compare_
// buffers, the same generic pattern-fill/compare helpers the SD/USB
// mass storage round-trip checks already use, rather than a third
// hand-rolled comparison loop.
fn dharafs_multiblock_self_test() -> i64 {
  let ok: i64 = 1;
  let file_len: i64 = 1000;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(1000);
  let _ = test_fill_pattern(write_buf, 1000);

  // Raw pattern bytes aren't valid Str/UTF-8 content, so this goes
  // through dharafs_append_raw/dharafs_read_raw directly rather than dharafs_append's
  // own Str-based wrapper, matching every other raw-content self-test
  // in this project.
  let path_buf: mut ref i64 = dhruva_alloc_bytes(16);
  let path_bytes: Str = "/bigfile/data";
  let path_len: i64 = str_len_bytes(path_bytes);
  let pi: i64 = 0;
  while pi < path_len {
    let _ = buf_write_byte(path_buf, pi as u32, str_byte_at(path_bytes, pi) as u32);
    pi = pi + 1;
  }
  let write_status: i64 = dharafs_append_raw(path_buf, path_len, write_buf, file_len, dharafs_user_get_uid(), dharafs_user_get_gid(), dharafs_default_mode());
  if write_status != 0 {
    ok = 0;
  }

  let read_buf: mut ref i64 = dhruva_alloc_bytes(1000);
  let read_len: i64 = dharafs_read_raw(path_buf, path_len, read_buf);
  if read_len != file_len {
    ok = 0;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, file_len);
  if mismatch != 0 {
    ok = 0;
  }

  // Overwrite with a DIFFERENT multi-block payload, confirm the
  // lookup correctly follows the NEW chain's head, not a leftover
  // continuation block from the old one (every continuation block's
  // path_len=0 sentinel makes this structurally impossible to get
  // wrong, but proving it live is still the point, not just trusting
  // the design on paper).
  let write_buf2: mut ref i64 = dhruva_alloc_bytes(1000);
  let qi: i64 = 0;
  while qi < 1000 {
    let _ = buf_write_byte(write_buf2, qi as u32, ((qi * 7) & 0xFF) as u32);
    qi = qi + 1;
  }
  let write_status2: i64 = dharafs_append_raw(path_buf, path_len, write_buf2, file_len, dharafs_user_get_uid(), dharafs_user_get_gid(), dharafs_default_mode());
  if write_status2 != 0 {
    ok = 0;
  }
  let read_buf2: mut ref i64 = dhruva_alloc_bytes(1000);
  let read_len2: i64 = dharafs_read_raw(path_buf, path_len, read_buf2);
  if read_len2 != file_len {
    ok = 0;
  }
  let mismatch2: i64 = test_compare_buffers(write_buf2, read_buf2, file_len);
  if mismatch2 != 0 {
    ok = 0;
  }

  let _ = uart_puts("DharaFS: multi-block file round trip (1000 bytes, 3 chunks) + overwrite");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 39's journaling-hardening proof: the actual crash-consistency
// claim dharafs_init's own header comment makes for multi-block files --
// that a crash/power-loss before a new chain's HEAD block is written
// leaves the OLD version of the file completely intact and reachable,
// because the head write is the one atomic point a new chain becomes
// visible at all. This project's own single-threaded, synchronous
// execution can't literally interrupt a write mid-chain the way
// test/power_yank.py does at the QEMU-process level for single-block
// writes -- so this reproduces the EXACT end state such a crash would
// leave instead: a real, valid, checksummed CONTINUATION block
// (path_len=0) written directly to the block number dharafs_state's own
// next_block would use next, with NO corresponding head ever written
// and dharafs_state deliberately left untouched (not calling dharafs_state_set
// IS the simulated crash -- that accounting update, and the real head
// write, are exactly the two things a crash prevents). Gives the
// phantom block an artificially huge sequence number specifically so
// that if it were EVER wrongly visible to a lookup, it would
// incorrectly "win" over the real record -- making this a genuine
// stress case, not a trivially-passing one.
fn dharafs_multiblock_crash_consistency_self_test() -> i64 {
  let ok: i64 = 1;
  let path: Str = "/crashtest/file";
  let old_value: Str = "safe-old-value";
  let _ = dharafs_append(path, old_value);

  let phantom_block: i64 = dharafs_state_get_next_block() as i64;
  let phantom_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = buf_write_u32(phantom_buf, 4 as u32, 999999 as u32); // seq far
                          // higher than any real record so far
  let _ = buf_write_u32(phantom_buf, 8 as u32, 0 as u32); // continuation marker
  let z: i64 = 0;
  while z < 32 {
    let _ = buf_write_byte(phantom_buf, (12 + z) as u32, 0 as u32);
    z = z + 1;
  }
  let _ = buf_write_u32(phantom_buf, 44 as u32, 10 as u32);
  let _ = buf_write_u32(phantom_buf, 48 as u32, 0 as u32); // next_block=0
  let p: i64 = 0;
  while p < 10 {
    let _ = buf_write_byte(phantom_buf, (52 + p) as u32, 88 as u32); // 'X'
    p = p + 1;
  }
  let checksum: u32 = buf_checksum(phantom_buf, 4 as u32, 508 as u32);
  let _ = buf_write_u32(phantom_buf, 0 as u32, checksum);
  let _ = dharafs_block_write(phantom_block, phantom_buf);
  // Deliberately no dharafs_state_set call -- see this function's own
  // header comment for why that omission IS the simulated crash.

  let out_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let read_len: i64 = dharafs_read(path, out_buf);
  let expected_len: i64 = str_len_bytes(old_value);
  if read_len != expected_len {
    ok = 0;
  }
  let ci: i64 = 0;
  while ci < expected_len {
    let want: i64 = str_byte_at(old_value, ci);
    let got: u32 = buf_read_byte(out_buf, ci as u32);
    if (got as i64) != want {
      ok = 0;
    }
    ci = ci + 1;
  }

  let _ = uart_puts("DharaFS: simulated crash mid-multi-block-write leaves old version intact");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Prints every live path (not tombstoned, and the newest record for
// that exact path -- an older, superseded occurrence in the log is
// correctly skipped even though it's still individually valid) whose
// first prefix_len bytes match `prefix`. An empty prefix matches
// every path -- "list everything" -- since matching zero bytes always
// trivially holds. Same "is this occurrence actually the champion for
// its path" check dharafs_compact uses to decide what's safe to reclaim.
// Round 42: linear membership check into a fixed-capacity "already
// printed" set of path segments, used by dharafs_list_dir's own
// deduplication below. `seen` holds up to 128 32-byte slots (byte 0 =
// this slot's real length 0-31, bytes 1..31 = the name itself) --
// reuses dharafs_data_scratch's full 4096 bytes, safe because dharafs_list_dir
// never touches file DATA itself, only record headers.
fn dharafs_dirlist_seen_contains(seen: mut ref i64, count: i64, path_buf: mut ref i64, seg_start: i64, seg_len: i64) -> i64 {
  let idx: i64 = 0;
  while idx < count {
    let slot_off: i64 = idx * 32;
    let slot_len: u32 = buf_read_byte(seen, slot_off as u32);
    if (slot_len as i64) == seg_len {
      let matches: i64 = 1;
      let k: i64 = 0;
      while k < seg_len {
        let a: u32 = buf_read_byte(seen, (slot_off + 1 + k) as u32);
        let b: u32 = buf_read_byte(path_buf, (seg_start + k) as u32);
        if a != b {
          matches = 0;
        }
        k = k + 1;
      }
      if matches == 1 {
        return 1;
      }
    }
    idx = idx + 1;
  }
  return 0;
}

// Round 42: does query_buf[0:query_len) exactly equal
// path_buf[seg_start:seg_start+seg_len)? Used by dharafs_list_dir_raw's
// classify mode (dharafs_list_dir_classify).
fn dharafs_dirlist_segment_equals(query_buf: mut ref i64, query_len: i64, path_buf: mut ref i64, seg_start: i64, seg_len: i64) -> i64 {
  if query_len != seg_len {
    return 0;
  }
  let k: i64 = 0;
  while k < seg_len {
    let a: u32 = buf_read_byte(query_buf, k as u32);
    let b: u32 = buf_read_byte(path_buf, (seg_start + k) as u32);
    if a != b {
      return 0;
    }
    k = k + 1;
  }
  return 1;
}

// Round 42: real single-level directory listing -- closes the
// directory-hierarchy half of this TODO item that round 39's
// multi-block-files work explicitly left open. dharafs_list (below) does a
// flat "every live record whose path starts with this exact prefix"
// scan and prints the whole remaining path -- "/config/mode" and
// "/config/sub/deep" print identically as full paths, with no notion
// that the second one lives in a subdirectory. dharafs_list_dir instead
// looks only at the FIRST path segment after `dir`, printing a leaf
// file's own name when nothing follows it, or a subdirectory's name
// (deduplicated, however many files actually live under it) with a
// trailing "/" when something does.
//
// `dir_buf`/`dir_len` is a directory path with a leading slash and no
// trailing one ("/config"), or length 0 for the root -- matching how
// every real path in this filesystem already starts with "/". Raw-
// buffer core (not Str) for the same reason dharafs_append_raw/dharafs_read_raw
// are: the shell's own "ls <dir>" only ever has the path as bytes
// copied out of its line buffer, with no Str form to build from
// arbitrary bytes (there's no vani-level operation for that). See
// dharafs_list_dir (below) for the Str-based wrapper self-tests use.
// `query_len > 0` switches this from printing (the shell "ls <dir>"
// use) to a silent, assertable classification query used by
// dharafs_list_dir_classify/its self-test: does `query_buf[0:query_len)`
// exactly match some live entry's first segment under `dir`, and if
// so is it a leaf file or a subdirectory? Same scan either way --
// splitting this into two near-duplicate functions would risk exactly
// the "the two diverge and only one gets fixed later" drift class
// this project has hit before with duplicated read/chain-follow logic
// (see dharafs_read's own doc comment on why it got consolidated).
// Returns (query mode only): 0 = no match, 1 = file, 2 = directory.
fn dharafs_list_dir_raw(dir_buf: mut ref i64, dir_len: i64, query_buf: mut ref i64, query_len: i64) -> i64 {
  let skip_len: i64 = if dir_len == 0 { 1 } else { dir_len + 1 };
  let next_block: u32 = dharafs_state_get_next_block();
  let log_start: u32 = dharafs_state_get_log_start();
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let seen: mut ref i64 = dharafs_data_scratch_get();
  let seen_count: i64 = 0;
  let classify_result: i64 = 0;
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
        let long_enough: i64 = 0;
        if (rec_path_len > (0 as u32)) && ((rec_path_len as i64) > skip_len) {
          long_enough = 1;
        }
        if (long_enough == 1) && (rec_data_len != (0xFFFFFFFF as u32)) {
          let prefix_matches: i64 = 1;
          if dir_len == 0 {
            let first: u32 = buf_read_byte(buf, 12 as u32);
            if first != (47 as u32) {
              prefix_matches = 0;
            }
          } else {
            let k: i64 = 0;
            while k < dir_len {
              let want: u32 = buf_read_byte(dir_buf, k as u32);
              let got: u32 = buf_read_byte(buf, (12 + k) as u32);
              if got != want {
                prefix_matches = 0;
              }
              k = k + 1;
            }
            let slash: u32 = buf_read_byte(buf, (12 + dir_len) as u32);
            if slash != (47 as u32) {
              prefix_matches = 0;
            }
          }
          if (prefix_matches == 1) && (rec_path_len <= (32 as u32)) {
            let path_buf: mut ref i64 = dharafs_path_scratch_get();
            let m: i64 = 0;
            while (m as u32) < rec_path_len {
              let pb: u32 = buf_read_byte(buf, (12 + m) as u32);
              let _ = buf_write_byte(path_buf, m as u32, pb);
              m = m + 1;
            }
            let latest_blk: i64 = dharafs_find_latest_block_raw(path_buf, rec_path_len as i64);
            if latest_blk == blk {
              let rec_path_len_i: i64 = rec_path_len as i64;
              let seg_start: i64 = skip_len;
              let seg_end: i64 = seg_start;
              let found_slash: i64 = 0;
              while (seg_end < rec_path_len_i) && (found_slash == 0) {
                let c: u32 = buf_read_byte(path_buf, seg_end as u32);
                if c == (47 as u32) {
                  found_slash = 1;
                } else {
                  seg_end = seg_end + 1;
                }
              }
              let seg_len: i64 = seg_end - seg_start;
              if query_len > 0 {
                let is_match: i64 = dharafs_dirlist_segment_equals(query_buf, query_len, path_buf, seg_start, seg_len);
                if is_match == 1 {
                  classify_result = if found_slash == 1 { 2 } else { 1 };
                }
              } else {
                if found_slash == 1 {
                  // Subdirectory -- print its name once, however many
                  // live files actually sit underneath it.
                  let already_seen: i64 = dharafs_dirlist_seen_contains(seen, seen_count, path_buf, seg_start, seg_len);
                  if (already_seen == 0) && (seen_count < 128) {
                    let _ = uart_puts("  ");
                    let p: i64 = seg_start;
                    while p < seg_end {
                      let pc: u32 = buf_read_byte(path_buf, p as u32);
                      let _ = uart_putc(pc as i64);
                      p = p + 1;
                    }
                    let _ = uart_puts("/\n");
                    let slot_off: i64 = seen_count * 32;
                    let _ = buf_write_byte(seen, slot_off as u32, seg_len as u32);
                    let q: i64 = 0;
                    while q < seg_len {
                      let sc: u32 = buf_read_byte(path_buf, (seg_start + q) as u32);
                      let _ = buf_write_byte(seen, (slot_off + 1 + q) as u32, sc);
                      q = q + 1;
                    }
                    seen_count = seen_count + 1;
                  }
                } else {
                  // Leaf file directly in this directory.
                  let _ = uart_puts("  ");
                  let p: i64 = seg_start;
                  while p < seg_end {
                    let pc: u32 = buf_read_byte(path_buf, p as u32);
                    let _ = uart_putc(pc as i64);
                    p = p + 1;
                  }
                  let _ = uart_puts("\n");
                }
              }
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return classify_result;
}

fn dharafs_list_dir(dir: Str) -> i64 {
  let dir_len: i64 = str_len_bytes(dir);
  if dir_len > 32 {
    return 1;
  }
  let dir_buf: mut ref i64 = dharafs_dir_scratch_get();
  let i: i64 = 0;
  while i < dir_len {
    let _ = buf_write_byte(dir_buf, i as u32, str_byte_at(dir, i) as u32);
    i = i + 1;
  }
  let dummy: mut ref i64 = dharafs_stat_scratch_get();
  return dharafs_list_dir_raw(dir_buf, dir_len, dummy, 0);
}

// Round 42: silent classification query for self-tests -- does
// `segment` exist as an entry directly under `dir`, and is it a leaf
// file (1) or a subdirectory (2)? 0 if no such entry. Real assertable
// coverage for dharafs_list_dir_raw's segment-splitting/classification
// logic, since the print-oriented dharafs_list_dir has no return value a
// self-test could check (matching dharafs_list's own long-standing print-
// only convention -- this project has no UART-capture mechanism in
// self-tests to assert against printed output instead).
fn dharafs_list_dir_classify(dir: Str, segment: Str) -> i64 {
  let dir_len: i64 = str_len_bytes(dir);
  let seg_len: i64 = str_len_bytes(segment);
  if dir_len > 32 {
    return 0;
  }
  // seg_buf below reuses the 12-byte dharafs_stat_scratch buffer (nothing
  // else needs a dedicated one just for this) -- plenty for any
  // realistic single path segment, but genuinely a real cap, not an
  // arbitrary one, so enforce it rather than silently overrunning.
  if seg_len > 11 {
    return 0;
  }
  let dir_buf: mut ref i64 = dharafs_dir_scratch_get();
  let i: i64 = 0;
  while i < dir_len {
    let _ = buf_write_byte(dir_buf, i as u32, str_byte_at(dir, i) as u32);
    i = i + 1;
  }
  let seg_buf: mut ref i64 = dharafs_stat_scratch_get();
  let j: i64 = 0;
  while j < seg_len {
    let _ = buf_write_byte(seg_buf, j as u32, str_byte_at(segment, j) as u32);
    j = j + 1;
  }
  return dharafs_list_dir_raw(dir_buf, dir_len, seg_buf, seg_len);
}

// Round 42: real, assertable coverage for the owner/group/other rwx
// permission model -- not just "does it compile", but a genuine
// allowed-vs-denied round trip from a non-root context, plus root's
// bypass and dharafs_chmod actually changing the outcome. Rebuilds path/
// data scratch buffers fresh before each raw-buffer call rather than
// assuming they survive an intervening Str-based call unclobbered
// (dharafs_chmod, for one, reuses both internally for its own purposes).
fn dharafs_permissions_self_test() -> i64 {
  let ok: i64 = 1;
  let _ = dharafs_user_set(0 as u32, 0 as u32); // start as root, the default

  let _ = dharafs_append("/perm/rootfile", "secret"); // root, default mode 0o644

  let path1: Str = "/perm/rootfile";
  let path1_len: i64 = str_len_bytes(path1);

  // Non-root, non-owning-group user: mode 644's other-read bit allows
  // reading...
  let _ = dharafs_user_set(100 as u32, 100 as u32);
  let path1_buf: mut ref i64 = dharafs_path_scratch_get();
  let i1: i64 = 0;
  while i1 < path1_len {
    let _ = buf_write_byte(path1_buf, i1 as u32, str_byte_at(path1, i1) as u32);
    i1 = i1 + 1;
  }
  let read_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let read_status: i64 = dharafs_read_raw_checked(path1_buf, path1_len, read_buf, 100 as u32, 100 as u32);
  if read_status < 0 {
    ok = 0;
  }

  // ...but 644 has no other-write bit, so writing is denied.
  let data1: Str = "hacked";
  let data1_len: i64 = str_len_bytes(data1);
  let data1_buf: mut ref i64 = dharafs_data_scratch_get();
  let j1: i64 = 0;
  while j1 < data1_len {
    let _ = buf_write_byte(data1_buf, j1 as u32, str_byte_at(data1, j1) as u32);
    j1 = j1 + 1;
  }
  let write_status: i64 = dharafs_write_raw_checked(path1_buf, path1_len, data1_buf, data1_len, 100 as u32, 100 as u32);
  if write_status != (0 - 2) {
    ok = 0;
  }

  // Deletion needs write permission too -- also denied.
  let del_status: i64 = dharafs_delete_raw_checked(path1_buf, path1_len, 100 as u32, 100 as u32);
  if del_status != (0 - 2) {
    ok = 0;
  }

  // A brand-new path has no existing owner to be denied by -- non-root
  // creation succeeds, and the new file's owner is the REQUESTER
  // (100), not incidentally root, proving dharafs_write_raw_checked's
  // new-file default actually uses its req_uid/req_gid parameters.
  let path2: Str = "/perm/userfile";
  let path2_len: i64 = str_len_bytes(path2);
  let path2_buf: mut ref i64 = dharafs_dir_scratch_get();
  let i2: i64 = 0;
  while i2 < path2_len {
    let _ = buf_write_byte(path2_buf, i2 as u32, str_byte_at(path2, i2) as u32);
    i2 = i2 + 1;
  }
  let data2: Str = "mine";
  let data2_len: i64 = str_len_bytes(data2);
  let data2_buf: mut ref i64 = dhruva_alloc_bytes(16);
  let j2: i64 = 0;
  while j2 < data2_len {
    let _ = buf_write_byte(data2_buf, j2 as u32, str_byte_at(data2, j2) as u32);
    j2 = j2 + 1;
  }
  let create_status: i64 = dharafs_write_raw_checked(path2_buf, path2_len, data2_buf, data2_len, 100 as u32, 100 as u32);
  if create_status != 0 {
    ok = 0;
  }
  let meta_check: mut ref i64 = dhruva_alloc_bytes(12);
  let stat_check: i64 = dharafs_stat("/perm/userfile", meta_check);
  if stat_check != 0 {
    ok = 0;
  }
  if buf_read_u32(meta_check, 0 as u32) != (100 as u32) {
    ok = 0;
  }

  // Root bypasses every check regardless of mode.
  let _ = dharafs_user_set(0 as u32, 0 as u32);
  let path1_buf_r: mut ref i64 = dharafs_path_scratch_get();
  let i3: i64 = 0;
  while i3 < path1_len {
    let _ = buf_write_byte(path1_buf_r, i3 as u32, str_byte_at(path1, i3) as u32);
    i3 = i3 + 1;
  }
  let data1_buf_r: mut ref i64 = dharafs_data_scratch_get();
  let j3: i64 = 0;
  while j3 < data1_len {
    let _ = buf_write_byte(data1_buf_r, j3 as u32, str_byte_at(data1, j3) as u32);
    j3 = j3 + 1;
  }
  let root_write_status: i64 = dharafs_write_raw_checked(path1_buf_r, path1_len, data1_buf_r, data1_len, 0 as u32, 0 as u32);
  if root_write_status != 0 {
    ok = 0;
  }

  // dharafs_chmod loosens rootfile to world-writable (0o666 = 438 decimal);
  // the same non-root write that was denied above now succeeds.
  let _ = dharafs_chmod("/perm/rootfile", 438 as u32);
  let _ = dharafs_user_set(100 as u32, 100 as u32);
  let path1_buf2: mut ref i64 = dharafs_path_scratch_get();
  let i4: i64 = 0;
  while i4 < path1_len {
    let _ = buf_write_byte(path1_buf2, i4 as u32, str_byte_at(path1, i4) as u32);
    i4 = i4 + 1;
  }
  let data1_buf2: mut ref i64 = dharafs_data_scratch_get();
  let j4: i64 = 0;
  while j4 < data1_len {
    let _ = buf_write_byte(data1_buf2, j4 as u32, str_byte_at(data1, j4) as u32);
    j4 = j4 + 1;
  }
  let write_status2: i64 = dharafs_write_raw_checked(path1_buf2, path1_len, data1_buf2, data1_len, 100 as u32, 100 as u32);
  if write_status2 != 0 {
    ok = 0;
  }

  // Restore the default root context so later self-tests/the shell
  // don't inherit this test's leftover non-root session.
  let _ = dharafs_user_set(0 as u32, 0 as u32);

  let _ = uart_puts("DharaFS: permission model (owner/group/other rwx, root bypass, chmod) enforces read/write/delete correctly");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 42: real, assertable coverage for directory-hierarchy
// listing -- dharafs_list_dir_classify (the query-mode twin of the print-
// oriented dharafs_list_dir the shell's "ls <dir>" uses) confirms a leaf
// file is classified as a file, a nested path's first segment is
// classified as a directory (not the flat full-path string dharafs_list's
// own prefix scan would show), and a name that doesn't exist under
// that directory classifies as neither.
fn dharafs_directory_hierarchy_self_test() -> i64 {
  let ok: i64 = 1;
  let _ = dharafs_append("/docs/readme", "hello");
  let _ = dharafs_append("/docs/notes", "abc");
  let _ = dharafs_append("/docs/sub/deep", "nested");

  if dharafs_list_dir_classify("/docs", "readme") != 1 {
    ok = 0;
  }
  if dharafs_list_dir_classify("/docs", "notes") != 1 {
    ok = 0;
  }
  if dharafs_list_dir_classify("/docs", "sub") != 2 {
    ok = 0;
  }
  // "deep" lives under /docs/sub, not directly under /docs -- must
  // NOT show up as an entry of /docs itself.
  if dharafs_list_dir_classify("/docs", "deep") != 0 {
    ok = 0;
  }
  // Querying the actual subdirectory directly finds its own leaf file.
  if dharafs_list_dir_classify("/docs/sub", "deep") != 1 {
    ok = 0;
  }
  // Root-level listing: /docs itself is a top-level directory.
  if dharafs_list_dir_classify("", "docs") != 2 {
    ok = 0;
  }

  let _ = uart_puts("DharaFS: directory hierarchy (dharafs_list_dir) distinguishes files from subdirectories");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

fn dharafs_list(prefix: Str) -> i64 {
  let prefix_len: i64 = str_len_bytes(prefix);
  let next_block: u32 = dharafs_state_get_next_block();
  let log_start: u32 = dharafs_state_get_log_start();
  let buf: mut ref i64 = dharafs_sd_scratch_get();
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = dharafs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
        let long_enough: i64 = 0;
        // Round 39: rec_path_len == 0 marks a continuation block (see
        // dharafs_init's own header comment), never independently listable
        // -- excluded explicitly rather than relying on the >=
        // prefix_len check below to happen to exclude it (it wouldn't,
        // for an empty "list everything" prefix, prefix_len == 0 too).
        if (rec_path_len > (0 as u32)) && ((rec_path_len as i64) >= prefix_len) {
          long_enough = 1;
        }
        if (long_enough == 1) && (rec_data_len != (0xFFFFFFFF as u32)) {
          let prefix_matches: i64 = 1;
          let k: i64 = 0;
          while k < prefix_len {
            let want: i64 = str_byte_at(prefix, k);
            let got: u32 = buf_read_byte(buf, (12 + k) as u32);
            if (got as i64) != want {
              prefix_matches = 0;
            }
            k = k + 1;
          }
          // BUG (found via audit, 2026-08-27): rec_path_len feeds the
          // copy loop below with only a checksum match backing it --
          // strong evidence against corruption, not proof (see dharafs_
          // compact's identical fix for the full reasoning). Reject
          // rather than let an out-of-range length overflow dharafs_path_
          // scratch's real 32-byte capacity.
          if (prefix_matches == 1) && (rec_path_len <= (32 as u32)) {
            // Copy the path out before calling dharafs_find_latest_block_
            // raw below: it reuses dharafs_sd_scratch (the same persistent
            // buffer as `buf` above) for its own scan, so `buf`'s
            // current record is only safe to keep reading from up to
            // this point -- everything this branch still needs from it
            // (rec_path_len, and now these bytes) has to be pulled out
            // first. path_buf itself is a separate persistent buffer
            // (dharafs_path_scratch), untouched by that scan.
            let path_buf: mut ref i64 = dharafs_path_scratch_get();
            let m: i64 = 0;
            while (m as u32) < rec_path_len {
              let pb: u32 = buf_read_byte(buf, (12 + m) as u32);
              let _ = buf_write_byte(path_buf, m as u32, pb);
              m = m + 1;
            }
            let latest_blk: i64 = dharafs_find_latest_block_raw(path_buf, rec_path_len as i64);
            if latest_blk == blk {
              let _ = uart_puts("  ");
              let p: i64 = 0;
              while (p as u32) < rec_path_len {
                let pc: u32 = buf_read_byte(path_buf, p as u32);
                let _ = uart_putc(pc as i64);
                p = p + 1;
              }
              let _ = uart_puts("\n");
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return 0;
}

fn dharafs_print_data(buf: mut ref i64, byte_len: i64) -> i64 {
  let i: i64 = 0;
  while i < byte_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = uart_putc(b as i64);
    i = i + 1;
  }
  return 0;
}

// Round 72: shell input echo. Confirmed by direct inspection (see
// shell_state.S's own original header comment) that this shell never
// echoed anything typed, for any command -- irq_dispatch's UART-RX
// branch only ever called shell_rx_push_char (buffers the byte), never
// uart_putc/uart_putc_nonblocking. Found as a real, still-open gap
// while building authentication (round 61): the OPPOSITE problem from
// what that round's own scoping note worried about (it checked whether
// typed passwords were ALREADY leaking into the UART stream via
// pre-existing echo -- they weren't, since there was no echo at all --
// but flagged that normal typing then has zero visual feedback either,
// and that adding real echo later would need its own password-mode
// suppression at that point, not before).
//
// `su <uid> <gid> [password]` and `passwd <uid> <new_password>` take
// their password as a plain argument on the same typed line (see
// shell_dispatch_su/_passwd), not a separate hidden-input prompt --
// there is no point in the character stream where "now entering a
// password" is announced up front. This state machine matches "su "
// or "passwd " as a literal PREFIX of the line, character by
// character, as they're typed: any character before that prefix is
// confirmed (or ruled out) still gets echoed normally (state 0-15,
// "still undetermined" or "partially matched"); state 99 means the
// line diverged from both prefixes ("cat ...", "ls", etc.) and echoes
// normally for the rest of the line; state 100 means EXACTLY "su " or
// "passwd " was just completed, and suppresses ALL further echo
// (including the uid/gid arguments too, not just the password itself)
// for the rest of the line -- deliberately coarser than token-precise
// suppression, and a real, considered choice: getting the token
// boundary exactly right would need tracking space-delimited argument
// positions too, real additional complexity for a security-adjacent
// feature where "hides a little more than strictly necessary" has no
// downside, unlike "hides a little less than necessary" (which would
// leak password characters). Once in state 100, backspace does NOT
// walk the state back -- correct for the common case (backspacing
// mid-password should obviously keep suppressing), a known, honest
// imprecision for the rare case of backspacing while still typing
// "su"/"passwd" itself before the confirming space (could
// theoretically leave state matching a prefix that's no longer what's
// actually on the line) -- not attempted, real but low-stakes.
fn shell_echo_state_suppress() -> u32 { return 100 as u32; }
fn shell_echo_state_other() -> u32 { return 99 as u32; }

fn shell_echo_advance(state: u32, c: u32) -> u32 {
  if state == shell_echo_state_suppress() { return shell_echo_state_suppress(); }
  if state == shell_echo_state_other() { return shell_echo_state_other(); }
  if state == (0 as u32) {
    if c == (115 as u32) { return 1 as u32; }  // 's' -- could become "su"
    if c == (112 as u32) { return 10 as u32; } // 'p' -- could become "passwd"
    return shell_echo_state_other();
  }
  if state == (1 as u32) { // "s"
    if c == (117 as u32) { return 2 as u32; } // 'u'
    return shell_echo_state_other();
  }
  if state == (2 as u32) { // "su"
    if c == (32 as u32) { return shell_echo_state_suppress(); } // ' ' -- confirmed "su "
    return shell_echo_state_other();
  }
  if state == (10 as u32) { // "p"
    if c == (97 as u32) { return 11 as u32; } // 'a'
    return shell_echo_state_other();
  }
  if state == (11 as u32) { // "pa"
    if c == (115 as u32) { return 12 as u32; } // 's'
    return shell_echo_state_other();
  }
  if state == (12 as u32) { // "pas"
    if c == (115 as u32) { return 13 as u32; } // 's'
    return shell_echo_state_other();
  }
  if state == (13 as u32) { // "pass"
    if c == (119 as u32) { return 14 as u32; } // 'w'
    return shell_echo_state_other();
  }
  if state == (14 as u32) { // "passw"
    if c == (100 as u32) { return 15 as u32; } // 'd'
    return shell_echo_state_other();
  }
  if state == (15 as u32) { // "passwd"
    if c == (32 as u32) { return shell_echo_state_suppress(); } // ' ' -- confirmed "passwd "
    return shell_echo_state_other();
  }
  return shell_echo_state_other(); // unreachable, defensive
}

// Echoes one just-received byte per the current line's echo state,
// then returns the state to persist for the NEXT byte. `line_len_before`
// is the line's length as of BEFORE this byte was pushed into it (the
// caller must capture this first) -- needed to decide whether a
// backspace/DEL actually had anything to erase, since shell_rx_push_char
// itself will already have decremented it by the time this runs.
// uart_putc_nonblocking, not the blocking uart_putc, throughout -- this
// runs inside irq_dispatch, a #[interrupt]-tagged function that must
// stay WCET-provable, and uart_putc's own FIFO-full wait loop has no
// static iteration bound (see that function's own header comment).
fn shell_echo_char(state: u32, c: u32, line_len_before: u32) -> u32 {
  if (c == (13 as u32)) || (c == (10 as u32)) { // CR / LF
    let _ = uart_putc_nonblocking(13);
    let _ = uart_putc_nonblocking(10);
    return 0 as u32; // new line -- reset the matcher
  }
  let suppressed: i64 = if state == shell_echo_state_suppress() { 1 } else { 0 };
  if (c == (8 as u32)) || (c == (127 as u32)) { // backspace / DEL
    if (suppressed == 0) && (line_len_before > (0 as u32)) {
      let _ = uart_putc_nonblocking(8);
      let _ = uart_putc_nonblocking(32); // ' ' -- erase the character visually
      let _ = uart_putc_nonblocking(8);
    }
    return state; // see this function group's own header comment on why backspace never un-suppresses
  }
  if suppressed == 0 {
    let _ = uart_putc_nonblocking(c as i64);
  }
  return shell_echo_advance(state, c);
}

// White-box test of the matcher (shell_echo_advance) alone -- exercises
// "su ", "passwd ", a non-matching line ("cat "), and a backspace mid-
// suppression -- without going through real UART hardware, matching
// this codebase's own established pattern of testing state-machine
// logic directly and reserving live/interactive checks for hardware
// behavior no self-test can observe (the actual echoed/suppressed
// bytes on the wire).
fn shell_echo_self_test() -> i64 {
  let ok: i64 = 1;

  // "su " -- 0 -> 1 -> 2 -> suppress
  let s: u32 = 0 as u32;
  s = shell_echo_advance(s, 115 as u32); // 's'
  if s != (1 as u32) { ok = 0; }
  s = shell_echo_advance(s, 117 as u32); // 'u'
  if s != (2 as u32) { ok = 0; }
  s = shell_echo_advance(s, 32 as u32);  // ' '
  if s != shell_echo_state_suppress() { ok = 0; }
  s = shell_echo_advance(s, 120 as u32); // 'x' -- stays suppressed
  if s != shell_echo_state_suppress() { ok = 0; }

  // "passwd " -- 0 -> 10 -> 11 -> 12 -> 13 -> 14 -> 15 -> suppress
  let p: u32 = 0 as u32;
  p = shell_echo_advance(p, 112 as u32); // 'p'
  if p != (10 as u32) { ok = 0; }
  p = shell_echo_advance(p, 97 as u32);  // 'a'
  p = shell_echo_advance(p, 115 as u32); // 's'
  p = shell_echo_advance(p, 115 as u32); // 's'
  p = shell_echo_advance(p, 119 as u32); // 'w'
  p = shell_echo_advance(p, 100 as u32); // 'd'
  if p != (15 as u32) { ok = 0; }
  p = shell_echo_advance(p, 32 as u32);  // ' '
  if p != shell_echo_state_suppress() { ok = 0; }

  // non-matching line ("cat ") falls to "other" and stays there
  let n: u32 = 0 as u32;
  n = shell_echo_advance(n, 99 as u32); // 'c' -- not 's' or 'p'
  if n != shell_echo_state_other() { ok = 0; }
  n = shell_echo_advance(n, 97 as u32);
  if n != shell_echo_state_other() { ok = 0; }

  // a near-miss prefix ("sx") falls out of the match, doesn't suppress
  let m: u32 = 0 as u32;
  m = shell_echo_advance(m, 115 as u32); // 's'
  m = shell_echo_advance(m, 120 as u32); // 'x' -- not 'u'
  if m != shell_echo_state_other() { ok = 0; }

  // CR resets shell_echo_char's returned state regardless of matcher state
  let reset: u32 = shell_echo_char(shell_echo_state_suppress(), 13 as u32, 5 as u32);
  if reset != (0 as u32) { ok = 0; }

  let _ = uart_puts("Shell: input-echo matcher (su/passwd suppression)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Runs in real IRQ context (called from boot/irq_entry.S's irq_entry,
// itself reached only via the hardware vector table -- never via a
// normal vani call chain). #[interrupt] gets real value here: it
// statically forbids heap allocation, unbounded recursion, lock-
// acquiring calls, and task/parallel-for spawns in this function's
// body -- exactly the set of things that would be genuinely unsafe to
// do from inside an ISR. It does NOT generate any ISR-specific
// codegen (register save/restore, vector entry, interrupt-return
// instruction) -- confirmed by checking all four backends contain no
// reference to the `interrupt` flag at all. That part is entirely
// boot/irq_entry.S and boot/rpi1/vectors.S's job.
#[no_mangle]
#[interrupt(priority=0)]
#[bounded_stack(bytes=1024)]
#[wcet(cycles=130000)]
// Round 72: budget raised from 100000 -- the new per-byte shell-echo
// call (shell_echo_char, invoked from the UART RX branch below) pushed
// the static estimate to 118044 cycles. Re-audited: still small,
// branch-only, no loops of its own, called at most once per received
// byte -- genuinely more work, not a WCET-estimator regression.
// BUG (round 4 audit, 2026-08-27): this function's return value used
// to be unconditionally 0, unused by every caller. scheduler_switch_
// from_irq (context_switch.S) -- called from irq_entry.S right after
// this function returns, on EVERY IRQ entry -- increments tick_count
// unconditionally too, even though its own doc comment claims it does
// so "every timer tick, exactly once." Those two facts together are a
// real bug: a UART RX interrupt (fires whenever a character is typed
// at the interactive shell, entirely independent of the 500ms timer)
// advanced tick_count exactly as much as a genuine timer tick did.
// tick_count is this whole scheduler's only notion of elapsed time --
// every task_sleep_ticks call and every sleep_until_table comparison
// is defined in terms of it -- so typing at the shell while any
// task's sleep was pending silently shortened that sleep, system-wide,
// with no relationship to how much real wall-clock time had actually
// passed. Concretely live in this project's own phase4_milestone.py,
// which types multiple shell commands while task_a/b/c's priority-
// inversion demo and task_e's GC pass are running concurrently in the
// background -- exactly the scenario that would speed both up.
// Fixed by returning 1 here iff the timer branch below actually fired
// this call, 0 otherwise, so irq_entry.S can pass that flag through to
// scheduler_switch_from_irq and gate the tick_count increment on it.
fn irq_dispatch() -> i64 {
  let _ = irq_count_increment();
  let ic_pending1: i64 = IC_PENDING1;
  let pending: u32 = mmio_read_u32(ic_pending1);
  let was_timer_tick: i64 = 0;
  if (pending & (2 as u32)) != (0 as u32) {
    let timer_cs: i64 = TIMER_CS;
    let timer_clo: i64 = TIMER_CLO;
    let timer_c1: i64 = TIMER_C1;

    // Acknowledge channel 1's match (write-1-to-clear) and reschedule
    // the next one 500ms out, before doing anything else -- if the
    // tick-handling work below ever took long enough to matter, the
    // next deadline should already be armed, not computed late.
    let _ = mmio_write_u32(timer_cs, 2 as u32);
    let now: u32 = mmio_read_u32(timer_clo);
    let interval: u32 = 500000 as u32;
    let next: u32 = now + interval;
    let _ = mmio_write_u32(timer_c1, next);

    // watchdog_kick() would belong here, once per tick -- see
    // watchdog_arm's comment for why it isn't actually called: doing
    // so resets QEMU's raspi1ap immediately rather than arming a real
    // countdown, which would break the only test method this project
    // has.
    //
    // '.' instead of "tick\n": uart_puts's own wait loop makes it
    // unboundable under #[wcet(...)] (see uart_putc_nonblocking's
    // comment) -- a single best-effort byte keeps ticks visible in
    // the log without reintroducing a blocking call to a hard-RT ISR.
    let _ = uart_putc_nonblocking(46);

    // Round 62 (fault injection): `fault irqburst <n>` -- see
    // fault_irqburst_take's own comment for exactly what this does
    // and does NOT simulate. Jumps the clock forward by n EXTRA ticks
    // before scheduler_switch_from_irq (called by our own caller,
    // irq_entry.S) does its normal +1 -- net effect, this tick's
    // tick_count advances by n+1 instead of 1.
    let irqburst_extra: u32 = fault_irqburst_take();
    if irqburst_extra > (0 as u32) {
      let _ = scheduler_set_tick_count_test_only(scheduler_get_tick_count() + irqburst_extra);
    }

    was_timer_tick = 1;
  }

  let ic_pending2: i64 = IC_PENDING2;
  let pending2: u32 = mmio_read_u32(ic_pending2);
  if (pending2 & (0x02000000 as u32)) != (0 as u32) {
    let uart_fr: i64 = UART_FR;
    let uart_dr: i64 = UART_DR;
    let uart_icr: i64 = UART_ICR;
    // Drain the RX FIFO for up to 128 iterations -- shell_line_buf's
    // own capacity (shell_state.S), not the PL011's real 16-byte
    // hardware FIFO depth. A `while` loop here, even one with a
    // literal constant bound checked every iteration, is
    // unconditionally treated as UNBOUNDED by vani's v1 WCET estimator
    // (confirmed in src/safety.rs: `S::While { .. } => None --
    // unbounded, no static iteration count`, with no attempt to prove
    // a bound from the loop body at all) -- only `for i from LOW to
    // HIGH` (vani's own range-for syntax -- not Rust's `0..N`, which
    // the parser rejects) carries a statically-known trip count the
    // estimator can multiply through. `break` was a red herring on the
    // way to finding this: the *first* fix attempt (skip-instead-of-
    // break, still inside a `while`) still failed for the real
    // underlying reason, not the one guessed first.
    //
    // BUG (task #9, found by an event-driven interactive test, not a
    // sleep-timed one -- see shell_interactive_check.py's own header
    // for why the sleep-timed version this replaced was worthless
    // here): 16 iterations undercounts real bursts. QEMU's stdio
    // chardev backend hands a whole typed-then-Entered line to the
    // emulated PL011 as one burst, faster than the guest can service
    // interrupts -- so any line at or past 17 bytes (e.g. "cat
    // /config/mode\r", 17 bytes) left its trailing byte (here, the
    // terminating CR) stuck in the FIFO below the RX interrupt's own
    // trigger threshold, so no further interrupt ever fired to deliver
    // it, shell_line_ready never got set for that line, and every
    // command after the first appeared to vanish without a trace --
    // while the rest of the system (HIGH/MEDIUM/LOW/idle/GC) kept
    // running completely normally throughout, since nothing about this
    // hangs or blocks anything, it just silently stops delivering. 128
    // -- shell_line_buf's own hard cap on how long a line can ever
    // legitimately be -- comfortably covers one full line every time.
    for i from 0 to 128 {
      let fr: u32 = mmio_read_u32(uart_fr);
      if (fr & (0x10 as u32)) == (0 as u32) {
        let c: u32 = mmio_read_u32(uart_dr) & (0xFF as u32);
        let line_len_before: u32 = shell_get_line_len();
        let _ = shell_rx_push_char(c);
        // Round 72: input echo (see shell_echo_char's own header
        // comment for why this needs to run here, and how su/passwd's
        // password argument gets suppressed).
        let echo_state: u32 = shell_get_echo_state();
        let new_echo_state: u32 = shell_echo_char(echo_state, c, line_len_before);
        let _ = shell_set_echo_state(new_echo_state);
      }
    }
    // Draining the FIFO above is what actually de-asserts this
    // level-triggered condition; this just clears any stale raw
    // status defensively, same pattern as the timer branch above.
    let _ = mmio_write_u32(uart_icr, 0x10 as u32);
  }

  // Round 66: sample the running counters into the history ring buffer
  // once per REAL tick only (not every UART RX interrupt) -- ties
  // "last N seconds" semantics to wall-clock ticks, not arbitrary IRQ
  // frequency, and keeps this at the same ~500ms granularity as every
  // other tick-driven thing in this project (the governor, sleep_
  // until_table). scheduler_get_tick_count() is read fresh here rather
  // than reusing anything already in scope -- this project's own tick
  // advance happens in scheduler_switch_from_irq, called by our OWN
  // caller (irq_entry.S) AFTER irq_dispatch returns, so the value at
  // this exact point is still last tick's count, one behind what this
  // sample will actually represent by the time anything reads it back.
  // Not a bug worth chasing: the counters sampled alongside it
  // (context_switch/irq/prio_lock) are already exactly "as of now,"
  // and being one tick's worth of x-axis label behind them is a
  // cosmetic granularity question, not a correctness one, for a
  // "roughly what was activity like recently" query.
  if was_timer_tick == 1 {
    let _ = diag_ring_push(scheduler_get_tick_count(), context_switch_count_get() as u32, irq_count_get() as u32, prio_lock_count_get() as u32);

    // Round 68 (this investigation): per-task stack overflow canary
    // check (see boot/stack_canary.S's own header for the full "why").
    // Same once-per-real-tick cadence as diag_ring_push just above --
    // catches a breach within ~500ms of it happening and names the
    // exact task, instead of the corruption silently propagating until
    // it eventually surfaces as an unrelated wild-pointer crash
    // arbitrarily far downstream, which is what made every one of this
    // bug class's four prior incidents (round 9, 27, 60, 67) so hard to
    // diagnose. Not a fix for the overflow itself -- see that file's
    // comment for why a real MMU guard page isn't possible yet at this
    // project's current 1MB section granularity.
    let canary_breach: u32 = stack_canary_check_all();
    if canary_breach != (0 as u32) {
      // Fixed, unrolled sequence of single-byte non-blocking putc
      // calls -- not uart_puts (blocking `while`, unbounded under
      // #[wcet(...)], see uart_put_hex32_irq's own comment above for
      // why) -- printing "CANARY mask=<hex> tick=<hex>\n" one
      // hardcoded byte at a time.
      let _ = uart_putc_nonblocking(67); // C
      let _ = uart_putc_nonblocking(65); // A
      let _ = uart_putc_nonblocking(78); // N
      let _ = uart_putc_nonblocking(65); // A
      let _ = uart_putc_nonblocking(82); // R
      let _ = uart_putc_nonblocking(89); // Y
      let _ = uart_putc_nonblocking(32); // ' '
      let _ = uart_put_hex32_irq(canary_breach);
      let _ = uart_putc_nonblocking(32); // ' '
      let _ = uart_put_hex32_irq(scheduler_get_tick_count());
      let _ = uart_putc_nonblocking(10); // '\n'
    }
  }
  return was_timer_tick;
}

// Phase 6: network byte order helpers, shared by ARP/IPv4/UDP/TCP
// below. Every multi-byte field in a real network protocol is
// transmitted big-endian ("network byte order"), regardless of the
// host CPU's own endianness -- and ARM1176JZF-S here defaults to
// little-endian, the same as the rest of this project's MMIO/buffer
// code (buf_read_u32/buf_write_u32 from dharafs_buf.S use plain ldr/str,
// which read/write in the HOST's native order, correct for this
// project's own filesystem records but wrong for anything that has to
// interoperate with a real remote host). These read/write byte-by-byte
// in the correct wire order regardless of host endianness, exactly
// like every multi-byte field already handled by hand in netif's own
// MAC/ethertype writes above -- just named and reusable instead of
// repeated inline each time.
fn buf_write_u16_be(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b1: u32 = value & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  return 0;
}

fn buf_read_u16_be(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  return (b0 << (8 as u32)) | b1;
}

fn buf_write_u32_be(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = (value >> (24 as u32)) & (0xFF as u32);
  let b1: u32 = (value >> (16 as u32)) & (0xFF as u32);
  let b2: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b3: u32 = value & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  let _ = buf_write_byte(buf, (offset + 2) as u32, b2);
  let _ = buf_write_byte(buf, (offset + 3) as u32, b3);
  return 0;
}

fn buf_read_u32_be(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  let b2: u32 = buf_read_byte(buf, (offset + 2) as u32);
  let b3: u32 = buf_read_byte(buf, (offset + 3) as u32);
  return (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3;
}

// Little-endian counterparts to the two above -- every multi-byte
// field this project has built on the wire so far (Ethernet/IP/ICMP/
// UDP/TCP/DHCP) is network byte order (big-endian), but USB's own
// wire format (descriptors, and round 33's Bulk-Only Transport CBW/
// CSW fields) is little-endian throughout, per spec. Kept as their
// own small helpers rather than a byte-order parameter on the BE
// versions, matching this project's own preference for a distinct,
// obviously-named function over a flag that silently changes behavior.
fn buf_write_u32_le(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = value & (0xFF as u32);
  let b1: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b2: u32 = (value >> (16 as u32)) & (0xFF as u32);
  let b3: u32 = (value >> (24 as u32)) & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  let _ = buf_write_byte(buf, (offset + 2) as u32, b2);
  let _ = buf_write_byte(buf, (offset + 3) as u32, b3);
  return 0;
}

fn buf_read_u32_le(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  let b2: u32 = buf_read_byte(buf, (offset + 2) as u32);
  let b3: u32 = buf_read_byte(buf, (offset + 3) as u32);
  return b0 | (b1 << (8 as u32)) | (b2 << (16 as u32)) | (b3 << (24 as u32));
}

// 16-bit counterparts, added round 66 for BLE's own HCI ACL/L2CAP/ATT
// framing -- every one of those layers is little-endian throughout
// (Bluetooth Core Spec) and uses FAR more 16-bit fields (lengths,
// channel IDs, connection handles, attribute handles, UUIDs) than the
// existing HCI command builders above ever needed individually
// (those write each field inline, byte by byte -- fine for one or two
// 16-bit fields per function, real duplication once every field in an
// entire protocol stack is 16-bit LE).
fn buf_write_u16_le(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = value & (0xFF as u32);
  let b1: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  return 0;
}

fn buf_read_u16_le(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  return b0 | (b1 << (8 as u32));
}

// Phase 6: generic netif abstraction (DHRUVA_ARCHITECTURE.md §4's own
// "get-go hook": "send/receive a raw frame, MTU, MAC address... just
// an interface, no implementation. Both the LAN9512 wired path and
// the WiFi dongle plug into the same upper-stack path without a
// redesign"). This is the ONE implementation that exists so far: a
// loopback netif, backing everything built on top of it (ARP/IPv4/
// UDP/TCP) for QEMU testing, per §4's own note that no real network
// hardware is emulated for any Pi generation QEMU models. vani has no
// dynamic dispatch -- no way to swap netif implementations at runtime
// via a function-pointer table, since a function's address can't be
// taken as arbitrary integer data (an established finding from this
// project's own Phase 1 work) -- so "the interface" here is a
// naming/layering convention (ARP/IPv4 call netif_send_frame/
// netif_recv_frame by name) rather than a true runtime-swappable
// vtable, consistent with how every other layer in this project
// (dharafs_*, shell_*) is already structured, and the only netif
// implementation that will ever exist under QEMU regardless of how
// this is designed.
//
// Frames are raw Ethernet: [dst_mac(6)][src_mac(6)][ethertype(2)]
// [payload...] -- the same framing a real hardware netif (LAN9512,
// the WiFi dongle) will need later, so ARP/IPv4 above this get written
// hardware-realistic from the start, not as a loopback-only shortcut.
fn netif_init() -> i64 {
  let buf: mut ref i64 = dhruva_alloc_bytes(4 * netif_frame_slot_size());
  let _ = netif_set_queue_buf(buf);
  return 0;
}

// Round 66 fix: the whole-frame slot size (Ethernet header + payload),
// now a real 1500-byte-MTU-sized 1514 bytes -- a single shared
// accessor every buffer/cap derived from frame size must call, the
// same discipline netif_get_mtu() below already established for the
// send-path payload bound. Previously a bare 512 (deliberately
// smaller than a real Ethernet MTU, since nothing this project could
// test end-to-end under QEMU needed a full-size frame) was hand-
// copied as a literal at every netif_recv_frame call site instead of
// derived from one place -- exactly the "loopback-era assumption"
// docs/TODO.md's own bug entry describes: a real DHCPOFFER (590
// bytes, options included) exceeds 512 and got silently dropped by
// dhcp_client_poll specifically, though every 512-sized receive
// buffer/cap in this file shared the same latent limit. Fixed by
// introducing this accessor and updating every send- and receive-side
// site that used to hardcode 512 to call it instead (netif_init's
// ring-buffer allocation and netif_send_frame's slot arithmetic/cap
// in this same file; net_send_scratch/net_recv_scratch/dhcp_frame_
// scratch's own allocations; and icmp_poll/socket_udp_recv/tcp_conn_
// poll/dhcp_client_poll's own netif_recv_frame calls) -- raising
// netif_get_mtu() alone, without raising net_send_scratch's own
// allocation in lockstep, would have reintroduced a real heap buffer
// overflow instead (ipv4_send/udp_send/tcp_send_segment write
// directly into that scratch buffer up to netif_get_mtu()'s own bound
// with no independent bounds check of their own -- confirmed by
// reading their bodies directly, not assumed). Self-test-local
// buffers (DHCP/TCP self-tests' own synthetic frames, all well under
// the old 512 already) were deliberately left untouched -- they
// construct their own bounded test data and don't exercise this path.
fn netif_frame_slot_size() -> i64 {
  return 1514;
}

// Payload MTU: netif_frame_slot_size() minus the 14-byte Ethernet
// header -- a real 1500-byte Ethernet MTU as of round 66 (previously
// 498, deliberately smaller -- see netif_frame_slot_size's own comment
// for the full round-66 fix).
//
// RE-AUDITED (round 20, 2026-08-28), no drift found: ipv4_send/
// udp_send/tcp_send_segment (round 11 fix) still derive their bounds
// from this function alone, still boundary-exact (max payload always
// produces exactly a full-slot-sized frame, matching netif_send_
// frame's own cutoff with zero slack), and no new hardcoded literal
// duplicating this value has crept back in anywhere since. Receive-
// side callers (socket_udp_recv, tcp_conn_handle_segment, dhcp_
// client_poll) take the caller's real buffer capacity as a required
// parameter rather than re-deriving a number, so they were never
// exposed to this class of drift in the first place -- confirmed
// every call site's allocation still matches what it passes. Also
// checked dhcp_find_option_byte/u32's own TLV parsing (untouched by
// round 11, since that round's scope was send-path bounds only):
// already correctly bounds-checks every option read against `end`
// before dereferencing, including the malicious-opt_len case, so no
// over-read is possible even from a hostile DHCP reply.
fn netif_get_mtu() -> i64 {
  return netif_frame_slot_size() - 14;
}

// Loopback's own placeholder MAC: a locally-administered address (bit
// 1 of the first octet set, per IEEE 802 convention for non-vendor
// addresses) rather than a real vendor OUI, so it can never collide
// with an actual NIC's burned-in address. Round 56: when a CDC-ECM
// device was enumerated AND its MAC string fetch succeeded (usb_net_
// mac_scratch_ptr genuinely set, not just usb_net_kind==1 -- the fetch
// can fail independently of detection itself succeeding), return the
// device's OWN real MAC instead. LAN9512 falls through to this same
// placeholder: this driver doesn't read the chip's EEPROM-programmed
// MAC (no EEPROM read implemented), so it assigns this address to the
// hardware via ADDRL/ADDRH instead (see the LAN9512 backend's own
// comment) -- one consistent address either way, not a real vs. fake
// mismatch.
fn netif_get_mac(out_buf: mut ref i64) -> i64 {
  if usb_net_get_kind() == (1 as u32) {
    let mac_ptr: mut ref i64 = usb_net_get_mac_scratch_ptr();
    if ptr_to_u32(mac_ptr) != (0 as u32) {
      let mi: i64 = 0;
      while mi < 6 {
        let mb: u32 = buf_read_byte(mac_ptr, mi as u32);
        let _ = buf_write_byte(out_buf, mi as u32, mb);
        mi = mi + 1;
      }
      return 0;
    }
  }
  let _ = buf_write_byte(out_buf, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(out_buf, 1 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 2 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 3 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 4 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 5 as u32, 0x01 as u32);
  return 0;
}

// Sends a raw frame (buf[0..len)) by copying it into the next free
// queue slot. Returns 0 on success, -1 if the queue is already full
// (dropped, matching real best-effort networking behavior under
// congestion -- nothing here can afford to block) or the frame is too
// big for a slot.
//
// Round 56: dispatches to the real CDC-ECM bulk path when one was
// enumerated (usb_net_get_kind()==1), falling through to the original
// loopback queue otherwise (kind==0, or a real LAN9512 -- see its own
// backend below for why it has a separate send path, not this one).
// CDC-ECM's own TX framing (confirmed against QEMU's hw/usb/dev-
// network.c usb_net_handle_dataout, the non-RNDIS branch): the raw
// frame bytes, chunked into bulk_out_mps-sized OUT packets, with NO
// vendor header of any kind (unlike the real LAN9512's own TX_CMD_A/B
// wrapper) -- CDC-ECM is a standard class specifically because the
// framing is just "the frame, on the wire." A frame whose total length
// is an exact multiple of bulk_out_mps needs an explicit zero-length
// packet afterward so the device knows the frame is complete instead
// of waiting for more data that never comes (dwc2_net_bulk_out(...,
// out_len=0) is exactly that ZLP, per its own comment).
fn netif_send_frame(buf: mut ref i64, frame_len: i64) -> i64 {
  if frame_len > netif_frame_slot_size() {
    return 0 - 1;
  }
  // Round 72: packet filtering's egress half -- the SAME single choke
  // point every outgoing frame (ARP/IPv4/ICMP/UDP/TCP) already passes
  // through, mirroring netif_recv_frame's own three ingress hook
  // points. A denied frame is silently dropped and reported as success
  // -- deliberately the SAME "the sender never learns" shape
  // fault_netdrop_maybe_inject immediately below already established
  // for this exact function, not a new convention.
  if filter_check_frame(buf, frame_len, 1 as u32) == (0 as u32) {
    return 0;
  }
  // Round 62 (fault injection): `fault netdrop <n>` -- see
  // fault_netdrop_maybe_inject's own comment. Every outgoing frame
  // (ARP/IPv4/ICMP/UDP/TCP) passes through this single choke point,
  // so this one check covers all of them. Reports success (matching
  // what a real dropped packet looks like to the sender, which never
  // learns the frame didn't actually go out) while silently
  // discarding it -- letting existing timeout/retransmission logic
  // (round 37) be exercised on demand in a live session.
  if fault_netdrop_maybe_inject() == (1 as u32) {
    return 0;
  }
  if usb_net_get_kind() == (1 as u32) {
    let mps: u32 = usb_net_get_bulk_out_mps();
    let devaddr: u32 = dwc2_downstream_addr();
    let chunk_buf: mut ref i64 = dhruva_alloc_bytes(64);
    let sent: i64 = 0;
    let frame_len_u: u32 = frame_len as u32;
    while sent < frame_len {
      let remaining: i64 = frame_len - sent;
      let chunk_len: i64 = if (remaining as u32) > mps { mps as i64 } else { remaining };
      let ci: i64 = 0;
      while ci < chunk_len {
        let b: u32 = buf_read_byte(buf, (sent + ci) as u32);
        let _ = buf_write_byte(chunk_buf, ci as u32, b);
        ci = ci + 1;
      }
      let out_status: i64 = dwc2_net_bulk_out(devaddr, mps, chunk_buf, chunk_len);
      if out_status != 0 {
        return 0 - 1;
      }
      sent = sent + chunk_len;
    }
    if (frame_len_u % mps) == (0 as u32) {
      let _ = dwc2_net_bulk_out(devaddr, mps, chunk_buf, 0);
    }
    return 0;
  }
  // Round 56: real LAN9512 TX framing -- an 8-byte vendor header
  // (TX_CMD_A/TX_CMD_B, little-endian, per smsc95xx.h) prepended before
  // the raw frame bytes. TX_CMD_A: frame length | FIRST_SEG_ (0x2000)
  // | LAST_SEG_ (0x1000) -- this driver never splits a frame across
  // multiple TX_CMD_A segments, so both bits are always set together.
  // TX_CMD_B: frame length again, no ADD_CRC_DIS_/DIS_PADDING_/
  // CSUM_ENABLE bits set -- the chip computes its own CRC, auto-pads
  // short frames, and this driver doesn't use TX checksum offload,
  // matching Linux's own smsc95xx_tx_fixup non-checksum path. Unlike
  // CDC-ECM, no ZLP terminator is needed: TX_CMD_B's own length field
  // tells the chip exactly how many bytes to expect, so an exact-
  // multiple-of-mps frame doesn't need a "frame is really done" signal
  // the way CDC-ECM's short-packet convention does.
  if usb_net_get_kind() == (2 as u32) {
    let mps2: u32 = usb_net_get_bulk_out_mps();
    let devaddr2: u32 = dwc2_downstream_addr();
    let frame_len_u2: u32 = frame_len as u32;
    let total_len: i64 = frame_len + 8;
    let wrapped_buf: mut ref i64 = dhruva_alloc_bytes(520);
    let _ = lan9512_build_tx_header(wrapped_buf, frame_len_u2);
    let wi: i64 = 0;
    while wi < frame_len {
      let wb: u32 = buf_read_byte(buf, wi as u32);
      let _ = buf_write_byte(wrapped_buf, (8 + wi) as u32, wb);
      wi = wi + 1;
    }
    let chunk_buf2: mut ref i64 = dhruva_alloc_bytes(64);
    let sent2: i64 = 0;
    while sent2 < total_len {
      let remaining2: i64 = total_len - sent2;
      let chunk_len2: i64 = if (remaining2 as u32) > mps2 { mps2 as i64 } else { remaining2 };
      let ci2: i64 = 0;
      while ci2 < chunk_len2 {
        let b2: u32 = buf_read_byte(wrapped_buf, (sent2 + ci2) as u32);
        let _ = buf_write_byte(chunk_buf2, ci2 as u32, b2);
        ci2 = ci2 + 1;
      }
      let out_status2: i64 = dwc2_net_bulk_out(devaddr2, mps2, chunk_buf2, chunk_len2);
      if out_status2 != 0 {
        return 0 - 1;
      }
      sent2 = sent2 + chunk_len2;
    }
    return 0;
  }
  if netif_get_count() >= 4 {
    return 0 - 1;
  }
  let qbuf: mut ref i64 = netif_get_queue_buf();
  let head: i64 = netif_get_head();
  let base: i64 = head * netif_frame_slot_size();
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(qbuf, (base + i) as u32, b);
    i = i + 1;
  }
  let _ = netif_set_slot_len(head, frame_len);
  let _ = netif_advance_head();
  return 0;
}

// Round 60: packet filtering's own single hook point. Parses just
// enough of a frame to match against the rule table -- EtherType
// (bytes 12-13) to confirm this is even IPv4 (ARP and anything else
// passes through untouched, nothing to filter on IP/port for it),
// then reuses this project's own EXISTING accessors
// (ipv4_get_protocol/_src_ip, tcp_get_dst_port/udp_get_dst_port,
// already used identically by dhcp_client_poll and every TCP/UDP
// receive path) rather than re-deriving byte offsets by hand. Called
// from netif_recv_frame directly -- ONE hook point covers ICMP/TCP/UDP
// uniformly instead of three separate hooks at each protocol's own
// `*_poll` entry point (the originally-sketched design in docs/
// TODO.md), since the IP header is identical across all three by the
// time it's parseable at all.
//
// First-match-wins (real iptables semantics): the first rule whose
// proto/src_ip/dst_port all match (a field's own "valid" bit 0 means
// wildcard) decides the frame's fate; nothing matching falls through
// to fw_get_default_policy(). A rule naming a specific dst_port can
// never match a portless protocol (ICMP) -- has_port stays 0 for
// anything that isn't TCP/UDP, and port_matches requires either a
// wildcard rule or a genuine port to compare against.
//
// Round 72: `is_outgoing` lets the SAME rule table filter both
// directions, called from netif_send_frame as well as
// netif_recv_frame's own three call sites below -- this project has
// one rule table, not separate INPUT/OUTPUT chains, so a rule's own
// `src_ip` field is really "the OTHER party's IP" regardless of which
// direction the frame is travelling: for an inbound frame that's
// genuinely the IP header's source field, but for an OUTBOUND frame
// (where the header's own source field is always OUR OWN address)
// it's the destination field instead. Matches the intuitive meaning
// a `fw add ... <ip>` rule actually has to whoever configures it --
// "block traffic involving this address" -- not a strict src-only
// reading that would make outgoing filtering silently unable to ever
// match anything.
// is_outgoing is `u32`, matching this file's own established
// convention for flag/boolean parameters (a `u32` is always exactly
// one AAPCS register, nothing to miscount).
//
// CORRECTION (round 72, 2026-09-05): an earlier version of this
// comment blamed the parameter SHAPE here (mut ref i64 + i64 + i64)
// for an intermittent-garbage symptom seen while writing
// filter_outgoing_self_test, and initially "fixed" it by making this
// parameter u32 -- which didn't actually fix anything (confirmed:
// switching back to i64 reproduces identically). The real cause,
// found via LLVM IR + ARM disassembly comparison of a working vs.
// broken build, was `fw_add_rule` (boot/fw_state.S) clobbering
// r4/r5/r6 -- AAPCS callee-saved registers -- without saving them,
// silently corrupting a live value in the CALLER (this function's own
// caller, filter_outgoing_self_test) that happened to be allocated to
// one of those same registers. Fixed there (see that function's own
// updated header comment), not here -- this file's own logic was
// never wrong. Kept as u32 anyway since it's a real, if unrelated,
// improvement matching this codebase's own convention.
// Round 106a: the packet filter's own real rule-matching ALGORITHM
// now lives in the shared `netstack` kosh package (`netstack_filter_
// check_frame`), confirmed byte-for-byte identical to Pi 4/5's own
// `filter_check_frame_rpi4` before extraction. This file's own rule
// TABLE storage (`boot/fw_state.S`, the `fw_*` extern accessors
// above) is untouched. Unlike Pi 4/5's own adapter (which already
// used fixed `[u8;512]` arrays), this file's `frame` parameter is a
// heap `mut ref i64` pointer of unbounded length (real Ethernet
// frames up to 1514 bytes) -- but the filter itself only ever reads
// header fields within the first 38 bytes regardless of overall
// frame length, so copying up to 512 bytes (the package's own array
// cap, comfortable headroom over the 38 bytes actually read) into a
// local stack array before calling the package is exact, not a
// truncation risk.
use "../vendor/netstack/src/lib.vani";

fn filter_config_from_state() -> FilterConfig {
  let count: u32 = fw_get_rule_count();
  let proto: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let src_ip: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let src_ip_valid: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let dst_port: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let dst_port_valid: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let action: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let i: u32 = 0 as u32;
  while i < count {
    proto[i] = fw_get_rule_proto(i);
    src_ip[i] = fw_get_rule_src_ip(i);
    src_ip_valid[i] = fw_get_rule_src_ip_valid(i);
    dst_port[i] = fw_get_rule_dst_port(i);
    dst_port_valid[i] = fw_get_rule_dst_port_valid(i);
    action[i] = fw_get_rule_action(i);
    i = i + (1 as u32);
  }
  return FilterConfig {
    rule_count: count as i64,
    default_policy: fw_get_default_policy(),
    proto: proto,
    src_ip: src_ip,
    src_ip_valid: src_ip_valid,
    dst_port: dst_port,
    dst_port_valid: dst_port_valid,
    action: action
  };
}

fn filter_check_frame(frame: mut ref i64, frame_len: i64, is_outgoing: u32) -> u32 {
  let cfg: FilterConfig = filter_config_from_state();
  let copy_len: i64 = if frame_len < 512 { frame_len } else { 512 };
  let local_frame: [u8; 512] = netstack_zero_frame();
  let i: i64 = 0;
  while i < copy_len {
    local_frame[i] = buf_read_byte(frame, i as u32) as u8;
    i = i + 1;
  }
  return netstack_filter_check_frame(ref local_frame, frame_len, is_outgoing, ref cfg);
}

// Receives the oldest pending frame into out_buf, returning its
// length, or -1 if nothing is queued OR the queued frame is larger
// than max_len (see below).
//
// BUG (found via audit, 2026-08-27, same shape as round 1's socket_
// udp_recv/tcp_conn_handle_segment fixes, just one layer lower): this
// used to copy up to 512 bytes (a queued frame's real length, valid
// per netif_send_frame's own 512-byte-slot check) into out_buf with
// no idea how big out_buf actually is. Every current caller happens
// to either use a 512-byte buffer (matching the slot size exactly) or
// a smaller one paired with self-generated traffic that never
// actually exceeds it -- but that's a property of today's callers,
// not something this function itself ever enforced. Since all netif
// traffic shares ONE queue, nothing stops a future/different sender's
// larger frame from being the next one a smaller-buffered caller
// dequeues. max_len is now required (no way to ask a dhruva_alloc_
// bytes result its own size at runtime) and a too-large frame is
// dropped (dequeued, not left stuck blocking the queue forever) and
// reported as -1, same "reject, don't guess/truncate" posture as
// every other bounds check this project's networking layer uses.
// Round 56: CDC-ECM RX dispatch. Reads bulk_in_mps-sized chunks in a
// loop, accumulating into out_buf, until a SHORT packet (< mps) comes
// back -- CDC-ECM's own short-packet-terminates-the-frame convention
// (confirmed against QEMU's hw/usb/dev-network.c usb_net_handle_
// datain, the non-RNDIS branch), mirroring netif_send_frame's own TX
// side of the same convention. dwc2_net_bulk_in's own -1 return (NAK/
// timeout/error, all indistinguishable at this driver's level) means
// "nothing to receive right now" when it happens on the FIRST chunk of
// a poll (the overwhelmingly common case -- most polls find nothing
// waiting), which is the expected non-blocking "no frame ready" signal
// every caller of netif_recv_frame already relies on for the loopback
// path too.
//
// Timing caveat, flagged rather than silently assumed: dwc2_wait_
// chan0_done's own 1,000,000-iteration poll bound means an empty RX
// endpoint is NOT an instant "-1", it's bounded-but-not-fast -- this
// project's other bulk/control transfers only ever poll while genuine
// data is expected imminently, never as a repeated "is anything
// there" check the way network RX polling fundamentally is. Whether
// this makes every idle netif_recv_frame poll unacceptably slow in
// practice (as opposed to merely non-infinite) is exactly what this
// round's live QEMU verification needs to confirm empirically, not
// guess.

fn netif_recv_frame(out_buf: mut ref i64, max_len: i64) -> i64 {
  if usb_net_get_kind() == (1 as u32) {
    let mps: u32 = usb_net_get_bulk_in_mps();
    let devaddr: u32 = dwc2_downstream_addr();
    let chunk_buf: mut ref i64 = dhruva_alloc_bytes(64);
    let total: i64 = 0;
    let done: i64 = 0;
    while done == 0 {
      let got: i64 = dwc2_net_bulk_in(devaddr, mps, chunk_buf, mps as i64);
      if got < 0 {
        if total == 0 {
          return 0 - 1;
        }
        done = 1;
      } else {
        if (total + got) > max_len {
          return 0 - 1;
        }
        let ci: i64 = 0;
        while ci < got {
          let b: u32 = buf_read_byte(chunk_buf, ci as u32);
          let _ = buf_write_byte(out_buf, (total + ci) as u32, b);
          ci = ci + 1;
        }
        total = total + got;
        if (got as u32) < mps {
          done = 1;
        }
      }
    }
    // Round 60: packet filtering's own hook. A denied frame is simply
    // dropped and reported as "nothing ready" this call -- no internal
    // retry loop for another frame, since a real NIC delivers one frame
    // at a time anyway (unlike the loopback queue below, which CAN have
    // more queued, but returning -1 here just means the caller's own
    // next poll dequeues whatever's next, same as any other "nothing
    // ready" case already does).
    if filter_check_frame(out_buf, total, 0 as u32) == (0 as u32) {
      return 0 - 1;
    }
    return total;
  }
  // Round 56: real LAN9512 RX framing (per smsc95xx.h/smsc95xx.c's own
  // rx_fixup): a 4-byte RX status word, then NET_IP_ALIGN (2) padding
  // bytes (matching lan9512_reset_and_init's own HW_CFG.RXDOFF=2
  // setup), then the frame data itself, which includes a 4-byte FCS
  // this driver trims off the end -- RX_STS_FL_ (bits 29:16) is the
  // reported length INCLUDING that FCS. RX_STS_ES_ (bit 15, error
  // summary) sets the frame is dropped outright. Deliberately assumes
  // exactly one frame per USB transfer (this driver never enables
  // HW_CFG_MEF_/turbo mode, matching lan9512_reset_and_init's own
  // simplification) -- a real multi-frame-per-transfer response would
  // need the same loop rx_fixup itself uses, not implemented here.
  if usb_net_get_kind() == (2 as u32) {
    let mps3: u32 = usb_net_get_bulk_in_mps();
    let devaddr3: u32 = dwc2_downstream_addr();
    let chunk_buf3: mut ref i64 = dhruva_alloc_bytes(64);
    let raw_buf: mut ref i64 = dhruva_alloc_bytes(520);
    let raw_total: i64 = 0;
    let done3: i64 = 0;
    while done3 == 0 {
      let got3: i64 = dwc2_net_bulk_in(devaddr3, mps3, chunk_buf3, mps3 as i64);
      if got3 < 0 {
        if raw_total == 0 {
          return 0 - 1;
        }
        done3 = 1;
      } else {
        if (raw_total + got3) > (520 as i64) {
          return 0 - 1;
        }
        let ci3: i64 = 0;
        while ci3 < got3 {
          let b3: u32 = buf_read_byte(chunk_buf3, ci3 as u32);
          let _ = buf_write_byte(raw_buf, (raw_total + ci3) as u32, b3);
          ci3 = ci3 + 1;
        }
        raw_total = raw_total + got3;
        if (got3 as u32) < mps3 {
          done3 = 1;
        }
      }
    }
    if raw_total < 6 {
      return 0 - 1;
    }
    let rx_status: u32 = buf_read_u32_le(raw_buf, 0);
    if lan9512_rx_status_has_error(rx_status) == (1 as u32) {
      return 0 - 1; // RX_STS_ES_ (error summary) -- drop
    }
    let reported_len: u32 = lan9512_rx_status_frame_len(rx_status);
    if (6 + (reported_len as i64)) > raw_total {
      return 0 - 1;
    }
    let usable_len: i64 = (reported_len as i64) - 4; // drop trailing FCS
    if (usable_len < 0) || (usable_len > max_len) {
      return 0 - 1;
    }
    let ri: i64 = 0;
    while ri < usable_len {
      let rb: u32 = buf_read_byte(raw_buf, (6 + ri) as u32);
      let _ = buf_write_byte(out_buf, ri as u32, rb);
      ri = ri + 1;
    }
    // Round 60: packet filtering's own hook -- see the CDC-ECM branch
    // above for why a denied frame is just dropped/reported "nothing
    // ready" rather than internally retrying for another one.
    if filter_check_frame(out_buf, usable_len, 0 as u32) == (0 as u32) {
      return 0 - 1;
    }
    return usable_len;
  }
  if netif_get_count() <= 0 {
    return 0 - 1;
  }
  let qbuf: mut ref i64 = netif_get_queue_buf();
  let tail: i64 = netif_get_tail();
  let base: i64 = tail * netif_frame_slot_size();
  let frame_len: i64 = netif_get_slot_len(tail);
  if frame_len > max_len {
    let _ = netif_advance_tail();
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = buf_read_byte(qbuf, (base + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let _ = netif_advance_tail();
  // Round 60: packet filtering applies here too, for consistency --
  // the tail already advanced above regardless of the verdict (this
  // queued slot is consumed either way, matching how a real NIC would
  // also have already delivered the frame off the wire by the time
  // filtering happens).
  if filter_check_frame(out_buf, frame_len, 0 as u32) == (0 as u32) {
    return 0 - 1;
  }
  return frame_len;
}

// Boot-time self-test: builds a tiny synthetic Ethernet frame
// (broadcast destination, our own loopback MAC as source, ethertype
// 0x0800 = IPv4, payload "hi"), sends it, receives it back, and checks
// every field round-tripped correctly -- plus the empty-queue and
// full-queue edge cases, both real conditions netif_send_frame/
// netif_recv_frame handle explicitly above.
fn netif_self_test() -> i64 {
  let ok: i64 = 1;

  let empty_len: i64 = netif_recv_frame(dhruva_alloc_bytes(64), 64);
  if empty_len != (0 - 1) {
    ok = 0;
  }

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(mac);
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(frame, i as u32, 0xFF as u32); // dst: broadcast
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let mb: u32 = buf_read_byte(mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, mb); // src: our own MAC
    j = j + 1;
  }
  let _ = buf_write_byte(frame, 12 as u32, 0x08 as u32); // ethertype hi (IPv4)
  let _ = buf_write_byte(frame, 13 as u32, 0x00 as u32); // ethertype lo
  let _ = buf_write_byte(frame, 14 as u32, 104 as u32);  // 'h'
  let _ = buf_write_byte(frame, 15 as u32, 105 as u32);  // 'i'

  let send_status: i64 = netif_send_frame(frame, 16);
  if send_status != 0 {
    ok = 0;
  }

  let recv_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_buf, 64);
  if recv_len != 16 {
    ok = 0;
  }
  let et_hi: u32 = buf_read_byte(recv_buf, 12 as u32);
  let et_lo: u32 = buf_read_byte(recv_buf, 13 as u32);
  if (et_hi != (0x08 as u32)) || (et_lo != (0x00 as u32)) {
    ok = 0;
  }
  let c0: u32 = buf_read_byte(recv_buf, 14 as u32);
  let c1: u32 = buf_read_byte(recv_buf, 15 as u32);
  if (c0 != (104 as u32)) || (c1 != (105 as u32)) {
    ok = 0;
  }

  // Queue-full: 4 slots total: send 4 more (filling the queue from
  // empty, since the one above was already drained) then a 5th, which
  // must be dropped.
  let k: i64 = 0;
  while k < 4 {
    let _ = netif_send_frame(frame, 16);
    k = k + 1;
  }
  let overflow_status: i64 = netif_send_frame(frame, 16);
  if overflow_status != (0 - 1) {
    ok = 0;
  }
  // Drain the 4 real frames back out before anything else uses the
  // queue, so this self-test doesn't leave stale frames behind for
  // the ARP/IPv4/UDP self-tests that follow it at boot.
  let m: i64 = 0;
  while m < 4 {
    let _ = netif_recv_frame(recv_buf, 64);
    m = m + 1;
  }

  // Regression test for the missing-destination-capacity fix found by
  // audit (2026-08-27, see netif_recv_frame's own comment): a queued
  // frame larger than the caller's own buffer must be dropped, not
  // used as a copy-loop bound that overflows that buffer. Queues a
  // real 16-byte frame (the same one used above) and asks for it with
  // a deliberately too-small max_len -- it must be rejected AND
  // actually dequeued (so a caller with a too-small buffer can't
  // permanently wedge the queue on a frame it will never fit).
  let small_send_status: i64 = netif_send_frame(frame, 16);
  if small_send_status != 0 {
    ok = 0;
  }
  let too_small_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let too_small_status: i64 = netif_recv_frame(too_small_buf, 4);
  if too_small_status != (0 - 1) {
    ok = 0;
  }
  if netif_get_count() != 0 {
    ok = 0; // must have been dequeued despite being rejected
  }

  let _ = uart_puts("NETIF: loopback send/recv + empty/full edge cases");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 60: builds a minimal synthetic IPv4 frame for filter_self_test
// below -- just enough of the header for filter_check_frame's own
// parsing (EtherType, protocol byte, src IP, dst port), matching the
// same byte offsets ipv4_get_protocol/_src_ip and tcp_get_dst_port/
// udp_get_dst_port already use (ip_offset=14, tcp/udp_offset=34).
// Always returns 38 (>= the >=38 threshold filter_check_frame itself
// requires before it will even look at a port), so this helper works
// for TCP/UDP test frames uniformly; ICMP tests just ignore dst_port.
fn filter_build_test_frame(frame: mut ref i64, proto: u32, src_ip: u32, dst_port: u32) -> i64 {
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let _ = buf_write_byte(frame, 23 as u32, proto);    // ip_offset(14)+9
  let _ = buf_write_u32_be(frame, 26, src_ip);        // ip_offset(14)+12
  let _ = buf_write_u16_be(frame, 36, dst_port);      // tcp/udp_offset(34)+2
  return 38;
}

// Round 60: self-test for filter_check_frame's rule-matching logic
// against synthetic frames (no live traffic needed -- this is pure
// logic over a fixed 8-rule table, exactly the kind of thing this
// project already covers with synthetic self-tests elsewhere, e.g.
// tcp_conn_recv_bounds_self_test). Saves/restores real global firewall
// state (default policy + rule table) around itself so it doesn't
// corrupt whatever runs after it in the boot sequence -- this is
// shared mutable state, not a fresh fixture per test.
fn filter_self_test() -> i64 {
  let ok: i64 = 1;
  let saved_policy: u32 = fw_get_default_policy();
  let _ = fw_flush();

  let ip_a: u32 = 0x0A000001 as u32; // 10.0.0.1
  let ip_b: u32 = 0x0A000002 as u32; // 10.0.0.2

  // 1. No rules at all: every frame falls through to the default
  // policy. Set default to deny and confirm a TCP frame is denied.
  let _ = fw_set_default_policy(0 as u32);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = filter_build_test_frame(f1, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame(f1, l1, 0 as u32) != (0 as u32) { ok = 0; }

  // 2. A specific deny rule overrides a permissive default, but only
  // for the src_ip it actually names -- a different src_ip must still
  // fall through to the (now allow) default.
  let _ = fw_set_default_policy(1 as u32);
  let _ = fw_add_rule(6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32);
  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = filter_build_test_frame(f2, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame(f2, l2, 0 as u32) != (0 as u32) { ok = 0; }
  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = filter_build_test_frame(f3, 6 as u32, ip_b, 80 as u32);
  if filter_check_frame(f3, l3, 0 as u32) != (1 as u32) { ok = 0; }

  // 3. Protocol specificity: the same rule (TCP, ip_a, port 80) must
  // not match UDP traffic on the identical src_ip/port.
  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = filter_build_test_frame(f4, 17 as u32, ip_a, 80 as u32);
  if filter_check_frame(f4, l4, 0 as u32) != (1 as u32) { ok = 0; }

  // 4. First-match-wins: an earlier wildcard deny must shadow a later,
  // more specific allow rule for traffic the wildcard also covers.
  let _ = fw_flush();
  let _ = fw_add_rule(0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32); // deny everything
  let _ = fw_add_rule(6 as u32, 0 as u32, 0 as u32, 443 as u32, 1 as u32, 1 as u32); // allow TCP/443 (shadowed)
  let f5: mut ref i64 = dhruva_alloc_bytes(64);
  let l5: i64 = filter_build_test_frame(f5, 6 as u32, ip_a, 443 as u32);
  if filter_check_frame(f5, l5, 0 as u32) != (0 as u32) { ok = 0; }

  // 5. A rule naming a specific dst_port must never match a portless
  // protocol (ICMP) -- has_port stays 0 for it regardless of the
  // rule's own port field, so it must fall through to the default.
  let _ = fw_flush();
  let _ = fw_add_rule(0 as u32, 0 as u32, 0 as u32, 80 as u32, 1 as u32, 0 as u32); // deny port 80
  let _ = fw_set_default_policy(1 as u32);
  let f6: mut ref i64 = dhruva_alloc_bytes(64);
  let l6: i64 = filter_build_test_frame(f6, 1 as u32, ip_a, 80 as u32); // ICMP
  if filter_check_frame(f6, l6, 0 as u32) != (1 as u32) { ok = 0; }

  // 6. Non-IPv4 traffic (e.g. ARP) passes through untouched regardless
  // of policy or rules -- deny-everything default/rule still must not
  // block it, since there's no IP/port to filter on in the first place.
  let _ = fw_set_default_policy(0 as u32);
  let f7: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = buf_write_u16_be(f7, 12, 0x0806 as u32); // ethertype: ARP
  if filter_check_frame(f7, 38, 0 as u32) != (1 as u32) { ok = 0; }

  let _ = fw_flush();
  let _ = fw_set_default_policy(saved_policy);

  let _ = uart_puts("FW: packet filter rule matching (default/specific/proto/order/port/non-ip)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 72: same shape as filter_build_test_frame, but writes the
// given IP into the DESTINATION field (ip_offset+16) instead of the
// source field -- for building synthetic OUTGOING test frames, where
// the "other party" a rule should match is the destination, not the
// (for an outgoing frame, always-our-own) source.
fn filter_build_test_frame_dst(frame: mut ref i64, proto: u32, dst_ip: u32, dst_port: u32) -> i64 {
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let _ = buf_write_byte(frame, 23 as u32, proto);    // ip_offset(14)+9
  let _ = buf_write_u32_be(frame, 30, dst_ip);        // ip_offset(14)+16
  let _ = buf_write_u16_be(frame, 36, dst_port);      // tcp/udp_offset(34)+2
  return 38;
}

// Round 72: outgoing packet filtering -- both filter_check_frame's own
// directional logic (a rule's src_ip field means "the other party,"
// so it must match an outgoing frame's DESTINATION, not its own
// always-self source field) and the real netif_send_frame integration
// (a denied frame must never reach the loopback queue at all, while
// reporting success -- the sender never learns, same convention
// fault_netdrop_maybe_inject already established for this exact
// function).
fn filter_outgoing_self_test() -> i64 {
  let ok: i64 = 1;
  let saved_policy: u32 = fw_get_default_policy();
  let _ = fw_flush();

  let ip_a: u32 = 0x0A000003 as u32; // 10.0.0.3
  let ip_b: u32 = 0x0A000004 as u32; // 10.0.0.4

  // 1. A rule naming ip_a must match an OUTGOING frame whose
  // DESTINATION is ip_a, even though that same frame's own literal
  // source-IP field (never written here, reads as 0) would never
  // match it.
  let _ = fw_set_default_policy(1 as u32);
  let _ = fw_add_rule(6 as u32, ip_a, 1 as u32, 80 as u32, 1 as u32, 0 as u32); // deny TCP/80 to ip_a
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = filter_build_test_frame_dst(f1, 6 as u32, ip_a, 80 as u32);
  if filter_check_frame(f1, l1, 1 as u32) != (0 as u32) { ok = 0; }
  // The SAME frame checked as INCOMING must NOT match -- confirms
  // is_outgoing genuinely switches which field is consulted, not a
  // no-op flag.
  if filter_check_frame(f1, l1, 0 as u32) != (1 as u32) { ok = 0; }
  // A different destination still falls through to the (allow) default.
  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = filter_build_test_frame_dst(f2, 6 as u32, ip_b, 80 as u32);
  if filter_check_frame(f2, l2, 1 as u32) != (1 as u32) { ok = 0; }

  // 2. Real integration: netif_send_frame must actually drop a
  // filtered outgoing frame (never queued) while still queuing a
  // non-denied one normally.
  let before_count: i64 = netif_get_count();
  let send_denied: i64 = netif_send_frame(f1, l1);
  if send_denied != 0 { ok = 0; }
  if netif_get_count() != before_count { ok = 0; } // never queued

  let send_allowed: i64 = netif_send_frame(f2, l2);
  if send_allowed != 0 { ok = 0; }
  if netif_get_count() != (before_count + 1) { ok = 0; } // queued normally
  let drain: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = netif_recv_frame(drain, 64); // don't leave it queued for a later test

  let _ = fw_flush();
  let _ = fw_set_default_policy(saved_policy);

  let _ = uart_puts("FW: outgoing packet filtering (netif_send_frame egress hook, directional src/dst semantics)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: ARP (RFC 826), built directly on netif's own Ethernet
// framing. Field layout (offsets within the full 42-byte frame,
// after netif's own 14-byte dst/src/ethertype header):
//   14-15 hwtype(1=Ethernet)  16-17 ptype(0x0800=IPv4)
//   18 hwlen(6)  19 plen(4)  20-21 op(1=request,2=reply)
//   22-27 sender_mac  28-31 sender_ip
//   32-37 target_mac  38-41 target_ip
// A loopback link doesn't actually need address resolution (there's
// no separate "other host" on the wire to resolve), but the packet
// format and cache logic below are real and directly testable without
// one -- exactly like eval_expr_raw or the governor were verified via
// self-test rather than live input earlier in this project.

// Round 106b: ARP's own build/parse/cache ALGORITHM now lives in the
// shared `netstack` package (`netstack_arp_*`/`ArpCache`), confirmed
// a direct port of this file's own former body (and of Pi 4/5's own
// `arp_*_rpi4`, already a direct port of THIS file per that side's
// own header comment) before extraction. This file's own heap
// buffers (`out_frame`/`my_mac`/etc, `mut ref i64`) get copied into
// fixed `[u8;N]` arrays before calling the package and copied back
// after -- same `_heap`-adapter shape every other migration in this
// project uses. `arp_cache_get_macs_buf`/`set_macs_buf` (this file's
// own heap-pointer MAC storage, `boot/arp_state.S`) is untouched;
// only `arp_cache_lookup`/`insert`'s own algorithm moved.
fn arp_copy_frame_to_local(frame: mut ref i64) -> [u8; 512] {
  let local: [u8; 512] = netstack_zero_frame();
  let i: i64 = 0;
  while i < 42 {
    local[i] = buf_read_byte(frame, i as u32) as u8;
    i = i + 1;
  }
  return local;
}

fn arp_build_request(out_frame: mut ref i64, my_mac: mut ref i64, my_ip: u32, target_ip: u32) -> i64 {
  let my_mac_arr: [u8; 6] = [
    buf_read_byte(my_mac, 0 as u32) as u8, buf_read_byte(my_mac, 1 as u32) as u8, buf_read_byte(my_mac, 2 as u32) as u8,
    buf_read_byte(my_mac, 3 as u32) as u8, buf_read_byte(my_mac, 4 as u32) as u8, buf_read_byte(my_mac, 5 as u32) as u8
  ];
  let frame: [u8; 512] = netstack_zero_frame();
  let built_len: i64 = netstack_arp_build_request(mut ref frame, ref my_mac_arr, my_ip, target_ip);
  let i: i64 = 0;
  while i < built_len {
    let _ = buf_write_byte(out_frame, i as u32, frame[i] as u32);
    i = i + 1;
  }
  return built_len;
}

fn arp_build_reply(out_frame: mut ref i64, my_mac: mut ref i64, my_ip: u32, requester_mac: mut ref i64, requester_ip: u32) -> i64 {
  let my_mac_arr: [u8; 6] = [
    buf_read_byte(my_mac, 0 as u32) as u8, buf_read_byte(my_mac, 1 as u32) as u8, buf_read_byte(my_mac, 2 as u32) as u8,
    buf_read_byte(my_mac, 3 as u32) as u8, buf_read_byte(my_mac, 4 as u32) as u8, buf_read_byte(my_mac, 5 as u32) as u8
  ];
  let requester_mac_arr: [u8; 6] = [
    buf_read_byte(requester_mac, 0 as u32) as u8, buf_read_byte(requester_mac, 1 as u32) as u8, buf_read_byte(requester_mac, 2 as u32) as u8,
    buf_read_byte(requester_mac, 3 as u32) as u8, buf_read_byte(requester_mac, 4 as u32) as u8, buf_read_byte(requester_mac, 5 as u32) as u8
  ];
  let frame: [u8; 512] = netstack_zero_frame();
  let built_len: i64 = netstack_arp_build_reply(mut ref frame, ref my_mac_arr, my_ip, ref requester_mac_arr, requester_ip);
  let i: i64 = 0;
  while i < built_len {
    let _ = buf_write_byte(out_frame, i as u32, frame[i] as u32);
    i = i + 1;
  }
  return built_len;
}

fn arp_get_ethertype(frame: mut ref i64) -> u32 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  return netstack_arp_get_ethertype(ref local);
}

fn arp_is_arp_frame(frame: mut ref i64) -> i64 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  return netstack_arp_is_arp_frame(ref local);
}

fn arp_get_operation(frame: mut ref i64) -> u32 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  return netstack_arp_get_operation(ref local);
}

fn arp_get_sender_ip(frame: mut ref i64) -> u32 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  return netstack_arp_get_sender_ip(ref local);
}

fn arp_get_target_ip(frame: mut ref i64) -> u32 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  return netstack_arp_get_target_ip(ref local);
}

fn arp_get_sender_mac(frame: mut ref i64, out_mac: mut ref i64) -> i64 {
  let local: [u8; 512] = arp_copy_frame_to_local(frame);
  let mac: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
  let _ = netstack_arp_get_sender_mac(ref local, mut ref mac);
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(out_mac, i as u32, mac[i] as u32);
    i = i + 1;
  }
  return 0;
}

fn arp_cache_init() -> i64 {
  let buf: mut ref i64 = dhruva_alloc_bytes(48);
  let _ = arp_cache_set_macs_buf(buf);
  return 0;
}

fn arp_cache_from_state() -> ArpCache {
  let count: u32 = arp_cache_get_count();
  let ip: [u32; 8] = [0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32];
  let mac_bytes: [u8; 48] = [
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8
  ];
  let macs: mut ref i64 = arp_cache_get_macs_buf();
  let i: u32 = 0 as u32;
  while i < count {
    ip[i as i64] = arp_cache_get_ip(i);
    let j: u32 = 0 as u32;
    while j < (6 as u32) {
      mac_bytes[(i * (6 as u32) + j) as i64] = buf_read_byte(macs, i * (6 as u32) + j) as u8;
      j = j + (1 as u32);
    }
    i = i + (1 as u32);
  }
  return ArpCache { count: count as i64, next_slot: arp_cache_get_next_slot() as i64, ip: ip, mac_bytes: mac_bytes };
}

// Looks up ip in the cache; if found, copies its MAC into out_mac and
// returns 1; if not found, returns 0 (out_mac left untouched).
fn arp_cache_lookup(ip: u32, out_mac: mut ref i64) -> i64 {
  let cache: ArpCache = arp_cache_from_state();
  let result: ArpLookupResult = netstack_arp_cache_lookup(ref cache, ip);
  if result.found == 1 {
    let i: i64 = 0;
    while i < 6 {
      let _ = buf_write_byte(out_mac, i as u32, result.mac[i] as u32);
      i = i + 1;
    }
  }
  return result.found;
}

// Inserts/updates an IP -> MAC mapping. Updates in place if the IP is
// already cached; otherwise appends while there's room, or overwrites
// the oldest entry round-robin once full -- a demo-scoped cache, not
// a production one with real aging/timeouts.
fn arp_cache_insert(ip: u32, mac: mut ref i64) -> i64 {
  let mac_arr: [u8; 6] = [
    buf_read_byte(mac, 0 as u32) as u8, buf_read_byte(mac, 1 as u32) as u8, buf_read_byte(mac, 2 as u32) as u8,
    buf_read_byte(mac, 3 as u32) as u8, buf_read_byte(mac, 4 as u32) as u8, buf_read_byte(mac, 5 as u32) as u8
  ];
  let cache: ArpCache = arp_cache_from_state();
  let new_cache: ArpCache = netstack_arp_cache_insert(cache, ip, ref mac_arr);
  let _ = arp_cache_set_count(new_cache.count as u32);
  let _ = arp_cache_set_next_slot(new_cache.next_slot as u32);
  let macs: mut ref i64 = arp_cache_get_macs_buf();
  let i: i64 = 0;
  while i < new_cache.count {
    let _ = arp_cache_set_ip(i as u32, new_cache.ip[i]);
    let j: i64 = 0;
    while j < 6 {
      let _ = buf_write_byte(macs, (i * 6 + j) as u32, new_cache.mac_bytes[i * 6 + j] as u32);
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

// Boot-time self-test: build+parse a request and a reply (round-
// tripping every field), then exercise the cache (insert, lookup,
// lookup-miss, and update-in-place -- re-inserting the same IP with a
// different MAC must overwrite, not append a second entry).
fn arp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;     // 192.168.1.1
  let target_ip: u32 = 0xC0A80102 as u32; // 192.168.1.2

  let req_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let req_len: i64 = arp_build_request(req_frame, my_mac, my_ip, target_ip);
  if req_len != 42 {
    ok = 0;
  }
  if arp_is_arp_frame(req_frame) != 1 {
    ok = 0;
  }
  if arp_get_operation(req_frame) != (1 as u32) {
    ok = 0;
  }
  if arp_get_sender_ip(req_frame) != my_ip {
    ok = 0;
  }
  if arp_get_target_ip(req_frame) != target_ip {
    ok = 0;
  }
  let parsed_sender_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = arp_get_sender_mac(req_frame, parsed_sender_mac);
  let mi: i64 = 0;
  while mi < 6 {
    let a: u32 = buf_read_byte(my_mac, mi as u32);
    let b: u32 = buf_read_byte(parsed_sender_mac, mi as u32);
    if a != b {
      ok = 0;
    }
    mi = mi + 1;
  }

  // A peer (192.168.1.2) replying to our request.
  let peer_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 5 as u32, 0x02 as u32);
  let reply_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let reply_len: i64 = arp_build_reply(reply_frame, peer_mac, target_ip, my_mac, my_ip);
  if reply_len != 42 {
    ok = 0;
  }
  if arp_get_operation(reply_frame) != (2 as u32) {
    ok = 0;
  }
  if arp_get_sender_ip(reply_frame) != target_ip {
    ok = 0;
  }

  let _ = arp_cache_init();
  let _ = arp_cache_insert(target_ip, peer_mac);
  let looked_up: mut ref i64 = dhruva_alloc_bytes(8);
  let found: i64 = arp_cache_lookup(target_ip, looked_up);
  if found != 1 {
    ok = 0;
  }
  let ci: i64 = 0;
  while ci < 6 {
    let a2: u32 = buf_read_byte(peer_mac, ci as u32);
    let b2: u32 = buf_read_byte(looked_up, ci as u32);
    if a2 != b2 {
      ok = 0;
    }
    ci = ci + 1;
  }
  let not_found: i64 = arp_cache_lookup(0xDEADBEEF as u32, looked_up);
  if not_found != 0 {
    ok = 0;
  }

  // Re-insert the same IP with a different MAC: must overwrite the
  // existing entry, not grow the cache.
  let peer_mac2: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac2, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac2, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 5 as u32, 0x03 as u32);
  let _ = arp_cache_insert(target_ip, peer_mac2);
  let count_after: u32 = arp_cache_get_count();
  if count_after != (1 as u32) {
    ok = 0;
  }
  let looked_up2: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = arp_cache_lookup(target_ip, looked_up2);
  let last_byte: u32 = buf_read_byte(looked_up2, 5 as u32);
  if last_byte != (0x03 as u32) {
    ok = 0;
  }

  let _ = uart_puts("ARP: build/parse + cache insert/lookup/update");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 22 audit, 2026-08-28: the live ARP resolution round trip
// round 21 explicitly deferred rather than building unboundedly --
// see socket_udp_send's own comment for why a cache MISS there is
// reported as a real failure rather than triggering a live
// resolution attempt mid-call. Built here as its own small,
// poll-based capability instead, matching every other stateful
// protocol in this project's design (DHCP, TCP): a single synchronous
// call structurally cannot wait for a live reply, so resolution is
// split into "send the request" (arp_resolve_start) and a separate
// "check whether a reply has arrived yet" (arp_resolve_poll) the
// caller invokes on its own later poll(s) -- exactly dhcp_client_
// start/dhcp_client_poll's own shape. Not wired into any live caller
// this round; this is the general capability itself, proven on its
// own merits by arp_resolve_self_test below. DHCP's own new lease-
// renewal code (dhcp_client_check_lease) doesn't use this either --
// it learns the server's MAC for free from the ACK frame it already
// received, sidestepping the need for a live round trip for that
// specific, narrower case.
fn arp_resolve_start(my_mac: mut ref i64, my_ip: u32, target_ip: u32) -> i64 {
  let req_frame: mut ref i64 = arp_resolve_scratch_get();
  let req_len: i64 = arp_build_request(req_frame, my_mac, my_ip, target_ip);
  return netif_send_frame(req_frame, req_len);
}

// Dequeues the next queued frame and checks whether it's an ARP
// reply resolving target_ip -- if so, caches it (arp_cache_insert)
// and returns 1. Returns 0 otherwise, whether because nothing was
// queued, the frame wasn't ARP, wasn't a reply, or resolved a
// different address -- same "not every queued frame is mine, drop it
// and move on" tolerance dhcp_client_poll/socket_udp_recv already
// have. This project's netif has one shared FIFO queue with no
// selective peek, so any consumer that finds a frame isn't for it
// has already consumed it regardless of what this function decides
// -- an accepted, pre-existing tradeoff (see socket_udp_recv's own
// comment: "no per-port binding/filtering table exists yet"), not a
// new limitation introduced here.
fn arp_resolve_poll(target_ip: u32) -> i64 {
  let frame: mut ref i64 = arp_resolve_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 64);
  if frame_len < 0 {
    return 0;
  }
  if arp_is_arp_frame(frame) != 1 {
    return 0;
  }
  if arp_get_operation(frame) != (2 as u32) {
    return 0;
  }
  if arp_get_sender_ip(frame) != target_ip {
    return 0;
  }
  let sender_mac: mut ref i64 = arp_resolve_mac_scratch_get();
  let _ = arp_get_sender_mac(frame, sender_mac);
  let _ = arp_cache_insert(target_ip, sender_mac);
  return 1;
}

// Boot-time self-test: no real second host exists in this loopback-
// only environment (same reasoning DHCP's own self-test already
// establishes), so this drains the request arp_resolve_start queues
// on the real netif and sanity-checks it, then manually builds a
// synthetic reply exactly as a real peer would and queues it via the
// real netif, proving arp_resolve_poll picks it up and updates the
// cache correctly -- plus the "nothing arrived yet" and "queued
// frame doesn't match" cases, both real conditions a live caller
// would hit.
fn arp_resolve_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;
  let target_ip: u32 = 0xC0A80105 as u32; // .5, not touched by any earlier self-test

  // Nothing queued yet -- must report "not resolved," not a false
  // positive.
  let none_yet: i64 = arp_resolve_poll(target_ip);
  if none_yet != 0 {
    ok = 0;
  }

  let start_status: i64 = arp_resolve_start(my_mac, my_ip, target_ip);
  if start_status != 0 {
    ok = 0;
  }

  // Drain and sanity-check the request itself before injecting the
  // synthetic reply below, the same "verify what actually went out"
  // discipline dhcp_self_test already uses for its own DISCOVER.
  let req_check: mut ref i64 = dhruva_alloc_bytes(64);
  let req_check_len: i64 = netif_recv_frame(req_check, 64);
  if req_check_len < 0 { ok = 0; }
  if arp_is_arp_frame(req_check) != 1 { ok = 0; }
  if arp_get_operation(req_check) != (1 as u32) { ok = 0; }
  if arp_get_target_ip(req_check) != target_ip { ok = 0; }

  // A peer (192.168.1.5) replying to our request.
  let peer_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 5 as u32, 0x05 as u32);
  let reply_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let reply_len: i64 = arp_build_reply(reply_frame, peer_mac, target_ip, my_mac, my_ip);
  let send_status: i64 = netif_send_frame(reply_frame, reply_len);
  if send_status != 0 { ok = 0; }

  let resolved: i64 = arp_resolve_poll(target_ip);
  if resolved != 1 { ok = 0; }
  let looked_up: mut ref i64 = dhruva_alloc_bytes(8);
  let found: i64 = arp_cache_lookup(target_ip, looked_up);
  if found != 1 { ok = 0; }
  if buf_read_byte(looked_up, 5 as u32) != (0x05 as u32) { ok = 0; }

  let _ = uart_puts("ARP: arp_resolve_start/poll live round trip");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: IPv4 (RFC 791), no options (IHL always 5 -- a 20-byte
// header, deliberately not supporting IP options at all: nothing this
// project's own from-scratch stack sends or needs to receive requires
// them, matching the doc's own "scoped like uIP/picoTCP" framing for
// this whole phase). Sits directly on netif's Ethernet framing, no
// new persistent state needed -- unlike ARP's cache, there's nothing
// here that needs to survive across calls, so this stays pure vani
// logic over the existing buf_* helpers with no new assembly file.
//
// Header layout (offsets relative to ip_offset, i.e. 14 bytes into
// the full Ethernet frame for anything netif-backed):
//   0 version(4 bits)+IHL(4 bits)   1 DSCP+ECN (unused, 0)
//   2-3 total length (header+payload)   4-5 identification (unused, 0)
//   6-7 flags+fragment offset (unused, 0 -- no fragmentation support)
//   8 TTL   9 protocol (1=ICMP, 6=TCP, 17=UDP)
//   10-11 header checksum   12-15 source IP   16-19 destination IP

// Round 106c: the header codec's own real ALGORITHM now lives in the
// shared `netstack` package (`netstack_ipv4_*`), operating on a
// standalone `[u8;20]` header window rather than an offset within
// this file's own unbounded heap frame buffer (real frames up to
// 1514 bytes) -- see that package's own header comment for why. Each
// function here copies its own 20-byte slice out of `frame` (via
// `buf_read_byte`) and, for `build_header`, back in.
fn ipv4_header_extract(frame: mut ref i64, ip_offset: i64) -> [u8; 20] {
  let hdr: [u8; 20] = netstack_zero20_bytes();
  let i: i64 = 0;
  while i < 20 {
    hdr[i] = buf_read_byte(frame, (ip_offset + i) as u32) as u8;
    i = i + 1;
  }
  return hdr;
}

fn ipv4_checksum(frame: mut ref i64, ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_checksum(ref hdr);
}

fn ipv4_build_header(frame: mut ref i64, ip_offset: i64, total_len: i64, protocol: u32, src_ip: u32, dst_ip: u32) -> i64 {
  let hdr: [u8; 20] = netstack_ipv4_build_header(total_len, protocol, src_ip, dst_ip);
  let i: i64 = 0;
  while i < 20 {
    let _ = buf_write_byte(frame, (ip_offset + i) as u32, hdr[i] as u32);
    i = i + 1;
  }
  return 20;
}

fn ipv4_get_total_len(frame: mut ref i64, ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_get_total_len(ref hdr);
}
fn ipv4_get_protocol(frame: mut ref i64, ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_get_protocol(ref hdr);
}
fn ipv4_get_src_ip(frame: mut ref i64, ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_get_src_ip(ref hdr);
}
fn ipv4_get_dst_ip(frame: mut ref i64, ip_offset: i64) -> u32 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_get_dst_ip(ref hdr);
}

fn ipv4_verify_checksum(frame: mut ref i64, ip_offset: i64) -> i64 {
  let hdr: [u8; 20] = ipv4_header_extract(frame, ip_offset);
  return netstack_ipv4_verify_checksum(ref hdr);
}

// Builds a full Ethernet+IPv4 frame around payload[0..payload_len) and
// sends it via netif. Frame layout: [14-byte Ethernet header][20-byte
// IP header][payload].
//
// `frame` is net_send_scratch, not a fresh dhruva_alloc_bytes call --
// see scratch_state.S's own comment on that buffer for why: this
// function (and udp_send/tcp_send_segment right after it) is the
// actual network SEND path, callable many times over a real session,
// not just from a boot self-test.
// BUG (round 9 audit, 2026-08-27): payload_len used to feed straight
// into the copy loop below with no check against net_send_scratch's
// real capacity (netif_frame_slot_size() bytes, round 66; originally
// a hardcoded 512) -- netif_send_frame's own `frame_len > netif_
// frame_slot_size()` check runs AFTER this function has already built
// (and, for an oversized payload_len, already overrun) the frame in
// net_send_scratch, so it catches the problem one step too late to
// actually prevent it. Every caller today passes a small, trusted
// payload_len, so not live-hit, but this is the send-side twin of the exact bug
// round 1 already fixed on the receive side (socket_udp_recv/
// tcp_conn_handle_segment trusting a length without checking
// destination capacity) -- worth closing before any future socket-API
// consumer (an echo server turning a received payload_len around into
// a send call, a DHCP client, etc.) can trip it.
//
// BUG (round 11 audit, 2026-08-27): this check's own bound used to be
// a hardcoded literal (478) rather than derived from netif_get_mtu()
// -- netif's own declared, authoritative "how much payload fits above
// the Ethernet layer" answer (DHRUVA_ARCHITECTURE.md's own framing:
// netif is supposed to be "an interface" exactly so higher layers
// don't need to know its internals). A hardcoded number that merely
// happens to match today's netif_get_mtu()-20 arithmetic is a second,
// silently-divergeable source of truth: the moment a real hardware
// netif (LAN9512/WiFi, this project's own documented next step)
// reports a different MTU -- larger (a real 1500-byte Ethernet MTU)
// or, in principle, smaller -- this hardcoded check stops matching
// reality, either rejecting valid traffic or (worse) failing to catch
// an overflow netif_get_mtu() would have correctly flagged. Every
// send-path bound in this file now derives from netif_get_mtu() at
// call time instead.
fn ipv4_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, protocol: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let ipv4_max_payload: i64 = netif_get_mtu() - 20; // netif's own payload budget, minus the 20-byte IP header
  if (payload_len < 0) || (payload_len > ipv4_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let total_len: i64 = 20 + payload_len;
  let _ = ipv4_build_header(frame, 14, total_len, protocol, src_ip, dst_ip);
  let k: i64 = 0;
  while k < payload_len {
    let pb: u32 = buf_read_byte(payload, k as u32);
    let _ = buf_write_byte(frame, (34 + k) as u32, pb); // 14 + 20 = 34
    k = k + 1;
  }
  return netif_send_frame(frame, 34 + payload_len);
}

// Boot-time self-test: send an IPv4 packet over the loopback netif,
// receive it back, and verify every header field plus the checksum
// and payload round-tripped correctly.
fn ipv4_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let payload: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32); // 'i'

  let send_status: i64 = ipv4_send(my_mac, my_mac, src_ip, dst_ip, 17 as u32, payload, 2);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_frame, 64);
  if recv_len != 36 {
    ok = 0;
  }
  if ipv4_get_total_len(recv_frame, 14) != (22 as u32) {
    ok = 0;
  }
  if ipv4_get_protocol(recv_frame, 14) != (17 as u32) {
    ok = 0;
  }
  if ipv4_get_src_ip(recv_frame, 14) != src_ip {
    ok = 0;
  }
  if ipv4_get_dst_ip(recv_frame, 14) != dst_ip {
    ok = 0;
  }
  if ipv4_verify_checksum(recv_frame, 14) != 1 {
    ok = 0;
  }
  let p0: u32 = buf_read_byte(recv_frame, 34 as u32);
  let p1: u32 = buf_read_byte(recv_frame, 35 as u32);
  if (p0 != (104 as u32)) || (p1 != (105 as u32)) {
    ok = 0;
  }

  let _ = uart_puts("IPV4: build/send/recv + checksum verify");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 26 (2026-08-28): dotted-quad IP address string <-> u32
// conversion -- every self-test in this file so far has only ever
// used hex literals (0xC0A80101) for an IP, fine for code but useless
// for an interactive shell command a human actually types. Returns
// the parsed address as a non-negative i64 on success (safe to do,
// since `u32 as i64` zero-extends rather than sign-extends in vani --
// so a genuine 255.255.255.255 still comes back as a large POSITIVE
// i64, never colliding with the -1 error sentinel below) or -1 on any
// malformed input: not exactly
// four dot-separated segments, an empty segment (covers both "a..b.c"
// and a leading/trailing dot), a non-digit character, more than three
// digits in one segment, or any segment's own value exceeding 255.
// Rejecting rather than clamping or guessing matches this project's
// own "reject, don't guess" posture for every other untrusted-input
// parse (DHCP's TLV options, the UDP/TCP length-validation fixes).
fn ip_parse_dotted_quad(buf: mut ref i64, start: i64, end: i64) -> i64 {
  let result: u32 = 0 as u32;
  let octet_val: i64 = 0;
  let octet_digits: i64 = 0;
  let octet_count: i64 = 0;
  let pos: i64 = start;
  while pos < end {
    let c: u32 = buf_read_byte(buf, pos as u32);
    if c == (46 as u32) { // '.'
      if (octet_digits == 0) || (octet_val > (255 as i64)) || (octet_count >= (3 as i64)) {
        return 0 - 1;
      }
      result = (result << (8 as u32)) | (octet_val as u32);
      octet_val = 0;
      octet_digits = 0;
      octet_count = octet_count + 1;
    } else {
      if (c < (48 as u32)) || (c > (57 as u32)) {
        return 0 - 1; // not a digit
      }
      if octet_digits >= (3 as i64) {
        return 0 - 1; // more digits than "255" could ever need
      }
      octet_val = (octet_val * (10 as i64)) + ((c - (48 as u32)) as i64);
      octet_digits = octet_digits + 1;
    }
    pos = pos + 1;
  }
  // The fourth segment has no trailing dot to end it -- checked here,
  // after the loop, against the same rules every other segment above
  // already enforced.
  if (octet_digits == 0) || (octet_val > (255 as i64)) || (octet_count != (3 as i64)) {
    return 0 - 1;
  }
  result = (result << (8 as u32)) | (octet_val as u32);
  return result as i64;
}

// Prints ip in dotted-quad form directly to the UART (no intermediate
// string buffer -- matches this file's own established style of
// printing incrementally via uart_puts/uart_put_i64 rather than
// building a formatted string first).
fn uart_put_ip(ip: u32) -> i64 {
  let a: u32 = (ip >> (24 as u32)) & (0xFF as u32);
  let b: u32 = (ip >> (16 as u32)) & (0xFF as u32);
  let c: u32 = (ip >> (8 as u32)) & (0xFF as u32);
  let d: u32 = ip & (0xFF as u32);
  let _ = uart_put_i64(a as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(b as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(c as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(d as i64);
  return 0;
}

// TEST-ONLY: copies a vani string literal's bytes into buf, returning
// its length -- this project's own self-tests everywhere else build
// byte sequences by hand (one buf_write_byte call per byte, e.g.
// udp_self_test's own "hello" payload), which would make eight
// dotted-quad test strings unreadable; str_byte_at/str_len_bytes are
// generic vani builtins, not anything specific to this test.
fn ip_test_write_str(buf: mut ref i64, s: Str) -> i64 {
  let slen: i64 = str_len_bytes(s);
  let i: i64 = 0;
  while i < slen {
    let b: i64 = str_byte_at(s, i);
    let _ = buf_write_byte(buf, i as u32, b as u32);
    i = i + 1;
  }
  return slen;
}

// Boot-time self-test: round-trips several known addresses through
// the parser and confirms the exact reject cases named in
// ip_parse_dotted_quad's own comment are all actually rejected, not
// just the happy path.
fn ip_parse_self_test() -> i64 {
  let ok: i64 = 1;
  let buf: mut ref i64 = dhruva_alloc_bytes(24);

  let l1: i64 = ip_test_write_str(buf, "192.168.1.1");
  if ip_parse_dotted_quad(buf, 0, l1) != (0xC0A80101 as i64) { ok = 0; }

  let l2: i64 = ip_test_write_str(buf, "0.0.0.0");
  if ip_parse_dotted_quad(buf, 0, l2) != 0 { ok = 0; }

  let l3: i64 = ip_test_write_str(buf, "255.255.255.255");
  if ip_parse_dotted_quad(buf, 0, l3) != (0xFFFFFFFF as i64) { ok = 0; }

  let l4: i64 = ip_test_write_str(buf, "256.1.1.1"); // segment > 255
  if ip_parse_dotted_quad(buf, 0, l4) != (0 - 1) { ok = 0; }

  let l5: i64 = ip_test_write_str(buf, "1.2.3"); // too few segments
  if ip_parse_dotted_quad(buf, 0, l5) != (0 - 1) { ok = 0; }

  let l6: i64 = ip_test_write_str(buf, "1.2.3.4.5"); // too many segments
  if ip_parse_dotted_quad(buf, 0, l6) != (0 - 1) { ok = 0; }

  let l7: i64 = ip_test_write_str(buf, "1..3.4"); // empty segment
  if ip_parse_dotted_quad(buf, 0, l7) != (0 - 1) { ok = 0; }

  let l8: i64 = ip_test_write_str(buf, "1.2.3.a"); // non-digit
  if ip_parse_dotted_quad(buf, 0, l8) != (0 - 1) { ok = 0; }

  let _ = uart_puts("IP: dotted-quad parse round-trip + reject cases");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued, round 25 (2026-08-28): ICMP (RFC 792) echo
// request/reply -- "ping," the one basic network capability every
// real IP stack has that this project had never built (protocol
// number 1 was named in a comment on ipv4_get_protocol's own header
// years of rounds ago, but nothing ever implemented it). Sits
// directly on ipv4_build_header/netif exactly like UDP/TCP do, no new
// persistent state, pure vani logic.
//
// Echo message layout (RFC 792, both request type=8 and reply type=0
// share this same shape): type(1) code(1, always 0 for echo)
// checksum(2) identifier(2) sequence(2) [arbitrary data...].
//
// Unlike UDP/TCP's checksum, ICMP's covers no pseudo-header at all --
// just the ICMP message itself, computed and verified the exact same
// "sums to 0xFFFF as transmitted" way ipv4_checksum/ipv4_verify_
// checksum already do for the IP header, not UDP's own RFC-768-
// specific "never transmit a literal 0" special case (that rule is
// UDP's alone; RFC 792 has no equivalent for ICMP).
fn icmp_checksum(frame: mut ref i64, icmp_offset: i64, icmp_len: i64) -> u32 {
  let sum: u32 = 0 as u32;
  let i: i64 = 0;
  while (i + 1) < icmp_len {
    let word: u32 = buf_read_u16_be(frame, icmp_offset + i);
    sum = sum + word;
    i = i + 2;
  }
  if i < icmp_len {
    let b: u32 = buf_read_byte(frame, (icmp_offset + i) as u32);
    sum = sum + (b << (8 as u32)); // odd trailing byte, zero-padded low
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  return sum & (0xFFFF as u32);
}
fn icmp_verify_checksum(frame: mut ref i64, icmp_offset: i64, icmp_len: i64) -> i64 {
  if icmp_checksum(frame, icmp_offset, icmp_len) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

fn icmp_type_echo_reply() -> u32 { return 0 as u32; }
fn icmp_type_echo_request() -> u32 { return 8 as u32; }

// Builds an echo request or reply message (type_val picks which) at
// frame[icmp_offset..), returning its total length (8-byte header +
// payload_len). Shared by both directions -- the only difference
// between a request and its reply is the type byte and which side
// initiated it, everything else about the message shape is identical
// (RFC 792 requires a reply to echo the request's own identifier,
// sequence, and data back verbatim, which this being one shared
// builder makes automatic rather than something a caller could get
// wrong copying by hand).
fn icmp_build_echo(frame: mut ref i64, icmp_offset: i64, type_val: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let _ = buf_write_byte(frame, icmp_offset as u32, type_val);
  let _ = buf_write_byte(frame, (icmp_offset + 1) as u32, 0 as u32); // code
  let _ = buf_write_u16_be(frame, icmp_offset + 2, 0 as u32); // checksum placeholder
  let _ = buf_write_u16_be(frame, icmp_offset + 4, identifier);
  let _ = buf_write_u16_be(frame, icmp_offset + 6, seq);
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (icmp_offset + 8 + i) as u32, b);
    i = i + 1;
  }
  let icmp_len: i64 = 8 + payload_len;
  let checksum: u32 = (icmp_checksum(frame, icmp_offset, icmp_len) ^ (0xFFFF as u32)) & (0xFFFF as u32);
  let _ = buf_write_u16_be(frame, icmp_offset + 2, checksum);
  return icmp_len;
}

fn icmp_get_type(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_byte(frame, icmp_offset as u32);
}
fn icmp_get_identifier(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, icmp_offset + 4);
}
fn icmp_get_sequence(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, icmp_offset + 6);
}

// Builds a full Ethernet+IPv4+ICMP frame and sends it via netif --
// same shape as ipv4_send/udp_send/tcp_send_segment right around it,
// sharing net_send_scratch for the same reason round 11's own comment
// on that buffer already establishes safe: none of these send
// functions call each other, each independently builds one complete
// frame from scratch.
fn icmp_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, type_val: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let icmp_max_payload: i64 = netif_get_mtu() - 20 - 8; // minus IP header, minus the 8-byte echo header -- same netif_get_mtu()-derivation discipline round 11 established for every other send path
  if (payload_len < 0) || (payload_len > icmp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let icmp_len: i64 = icmp_build_echo(frame, 34, type_val, identifier, seq, payload, payload_len);
  let total_len: i64 = 20 + icmp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 1 as u32, src_ip, dst_ip); // protocol 1 = ICMP
  return netif_send_frame(frame, 14 + total_len);
}

// Sends an echo request -- the "ping" a caller actually issues.
// Doesn't wait for a reply itself (this project's own established
// poll-don't-block design, same reasoning DHCP/TCP/ARP resolution all
// already use): a caller polls icmp_poll separately, as many times as
// it's willing to, to find out whether one ever came back.
fn icmp_ping_start(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  return icmp_send(my_mac, dst_mac, src_ip, dst_ip, icmp_type_echo_request(), identifier, seq, payload, payload_len);
}

// Dequeues the next queued frame and handles it if it's ICMP:
//   - an echo REQUEST addressed to my_ip is answered automatically,
//     right here, the same way a real OS kernel answers ping without
//     any application involvement -- returns -2 (not a payload
//     length, just a "handled, but this isn't a reply for you" signal
//     distinct from both "nothing relevant" and any real length).
//   - an echo REPLY (to anyone, not filtered by identifier/seq -- this
//     project's socket layer doesn't demux by port either, see
//     socket_udp_recv's own comment on why that's an accepted scope
//     limit, not an oversight) copies its payload into out_payload,
//     [src_ip(4 BE)][identifier(2 BE)][seq(2 BE)] into out_meta, and
//     returns the payload length -- the caller checks identifier/seq
//     itself against what it expects.
//   - anything else (non-ICMP, an echo request not addressed to us,
//     a request/reply too large for max_payload_len) is dequeued and
//     dropped, returning -1, same "not every queued frame is mine"
//     tolerance every other live receive path in this project has.
fn icmp_poll(my_mac: mut ref i64, my_ip: u32, out_payload: mut ref i64, max_payload_len: i64, out_meta: mut ref i64) -> i64 {
  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, netif_frame_slot_size());
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (1 as u32) {
    return 0 - 1;
  }
  let total_len: u32 = ipv4_get_total_len(frame, 14);
  let icmp_len: i64 = (total_len as i64) - 20;
  // Same "reject, don't guess" bounds posture socket_udp_recv/
  // dhcp_client_poll already use: a declared length claiming more
  // than netif actually delivered, or too short to even hold the
  // fixed 8-byte echo header, is dropped outright before anything
  // below trusts it.
  if icmp_len < 8 {
    return 0 - 1;
  }
  if (14 + (total_len as i64)) > frame_len {
    return 0 - 1;
  }
  if ipv4_verify_checksum(frame, 14) != 1 {
    return 0 - 1;
  }
  if icmp_verify_checksum(frame, 34, icmp_len) != 1 {
    return 0 - 1;
  }
  let msg_type: u32 = icmp_get_type(frame, 34);
  let payload_len: i64 = icmp_len - 8;

  if msg_type == icmp_type_echo_request() {
    if ipv4_get_dst_ip(frame, 14) != my_ip {
      return 0 - 1; // not addressed to us -- not this project's to answer
    }
    let src_ip: u32 = ipv4_get_src_ip(frame, 14);
    let src_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(frame, (6 + mi) as u32); // Ethernet src MAC
      let _ = buf_write_byte(src_mac, mi as u32, mb);
      mi = mi + 1;
    }
    let identifier: u32 = icmp_get_identifier(frame, 34);
    let seq: u32 = icmp_get_sequence(frame, 34);
    let echo_payload: mut ref i64 = dhruva_alloc_bytes(56); // 64-byte real-hardware-typical ping payload minus the 8-byte header, generous headroom over anything this project's own self-test sends
    let copy_len: i64 = if payload_len > (56 as i64) { 56 as i64 } else { payload_len };
    let ci: i64 = 0;
    while ci < copy_len {
      let b: u32 = buf_read_byte(frame, (42 + ci) as u32); // 14 + 20 + 8
      let _ = buf_write_byte(echo_payload, ci as u32, b);
      ci = ci + 1;
    }
    let _ = icmp_send(my_mac, src_mac, my_ip, src_ip, icmp_type_echo_reply(), identifier, seq, echo_payload, copy_len);
    return 0 - 2;
  }

  if msg_type == icmp_type_echo_reply() {
    if payload_len > max_payload_len {
      return 0 - 1;
    }
    let pi: i64 = 0;
    while pi < payload_len {
      let b: u32 = buf_read_byte(frame, (42 + pi) as u32);
      let _ = buf_write_byte(out_payload, pi as u32, b);
      pi = pi + 1;
    }
    let src_ip: u32 = ipv4_get_src_ip(frame, 14);
    let identifier: u32 = icmp_get_identifier(frame, 34);
    let seq: u32 = icmp_get_sequence(frame, 34);
    let _ = buf_write_u32_be(out_meta, 0, src_ip);
    let _ = buf_write_u16_be(out_meta, 4, identifier);
    let _ = buf_write_u16_be(out_meta, 6, seq);
    return payload_len;
  }

  return 0 - 1; // some other ICMP type (e.g. destination unreachable) -- not handled yet
}

// Boot-time self-test: pings our OWN IP over the loopback netif.
// Unlike every other self-test in this project's networking layer,
// this one needs no synthetic "other host" at all -- pinging yourself
// is a genuinely real, self-contained round trip: the first poll
// dequeues our own just-sent echo REQUEST and icmp_poll's own live
// auto-responder answers it for real (queuing a real reply, not a
// hand-built stand-in), and the second poll dequeues THAT reply and
// confirms it matches. Also confirms the "unrelated identifier"
// case is reported as a real reply (this layer doesn't demux by
// identifier/seq itself, matching socket_udp_recv's own no-port-
// demux scope) rather than silently dropped.
fn icmp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;
  let identifier: u32 = 0x1234 as u32;
  let seq: u32 = 1 as u32;

  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 112 as u32); // "ping"
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32);
  let _ = buf_write_byte(payload, 2 as u32, 110 as u32);
  let _ = buf_write_byte(payload, 3 as u32, 103 as u32);

  let send_status: i64 = icmp_ping_start(my_mac, my_mac, my_ip, my_ip, identifier, seq, payload, 4);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);

  // First poll: our own echo REQUEST, auto-answered.
  let poll1: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if poll1 != (0 - 2) {
    ok = 0;
  }

  // Second poll: the reply icmp_poll's own responder just queued.
  let poll2: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if poll2 != 4 {
    ok = 0;
  }
  let i: i64 = 0;
  while i < 4 {
    let a: u32 = buf_read_byte(payload, i as u32);
    let b: u32 = buf_read_byte(recv_payload, i as u32);
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }
  if buf_read_u32_be(recv_meta, 0) != my_ip {
    ok = 0;
  }
  if buf_read_u16_be(recv_meta, 4) != identifier {
    ok = 0;
  }
  if buf_read_u16_be(recv_meta, 6) != seq {
    ok = 0;
  }

  let empty_status: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if empty_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("ICMP: ping self over loopback (auto-reply + round trip)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: UDP (RFC 768), sitting on ipv4_build_header/netif exactly
// like IPv4 sits on netif -- no new persistent state, pure vani logic.
// Header: src_port(2) dst_port(2) length(2, header+data) checksum(2).
//
// The checksum covers a "pseudo-header" (source IP, destination IP,
// a zero byte, the protocol number, and the UDP length) PREPENDED to
// the real UDP header+data before summing -- not because those bytes
// are transmitted twice, but because it's what lets a corrupted IP
// address (not just corrupted UDP bytes) be caught by the receiver,
// per RFC 768's own design. A UDP checksum of exactly 0 is illegal on
// the wire (0 means "no checksum was computed" by convention) --
// RFC 768 requires transmitting 0xFFFF instead in that case.

// Round 106d: UDP's own checksum/header-codec ALGORITHM now lives in
// the shared `netstack` package (`netstack_udp_*`/`UdpChecksumCtx`),
// streaming rather than assuming a bounded frame -- Pi 1's own real
// UDP payloads run up to ~1472 bytes (netif_get_mtu() minus IP/UDP
// headers), well past any small fixed array the package could
// otherwise commit to. See `vani-netstack`'s own header comment for
// the full reasoning (mirrors `chacha20_poly1305`'s own streaming
// `Poly1305Ctx`).
fn udp_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, udp_offset: i64, udp_len: i64) -> u32 {
  let ctx: UdpChecksumCtx = netstack_udp_checksum_init(src_ip, dst_ip, udp_len);
  let pos: i64 = 0;
  while pos < udp_len {
    let remaining: i64 = udp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let i: i64 = 0;
    while i < take {
      chunk[i] = buf_read_byte(frame, (udp_offset + pos + i) as u32) as u8;
      i = i + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  return netstack_udp_checksum_finalize(ref ctx);
}

// BUG (round 8 audit, 2026-08-27): no udp_verify_checksum existed at
// all, and socket_udp_recv (the live UDP receive path) never checked
// an incoming datagram's checksum against anything -- despite every
// other layer in this stack having a working, self-tested verify
// function (ipv4_verify_checksum, tcp_verify_checksum) sitting right
// next to its own build/checksum function. A corrupted UDP datagram
// (bit-flipped in transit -- the exact threat model this project's
// own FS layer takes seriously enough to checksum every record for)
// would be silently accepted and handed to the caller as valid data.
//
// The verify criterion here is NOT the same as tcp_verify_checksum's
// `== 0` -- confirmed by working through the arithmetic (and checked
// against a standalone vani test): udp_checksum has an extra step
// tcp_checksum doesn't (RFC 768's "never transmit a literal 0, send
// 0xFFFF instead" substitution). Re-summing a valid, as-transmitted
// datagram (checksum field included) always folds to exactly 0xFFFF,
// which udp_checksum's own zero-substitution rule then maps back to
// 0xFFFF again (not 0) -- so a valid datagram makes udp_checksum
// return 0xFFFF, matching ipv4_verify_checksum's convention, not
// tcp_verify_checksum's.
fn udp_verify_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, udp_offset: i64, udp_len: i64) -> i64 {
  if udp_checksum(src_ip, dst_ip, frame, udp_offset, udp_len) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

// Writes the UDP header+payload at frame[udp_offset..), returning the
// UDP length (header+payload). Caller still has to build the IP
// header around this afterward (see udp_send below) -- kept separate
// so a self-test can exercise header construction without needing a
// full send/recv round trip too.
fn udp_build(frame: mut ref i64, udp_offset: i64, src_port: u32, dst_port: u32, payload: mut ref i64, payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let udp_len: i64 = 8 + payload_len;
  let hdr: [u8; 8] = netstack_udp_header_only(src_port, dst_port, udp_len);
  let hi: i64 = 0;
  while hi < 8 {
    let _ = buf_write_byte(frame, (udp_offset + hi) as u32, hdr[hi] as u32);
    hi = hi + 1;
  }
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (udp_offset + 8 + i) as u32, b);
    i = i + 1;
  }
  let checksum: u32 = udp_checksum(src_ip, dst_ip, frame, udp_offset, udp_len);
  let _ = buf_write_u16_be(frame, udp_offset + 6, checksum);
  return udp_len;
}

fn udp_get_src_port(frame: mut ref i64, udp_offset: i64) -> u32 {
  let hdr: [u8; 8] = [
    buf_read_byte(frame, udp_offset as u32) as u8, buf_read_byte(frame, (udp_offset + 1) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 2) as u32) as u8, buf_read_byte(frame, (udp_offset + 3) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 4) as u32) as u8, buf_read_byte(frame, (udp_offset + 5) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 6) as u32) as u8, buf_read_byte(frame, (udp_offset + 7) as u32) as u8
  ];
  return netstack_udp_get_src_port(ref hdr);
}
fn udp_get_dst_port(frame: mut ref i64, udp_offset: i64) -> u32 {
  let hdr: [u8; 8] = [
    buf_read_byte(frame, udp_offset as u32) as u8, buf_read_byte(frame, (udp_offset + 1) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 2) as u32) as u8, buf_read_byte(frame, (udp_offset + 3) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 4) as u32) as u8, buf_read_byte(frame, (udp_offset + 5) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 6) as u32) as u8, buf_read_byte(frame, (udp_offset + 7) as u32) as u8
  ];
  return netstack_udp_get_dst_port(ref hdr);
}
fn udp_get_length(frame: mut ref i64, udp_offset: i64) -> u32 {
  let hdr: [u8; 8] = [
    buf_read_byte(frame, udp_offset as u32) as u8, buf_read_byte(frame, (udp_offset + 1) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 2) as u32) as u8, buf_read_byte(frame, (udp_offset + 3) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 4) as u32) as u8, buf_read_byte(frame, (udp_offset + 5) as u32) as u8,
    buf_read_byte(frame, (udp_offset + 6) as u32) as u8, buf_read_byte(frame, (udp_offset + 7) as u32) as u8
  ];
  return netstack_udp_get_length(ref hdr);
}

// Builds and sends a full Ethernet+IPv4+UDP frame. Offsets are fixed
// (14 for IP, 34 for UDP) since this stack never sends IP options.
// `frame` is net_send_scratch -- see ipv4_send's own comment above.
//
// BUG (round 9 audit, 2026-08-27): same send-side missing-bounds-check
// shape as ipv4_send's own fix above, one layer higher -- payload_len
// fed udp_build's copy loop with nothing checking it against net_send_
// scratch's real capacity (netif_frame_slot_size() bytes, round 66;
// originally a hardcoded 512) first.
//
// BUG (round 11 audit, 2026-08-27): same "derive from netif_get_mtu(),
// don't hardcode a number that merely matches it today" fix as
// ipv4_send's own comment explains in full.
fn udp_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let udp_max_payload: i64 = netif_get_mtu() - 20 - 8; // minus IP header, minus UDP header
  if (payload_len < 0) || (payload_len > udp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let udp_len: i64 = udp_build(frame, 34, src_port, dst_port, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + udp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 17 as u32, src_ip, dst_ip);
  return netif_send_frame(frame, 14 + total_len);
}

// Phase 6's "small socket-style API" (DHRUVA_ARCHITECTURE.md §4): a
// thin, deliberately minimal wrapper hiding the raw Ethernet/IP/UDP
// plumbing above. This demo stack has exactly one implicit "socket" --
// no per-port binding/filtering table exists yet, so socket_udp_recv
// just reports whatever the next queued UDP frame's own header says
// it's addressed to/from, silently skipping (returning -1 for) any
// non-UDP frame rather than actually demultiplexing by port. A real
// multi-socket implementation would need that; this is enough to
// prove the layers below it end-to-end, per this phase's own scope.
// BUG (round 21 audit, 2026-08-28): this used to hardcode `my_mac` as
// the destination MAC unconditionally -- a loopback-only assumption
// baked directly into the one layer explicitly documented as hiding
// this exact plumbing from callers. It happened to "work" only
// because there is no other real host on this project's only tested
// link: whatever remote_ip claims, the frame still had to physically
// go to yourself to be receivable at all. On real hardware
// (LAN9512/WiFi), a genuinely different peer's MAC has to actually be
// known before a unicast frame can reach it -- arp_cache_lookup/
// arp_cache_insert/arp_build_request/arp_build_reply were all already
// implemented and self-tested (arp_self_test), but had ZERO live
// callers anywhere in the codebase, the same "correct function nobody
// calls" bug class rounds 8 and 11 already found in this file. Fixed
// by requiring the destination to already be ARP-resolved (a cache
// hit) before sending -- matching every other layer in this project's
// established poll-don't-block design (DHCP/TCP never block inside a
// single call waiting on a live round trip either): a synchronous
// send function has no way to synchronously wait for an ARP reply
// without restructuring this whole layer into a stateful poll loop,
// so a cache miss is reported as a real, honest failure (-1, "no
// route to host") rather than silently substituting a MAC that's
// certain to be wrong for any real off-loopback destination.
fn socket_udp_send(my_mac: mut ref i64, local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let dst_mac: mut ref i64 = udp_send_arp_scratch_get();
  if arp_cache_lookup(remote_ip, dst_mac) != 1 {
    return 0 - 1;
  }
  return udp_send(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, payload, payload_len);
}

// Receives the next queued frame; if it's UDP, copies its payload into
// out_payload and writes [src_ip(4, BE)][src_port(2, BE)][dst_port(2,
// BE)] into out_meta (8 bytes), returning the payload length. Returns
// -1 if nothing is queued, the frame isn't UDP, or the segment fails
// the sanity checks below (see the comment at those checks for what
// they guard against and why they're not optional). `frame` is
// net_recv_scratch, not a fresh allocation -- see ipv4_send's own
// comment on the identical fix for the send side.
fn socket_udp_recv(out_payload: mut ref i64, out_meta: mut ref i64, max_payload_len: i64) -> i64 {
  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, netif_frame_slot_size());
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (17 as u32) {
    return 0 - 1;
  }
  let udp_len: u32 = udp_get_length(frame, 34);
  let payload_len: i64 = (udp_len as i64) - 8;
  // BUG (found via audit, 2026-08-27, never actually triggered since
  // nothing exercises this against real/malformed network input yet):
  // payload_len came entirely from the UDP header's OWN self-reported
  // length field -- untrusted data carried INSIDE the very frame this
  // function is parsing, not validated against anything. A field
  // claiming an absurd length (corrupted on the wire, or crafted, on
  // any real non-loopback link) would drive the copy loop below to
  // read far past frame's real bounds and write far past out_payload's
  // real allocated size -- a heap buffer over-read/overflow, the exact
  // kind of bug a from-scratch network stack has to guard against at
  // exactly this boundary (untrusted bytes off the wire), not trust
  // the way this project trusts its own already-checksummed FS
  // records. Three checks, all required: the declared length can't be
  // negative (a UDP length < 8 doesn't even cover its own header), the
  // declared segment can't claim to extend past what netif actually
  // received (frame_len), and the payload can't be larger than the
  // caller's own out_payload buffer (max_payload_len, now a required
  // parameter -- there is no way to ask a dhruva_alloc_bytes result
  // its own size at runtime, so the caller has to say). Any violation
  // is treated as a malformed/hostile segment and dropped outright,
  // never silently truncated -- same "reject, don't guess" posture as
  // dharafs_init's own checksum-based recovery scan.
  if payload_len < 0 {
    return 0 - 1;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0 - 1;
  }
  if payload_len > max_payload_len {
    return 0 - 1;
  }
  // BUG (round 8 audit, 2026-08-27): this function never checked the
  // datagram's own checksum against anything -- see udp_verify_
  // checksum's own comment for the full story. Checked here, after
  // the length/bounds validation above (so the checksum is computed
  // over a range already known to be in-bounds) and before the
  // payload copy, same "reject, don't guess" posture as every other
  // check in this function.
  let src_ip_for_checksum: u32 = ipv4_get_src_ip(frame, 14);
  let dst_ip_for_checksum: u32 = ipv4_get_dst_ip(frame, 14);
  if udp_verify_checksum(src_ip_for_checksum, dst_ip_for_checksum, frame, 34, udp_len as i64) != 1 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(frame, (42 + i) as u32); // 14 + 20 + 8
    let _ = buf_write_byte(out_payload, i as u32, b);
    i = i + 1;
  }
  let src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let src_port: u32 = udp_get_src_port(frame, 34);
  let dst_port: u32 = udp_get_dst_port(frame, 34);
  let _ = buf_write_u32_be(out_meta, 0, src_ip);
  let _ = buf_write_u16_be(out_meta, 4, src_port);
  let _ = buf_write_u16_be(out_meta, 6, dst_port);
  return payload_len;
}

// Boot-time self-test: send a UDP datagram over the loopback netif,
// receive it back through the socket API, and verify the payload,
// port/address metadata, and the empty-queue case afterward.
//
// BUG (round 21 audit, 2026-08-28): socket_udp_send now requires
// remote_ip to already be ARP-resolved (see its own comment for the
// full story) rather than silently sending to itself -- so this test
// pre-populates the cache with arp_cache_insert(remote_ip, my_mac)
// before calling it, standing in for "ARP already happened" the same
// way DHCP's own self-test manually builds a synthetic server reply
// instead of needing a real second host. This tests UDP header
// build/parse/checksum round-tripping specifically; arp_self_test
// already independently covers the ARP mechanics themselves. Depends
// on arp_self_test having already run this boot (it's the one place
// arp_cache_init actually gets called) -- see kernel_main's own call
// order.
fn udp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;
  let local_port: u32 = 12345 as u32;
  let remote_port: u32 = 7 as u32;

  let payload: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // "hello"
  let _ = buf_write_byte(payload, 1 as u32, 101 as u32);
  let _ = buf_write_byte(payload, 2 as u32, 108 as u32);
  let _ = buf_write_byte(payload, 3 as u32, 108 as u32);
  let _ = buf_write_byte(payload, 4 as u32, 111 as u32);

  let _ = arp_cache_insert(remote_ip, my_mac);
  let send_status: i64 = socket_udp_send(my_mac, local_ip, remote_ip, local_port, remote_port, payload, 5);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(16);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let recv_len: i64 = socket_udp_recv(recv_payload, recv_meta, 16);
  if recv_len != 5 {
    ok = 0;
  }
  let i: i64 = 0;
  while i < 5 {
    let a: u32 = buf_read_byte(payload, i as u32);
    let b: u32 = buf_read_byte(recv_payload, i as u32);
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }

  let got_src_ip: u32 = buf_read_u32_be(recv_meta, 0);
  let got_src_port: u32 = buf_read_u16_be(recv_meta, 4);
  let got_dst_port: u32 = buf_read_u16_be(recv_meta, 6);
  if got_src_ip != local_ip {
    ok = 0;
  }
  if got_src_port != local_port {
    ok = 0;
  }
  if got_dst_port != remote_port {
    ok = 0;
  }

  let empty_status: i64 = socket_udp_recv(recv_payload, recv_meta, 16);
  if empty_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: socket send/recv over loopback + checksum");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 21's fix (see socket_udp_send's own
// comment): sending to an IP that was never ARP-resolved must be
// rejected outright, not silently sent to whatever MAC happens to be
// convenient (this project's own MAC, the loopback-only shortcut that
// used to sit here unconditionally). Deliberately uses an IP no
// earlier self-test this boot has ever called arp_cache_insert for.
fn udp_send_unresolved_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let never_resolved_ip: u32 = 0xC0A80103 as u32; // .3, never cached
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32);

  let send_status: i64 = socket_udp_send(my_mac, local_ip, never_resolved_ip, 12345 as u32, 7 as u32, payload, 1);
  if send_status != (0 - 1) {
    ok = 0;
  }
  // Confirm the rejection didn't leak a phantom frame onto the queue
  // either -- a caller retrying after resolving the address must see
  // an empty queue, not a stale, wrongly-addressed one from the
  // rejected attempt.
  let drain: mut ref i64 = dhruva_alloc_bytes(16);
  let drain_status: i64 = netif_recv_frame(drain, 16);
  if drain_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: socket_udp_send rejects an unresolved destination");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for the length-validation fix found by audit
// (2026-08-27, see socket_udp_recv's own comment): a UDP segment
// whose header claims a length far beyond what was actually received
// must be rejected outright, not trusted as a copy-loop bound. Builds
// a real, small, correctly-queued frame (so netif_recv_frame reports
// its true, small length), then corrupts only the UDP header's own
// length field to claim far more data than that -- exactly the shape
// a corrupted-on-the-wire or hostile segment would have on any real
// (non-loopback) link.
fn udp_recv_bounds_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let i: i64 = 0;
  while i < 12 {
    let _ = buf_write_byte(frame, i as u32, 0 as u32); // dst/src MAC, don't care
    i = i + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32);
  let real_udp_len: i64 = udp_build(frame, 34, 1 as u32, 2 as u32, payload, 1, local_ip, remote_ip);
  let real_total_len: i64 = 20 + real_udp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 17 as u32, local_ip, remote_ip);
  let real_frame_len: i64 = 14 + real_total_len; // 14+20+9 = 43 bytes, actually queued

  // Corrupt ONLY the UDP header's own length field (checksum is left
  // stale/mismatched on purpose -- this test targets the length
  // bounds check specifically, not checksum validation; the too-large
  // length is rejected by the bounds check below before checksum
  // verification is even reached. See udp_checksum_reject_self_test
  // right after this function for the checksum-specific case).
  let _ = buf_write_u16_be(frame, 34 + 4, 60000 as u32);

  let send_status: i64 = netif_send_frame(frame, real_frame_len);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let status: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: recv rejects a length field past what was actually received");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 8's checksum-verification fix (see
// udp_verify_checksum's own comment): a UDP datagram with a perfectly
// valid length but corrupted PAYLOAD bytes must now be rejected too --
// before this fix, socket_udp_recv never checked the checksum at all,
// so this exact corruption would have been silently accepted and
// handed to the caller as if it were valid data.
fn udp_checksum_reject_self_test() -> i64 {
  let ok: i64 = 1;
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let i: i64 = 0;
  while i < 12 {
    let _ = buf_write_byte(frame, i as u32, 0 as u32); // dst/src MAC, don't care
    i = i + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32); // 'A'
  let real_udp_len: i64 = udp_build(frame, 34, 1 as u32, 2 as u32, payload, 1, local_ip, remote_ip);
  let real_total_len: i64 = 20 + real_udp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 17 as u32, local_ip, remote_ip);
  let real_frame_len: i64 = 14 + real_total_len;

  // Corrupt ONLY the payload byte -- length fields (both IPv4 and UDP)
  // stay correct, so this must pass every bounds check and be rejected
  // by checksum verification specifically.
  let _ = buf_write_byte(frame, 42 as u32, 66 as u32); // 'A' -> 'B', 14+20+8=42

  let send_status: i64 = netif_send_frame(frame, real_frame_len);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let status: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: recv rejects a datagram with a corrupted checksum");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: TCP (RFC 793), the last protocol layer
// DHRUVA_ARCHITECTURE.md §4 calls for ("ARP, IPv4, UDP, TCP, a small
// socket-style API"). No options (data offset always 5 words/20
// bytes, matching this stack's own "no IP options either" convention
// -- nothing here sends or needs to parse them). This first slice is
// the stateless header layer only (build/parse/checksum), verified by
// its own self-test exactly like ARP/IPv4 were introduced before
// UDP's stateful socket layer landed on top -- the three-way-
// handshake + data-transfer + close connection state machine is
// deliberately a separate, later slice, not attempted in the same
// pass as this header layer.
//
// Header layout (offsets relative to tcp_offset, 34 bytes into a
// netif-backed frame with no IP options, exactly where UDP's own
// header starts):
//   0-1 source port          2-3 destination port
//   4-7 sequence number      8-11 acknowledgment number
//   12 data offset (upper 4 bits, in 32-bit words) + reserved (0)
//   13 flags (bit0=FIN bit1=SYN bit2=RST bit3=PSH bit4=ACK bit5=URG)
//   14-15 window size        16-17 checksum        18-19 urgent ptr (0)
//
// Checksum uses the identical pseudo-header technique as UDP (source
// IP, destination IP, zero byte, protocol=6, TCP segment length) --
// see udp_checksum's own comment for why the pseudo-header matters,
// same reasoning applies verbatim here.

fn tcp_flag_fin() -> u32 { return netstack_tcp_flag_fin(); }
fn tcp_flag_syn() -> u32 { return netstack_tcp_flag_syn(); }
fn tcp_flag_rst() -> u32 { return netstack_tcp_flag_rst(); }
fn tcp_flag_psh() -> u32 { return netstack_tcp_flag_psh(); }
fn tcp_flag_ack() -> u32 { return netstack_tcp_flag_ack(); }

// Round 106f: TCP's own header codec/checksum ALGORITHM now lives in
// the shared `netstack` package (`netstack_tcp_*`/`UdpChecksumCtx`
// reused, no separate TCP-specific accumulator needed -- the running
// sum itself is identical between UDP and TCP, only the pseudo-
// header seed and final zero-substitution step differ). TCP's
// checksum spans the whole segment (header+payload), genuinely
// unbounded on this file's own heap frames, so it streams in
// <=256-byte chunks; the 20-byte header itself is fixed, so it uses
// a standalone codec matching IPv4's own precedent.
fn tcp_header_extract(frame: mut ref i64, tcp_offset: i64) -> [u8; 20] {
  let hdr: [u8; 20] = netstack_zero20_bytes();
  let i: i64 = 0;
  while i < 20 {
    hdr[i] = buf_read_byte(frame, (tcp_offset + i) as u32) as u8;
    i = i + 1;
  }
  return hdr;
}

fn tcp_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, tcp_offset: i64, tcp_len: i64) -> u32 {
  let ctx: UdpChecksumCtx = netstack_tcp_checksum_init(src_ip, dst_ip, tcp_len);
  let pos: i64 = 0;
  while pos < tcp_len {
    let remaining: i64 = tcp_len - pos;
    let take: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = netstack_zero256_bytes();
    let i: i64 = 0;
    while i < take {
      chunk[i] = buf_read_byte(frame, (tcp_offset + pos + i) as u32) as u8;
      i = i + 1;
    }
    ctx = netstack_udp_checksum_update(ctx, ref chunk, take);
    pos = pos + take;
  }
  return netstack_tcp_checksum_finalize(ref ctx);
}

fn tcp_build_header(frame: mut ref i64, tcp_offset: i64, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: mut ref i64, payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let tcp_len: i64 = 20 + payload_len;
  let hdr: [u8; 20] = netstack_tcp_header_only(src_port, dst_port, seq, ack, flags, window);
  let hi: i64 = 0;
  while hi < 20 {
    let _ = buf_write_byte(frame, (tcp_offset + hi) as u32, hdr[hi] as u32);
    hi = hi + 1;
  }
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (tcp_offset + 20 + i) as u32, b);
    i = i + 1;
  }
  let checksum: u32 = tcp_checksum(src_ip, dst_ip, frame, tcp_offset, tcp_len);
  let _ = buf_write_u16_be(frame, tcp_offset + 16, checksum);
  return tcp_len;
}

fn tcp_get_src_port(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_src_port(ref hdr);
}
fn tcp_get_dst_port(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_dst_port(ref hdr);
}
fn tcp_get_seq(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_seq(ref hdr);
}
fn tcp_get_ack(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_ack(ref hdr);
}
fn tcp_get_flags(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_flags(ref hdr);
}
fn tcp_get_window(frame: mut ref i64, tcp_offset: i64) -> u32 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_window(ref hdr);
}
fn tcp_get_data_offset_bytes(frame: mut ref i64, tcp_offset: i64) -> i64 {
  let hdr: [u8; 20] = tcp_header_extract(frame, tcp_offset);
  return netstack_tcp_get_data_offset_bytes(ref hdr);
}

// A correctly-checksummed segment's bytes, summed again as
// transmitted (checksum field included, unlike at build time), yield
// exactly zero -- NOT all-ones. This differs from ipv4_verify_
// checksum's own convention on purpose, not by accident: ipv4_
// checksum returns the raw pre-complement sum (its caller,
// ipv4_build_header, does the `^ 0xFFFF` complement itself), so
// summing again including the stored checksum reaches all-ones
// (S + ~S, the defining identity of one's-complement negation).
// tcp_checksum instead complements its OWN running sum internally
// before returning (matching udp_checksum's shape, which this
// function was modeled on) -- so calling it again over the as-
// transmitted bytes computes ~(S + C) = ~(S + ~S) = ~0xFFFF = 0x0000
// instead. Found live: the first version of this function copied
// ipv4_verify_checksum's `== 0xFFFF` comparison without accounting
// for that difference, and failed on every single correctly-built
// segment.
fn tcp_verify_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, tcp_offset: i64, tcp_len: i64) -> i64 {
  if tcp_checksum(src_ip, dst_ip, frame, tcp_offset, tcp_len) == (0 as u32) {
    return 1;
  }
  return 0;
}

// Builds a full Ethernet+IPv4+TCP segment and sends it via netif.
// Fixed offsets (14 for IP, 34 for TCP) since this stack never sends
// IP options, matching udp_send's own layout exactly.
//
// BUG (round 9 audit, 2026-08-27): same send-side missing-bounds-check
// shape as ipv4_send/udp_send's own fixes -- payload_len fed tcp_build_
// header's copy loop with nothing checking it against net_send_
// scratch's real capacity (netif_frame_slot_size() bytes, round 66;
// originally a hardcoded 512) first.
//
// BUG (round 11 audit, 2026-08-27): same "derive from netif_get_mtu(),
// don't hardcode a number that merely matches it today" fix as
// ipv4_send's own comment explains in full.
fn tcp_send_segment(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let tcp_max_payload: i64 = netif_get_mtu() - 20 - 20; // minus IP header, minus TCP header (no options)
  if (payload_len < 0) || (payload_len > tcp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let tcp_len: i64 = tcp_build_header(frame, 34, src_port, dst_port, seq, ack, flags, window, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + tcp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 6 as u32, src_ip, dst_ip);
  return netif_send_frame(frame, 14 + total_len);
}

// Boot-time self-test: build/send/receive a single SYN segment over
// the loopback netif and verify every TCP header field, the checksum,
// and the (empty, for a SYN) payload round-tripped correctly -- the
// same "prove the stateless header layer is byte-correct" role
// ipv4_self_test plays for IPv4, before UDP's stateful socket layer
// was introduced on top of ITS header layer. The three-way-handshake/
// data-transfer/close connection state machine gets its own, later
// self-test once that stateful layer exists.
fn tcp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let src_port: u32 = 54321 as u32;
  let dst_port: u32 = 80 as u32;
  let seq: u32 = 1000 as u32;
  let ack: u32 = 0 as u32;
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();

  let send_status: i64 = tcp_send_segment(my_mac, my_mac, src_ip, dst_ip, src_port, dst_port, seq, ack, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_frame, 64);
  if recv_len != 54 { // 14 (eth) + 20 (ip) + 20 (tcp), no payload
    ok = 0;
  }
  if tcp_get_src_port(recv_frame, 34) != src_port {
    ok = 0;
  }
  if tcp_get_dst_port(recv_frame, 34) != dst_port {
    ok = 0;
  }
  if tcp_get_seq(recv_frame, 34) != seq {
    ok = 0;
  }
  if tcp_get_ack(recv_frame, 34) != ack {
    ok = 0;
  }
  if tcp_get_flags(recv_frame, 34) != tcp_flag_syn() {
    ok = 0;
  }
  if tcp_get_data_offset_bytes(recv_frame, 34) != 20 {
    ok = 0;
  }
  if tcp_verify_checksum(src_ip, dst_ip, recv_frame, 34, 20) != 1 {
    ok = 0;
  }
  if ipv4_get_protocol(recv_frame, 14) != (6 as u32) {
    ok = 0;
  }

  let _ = uart_puts("TCP: header build/send/recv + checksum verify (SYN)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: the stateful TCP connection state machine --
// three-way handshake, data transfer, and a simplified close, closing
// out DHRUVA_ARCHITECTURE.md §4's "small socket-style API" for TCP.
//
// Deliberately event-driven (one segment in, one reaction out) rather
// than a blocking `tcp_connect()` that internally loops waiting for a
// response: this is a single-threaded environment with no second task
// available to run "the other side" concurrently while a blocking
// call waits, the same reasoning arp_self_test's own design already
// reflects (it never actually blocks on a real request/reply round
// trip either). The self-test below plays traffic cop, manually
// handing each side's own outgoing segment to the OTHER side's
// tcp_conn_handle_segment call -- two independent connection slots
// (boot/tcp_state.S), not one, so both a real "active open" client
// role and a real "passive open" server role can be tracked
// simultaneously.
//
// Scoped like uIP/picoTCP, not full lwIP feature parity -- a real,
// useful, correctly-sequenced connection lifecycle, not a
// spec-complete implementation. Round 37 added retransmission timers
// and simultaneous open; round 72 added simultaneous close (see
// tcp_state_closing() below) and advertised-window enforcement (see
// tcp_conn_remote_window in boot/tcp_state.S and tcp_conn_send_data's
// own check). Still deliberately NOT implemented: no urgent-pointer
// handling, no zero-window probing (tcp_conn_send_data simply refuses
// to send more than the peer's last-advertised window rather than
// waiting/retrying for it to reopen -- a real, honest scope boundary,
// not an oversight).

fn tcp_state_closed() -> u32 { return 0 as u32; }
fn tcp_state_syn_sent() -> u32 { return 1 as u32; }
fn tcp_state_syn_rcvd() -> u32 { return 2 as u32; }
fn tcp_state_established() -> u32 { return 3 as u32; }
fn tcp_state_fin_wait() -> u32 { return 4 as u32; }
fn tcp_state_closed_final() -> u32 { return 5 as u32; }
// Round 72: RFC 793 CLOSING -- reached from FIN_WAIT when the peer's
// own FIN arrives BEFORE it has acknowledged ours (simultaneous
// close: both sides called tcp_conn_close before seeing the other's
// FIN). Distinct from FIN_WAIT's own normal one-sided-close case
// (peer's FIN+ACK arrives ALREADY acknowledging our FIN, going
// straight to CLOSED_FINAL) -- CLOSING still needs to wait for that
// specific ACK to arrive separately. See tcp_conn_handle_segment's
// own FIN_WAIT/CLOSING branches below.
fn tcp_state_closing() -> u32 { return 6 as u32; }

// Round 37: retransmission timing constants. 4 ticks (timer_ic_init's
// own 500ms compare interval -- confirmed against that function's own
// comment) = 2 real seconds, short enough for a live test to actually
// wait one out without an excessive delay, long enough to be a real
// timeout rather than firing on ordinary scheduling jitter. 3 retries
// before giving up, matching this project's own established "bounded,
// not forever" polling discipline used everywhere else.
fn tcp_rtx_timeout_ticks() -> u32 {
  return 4 as u32;
}
fn tcp_rtx_max_retries() -> u32 {
  return 3 as u32;
}

// Active open (the connecting/"client" side): records connection
// identity, picks an initial sequence number, and sends the opening
// SYN. Conn moves to SYN_SENT; the handshake only completes once the
// caller feeds a matching SYN-ACK segment into tcp_conn_handle_segment.
// Round 37: also arms the SYN's own retransmission timer -- rtx_len=0
// marks this as a bare-SYN retransmission (no payload buffer needed),
// rtx_seq=initial_seq is what tcp_conn_check_retransmit resends if the
// SYN-ACK never arrives.
fn tcp_conn_active_open(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64, local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, initial_seq: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_remote_port(conn_id, remote_port);
  let _ = tcp_conn_set_local_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_remote_seq(conn_id, 0 as u32);
  let _ = tcp_conn_set_remote_window(conn_id, 65535 as u32); // sane default until the peer's first real segment says otherwise
  let _ = tcp_conn_set_state(conn_id, tcp_state_syn_sent());
  let _ = tcp_conn_set_rtx_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_rtx_len(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
  return tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, initial_seq, 0 as u32, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
}

// Passive open (the listening/"server" side): records only the local
// identity it's willing to accept a connection on -- remote identity
// and sequence numbers get filled in once tcp_conn_handle_segment sees
// the actual incoming SYN. Conn stays CLOSED until then (there's no
// separate LISTEN state in this minimal scope; a CLOSED connection
// with local_port already set is what handle_segment treats as
// "willing to accept").
fn tcp_conn_passive_open(conn_id: u32, local_ip: u32, local_port: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_remote_window(conn_id, 65535 as u32); // sane default until the peer's first real segment says otherwise
  let _ = tcp_conn_set_state(conn_id, tcp_state_closed());
  return 0;
}

// The core state-machine step: given one already-received TCP segment
// (frame, with its IPv4/Ethernet headers still in place at their
// usual fixed offsets) addressed to this connection, takes whatever
// single reaction the current state calls for -- sending at most one
// reply segment via my_mac/dst_mac -- and returns:
//   >= 0  a data segment was accepted; return value is the payload
//         length copied into out_payload (0 for a control-only
//         segment with no data, which is the common case)
//   -1    the segment didn't match anything this state expects
//         (silently ignored, matching a real TCP's own tolerance of
//         duplicate/out-of-order segments in a scope this minimal
//         implementation doesn't attempt to handle)
fn tcp_conn_handle_segment(conn_id: u32, frame: mut ref i64, recv_len: i64, my_mac: mut ref i64, dst_mac: mut ref i64, out_payload: mut ref i64, max_payload_len: i64) -> i64 {
  // BUG (round 8 audit, 2026-08-27): this function -- the live TCP
  // receive path -- never checked an incoming segment's checksum
  // against anything, despite tcp_checksum/tcp_verify_checksum both
  // already existing, working, and self-tested. A corrupted segment
  // (bit-flipped in transit) would be processed as if valid, its
  // flags/seq/ack all trusted outright. Checked here, before any of
  // the state-machine branches below, so it covers every segment type
  // uniformly (a control-only segment's flags could be corrupted just
  // as easily as a data segment's payload) -- same "reject, don't
  // guess" posture as every other check in this networking layer.
  // tcp_len is computed from recv_len (already trusted -- how many
  // bytes netif actually received, per round 1's audit) rather than
  // the segment's own data_offset field, since the checksum has to
  // cover the whole segment as received regardless of which branch
  // below ends up handling it.
  let tcp_seg_len: i64 = recv_len - 34;
  let checksum_src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let checksum_dst_ip: u32 = ipv4_get_dst_ip(frame, 14);
  if tcp_verify_checksum(checksum_src_ip, checksum_dst_ip, frame, 34, tcp_seg_len) != 1 {
    return 0 - 1;
  }
  let state: u32 = tcp_conn_get_state(conn_id);
  let flags: u32 = tcp_get_flags(frame, 34);
  let seg_seq: u32 = tcp_get_seq(frame, 34);
  let seg_ack: u32 = tcp_get_ack(frame, 34);
  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);

  let has_syn: i64 = 0;
  if (flags & tcp_flag_syn()) != (0 as u32) { has_syn = 1; }
  let has_ack: i64 = 0;
  if (flags & tcp_flag_ack()) != (0 as u32) { has_ack = 1; }
  let has_fin: i64 = 0;
  if (flags & tcp_flag_fin()) != (0 as u32) { has_fin = 1; }
  let has_psh: i64 = 0;
  if (flags & tcp_flag_psh()) != (0 as u32) { has_psh = 1; }

  // Round 72: capture the peer's own advertised window from EVERY
  // segment uniformly, before any state branch below -- consulted by
  // tcp_conn_send_data, closing the "accepted, never enforced" gap.
  let _ = tcp_conn_set_remote_window(conn_id, tcp_get_window(frame, 34));

  // Passive open, first SYN arriving: only reachable from CLOSED with
  // a local_port already configured by tcp_conn_passive_open.
  if (state == tcp_state_closed()) && (has_syn == 1) && (tcp_get_dst_port(frame, 34) == local_port) {
    let _ = tcp_conn_set_remote_ip(conn_id, ipv4_get_src_ip(frame, 14));
    let _ = tcp_conn_set_remote_port(conn_id, tcp_get_src_port(frame, 34));
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // SYN consumes one seq number
    let server_isn: u32 = 5000 as u32;
    let _ = tcp_conn_set_local_seq(conn_id, server_isn);
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), server_isn, tcp_conn_get_remote_seq(conn_id), tcp_flag_syn() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Active-open side receiving the SYN-ACK: completes with our own
  // final ACK, moving straight to ESTABLISHED (this side never
  // actually waits in a separate "just sent the final ACK" state --
  // once it's sent, the handshake is done from this side's view).
  // Round 37: the peer answered, so whatever SYN retransmission timer
  // active_open armed is no longer needed -- cancel it.
  if (state == tcp_state_syn_sent()) && (has_syn == 1) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let new_local_seq: u32 = tcp_conn_get_local_seq(conn_id) + (1 as u32); // our own SYN consumed one
    let _ = tcp_conn_set_local_seq(conn_id, new_local_seq);
    let _ = tcp_conn_set_state(conn_id, tcp_state_established());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), new_local_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Round 37: simultaneous open -- both sides issue active_open at
  // roughly the same time, so this side is still in SYN_SENT when the
  // peer's own bare SYN (no ACK -- it hasn't seen OUR SYN yet either)
  // arrives instead of a SYN-ACK. Real, spec-legitimate TCP behavior
  // (RFC 793), not a shortcut: answer with SYN+ACK (acknowledging the
  // peer's SYN) and move to SYN_RCVD -- the EXACT state passive_open's
  // own first-SYN branch above already produces, so the existing
  // "Passive-open side receiving the final ACK" branch below already
  // knows how to complete this side's handshake with no further
  // changes needed. Our own local_seq is left exactly as active_open
  // already set it -- our SYN was already sent at that value; nothing
  // here re-sends or re-picks it, matching passive_open's own
  // "server_isn set once" pattern.
  if (state == tcp_state_syn_sent()) && (has_syn == 1) && (has_ack == 0) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32); // peer answered
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_syn() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Passive-open side receiving the final ACK of the handshake.
  if (state == tcp_state_syn_rcvd()) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_established());
    return 0;
  }

  // Established, a data segment arrives in order: copy the payload
  // out, advance what we expect next, and acknowledge it.
  //
  // BUG (found via audit, 2026-08-27, same shape and same "never
  // actually triggered yet" caveat as socket_udp_recv's identical
  // fix -- see that function's own comment for the full reasoning):
  // payload_len came entirely from the segment's OWN self-reported
  // IPv4 total-length field, untrusted data carried inside the frame
  // being parsed, never checked against recv_len (what netif actually
  // received) or against out_payload's real capacity. A malformed or
  // hostile segment on any real link could drive the copy loop to
  // read past frame's real bounds and write past out_payload's real
  // allocation. Same three-fold guard as socket_udp_recv: reject
  // (don't truncate) a negative length, a declared extent past
  // recv_len, or a payload bigger than the caller's own buffer
  // (max_payload_len, now a required parameter for the same reason).
  // data_offset also gets a sanity floor -- a value under 20 bytes
  // isn't a valid TCP header at all (this stack never sends or
  // expects options, so it should always read exactly 20, but a
  // malformed segment could claim otherwise) and would otherwise let
  // the "payload" start being read from inside the header itself.
  if (state == tcp_state_established()) && (has_psh == 1) && (seg_seq == tcp_conn_get_remote_seq(conn_id)) {
    let tcp_len: i64 = ipv4_get_total_len(frame, 14) as i64 - 20;
    let data_offset: i64 = tcp_get_data_offset_bytes(frame, 34);
    let payload_len: i64 = tcp_len - data_offset;
    if data_offset < 20 {
      return 0 - 1;
    }
    if payload_len < 0 {
      return 0 - 1;
    }
    if (34 + data_offset + payload_len) > recv_len {
      return 0 - 1;
    }
    if payload_len > max_payload_len {
      return 0 - 1;
    }
    let i: i64 = 0;
    while i < payload_len {
      let b: u32 = buf_read_byte(frame, (34 + data_offset + i) as u32);
      let _ = buf_write_byte(out_payload, i as u32, b);
      i = i + 1;
    }
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (payload_len as u32));
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return payload_len;
  }

  // Established, a pure ACK for data we sent. Round 37: if a data
  // retransmission is pending (rtx_deadline != 0) and this ACK covers
  // it (seg_ack has advanced at least to the byte past the pending
  // segment's own last byte), the peer got it -- cancel the timer.
  // rtx_len==0 would mean no data is pending (only a SYN could be,
  // and a SYN's own retransmission is cancelled by the two branches
  // above instead, never here), so this check is naturally a no-op in
  // that case without needing a separate guard.
  if (state == tcp_state_established()) && (has_ack == 1) && (has_fin == 0) && (has_psh == 0) && (has_syn == 0) {
    if tcp_conn_get_rtx_deadline(conn_id) != (0 as u32) {
      let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
      let rtx_len: u32 = tcp_conn_get_rtx_len(conn_id);
      if seg_ack >= (rtx_seq + rtx_len) {
        let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
      }
    }
    return 0;
  }

  // Established, the peer starts closing: this side has nothing more
  // to send either, so it piggybacks its own FIN onto the ACK
  // (a real, legitimate simplified-close shape, not a shortcut this
  // implementation invented) and moves to FIN_WAIT for the final ACK.
  if (state == tcp_state_established()) && (has_fin == 1) {
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // FIN consumes one seq number
    let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack() | tcp_flag_fin(), 65535 as u32, empty_payload, 0);
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // our own FIN
    return 0;
  }

  // The initiating closer receiving the peer's response to its own
  // FIN. BUG (found live, via the self-test's own final ACK never
  // showing up in the loopback queue): the peer's response here is
  // the SAME simplified-close shape this side's own ESTABLISHED/FIN
  // branch above produces when IT'S the one responding to a FIN --
  // a single segment carrying BOTH the ACK of this side's FIN AND the
  // peer's own piggybacked closing FIN, not just a bare ACK. The
  // first version of this branch checked only has_ack and moved
  // straight to CLOSED_FINAL, silently never acknowledging the peer's
  // own FIN bit riding along in that same segment -- the peer was
  // then left waiting forever in FIN_WAIT for an ACK that this side
  // never sends. Fixed: if the peer's FIN bit is ALSO set here, send
  // that ACK before considering the connection closed.
  //
  // Round 72: this used to treat ANY ack while in FIN_WAIT as proof
  // our own FIN was acknowledged -- correct for the normal one-sided
  // close above (the peer was ESTABLISHED, saw our FIN, and its
  // response necessarily acknowledges it), but WRONG for simultaneous
  // close: if the peer independently called tcp_conn_close before
  // ever seeing ours, its FIN+ACK segment acknowledges only whatever
  // it last knew from us, not our FIN specifically. our_fin_acked
  // checks that explicitly (seg_ack must equal our own local_seq,
  // which tcp_conn_close already advanced past our FIN's own sequence
  // number) rather than assuming any ack qualifies.
  if (state == tcp_state_fin_wait()) && (has_ack == 1) {
    let our_fin_acked: i64 = if seg_ack == tcp_conn_get_local_seq(conn_id) { 1 } else { 0 };
    if has_fin == 1 {
      let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
      let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
      let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
      if our_fin_acked == 1 {
        let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final());
      } else {
        // Simultaneous close: the peer's FIN arrived independently,
        // before it had seen ours. We've just ACKed its FIN above;
        // now wait in CLOSING for it to separately ACK ours.
        let _ = tcp_conn_set_state(conn_id, tcp_state_closing());
      }
    } else {
      if our_fin_acked == 1 {
        let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final());
      }
    }
    return 0;
  }

  // Round 72: CLOSING (simultaneous close only reaches this state via
  // the FIN_WAIT branch above) -- we already ACKed the peer's own FIN;
  // this is specifically waiting for the peer's separate ACK of ours.
  if (state == tcp_state_closing()) && (has_ack == 1) && (seg_ack == tcp_conn_get_local_seq(conn_id)) {
    let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final());
    return 0;
  }

  return 0 - 1;
}

// Sends one data segment on an ESTABLISHED connection. local_seq
// advances immediately rather than waiting for the peer's ACK to
// confirm it (this project's own segments are never split/coalesced,
// so there's no reassembly complexity that choice would otherwise
// create). Round 37: also buffers the segment (its starting seq +
// payload bytes) into this connection's own retransmit slot and arms
// the retransmit timer -- tcp_conn_check_retransmit resends it if
// tcp_conn_handle_segment's own "pure ACK" branch never cancels the
// timer in time. payload_len is capped at 64 bytes, tcp_conn_rtx_buf's
// real per-connection capacity (tcp_state.S) -- every real payload
// this project ever sends (tcpecho's own text, capped at 64 bytes by
// the shell command itself) already fits comfortably under that.
//
// Round 72: also refuses to send more than the peer's own
// last-advertised window (tcp_conn_remote_window, updated from every
// incoming segment by tcp_conn_handle_segment) -- "reject, don't
// guess," same posture as every other bounds check in this networking
// layer, rather than sending anyway and hoping the peer buffers it.
// No zero-window probe/retry: a real window of 0 simply means every
// send is refused until a later incoming segment reopens it -- a
// real, honest scope boundary (see this file's own TCP section header
// comment), not silently ignored.
fn tcp_conn_send_data(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64, payload: mut ref i64, payload_len: i64) -> i64 {
  if (payload_len < 0) || (payload_len > (64 as i64)) {
    return 0 - 1;
  }
  if payload_len > (tcp_conn_get_remote_window(conn_id) as i64) {
    return 0 - 1;
  }
  let seq_before: u32 = tcp_conn_get_local_seq(conn_id);
  let status: i64 = tcp_send_segment(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), seq_before, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, payload, payload_len);
  let _ = tcp_conn_set_local_seq(conn_id, seq_before + (payload_len as u32));
  if status == 0 {
    let rtx_buf: mut ref i64 = tcp_conn_get_rtx_buf(conn_id);
    let i: i64 = 0;
    while i < payload_len {
      let b: u32 = buf_read_byte(payload, i as u32);
      let _ = buf_write_byte(rtx_buf, i as u32, b);
      i = i + 1;
    }
    let _ = tcp_conn_set_rtx_seq(conn_id, seq_before);
    let _ = tcp_conn_set_rtx_len(conn_id, payload_len as u32);
    let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
    let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  }
  return status;
}

// Starts closing an ESTABLISHED connection from this side: sends FIN,
// moves to FIN_WAIT. Teardown completes once the caller feeds the
// peer's own FIN+ACK (or separate FIN) back into
// tcp_conn_handle_segment and it in turn produces the final ACK this
// side is waiting for.
fn tcp_conn_close(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64) -> i64 {
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
  let status: i64 = tcp_send_segment(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_fin() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
  let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // FIN consumes one
  let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait());
  return status;
}

// Round 37: fires whenever a connection's own pending retransmission
// (armed by active_open for a SYN, or send_data for a data segment)
// is actually due -- called from tcp_conn_poll on EVERY poll, for
// BOTH connection slots, regardless of whether a frame was even
// dequeued this call. That "regardless" is the whole point: a LOST
// segment produces no frame at all, so nothing else could ever notice
// the silence and react to it. Returns 0 if nothing was due (including
// "nothing pending" -- the common case), 1 if a retransmission was
// just sent, -1 if this connection just gave up (exceeded
// tcp_rtx_max_retries) -- a SYN give-up resets the connection to
// CLOSED (stuck forever in SYN_SENT otherwise); a data give-up leaves
// the connection's own state alone, since ESTABLISHED is still
// otherwise valid and the caller's own bounded poll loop (see
// tcpecho's own shell command) will simply time out waiting for data
// that never arrives, exactly the honest observable outcome for a
// send that truly never got through.
fn tcp_conn_check_retransmit(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64) -> i64 {
  let deadline: u32 = tcp_conn_get_rtx_deadline(conn_id);
  if deadline == (0 as u32) {
    return 0;
  }
  if scheduler_get_tick_count() < deadline {
    return 0;
  }
  let count: u32 = tcp_conn_get_rtx_count(conn_id);
  if count >= tcp_rtx_max_retries() {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    if tcp_conn_get_state(conn_id) == tcp_state_syn_sent() {
      let _ = tcp_conn_set_state(conn_id, tcp_state_closed());
    }
    return 0 - 1;
  }

  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);
  let remote_ip: u32 = tcp_conn_get_remote_ip(conn_id);
  let remote_port: u32 = tcp_conn_get_remote_port(conn_id);
  let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
  let rtx_len: i64 = tcp_conn_get_rtx_len(conn_id) as i64;
  if rtx_len == 0 {
    // Bare-SYN retransmission -- active_open's own SYN never got a
    // reply.
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, 0 as u32, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
  } else {
    // Data-segment retransmission -- send_data's own segment never
    // got acked. Uses the CURRENT remote_seq for the ack field (this
    // side's own view of what it expects next hasn't changed just
    // because a retransmit is happening), same as every other
    // outgoing segment this project builds.
    let rtx_buf: mut ref i64 = tcp_conn_get_rtx_buf(conn_id);
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, rtx_buf, rtx_len);
  }
  let _ = tcp_conn_set_rtx_count(conn_id, count + (1 as u32));
  let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  return 1;
}

// Round 29 (2026-08-24): the live counterpart to tcp_conn_self_test's
// own hand-driven "traffic cop" role. tcp_conn_active_open/
// passive_open/handle_segment/send_data/close have all existed since
// this whole section was written, fully correct and self-tested, but
// -- like ARP resolve before round 26, and DHCP before round 27 --
// never had a single live caller anywhere in this codebase. This is
// the general-purpose piece that makes one possible: dequeues the
// next queued frame and, if it's TCP addressed to either of this
// project's two connection slots (0=client, 1=server -- the same
// fixed pair tcp_conn_self_test already uses), routes it to
// tcp_conn_handle_segment for that connection instead of the
// self-test's own hardcoded "I already know which frame this is"
// sequencing.
//
// Also the live echo-service responder: if the SERVER connection
// (slot 1) just received real data (a positive return from
// handle_segment, not the 0 every control-only segment produces),
// echoes it straight back via tcp_conn_send_data -- the same "answer
// automatically, no caller involvement" shape icmp_poll's own
// auto-responder already established for ping. Returns -2 for that
// case (matching icmp_poll's own "handled a request, not a reply for
// you" convention), -1 for anything not addressed to either
// connection, and otherwise whatever tcp_conn_handle_segment itself
// returned (>=0 on the client side is a genuine received payload --
// the echoed data coming back, from this round's own only live
// caller's point of view).
//
// Same shared-netif-queue concurrency note task_e's own comment
// already makes for DHCP vs. the shell's ping command: the shell's
// new `tcpecho` command below drives several rounds of this poll
// function back to back, entirely synchronously within one
// shell_dispatch() call -- but nothing stops task_e's own periodic
// dhcp_client_poll from being scheduled in between two of those polls
// and dequeuing a TCP frame tcpecho was actually waiting for. A third
// instance of the same already-accepted, not-yet-solved tradeoff,
// not a new one.
fn tcp_conn_poll(my_mac: mut ref i64, out_payload: mut ref i64, max_payload_len: i64) -> i64 {
  // Round 37: checked on every call, for both connection slots,
  // regardless of whether a frame is even queued below -- a lost
  // segment produces no frame at all, so this is the only thing that
  // can ever notice and react to it.
  let _ = tcp_conn_check_retransmit(0 as u32, my_mac, my_mac);
  let _ = tcp_conn_check_retransmit(1 as u32, my_mac, my_mac);

  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, netif_frame_slot_size());
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (6 as u32) {
    return 0 - 1;
  }
  let dst_port: u32 = tcp_get_dst_port(frame, 34);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let target_conn: u32 = client_id;
  let matched: i64 = 0;
  if dst_port == tcp_conn_get_local_port(client_id) {
    target_conn = client_id;
    matched = 1;
  }
  if dst_port == tcp_conn_get_local_port(server_id) {
    target_conn = server_id;
    matched = 1;
  }
  if matched == 0 {
    return 0 - 1;
  }
  let result: i64 = tcp_conn_handle_segment(target_conn, frame, frame_len, my_mac, my_mac, out_payload, max_payload_len);
  if (target_conn == server_id) && (result > 0) {
    let _ = tcp_conn_send_data(server_id, my_mac, my_mac, out_payload, result);
    return 0 - 2;
  }
  return result;
}

// Boot-time self-test: a complete, real connection lifecycle --
// three-way handshake, one data transfer each direction... actually
// one direction (client-to-server) is enough to prove the data path
// end to end -- and a full close, driven entirely by this function
// acting as traffic cop between connection slot 0 (client/active
// open) and slot 1 (server/passive open), exactly as this section's
// own header comment describes.
fn tcp_conn_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let client_ip: u32 = 0xC0A80101 as u32;
  let server_ip: u32 = 0xC0A80102 as u32;
  let client_port: u32 = 54321 as u32;
  let server_port: u32 = 7 as u32;

  let _ = tcp_conn_passive_open(server_id, server_ip, server_port);
  let _ = tcp_conn_active_open(client_id, my_mac, my_mac, client_ip, server_ip, client_port, server_port, 1000 as u32);

  // Handshake: client's SYN -> server; server's SYN-ACK -> client;
  // client's final ACK -> server.
  let scratch: mut ref i64 = dhruva_alloc_bytes(512);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = netif_recv_frame(f1, 64); // client's SYN
  let s1: i64 = tcp_conn_handle_segment(server_id, f1, l1, my_mac, my_mac, scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }

  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = netif_recv_frame(f2, 64); // server's SYN-ACK
  let s2: i64 = tcp_conn_handle_segment(client_id, f2, l2, my_mac, my_mac, scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }

  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = netif_recv_frame(f3, 64); // client's final ACK
  let s3: i64 = tcp_conn_handle_segment(server_id, f3, l3, my_mac, my_mac, scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }

  if tcp_conn_get_state(client_id) != tcp_state_established() { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_established() { ok = 0; }

  // Data transfer: client sends "hi", server receives + ACKs it.
  let payload: mut ref i64 = dhruva_alloc_bytes(2);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32); // 'i'
  let send_status: i64 = tcp_conn_send_data(client_id, my_mac, my_mac, payload, 2);
  if send_status != 0 { ok = 0; }

  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = netif_recv_frame(f4, 64); // client's data segment
  let recv_payload: mut ref i64 = dhruva_alloc_bytes(2);
  let recv_len: i64 = tcp_conn_handle_segment(server_id, f4, l4, my_mac, my_mac, recv_payload, 2);
  if (l4 <= 0) || (recv_len != 2) { ok = 0; }
  if (buf_read_byte(recv_payload, 0 as u32) != (104 as u32)) || (buf_read_byte(recv_payload, 1 as u32) != (105 as u32)) {
    ok = 0;
  }

  let f5: mut ref i64 = dhruva_alloc_bytes(64);
  let l5: i64 = netif_recv_frame(f5, 64); // server's ACK of the data
  let s5: i64 = tcp_conn_handle_segment(client_id, f5, l5, my_mac, my_mac, scratch, 512);
  if (l5 <= 0) || (s5 != 0) { ok = 0; }

  // Close: client sends FIN+ACK; server piggybacks its own FIN onto
  // the ACK; client sends the final ACK.
  let close_status: i64 = tcp_conn_close(client_id, my_mac, my_mac);
  if close_status != 0 { ok = 0; }

  let f6: mut ref i64 = dhruva_alloc_bytes(64);
  let l6: i64 = netif_recv_frame(f6, 64); // client's FIN+ACK
  let s6: i64 = tcp_conn_handle_segment(server_id, f6, l6, my_mac, my_mac, scratch, 512);
  if (l6 <= 0) || (s6 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_fin_wait() { ok = 0; }

  let f7: mut ref i64 = dhruva_alloc_bytes(64);
  let l7: i64 = netif_recv_frame(f7, 64); // server's FIN+ACK (piggybacked)
  let s7: i64 = tcp_conn_handle_segment(client_id, f7, l7, my_mac, my_mac, scratch, 512);
  if (l7 <= 0) || (s7 != 0) { ok = 0; }
  if tcp_conn_get_state(client_id) != tcp_state_closed_final() { ok = 0; }

  let f8: mut ref i64 = dhruva_alloc_bytes(64);
  let l8: i64 = netif_recv_frame(f8, 64); // client's final ACK
  let s8: i64 = tcp_conn_handle_segment(server_id, f8, l8, my_mac, my_mac, scratch, 512);
  if (l8 <= 0) || (s8 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_closed_final() { ok = 0; }

  let _ = uart_puts("TCP: connection lifecycle (handshake + data + close)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for the length-validation fix found by audit
// (2026-08-27, see tcp_conn_handle_segment's own comment): a TCP data
// segment whose IPv4 header claims a length far beyond what was
// actually received must be rejected, not trusted as a copy-loop
// bound. Drives connection slot 0 directly into ESTABLISHED (a
// white-box setup, not a real handshake -- this test targets the
// data-segment length check specifically) and hands it a real, small,
// correctly-queued segment whose IP total-length field has been
// corrupted to claim far more data than that.
fn tcp_conn_recv_bounds_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_id: u32 = 0 as u32;
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;
  let start_seq: u32 = 9000 as u32;

  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, 7 as u32);
  let _ = tcp_conn_set_remote_port(conn_id, 54321 as u32);
  let _ = tcp_conn_set_local_seq(conn_id, 1 as u32);
  let _ = tcp_conn_set_remote_seq(conn_id, start_seq);
  let _ = tcp_conn_set_state(conn_id, tcp_state_established());

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 66 as u32);
  let real_tcp_len: i64 = tcp_build_header(frame, 34, 54321 as u32, 7 as u32, start_seq, 1 as u32, tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, payload, 1, remote_ip, local_ip);
  let real_total_len: i64 = 20 + real_tcp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 6 as u32, remote_ip, local_ip);
  let real_frame_len: i64 = 14 + real_total_len; // 14+20+21 = 55 bytes, actually queued

  // Corrupt ONLY the IPv4 header's own total-length field (the field
  // tcp_conn_handle_segment's payload_len calculation actually reads)
  // to claim far more data than was really sent.
  let _ = buf_write_u16_be(frame, 14 + 2, 60000 as u32);

  let scratch: mut ref i64 = dhruva_alloc_bytes(4);
  let status: i64 = tcp_conn_handle_segment(conn_id, frame, real_frame_len, my_mac, my_mac, scratch, 4);
  if status != (0 - 1) {
    ok = 0;
  }
  // The malformed segment must not have been treated as accepted --
  // remote_seq should be untouched (still start_seq, not advanced).
  if tcp_conn_get_remote_seq(conn_id) != start_seq {
    ok = 0;
  }

  let _ = uart_puts("TCP: handle_segment rejects a length field past what was actually received");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 37: simultaneous open (RFC 793) -- both sides call
// active_open (neither is a passive_open listener), so both start out
// in SYN_SENT and each receives the OTHER's bare SYN instead of a
// SYN-ACK. Real, spec-legitimate TCP behavior, not a shortcut this
// implementation invented -- see tcp_conn_handle_segment's own new
// SYN_SENT+bare-SYN branch. Drives this the same "traffic cop" way
// tcp_conn_self_test already does: dequeue each side's own segment
// via netif_recv_frame, hand it directly to the OTHER side's
// handle_segment, and confirm the whole 4-segment exchange (two bare
// SYNs, two SYN+ACKs) still reaches ESTABLISHED on both sides purely
// through the EXISTING SYN_RCVD-handling machinery plus the one new
// branch -- no other state-machine code needed changing for this.
// Also confirms both sides' SYN retransmission timers (armed by
// active_open) end up cancelled once the peer actually answers,
// rather than still ticking down toward a spurious retransmit.
fn tcp_conn_simultaneous_open_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_a: u32 = 0 as u32;
  let conn_b: u32 = 1 as u32;
  let ip_a: u32 = 0xC0A80103 as u32;
  let ip_b: u32 = 0xC0A80104 as u32;
  let port_a: u32 = 54322 as u32;
  let port_b: u32 = 8 as u32;

  let _ = tcp_conn_active_open(conn_a, my_mac, my_mac, ip_a, ip_b, port_a, port_b, 2000 as u32);
  let _ = tcp_conn_active_open(conn_b, my_mac, my_mac, ip_b, ip_a, port_b, port_a, 9000 as u32);

  if tcp_conn_get_rtx_deadline(conn_a) == (0 as u32) { ok = 0; } // SYN rtx armed
  if tcp_conn_get_rtx_deadline(conn_b) == (0 as u32) { ok = 0; }

  let scratch: mut ref i64 = dhruva_alloc_bytes(512);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = netif_recv_frame(f1, 64); // a's bare SYN
  let s1: i64 = tcp_conn_handle_segment(conn_b, f1, l1, my_mac, my_mac, scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_syn_rcvd() { ok = 0; }

  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = netif_recv_frame(f2, 64); // b's bare SYN
  let s2: i64 = tcp_conn_handle_segment(conn_a, f2, l2, my_mac, my_mac, scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_syn_rcvd() { ok = 0; }

  // Both bare SYNs answered -- neither side should still be waiting to
  // retransmit its own original SYN.
  if tcp_conn_get_rtx_deadline(conn_a) != (0 as u32) { ok = 0; }
  if tcp_conn_get_rtx_deadline(conn_b) != (0 as u32) { ok = 0; }

  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = netif_recv_frame(f3, 64); // b's SYN+ACK (answering a's SYN)
  let s3: i64 = tcp_conn_handle_segment(conn_a, f3, l3, my_mac, my_mac, scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_established() { ok = 0; }

  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = netif_recv_frame(f4, 64); // a's SYN+ACK (answering b's SYN)
  let s4: i64 = tcp_conn_handle_segment(conn_b, f4, l4, my_mac, my_mac, scratch, 512);
  if (l4 <= 0) || (s4 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_established() { ok = 0; }

  let _ = uart_puts("TCP: simultaneous open (both sides active_open) reaches ESTABLISHED");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 72: simultaneous close (RFC 793) -- both sides call
// tcp_conn_close before either has seen the other's FIN, so each
// receives a FIN+ACK that does NOT yet acknowledge its own FIN. Real,
// spec-legitimate TCP behavior, not a shortcut -- see
// tcp_conn_handle_segment's own FIN_WAIT/CLOSING branches. Drives a
// real handshake to ESTABLISHED first (same traffic-cop technique as
// every other TCP self-test here), then has BOTH sides call
// tcp_conn_close back to back before dequeuing anything, so neither
// side has seen the other's FIN when each processes its own incoming
// segment -- the genuine simultaneous case, not a coincidence of
// ordering. Hand-traced exact seq/ack numbers before writing this
// (ISNs 3000/5000, per active_open's argument and passive_open's own
// hardcoded server_isn) to confirm both sides land in CLOSING (not
// straight to CLOSED_FINAL, which would silently mean the
// our-FIN-acked distinction wasn't actually being checked) before
// each's own final ACK arrives.
fn tcp_conn_simultaneous_close_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_a: u32 = 0 as u32;
  let conn_b: u32 = 1 as u32;
  let ip_a: u32 = 0xC0A80105 as u32;
  let ip_b: u32 = 0xC0A80106 as u32;
  let port_a: u32 = 54323 as u32;
  let port_b: u32 = 9 as u32;

  let _ = tcp_conn_passive_open(conn_b, ip_b, port_b);
  let _ = tcp_conn_active_open(conn_a, my_mac, my_mac, ip_a, ip_b, port_a, port_b, 3000 as u32);

  let scratch: mut ref i64 = dhruva_alloc_bytes(512);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = netif_recv_frame(f1, 64); // a's SYN
  let s1: i64 = tcp_conn_handle_segment(conn_b, f1, l1, my_mac, my_mac, scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }

  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = netif_recv_frame(f2, 64); // b's SYN-ACK
  let s2: i64 = tcp_conn_handle_segment(conn_a, f2, l2, my_mac, my_mac, scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }

  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = netif_recv_frame(f3, 64); // a's final ACK
  let s3: i64 = tcp_conn_handle_segment(conn_b, f3, l3, my_mac, my_mac, scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }

  if tcp_conn_get_state(conn_a) != tcp_state_established() { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_established() { ok = 0; }

  // Both sides close back to back, BEFORE either dequeues anything --
  // neither has seen the other's FIN yet at this point.
  let close_a: i64 = tcp_conn_close(conn_a, my_mac, my_mac);
  let close_b: i64 = tcp_conn_close(conn_b, my_mac, my_mac);
  if (close_a != 0) || (close_b != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_fin_wait() { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_fin_wait() { ok = 0; }

  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = netif_recv_frame(f4, 64); // a's FIN+ACK -> b
  let s4: i64 = tcp_conn_handle_segment(conn_b, f4, l4, my_mac, my_mac, scratch, 512);
  if (l4 <= 0) || (s4 != 0) { ok = 0; }
  // b's own FIN was already sent, independently, before b ever saw
  // a's -- the genuine simultaneous case, so b must land in CLOSING,
  // not CLOSED_FINAL, until its own FIN is separately acked.
  if tcp_conn_get_state(conn_b) != tcp_state_closing() { ok = 0; }

  let f5: mut ref i64 = dhruva_alloc_bytes(64);
  let l5: i64 = netif_recv_frame(f5, 64); // b's FIN+ACK -> a
  let s5: i64 = tcp_conn_handle_segment(conn_a, f5, l5, my_mac, my_mac, scratch, 512);
  if (l5 <= 0) || (s5 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_closing() { ok = 0; }

  let f6: mut ref i64 = dhruva_alloc_bytes(64);
  let l6: i64 = netif_recv_frame(f6, 64); // b's ACK of a's FIN (sent from b's own CLOSING transition above)
  let s6: i64 = tcp_conn_handle_segment(conn_a, f6, l6, my_mac, my_mac, scratch, 512);
  if (l6 <= 0) || (s6 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_closed_final() { ok = 0; }

  let f7: mut ref i64 = dhruva_alloc_bytes(64);
  let l7: i64 = netif_recv_frame(f7, 64); // a's ACK of b's FIN (sent from a's own CLOSING transition above)
  let s7: i64 = tcp_conn_handle_segment(conn_b, f7, l7, my_mac, my_mac, scratch, 512);
  if (l7 <= 0) || (s7 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_closed_final() { ok = 0; }

  let _ = uart_puts("TCP: simultaneous close (both sides tcp_conn_close before seeing the peer's FIN) reaches CLOSED_FINAL via CLOSING");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 72: advertised-window enforcement -- tcp_conn_send_data must
// refuse to send more than the peer's own last-advertised window, and
// must track updates (a later segment reopening the window must be
// honored, not just the first value ever seen). White-box connection
// setup (like tcp_conn_recv_bounds_self_test above), since this
// targets tcp_conn_send_data's own check and tcp_conn_handle_segment's
// unconditional window capture directly, not a live handshake.
fn tcp_conn_window_enforcement_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_id: u32 = 0 as u32;
  let local_ip: u32 = 0xC0A80107 as u32;
  let remote_ip: u32 = 0xC0A80108 as u32;

  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, 7 as u32);
  let _ = tcp_conn_set_remote_port(conn_id, 54324 as u32);
  let _ = tcp_conn_set_local_seq(conn_id, 1 as u32);
  let _ = tcp_conn_set_remote_seq(conn_id, 9000 as u32);
  let _ = tcp_conn_set_state(conn_id, tcp_state_established());

  // A synthetic incoming pure-ACK segment advertising a small window
  // (10 bytes) -- tcp_conn_handle_segment's own "established, pure
  // ACK" branch must capture it even though this segment carries no
  // data of its own.
  let empty_payload: mut ref i64 = dhruva_alloc_bytes(1);
  let small_window: u32 = 10 as u32;
  let frame1: mut ref i64 = dhruva_alloc_bytes(64);
  let tcp_len1: i64 = tcp_build_header(frame1, 34, 54324 as u32, 7 as u32, 9000 as u32, 1 as u32, tcp_flag_ack(), small_window, empty_payload, 0, remote_ip, local_ip);
  let total_len1: i64 = 20 + tcp_len1;
  let _ = ipv4_build_header(frame1, 14, total_len1, 6 as u32, remote_ip, local_ip);
  let frame1_len: i64 = 14 + total_len1;
  let scratch: mut ref i64 = dhruva_alloc_bytes(4);
  let seg1_status: i64 = tcp_conn_handle_segment(conn_id, frame1, frame1_len, my_mac, my_mac, scratch, 4);
  if seg1_status != 0 { ok = 0; }
  if tcp_conn_get_remote_window(conn_id) != small_window { ok = 0; }

  // A 20-byte send must now be refused (exceeds the 10-byte window)...
  let payload20: mut ref i64 = dhruva_alloc_bytes(20);
  let big_send: i64 = tcp_conn_send_data(conn_id, my_mac, my_mac, payload20, 20);
  if big_send != (0 - 1) { ok = 0; }

  // ...but a 10-byte send (exactly the window) must still succeed.
  let payload10: mut ref i64 = dhruva_alloc_bytes(10);
  let exact_send: i64 = tcp_conn_send_data(conn_id, my_mac, my_mac, payload10, 10);
  if exact_send != 0 { ok = 0; }
  let drain1: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = netif_recv_frame(drain1, 64); // the segment exact_send just queued

  // The window reopening (a later segment advertising the max again)
  // must be honored too, not just the first value ever seen.
  let max_window: u32 = 65535 as u32;
  let frame2: mut ref i64 = dhruva_alloc_bytes(64);
  let tcp_len2: i64 = tcp_build_header(frame2, 34, 54324 as u32, 7 as u32, 9000 as u32, 1 as u32, tcp_flag_ack(), max_window, empty_payload, 0, remote_ip, local_ip);
  let total_len2: i64 = 20 + tcp_len2;
  let _ = ipv4_build_header(frame2, 14, total_len2, 6 as u32, remote_ip, local_ip);
  let frame2_len: i64 = 14 + total_len2;
  let seg2_status: i64 = tcp_conn_handle_segment(conn_id, frame2, frame2_len, my_mac, my_mac, scratch, 4);
  if seg2_status != 0 { ok = 0; }
  if tcp_conn_get_remote_window(conn_id) != max_window { ok = 0; }

  let reopened_send: i64 = tcp_conn_send_data(conn_id, my_mac, my_mac, payload20, 20);
  if reopened_send != 0 { ok = 0; }
  let drain2: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = netif_recv_frame(drain2, 64); // the segment reopened_send just queued

  let _ = uart_puts("TCP: tcp_conn_send_data enforces the peer's own last-advertised window");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: DHCP (RFC 2131), a minimal client -- DISCOVER ->
// OFFER -> REQUEST -> ACK, sitting on socket_udp_send/udp_send exactly
// like TCP sits on ipv4_build_header, no new transport of its own.
// Only the client side exists (no server): this stack has no need to
// hand out addresses to anyone.
//
// Message layout (RFC 2131 s2, offsets relative to dhcp_offset, the
// start of the UDP payload):
//   0 op(1, 1=BOOTREQUEST/2=BOOTREPLY)  1 htype(1)  2 hlen(1)  3 hops(1)
//   4-7 xid(4)  8-9 secs(2)  10-11 flags(2, 0x8000=broadcast)
//   12-15 ciaddr(4)  16-19 yiaddr(4)  20-23 siaddr(4)  24-27 giaddr(4)
//   28-43 chaddr(16, only the first 6 bytes -- an Ethernet MAC -- ever
//         used here)  44-107 sname(64, unused)  108-235 file(128, unused)
//   236-239 magic cookie (99.130.83.99, fixed)
//   240+ options: TLV (code(1) len(1) data(len)), 0=Pad (no length
//         byte), 255=End. This client only ever sends/reads option 53
//         (DHCP Message Type, 1 byte), 50 (Requested IP Address, 4
//         bytes), and 54 (Server Identifier, 4 bytes) -- the minimum
//         RFC 2131 s4.3.2 requires for the SELECTING->REQUESTING step.
//
// Client ports are fixed by the protocol, not negotiated: 68 (client)
// and 67 (server). DISCOVER/REQUEST always go out from 0.0.0.0 (no
// address yet) to 255.255.255.255 at the Ethernet broadcast address
// (the server's real MAC isn't known until an OFFER names an IP, and
// this client has no ARP-before-we-have-an-IP path anyway) -- exactly
// what RFC 2131 requires before an address is bound, not a loopback-
// only shortcut.
fn dhcp_op_bootrequest() -> u32 { return 1 as u32; }
fn dhcp_op_bootreply() -> u32 { return 2 as u32; }
fn dhcp_htype_ethernet() -> u32 { return 1 as u32; }
fn dhcp_hlen_ethernet() -> u32 { return 6 as u32; }
fn dhcp_msgtype_discover() -> u32 { return 1 as u32; }
fn dhcp_msgtype_offer() -> u32 { return 2 as u32; }
fn dhcp_msgtype_request() -> u32 { return 3 as u32; }
fn dhcp_msgtype_ack() -> u32 { return 5 as u32; }
fn dhcp_msgtype_nak() -> u32 { return 6 as u32; }
fn dhcp_state_init() -> u32 { return 0 as u32; }
fn dhcp_state_selecting() -> u32 { return 1 as u32; }
fn dhcp_state_requesting() -> u32 { return 2 as u32; }
fn dhcp_state_bound() -> u32 { return 3 as u32; }
// Round 22 (2026-08-28): RFC 2131 s4.4's lease lifecycle, past BOUND
// -- RENEWING (unicasting to the original server after T1) and
// REBINDING (broadcasting after T2 if the server never answered the
// unicast attempt). See dhcp_client_check_lease's own comment for
// the full state machine.
fn dhcp_state_renewing() -> u32 { return 4 as u32; }
fn dhcp_state_rebinding() -> u32 { return 5 as u32; }
fn dhcp_client_port() -> u32 { return 68 as u32; }
fn dhcp_server_port() -> u32 { return 67 as u32; }

// Zero-fills buf[offset..offset+count) -- vani has no memset builtin
// (every buffer-clearing loop in this project writes byte by byte;
// see e.g. dharafs_compact's own copy loops), needed here for chaddr's
// padding and the sname/file fields every message carries but this
// client never uses.
// Round 106e: DHCP's own message build/parse ALGORITHM now lives in
// the shared `netstack` package (`netstack_dhcp_*`), operating on a
// standalone `[u8;512]` buffer + `dhcp_offset` -- every real DHCP
// message here is small and fixed-size (256 bytes max), comfortably
// within that cap regardless of this file's own much larger real
// heap frame buffers. Each function below copies its own message
// window into (and, for builders, back out of) a local `[u8;512]`.
fn dhcp_copy_msg_to_local(buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64) -> [u8; 512] {
  let local: [u8; 512] = netstack_zero_frame();
  let i: i64 = 0;
  while i < dhcp_len {
    local[dhcp_offset + i] = buf_read_byte(buf, (dhcp_offset + i) as u32) as u8;
    i = i + 1;
  }
  return local;
}

fn dhcp_copy_msg_from_local(local: ref [u8; 512], buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64) -> i64 {
  let i: i64 = 0;
  while i < dhcp_len {
    let _ = buf_write_byte(buf, (dhcp_offset + i) as u32, local[dhcp_offset + i] as u32);
    i = i + 1;
  }
  return 0;
}

fn dhcp_zero_range(buf: mut ref i64, offset: i64, count: i64) -> i64 {
  let i: i64 = 0;
  while i < count {
    let _ = buf_write_byte(buf, (offset + i) as u32, 0 as u32);
    i = i + 1;
  }
  return 0;
}

fn dhcp_mac_to_local(mac: mut ref i64) -> [u8; 6] {
  return [
    buf_read_byte(mac, 0 as u32) as u8, buf_read_byte(mac, 1 as u32) as u8, buf_read_byte(mac, 2 as u32) as u8,
    buf_read_byte(mac, 3 as u32) as u8, buf_read_byte(mac, 4 as u32) as u8, buf_read_byte(mac, 5 as u32) as u8
  ];
}

fn dhcp_build_fixed_header(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, op: u32, ciaddr: u32, yiaddr: u32, siaddr: u32) -> i64 {
  let mac_arr: [u8; 6] = dhcp_mac_to_local(mac);
  let local: [u8; 512] = netstack_zero_frame();
  let msg_len: i64 = netstack_dhcp_build_fixed_header(mut ref local, dhcp_offset, ref mac_arr, xid, op, ciaddr, yiaddr, siaddr);
  let _ = dhcp_copy_msg_from_local(ref local, buf, dhcp_offset, msg_len);
  return msg_len;
}

fn dhcp_build_discover(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32) -> i64 {
  let mac_arr: [u8; 6] = dhcp_mac_to_local(mac);
  let local: [u8; 512] = netstack_zero_frame();
  let msg_len: i64 = netstack_dhcp_build_discover(mut ref local, dhcp_offset, ref mac_arr, xid);
  let _ = dhcp_copy_msg_from_local(ref local, buf, dhcp_offset, msg_len);
  return msg_len;
}

fn dhcp_build_request(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, requested_ip: u32, server_ip: u32) -> i64 {
  let mac_arr: [u8; 6] = dhcp_mac_to_local(mac);
  let local: [u8; 512] = netstack_zero_frame();
  let msg_len: i64 = netstack_dhcp_build_request(mut ref local, dhcp_offset, ref mac_arr, xid, requested_ip, server_ip);
  let _ = dhcp_copy_msg_from_local(ref local, buf, dhcp_offset, msg_len);
  return msg_len;
}

fn dhcp_build_renew_request(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, ciaddr: u32) -> i64 {
  let mac_arr: [u8; 6] = dhcp_mac_to_local(mac);
  let local: [u8; 512] = netstack_zero_frame();
  let msg_len: i64 = netstack_dhcp_build_renew_request(mut ref local, dhcp_offset, ref mac_arr, xid, ciaddr);
  let _ = dhcp_copy_msg_from_local(ref local, buf, dhcp_offset, msg_len);
  return msg_len;
}

fn dhcp_get_op(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, 1);
  return netstack_dhcp_get_op(ref local, dhcp_offset);
}
fn dhcp_get_xid(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, 8);
  return netstack_dhcp_get_xid(ref local, dhcp_offset);
}
fn dhcp_get_yiaddr(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, 20);
  return netstack_dhcp_get_yiaddr(ref local, dhcp_offset);
}
fn dhcp_get_ciaddr(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, 16);
  return netstack_dhcp_get_ciaddr(ref local, dhcp_offset);
}

fn dhcp_verify_magic_cookie(buf: mut ref i64, dhcp_offset: i64) -> i64 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, 240);
  return netstack_dhcp_verify_magic_cookie(ref local, dhcp_offset);
}

fn dhcp_find_option_byte(buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> i64 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, dhcp_len);
  return netstack_dhcp_find_option_byte(ref local, dhcp_offset, dhcp_len, want_code);
}

fn dhcp_find_option_u32(buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> u32 {
  let local: [u8; 512] = dhcp_copy_msg_to_local(buf, dhcp_offset, dhcp_len);
  return netstack_dhcp_find_option_u32(ref local, dhcp_offset, dhcp_len, want_code);
}

fn dhcp_broadcast_mac(out_mac: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(out_mac, i as u32, 0xFF as u32);
    i = i + 1;
  }
  return 0;
}

// Starts (or restarts) address acquisition: broadcasts a DHCPDISCOVER
// and moves to SELECTING. xid should differ across separate
// acquisition attempts (RFC 2131 uses it to match replies to the
// request that triggered them) -- this driver has no random-number
// source, so callers supply it (a boot-time tick count, a counter,
// anything that varies run to run is fine; the self-test uses a fixed
// constant since it doesn't need uniqueness across multiple real
// attempts).
fn dhcp_client_start(my_mac: mut ref i64, xid: u32) -> i64 {
  let _ = dhcp_state_set_client_state(dhcp_state_selecting());
  let _ = dhcp_state_set_xid(xid);
  let _ = dhcp_state_set_offered_ip(0 as u32);
  let _ = dhcp_state_set_server_ip(0 as u32);
  // Round 22: a stale lease_time from a prior acquisition cycle must
  // not leak into a fresh DISCOVER attempt and arm a renewal timer
  // for an address this client no longer holds.
  let _ = dhcp_state_set_lease_time(0 as u32);
  let _ = dhcp_state_set_lease_start_tick(0 as u32);

  let payload: mut ref i64 = dhcp_payload_scratch_get();
  let payload_len: i64 = dhcp_build_discover(payload, 0, my_mac, xid);
  let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
  let _ = dhcp_broadcast_mac(bcast_mac);
  let no_ip: u32 = 0 as u32;
  let bcast_ip: u32 = 0xFFFFFFFF as u32;
  return udp_send(my_mac, bcast_mac, no_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
}

// Dequeues and processes the next queued frame if it's a DHCP reply
// relevant to this client's current attempt -- advances SELECTING->
// REQUESTING on a matching OFFER (broadcasting a DHCPREQUEST for the
// offered address) and REQUESTING->BOUND on a matching ACK. Any other
// queued traffic (non-IPv4, non-UDP, wrong port, wrong xid, a
// corrupted checksum, a NAK, an OFFER/ACK arriving in a state that
// doesn't expect one) is dequeued and silently ignored -- the same
// "not every queued frame is mine" tolerance socket_udp_recv already
// has, just with DHCP's own state machine and xid check on top
// (mirroring tcp_conn_handle_segment's own "-1 means this didn't
// match anything this state expects" posture). Returns 1 if a state
// transition happened, 0 if a frame was dequeued but irrelevant, -1
// if nothing was queued.
fn dhcp_client_poll(my_mac: mut ref i64) -> i64 {
  // Round 22: the lease-expiry/renewal timer has to fire on its own
  // schedule regardless of whether a frame happens to be queued right
  // now -- checked first, unconditionally, rather than after the
  // early "nothing queued" return below (which used to skip past
  // everything for the exact case -- no traffic -- this check most
  // needs to run in).
  let lease_transition: i64 = dhcp_client_check_lease(my_mac);
  if lease_transition == 1 {
    return 1;
  }

  let frame: mut ref i64 = dhcp_frame_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, netif_frame_slot_size());
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0;
  }
  if ipv4_get_protocol(frame, 14) != (17 as u32) {
    return 0;
  }
  if udp_get_dst_port(frame, 34) != dhcp_client_port() {
    return 0;
  }
  let udp_len: u32 = udp_get_length(frame, 34);
  let dhcp_len: i64 = (udp_len as i64) - 8;
  // Same "reject, don't guess" bounds posture as socket_udp_recv's own
  // fix: a UDP length claiming more than netif actually delivered, or
  // too short to even hold a DHCP message's fixed header, is dropped
  // outright before anything below trusts it.
  if dhcp_len < 240 {
    return 0;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0;
  }
  let src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let dst_ip: u32 = ipv4_get_dst_ip(frame, 14);
  if udp_verify_checksum(src_ip, dst_ip, frame, 34, udp_len as i64) != 1 {
    return 0;
  }
  let dhcp_offset: i64 = 42; // 14 (Ethernet) + 20 (IP) + 8 (UDP)
  if dhcp_verify_magic_cookie(frame, dhcp_offset) != 1 {
    return 0;
  }
  if dhcp_get_op(frame, dhcp_offset) != dhcp_op_bootreply() {
    return 0;
  }
  if dhcp_get_xid(frame, dhcp_offset) != dhcp_state_get_xid() {
    return 0;
  }
  let msg_type: i64 = dhcp_find_option_byte(frame, dhcp_offset, dhcp_len, 53 as u32);
  let client_state: u32 = dhcp_state_get_client_state();

  if (client_state == dhcp_state_selecting()) && (msg_type == (dhcp_msgtype_offer() as i64)) {
    let offered_ip: u32 = dhcp_get_yiaddr(frame, dhcp_offset);
    let server_ip: u32 = dhcp_find_option_u32(frame, dhcp_offset, dhcp_len, 54 as u32);
    if (offered_ip == (0 as u32)) || (server_ip == (0 as u32)) {
      return 0; // malformed offer, missing what's needed to request it
    }
    let _ = dhcp_state_set_offered_ip(offered_ip);
    let _ = dhcp_state_set_server_ip(server_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_requesting());

    let payload: mut ref i64 = dhcp_payload_scratch_get();
    let xid: u32 = dhcp_state_get_xid();
    let payload_len: i64 = dhcp_build_request(payload, 0, my_mac, xid, offered_ip, server_ip);
    let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
    let _ = dhcp_broadcast_mac(bcast_mac);
    let no_ip: u32 = 0 as u32;
    let bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send(my_mac, bcast_mac, no_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    return 1;
  }

  // Round 22: an ACK is expected not just fresh out of REQUESTING but
  // also as the (re)answer to a RENEWING (unicast) or REBINDING
  // (broadcast) lease-renewal attempt -- RFC 2131 s4.4 treats all
  // three the same way, back to BOUND with a refreshed lease.
  let ack_expected: i64 = if (client_state == dhcp_state_requesting()) || (client_state == dhcp_state_renewing()) || (client_state == dhcp_state_rebinding()) { 1 } else { 0 };
  if (ack_expected == 1) && (msg_type == (dhcp_msgtype_ack() as i64)) {
    let leased_ip: u32 = dhcp_get_yiaddr(frame, dhcp_offset);
    if leased_ip == (0 as u32) {
      return 0;
    }
    let _ = dhcp_state_set_leased_ip(leased_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_bound());

    // Round 22: arm (or refresh) the lease-renewal timer from option
    // 51. lease_time staying 0 (the server didn't send option 51) is
    // treated as "no timer armed" -- see dhcp_lease_time's own .bss
    // comment for why that's acceptable rather than a hard error.
    let lease_time: u32 = dhcp_find_option_u32(frame, dhcp_offset, dhcp_len, 51 as u32);
    let _ = dhcp_state_set_lease_time(lease_time);
    let _ = dhcp_state_set_lease_start_tick(scheduler_get_tick_count());

    // Round 22: learn the server's MAC for free from this ACK's own
    // Ethernet source address -- exactly what a real minimal
    // implementation needs to send a later unicast renewal REQUEST
    // without a live ARP round trip (see dhcp_client_check_lease's
    // own comment). Every ACK carries this, not just the very first
    // one, so a RENEWING/REBINDING refresh keeps it current too.
    let server_mac: mut ref i64 = dhcp_server_mac_scratch_get();
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(frame, (6 + mi) as u32);
      let _ = buf_write_byte(server_mac, mi as u32, mb);
      mi = mi + 1;
    }
    let _ = arp_cache_insert(dhcp_state_get_server_ip(), server_mac);

    return 1;
  }

  // BUG (round 10 audit -- a fresh, critical re-read of the DHCP
  // client added last round, specifically requested since it's new,
  // untested-by-a-second-pass code): dhcp_msgtype_nak() was defined
  // but never actually checked anywhere -- a real server can NAK a
  // REQUEST (RFC 2131 s4.3.2: e.g. the offered address became
  // unavailable, or the client's own request was invalid), and this
  // client would have silently ignored it via the catch-all `return 0`
  // below, leaving the state machine stuck in REQUESTING forever with
  // no way to ever reach BOUND again -- a real client MUST handle this
  // per spec, not just the happy-path ACK. Fixed by resetting to INIT
  // (matching RFC 2131 s4.4's guidance to restart the whole process on
  // a NAK) rather than auto-retrying here: this driver has no random-
  // number source and no backoff policy of its own, so -- same
  // "caller decides when" design dhcp_client_start's own xid parameter
  // already uses -- resetting to INIT and leaving it to the caller to
  // call dhcp_client_start again (with a fresh xid) avoids baking in a
  // retry policy this minimal client has no good way to choose itself.
  // Round 22: RFC 2131 s4.4 -- "If the client receives a DHCPNAK
  // message, it cannot reuse its remembered lease and MUST return to
  // INIT," and that applies just as much to a NAK'd RENEWING/
  // REBINDING attempt as to the original REQUESTING one this check
  // already covered.
  let nak_expected: i64 = if (client_state == dhcp_state_requesting()) || (client_state == dhcp_state_renewing()) || (client_state == dhcp_state_rebinding()) { 1 } else { 0 };
  if (nak_expected == 1) && (msg_type == (dhcp_msgtype_nak() as i64)) {
    let _ = dhcp_state_set_client_state(dhcp_state_init());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// RFC 2131 s4.4's lease lifecycle past BOUND, entirely time-driven
// (not frame-driven) -- called unconditionally at the top of every
// dhcp_client_poll, since a lease timeout has nothing to do with
// whether a frame happens to be queued. lease_time == 0 means no
// timer is armed at all (never bound yet this cycle, or the server
// never sent option 51 -- see dhcp_lease_time's own .bss comment).
// All three thresholds (T1, T2, final expiry) are measured as elapsed
// ticks from the SAME lease_start_tick throughout -- per spec, not
// reset at each RENEWING/REBINDING transition. Ticks run at 2/second
// (timer_ic_init's own 500ms compare interval), computed here rather
// than assumed inline so the arithmetic's own units are visible at
// every step: T1 = lease/2, T2 = lease*7/8, both converted from
// seconds to ticks by the same factor.
//
// Deliberately sends at most ONE attempt per threshold (no
// retransmission/backoff while RENEWING) -- matching this client's
// own already-established, deliberate scope everywhere else (neither
// the original DISCOVER nor the original REQUEST retry on their own
// either; a lost renewal attempt is recovered the same way a lost
// DISCOVER always has been, by REBINDING's broadcast fallback or,
// failing that, full re-acquisition from INIT). Returns 1 if a state
// transition happened (matching dhcp_client_poll's own frame-handling
// branches), 0 otherwise.
fn dhcp_client_check_lease(my_mac: mut ref i64) -> i64 {
  let lease_time: u32 = dhcp_state_get_lease_time();
  if lease_time == (0 as u32) {
    return 0;
  }
  let client_state: u32 = dhcp_state_get_client_state();
  if (client_state != dhcp_state_bound()) && (client_state != dhcp_state_renewing()) && (client_state != dhcp_state_rebinding()) {
    return 0;
  }

  let ticks_per_second: i64 = 2;
  let lease_ticks: i64 = (lease_time as i64) * ticks_per_second;
  let t1_ticks: i64 = lease_ticks / 2;
  let t2_ticks: i64 = (lease_ticks * 7) / 8;
  let elapsed_ticks: i64 = (scheduler_get_tick_count() as i64) - (dhcp_state_get_lease_start_tick() as i64);

  if (client_state == dhcp_state_bound()) && (elapsed_ticks >= t1_ticks) {
    // RFC 2131 s4.3.2: renewal is unicast directly to the server that
    // granted the lease. Uses the MAC learned for free from that
    // original ACK's own Ethernet source address (see the ACK-
    // handling branch above) rather than a live ARP round trip --
    // arp_cache_lookup here is a defensive fallback (e.g. an older
    // cache entry evicted by unrelated traffic), not the primary
    // path; a miss here just means this one attempt is skipped, not
    // a hang, since RENEWING's own elapsed-time check above already
    // guarantees forward progress to REBINDING regardless.
    let server_ip: u32 = dhcp_state_get_server_ip();
    let dst_mac: mut ref i64 = dhcp_server_mac_scratch_get();
    if arp_cache_lookup(server_ip, dst_mac) == 1 {
      let payload: mut ref i64 = dhcp_payload_scratch_get();
      let xid: u32 = dhcp_state_get_xid();
      let leased_ip: u32 = dhcp_state_get_leased_ip();
      let payload_len: i64 = dhcp_build_renew_request(payload, 0, my_mac, xid, leased_ip);
      let _ = udp_send(my_mac, dst_mac, leased_ip, server_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    }
    let _ = dhcp_state_set_client_state(dhcp_state_renewing());
    return 1;
  }

  if (client_state == dhcp_state_renewing()) && (elapsed_ticks >= t2_ticks) {
    // RFC 2131 s4.3.2: no answer to the unicast attempt by T2 --
    // broadcast instead, giving ANY server that recognizes this
    // client's lease a chance to renew it, not just the original one.
    let payload: mut ref i64 = dhcp_payload_scratch_get();
    let xid: u32 = dhcp_state_get_xid();
    let leased_ip: u32 = dhcp_state_get_leased_ip();
    let payload_len: i64 = dhcp_build_renew_request(payload, 0, my_mac, xid, leased_ip);
    let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
    let _ = dhcp_broadcast_mac(bcast_mac);
    let bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send(my_mac, bcast_mac, leased_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    let _ = dhcp_state_set_client_state(dhcp_state_rebinding());
    return 1;
  }

  if (client_state == dhcp_state_rebinding()) && (elapsed_ticks >= lease_ticks) {
    // RFC 2131 s4.4: the lease has genuinely expired with no response
    // at all -- give up the address and restart from scratch, same
    // reset shape as a NAK.
    let _ = dhcp_state_set_client_state(dhcp_state_init());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// Boot-time self-test: no real DHCP server exists in this loopback-
// only environment (same reasoning ARP/TCP's own self-tests already
// establish), so this drives the client through a full DISCOVER ->
// OFFER -> REQUEST -> ACK -> BOUND cycle by manually building the
// server's two replies exactly as a real server would and queuing
// them via the real netif -- proving the client's own state machine
// end to end without needing a real second host.
fn dhcp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x12345678 as u32;
  let offered_ip: u32 = 0xC0A80164 as u32; // 192.168.1.100
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  let start_status: i64 = dhcp_client_start(my_mac, xid);
  if start_status != 0 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_selecting() { ok = 0; }

  // Drain the client's own broadcast DISCOVER off the loopback queue
  // and sanity-check it before injecting the synthetic OFFER below.
  let discover_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let discover_len: i64 = netif_recv_frame(discover_frame, 512);
  if discover_len < 240 { ok = 0; }
  if dhcp_get_op(discover_frame, 42) != dhcp_op_bootrequest() { ok = 0; }
  if dhcp_find_option_byte(discover_frame, 42, discover_len - 42, 53 as u32) != (dhcp_msgtype_discover() as i64) { ok = 0; }

  // Build the synthetic DHCPOFFER: fixed header (op=BOOTREPLY,
  // yiaddr=offered_ip, siaddr=server_ip, chaddr echoed back per RFC
  // 2131) plus Message-Type + Server-Identifier options.
  let offer_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(offer_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(offer_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(offer_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(offer_msg, 242 as u32, dhcp_msgtype_offer());
  let _ = buf_write_byte(offer_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(offer_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(offer_msg, 245, server_ip);
  let _ = buf_write_byte(offer_msg, 249 as u32, 255 as u32); // End
  let offer_dhcp_len: i64 = 250;

  let offer_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let oi: i64 = 0;
  while oi < 6 {
    let mb: u32 = buf_read_byte(my_mac, oi as u32);
    let _ = buf_write_byte(offer_frame, oi as u32, mb); // dst: us
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 6 {
    let _ = buf_write_byte(offer_frame, (6 + oj) as u32, 0xAA as u32); // src: arbitrary "server" MAC
    oj = oj + 1;
  }
  let _ = buf_write_u16_be(offer_frame, 12, 0x0800 as u32);
  let offer_udp_len: i64 = udp_build(offer_frame, 34, dhcp_server_port(), dhcp_client_port(), offer_msg, offer_dhcp_len, server_ip, bcast_ip);
  let offer_total_len: i64 = 20 + offer_udp_len;
  let _ = ipv4_build_header(offer_frame, 14, offer_total_len, 17 as u32, server_ip, bcast_ip);
  let offer_frame_len: i64 = 14 + offer_total_len;

  let send_status1: i64 = netif_send_frame(offer_frame, offer_frame_len);
  if send_status1 != 0 { ok = 0; }

  let poll1: i64 = dhcp_client_poll(my_mac);
  if poll1 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_requesting() { ok = 0; }
  if dhcp_state_get_offered_ip() != offered_ip { ok = 0; }
  if dhcp_state_get_server_ip() != server_ip { ok = 0; }

  // Drain the client's own broadcast DHCPREQUEST (triggered by the
  // OFFER above) and confirm it correctly echoed the offered address
  // and chosen server back per RFC 2131 s4.3.2.
  let request_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let request_len: i64 = netif_recv_frame(request_frame, 512);
  if request_len < 240 { ok = 0; }
  if dhcp_find_option_byte(request_frame, 42, request_len - 42, 53 as u32) != (dhcp_msgtype_request() as i64) { ok = 0; }
  if dhcp_find_option_u32(request_frame, 42, request_len - 42, 50 as u32) != offered_ip { ok = 0; }
  if dhcp_find_option_u32(request_frame, 42, request_len - 42, 54 as u32) != server_ip { ok = 0; }

  // Build and queue the synthetic DHCPACK.
  let ack_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(ack_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(ack_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(ack_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(ack_msg, 242 as u32, dhcp_msgtype_ack());
  let _ = buf_write_byte(ack_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(ack_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(ack_msg, 245, server_ip);
  let _ = buf_write_byte(ack_msg, 249 as u32, 255 as u32); // End
  let ack_dhcp_len: i64 = 250;

  let ack_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let ai: i64 = 0;
  while ai < 6 {
    let mb2: u32 = buf_read_byte(my_mac, ai as u32);
    let _ = buf_write_byte(ack_frame, ai as u32, mb2);
    ai = ai + 1;
  }
  let aj: i64 = 0;
  while aj < 6 {
    let _ = buf_write_byte(ack_frame, (6 + aj) as u32, 0xAA as u32);
    aj = aj + 1;
  }
  let _ = buf_write_u16_be(ack_frame, 12, 0x0800 as u32);
  let ack_udp_len: i64 = udp_build(ack_frame, 34, dhcp_server_port(), dhcp_client_port(), ack_msg, ack_dhcp_len, server_ip, bcast_ip);
  let ack_total_len: i64 = 20 + ack_udp_len;
  let _ = ipv4_build_header(ack_frame, 14, ack_total_len, 17 as u32, server_ip, bcast_ip);
  let ack_frame_len: i64 = 14 + ack_total_len;

  let send_status2: i64 = netif_send_frame(ack_frame, ack_frame_len);
  if send_status2 != 0 { ok = 0; }

  let poll2: i64 = dhcp_client_poll(my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }
  if dhcp_state_get_leased_ip() != offered_ip { ok = 0; }

  let _ = uart_puts("DHCP: client DISCOVER->OFFER->REQUEST->ACK->BOUND");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 22 audit, 2026-08-28: exercises dhcp_client_check_lease's
// whole state machine (BOUND -T1-> RENEWING -T2-> REBINDING, plus a
// refresh ACK and full expiry) -- the RFC 2131 s4.4 lease lifecycle
// dhcp_self_test above never reaches, since it only ever proves the
// initial acquisition handshake. Starts directly from an
// already-BOUND precondition (set up via the same state-setter
// accessors dhcp_client_poll itself uses) rather than replaying that
// whole handshake again -- dhcp_self_test already independently
// covers it, matching arp_resolve_self_test's own "each self-test
// proves its own concern" reasoning from earlier this round.
//
// Backdates lease_start_tick directly to simulate each threshold
// having elapsed, rather than waiting real wall-clock time for real
// ticks (a boot self-test cannot afford to actually wait out even an
// 8-second lease, let alone a realistic one) -- this project's own
// established way of staging an otherwise-unstageable timing
// condition without adding any test-only mutation of real system
// time (see e.g. sdcard_state.S's TEST-ONLY buffer-pattern helpers
// for the same spirit applied to a different layer). Uses a
// lease_time (8 seconds) chosen specifically so every threshold's
// integer tick math divides evenly at this project's fixed 2-ticks/
// second rate, avoiding any rounding-driven off-by-one between this
// test's own expectations and dhcp_client_check_lease's actual
// arithmetic.
fn dhcp_renewal_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x22334455 as u32;
  let leased_ip: u32 = 0xC0A80165 as u32; // 192.168.1.101
  let server_ip: u32 = 0xC0A80110 as u32; // 192.168.1.16 -- distinct from every other self-test's IPs, avoids any ARP-cache cross-talk
  let lease_time: u32 = 8 as u32; // seconds
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  // Round 22: a known, fixed tick_count baseline -- rather than
  // reading whatever scheduler_get_tick_count() happens to already be
  // this early in boot (plausibly still 0 or 1, since timer_ic_init's
  // very first compare match is 500ms out and self-tests run well
  // before that elapses) and then trying to backdate FROM it via
  // subtraction. Subtracting an assumed margin from a small,
  // uncertain u32 tick_count is exactly the kind of underflow this
  // project's own inconsistent overflow trap has hit for real before
  // (round 2's eval_apply finding) -- this test hung outright the
  // first time it was written that way. Safe to set directly: see
  // scheduler_set_tick_count_test_only's own comment for why (no task
  // exists yet, IRQs stay masked through all of kernel_main's setup).
  // Every threshold below is reached by advancing tick_count FORWARD
  // from this fixed baseline, never by subtracting.
  let baseline_tick: u32 = 1000 as u32;
  let _ = scheduler_set_tick_count_test_only(baseline_tick);

  let _ = dhcp_state_set_client_state(dhcp_state_bound());
  let _ = dhcp_state_set_xid(xid);
  let _ = dhcp_state_set_leased_ip(leased_ip);
  let _ = dhcp_state_set_server_ip(server_ip);
  let _ = dhcp_state_set_lease_time(lease_time);
  let _ = dhcp_state_set_lease_start_tick(baseline_tick);
  let server_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let smi: i64 = 0;
  while smi < 6 {
    let _ = buf_write_byte(server_mac, smi as u32, 0xBB as u32);
    smi = smi + 1;
  }
  let _ = arp_cache_insert(server_ip, server_mac);

  // A fresh lease (elapsed=0) must not renew early.
  let too_early: i64 = dhcp_client_check_lease(my_mac);
  if too_early != 0 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }

  // Simulate T1 (lease_time/2 seconds = lease_time ticks at this
  // project's 2-ticks/second rate) having elapsed.
  let _ = scheduler_set_tick_count_test_only(baseline_tick + lease_time + (1 as u32));
  let renew_transition: i64 = dhcp_client_check_lease(my_mac);
  if renew_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_renewing() { ok = 0; }

  // The renewal REQUEST must go out UNICAST to the server's learned
  // MAC (not broadcast), with ciaddr set and options 50/54 both
  // absent, per RFC 2131 s4.3.2.
  let renew_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let renew_len: i64 = netif_recv_frame(renew_frame, 512);
  if renew_len < 240 { ok = 0; }
  let rmi: i64 = 0;
  while rmi < 6 {
    if buf_read_byte(renew_frame, rmi as u32) != (0xBB as u32) { ok = 0; }
    rmi = rmi + 1;
  }
  if dhcp_find_option_byte(renew_frame, 42, renew_len - 42, 53 as u32) != (dhcp_msgtype_request() as i64) { ok = 0; }
  if dhcp_find_option_u32(renew_frame, 42, renew_len - 42, 50 as u32) != (0 as u32) { ok = 0; }
  if dhcp_get_ciaddr(renew_frame, 42) != leased_ip { ok = 0; }

  // Simulate T2 (lease_time*7/8 seconds = lease_time*7/4 ticks) too --
  // measured from the SAME baseline_tick lease_start_tick was set to
  // above (never reset until a fresh ACK arrives, matching real
  // RFC 2131 semantics), so this advances tick_count further forward
  // from baseline_tick, not from wherever the T1 check left it.
  let t2_ticks_test: u32 = ((lease_time as u32) * (7 as u32)) / (4 as u32);
  let _ = scheduler_set_tick_count_test_only(baseline_tick + t2_ticks_test + (1 as u32));
  let rebind_transition: i64 = dhcp_client_check_lease(my_mac);
  if rebind_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_rebinding() { ok = 0; }

  let rebind_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let rebind_len: i64 = netif_recv_frame(rebind_frame, 512);
  if rebind_len < 240 { ok = 0; }
  let rbi: i64 = 0;
  while rbi < 6 {
    if buf_read_byte(rebind_frame, rbi as u32) != (0xFF as u32) { ok = 0; } // dst: broadcast this time
    rbi = rbi + 1;
  }

  // A real ACK arriving while REBINDING must refresh the lease back
  // to BOUND -- same handling as the original REQUESTING->BOUND
  // transition, just reached via REBINDING this time.
  let ack2_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(ack2_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, leased_ip, server_ip);
  let _ = buf_write_byte(ack2_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(ack2_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(ack2_msg, 242 as u32, dhcp_msgtype_ack());
  let _ = buf_write_byte(ack2_msg, 243 as u32, 51 as u32);
  let _ = buf_write_byte(ack2_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(ack2_msg, 245, lease_time);
  let _ = buf_write_byte(ack2_msg, 249 as u32, 255 as u32); // End
  let ack2_dhcp_len: i64 = 250;

  let ack2_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let a2i: i64 = 0;
  while a2i < 6 {
    let mb3: u32 = buf_read_byte(my_mac, a2i as u32);
    let _ = buf_write_byte(ack2_frame, a2i as u32, mb3);
    a2i = a2i + 1;
  }
  let a2j: i64 = 0;
  while a2j < 6 {
    let _ = buf_write_byte(ack2_frame, (6 + a2j) as u32, 0xBB as u32); // src: same server MAC
    a2j = a2j + 1;
  }
  let _ = buf_write_u16_be(ack2_frame, 12, 0x0800 as u32);
  let ack2_udp_len: i64 = udp_build(ack2_frame, 34, dhcp_server_port(), dhcp_client_port(), ack2_msg, ack2_dhcp_len, server_ip, bcast_ip);
  let ack2_total_len: i64 = 20 + ack2_udp_len;
  let _ = ipv4_build_header(ack2_frame, 14, ack2_total_len, 17 as u32, server_ip, bcast_ip);
  let ack2_frame_len: i64 = 14 + ack2_total_len;
  let send_status3: i64 = netif_send_frame(ack2_frame, ack2_frame_len);
  if send_status3 != 0 { ok = 0; }

  let poll3: i64 = dhcp_client_poll(my_mac);
  if poll3 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }
  if dhcp_state_get_lease_time() != lease_time { ok = 0; }

  // Finally: full expiry with no response at all while REBINDING must
  // give up the address, matching a NAK's own reset shape. The
  // refresh ACK above just reset lease_start_tick to whatever
  // tick_count was at that moment (dhcp_client_poll's own ACK-
  // handling branch) -- read it back and advance FORWARD from there
  // (safe: addition, never subtraction) rather than assuming its
  // value.
  let _ = dhcp_state_set_client_state(dhcp_state_rebinding());
  let lease_ticks_test: u32 = (lease_time as u32) * (2 as u32);
  let refreshed_start: u32 = dhcp_state_get_lease_start_tick();
  let _ = scheduler_set_tick_count_test_only(refreshed_start + lease_ticks_test + (1 as u32));
  let expiry_transition: i64 = dhcp_client_check_lease(my_mac);
  if expiry_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_init() { ok = 0; }
  if dhcp_state_get_leased_ip() != (0 as u32) { ok = 0; }

  let _ = uart_puts("DHCP: lease renewal (BOUND->RENEWING unicast->REBINDING broadcast->refresh/expiry)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 10's NAK-handling fix (see
// dhcp_client_poll's own comment): drives the client to REQUESTING
// exactly like dhcp_self_test above, then replies with a synthetic
// DHCPNAK instead of an ACK, confirming the client resets to INIT
// (rather than getting stuck in REQUESTING forever, which is what it
// did before this fix -- a NAK fell through to the catch-all ignore
// path with nothing checking for it).
fn dhcp_nak_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x87654321 as u32;
  let offered_ip: u32 = 0xC0A80165 as u32; // 192.168.1.101
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  let start_status: i64 = dhcp_client_start(my_mac, xid);
  if start_status != 0 { ok = 0; }

  let discover_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = netif_recv_frame(discover_frame, 512); // drain our own DISCOVER

  let offer_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(offer_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(offer_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(offer_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(offer_msg, 242 as u32, dhcp_msgtype_offer());
  let _ = buf_write_byte(offer_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(offer_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(offer_msg, 245, server_ip);
  let _ = buf_write_byte(offer_msg, 249 as u32, 255 as u32);
  let offer_dhcp_len: i64 = 250;

  let offer_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let oi: i64 = 0;
  while oi < 6 {
    let mb: u32 = buf_read_byte(my_mac, oi as u32);
    let _ = buf_write_byte(offer_frame, oi as u32, mb);
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 6 {
    let _ = buf_write_byte(offer_frame, (6 + oj) as u32, 0xAA as u32);
    oj = oj + 1;
  }
  let _ = buf_write_u16_be(offer_frame, 12, 0x0800 as u32);
  let offer_udp_len: i64 = udp_build(offer_frame, 34, dhcp_server_port(), dhcp_client_port(), offer_msg, offer_dhcp_len, server_ip, bcast_ip);
  let offer_total_len: i64 = 20 + offer_udp_len;
  let _ = ipv4_build_header(offer_frame, 14, offer_total_len, 17 as u32, server_ip, bcast_ip);
  let offer_frame_len: i64 = 14 + offer_total_len;
  let _ = netif_send_frame(offer_frame, offer_frame_len);

  let poll1: i64 = dhcp_client_poll(my_mac);
  if poll1 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_requesting() { ok = 0; }

  let request_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = netif_recv_frame(request_frame, 512); // drain our own REQUEST

  // Build and queue a synthetic DHCPNAK -- no yiaddr/siaddr per RFC
  // 2131 s4.3.2 (a NAK carries no offered address, unlike OFFER/ACK).
  let nak_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(nak_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, 0 as u32, 0 as u32);
  let _ = buf_write_byte(nak_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(nak_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(nak_msg, 242 as u32, dhcp_msgtype_nak());
  let _ = buf_write_byte(nak_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(nak_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(nak_msg, 245, server_ip);
  let _ = buf_write_byte(nak_msg, 249 as u32, 255 as u32);
  let nak_dhcp_len: i64 = 250;

  let nak_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let ni: i64 = 0;
  while ni < 6 {
    let mb3: u32 = buf_read_byte(my_mac, ni as u32);
    let _ = buf_write_byte(nak_frame, ni as u32, mb3);
    ni = ni + 1;
  }
  let nj: i64 = 0;
  while nj < 6 {
    let _ = buf_write_byte(nak_frame, (6 + nj) as u32, 0xAA as u32);
    nj = nj + 1;
  }
  let _ = buf_write_u16_be(nak_frame, 12, 0x0800 as u32);
  let nak_udp_len: i64 = udp_build(nak_frame, 34, dhcp_server_port(), dhcp_client_port(), nak_msg, nak_dhcp_len, server_ip, bcast_ip);
  let nak_total_len: i64 = 20 + nak_udp_len;
  let _ = ipv4_build_header(nak_frame, 14, nak_total_len, 17 as u32, server_ip, bcast_ip);
  let nak_frame_len: i64 = 14 + nak_total_len;

  let send_status: i64 = netif_send_frame(nak_frame, nak_frame_len);
  if send_status != 0 { ok = 0; }

  let poll2: i64 = dhcp_client_poll(my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_init() { ok = 0; }

  let _ = uart_puts("DHCP: client resets to INIT on a DHCPNAK");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 32: closes the feature ledger's last open item -- a permanent
// regression test for the shared-netif-queue hazard task_e's own
// comment has documented (and named more live consumers of, rounds
// 27/29/30) since round 27, but that was only ever documented, never
// actually exercised by a test. netif_recv_frame (see its own
// comment) unconditionally dequeues the OLDEST queued frame regardless
// of what the caller actually wants -- every *_poll/*_recv function
// relies on that, checking the frame's own type only AFTER dequeuing
// it, and silently dropping (not requeuing) a mismatch. That's the
// real mechanism behind the live hazard: task_e's periodic
// dhcp_client_poll and the shell's ping/tcpecho/udpecho are
// independently-scheduled concurrent consumers of that same queue, so
// whichever one happens to poll next can steal-and-drop a frame a
// different one was actually waiting for.
//
// Reproducing the live timing-dependent version directly would need
// real preemption luck (and DHCP never receives anything live under
// this project's loopback-only QEMU netif to even compete over -- see
// dhcp_client_poll's own "never actually binds" note). Instead this
// proves the underlying MECHANISM deterministically, with no timing
// dependency at all: queue a real ICMP echo request first, a real UDP
// datagram second (both self-to-self over loopback, reusing the exact
// same already-proven send paths icmp_self_test/udp_self_test/
// icmp_poll/socket_udp_recv individually rely on), then deliberately
// poll for UDP before ICMP. socket_udp_recv dequeues the OLDEST frame
// (the ICMP one), rejects it (protocol != 17), and drops it --
// icmp_poll then dequeues the only frame left (the UDP one), rejects
// it too (protocol != 1), and drops that as well. Neither caller ever
// sees the frame it was actually waiting for, even though both were
// valid and genuinely queued -- exactly the failure mode task_e's
// comment describes, reproduced without needing any specific
// interleaving to get lucky on.
fn netif_queue_contention_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1

  // Drain any leftover queue state from earlier self-tests so the two
  // enqueues below land in a known, empty queue.
  let drain: mut ref i64 = dhruva_alloc_bytes(512);
  let drain_iter: i64 = 0;
  while (drain_iter < 8) && (netif_recv_frame(drain, 512) >= 0) {
    drain_iter = drain_iter + 1;
  }

  // Frame 1, queued first (so it's the oldest -- dequeued first):
  // a real ICMP echo request.
  let icmp_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(icmp_payload, 0 as u32, 104 as u32); // 'h'
  let send1: i64 = icmp_ping_start(my_mac, my_mac, loop_ip, loop_ip, 4242 as u32, 1 as u32, icmp_payload, 1);
  if send1 != 0 {
    ok = 0;
  }

  // Frame 2, queued second: a real UDP datagram. socket_udp_send
  // needs an ARP-cache hit (round 21) -- same self-insert precedent
  // udp_self_test/udpecho already established.
  let _ = arp_cache_insert(loop_ip, my_mac);
  let udp_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(udp_payload, 0 as u32, 117 as u32); // 'u'
  let send2: i64 = socket_udp_send(my_mac, loop_ip, loop_ip, 54399 as u32, 54398 as u32, udp_payload, 1);
  if send2 != 0 {
    ok = 0;
  }
  if netif_get_count() != 2 {
    ok = 0; // exactly one frame per send call -- both queued, neither
             // dequeued yet
  }

  // Poll for UDP FIRST, even though the ICMP frame is queued ahead of
  // it -- proves the steal: socket_udp_recv dequeues the oldest frame
  // (ICMP, protocol 1 != 17), rejects it, and drops it. Its own real
  // UDP datagram is still queued behind, unseen by this call.
  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let udp_result: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if udp_result != (0 - 1) {
    ok = 0; // if this ever starts succeeding, the queue got demuxed
             // by something else -- worth re-examining this test, not
             // silently trusting a changed assumption.
  }

  // Now poll for ICMP -- but its frame was already stolen-and-dropped
  // above. Only the UDP frame is left; icmp_poll rejects (protocol 17
  // != 1) and drops that one too.
  let icmp_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let icmp_result: i64 = icmp_poll(my_mac, loop_ip, recv_payload, 4, icmp_meta);
  if icmp_result != (0 - 1) {
    ok = 0;
  }

  // Both frames are now gone -- neither caller ever got the one it
  // was actually waiting for. This is the hazard, reproduced.
  if netif_get_count() != 0 {
    ok = 0;
  }

  let _ = uart_puts("NETIF: shared-queue contention hazard reproduced as documented");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: DWC2 USB host controller bring-up (BCM2835's real
// on-chip USB silicon -- the Pi 1 Model B has no native Ethernet, so
// DHRUVA_ARCHITECTURE.md's whole "real networking" path runs through
// this chip via a USB-attached LAN9512/WiFi/BLE device). Base address
// 0x20980000 and GPU IRQ 9 confirmed directly against QEMU's own
// hw/arm/bcm2835_peripherals.c (USB_OTG_OFFSET=0x980000) and
// include/hw/arm/raspi_platform.h (INTERRUPT_USB=9), not assumed from
// the datasheet alone -- same discipline as every other BCM2835
// peripheral this project has brought up. Register-level behavior
// (which bits are real vs. logged-only no-ops) confirmed against
// QEMU's own hw/usb/hcd-dwc2.c, since a byte-correct driver against
// the datasheet can still hang forever against an emulation that
// doesn't implement everything the datasheet promises (matching
// task #3's SD driver "checked byte-correct and still didn't work"
// lesson) -- specifically:
//   - GRSTCTL (core/host soft reset, FIFO flush) is entirely
//     logged-only in this model; writing it does nothing real, so
//     init here does not wait on or depend on any GRSTCTL self-clear
//     beyond what the register read path already strips immediately.
//   - HPRT0's ENA bit cannot be set directly by writing it -- only a
//     RST=1-then-0 transition while a device is attached makes the
//     model itself set ENA+ENACHG. This is not a polling race to
//     tune; the model's own dwc2_hprt_write only performs that
//     transition-triggered enable exactly once, synchronously.
//   - FIFO/slave-mode transfers are entirely unimplemented (dead
//     no-op registers) in this model -- DMA mode via HCDMA is the
//     only working data path here, so this driver is DMA-only by
//     necessity, not by choice (real hardware supports both, but a
//     driver written for slave mode would never work under this
//     specific QEMU model).
fn dwc2_base() -> i64 {
  return 0x20980000;
}

// GSNPSID (Synopsys ID register, offset 0x40) -- a fixed silicon ID
// QEMU's model reports as a reset-default constant (0x4f54294a). Used
// here purely as a sanity check that MMIO to this address range
// reaches the DWC2 model at all, the same role dharafs_init's checksum
// check or the SD driver's SDHSTS checks play elsewhere: confirm the
// hardware is really there and responding before trusting anything
// else it reports.
fn dwc2_read_gsnpsid() -> u32 {
  return mmio_read_u32(dwc2_base() + 0x40);
}

// GAHBCFG bit 0 (GLBL_INTR_EN) -- confirmed against hcd-dwc2.c as the
// one bit this model actually gates its IRQ line on (GINTSTS &
// GINTMSK must also be nonzero, but without this bit set the line
// never asserts regardless). This driver polls registers directly
// rather than using the IRQ line for now, but the bit is set anyway
// to match what a real controller expects during bring-up and to
// leave room for a real interrupt-driven path later without an init
// order change.
fn dwc2_enable_global_intr() -> i64 {
  let gahbcfg: i64 = dwc2_base() + 0x08;
  let v: u32 = mmio_read_u32(gahbcfg);
  let _ = mmio_write_u32(gahbcfg, v | (1 as u32));
  return 0;
}

// HPRT0 (offset 0x440) bit layout confirmed against hcd-dwc2.c:
// CONNSTS=bit0 (RO), CONNDET=bit1 (W1C), ENA=bit2 (RO, self-setting
// only), ENACHG=bit3 (W1C), RST=bit8, PWR=bit12, LNSTS=bits[11:10]
// (RO), SPD=bits[18:17] (RO: 0=high,1=full,2=low).
fn dwc2_hprt0_addr() -> i64 {
  return dwc2_base() + 0x440;
}

fn dwc2_port_connected() -> i64 {
  let v: u32 = mmio_read_u32(dwc2_hprt0_addr());
  if (v & (1 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

fn dwc2_port_enabled() -> i64 {
  let v: u32 = mmio_read_u32(dwc2_hprt0_addr());
  if (v & (4 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

// Resets the root port -- the RST=1-then-0 transition is what the
// model actually keys off of (see this section's header comment): it
// synchronously sets ENA+ENACHG itself once a device is attached, so
// there's no separate "wait for enable" poll loop needed here, only a
// bounded settle delay around the transition itself (matching every
// other bounded-not-unbounded wait already established in this
// project's own hard-RT-adjacent code, even though this path isn't
// itself hard-RT). CONNDET/ENACHG are write-1-to-clear status bits --
// cleared explicitly afterward so a later poll can distinguish a NEW
// event from this reset's own leftover flags.
// HPRT0's write-1-to-clear group is FOUR bits, not the three a naive
// reading of the Synopsys databook's "status" vs "control" column
// split might suggest: CONNDET(1), ENA(2), ENACHG(3), OVRCURRCHG(5) --
// confirmed directly against hcd-dwc2.c's dwc2_hreg0_write, which
// applies the exact same old-AND-NOT-written clear transform to all
// four uniformly. ENA looking like a plain RO/self-set status bit
// (true for how it gets SET -- only the model itself can set it, not
// a direct write) is a trap: it can still be WRITTEN BACK TO ZERO by
// including its own current "1" in a later write, since this group's
// write semantics are "write 1 clears, write 0 preserves" regardless
// of which bit. Every write to this register must therefore always
// force this whole 4-bit group to 0 in the value being constructed,
// then OR in only the specific bit(s) actually meant to be cleared
// THIS write -- never carry a freshly-read 1 in any of these four
// bit positions into a subsequent write, or it silently un-sets
// whatever that bit was reporting (this cost one full extra debug
// round-trip to catch: the very first pass here wrote back a freshly-
// read ENA=1 while only intending to clear two unrelated bits, and
// silently turned ENA back off in the same instruction).
fn dwc2_hprt0_w1c_group_mask() -> u32 {
  return 0x2E as u32; // bits 1,2,3,5: CONNDET,ENA,ENACHG,OVRCURRCHG
}

// AUDITED (round 17, 2026-08-28) -- this function's own read/write/
// read/write/read/write sequence against HPRT0, and the read/write
// sequence dwc2_init() runs against GSNPSID/GAHBCFG/HPRT0 on the way
// in, do NOT need a memory barrier (context_switch.S's mem_barrier,
// added round 16 for a genuinely different problem -- see that
// function's own comment). Checked directly against the same
// Broadcom BCM2835 guidance round 16 already cited: "accesses to the
// same peripheral will always arrive and return in-order... it is
// only when switching from one peripheral to another that data can
// arrive out-of-order." GSNPSID, GAHBCFG, and HPRT0 are all registers
// of the one DWC2 IP block at base 0x20980000 -- dwc2_init never
// switches to a different peripheral anywhere on this path, so the
// out-of-order risk that guidance describes doesn't apply here. This
// closes the "HPRT0 reset sequence" half of the open question round
// 16's own mem_barrier comment flagged for a future round.
fn dwc2_port_reset() -> i64 {
  let hprt0: i64 = dwc2_hprt0_addr();
  let w1c_mask: u32 = dwc2_hprt0_w1c_group_mask();

  let not_w1c_mask: u32 = w1c_mask ^ (0xFFFFFFFF as u32);

  // Set RST=1, forcing the w1c group to 0 (preserve, clear nothing).
  let v: u32 = mmio_read_u32(hprt0);
  let _ = mmio_write_u32(hprt0, (v & not_w1c_mask) | (0x100 as u32));
  let _ = delay(50000);

  // Deassert RST, again forcing the w1c group to 0 in the WRITE value
  // -- the model's own RST-transition handler sets ENA+ENACHG itself
  // (unconditionally overriding whatever this write says for those
  // two bits), so there's nothing to OR in here at all.
  let v2: u32 = mmio_read_u32(hprt0);
  let clear_rst: u32 = (0x100 as u32) ^ (0xFFFFFFFF as u32);
  let _ = mmio_write_u32(hprt0, v2 & clear_rst & not_w1c_mask);
  let _ = delay(50000);

  // Acknowledge CONNDET+ENACHG (write 1 to clear just those two),
  // forcing ENA's own bit position to 0 in this write so its current
  // 1 value is PRESERVED, not cleared.
  let v3: u32 = mmio_read_u32(hprt0);
  let ack_bits: u32 = (0x2 as u32) | (0x8 as u32); // CONNDET | ENACHG
  let _ = mmio_write_u32(hprt0, (v3 & not_w1c_mask) | ack_bits);
  return 0;
}

// Brings the controller up far enough to detect and reset an attached
// device's port -- deliberately NOT yet a full enumeration (no
// control transfer, no descriptor read): this is the first verifiable
// slice, matching this project's own "verify each increment under
// QEMU before adding the next" discipline used for every prior
// peripheral. Real hardware value: FALSE for "silicon responds and
// port reaches ENABLED with a device attached", used by the self-test
// below to report pass/fail without the caller needing to inspect
// raw register values.
fn dwc2_init() -> i64 {
  let id: u32 = dwc2_read_gsnpsid();
  let _ = uart_puts("USB: GSNPSID=");
  let _ = uart_put_hex32(id);
  let _ = uart_puts("\n");

  let _ = dwc2_enable_global_intr();

  let connected: i64 = dwc2_port_connected();
  let _ = uart_puts("USB: port connected=");
  let _ = uart_put_hex32(connected as u32);
  let _ = uart_puts("\n");

  if connected == 0 {
    return 0 - 1;
  }

  let _ = dwc2_port_reset();
  let enabled: i64 = dwc2_port_enabled();
  let _ = uart_puts("USB: port enabled after reset=");
  let _ = uart_put_hex32(enabled as u32);
  let _ = uart_puts("\n");

  if enabled == 0 {
    return 0 - 1;
  }
  return dwc2_probe_device0();
}

// Host channel 0 register block: base 0x500, one control-endpoint
// transfer at a time, stride 0x20 unused here since only channel 0 is
// ever used by this driver so far -- confirmed against hcd-dwc2.h's
// own `hreg1[((_ch) << 3) + N]` macros (each `hreg1` word is 4 bytes,
// so `<<3` word-index-shift is a 0x20-byte channel stride).
fn dwc2_hcchar0_addr() -> i64 {
  return dwc2_base() + 0x500;
}
fn dwc2_hcint0_addr() -> i64 {
  return dwc2_base() + 0x508;
}
fn dwc2_hcintmsk0_addr() -> i64 {
  return dwc2_base() + 0x50C;
}
fn dwc2_hctsiz0_addr() -> i64 {
  return dwc2_base() + 0x510;
}
fn dwc2_hcdma0_addr() -> i64 {
  return dwc2_base() + 0x514;
}

// HCCHAR field layout confirmed against hcd-dwc2.c's dwc2_enable_chan
// (CHENA=bit31, DEVADDR=bits[28:22], EPTYPE=bits[19:18] (0=control),
// EPDIR=bit15 (0=out,1=in), EPNUM=bits[14:11], MPS=bits[10:0]).
fn dwc2_build_hcchar(devaddr: u32, eptype: u32, epdir: u32, epnum: u32, mps: u32) -> u32 {
  let chena: u32 = 1 as u32;
  let v: u32 = (chena << (31 as u32))
    | (devaddr << (22 as u32))
    | (eptype << (18 as u32))
    | (epdir << (15 as u32))
    | (epnum << (11 as u32))
    | mps;
  return v;
}

// HCTSIZ field layout confirmed against hcd-dwc2.c (PID=bits[30:29],
// PKTCNT=bits[28:19], XFERSIZE=bits[18:0]). PID encoding for a
// CONTROL endpoint specifically (not the generic non-control 0/1/2/3
// = DATA0/DATA1/DATA2/MDATA scheme): 0=DATA0, 1=DATA2, 2=DATA1,
// 3=SETUP -- this project's own DWC2 register reference (gathered
// directly from hcd-dwc2.c/.h before writing any of this code, same
// discipline as every other peripheral here) confirmed this
// control-specific encoding explicitly, since assuming the generic
// non-control PID numbering here would silently mislabel every DATA1
// packet as DATA2 and vice versa.
fn dwc2_pid_setup() -> u32 {
  return 3 as u32;
}
fn dwc2_pid_data1() -> u32 {
  return 2 as u32;
}

fn dwc2_build_hctsiz(pid: u32, pktcnt: u32, xfersize: u32) -> u32 {
  let v: u32 = (pid << (29 as u32)) | (pktcnt << (19 as u32)) | xfersize;
  return v;
}

// Kicks off whatever channel 0 is already programmed for (HCCHAR/
// HCTSIZ/HCDMA must be set by the caller first) and polls HCINT(0)
// directly for completion -- bounded, not `while true`, matching this
// project's own established pattern for any hardware poll (the
// mailbox property-interface call earlier in this same phase uses the
// identical shape).
//
// Deliberately polls HCINT(0) itself, NOT HAINT: confirmed against
// hcd-dwc2.c's dwc2_update_hc_irq that HAINT's per-channel bit only
// ever reflects `HCINT & HCINTMSK`, and HCINTMSK(0) is 0 (every
// source masked) at reset -- a driver that never explicitly unmasks
// it would see HCINT(0) get the real completion bits from
// dwc2_handle_packet every time, while HAINT stayed permanently 0
// regardless (found the hard way: the very first version of this
// function polled HAINT and timed out on every single transfer, even
// though the transfer itself was completing correctly one MMIO write
// later). Since this driver polls registers directly instead of using
// the IRQ line, there's no need to program HCINTMSK/GINTMSK at all --
// reading the raw, always-current HCINT(0) value sidesteps the whole
// masking mechanism real interrupt-driven code would have to set up.
// Returns the HCINT value observed at completion (0 on a timeout,
// which is not a valid real HCINT value since XFERCOMPL or CHHLTD
// would always be set on a genuine completion -- callers check for
// exactly 0 to distinguish a timeout from a real, if unsuccessful,
// transfer outcome), and always clears whatever HCINT bits it saw
// (write-1-to-clear) before returning.
fn dwc2_wait_chan0_done() -> u32 {
  let hcint0: i64 = dwc2_hcint0_addr();
  let tries: i64 = 0;
  while tries < 1000000 {
    let hi: u32 = mmio_read_u32(hcint0);
    if hi != (0 as u32) {
      let _ = mmio_write_u32(hcint0, hi);
      return hi;
    }
    tries = tries + 1;
  }
  return 0 as u32;
}

// One complete control transfer (SETUP + optional IN data stage +
// zero-length STATUS stage) targeting device address `devaddr`,
// endpoint 0, using `mps` as the control endpoint's max packet size
// (8 is always safe for the very first transfer to any USB device,
// per spec -- every device supports at least an 8-byte EP0 before its
// real bMaxPacketSize0 is even known). Fetches `want_len` bytes of
// whatever descriptor `setup_buf` (already built by the caller into
// dwc2_dma_scratch) requests, copying the result into `out_buf`
// (caller-owned, at least `want_len` bytes). Returns 0 on success, -1
// on any stage failing to complete (channel-halt error bits set, or a
// poll timeout), or on either of the two bad-input cases guarded
// below.
//
// BUG (round 3 audit, 2026-08-27), two findings, both here:
//
// 1. The data stage below programs HCDMA to point straight at
// dwc2_dma_scratch and HCTSIZ's xfersize to `want_len` -- the DWC2
// controller then DMAs that many bytes into dwc2_dma_scratch directly
// in hardware, with nothing on this function's own side checking
// `want_len` against that buffer's actual, fixed 64-byte capacity
// (see scratch_state.S). Every call site today only ever asks for
// 4, 8, or 18 bytes, so this hasn't been hit live, but it's the exact
// same shape of bug rounds 1 and 2 both found and fixed elsewhere
// (netif_recv_frame, socket_udp_recv, tcp_conn_handle_segment, the FS
// layer) -- a length used as a hardware DMA/copy bound with no check
// against the destination's real size -- just with the DMA engine as
// the "writer" instead of a software loop this time. Worth closing
// now rather than after DHRUVA_ARCHITECTURE.md's own planned next
// step (real LAN9512/WiFi/BLE class drivers) adds a config-descriptor
// read whose length comes from the device's own reported wTotalLength
// and quietly exceeds 64.
//
// 2. `mps` is used below as a divisor when computing pktcnt for the
// data stage. Every real call site passes either a fixed 8 (the
// spec-guaranteed-safe default before a device's own MPS is known) or
// `mps0`/`dmps0` -- bMaxPacketSize0 read straight out of a device's
// own descriptor response, i.e. attacker/device-controlled data. A
// misbehaving or malicious device reporting bMaxPacketSize0=0 would
// divide by zero the moment this driver tried its next control
// transfer to that device (the 18-byte full-descriptor re-fetch,
// concretely) -- the exact same "validate untrusted external data
// before using it in an operation that can crash/hang" lesson as
// eval_apply's own division-by-zero guard, just with a USB device
// standing in for shell input this time.
fn dwc2_control_in(devaddr: u32, mps: u32, want_len: u32, out_buf: mut ref i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  // Round 56: raised from 64 to 128, matching dwc2_dma_scratch's own
  // real allocation size -- found live, not anticipated: CDC-ECM's
  // full config descriptor (control iface + Union + Ethernet
  // functional descriptors + interrupt endpoint + data iface at BOTH
  // altsettings + 2 bulk endpoints) is 80 bytes, which the old 64-byte
  // cap silently truncated mid-descriptor-chain, before ever reaching
  // the data interface's own altsetting-1 bulk endpoints -- CDC-ECM
  // detection succeeded but bulk endpoint capture silently failed.
  if want_len > (128 as u32) {
    return 0 - 1;
  }
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  // BUG (round 16 audit, 2026-08-28): the caller already wrote the
  // SETUP packet into dwc2_dma_scratch via plain stores before calling
  // this function -- nothing guaranteed that write had actually
  // reached memory before the HCDMA/HCCHAR writes just below hand this
  // same address off to the DWC2 controller's own DMA engine, a
  // genuinely separate hardware bus master that reads it via its own
  // path, not through the CPU. See mem_barrier's own comment
  // (context_switch.S) for why this is a real gap on real hardware
  // regardless of the MMU/cache state, and why QEMU's own testing
  // can't reveal it. Centralized here rather than at every call site
  // that builds a SETUP packet, matching this function's own existing
  // role as the one choke point every control transfer already goes
  // through.
  let _ = mem_barrier();

  // SETUP stage: the 8-byte request already sits in dwc2_dma_scratch
  // (dma), written by the caller before this call.
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_setup(), 1 as u32, 8 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let setup_result: u32 = dwc2_wait_chan0_done();
  if (setup_result & (1 as u32)) == (0 as u32) {
    return 0 - 1; // XFERCOMPL (bit0) never set -- timeout or error
  }

  // DATA stage (IN): read want_len bytes back into the same DMA
  // buffer, then copy out to the caller's own out_buf.
  //
  // BUG (found via a live STALL on the very first multi-packet
  // transfer this driver ever attempted -- want_len=18 > mps=8):
  // pktcnt must be the real number of MPS-sized packets the transfer
  // needs (ceil(want_len/mps)), not a hardcoded 1. hcd-dwc2.c's own
  // dwc2_handle_packet caps a single packet's actual transfer length
  // to `mps` whenever the overall length is "small" (<=1536 bytes,
  // true for every transfer this driver issues) -- with pktcnt wrongly
  // fixed at 1, the model still marks the WHOLE transfer "done" the
  // instant that single MPS-sized packet lands (pcnt hits 0 via
  // `pcnt -= min(tpcnt, pcnt)` clamping), silently truncating the
  // data stage to just `mps` bytes instead of the real want_len this
  // driver asked for and copied out assuming it got. The device's own
  // control-endpoint state machine, still expecting to send the
  // REMAINING data it hasn't transmitted yet, then sees a premature
  // STATUS token and STALLs it -- a real, spec-shaped protocol
  // violation this driver caused, not a QEMU model quirk. Multi-packet
  // completion itself needs no extra driver-side loop: hcd-dwc2.c's
  // dwc2_enable_chan always schedules its async bottom half after the
  // first packet regardless, and dwc2_work_bh keeps servicing this
  // channel (via p->needs_service) until pcnt/len both reach 0 -- this
  // driver's own poll loop already waits for that same final HCINT,
  // it just needs pktcnt to describe the truth up front.
  let pktcnt: u32 = (want_len + mps - (1 as u32)) / mps;
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), pktcnt, want_len));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 1 as u32, 0 as u32, mps));
  let data_result: u32 = dwc2_wait_chan0_done();
  if (data_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let i: i64 = 0;
  let want_len_i: i64 = want_len as i64;
  while i < want_len_i {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }

  // STATUS stage (OUT, zero-length, DATA1) -- acknowledges the
  // transfer is complete; no data buffer content matters here since
  // xfersize=0 means the model transfers nothing regardless of what
  // HCDMA points at, but a valid pointer is still supplied.
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), 1 as u32, 0 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let status_result: u32 = dwc2_wait_chan0_done();
  if (status_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  return 0;
}

// One control transfer with NO data stage: SETUP, then a zero-length
// STATUS stage in the OPPOSITE direction of the request (IN, since
// every no-data-stage standard request this driver issues -- SET_
// ADDRESS, SET_CONFIGURATION -- is host-to-device). Used for requests
// whose entire effect is encoded in the 8-byte SETUP packet itself,
// with nothing to read back or send afterward.
fn dwc2_control_no_data(devaddr: u32, mps: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  // Same real-hardware DMA-coherency gap dwc2_control_in's own comment
  // explains in full -- the caller already wrote the SETUP packet into
  // dwc2_dma_scratch via plain stores before calling this function.
  let _ = mem_barrier();

  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_setup(), 1 as u32, 8 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let setup_result: u32 = dwc2_wait_chan0_done();
  if (setup_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }

  // STATUS stage (IN, zero-length, DATA1).
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), 1 as u32, 0 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 1 as u32, 0 as u32, mps));
  let status_result: u32 = dwc2_wait_chan0_done();
  if (status_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  return 0;
}

// Round 56: one complete control transfer with an OUT data stage --
// SETUP, then out_len bytes sent host-to-device, then a zero-length
// STATUS stage in the OPPOSITE direction (IN), mirroring dwc2_control_
// in's own shape exactly but with the data stage's direction bit and
// the buffer-copy direction both flipped. Needed for the real LAN9512
// backend's WRITE_REGISTER vendor request (0xA0), which sends 4 bytes
// host-to-device -- the first OUT-data-stage control transfer this
// driver has ever needed (every existing one -- GET_DESCRIPTOR,
// SET_ADDRESS/CONFIGURATION/INTERFACE -- either reads data back or has
// none at all). Reuses dwc2_dma_scratch (same 128-byte cap as dwc2_
// control_in) for the DATA stage buffer, safe to overwrite immediately
// after the SETUP stage completes since the SETUP packet's own 8 bytes
// are no longer needed by that point.
fn dwc2_control_out(devaddr: u32, mps: u32, buf: mut ref i64, out_len: u32) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if out_len > (128 as u32) {
    return 0 - 1;
  }
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let _ = mem_barrier();
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_setup(), 1 as u32, 8 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let setup_result: u32 = dwc2_wait_chan0_done();
  if (setup_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }

  let i: i64 = 0;
  let out_len_i: i64 = out_len as i64;
  while i < out_len_i {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(dma, i as u32, b);
    i = i + 1;
  }
  let _ = mem_barrier();

  let pktcnt: u32 = if out_len == (0 as u32) { 1 as u32 } else { (out_len + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), pktcnt, out_len));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let data_result: u32 = dwc2_wait_chan0_done();
  if (data_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }

  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), 1 as u32, 0 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 1 as u32, 0 as u32, mps));
  let status_result: u32 = dwc2_wait_chan0_done();
  if (status_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  return 0;
}

// Generic SETUP packet builder -- every standard AND class-specific
// request (GET_DESCRIPTOR, SET_ADDRESS, and the hub-class port
// requests below) is just these five fields in the same 8-byte
// layout; the standard-request builders above predate this one and
// are kept as-is (each still correct, just less general) rather than
// churning already-verified code for a cosmetic refactor.
fn dwc2_build_setup(bm_request_type: u32, b_request: u32, w_value: u32, w_index: u32, w_length: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, bm_request_type);
  let _ = buf_write_byte(dma, 1 as u32, b_request);
  let _ = buf_write_byte(dma, 2 as u32, w_value & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (w_value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, w_index & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (w_index >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, w_length & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (w_length >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// USB 2.0 spec chapter 11 hub-class port feature selectors (the ones
// this driver actually uses -- ports "power up" reset-disabled by
// default, and PORT_RESET's own completion has to be observed via
// the port's status/change bits rather than assumed from timing
// alone, same "don't trust a bounded delay over a real status check
// where one exists" reasoning as this project's own IPCP/scheduler
// code, just applied to a hub port instead of a task).
fn hub_feature_port_enable() -> u32 { return 1 as u32; }
fn hub_feature_port_reset() -> u32 { return 4 as u32; }
fn hub_feature_port_power() -> u32 { return 8 as u32; }
fn hub_feature_c_port_connection() -> u32 { return 16 as u32; }
fn hub_feature_c_port_reset() -> u32 { return 20 as u32; }

// SET_PORT_FEATURE / CLEAR_PORT_FEATURE / GET_PORT_STATUS -- class-
// specific (not standard) requests, recipient=OTHER (a port, not the
// hub device itself): bmRequestType 0x23 for the two SET/CLEAR
// (host-to-device, class, other) and 0xA3 for GET_PORT_STATUS
// (device-to-host, class, other). `port` is 1-based per spec.
fn dwc2_hub_set_port_feature(hub_addr: u32, hub_mps: u32, port: u32, feature: u32) -> i64 {
  let _ = dwc2_build_setup(0x23 as u32, 3 as u32, feature, port, 0 as u32);
  return dwc2_control_no_data(hub_addr, hub_mps);
}
fn dwc2_hub_clear_port_feature(hub_addr: u32, hub_mps: u32, port: u32, feature: u32) -> i64 {
  let _ = dwc2_build_setup(0x23 as u32, 1 as u32, feature, port, 0 as u32);
  return dwc2_control_no_data(hub_addr, hub_mps);
}
// out_buf must be at least 4 bytes: wPortStatus (bytes 0-1, LE),
// wPortChange (bytes 2-3, LE).
fn dwc2_hub_get_port_status(hub_addr: u32, hub_mps: u32, port: u32, out_buf: mut ref i64) -> i64 {
  let _ = dwc2_build_setup(0xA3 as u32, 0 as u32, 0 as u32, port, 4 as u32);
  return dwc2_control_in(hub_addr, hub_mps, 4 as u32, out_buf);
}

// Builds a standard SET_ADDRESS SETUP packet: bmRequestType=0x00
// (host-to-device, standard, device), bRequest=5, wValue=new_addr,
// wIndex=0, wLength=0. Per USB spec this request is always issued
// TO address 0 (the device hasn't adopted new_addr yet -- it only
// does so after this transfer's STATUS stage completes), regardless
// of what new_addr itself is.
fn dwc2_build_set_address_setup(new_addr: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 5 as u32);
  let _ = buf_write_byte(dma, 2 as u32, new_addr & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (new_addr >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Builds a standard GET_DESCRIPTOR(Device) SETUP packet directly into
// dwc2_dma_scratch: bmRequestType=0x80 (device-to-host, standard,
// device), bRequest=6 (GET_DESCRIPTOR), wValue=0x0100 (type=1/DEVICE,
// index=0), wIndex=0, wLength as given (8 for the very first probe --
// enough to learn bMaxPacketSize0 at byte 7 without assuming the real
// device's MPS in advance).
fn dwc2_build_get_device_descriptor_setup(want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x80 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 6 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 1 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// Round 24 (WiFi dongle enumeration prep, 2026-08-28): same shape as
// dwc2_build_get_device_descriptor_setup right above, but wValue's
// high byte is 2 (CONFIGURATION) instead of 1 (DEVICE) -- everything
// else about a GET_DESCRIPTOR request is identical regardless of
// which descriptor type is being asked for.
// Round 56: config_index parameter added (was hardcoded to 0). A
// device can declare MORE than one configuration (bNumConfigurations
// in its device descriptor) -- found live, not anticipated in advance:
// QEMU's own `usb-net` device declares its RNDIS config FIRST
// (bConfigurationValue=2) and its plain CDC-ECM config SECOND
// (bConfigurationValue=1) in its own descriptor array, so index 0
// (the only index this function ever requested before this round)
// returns RNDIS, not the CDC-ECM config this driver actually knows how
// to drive -- confirmed live via a real QEMU boot with `-device
// usb-net` attached, not guessed from the source alone (mass storage,
// this project's only other real USB device so far, only ever
// declares a single configuration, so this gap was invisible until a
// genuinely multi-configuration device showed up). See dwc2_fetch_
// and_set_configuration's own comment for how it now tries index 0
// then index 1 rather than assuming index 0 is always the right one.
fn dwc2_build_get_config_descriptor_setup(config_index: u32, want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x80 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 6 as u32);
  let _ = buf_write_byte(dma, 2 as u32, config_index & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, 2 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// Round 24: bmRequestType=0x00 (host-to-device, standard, device),
// bRequest=9 (SET_CONFIGURATION), wValue=config_value, wIndex=0,
// wLength=0 -- a no-data control transfer, same shape as SET_ADDRESS.
// USB 2.0 spec chapter 9.4.7: a device sits in the non-functional
// Address state (it will answer control requests, and nothing else)
// until this request moves it to the Configured state -- every real
// device this driver will eventually need to actually exchange data
// with (a WiFi dongle's bulk/interrupt endpoints, LAN9512's own
// Ethernet bulk endpoints) needs this, not just WiFi specifically.
// Neither dwc2_probe_device0 nor dwc2_enumerate_downstream ever issued
// it before this round -- enumeration got as far as learning a
// device's identity, never as far as making it usable.
fn dwc2_build_set_configuration_setup(config_value: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 9 as u32);
  let _ = buf_write_byte(dma, 2 as u32, config_value & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (config_value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Round 56: bmRequestType=0x01 (host-to-device, standard, INTERFACE
// recipient -- not 0x00/device, the distinction USB 2.0 spec chapter
// 9.4.10 draws between SET_CONFIGURATION and SET_INTERFACE),
// bRequest=0x0B (SET_INTERFACE), wValue=alt_setting, wIndex=iface_num,
// wLength=0. CDC-ECM's own data interface defines alternate setting 0
// with ZERO endpoints ("link inactive") and alternate setting 1 with
// the real bulk IN/OUT pair -- confirmed directly against QEMU's own
// hw/usb/dev-network.c descriptor tables before writing this, same
// discipline as every other USB assumption in this file. A device
// stays on altsetting 0 (no data flow at all) until this request
// explicitly selects altsetting 1.
fn dwc2_build_set_interface_setup(iface_num: u32, alt_setting: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x01 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0x0B as u32);
  let _ = buf_write_byte(dma, 2 as u32, alt_setting & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (alt_setting >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, iface_num & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (iface_num >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Round 71: HID class-specific SET_PROTOCOL request (HID1.11 section
// 7.2.5) -- bmRequestType=0x21 (host-to-device, class, interface,
// distinct from SET_INTERFACE's plain 0x01 standard-request type
// above), bRequest=0x0B, wValue=protocol (0=boot, 1=report),
// wIndex=iface_num, wLength=0. Sent unconditionally to force Boot
// Protocol regardless of whatever protocol a device happens to power
// up in -- this driver only ever decodes the fixed, spec-defined
// 8-byte keyboard / 3-byte mouse boot report layouts (see
// hid_kbd_report_get_modifiers/hid_mouse_report_get_dx etc. below),
// never a device-specific Report Protocol descriptor.
fn dwc2_build_hid_set_protocol_setup(iface_num: u32, protocol: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x21 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0x0B as u32);
  let _ = buf_write_byte(dma, 2 as u32, protocol & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 4 as u32, iface_num & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (iface_num >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Round 56: GET_DESCRIPTOR(String, index=string_index), same shape as
// dwc2_build_get_device_descriptor_setup but wValue's high byte is 3
// (STRING) and low byte is the string index, with wIndex=langid.
// Hardcodes langid 0x0409 (US English) rather than doing the full
// spec-correct "fetch string index 0 for the device's supported langid
// list first" dance: confirmed against QEMU's own hw/usb/desc.c
// (usb_desc_string) that it ignores wIndex/langid entirely for any
// non-zero string index, and real devices overwhelmingly accept 0x0409
// for a plain-ASCII field like CDC-ECM's own MAC-address string
// regardless of their actual supported langid list -- a simplification
// flagged here, not silently assumed.
fn dwc2_build_get_string_descriptor_setup(string_index: u32, want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x80 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 6 as u32);
  let _ = buf_write_byte(dma, 2 as u32, string_index & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, 3 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0x09 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0x04 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

fn hex_ascii_to_nibble(c: u32) -> u32 {
  if (c >= (0x30 as u32)) && (c <= (0x39 as u32)) {
    return c - (0x30 as u32);
  }
  if (c >= (0x61 as u32)) && (c <= (0x66 as u32)) {
    return (c - (0x61 as u32)) + (10 as u32);
  }
  if (c >= (0x41 as u32)) && (c <= (0x46 as u32)) {
    return (c - (0x41 as u32)) + (10 as u32);
  }
  return 0 as u32;
}

// Round 56: CDC-ECM's own iMACAddress functional descriptor field
// (USB CDC spec 1.2 §5.2.3.1) names a STRING descriptor holding the
// MAC as 12 plain ASCII hex digits, no colons/separators (e.g.
// "400102030405"). USB string descriptors are UTF-16LE
// (bLength, bDescriptorType, then 2 bytes per character) -- since hex
// digits are always ASCII, the low byte of each UTF-16 code unit IS
// the character and the high byte is always 0, so this only reads the
// low byte of each pair (byte offset 2 + i*2), skipping the 2-byte
// header. Does not validate the high byte is actually 0 (a genuinely
// non-ASCII MAC-string reply would be a spec-violating device; this
// project's existing "reject clearly malformed input" posture doesn't
// extend to defending against a compliant class of device sending
// deliberately malformed class-specific string content here).
fn cdc_parse_mac_string(buf: mut ref i64, out_mac: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let hi_char: u32 = buf_read_byte(buf, ((2 as i64) + (i * 4)) as u32);
    let lo_char: u32 = buf_read_byte(buf, ((2 as i64) + (i * 4) + 2) as u32);
    let hi_nibble: u32 = hex_ascii_to_nibble(hi_char);
    let lo_nibble: u32 = hex_ascii_to_nibble(lo_char);
    let byte_val: u32 = (hi_nibble << (4 as u32)) | lo_nibble;
    let _ = buf_write_byte(out_mac, i as u32, byte_val);
    i = i + 1;
  }
  return 0;
}

// Round 56: the REAL SMSC LAN9512 backend -- the actual USB-to-
// Ethernet bridge chip every Pi 1 Model B's onboard wired port uses
// (BCM2835 has no native Ethernet MAC). Detected by idVendor:
// idProduct (0x0424:0xec00 or 0x0424:0x9904 -- Microchip/SMSC's own
// device table lists both as valid PIDs for this exact chip family
// depending on EEPROM-strapped mode, confirmed against Linux's
// smsc95xx.c `products[]` table), NOT by interface class/subclass like
// CDC-ECM above -- this chip's Ethernet function is entirely vendor-
// specific (no standard USB class exists for it), so dwc2_fetch_and_
// set_configuration's descriptor walk captures ITS bulk endpoints
// unconditionally (gated on is_lan9512, not any class check) rather
// than needing its own functional-descriptor parsing the way CDC-ECM
// did.
//
// IMPORTANT, stated plainly rather than left implicit: nothing below
// this comment through the end of the LAN9512 backend has been (or
// currently can be) LIVE-VERIFIED. QEMU's raspi1ap has no LAN9512
// device model -- unlike CDC-ECM above (verified against QEMU's own
// real `usb-net` device: real MAC fetch matching an independently-
// specified value, real ping round trips, packet-capture-confirmed
// real frames on the wire), this backend is written directly against
// the public LAN9512/9514 datasheet and Linux's smsc95xx.c/.h
// reference driver (register offsets, vendor request numbers, TX/RX
// wire framing all cross-checked against that real, in-tree Linux
// driver source before writing a single line here), but has only ever
// been exercised via the vani-compiler's own type/borrow checker, not
// against a real chip or its own protocol responses. Pending this
// project's own planned Pi 1B hardware-in-loop testing (see project
// TODO) before this can be called proven rather than "written to
// spec." The TX_CMD_A/B and RX-status-word FRAMING MATH specifically
// (the part that doesn't need real chip I/O to check) does get real
// host-side test coverage -- see test/host_harness/'s own LAN9512
// framing tests.
//
// USB_VENDOR_REQUEST_READ_REGISTER=0xA1 (device-to-host, vendor,
// device), USB_VENDOR_REQUEST_WRITE_REGISTER=0xA0 (host-to-device,
// vendor, device) -- both wValue=0, wIndex=register offset, wLength=4,
// data=4-byte little-endian register value. Register offsets below
// (ID_REV/HW_CFG/RX_CFG/TX_CFG/BURST_CAP/BULK_IN_DLY/INT_STS/
// LED_GPIO_CFG/AFC_CFG/FLOW/VLAN1/INT_EP_CTL/MAC_CR/ADDRH/ADDRL) all
// named exactly as smsc95xx.h names them, same reason this project's
// other hardware-register code always keeps the vendor's own names.
fn lan9512_reg_read(devaddr: u32, mps: u32, reg_offset: u32) -> u32 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0xC1 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0xA1 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 4 as u32, reg_offset & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (reg_offset >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, 4 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  let out_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let status: i64 = dwc2_control_in(devaddr, mps, 4 as u32, out_buf);
  if status != 0 {
    return 0xFFFFFFFF as u32; // sentinel: no real LAN9512 register
                              // this driver reads is ever expected to
                              // legitimately read back as all-ones
  }
  let b0: u32 = buf_read_byte(out_buf, 0 as u32);
  let b1: u32 = buf_read_byte(out_buf, 1 as u32);
  let b2: u32 = buf_read_byte(out_buf, 2 as u32);
  let b3: u32 = buf_read_byte(out_buf, 3 as u32);
  return b0 | (b1 << (8 as u32)) | (b2 << (16 as u32)) | (b3 << (24 as u32));
}

fn lan9512_reg_write(devaddr: u32, mps: u32, reg_offset: u32, value: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x41 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0xA0 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 4 as u32, reg_offset & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (reg_offset >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, 4 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  let val_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(val_buf, 0 as u32, value & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 1 as u32, (value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 2 as u32, (value >> (16 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 3 as u32, (value >> (24 as u32)) & (0xFF as u32));
  // Same "SETUP already written into dwc2_dma_scratch by the caller"
  // convention as every other control-transfer call site in this file
  // -- the SETUP bytes written into `dma` above are what dwc2_control_
  // out's own SETUP stage sends; val_buf here is only the DATA stage's
  // OUT payload (dwc2_control_out reuses dma for that too, internally,
  // once the SETUP stage itself has completed).
  return dwc2_control_out(devaddr, mps, val_buf, 4 as u32);
}

// Round 58: Realtek RTL8188CU/RTL8192CU family (USB WiFi, VID 0x0bda,
// PID 0x8176 -- confirmed against Linux's rtl8xxxu driver's own device
// table, `USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_REALTEK, 0x8176,
// 0xff, 0xff, 0xff)`) vendor register read/write -- a DIFFERENT wire
// protocol from LAN9512's own 0xA0/0xA1 scheme, confirmed directly
// against rtl8xxxu's own rtl8xxxu_read8/16/32 and rtl8xxxu_write8/16/32
// (drivers/net/wireless/realtek/rtl8xxxu/core.c): a single bRequest
// (0x05, REALTEK_USB_CMD_REQ) for both directions, distinguished by
// bmRequestType alone (0xC0 read / 0x40 write, i.e. USB_DIR_IN|
// USB_TYPE_VENDOR|USB_RECIP_DEVICE vs USB_DIR_OUT|... -- same direction
// encoding LAN9512 uses, just a different bRequest value and, unlike
// LAN9512, the register address goes in wValue, not wIndex.
//
// This round's scope stops here deliberately -- see rtl8188cu_probe's
// own comment below for exactly why (real, redistributable but
// proprietary firmware blob required before the radio does anything;
// this project fetched one temporarily to verify the header format
// documented there, then deleted it per explicit instruction -- never
// committed to this repository).
fn dwc2_build_rtl_reg_read_setup(reg_addr: u32, want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0xC0 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0x05 as u32);
  let _ = buf_write_byte(dma, 2 as u32, reg_addr & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (reg_addr >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

fn dwc2_build_rtl_reg_write_setup(reg_addr: u32, data_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x40 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0x05 as u32);
  let _ = buf_write_byte(dma, 2 as u32, reg_addr & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (reg_addr >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, data_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (data_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

fn rtl_reg_read8(devaddr: u32, mps: u32, addr: u32) -> u32 {
  let _ = dwc2_build_rtl_reg_read_setup(addr, 1 as u32);
  let out_buf: mut ref i64 = dhruva_alloc_bytes(1);
  let status: i64 = dwc2_control_in(devaddr, mps, 1 as u32, out_buf);
  if status != 0 {
    return 0xFFFFFFFF as u32;
  }
  return buf_read_byte(out_buf, 0 as u32);
}

fn rtl_reg_read16(devaddr: u32, mps: u32, addr: u32) -> u32 {
  let _ = dwc2_build_rtl_reg_read_setup(addr, 2 as u32);
  let out_buf: mut ref i64 = dhruva_alloc_bytes(2);
  let status: i64 = dwc2_control_in(devaddr, mps, 2 as u32, out_buf);
  if status != 0 {
    return 0xFFFFFFFF as u32;
  }
  let b0: u32 = buf_read_byte(out_buf, 0 as u32);
  let b1: u32 = buf_read_byte(out_buf, 1 as u32);
  return b0 | (b1 << (8 as u32));
}

fn rtl_reg_read32(devaddr: u32, mps: u32, addr: u32) -> u32 {
  let _ = dwc2_build_rtl_reg_read_setup(addr, 4 as u32);
  let out_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let status: i64 = dwc2_control_in(devaddr, mps, 4 as u32, out_buf);
  if status != 0 {
    return 0xFFFFFFFF as u32;
  }
  let b0: u32 = buf_read_byte(out_buf, 0 as u32);
  let b1: u32 = buf_read_byte(out_buf, 1 as u32);
  let b2: u32 = buf_read_byte(out_buf, 2 as u32);
  let b3: u32 = buf_read_byte(out_buf, 3 as u32);
  return b0 | (b1 << (8 as u32)) | (b2 << (16 as u32)) | (b3 << (24 as u32));
}

fn rtl_reg_write8(devaddr: u32, mps: u32, addr: u32, value: u32) -> i64 {
  let _ = dwc2_build_rtl_reg_write_setup(addr, 1 as u32);
  let val_buf: mut ref i64 = dhruva_alloc_bytes(1);
  let _ = buf_write_byte(val_buf, 0 as u32, value & (0xFF as u32));
  return dwc2_control_out(devaddr, mps, val_buf, 1 as u32);
}

fn rtl_reg_write16(devaddr: u32, mps: u32, addr: u32, value: u32) -> i64 {
  let _ = dwc2_build_rtl_reg_write_setup(addr, 2 as u32);
  let val_buf: mut ref i64 = dhruva_alloc_bytes(2);
  let _ = buf_write_byte(val_buf, 0 as u32, value & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 1 as u32, (value >> (8 as u32)) & (0xFF as u32));
  return dwc2_control_out(devaddr, mps, val_buf, 2 as u32);
}

fn rtl_reg_write32(devaddr: u32, mps: u32, addr: u32, value: u32) -> i64 {
  let _ = dwc2_build_rtl_reg_write_setup(addr, 4 as u32);
  let val_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(val_buf, 0 as u32, value & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 1 as u32, (value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 2 as u32, (value >> (16 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(val_buf, 3 as u32, (value >> (24 as u32)) & (0xFF as u32));
  return dwc2_control_out(devaddr, mps, val_buf, 4 as u32);
}

// Round 58: USB WiFi bring-up STOPS here, deliberately, right after
// enumeration + a structural register-read demonstration -- this is
// NOT the same shape as lan9512_reset_and_init or hci_reset_and_scan,
// which both go on to actually bring hardware up. Real Realtek USB
// WiFi chips (RTL8188CU/RTL8192CU and effectively every other USB
// WiFi chipset in existence) require uploading a PROPRIETARY firmware
// BLOB to the chip's embedded 8051 MCU before the radio does anything
// at all -- this is not a protocol this driver can implement from a
// public specification the way LAN9512's register sequence or
// Bluetooth's HCI transport were. Real Linux systems get this blob
// from the `linux-firmware` project (a legally separate, redistribu-
// table binary collection under Realtek's own terms), never by
// deriving it from source.
//
// This project fetched the REAL firmware
// (rtlwifi/rtl8192cufw_TMSC.bin, from
// https://gitlab.com/kernel-firmware/linux-firmware -- the current
// canonical linux-firmware mirror; also available via kernel.org's own
// linux-firmware.git) TEMPORARILY, specifically to confirm this
// comment's own claims about its structure are accurate rather than
// copied from driver source without verification -- then DELETED it
// immediately afterward. It was never committed to this repository and
// never will be; this is a deliberate project-hygiene and licensing
// boundary; not an oversight. Verified, for the record: the file is
// 16126 bytes; its first 32 bytes are a `struct rtl8xxxu_firmware_
// header` (signature, category, function, major/minor version,
// BCD-encoded release month/date/hour/minute, ramcodesize, ...,
// matching rtl8xxxu.h's own struct layout exactly); signature field
// (bytes 0-1, little-endian) reads 0x88c1, matching the driver's own
// documented "88C1: MP A-cut" case; the ramcodesize field (bytes
// 12-13, little-endian) reads 0x3ede (16094), which is EXACTLY
// file_size-32 -- confirming the header is really 32 bytes and the
// field genuinely self-describes the payload length that follows it.
//
// Whoever continues this with real Pi 1B hardware needs to: (1) fetch
// the same file from the same URL, (2) implement the actual MCU
// firmware-download sequence (rtl8xxxu_download_firmware in core.c --
// enable MCU download mode, write the payload in chunks via register
// writes, verify a checksum, disable download mode), (3) only then
// does any of the 802.11 MAC-layer/WPA2 work in TODO.md's own next
// item become reachable at all.
fn rtl8188cu_probe(devaddr: u32, mps: u32) -> i64 {
  let _ = usb_wifi_set_kind(1 as u32);
  let iso_ctrl: u32 = rtl_reg_read16(devaddr, mps, 0x0000 as u32); // REG_SYS_ISO_CTRL
  let sys_func: u32 = rtl_reg_read16(devaddr, mps, 0x0002 as u32); // REG_SYS_FUNC
  let _ = uart_puts("USB: RTL8188CU/RTL8192CU family detected, REG_SYS_ISO_CTRL=");
  let _ = uart_put_hex32(iso_ctrl);
  let _ = uart_puts(" REG_SYS_FUNC=");
  let _ = uart_put_hex32(sys_func);
  let _ = uart_puts(" (register I/O only -- firmware upload NOT implemented, see this function's own comment)\n");
  return 0;
}

// Register offsets/bit values below all named and valued exactly as
// smsc95xx.h (Linux's real, in-tree LAN9512/95xx driver header). A
// deliberately SIMPLIFIED subset of the reference driver's own reset()
// -- enough to bring TX and RX up correctly, not every register the
// reference driver also touches for LED behavior, checksum-offload
// capability advertisement, or burst/turbo-mode tuning this driver
// doesn't use (turbo/multi-frame-per-USB-packet mode specifically is
// never enabled here, matching netif_recv_frame's own single-frame-
// per-transfer assumption -- see its LAN9512 branch below).
fn lan9512_reset_and_init(devaddr: u32, mps: u32) -> i64 {
  // HW_CFG Lite Reset, then poll until the chip clears the bit itself
  // (bounded, not `while true`, matching this project's own
  // established hardware-poll discipline).
  let _ = lan9512_reg_write(devaddr, mps, 0x14 as u32, 0x00000008 as u32);
  let tries: i64 = 0;
  let reset_done: i64 = 0;
  while (tries < 1000) && (reset_done == 0) {
    let hw_cfg: u32 = lan9512_reg_read(devaddr, mps, 0x14 as u32);
    if (hw_cfg & (0x00000008 as u32)) == (0 as u32) {
      reset_done = 1;
    }
    tries = tries + 1;
  }
  if reset_done == 0 {
    let _ = uart_puts("USB: LAN9512 lite reset timed out\n");
    return 0 - 1;
  }

  // Program the chip's MAC registers with this driver's own assigned
  // address (ADDRL = bytes 0-3 little-endian, ADDRH = bytes 4-5 in the
  // low 16 bits) -- no EEPROM read implemented, so this is always the
  // SAME address netif_get_mac's own loopback fallback already uses,
  // not the real hardware's burned-in one (see netif_get_mac's own
  // comment for why that's a consistent choice, not a mismatch).
  let mac_buf: mut ref i64 = dhruva_alloc_bytes(6);
  let _ = netif_get_mac(mac_buf);
  let m0: u32 = buf_read_byte(mac_buf, 0 as u32);
  let m1: u32 = buf_read_byte(mac_buf, 1 as u32);
  let m2: u32 = buf_read_byte(mac_buf, 2 as u32);
  let m3: u32 = buf_read_byte(mac_buf, 3 as u32);
  let m4: u32 = buf_read_byte(mac_buf, 4 as u32);
  let m5: u32 = buf_read_byte(mac_buf, 5 as u32);
  let addr_lo: u32 = m0 | (m1 << (8 as u32)) | (m2 << (16 as u32)) | (m3 << (24 as u32));
  let addr_hi: u32 = m4 | (m5 << (8 as u32));
  let _ = lan9512_reg_write(devaddr, mps, 0x108 as u32, addr_lo); // ADDRL
  let _ = lan9512_reg_write(devaddr, mps, 0x104 as u32, addr_hi); // ADDRH

  // RX data offset = 2 (NET_IP_ALIGN), so a received frame's IP header
  // (14 bytes into the Ethernet payload) lands word-aligned -- HW_CFG
  // bits [10:9], mask 0x00000600, matching smsc95xx.h's own HW_CFG_
  // RXDOFF_ field exactly.
  let hw_cfg2: u32 = lan9512_reg_read(devaddr, mps, 0x14 as u32);
  let hw_cfg3: u32 = (hw_cfg2 & (0xFFFFF9FF as u32)) | ((2 as u32) << (9 as u32));
  let _ = lan9512_reg_write(devaddr, mps, 0x14 as u32, hw_cfg3);

  let _ = lan9512_reg_write(devaddr, mps, 0x08 as u32, 0xFFFFFFFF as u32); // INT_STS clear-all
  let _ = lan9512_reg_write(devaddr, mps, 0x11C as u32, 0 as u32); // FLOW
  let _ = lan9512_reg_write(devaddr, mps, 0x2C as u32, 0x00F830A1 as u32); // AFC_CFG default

  // Enable TX: MAC_CR.TXEN_ then TX_CFG.TX_CFG_ON_.
  let mac_cr: u32 = lan9512_reg_read(devaddr, mps, 0x100 as u32);
  let mac_cr_tx: u32 = mac_cr | (0x00000008 as u32);
  let _ = lan9512_reg_write(devaddr, mps, 0x100 as u32, mac_cr_tx);
  let _ = lan9512_reg_write(devaddr, mps, 0x10 as u32, 0x00000004 as u32); // TX_CFG_ON_

  // Enable RX: MAC_CR.RXEN_.
  let mac_cr_rx: u32 = mac_cr_tx | (0x00000004 as u32);
  let _ = lan9512_reg_write(devaddr, mps, 0x100 as u32, mac_cr_rx);

  let _ = uart_puts("USB: LAN9512 reset+init complete (spec-only, not live-verified -- see its own comment)\n");
  return 0;
}

// Round 56: the LAN9512 TX/RX wire-framing math, factored out into
// pure functions (no MMIO, no USB, only buffer reads/writes and
// arithmetic) specifically so test/host_harness/ can exercise them
// directly against hand-computed expected byte layouts -- the part of
// this backend that genuinely doesn't need real chip I/O to verify,
// unlike lan9512_reset_and_init's own register sequence. netif_send_
// frame/netif_recv_frame's LAN9512 branches call these rather than
// duplicating this arithmetic inline.
fn lan9512_build_tx_header(out_buf: mut ref i64, frame_len: u32) -> i64 {
  let tx_cmd_a: u32 = frame_len | (0x00002000 as u32) | (0x00001000 as u32);
  let tx_cmd_b: u32 = frame_len;
  let _ = buf_write_u32_le(out_buf, 0, tx_cmd_a);
  let _ = buf_write_u32_le(out_buf, 4, tx_cmd_b);
  return 0;
}

fn lan9512_rx_status_has_error(rx_status: u32) -> u32 {
  if (rx_status & (0x00008000 as u32)) != (0 as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

fn lan9512_rx_status_frame_len(rx_status: u32) -> u32 {
  return (rx_status >> (16 as u32)) & (0x3FFF as u32);
}

// Fetches the configuration descriptor (first its own fixed 9-byte
// header to learn wTotalLength/bConfigurationValue -- the same
// "short fetch to learn a length, then a full fetch" progressive
// pattern dwc2_probe_device0 already uses for the device descriptor
// -- then as much of the full interface/endpoint descriptor chain as
// fits in dwc2_dma_scratch's own 64-byte capacity), walks it counting
// INTERFACE (type 4) and ENDPOINT (type 5) descriptors -- the two
// things a real class driver (WiFi, or LAN9512's own Ethernet
// function) needs to know exist before it can do anything with
// them -- and issues SET_CONFIGURATION so the device actually leaves
// the non-functional Address state. Logs a summary but doesn't keep
// any interface/endpoint descriptor fields around: this is
// enumeration-completeness prep (get every device to a genuinely
// Configured, usable state and prove what's inside its configuration
// is visible), not the start of a class driver -- parsing individual
// endpoint addresses/types into something a future bulk-transfer
// driver would consume is real, separate work for whenever that
// driver actually gets built.
// Round 56: config_index parameter added -- see dwc2_build_get_config_
// descriptor_setup's own comment for why (QEMU's usb-net device
// exposes a config this driver can't use at index 0, and the one it
// can use at index 1). Callers that only ever expect a single-
// configuration device (the hub itself) always pass 0; dwc2_
// enumerate_downstream retries with 1 if index 0 turned out to hold
// neither a mass-storage nor CDC-ECM interface.
fn dwc2_fetch_and_set_configuration(devaddr: u32, mps: u32, config_index: u32, is_lan9512: u32) -> i64 {
  let cfg9: mut ref i64 = dhruva_alloc_bytes(9);
  let _ = dwc2_build_get_config_descriptor_setup(config_index, 9 as u32);
  let status0: i64 = dwc2_control_in(devaddr, mps, 9 as u32, cfg9);
  if status0 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Configuration) short fetch failed\n");
    return 0 - 1;
  }
  let clength: u32 = buf_read_byte(cfg9, 0 as u32);
  let cdesctype: u32 = buf_read_byte(cfg9, 1 as u32);
  if (clength != (9 as u32)) || (cdesctype != (2 as u32)) {
    let _ = uart_puts("USB: config descriptor probe (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }
  let total_lo: u32 = buf_read_byte(cfg9, 2 as u32);
  let total_hi: u32 = buf_read_byte(cfg9, 3 as u32);
  let total_length: u32 = total_lo | (total_hi << (8 as u32));
  let num_interfaces: u32 = buf_read_byte(cfg9, 4 as u32);
  let config_value: u32 = buf_read_byte(cfg9, 5 as u32);

  // dwc2_control_in's own cap (round 3 audit -- the DMA scratch
  // buffer's real capacity, raised 64->128 in round 56 for CDC-ECM's
  // own 80-byte config descriptor, see its own comment) means a
  // configuration whose wTotalLength exceeds that can only be read
  // partially here. Grab as much as fits rather than failing outright
  // -- everything counted below still reflects real descriptors, just
  // possibly not all of them for an unusually large configuration
  // (every device this project attaches under QEMU today, including
  // CDC-ECM's own 80-byte one, fits comfortably under 128 bytes).
  let full_want_len: u32 = if total_length > (128 as u32) { 128 as u32 } else { total_length };
  let truncated: i64 = if total_length > (128 as u32) { 1 } else { 0 };

  let cfgfull: mut ref i64 = dhruva_alloc_bytes(128);
  let _ = dwc2_build_get_config_descriptor_setup(config_index, full_want_len);
  let status1: i64 = dwc2_control_in(devaddr, mps, full_want_len, cfgfull);
  if status1 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Configuration) full fetch failed\n");
    return 0 - 1;
  }

  // Standard USB descriptor-chain traversal: each descriptor names its
  // own bLength (byte 0), so an unrecognized bDescriptorType (a
  // class-specific or vendor-specific descriptor, common right after
  // an INTERFACE descriptor for anything more complex than a trivial
  // device) is still skipped correctly rather than misread as
  // something fixed-size. Bounds-checked against full_want_len before
  // every read -- a corrupt or truncated descriptor chain is dropped,
  // not trusted, same "reject, don't guess" posture as every other
  // untrusted-length parse in this project (DHCP's own TLV option
  // parser, most recently).
  // Round 33: while walking this same descriptor chain, also actually
  // extract (not just count) the bulk endpoints of a USB Mass Storage
  // / SCSI / Bulk-Only Transport interface, if one is present --
  // class 0x08 (Mass Storage), subclass 0x06 (SCSI transparent
  // command set), protocol 0x50 (Bulk-Only Transport). cur_iface_is_bot
  // reflects the MOST RECENTLY seen INTERFACE descriptor's class triad
  // and is consulted at each ENDPOINT descriptor that follows it --
  // standard descriptor-chain attribution (endpoints always
  // immediately follow the interface they belong to in a well-formed
  // config descriptor), same walk this loop already does for
  // iface_count/ep_count, just also acting on what it sees instead of
  // only counting it. Reset bot=0 at the top of every call (not just
  // once at boot): this function runs once per newly-enumerated
  // device, and a non-mass-storage device (the hub itself, or a
  // usb-net gadget) must not retain a stale BOT flag/endpoints from
  // a previous call.
  // Round 56: this same single-pass walk also detects a CDC-ECM
  // Ethernet Networking Control Model interface (class 0x02/COMM,
  // subclass 0x06) alongside the existing BOT detection -- QEMU's own
  // `usb-net` device (non-RNDIS config) presents exactly this,
  // confirmed against hw/usb/dev-network.c before writing this. Real
  // standard USB Ethernet dongles use the same class. This is
  // DIFFERENT from the real onboard SMSC LAN9512 (Pi 1's own wired
  // port), which is entirely vendor-specific and detected separately
  // by idVendor:idProduct at the DEVICE-descriptor level, before this
  // function is even called -- see dwc2_enumerate_downstream's own
  // comment on that.
  //
  // Tracking a CDC control interface's associated DATA interface
  // needs two things this loop didn't track before: bInterfaceNumber/
  // bAlternateSetting (CDC's data interface defines altsetting 0 with
  // ZERO endpoints -- "link inactive" -- and altsetting 1 with the
  // real bulk pair; SET_CONFIGURATION alone leaves every interface on
  // altsetting 0, so the wrong one must never be mistaken for the
  // active one), and the CS_INTERFACE Union Functional Descriptor
  // (bDescriptorType 0x24, bDescriptorSubType 0x06) inside the control
  // interface's own descriptor block, whose bSlaveInterface0 field
  // names which OTHER interface number is the paired data interface --
  // read while cur_iface_is_cdc_control is still true from having just
  // seen that control interface, exactly the same "most recently seen
  // INTERFACE descriptor" attribution BOT's own ENDPOINT handling
  // already relies on. The CDC Ethernet Functional Descriptor
  // (subtype 0x0F) is read the same way, for cdc_mac_string_index.
  let _ = usb_msd_set_bot(0 as u32);
  let _ = usb_net_set_kind(0 as u32);
  let pos: i64 = 0;
  let iface_count: i64 = 0;
  let ep_count: i64 = 0;
  let cur_iface_is_bot: i64 = 0;
  let found_bot: i64 = 0;
  let cur_iface_is_cdc_control: i64 = 0;
  let cur_iface_num: i64 = 0 - 1;
  let cur_iface_is_cdc_data_active: i64 = 0;
  let cdc_data_iface_target: i64 = 0 - 1;
  let cdc_mac_string_index: u32 = 0 as u32;
  let found_cdc_control: i64 = 0;
  let found_net_bulk_eps: i64 = 0;
  // Round 57: USB Bluetooth HCI (interface class 0xE0, subclass 0x01,
  // protocol 0x01) -- an OFFICIAL, STANDARDIZED USB class, detected the
  // same way BOT's own 0x08/0x06/0x50 check already works, unlike
  // LAN9512's vendor-specific detection which needs idVendor:idProduct
  // instead. found_bt_bulk_eps/found_bt_intr_ep are tracked separately
  // (not reused from found_net_bulk_eps) since a real HCI device needs
  // BOTH kinds of endpoint present, not just "at least one bulk pair,"
  // to be usable.
  let cur_iface_is_bt: i64 = 0;
  let found_bt: i64 = 0;
  let found_bt_bulk_eps: i64 = 0;
  let found_bt_intr_ep: i64 = 0;
  // Round 71: USB HID boot-protocol keyboard/mouse (interface class
  // 0x03, subclass 0x01 "boot interface subclass", protocol 0x01
  // keyboard / 0x02 mouse -- HID1.11 Appendix B). cur_iface_hid_kind
  // carries which of the two the MOST RECENTLY seen INTERFACE
  // descriptor was (0 if neither), same attribution style BOT/CDC/BT
  // already use for their own single-purpose flags -- a plain int
  // here instead of a second bool since keyboard and mouse need
  // exactly the same endpoint handling, just a different final kind.
  let cur_iface_hid_kind: i64 = 0;
  let found_hid_kind: i64 = 0;
  let found_hid_intr_ep: i64 = 0;
  let hid_iface_num: i64 = 0 - 1;
  let _ = usb_hid_set_kind(0 as u32);
  let full_want_len_i: i64 = full_want_len as i64;
  while pos < full_want_len_i {
    let dlen: u32 = buf_read_byte(cfgfull, pos as u32);
    if dlen == (0 as u32) {
      pos = full_want_len_i; // malformed -- stop rather than loop forever
    } else {
      if (pos + 1) >= full_want_len_i {
        pos = full_want_len_i; // truncated -- can't read bDescriptorType
      } else {
        let dtype: u32 = buf_read_byte(cfgfull, (pos + 1) as u32);
        if dtype == (4 as u32) {
          iface_count = iface_count + 1;
          cur_iface_is_bot = 0;
          cur_iface_is_cdc_control = 0;
          cur_iface_is_cdc_data_active = 0;
          cur_iface_is_bt = 0;
          cur_iface_hid_kind = 0;
          if (pos + 7) < full_want_len_i {
            let inum: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let ialt: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let iclass: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let isubclass: u32 = buf_read_byte(cfgfull, (pos + 6) as u32);
            let iproto: u32 = buf_read_byte(cfgfull, (pos + 7) as u32);
            cur_iface_num = inum as i64;
            if (iclass == (0x08 as u32)) && (isubclass == (0x06 as u32)) && (iproto == (0x50 as u32)) {
              cur_iface_is_bot = 1;
              found_bot = 1;
            }
            if (iclass == (0x02 as u32)) && (isubclass == (0x06 as u32)) {
              cur_iface_is_cdc_control = 1;
              found_cdc_control = 1;
            }
            if (iclass == (0x0A as u32)) && (cur_iface_num == cdc_data_iface_target) && ((ialt as i64) == 1) {
              cur_iface_is_cdc_data_active = 1;
            }
            if (iclass == (0xE0 as u32)) && (isubclass == (0x01 as u32)) && (iproto == (0x01 as u32)) {
              cur_iface_is_bt = 1;
              found_bt = 1;
            }
            if (iclass == (0x03 as u32)) && (isubclass == (0x01 as u32)) {
              if iproto == (0x01 as u32) {
                cur_iface_hid_kind = 1; // keyboard
                found_hid_kind = 1;
                hid_iface_num = cur_iface_num;
              }
              if iproto == (0x02 as u32) {
                cur_iface_hid_kind = 2; // mouse
                found_hid_kind = 2;
                hid_iface_num = cur_iface_num;
              }
            }
          }
        }
        if dtype == (0x24 as u32) && (cur_iface_is_cdc_control == 1) && ((pos + 2) < full_want_len_i) {
          let cs_subtype: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
          if (cs_subtype == (0x06 as u32)) && ((pos + 4) < full_want_len_i) {
            let slave_iface: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            cdc_data_iface_target = slave_iface as i64;
          }
          if (cs_subtype == (0x0F as u32)) && ((pos + 3) < full_want_len_i) {
            cdc_mac_string_index = buf_read_byte(cfgfull, (pos + 3) as u32);
          }
        }
        if dtype == (5 as u32) {
          ep_count = ep_count + 1;
          if (cur_iface_is_bot == 1) && ((pos + 5) < full_want_len_i) {
            let ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let ep_mps: u32 = ep_mps_lo | (ep_mps_hi << (8 as u32));
            // bmAttributes bits[1:0]: 2 = bulk (0=control, 1=iso,
            // 3=interrupt) -- only bulk endpoints matter for BOT.
            if (ep_attr & (0x03 as u32)) == (0x02 as u32) {
              if (ep_addr & (0x80 as u32)) != (0 as u32) {
                let _ = usb_msd_set_bulk_in_epaddr(ep_addr);
                let _ = usb_msd_set_bulk_in_mps(ep_mps);
              } else {
                let _ = usb_msd_set_bulk_out_epaddr(ep_addr);
                let _ = usb_msd_set_bulk_out_mps(ep_mps);
              }
            }
          }
          if (cur_iface_is_cdc_data_active == 1) && ((pos + 5) < full_want_len_i) {
            let net_ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let net_ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let net_ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let net_ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let net_ep_mps: u32 = net_ep_mps_lo | (net_ep_mps_hi << (8 as u32));
            if (net_ep_attr & (0x03 as u32)) == (0x02 as u32) {
              found_net_bulk_eps = 1;
              if (net_ep_addr & (0x80 as u32)) != (0 as u32) {
                let _ = usb_net_set_bulk_in_epaddr(net_ep_addr);
                let _ = usb_net_set_bulk_in_mps(net_ep_mps);
              } else {
                let _ = usb_net_set_bulk_out_epaddr(net_ep_addr);
                let _ = usb_net_set_bulk_out_mps(net_ep_mps);
              }
            }
          }
          // Round 56: LAN9512's Ethernet function is entirely vendor-
          // specific (no standard class to gate on the way CDC-ECM's
          // own class/subclass check does above) -- is_lan9512 was
          // already determined by idVendor:idProduct before this
          // function was even called (see dwc2_enumerate_downstream's
          // own comment), so ANY bulk endpoint found anywhere in this
          // device's configuration is captured unconditionally.
          if (is_lan9512 == (1 as u32)) && ((pos + 5) < full_want_len_i) {
            let lan_ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let lan_ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let lan_ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let lan_ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let lan_ep_mps: u32 = lan_ep_mps_lo | (lan_ep_mps_hi << (8 as u32));
            if (lan_ep_attr & (0x03 as u32)) == (0x02 as u32) {
              found_net_bulk_eps = 1; // reused below as "found something to publish"
              if (lan_ep_addr & (0x80 as u32)) != (0 as u32) {
                let _ = usb_net_set_bulk_in_epaddr(lan_ep_addr);
                let _ = usb_net_set_bulk_in_mps(lan_ep_mps);
              } else {
                let _ = usb_net_set_bulk_out_epaddr(lan_ep_addr);
                let _ = usb_net_set_bulk_out_mps(lan_ep_mps);
              }
            }
          }
          // Round 57: USB Bluetooth HCI's own 3 endpoints -- bulk
          // IN/OUT (ACL data) plus interrupt IN (HCI events),
          // distinguished by bmAttributes bits[1:0] (2=bulk, 3=
          // interrupt) the same way BOT/CDC-ECM/LAN9512 already
          // distinguish bulk from other types above.
          if (cur_iface_is_bt == 1) && ((pos + 5) < full_want_len_i) {
            let bt_ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let bt_ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let bt_ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let bt_ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let bt_ep_mps: u32 = bt_ep_mps_lo | (bt_ep_mps_hi << (8 as u32));
            if (bt_ep_attr & (0x03 as u32)) == (0x02 as u32) {
              found_bt_bulk_eps = 1;
              if (bt_ep_addr & (0x80 as u32)) != (0 as u32) {
                let _ = usb_bt_set_bulk_in_epaddr(bt_ep_addr);
                let _ = usb_bt_set_bulk_in_mps(bt_ep_mps);
              } else {
                let _ = usb_bt_set_bulk_out_epaddr(bt_ep_addr);
                let _ = usb_bt_set_bulk_out_mps(bt_ep_mps);
              }
            }
            if ((bt_ep_attr & (0x03 as u32)) == (0x03 as u32)) && ((bt_ep_addr & (0x80 as u32)) != (0 as u32)) {
              found_bt_intr_ep = 1;
              let _ = usb_bt_set_intr_in_epaddr(bt_ep_addr);
              let _ = usb_bt_set_intr_in_mps(bt_ep_mps);
            }
          }
          // Round 71: USB HID's own interrupt-IN report endpoint --
          // same bmAttributes==3 (interrupt)/direction-bit check BT's
          // own intr_in above already uses. A boot-protocol keyboard/
          // mouse needs exactly this one endpoint for this driver's
          // read-only scope (see boot/usb_hid_state.S's own header
          // comment on why interrupt-OUT/LEDs are out of scope).
          if (cur_iface_hid_kind != 0) && ((pos + 5) < full_want_len_i) {
            let hid_ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let hid_ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let hid_ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let hid_ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let hid_ep_mps: u32 = hid_ep_mps_lo | (hid_ep_mps_hi << (8 as u32));
            if ((hid_ep_attr & (0x03 as u32)) == (0x03 as u32)) && ((hid_ep_addr & (0x80 as u32)) != (0 as u32)) {
              found_hid_intr_ep = 1;
              let _ = usb_hid_set_intr_in_epaddr(hid_ep_addr);
              let _ = usb_hid_set_intr_in_mps(hid_ep_mps);
            }
          }
        }
        pos = pos + (dlen as i64);
      }
    }
  }
  if found_bot == 1 {
    let _ = usb_msd_set_bot(1 as u32);
    // SET_CONFIGURATION (below) resets every endpoint's data toggle
    // to DATA0 per spec -- mirrored here so this driver's own toggle
    // tracking starts in sync with the device's real state.
    let _ = usb_msd_set_in_toggle(0 as u32);
    let _ = usb_msd_set_out_toggle(0 as u32);
    let _ = uart_puts("USB: mass storage (BOT) interface detected, bulk_in_ep=");
    let _ = uart_put_hex32(usb_msd_get_bulk_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_msd_get_bulk_in_mps());
    let _ = uart_puts(" bulk_out_ep=");
    let _ = uart_put_hex32(usb_msd_get_bulk_out_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_msd_get_bulk_out_mps());
    let _ = uart_puts("\n");
  }
  if (found_cdc_control == 1) && (found_net_bulk_eps == 1) {
    let _ = usb_net_set_kind(1 as u32);
    let _ = usb_net_set_cdc_data_iface_num((cdc_data_iface_target as u32));
    let _ = usb_net_set_in_toggle(0 as u32);
    let _ = usb_net_set_out_toggle(0 as u32);
    let _ = uart_puts("USB: CDC-ECM interface detected, data_iface=");
    let _ = uart_put_hex32(cdc_data_iface_target as u32);
    let _ = uart_puts(" bulk_in_ep=");
    let _ = uart_put_hex32(usb_net_get_bulk_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_net_get_bulk_in_mps());
    let _ = uart_puts(" bulk_out_ep=");
    let _ = uart_put_hex32(usb_net_get_bulk_out_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_net_get_bulk_out_mps());
    let _ = uart_puts("\n");
  }
  if (is_lan9512 == (1 as u32)) && (found_net_bulk_eps == 1) {
    let _ = usb_net_set_kind(2 as u32);
    let _ = usb_net_set_in_toggle(0 as u32);
    let _ = usb_net_set_out_toggle(0 as u32);
    let _ = uart_puts("USB: LAN9512 Ethernet function detected, bulk_in_ep=");
    let _ = uart_put_hex32(usb_net_get_bulk_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_net_get_bulk_in_mps());
    let _ = uart_puts(" bulk_out_ep=");
    let _ = uart_put_hex32(usb_net_get_bulk_out_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_net_get_bulk_out_mps());
    let _ = uart_puts("\n");
  }
  if (found_bt == 1) && (found_bt_bulk_eps == 1) && (found_bt_intr_ep == 1) {
    let _ = usb_bt_set_kind(1 as u32);
    let _ = usb_bt_set_bulk_in_toggle(0 as u32);
    let _ = usb_bt_set_bulk_out_toggle(0 as u32);
    let _ = usb_bt_set_intr_in_toggle(0 as u32);
    let _ = uart_puts("USB: Bluetooth HCI interface detected, bulk_in_ep=");
    let _ = uart_put_hex32(usb_bt_get_bulk_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_bt_get_bulk_in_mps());
    let _ = uart_puts(" bulk_out_ep=");
    let _ = uart_put_hex32(usb_bt_get_bulk_out_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_bt_get_bulk_out_mps());
    let _ = uart_puts(" intr_in_ep=");
    let _ = uart_put_hex32(usb_bt_get_intr_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_bt_get_intr_in_mps());
    let _ = uart_puts("\n");
  }
  if (found_hid_kind != 0) && (found_hid_intr_ep == 1) {
    let _ = usb_hid_set_kind(found_hid_kind as u32);
    let _ = usb_hid_set_intr_in_toggle(0 as u32);
    let _ = uart_puts("USB: HID ");
    if found_hid_kind == 1 {
      let _ = uart_puts("keyboard");
    } else {
      let _ = uart_puts("mouse");
    }
    let _ = uart_puts(" (boot protocol) interface detected, intr_in_ep=");
    let _ = uart_put_hex32(usb_hid_get_intr_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_hid_get_intr_in_mps());
    let _ = uart_puts("\n");
  }

  let _ = uart_puts("USB: config bConfigurationValue=");
  let _ = uart_put_hex32(config_value);
  let _ = uart_puts(" bNumInterfaces=");
  let _ = uart_put_hex32(num_interfaces);
  let _ = uart_puts(" wTotalLength=");
  let _ = uart_put_hex32(total_length);
  let _ = uart_puts(" interfaces_seen=");
  let _ = uart_put_hex32(iface_count as u32);
  let _ = uart_puts(" endpoints_seen=");
  let _ = uart_put_hex32(ep_count as u32);
  if truncated == 1 {
    let _ = uart_puts(" (truncated, exceeds 64-byte scratch)");
  }
  let _ = uart_puts("\n");

  let _ = dwc2_build_set_configuration_setup(config_value);
  let set_status: i64 = dwc2_control_no_data(devaddr, mps);
  if set_status != 0 {
    let _ = uart_puts("USB: SET_CONFIGURATION failed\n");
    return 0 - 1;
  }

  // Round 56: CDC-ECM follow-up, only reachable once SET_CONFIGURATION
  // itself has already succeeded above. SET_CONFIGURATION alone leaves
  // every interface on altsetting 0 -- the data interface's bulk
  // endpoints this driver just captured above are not actually live
  // until SET_INTERFACE explicitly selects altsetting 1 (see dwc2_
  // build_set_interface_setup's own comment).
  if usb_net_get_kind() == (1 as u32) {
    let _ = dwc2_build_set_interface_setup(cdc_data_iface_target as u32, 1 as u32);
    let iface_status: i64 = dwc2_control_no_data(devaddr, mps);
    if iface_status != 0 {
      let _ = uart_puts("USB: CDC-ECM SET_INTERFACE(data, alt=1) failed\n");
    }
    if cdc_mac_string_index != (0 as u32) {
      let mac_str_buf: mut ref i64 = dhruva_alloc_bytes(32);
      let _ = dwc2_build_get_string_descriptor_setup(cdc_mac_string_index, 32 as u32);
      let mac_str_status: i64 = dwc2_control_in(devaddr, mps, 32 as u32, mac_str_buf);
      if mac_str_status == 0 {
        let mac_buf: mut ref i64 = dhruva_alloc_bytes(6);
        let _ = cdc_parse_mac_string(mac_str_buf, mac_buf);
        let _ = usb_net_set_mac_scratch_ptr(mac_buf);
        let _ = uart_puts("USB: CDC-ECM MAC=");
        let mi: i64 = 0;
        while mi < 6 {
          let mb: u32 = buf_read_byte(mac_buf, mi as u32);
          let _ = uart_put_hex_byte(mb);
          if mi < 5 {
            let _ = uart_puts(":");
          }
          mi = mi + 1;
        }
        let _ = uart_puts("\n");
      } else {
        let _ = uart_puts("USB: CDC-ECM MAC string fetch failed\n");
      }
    }
  }
  // Round 56: real LAN9512 follow-up -- see lan9512_reset_and_init's
  // own comment for exactly what this does and does not do, and why
  // it can't be live-verified under QEMU.
  if usb_net_get_kind() == (2 as u32) {
    let _ = lan9512_reset_and_init(devaddr, mps);
  }
  // Round 57: USB Bluetooth HCI follow-up -- see hci_reset_and_scan's
  // own comment for exactly what this does and does not do, and why
  // it can't be live-verified under QEMU either.
  if usb_bt_get_kind() == (1 as u32) {
    let _ = hci_reset_and_scan(devaddr, mps);
  }
  // Round 71: USB HID follow-up -- force Boot Protocol explicitly
  // (see dwc2_build_hid_set_protocol_setup's own comment on why),
  // only reachable once SET_CONFIGURATION itself has already
  // succeeded above, matching CDC-ECM's/BT's own follow-up ordering.
  if usb_hid_get_kind() != (0 as u32) {
    let _ = dwc2_build_hid_set_protocol_setup(hid_iface_num as u32, 0 as u32);
    let hid_proto_status: i64 = dwc2_control_no_data(devaddr, mps);
    if hid_proto_status != 0 {
      let _ = uart_puts("USB: HID SET_PROTOCOL(boot) failed\n");
    }
  }
  return 0;
}

// Round 33: USB mass storage (Bulk-Only Transport, USB Mass Storage
// Class Bulk-Only Transport spec) bring-up -- the first live caller
// of real bulk transfers anywhere in this project. Every control
// transfer above (dwc2_control_in/no_data) uses a fixed PID encoding
// specific to endpoint 0/control (see dwc2_pid_setup/data1's own
// comment); bulk endpoints use the GENERIC non-control PID/DATA-
// toggle encoding instead (0=DATA0, 1=DATA1 -- not control's 2/3),
// and unlike a control transfer's fixed per-stage toggle, a bulk
// endpoint's toggle must keep alternating correctly across every
// separate transfer for as long as the endpoint stays configured --
// tracked persistently via usb_msd_state.S, reset to DATA0 the moment
// SET_CONFIGURATION establishes the endpoint (see the detection block
// above). Otherwise this reuses dwc2_control_in/no_data's own proven
// channel-0/HCCHAR/HCTSIZ/HCDMA/dwc2_wait_chan0_done plumbing
// unchanged -- the DWC2 controller doesn't care whether channel 0 was
// last used for a control or bulk transfer, only what's programmed
// into it for the transfer about to be kicked off.
fn dwc2_bulk_pid_data0() -> u32 {
  return 0 as u32;
}
fn dwc2_bulk_pid_data1() -> u32 {
  return 1 as u32;
}

// One bulk OUT transfer (host -> device), <= 512 bytes (usb_bulk_
// data_scratch's real capacity -- round 35 raised this from 64, a cap
// that only ever needed to cover a 31-byte CBW, once READ(10)/
// WRITE(10) needed to move a full 512-byte sector through this same
// function. Uses its own dedicated scratch buffer, NOT dwc2_dma_
// scratch (still 64 bytes, still used unchanged by dwc2_control_in/
// no_data -- see usb_bulk_data_scratch_addr's own comment in
// scratch_state.S for why a separate buffer was safer than growing
// the control-transfer one those already-proven functions still use).
fn dwc2_bulk_out(devaddr: u32, mps: u32, buf: mut ref i64, out_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (out_len < 0) || (out_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_msd_get_bulk_out_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let i: i64 = 0;
  while i < out_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(dma, i as u32, b);
    i = i + 1;
  }
  // Same real-hardware DMA-coherency gap dwc2_control_in's own comment
  // explains in full -- buf was just copied into dma via plain stores
  // above, before handing that same address to the DWC2 controller's
  // own DMA engine below.
  let _ = mem_barrier();

  let toggle: u32 = usb_msd_get_out_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if out_len == 0 { 1 as u32 } else { ((out_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, out_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 0 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_msd_set_out_toggle(next_toggle);
  return 0;
}

// One bulk IN transfer (device -> host), <= 512 bytes, same scratch-
// capacity reasoning as dwc2_bulk_out above.
fn dwc2_bulk_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_msd_get_bulk_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_msd_get_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < want_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_msd_set_in_toggle(next_toggle);
  return want_len;
}

// Round 56: the network driver's own bulk OUT/IN, identical shape to
// dwc2_bulk_out/dwc2_bulk_in above but referencing usb_net_state.S's
// endpoint/toggle state instead of usb_msd_state.S's -- a deliberate,
// small duplication rather than generalizing the mass-storage
// functions to take endpoint/toggle parameters, so this new, less-
// proven driver can never regress the already-working BOT code path
// (see usb_net_state.S's own header comment for the same reasoning
// applied to the state module). Reuses usb_bulk_data_scratch_get()'s
// SAME DMA buffer as mass storage -- safe because a single enumerated
// downstream device is always either mass-storage OR network, never
// both, so there is no concurrent-use hazard.
//
// dwc2_net_bulk_out(..., out_len=0) doubles as a zero-length-packet
// (ZLP) send: the pktcnt computation below already handles out_len==0
// as exactly one zero-length packet, which is what CDC-ECM's TX
// framing needs to explicitly terminate a frame whose length happens
// to be an exact multiple of the endpoint's max packet size (see
// netif_send_frame's own CDC-ECM branch for why).
fn dwc2_net_bulk_out(devaddr: u32, mps: u32, buf: mut ref i64, out_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (out_len < 0) || (out_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_net_get_bulk_out_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let i: i64 = 0;
  while i < out_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(dma, i as u32, b);
    i = i + 1;
  }
  let _ = mem_barrier();

  let toggle: u32 = usb_net_get_out_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if out_len == 0 { 1 as u32 } else { ((out_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, out_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 0 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_net_set_out_toggle(next_toggle);
  return 0;
}

// One bulk IN transfer (device -> host), <= 512 bytes. Unlike dwc2_
// bulk_in (which always transfers exactly want_len bytes -- fine for
// SCSI, which always knows the exact expected length up front),
// network RX genuinely doesn't know the incoming frame's length ahead
// of time. Callers pass the endpoint's own max packet size as want_len
// and rely on the RETURNED length: a SHORT return (< mps) means "this
// was the last/only packet of the frame" (CDC-ECM's own short-packet-
// terminates-transfer convention, matching QEMU's usb-net emulation
// exactly -- see netif_recv_frame's own comment). A transfer that
// comes back empty (0 actual bytes moved, distinct from a 0-length
// bulk IN request) signals "nothing waiting" to the caller via a
// negative return, same as dwc2_bulk_in's own error convention.
fn dwc2_net_bulk_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_net_get_bulk_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_net_get_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  // dwc2_control_in never needed this (every control transfer it
  // issues asks for an exact, already-known length and trusts
  // XFERCOMPL alone) -- this is this driver's first genuine short-read
  // case, confirmed against the real Linux dwc2 driver
  // (drivers/usb/dwc2/hcd_intr.c, dwc2_hc_get_actual_xfer_length-style
  // logic): on a clean XFERCOMPL (not a halted/errored transfer, which
  // is a different, pktcnt-based calculation this driver doesn't need
  // since it already returns -1 for that case above), HCTSIZ's
  // xfersize field holds the REMAINING (not transferred) byte count,
  // counting down from want_len as bytes actually moved over USB --
  // read it back and subtract to recover the real short-packet length.
  let hctsiz_after: u32 = mmio_read_u32(hctsiz0);
  let bytes_left: u32 = hctsiz_after & (0x7FFFF as u32);
  let actual_len: i64 = want_len - (bytes_left as i64);
  let i: i64 = 0;
  while i < actual_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_net_set_in_toggle(next_toggle);
  return actual_len;
}

// Round 57: USB Bluetooth HCI's own bulk OUT/IN (ACL data), identical
// shape to dwc2_net_bulk_out/in but against usb_bt_state.S's own
// endpoint/toggle state -- same small, deliberate duplication reasoning
// as usb_net_state.S's own header comment (a separate module per USB
// device kind, not a shared/parameterized one).
fn dwc2_bt_bulk_out(devaddr: u32, mps: u32, buf: mut ref i64, out_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (out_len < 0) || (out_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_bt_get_bulk_out_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let i: i64 = 0;
  while i < out_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(dma, i as u32, b);
    i = i + 1;
  }
  let _ = mem_barrier();

  let toggle: u32 = usb_bt_get_bulk_out_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if out_len == 0 { 1 as u32 } else { ((out_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, out_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 0 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_bt_set_bulk_out_toggle(next_toggle);
  return 0;
}

fn dwc2_bt_bulk_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_bt_get_bulk_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_bt_get_bulk_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let hctsiz_after: u32 = mmio_read_u32(hctsiz0);
  let bytes_left: u32 = hctsiz_after & (0x7FFFF as u32);
  let actual_len: i64 = want_len - (bytes_left as i64);
  let i: i64 = 0;
  while i < actual_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_bt_set_bulk_in_toggle(next_toggle);
  return actual_len;
}

// Round 66: HCI ACL Data packet framing (Bluetooth Core Spec Vol 4
// Part E §5.4.2) -- the envelope every L2CAP packet travels in over
// the bulk OUT/IN endpoints above, once a connection handle exists
// (hci_le_conn_complete_handle). [Handle:12 bits][PB_Flag:2 bits]
// [BC_Flag:2 bits] packed into 2 bytes LE, then [Data_Total_Length:2
// bytes LE], then the L2CAP payload. PB_Flag 0b10 ("first non-
// automatically-flushable packet, complete L2CAP PDU") and BC_Flag
// 0b00 (point-to-point, not broadcast -- BLE has no broadcast ACL)
// are the only combination this driver's own single-L2CAP-packet-per-
// ACL-packet design ever needs; PB_Flag 0b01 (packet continuation) is
// for reassembling an L2CAP PDU split across multiple ACL packets,
// not implemented here (every ATT PDU this round builds comfortably
// fits in one ACL packet under any realistic LE ATT_MTU).
fn hci_acl_pb_flag_first() -> u32 {
  return 0x02 as u32;
}

fn hci_acl_bc_flag_point_to_point() -> u32 {
  return 0x00 as u32;
}

fn hci_acl_build_header(out_buf: mut ref i64, handle: u32, pb_flag: u32, bc_flag: u32, data_len: u32) -> i64 {
  let handle_and_flags: u32 = (handle & (0x0FFF as u32)) | ((pb_flag & (0x03 as u32)) << (12 as u32)) | ((bc_flag & (0x03 as u32)) << (14 as u32));
  let _ = buf_write_u16_le(out_buf, 0, handle_and_flags);
  let _ = buf_write_u16_le(out_buf, 2, data_len);
  return 4;
}

fn hci_acl_get_handle(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 0) & (0x0FFF as u32);
}

fn hci_acl_get_pb_flag(buf: mut ref i64) -> u32 {
  return (buf_read_u16_le(buf, 0) >> (12 as u32)) & (0x03 as u32);
}

fn hci_acl_get_data_len(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 2);
}

// L2CAP B-frame (Basic frame, Bluetooth Core Spec Vol 3 Part A §3.1)
// -- carried as the payload of one ACL data packet above.
// [Length:2 bytes LE][Channel_ID:2 bytes LE][payload]. Length covers
// the payload only, not this 4-byte header itself. LE has a small,
// fixed set of predefined channel IDs (§3.2 Table 3.2, "LE-U logical
// link"); this round only needs the Attribute Protocol's own fixed
// channel, but l2cap_signaling_channel_id is included alongside it
// since any real connection setup (LE credit-based flow control,
// connection parameter updates) runs over L2CAP Signaling, the next
// genuinely separate piece above what this round builds.
fn l2cap_att_channel_id() -> u32 {
  return 0x0004 as u32;
}

fn l2cap_signaling_channel_id() -> u32 {
  return 0x0005 as u32;
}

fn l2cap_build_header(out_buf: mut ref i64, length: u32, channel_id: u32) -> i64 {
  let _ = buf_write_u16_le(out_buf, 0, length);
  let _ = buf_write_u16_le(out_buf, 2, channel_id);
  return 4;
}

fn l2cap_get_length(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 0);
}

fn l2cap_get_channel_id(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 2);
}

// Round 66 follow-up: L2CAP Signaling (§4, fixed channel 0x0005) --
// specifically just Connection Parameter Update Request/Response
// (§4.20-21), the one Signaling exchange a GAP CENTRAL (Dhruva's own
// only implemented role, see hci_build_le_create_connection_command's
// own comment) is actually expected to handle: a connected peripheral
// asks to change the connection interval/latency/timeout, and the
// central must respond (accept or reject) -- every other Signaling
// command (L2CAP connection-oriented channel creation, disconnection,
// ...) is genuinely out of scope, this project's own BLE work never
// uses anything but the ATT fixed channel for actual data. Command
// format (§4, Fig 4.1): [Code (1)][Identifier (1)][Length (2, LE)]
// [Data (Length bytes)].
fn l2cap_sig_code_connection_parameter_update_request() -> u32 { return 0x12 as u32; }
fn l2cap_sig_code_connection_parameter_update_response() -> u32 { return 0x13 as u32; }
fn l2cap_conn_param_update_result_accepted() -> u32 { return 0x0000 as u32; }
fn l2cap_conn_param_update_result_rejected() -> u32 { return 0x0001 as u32; }

fn l2cap_sig_get_code(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 0 as u32);
}

fn l2cap_sig_get_identifier(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 1 as u32);
}

fn l2cap_sig_get_length(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 2);
}

// Connection Parameter Update Request (§4.20): Data = [Interval_Min
// (2, LE)][Interval_Max (2, LE)][Slave_Latency (2, LE)][Timeout_
// Multiplier (2, LE)], all in the standard 1.25ms/10ms Bluetooth LE
// units -- this round doesn't convert them to real time, just exposes
// the raw fields (a caller wanting to actually validate/apply them
// would do that conversion itself).
fn l2cap_conn_param_update_request_get_interval_min(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 4);
}

fn l2cap_conn_param_update_request_get_interval_max(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 6);
}

fn l2cap_conn_param_update_request_get_slave_latency(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 8);
}

fn l2cap_conn_param_update_request_get_timeout_multiplier(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 10);
}

// Connection Parameter Update Response (§4.21): Data = [Result (2,
// LE)] (0x0000 Accepted, 0x0001 Rejected).
fn l2cap_build_conn_param_update_response(out_buf: mut ref i64, identifier: u32, result: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, l2cap_sig_code_connection_parameter_update_response());
  let _ = buf_write_byte(out_buf, 1 as u32, identifier);
  let _ = buf_write_u16_le(out_buf, 2, 2 as u32);
  let _ = buf_write_u16_le(out_buf, 4, result);
  return 6;
}

// Attribute Protocol (ATT, Bluetooth Core Spec Vol 3 Part F) -- the
// generic read/write-by-handle protocol GATT (the next layer up,
// still not started) builds services/characteristics semantics on top
// of. Every PDU starts with a 1-byte Opcode; these are the core
// operations a minimal "connect, negotiate MTU, read/write one known
// attribute handle" interaction needs (§3.4.1-§3.4.3, §3.4.4.1-3,
// §3.4.5.1-3) -- GATT's own discovery procedures (Find Information,
// Read By Type/Group Type, needed to enumerate services/
// characteristics rather than accessing a handle already known ahead
// of time) are deliberately NOT included in this round, a genuinely
// separate, larger increment (this project's own directory-hierarchy-
// style "don't build past what's actually needed yet" discipline).
fn att_opcode_error_response() -> u32 { return 0x01 as u32; }
fn att_opcode_exchange_mtu_request() -> u32 { return 0x02 as u32; }
fn att_opcode_exchange_mtu_response() -> u32 { return 0x03 as u32; }
fn att_opcode_read_request() -> u32 { return 0x0A as u32; }
fn att_opcode_read_response() -> u32 { return 0x0B as u32; }
fn att_opcode_write_request() -> u32 { return 0x12 as u32; }
fn att_opcode_write_response() -> u32 { return 0x13 as u32; }

fn att_get_opcode(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 0 as u32);
}

// Error Response (§3.4.1.1): [Opcode=0x01][Request_Opcode_In_Error
// (1)][Attribute_Handle_In_Error (2, LE)][Error_Code (1)] -- the
// generic "that request failed" reply every other PDU type below can
// draw instead of its own normal response.
fn att_build_error_response(out_buf: mut ref i64, request_opcode: u32, handle: u32, error_code: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_error_response());
  let _ = buf_write_byte(out_buf, 1 as u32, request_opcode);
  let _ = buf_write_u16_le(out_buf, 2, handle);
  let _ = buf_write_byte(out_buf, 4 as u32, error_code);
  return 5;
}

fn att_error_request_opcode(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 1 as u32);
}

fn att_error_handle(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 2);
}

fn att_error_code(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 4 as u32);
}

// Exchange MTU Request/Response (§3.4.2.1-2): [Opcode][Client/Server_
// Rx_MTU (2, LE)] -- the very first exchange over a fresh ATT bearer,
// negotiating the larger of the two ends' own receive capability
// (default LE ATT_MTU is 23 bytes absent this exchange).
fn att_build_exchange_mtu_request(out_buf: mut ref i64, client_rx_mtu: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_exchange_mtu_request());
  let _ = buf_write_u16_le(out_buf, 1, client_rx_mtu);
  return 3;
}

fn att_exchange_mtu_request_get_mtu(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 1);
}

fn att_build_exchange_mtu_response(out_buf: mut ref i64, server_rx_mtu: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_exchange_mtu_response());
  let _ = buf_write_u16_le(out_buf, 1, server_rx_mtu);
  return 3;
}

fn att_exchange_mtu_response_get_mtu(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 1);
}

// Read Request/Response (§3.4.4.1-2): Request is [Opcode][Handle (2,
// LE)]; Response is [Opcode][Value (variable, up to ATT_MTU-1 bytes)]
// -- the value's own length is implicit (whatever the underlying L2CAP
// PDU's own length said), not carried inside the ATT PDU itself.
fn att_build_read_request(out_buf: mut ref i64, handle: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_request());
  let _ = buf_write_u16_le(out_buf, 1, handle);
  return 3;
}

fn att_read_request_get_handle(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 1);
}

fn att_build_read_response(out_buf: mut ref i64, value: mut ref i64, value_len: i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_response());
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(value, i as u32);
    let _ = buf_write_byte(out_buf, (1 + i) as u32, b);
    i = i + 1;
  }
  return 1 + value_len;
}

// Copies a Read Response PDU's own value portion (everything after
// the 1-byte opcode) into out_value -- pdu_len is the WHOLE PDU's
// length (as delivered by L2CAP), matching this project's own "caller
// states its real buffer capacity, callee never guesses" posture
// (netif_recv_frame's own established convention) rather than
// re-deriving a length from something implicit.
fn att_read_response_get_value(buf: mut ref i64, pdu_len: i64, out_value: mut ref i64) -> i64 {
  let value_len: i64 = pdu_len - 1;
  if value_len < 0 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(buf, (1 + i) as u32);
    let _ = buf_write_byte(out_value, i as u32, b);
    i = i + 1;
  }
  return value_len;
}

// Write Request/Response (§3.4.5.1, §3.4.5.3): Request is [Opcode]
// [Handle (2, LE)][Value (variable)]; Response is just [Opcode] alone
// -- confirmation, no return data (that's Read's own job).
fn att_build_write_request(out_buf: mut ref i64, handle: u32, value: mut ref i64, value_len: i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_write_request());
  let _ = buf_write_u16_le(out_buf, 1, handle);
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(value, i as u32);
    let _ = buf_write_byte(out_buf, (3 + i) as u32, b);
    i = i + 1;
  }
  return 3 + value_len;
}

fn att_write_request_get_handle(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 1);
}

fn att_write_request_get_value(buf: mut ref i64, pdu_len: i64, out_value: mut ref i64) -> i64 {
  let value_len: i64 = pdu_len - 3;
  if value_len < 0 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(buf, (3 + i) as u32);
    let _ = buf_write_byte(out_value, i as u32, b);
    i = i + 1;
  }
  return value_len;
}

fn att_build_write_response(out_buf: mut ref i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_write_response());
  return 1;
}

// Round 66 follow-up: Handle Value Notification/Indication/
// Confirmation (§3.4.7.1-3) -- how a server pushes a characteristic's
// own value to a subscribed client without waiting to be asked (a
// Read Request round trip), the actual mechanism gatt_client_write_
// cccd (below) subscribes TO. Notification and Indication share the
// identical wire shape ([Opcode][Handle (2, LE)][Value]) -- only the
// opcode and whether a Confirmation is required afterward (Indication
// only, §3.4.7.3 -- the server won't send another Indication until
// this arrives) differ, so both builders/the shared getter below
// reuse att_write_request_get_handle-style accessors rather than
// duplicating four near-identical functions.
fn att_opcode_handle_value_notification() -> u32 { return 0x1B as u32; }
fn att_opcode_handle_value_indication() -> u32 { return 0x1D as u32; }
fn att_opcode_handle_value_confirmation() -> u32 { return 0x1E as u32; }

fn att_build_handle_value_notification(out_buf: mut ref i64, handle: u32, value: mut ref i64, value_len: i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_handle_value_notification());
  let _ = buf_write_u16_le(out_buf, 1, handle);
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(value, i as u32);
    let _ = buf_write_byte(out_buf, (3 + i) as u32, b);
    i = i + 1;
  }
  return 3 + value_len;
}

fn att_build_handle_value_indication(out_buf: mut ref i64, handle: u32, value: mut ref i64, value_len: i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_handle_value_indication());
  let _ = buf_write_u16_le(out_buf, 1, handle);
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(value, i as u32);
    let _ = buf_write_byte(out_buf, (3 + i) as u32, b);
    i = i + 1;
  }
  return 3 + value_len;
}

// Shared getter for either PDU -- same offset in both.
fn att_handle_value_get_handle(buf: mut ref i64) -> u32 {
  return buf_read_u16_le(buf, 1);
}

fn att_handle_value_get_value(buf: mut ref i64, pdu_len: i64, out_value: mut ref i64) -> i64 {
  let value_len: i64 = pdu_len - 3;
  if value_len < 0 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(buf, (3 + i) as u32);
    let _ = buf_write_byte(out_value, i as u32, b);
    i = i + 1;
  }
  return value_len;
}

fn att_build_handle_value_confirmation(out_buf: mut ref i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_handle_value_confirmation());
  return 1;
}

// Round 66 follow-up: ATT error codes (§3.4.1.1, Table 3.4) worth
// naming -- Attribute_Not_Found (0x0A) specifically is how every
// discovery procedure below recognizes "no more results" (a real
// Error Response, not a distinct "done" signal of its own kind --
// GATT discovery is defined entirely in terms of repeating an ATT
// request with a narrowing handle range until this exact error comes
// back, per §4.3.1/§4.6.1/§4.6.8's own procedure text).
fn att_error_invalid_handle() -> u32 { return 0x01 as u32; }
fn att_error_read_not_permitted() -> u32 { return 0x02 as u32; }
fn att_error_write_not_permitted() -> u32 { return 0x03 as u32; }
fn att_error_invalid_pdu() -> u32 { return 0x04 as u32; }
fn att_error_insufficient_authentication() -> u32 { return 0x05 as u32; }
fn att_error_request_not_supported() -> u32 { return 0x06 as u32; }
fn att_error_invalid_offset() -> u32 { return 0x07 as u32; }
fn att_error_insufficient_authorization() -> u32 { return 0x08 as u32; }
fn att_error_prepare_queue_full() -> u32 { return 0x09 as u32; }
fn att_error_attribute_not_found() -> u32 { return 0x0A as u32; }
fn att_error_attribute_not_long() -> u32 { return 0x0B as u32; }
fn att_error_insufficient_encryption_key_size() -> u32 { return 0x0C as u32; }
fn att_error_invalid_attribute_value_length() -> u32 { return 0x0D as u32; }
fn att_error_unlikely_error() -> u32 { return 0x0E as u32; }
fn att_error_insufficient_encryption() -> u32 { return 0x0F as u32; }
fn att_error_unsupported_group_type() -> u32 { return 0x10 as u32; }
fn att_error_insufficient_resources() -> u32 { return 0x11 as u32; }

// Round 66 follow-up: GATT discovery's own PDUs (§3.4.3 Find
// Information, §3.4.4.3 Read By Type, §3.4.4.9 Read By Group Type) --
// the actual operations GATT's service/characteristic discovery is
// built on top of (kernel_main.vani's own gatt_discover_* functions,
// below). Attribute_Type/Group_Type is always a 16-bit Bluetooth-SIG-
// assigned UUID in the *_uuid16 request builders below (Primary/
// Secondary Service, Characteristic Declaration, ...) -- every
// standard GATT service and characteristic TYPE is one of these, and
// gatt_discover_* only ever searches by these standard types, so
// that's all they use. A second later round-66 follow-up added *_
// uuid128 request-builder twins for a genuinely custom grouping/
// attribute type (§3.4.4.1/§3.4.4.9 both allow it), plus full
// decoding of 128-bit VALUES (a discovered service/characteristic's
// own UUID, as opposed to the TYPE being searched for) into gatt_
// state.S's own uuid128 storage. Find Information's own response CAN
// report either 16-bit or 128-bit UUIDs for the DISCOVERED attribute
// (its `Format` byte) -- parsed generically below via that field rather than
// assumed, even though this round's own callers (GATT descriptor
// discovery) only ever need the 16-bit case.

// Find Information Request (§3.4.3.1): [Opcode][Starting_Handle (2,
// LE)][Ending_Handle (2, LE)].
fn att_build_find_information_request(out_buf: mut ref i64, starting_handle: u32, ending_handle: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_find_information_request());
  let _ = buf_write_u16_le(out_buf, 1, starting_handle);
  let _ = buf_write_u16_le(out_buf, 3, ending_handle);
  return 5;
}

fn att_opcode_find_information_request() -> u32 { return 0x04 as u32; }
fn att_opcode_find_information_response() -> u32 { return 0x05 as u32; }

// Find Information Response (§3.4.3.2): [Opcode][Format (1, 0x01=16-
// bit UUIDs/0x02=128-bit UUIDs)][Information Data: repeating (Handle
// (2, LE), UUID (2 or 16 bytes)) pairs, as many as fit under ATT_MTU].
fn att_find_information_response_get_format(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 1 as u32);
}

fn att_find_information_entry_size(format: u32) -> i64 {
  if format == (1 as u32) { return 4; } // 2 (handle) + 2 (16-bit UUID)
  return 18; // 2 (handle) + 16 (128-bit UUID)
}

fn att_find_information_response_count(buf: mut ref i64, pdu_len: i64) -> i64 {
  let format: u32 = att_find_information_response_get_format(buf);
  let entry_size: i64 = att_find_information_entry_size(format);
  return (pdu_len - 2) / entry_size;
}

fn att_find_information_response_get_handle_at(buf: mut ref i64, index: i64) -> u32 {
  let format: u32 = att_find_information_response_get_format(buf);
  let entry_size: i64 = att_find_information_entry_size(format);
  return buf_read_u16_le(buf, 2 + (index * entry_size));
}

// Only meaningful when the response's own format is 1 (16-bit UUIDs)
// -- caller's own job to check att_find_information_response_get_
// format first, same "don't guess, the caller already knows enough to
// ask correctly" posture as every other accessor in this file.
fn att_find_information_response_get_uuid16_at(buf: mut ref i64, index: i64) -> u32 {
  return buf_read_u16_le(buf, 2 + (index * 4) + 2);
}

// Round 66 follow-up: the 128-bit-custom-UUID twin of the accessor
// above -- only meaningful when the response's own format is 2
// (caller's own job to check, same posture as the 16-bit case).
// entry_size for format 2 is 18 (2 handle + 16 UUID), per att_find_
// information_entry_size.
fn att_find_information_response_get_uuid128_at(buf: mut ref i64, index: i64, out_uuid128: mut ref i64) -> i64 {
  let base: i64 = 2 + (index * 18) + 2;
  let i: i64 = 0;
  while i < 16 {
    let b: u32 = buf_read_byte(buf, (base + i) as u32);
    let _ = buf_write_byte(out_uuid128, i as u32, b);
    i = i + 1;
  }
  return 16;
}

// Byte-for-byte comparison of two 16-byte UUIDs -- the only sane way
// to compare a 128-bit value in a language whose largest native
// integer is i64. Returns 1 if equal, 0 otherwise.
fn uuid128_equal(a: mut ref i64, b: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 16 {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Read By Type Request (§3.4.4.1): [Opcode][Starting_Handle (2, LE)]
// [Ending_Handle (2, LE)][Attribute_Type (2, LE, 16-bit UUID)].
fn att_opcode_read_by_type_request() -> u32 { return 0x08 as u32; }
fn att_opcode_read_by_type_response() -> u32 { return 0x09 as u32; }

fn att_build_read_by_type_request_uuid16(out_buf: mut ref i64, starting_handle: u32, ending_handle: u32, attribute_type_uuid16: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_by_type_request());
  let _ = buf_write_u16_le(out_buf, 1, starting_handle);
  let _ = buf_write_u16_le(out_buf, 3, ending_handle);
  let _ = buf_write_u16_le(out_buf, 5, attribute_type_uuid16);
  return 7;
}

// Round 66 follow-up: 128-bit-custom-UUID twin -- same PDU shape,
// Attribute_Type is 16 raw bytes instead of one LE u16 (§3.4.4.1 makes
// this a real spec option, needed for "Read Using Characteristic
// UUID"-style lookups against a vendor-specific characteristic type,
// though this round's own gatt_discover_* never call it -- they only
// ever search for the standard 16-bit Characteristic Declaration type
// 0x2803, decoding a possibly-128-bit VALUE afterward instead; this is
// a spec-complete primitive for a caller with a genuinely custom
// TYPE to search for).
fn att_build_read_by_type_request_uuid128(out_buf: mut ref i64, starting_handle: u32, ending_handle: u32, attribute_type_uuid128: mut ref i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_by_type_request());
  let _ = buf_write_u16_le(out_buf, 1, starting_handle);
  let _ = buf_write_u16_le(out_buf, 3, ending_handle);
  let i: i64 = 0;
  while i < 16 {
    let b: u32 = buf_read_byte(attribute_type_uuid128, i as u32);
    let _ = buf_write_byte(out_buf, (5 + i) as u32, b);
    i = i + 1;
  }
  return 21;
}

// Read By Type Response (§3.4.4.2): [Opcode][Length (1, size of each
// handle-value pair, i.e. 2 + value size)][Attribute Data List:
// repeating (Handle (2, LE), Value (Length-2 bytes)) pairs].
fn att_read_by_type_response_get_entry_len(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 1 as u32);
}

fn att_read_by_type_response_count(buf: mut ref i64, pdu_len: i64) -> i64 {
  let entry_len: i64 = att_read_by_type_response_get_entry_len(buf) as i64;
  if entry_len <= 0 { return 0; }
  return (pdu_len - 2) / entry_len;
}

fn att_read_by_type_response_get_handle_at(buf: mut ref i64, index: i64) -> u32 {
  let entry_len: i64 = att_read_by_type_response_get_entry_len(buf) as i64;
  return buf_read_u16_le(buf, 2 + (index * entry_len));
}

fn att_read_by_type_response_get_value_len(buf: mut ref i64) -> i64 {
  return (att_read_by_type_response_get_entry_len(buf) as i64) - 2;
}

fn att_read_by_type_response_get_value_at(buf: mut ref i64, index: i64, out_value: mut ref i64) -> i64 {
  let entry_len: i64 = att_read_by_type_response_get_entry_len(buf) as i64;
  let value_len: i64 = entry_len - 2;
  let base: i64 = 2 + (index * entry_len) + 2;
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(buf, (base + i) as u32);
    let _ = buf_write_byte(out_value, i as u32, b);
    i = i + 1;
  }
  return value_len;
}

// Read By Group Type Request (§3.4.4.9): identical shape to Read By
// Type Request above (only the semantics of what's being searched for
// differ -- grouping attribute TYPES, like Primary Service, rather
// than any attribute type), so it reuses the same 16-bit-UUID-only
// request encoding.
fn att_opcode_read_by_group_type_request() -> u32 { return 0x10 as u32; }
fn att_opcode_read_by_group_type_response() -> u32 { return 0x11 as u32; }

fn att_build_read_by_group_type_request_uuid16(out_buf: mut ref i64, starting_handle: u32, ending_handle: u32, group_type_uuid16: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_by_group_type_request());
  let _ = buf_write_u16_le(out_buf, 1, starting_handle);
  let _ = buf_write_u16_le(out_buf, 3, ending_handle);
  let _ = buf_write_u16_le(out_buf, 5, group_type_uuid16);
  return 7;
}

// Round 66 follow-up: 128-bit-custom-UUID twin, same reasoning as
// att_build_read_by_type_request_uuid128 above -- gatt_discover_
// primary_services never calls this either (Primary Service, 0x2800,
// is always a 16-bit standard type; it's the discovered service's own
// VALUE that can be 128-bit), a spec-complete primitive for a caller
// searching by a genuinely custom GROUPING type instead.
fn att_build_read_by_group_type_request_uuid128(out_buf: mut ref i64, starting_handle: u32, ending_handle: u32, group_type_uuid128: mut ref i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, att_opcode_read_by_group_type_request());
  let _ = buf_write_u16_le(out_buf, 1, starting_handle);
  let _ = buf_write_u16_le(out_buf, 3, ending_handle);
  let i: i64 = 0;
  while i < 16 {
    let b: u32 = buf_read_byte(group_type_uuid128, i as u32);
    let _ = buf_write_byte(out_buf, (5 + i) as u32, b);
    i = i + 1;
  }
  return 21;
}

// Read By Group Type Response (§3.4.4.10): [Opcode][Length (1, size of
// each group, i.e. 4 + value size)][Attribute Data List: repeating
// (Attribute_Handle (2, LE), End_Group_Handle (2, LE), Value
// (Length-4 bytes)) groups] -- e.g. one group per discovered service,
// value = the service's own UUID, Attribute_Handle/End_Group_Handle =
// the service's whole attribute-handle range (its declaration handle
// through its last characteristic/descriptor before the next
// service).
fn att_read_by_group_type_response_get_entry_len(buf: mut ref i64) -> u32 {
  return buf_read_byte(buf, 1 as u32);
}

fn att_read_by_group_type_response_count(buf: mut ref i64, pdu_len: i64) -> i64 {
  let entry_len: i64 = att_read_by_group_type_response_get_entry_len(buf) as i64;
  if entry_len <= 0 { return 0; }
  return (pdu_len - 2) / entry_len;
}

fn att_read_by_group_type_response_get_start_handle_at(buf: mut ref i64, index: i64) -> u32 {
  let entry_len: i64 = att_read_by_group_type_response_get_entry_len(buf) as i64;
  return buf_read_u16_le(buf, 2 + (index * entry_len));
}

fn att_read_by_group_type_response_get_end_handle_at(buf: mut ref i64, index: i64) -> u32 {
  let entry_len: i64 = att_read_by_group_type_response_get_entry_len(buf) as i64;
  return buf_read_u16_le(buf, 2 + (index * entry_len) + 2);
}

fn att_read_by_group_type_response_get_value_len(buf: mut ref i64) -> i64 {
  return (att_read_by_group_type_response_get_entry_len(buf) as i64) - 4;
}

fn att_read_by_group_type_response_get_value_at(buf: mut ref i64, index: i64, out_value: mut ref i64) -> i64 {
  let entry_len: i64 = att_read_by_group_type_response_get_entry_len(buf) as i64;
  let value_len: i64 = entry_len - 4;
  let base: i64 = 2 + (index * entry_len) + 4;
  let i: i64 = 0;
  while i < value_len {
    let b: u32 = buf_read_byte(buf, (base + i) as u32);
    let _ = buf_write_byte(out_value, i as u32, b);
    i = i + 1;
  }
  return value_len;
}

// GATT (Generic Attribute Profile, Bluetooth Core Spec Vol 3 Part G) --
// the semantic layer this project's own ATT operations above exist to
// serve: services and characteristics are just conventionally-typed
// attributes (Primary Service = attribute type 0x2800, Characteristic
// Declaration = 0x2803, ...), discovered via ATT's own Read By Group
// Type/Read By Type procedures rather than any GATT-specific PDU of
// their own -- GATT defines the PROCEDURE (§4.3.1's own "Discover All
// Primary Services", §4.6.1's "Discover All Characteristics of a
// Service"), not new wire format. This round builds the CLIENT role
// only (Dhruva as the connecting central, per hci_build_le_create_
// connection_command's own direction) -- a GATT SERVER role (Dhruva
// exposing its own attributes for something else to discover) is a
// separate, additional direction, not attempted here.
fn gatt_uuid_primary_service() -> u32 { return 0x2800 as u32; }
fn gatt_uuid_secondary_service() -> u32 { return 0x2801 as u32; }
fn gatt_uuid_include() -> u32 { return 0x2802 as u32; }
fn gatt_uuid_characteristic() -> u32 { return 0x2803 as u32; }
fn gatt_uuid_char_extended_properties() -> u32 { return 0x2900 as u32; }
fn gatt_uuid_char_user_description() -> u32 { return 0x2901 as u32; }
fn gatt_uuid_client_char_configuration() -> u32 { return 0x2902 as u32; }
fn gatt_uuid_server_char_configuration() -> u32 { return 0x2903 as u32; }
fn gatt_uuid_char_presentation_format() -> u32 { return 0x2904 as u32; }
fn gatt_uuid_char_aggregate_format() -> u32 { return 0x2905 as u32; }

// Wraps one ATT PDU in its L2CAP B-frame (fixed ATT channel) and HCI
// ACL Data envelope, then sends it over the already-established
// connection's bulk OUT endpoint. gatt_send_scratch is reused across
// every call (never a fresh dhruva_alloc_bytes) since this is the
// actual per-request send path, not a one-time setup call -- same
// "repeatable real caller needs persistent scratch" reasoning as
// net_send_scratch's own comment. hci_acl_build_header is reused
// directly (the ACL header genuinely belongs at this buffer's own
// offset 0); the L2CAP header's own 2 fields are written inline at
// offset 4 instead of via l2cap_build_header, which assumes offset 0
// and has no way to target a sub-region of an existing buffer (vani
// has no pointer arithmetic to hand it a "buf + 4" view).
fn gatt_att_send(devaddr: u32, mps: u32, conn_handle: u32, att_pdu: mut ref i64, att_pdu_len: i64) -> i64 {
  let buf: mut ref i64 = gatt_send_scratch_get();
  let l2cap_total_len: u32 = (4 + att_pdu_len) as u32;
  let _ = hci_acl_build_header(buf, conn_handle, hci_acl_pb_flag_first(), hci_acl_bc_flag_point_to_point(), l2cap_total_len);
  let _ = buf_write_u16_le(buf, 4, att_pdu_len as u32);
  let _ = buf_write_u16_le(buf, 6, l2cap_att_channel_id());
  let i: i64 = 0;
  while i < att_pdu_len {
    let b: u32 = buf_read_byte(att_pdu, i as u32);
    let _ = buf_write_byte(buf, (8 + i) as u32, b);
    i = i + 1;
  }
  return dwc2_bt_bulk_out(devaddr, mps, buf, 8 + att_pdu_len);
}

// Receives one ACL data packet, unwraps its L2CAP B-frame, and copies
// the ATT PDU it carries into out_att_pdu -- the receive-side twin of
// gatt_att_send above. Deliberately assumes the whole L2CAP PDU always
// fits in a single ACL packet (this round's own ATT operations never
// build anything close to a real LE data-length-extension packet's own
// size), matching how netif_recv_frame's own LAN9512 branch documents
// the identical "one frame per transfer" simplification. A non-ATT
// channel ID (L2CAP Signaling, SMP, ...) or a declared length exceeding
// what was actually delivered is rejected outright -- same "reject,
// don't guess" posture as every other wire-format boundary check in
// this project.
fn gatt_att_recv(devaddr: u32, mps: u32, out_att_pdu: mut ref i64) -> i64 {
  let buf: mut ref i64 = gatt_recv_scratch_get();
  let recv_len: i64 = dwc2_bt_bulk_in(devaddr, mps, buf, mps as i64);
  if recv_len < 8 {
    return 0 - 1; // too short to hold ACL header (4) + L2CAP header (4), or nothing was waiting
  }
  let channel_id: u32 = buf_read_u16_le(buf, 6);
  if channel_id != l2cap_att_channel_id() {
    return 0 - 1; // not ATT (Signaling goes through l2cap_sig_recv instead, SMP still out of scope)
  }
  let att_pdu_len: i64 = buf_read_u16_le(buf, 4) as i64;
  if (8 + att_pdu_len) > recv_len {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < att_pdu_len {
    let b: u32 = buf_read_byte(buf, (8 + i) as u32);
    let _ = buf_write_byte(out_att_pdu, i as u32, b);
    i = i + 1;
  }
  return att_pdu_len;
}

// Round 66 follow-up: the L2CAP Signaling twin of gatt_att_send above
// -- identical ACL/L2CAP envelope, just the Signaling fixed channel
// (0x0005) instead of ATT (0x0004). Reuses gatt_send_scratch (same
// "repeatable real caller needs persistent scratch" reasoning as that
// function's own comment -- Signaling and ATT traffic are never
// in-flight at the same instant in this project's own single-
// threaded, one-frame-per-transfer BLE driver model, so sharing the
// scratch buffer is safe, not a real conflict).
fn l2cap_sig_send(devaddr: u32, mps: u32, conn_handle: u32, sig_pdu: mut ref i64, sig_pdu_len: i64) -> i64 {
  let buf: mut ref i64 = gatt_send_scratch_get();
  let l2cap_total_len: u32 = (4 + sig_pdu_len) as u32;
  let _ = hci_acl_build_header(buf, conn_handle, hci_acl_pb_flag_first(), hci_acl_bc_flag_point_to_point(), l2cap_total_len);
  let _ = buf_write_u16_le(buf, 4, sig_pdu_len as u32);
  let _ = buf_write_u16_le(buf, 6, l2cap_signaling_channel_id());
  let i: i64 = 0;
  while i < sig_pdu_len {
    let b: u32 = buf_read_byte(sig_pdu, i as u32);
    let _ = buf_write_byte(buf, (8 + i) as u32, b);
    i = i + 1;
  }
  return dwc2_bt_bulk_out(devaddr, mps, buf, 8 + sig_pdu_len);
}

// The L2CAP Signaling twin of gatt_att_recv -- same "one frame per
// transfer" simplification and "reject, don't guess" length checks,
// same shared gatt_recv_scratch. A REAL limitation, stated plainly
// rather than hidden: a caller polling for Signaling commands via
// this function and ATT PDUs via gatt_att_recv on two SEPARATE calls
// will silently drop whichever type's packet arrives while polling
// for the other (each function only accepts its own channel ID and
// discards anything else) -- this project's BLE work has no frame
// queue/demux layer. In practice this is fine: a caller runs GATT
// operations in their own tight request/response loop and calls
// l2cap_sig_poll BETWEEN them (e.g. once per gatt_client_poll_
// notifications iteration), not concurrently with an in-flight GATT
// request -- matching how a real peripheral's own Connection
// Parameter Update Request timing works in practice (sent once,
// shortly after connection, not mid-transaction).
fn l2cap_sig_recv(devaddr: u32, mps: u32, out_sig_pdu: mut ref i64) -> i64 {
  let buf: mut ref i64 = gatt_recv_scratch_get();
  let recv_len: i64 = dwc2_bt_bulk_in(devaddr, mps, buf, mps as i64);
  if recv_len < 8 {
    return 0 - 1;
  }
  let channel_id: u32 = buf_read_u16_le(buf, 6);
  if channel_id != l2cap_signaling_channel_id() {
    return 0 - 1;
  }
  let sig_pdu_len: i64 = buf_read_u16_le(buf, 4) as i64;
  if (8 + sig_pdu_len) > recv_len {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < sig_pdu_len {
    let b: u32 = buf_read_byte(buf, (8 + i) as u32);
    let _ = buf_write_byte(out_sig_pdu, i as u32, b);
    i = i + 1;
  }
  return sig_pdu_len;
}

// Receives and dispatches ONE Signaling command: Connection Parameter
// Update Request gets auto-accepted (0x0000) and answered, matching
// many real central stacks' own default behavior of not second-
// guessing a peripheral's requested interval/latency/timeout this
// round (a caller wanting real validation would read the raw fields
// via l2cap_conn_param_update_request_get_* itself instead of calling
// this). Any other Signaling command is genuinely out of scope (see
// this file's own l2cap_sig_code_connection_parameter_update_request
// comment) and is simply ignored, not rejected -- L2CAP Signaling has
// no generic "Command Reject" response built here since nothing this
// round's own driver does would trigger sending one. Returns 0 on a
// normal receive-dispatch-respond cycle, -1 if nothing was waiting or
// it wasn't a Connection Parameter Update Request.
fn l2cap_sig_poll(devaddr: u32, mps: u32, conn_handle: u32) -> i64 {
  let req: mut ref i64 = dhruva_alloc_bytes(256);
  let req_len: i64 = l2cap_sig_recv(devaddr, mps, req);
  if req_len < 0 {
    return 0 - 1;
  }
  let code: u32 = l2cap_sig_get_code(req);
  if code != l2cap_sig_code_connection_parameter_update_request() {
    return 0 - 1;
  }
  let identifier: u32 = l2cap_sig_get_identifier(req);
  let rsp: mut ref i64 = dhruva_alloc_bytes(6);
  let rsp_len: i64 = l2cap_build_conn_param_update_response(rsp, identifier, l2cap_conn_param_update_result_accepted());
  let send_status: i64 = l2cap_sig_send(devaddr, mps, conn_handle, rsp, rsp_len);
  if send_status != 0 {
    return 0 - 1;
  }
  return 0;
}

// Clears both discovery tables -- called once at the start of a fresh
// connection's own discovery phase (a stale previous connection's
// services/characteristics must never leak into a new one's results).
fn gatt_discover_reset() -> i64 {
  let _ = gatt_service_set_count(0 as u32);
  let _ = gatt_char_set_count(0 as u32);
  return 0;
}

// Discover All Primary Services (§4.3.1): repeats Read By Group Type
// (group type = Primary Service) with a narrowing starting handle
// until an Attribute Not Found error signals "nothing left to
// discover" -- the standard GATT discovery procedure shape every
// other discovery function below also follows. Returns the number of
// services discovered (capped at gatt_state.S's own 8-service table),
// or -1 on a real transport/protocol error (not on the normal
// Attribute-Not-Found end condition, which is success, not failure).
fn gatt_discover_primary_services(devaddr: u32, mps: u32, conn_handle: u32) -> i64 {
  let req: mut ref i64 = dhruva_alloc_bytes(7);
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let value: mut ref i64 = dhruva_alloc_bytes(16);
  let starting_handle: u32 = 1 as u32;
  let done: i64 = 0;
  while done == 0 {
    let req_len: i64 = att_build_read_by_group_type_request_uuid16(req, starting_handle, 0xFFFF as u32, gatt_uuid_primary_service());
    let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
    if send_status != 0 {
      return 0 - 1;
    }
    let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
    if rsp_len < 0 {
      return 0 - 1;
    }
    let opcode: u32 = att_get_opcode(rsp);
    if opcode == att_opcode_error_response() {
      if att_error_code(rsp) == att_error_attribute_not_found() {
        done = 1;
      } else {
        return 0 - 1;
      }
    } else {
      if opcode != att_opcode_read_by_group_type_response() {
        return 0 - 1;
      }
      let count: i64 = att_read_by_group_type_response_count(rsp, rsp_len);
      if count <= 0 {
        done = 1;
      } else {
        let i: i64 = 0;
        while i < count {
          let start_h: u32 = att_read_by_group_type_response_get_start_handle_at(rsp, i);
          let end_h: u32 = att_read_by_group_type_response_get_end_handle_at(rsp, i);
          let val_len: i64 = att_read_by_group_type_response_get_value_at(rsp, i, value);
          // Round 66 follow-up: 128-bit custom service UUIDs
          // (val_len==16) are now decoded and stored in full via
          // gatt_service_uuid128 -- uuid16 stays 0 as a "check is_
          // uuid128 instead" marker for this case, no longer a "not
          // decoded" sentinel.
          let uuid16: u32 = if val_len == 2 { buf_read_u16_le(value, 0) } else { 0 as u32 };
          let is_uuid128: u32 = if val_len == 16 { 1 as u32 } else { 0 as u32 };
          let svc_index: i64 = gatt_service_get_count();
          if svc_index < 8 {
            let _ = gatt_service_set_start_handle_at(svc_index as u32, start_h);
            let _ = gatt_service_set_end_handle_at(svc_index as u32, end_h);
            let _ = gatt_service_set_uuid16_at(svc_index as u32, uuid16);
            let _ = gatt_service_set_is_uuid128_at(svc_index as u32, is_uuid128);
            if is_uuid128 == (1 as u32) {
              let k: i64 = 0;
              while k < 16 {
                let b: u32 = buf_read_byte(value, k as u32);
                let _ = gatt_service_set_uuid128_byte((svc_index * 16 + k) as u32, b);
                k = k + 1;
              }
            }
            let _ = gatt_service_set_count((svc_index + 1) as u32);
          }
          i = i + 1;
        }
        let last_end_h: u32 = att_read_by_group_type_response_get_end_handle_at(rsp, count - 1);
        if last_end_h == (0xFFFF as u32) {
          done = 1;
        } else {
          starting_handle = last_end_h + (1 as u32);
        }
      }
    }
  }
  return gatt_service_get_count();
}

// Discover All Characteristics of a Service (§4.6.1): Read By Type
// (attribute type = Characteristic Declaration) within one already-
// discovered service's own handle range, same repeat-until-Attribute-
// Not-Found shape as service discovery above. A Characteristic
// Declaration's own value is [Properties (1)][Value_Handle (2, LE)]
// [Characteristic_UUID (2 or 16 bytes)] -- both the 16-bit and 128-bit
// (round 66 follow-up) cases are decoded and stored, matching gatt_
// discover_primary_services' own equivalent fix. Returns the number
// of characteristics discovered for THIS service (not the running
// total across all services), or -1 on a real error.
fn gatt_discover_characteristics_for_service(devaddr: u32, mps: u32, conn_handle: u32, service_index: i64) -> i64 {
  let start_h: u32 = gatt_service_get_start_handle_at(service_index as u32) as u32;
  let end_h: u32 = gatt_service_get_end_handle_at(service_index as u32) as u32;
  let req: mut ref i64 = dhruva_alloc_bytes(7);
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let value: mut ref i64 = dhruva_alloc_bytes(19);
  let starting_handle: u32 = start_h;
  let done: i64 = 0;
  let found_this_service: i64 = 0;
  while done == 0 {
    let req_len: i64 = att_build_read_by_type_request_uuid16(req, starting_handle, end_h, gatt_uuid_characteristic());
    let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
    if send_status != 0 {
      return 0 - 1;
    }
    let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
    if rsp_len < 0 {
      return 0 - 1;
    }
    let opcode: u32 = att_get_opcode(rsp);
    if opcode == att_opcode_error_response() {
      if att_error_code(rsp) == att_error_attribute_not_found() {
        done = 1;
      } else {
        return 0 - 1;
      }
    } else {
      if opcode != att_opcode_read_by_type_response() {
        return 0 - 1;
      }
      let count: i64 = att_read_by_type_response_count(rsp, rsp_len);
      if count <= 0 {
        done = 1;
      } else {
        let i: i64 = 0;
        let last_decl_h: u32 = starting_handle;
        while i < count {
          let decl_h: u32 = att_read_by_type_response_get_handle_at(rsp, i);
          let val_len: i64 = att_read_by_type_response_get_value_at(rsp, i, value);
          if val_len >= 5 {
            let properties: u32 = buf_read_byte(value, 0 as u32);
            let value_h: u32 = buf_read_u16_le(value, 1);
            // Round 66 follow-up: a Characteristic Declaration's own
            // UUID field is either 2 bytes (val_len==5 total) or 16
            // bytes (val_len==19 total, a genuinely custom
            // characteristic type) -- both now decoded and stored in
            // full, matching gatt_discover_primary_services' own
            // service-side fix above.
            let uuid16: u32 = if val_len == 5 { buf_read_u16_le(value, 3) } else { 0 as u32 };
            let is_uuid128: u32 = if val_len == 19 { 1 as u32 } else { 0 as u32 };
            let char_index: i64 = gatt_char_get_count();
            if char_index < 32 {
              let _ = gatt_char_set_decl_handle_at(char_index as u32, decl_h);
              let _ = gatt_char_set_properties_at(char_index as u32, properties);
              let _ = gatt_char_set_value_handle_at(char_index as u32, value_h);
              let _ = gatt_char_set_uuid16_at(char_index as u32, uuid16);
              let _ = gatt_char_set_is_uuid128_at(char_index as u32, is_uuid128);
              if is_uuid128 == (1 as u32) {
                let k: i64 = 0;
                while k < 16 {
                  let b: u32 = buf_read_byte(value, (3 + k) as u32);
                  let _ = gatt_char_set_uuid128_byte((char_index * 16 + k) as u32, b);
                  k = k + 1;
                }
              }
              let _ = gatt_char_set_service_index_at(char_index as u32, service_index as u32);
              let _ = gatt_char_set_count((char_index + 1) as u32);
              found_this_service = found_this_service + 1;
            }
          }
          last_decl_h = decl_h;
          i = i + 1;
        }
        if (last_decl_h >= end_h) || (last_decl_h == (0xFFFF as u32)) {
          done = 1;
        } else {
          starting_handle = last_decl_h + (1 as u32);
        }
      }
    }
  }
  return found_this_service;
}

// Orchestrates the full discovery phase for a freshly-established
// connection: reset both tables, discover every primary service, then
// discover every characteristic within each one. Returns the total
// characteristic count across all services, or -1 on a real error
// from either sub-procedure -- a caller wanting per-service detail
// should call gatt_discover_primary_services/_characteristics_for_
// service directly instead, this is the "just get everything" entry
// point.
fn gatt_discover_all(devaddr: u32, mps: u32, conn_handle: u32) -> i64 {
  let _ = gatt_discover_reset();
  let service_count: i64 = gatt_discover_primary_services(devaddr, mps, conn_handle);
  if service_count < 0 {
    return 0 - 1;
  }
  let s: i64 = 0;
  while s < service_count {
    let char_status: i64 = gatt_discover_characteristics_for_service(devaddr, mps, conn_handle, s);
    if char_status < 0 {
      return 0 - 1;
    }
    s = s + 1;
  }
  return gatt_char_get_count();
}

// Reads one already-discovered characteristic's own value, by index
// into gatt_char_*'s own table (not a raw ATT handle -- the caller
// works in terms of what gatt_discover_all/_characteristics_for_
// service already found, not protocol-level handles directly).
// Returns the value's own length (copied into out_value), or -1 on a
// real transport/protocol error or an unexpected response PDU.
fn gatt_read_characteristic_value(devaddr: u32, mps: u32, conn_handle: u32, char_index: i64, out_value: mut ref i64) -> i64 {
  let value_handle: u32 = gatt_char_get_value_handle_at(char_index as u32) as u32;
  let req: mut ref i64 = dhruva_alloc_bytes(3);
  let req_len: i64 = att_build_read_request(req, value_handle);
  let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
  if send_status != 0 {
    return 0 - 1;
  }
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
  if rsp_len < 0 {
    return 0 - 1;
  }
  let opcode: u32 = att_get_opcode(rsp);
  if opcode != att_opcode_read_response() {
    return 0 - 1;
  }
  return att_read_response_get_value(rsp, rsp_len, out_value);
}

// Writes one already-discovered characteristic's own value, same
// index-into-the-discovery-table convention as the read path above.
// value must be <= 253 bytes (256-byte scratch minus the 3-byte ATT
// Write Request header) -- comfortably above any real default LE
// ATT_MTU's own payload capacity (20 bytes), rejected outright rather
// than silently truncated if a caller ever passed something absurd.
// Returns 0 on a confirmed Write Response, or -1 on a real error.
fn gatt_write_characteristic_value(devaddr: u32, mps: u32, conn_handle: u32, char_index: i64, value: mut ref i64, value_len: i64) -> i64 {
  if value_len > 253 {
    return 0 - 1;
  }
  let value_handle: u32 = gatt_char_get_value_handle_at(char_index as u32) as u32;
  let req: mut ref i64 = dhruva_alloc_bytes(256);
  let req_len: i64 = att_build_write_request(req, value_handle, value, value_len);
  let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
  if send_status != 0 {
    return 0 - 1;
  }
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
  if rsp_len < 0 {
    return 0 - 1;
  }
  let opcode: u32 = att_get_opcode(rsp);
  if opcode != att_opcode_write_response() {
    return 0 - 1;
  }
  return 0;
}

// Round 66 follow-up: characteristic descriptor discovery + CCCD
// subscription + notification/indication receive -- the piece
// gatt_discover_characteristics_for_service's own scope explicitly
// left out (descriptors are a THIRD kind of attribute, discovered
// within a characteristic's own narrow handle range via Find
// Information, §4.7.1 "Discover All Characteristic Descriptors" --
// not Read By Type/Group Type like services/characteristics
// themselves). This round only looks for the Client Characteristic
// Configuration Descriptor (CCCD, UUID 0x2902) specifically -- the
// ONE descriptor actually needed to subscribe to notifications/
// indications, not a generic "record every descriptor" table (this
// project doesn't have a use for User Description/Presentation
// Format/etc descriptors yet, and adding a third fixed-size table for
// them with no caller isn't justified by anything real this round
// needs).

// A characteristic's own descriptor range ends right before the NEXT
// characteristic in the SAME service (their declaration handles are
// contiguous and ascending, exactly how gatt_discover_characteristics_
// for_service already populated the table), or at the service's own
// end handle if this is the last characteristic in it.
fn gatt_char_descriptor_range_end(char_index: i64) -> u32 {
  let service_index: i64 = gatt_char_get_service_index_at(char_index as u32);
  let count: i64 = gatt_char_get_count();
  let next_index: i64 = char_index + 1;
  if (next_index < count) && (gatt_char_get_service_index_at(next_index as u32) == service_index) {
    let next_decl_h: u32 = gatt_char_get_decl_handle_at(next_index as u32) as u32;
    return next_decl_h - (1 as u32);
  }
  return gatt_service_get_end_handle_at(service_index as u32) as u32;
}

// Discover All Characteristic Descriptors (§4.7.1), scoped to finding
// the CCCD only (see this section's own header comment) -- same
// repeat-Find-Information-until-Attribute-Not-Found shape as every
// other discovery function in this file. Returns 1 if a CCCD was
// found and recorded, 0 if this characteristic genuinely has none (not
// an error -- plenty of real characteristics, e.g. read-only ones,
// never have one), or -1 on a real transport/protocol error.
fn gatt_discover_descriptors_for_characteristic(devaddr: u32, mps: u32, conn_handle: u32, char_index: i64) -> i64 {
  let value_h: u32 = gatt_char_get_value_handle_at(char_index as u32) as u32;
  let range_end: u32 = gatt_char_descriptor_range_end(char_index);
  if value_h >= range_end {
    return 0; // no handle room for any descriptor
  }
  let req: mut ref i64 = dhruva_alloc_bytes(5);
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let starting_handle: u32 = value_h + (1 as u32);
  let done: i64 = 0;
  let found: i64 = 0;
  while done == 0 {
    let req_len: i64 = att_build_find_information_request(req, starting_handle, range_end);
    let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
    if send_status != 0 {
      return 0 - 1;
    }
    let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
    if rsp_len < 0 {
      return 0 - 1;
    }
    let opcode: u32 = att_get_opcode(rsp);
    if opcode == att_opcode_error_response() {
      if att_error_code(rsp) == att_error_attribute_not_found() {
        done = 1;
      } else {
        return 0 - 1;
      }
    } else {
      if opcode != att_opcode_find_information_response() {
        return 0 - 1;
      }
      let count: i64 = att_find_information_response_count(rsp, rsp_len);
      if count <= 0 {
        done = 1;
      } else {
        let format: u32 = att_find_information_response_get_format(rsp);
        let i: i64 = 0;
        let last_h: u32 = starting_handle;
        while i < count {
          let h: u32 = att_find_information_response_get_handle_at(rsp, i);
          if format == (1 as u32) {
            let uuid: u32 = att_find_information_response_get_uuid16_at(rsp, i);
            if uuid == gatt_uuid_client_char_configuration() {
              let _ = gatt_char_set_cccd_handle_at(char_index as u32, h);
              found = 1;
            }
          }
          last_h = h;
          i = i + 1;
        }
        if (last_h >= range_end) || (last_h == (0xFFFF as u32)) {
          done = 1;
        } else {
          starting_handle = last_h + (1 as u32);
        }
      }
    }
  }
  return found;
}

// Subscribes to (or unsubscribes from) a characteristic's own
// notifications/indications by writing the CCCD gatt_discover_
// descriptors_for_characteristic already found -- §3.3.3.3's own bit
// layout: bit0 = Notifications enabled, bit1 = Indications enabled.
// Returns -1 if no CCCD was ever discovered for this characteristic
// (gatt_discover_descriptors_for_characteristic wasn't called, or
// found none), matching this project's own "reject, don't guess"
// posture rather than silently writing to handle 0.
fn gatt_client_write_cccd(devaddr: u32, mps: u32, conn_handle: u32, char_index: i64, enable_notify: u32, enable_indicate: u32) -> i64 {
  let cccd_handle: u32 = gatt_char_get_cccd_handle_at(char_index as u32) as u32;
  if cccd_handle == (0 as u32) {
    return 0 - 1;
  }
  let bits: u32 = (if enable_notify != (0 as u32) { 0x01 as u32 } else { 0 as u32 }) | (if enable_indicate != (0 as u32) { 0x02 as u32 } else { 0 as u32 });
  let value: mut ref i64 = dhruva_alloc_bytes(2);
  let _ = buf_write_u16_le(value, 0, bits);
  let req: mut ref i64 = dhruva_alloc_bytes(5);
  let req_len: i64 = att_build_write_request(req, cccd_handle, value, 2);
  let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, req, req_len);
  if send_status != 0 {
    return 0 - 1;
  }
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let rsp_len: i64 = gatt_att_recv(devaddr, mps, rsp);
  if rsp_len < 0 {
    return 0 - 1;
  }
  let opcode: u32 = att_get_opcode(rsp);
  if opcode != att_opcode_write_response() {
    return 0 - 1;
  }
  return 0;
}

// Finds the discovery-table index of the characteristic whose own
// VALUE handle matches, or -1 if none does -- how gatt_client_poll_
// notifications (below) turns an incoming Notification/Indication's
// raw handle back into the caller's own table-index convention (the
// same convention gatt_read/write_characteristic_value already use).
// Pure table lookup, no transport involved.
fn gatt_client_find_char_index_for_value_handle(handle: u32) -> i64 {
  let count: i64 = gatt_char_get_count();
  let i: i64 = 0;
  while i < count {
    if (gatt_char_get_value_handle_at(i as u32) as u32) == handle {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// Receives one Notification or Indication (whichever arrives next --
// a caller runs this in its own poll loop, same shape as gatt_server_
// poll/l2cap_sig_poll), auto-sending the required Handle Value
// Confirmation if it was an Indication (§3.4.7.3 -- the server won't
// send another one until this arrives, so this is not optional
// caller-side bookkeeping, it's part of receiving an Indication
// correctly at all). The matching characteristic's own table index
// isn't returned directly (this function's own return value is
// value_len, matching gatt_read_characteristic_value's own
// convention) -- call gatt_client_last_notify_handle() then gatt_
// client_find_char_index_for_value_handle() to resolve it, kept as
// separate composable steps rather than baked into one wider
// signature. Returns -1 if nothing was waiting or it wasn't a
// Notification/Indication.
fn gatt_client_poll_notifications(devaddr: u32, mps: u32, conn_handle: u32, out_value: mut ref i64) -> i64 {
  let pdu: mut ref i64 = dhruva_alloc_bytes(256);
  let pdu_len: i64 = gatt_att_recv(devaddr, mps, pdu);
  if pdu_len < 0 {
    return 0 - 1;
  }
  let opcode: u32 = att_get_opcode(pdu);
  let is_indication: i64 = if opcode == att_opcode_handle_value_indication() { 1 } else { 0 };
  if (opcode != att_opcode_handle_value_notification()) && (is_indication == 0) {
    return 0 - 1;
  }
  let handle: u32 = att_handle_value_get_handle(pdu);
  let value_len: i64 = att_handle_value_get_value(pdu, pdu_len, out_value);
  let _ = gatt_last_notify_handle_set(handle);
  if is_indication == 1 {
    let conf: mut ref i64 = dhruva_alloc_bytes(1);
    let conf_len: i64 = att_build_handle_value_confirmation(conf);
    let _ = gatt_att_send(devaddr, mps, conn_handle, conf, conf_len);
  }
  return value_len;
}

fn gatt_client_last_notify_handle() -> u32 {
  return gatt_last_notify_handle_get() as u32;
}

// GATT SERVER role (round 66 follow-up -- user asked for the "full BLE
// stack", client role alone wasn't it). Dhruva exposes its OWN
// services/characteristics for something else to discover/read/write,
// over a connection Dhruva itself still establishes as central (this
// project's own HCI work only implements GAP central, never
// peripheral/advertising -- but GATT server role is independent of
// GAP central/peripheral role per spec, so this doesn't need
// peripheral HCI support at all). Backed by gatt_server_state.S's own
// flat, handle-ordered attribute table (32 attributes max) -- a
// "service" is one attribute (type 0x2800, value = the service's own
// UUID), a "characteristic" is two more (a 0x2803 declaration whose
// own value is the standard 5-byte [Properties][Value_Handle (2, LE)]
// [UUID (2)], then a separate value attribute typed by the
// characteristic's own UUID) -- matching the wire protocol directly,
// same reasoning as that file's own header comment.
//
// Scope, explicit: services/characteristics only, no descriptors of
// their own (no CCCD exposed on Dhruva's own attributes this round --
// notification/indication SUBSCRIPTION is a CLIENT-side concern,
// handled in gatt_client_write_cccd below against a REMOTE server;
// Dhruva's own server doesn't need to expose one just to serve reads/
// writes). 16-bit UUIDs only, matching the client side's own scoping
// this same round.

fn gatt_server_max_value_len() -> i64 { return 20; }

// Clears the attribute table -- same "never let a stale previous
// connection's state leak into a new one" reasoning as gatt_discover_
// reset, though here it's Dhruva's own exposed database being reset,
// not what it discovered on someone else.
fn gatt_server_reset() -> i64 {
  let _ = gatt_server_attr_set_count(0 as u32);
  return 0;
}

fn gatt_server_set_value_byte(attr_index: i64, byte_offset: i64, value: u32) -> i64 {
  let combined: i64 = (attr_index * gatt_server_max_value_len()) + byte_offset;
  return gatt_server_attr_set_value_byte(combined as u32, value);
}

fn gatt_server_get_value_byte(attr_index: i64, byte_offset: i64) -> u32 {
  let combined: i64 = (attr_index * gatt_server_max_value_len()) + byte_offset;
  return gatt_server_attr_get_value_byte(combined as u32) as u32;
}

// Appends one Primary Service attribute (§3.G.3.1) -- value is just
// the service's own 16-bit UUID, 2 bytes, little-endian, matching how
// gatt_discover_primary_services on the CLIENT side already expects to
// parse it back out via Read By Group Type. Returns the new
// attribute's own handle (index+1, GATT handles start at 1), or -1 if
// the table's own 32-attribute cap is already reached.
fn gatt_server_add_service(uuid16: u32) -> i64 {
  let index: i64 = gatt_server_attr_get_count();
  if index >= 32 {
    return 0 - 1;
  }
  let _ = gatt_server_attr_set_uuid16_at(index as u32, gatt_uuid_primary_service());
  let _ = gatt_server_attr_set_value_len_at(index as u32, 2 as u32);
  let _ = gatt_server_attr_set_writable_at(index as u32, 0 as u32);
  let _ = gatt_server_set_value_byte(index, 0, uuid16 & (0xFF as u32));
  let _ = gatt_server_set_value_byte(index, 1, (uuid16 >> (8 as u32)) & (0xFF as u32));
  let _ = gatt_server_attr_set_count((index + 1) as u32);
  return index + 1;
}

// Appends one characteristic -- ALWAYS two attributes at once (§3.G.3.3):
// a Characteristic Declaration (type 0x2803, value = [Properties (1)]
// [Value_Handle (2, LE)][UUID (2, LE)]) immediately followed by the
// Characteristic Value attribute itself (type = the characteristic's
// own UUID). Must be called after the service it belongs to (this
// project's own attribute table is handle-ordered, matching the wire
// format directly -- there's no other way to express "belongs to
// service X" than contiguous placement, same as a real GATT server's
// own database). initial_value_len is silently clamped to gatt_
// server_max_value_len() (20 bytes) -- comfortably above default LE
// ATT_MTU's own 20-byte payload cap, so this only ever bites a caller
// trying to seed something unrealistic. properties bit 3 (0x08,
// Write) controls whether gatt_server_handle_request's own Write
// Request dispatch accepts writes to this value at all -- reject,
// don't silently accept, an unauthorized write. Returns the new VALUE
// attribute's own handle (the one clients read/write), or -1 if the
// table doesn't have room for both attributes.
fn gatt_server_add_characteristic(properties: u32, char_uuid16: u32, initial_value: mut ref i64, initial_value_len: i64) -> i64 {
  let decl_index: i64 = gatt_server_attr_get_count();
  if (decl_index + 2) > 32 {
    return 0 - 1;
  }
  let value_index: i64 = decl_index + 1;
  let value_handle: i64 = value_index + 1;
  let _ = gatt_server_attr_set_uuid16_at(decl_index as u32, gatt_uuid_characteristic());
  let _ = gatt_server_attr_set_value_len_at(decl_index as u32, 5 as u32);
  let _ = gatt_server_attr_set_writable_at(decl_index as u32, 0 as u32);
  let _ = gatt_server_set_value_byte(decl_index, 0, properties);
  let _ = gatt_server_set_value_byte(decl_index, 1, (value_handle as u32) & (0xFF as u32));
  let _ = gatt_server_set_value_byte(decl_index, 2, ((value_handle as u32) >> (8 as u32)) & (0xFF as u32));
  let _ = gatt_server_set_value_byte(decl_index, 3, char_uuid16 & (0xFF as u32));
  let _ = gatt_server_set_value_byte(decl_index, 4, (char_uuid16 >> (8 as u32)) & (0xFF as u32));
  let clamped_len: i64 = if initial_value_len > gatt_server_max_value_len() { gatt_server_max_value_len() } else { initial_value_len };
  let _ = gatt_server_attr_set_uuid16_at(value_index as u32, char_uuid16);
  let _ = gatt_server_attr_set_value_len_at(value_index as u32, clamped_len as u32);
  let writable_flag: u32 = if (properties & (0x08 as u32)) != (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = gatt_server_attr_set_writable_at(value_index as u32, writable_flag);
  let i: i64 = 0;
  while i < clamped_len {
    let b: u32 = buf_read_byte(initial_value, i as u32);
    let _ = gatt_server_set_value_byte(value_index, i, b);
    i = i + 1;
  }
  let _ = gatt_server_attr_set_count((value_index + 1) as u32);
  return value_handle;
}

// Finds the table index of the attribute at a given HANDLE (index+1),
// or -1 if handle is out of range -- every dispatch handler below
// resolves an incoming request's own handle through this rather than
// assuming handle-1 is always safe to index with directly (an
// out-of-range or zero handle must be REJECTED, not underflow into a
// negative index).
fn gatt_server_find_index_for_handle(handle: u32) -> i64 {
  let count: i64 = gatt_server_attr_get_count();
  if (handle < (1 as u32)) || ((handle as i64) > count) {
    return 0 - 1;
  }
  return (handle as i64) - 1;
}

// Exchange MTU (§3.4.2.2) -- Dhruva's own server-side receive MTU is
// fixed at 247 (LE data-length-extension's own practical ceiling,
// comfortably above every value this project's own attributes ever
// hold), same "just advertise the real buffer capacity" posture as
// the CLIENT side's own att_build_exchange_mtu_request callers use.
fn gatt_server_handle_exchange_mtu(_req: mut ref i64, out_rsp: mut ref i64) -> i64 {
  return att_build_exchange_mtu_response(out_rsp, 247 as u32);
}

// Read By Group Type (§3.4.4.10) -- service discovery against Dhruva's
// own database. Scans the table for attributes matching group_type
// within [starting_handle, ending_handle], grouping each match's own
// END handle at the handle immediately before the NEXT matching
// attribute (or the table's own last handle if there isn't one) --
// same grouping semantics §2.5.3 defines for any grouping attribute
// type, not just Primary Service specifically (Secondary Service
// would group identically, though this project's own gatt_server_add_
// service only ever emits Primary Service attributes). Per §3.4.4.9's
// own response-uniformity rule, every entry in ONE response must
// share the same value length -- since Dhruva's own service UUIDs are
// always 2 bytes (16-bit only, this round's scoping), that's
// automatically satisfied; a genuinely mixed-length table isn't
// something this server ever builds. Returns response length, or -1
// if nothing in range matched (caller sends Attribute Not Found
// instead).
fn gatt_server_handle_read_by_group_type(req: mut ref i64, out_rsp: mut ref i64) -> i64 {
  let starting_handle: u32 = buf_read_u16_le(req, 1);
  let ending_handle: u32 = buf_read_u16_le(req, 3);
  let group_type: u32 = buf_read_u16_le(req, 5);
  let count: i64 = gatt_server_attr_get_count();
  let out_offset: i64 = 2;
  let entries_written: i64 = 0;
  let entry_value_len: i64 = 0 - 1;
  let i: i64 = 0;
  while i < count {
    let handle: u32 = (i + 1) as u32;
    let uuid: u32 = gatt_server_attr_get_uuid16_at(i as u32) as u32;
    if (handle >= starting_handle) && (handle <= ending_handle) && (uuid == group_type) {
      let value_len: i64 = gatt_server_attr_get_value_len_at(i as u32);
      if (entry_value_len >= 0) && (value_len != entry_value_len) {
        break; // stop before a mixed-length entry -- caller can re-request from here
      } else {
        entry_value_len = value_len;
        let end_handle: u32 = (count) as u32;
        let j: i64 = i + 1;
        let scanning: i64 = 1;
        while (j < count) && (scanning == 1) {
          let next_uuid: u32 = gatt_server_attr_get_uuid16_at(j as u32) as u32;
          if next_uuid == group_type {
            end_handle = j as u32;
            scanning = 0;
          }
          j = j + 1;
        }
        let _ = buf_write_u16_le(out_rsp, out_offset, handle);
        let _ = buf_write_u16_le(out_rsp, out_offset + 2, end_handle);
        let k: i64 = 0;
        while k < value_len {
          let b: u32 = gatt_server_get_value_byte(i, k);
          let _ = buf_write_byte(out_rsp, (out_offset + 4 + k) as u32, b);
          k = k + 1;
        }
        out_offset = out_offset + 4 + value_len;
        entries_written = entries_written + 1;
      }
    }
    i = i + 1;
  }
  if entries_written == 0 {
    return 0 - 1;
  }
  let _ = buf_write_byte(out_rsp, 0 as u32, att_opcode_read_by_group_type_response());
  let _ = buf_write_byte(out_rsp, 1 as u32, (4 + entry_value_len) as u32);
  return out_offset;
}

// Read By Type (§3.4.4.3) -- characteristic discovery (attribute_type
// = Characteristic Declaration) or any other by-type lookup within
// Dhruva's own database, same range/uniform-length reasoning as Read
// By Group Type above but WITHOUT the grouping (each match is its own
// entry, no end-handle computation needed -- §3.4.4.1 doesn't group).
fn gatt_server_handle_read_by_type(req: mut ref i64, out_rsp: mut ref i64) -> i64 {
  let starting_handle: u32 = buf_read_u16_le(req, 1);
  let ending_handle: u32 = buf_read_u16_le(req, 3);
  let attr_type: u32 = buf_read_u16_le(req, 5);
  let count: i64 = gatt_server_attr_get_count();
  let out_offset: i64 = 2;
  let entries_written: i64 = 0;
  let entry_value_len: i64 = 0 - 1;
  let i: i64 = 0;
  while i < count {
    let handle: u32 = (i + 1) as u32;
    let uuid: u32 = gatt_server_attr_get_uuid16_at(i as u32) as u32;
    if (handle >= starting_handle) && (handle <= ending_handle) && (uuid == attr_type) {
      let value_len: i64 = gatt_server_attr_get_value_len_at(i as u32);
      if (entry_value_len >= 0) && (value_len != entry_value_len) {
        break;
      } else {
        entry_value_len = value_len;
        let _ = buf_write_u16_le(out_rsp, out_offset, handle);
        let k: i64 = 0;
        while k < value_len {
          let b: u32 = gatt_server_get_value_byte(i, k);
          let _ = buf_write_byte(out_rsp, (out_offset + 2 + k) as u32, b);
          k = k + 1;
        }
        out_offset = out_offset + 2 + value_len;
        entries_written = entries_written + 1;
      }
    }
    i = i + 1;
  }
  if entries_written == 0 {
    return 0 - 1;
  }
  let _ = buf_write_byte(out_rsp, 0 as u32, att_opcode_read_by_type_response());
  let _ = buf_write_byte(out_rsp, 1 as u32, (2 + entry_value_len) as u32);
  return out_offset;
}

// Read Request (§3.4.4.1) -- a single already-resolved handle, no
// range/type matching needed. Returns -1 (dispatch sends Invalid
// Handle) if the handle doesn't resolve to a real attribute.
fn gatt_server_handle_read(req: mut ref i64, out_rsp: mut ref i64) -> i64 {
  let handle: u32 = att_read_request_get_handle(req);
  let index: i64 = gatt_server_find_index_for_handle(handle);
  if index < 0 {
    return 0 - 1;
  }
  let value_len: i64 = gatt_server_attr_get_value_len_at(index as u32);
  let value: mut ref i64 = dhruva_alloc_bytes(gatt_server_max_value_len());
  let k: i64 = 0;
  while k < value_len {
    let b: u32 = gatt_server_get_value_byte(index, k);
    let _ = buf_write_byte(value, k as u32, b);
    k = k + 1;
  }
  return att_build_read_response(out_rsp, value, value_len);
}

// Write Request (§3.4.5.1) -- rejects outright (dispatch sends Write
// Not Permitted) unless gatt_server_add_characteristic's own
// Write(0x08) property bit was set for this exact attribute, matching
// this project's own "reject, don't guess" posture for every wire-
// format boundary. Returns 0 on success, -2 specifically for "not
// writable" (distinguished from -1 "handle doesn't exist" so dispatch
// can pick the right error code), or -1 for an unresolvable handle.
fn gatt_server_handle_write(req: mut ref i64, req_len: i64, out_rsp: mut ref i64) -> i64 {
  let handle: u32 = att_write_request_get_handle(req);
  let index: i64 = gatt_server_find_index_for_handle(handle);
  if index < 0 {
    return 0 - 1;
  }
  let writable: i64 = gatt_server_attr_get_writable_at(index as u32);
  if writable == 0 {
    return 0 - 2;
  }
  let value: mut ref i64 = dhruva_alloc_bytes(gatt_server_max_value_len());
  let value_len: i64 = att_write_request_get_value(req, req_len, value);
  if value_len < 0 {
    return 0 - 1;
  }
  let clamped_len: i64 = if value_len > gatt_server_max_value_len() { gatt_server_max_value_len() } else { value_len };
  let _ = gatt_server_attr_set_value_len_at(index as u32, clamped_len as u32);
  let k: i64 = 0;
  while k < clamped_len {
    let b: u32 = buf_read_byte(value, k as u32);
    let _ = gatt_server_set_value_byte(index, k, b);
    k = k + 1;
  }
  let _ = att_build_write_response(out_rsp);
  return 0;
}

// Dispatches one already-received ATT request PDU against Dhruva's own
// attribute database, building the appropriate response (or an Error
// Response, per §3.4.1.1, on any failure -- every real GATT server's
// own baseline behavior, never silently dropping an unrecognized or
// failed request). Returns the response's own length (always >0 --
// even a rejected request gets a 5-byte Error Response back).
fn gatt_server_handle_request(req: mut ref i64, req_len: i64, out_rsp: mut ref i64) -> i64 {
  let opcode: u32 = att_get_opcode(req);
  if opcode == att_opcode_exchange_mtu_request() {
    return gatt_server_handle_exchange_mtu(req, out_rsp);
  }
  if opcode == att_opcode_read_by_group_type_request() {
    let status: i64 = gatt_server_handle_read_by_group_type(req, out_rsp);
    if status >= 0 {
      return status;
    }
    return att_build_error_response(out_rsp, opcode, buf_read_u16_le(req, 1), att_error_attribute_not_found());
  }
  if opcode == att_opcode_read_by_type_request() {
    let status: i64 = gatt_server_handle_read_by_type(req, out_rsp);
    if status >= 0 {
      return status;
    }
    return att_build_error_response(out_rsp, opcode, buf_read_u16_le(req, 1), att_error_attribute_not_found());
  }
  if opcode == att_opcode_read_request() {
    let status: i64 = gatt_server_handle_read(req, out_rsp);
    if status >= 0 {
      return status;
    }
    return att_build_error_response(out_rsp, opcode, att_read_request_get_handle(req), att_error_invalid_handle());
  }
  if opcode == att_opcode_write_request() {
    let status: i64 = gatt_server_handle_write(req, req_len, out_rsp);
    if status == 0 {
      return 1;
    }
    if status == (0 - 2) {
      return att_build_error_response(out_rsp, opcode, att_write_request_get_handle(req), att_error_write_not_permitted());
    }
    return att_build_error_response(out_rsp, opcode, att_write_request_get_handle(req), att_error_invalid_handle());
  }
  return att_build_error_response(out_rsp, opcode, 0 as u32, att_error_request_not_supported());
}

// Wires the dispatch above into the actual transport: receive one ATT
// PDU (blocking on the bulk IN endpoint, same as gatt_att_recv's own
// caller elsewhere), dispatch it, send the response back. Returns 0 on
// a normal request-response cycle, or -1 if nothing was waiting/a
// transport error occurred (not a protocol-level rejection -- those
// still return 0, since a valid Error Response IS a successful cycle
// from the transport's own point of view). A caller runs this in a
// loop for as long as the connection stays open, same shape as this
// project's own other poll-style drivers (usb_bt_poll, ...).
fn gatt_server_poll(devaddr: u32, mps: u32, conn_handle: u32) -> i64 {
  let req: mut ref i64 = dhruva_alloc_bytes(256);
  let req_len: i64 = gatt_att_recv(devaddr, mps, req);
  if req_len < 0 {
    return 0 - 1;
  }
  let rsp: mut ref i64 = dhruva_alloc_bytes(256);
  let rsp_len: i64 = gatt_server_handle_request(req, req_len, rsp);
  let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, rsp, rsp_len);
  if send_status != 0 {
    return 0 - 1;
  }
  return 0;
}

// Round 66 follow-up: sends a Handle Value Notification for one of
// Dhruva's OWN attributes (by wire HANDLE, matching gatt_server_add_
// characteristic's own return-value convention -- not a table index,
// unlike the client-side functions above, since a caller here already
// has the handle from whichever gatt_server_add_characteristic call
// created the value attribute it wants to notify about). The value
// sent is whatever's currently stored at that attribute (the same
// data a Read Request would return) -- a caller updates the
// attribute's own value first (there's no existing setter for this;
// gatt_server_handle_write is the only thing that currently changes a
// stored value, via an incoming Write Request) then calls this to
// push it out proactively. Scope, explicit: the CALLER decides when to
// notify -- no CCCD exposed on Dhruva's own attribute table, no
// per-connection subscription-state tracking (see gatt_server_add_
// characteristic's own header comment on why descriptors aren't part
// of this server's own database this round). Returns 0 on success, -1
// on an unresolvable handle or a real transport error.
fn gatt_server_notify_value(devaddr: u32, mps: u32, conn_handle: u32, attr_handle: u32) -> i64 {
  let index: i64 = gatt_server_find_index_for_handle(attr_handle);
  if index < 0 {
    return 0 - 1;
  }
  let value_len: i64 = gatt_server_attr_get_value_len_at(index as u32);
  let value: mut ref i64 = dhruva_alloc_bytes(gatt_server_max_value_len());
  let k: i64 = 0;
  while k < value_len {
    let b: u32 = gatt_server_get_value_byte(index, k);
    let _ = buf_write_byte(value, k as u32, b);
    k = k + 1;
  }
  let pdu: mut ref i64 = dhruva_alloc_bytes(gatt_server_max_value_len() + 3);
  let pdu_len: i64 = att_build_handle_value_notification(pdu, attr_handle, value, value_len);
  let send_status: i64 = gatt_att_send(devaddr, mps, conn_handle, pdu, pdu_len);
  if send_status != 0 {
    return 0 - 1;
  }
  return 0;
}

// Round 57: one INTERRUPT IN transfer -- this driver's first use of the
// interrupt transfer type (bmAttributes==3), needed because USB
// Bluetooth HCI delivers HCI EVENTS (Command Complete, Command Status,
// LE Meta Event/advertising reports, ...) via a dedicated interrupt
// endpoint, never the control or bulk endpoints. dwc2_build_hcchar
// already takes eptype as a plain parameter (2=bulk elsewhere in this
// file) -- confirmed against hcd-dwc2.c that the DWC2 controller's own
// HCCHAR/HCTSIZ channel-programming mechanism doesn't otherwise care
// which of the 4 USB transfer types a channel is scheduled for, only
// that eptype (bits [19:18]) is set correctly (3=interrupt, standard
// USB-defined encoding) -- so this is almost identical to dwc2_bt_
// bulk_in, just polled explicitly by this driver rather than serviced
// by real hardware's own periodic microframe scheduling (irrelevant
// here since this driver polls every transfer type the same way
// already, control included). Same short-packet/HCTSIZ-readback
// technique as dwc2_net_bulk_in/dwc2_bt_bulk_in for the returned
// length -- an HCI event's own length is never known in advance by the
// caller, same shape as network RX.
fn dwc2_hci_interrupt_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_bt_get_intr_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_bt_get_intr_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 3 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let hctsiz_after: u32 = mmio_read_u32(hctsiz0);
  let bytes_left: u32 = hctsiz_after & (0x7FFFF as u32);
  let actual_len: i64 = want_len - (bytes_left as i64);
  let i: i64 = 0;
  while i < actual_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_bt_set_intr_in_toggle(next_toggle);
  return actual_len;
}

// Round 71: USB HID's own interrupt-IN transfer -- identical shape to
// dwc2_hci_interrupt_in above (same DWC2 channel-programming
// mechanism, same short-packet/HCTSIZ-readback technique for the
// returned length, since a HID input report's own length also isn't
// known in advance -- a keyboard boot report is always 8 bytes but a
// mouse boot report can be 3 or 4 depending on whether the device adds
// a wheel byte). A separate function rather than a shared one
// parameterized on which *_get_intr_in_* accessors to call, matching
// this codebase's own established "one function per feature" style
// (BOT/CDC-ECM/LAN9512/BT already each have their own bulk-transfer
// functions rather than a shared parameterized one).
fn dwc2_hid_interrupt_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_hid_get_intr_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_hid_get_intr_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 3 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let hctsiz_after: u32 = mmio_read_u32(hctsiz0);
  let bytes_left: u32 = hctsiz_after & (0x7FFFF as u32);
  let actual_len: i64 = want_len - (bytes_left as i64);
  let i: i64 = 0;
  while i < actual_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_hid_set_intr_in_toggle(next_toggle);
  return actual_len;
}

// Boot-protocol report decoders (HID1.11 Appendix B) -- pure, MMIO-
// free parsing, host-harness-testable with synthetic bytes. Keyboard:
// byte0=modifier bitmask (bit0=LCtrl..bit7=RGUI), byte1=reserved,
// bytes2-7=up to 6 simultaneously pressed keycodes (0=no key, 1=
// rollover error -- per USB HID Usage Tables, not decoded further
// here). Mouse: byte0=button bitmask (bit0=left/bit1=right/
// bit2=middle), byte1=X displacement, byte2=Y displacement, both
// SIGNED 8-bit (a real mouse reports relative motion, negative values
// are a real and common case, not a caller error).
fn hid_kbd_report_get_modifiers(report: mut ref i64) -> u32 {
  return buf_read_byte(report, 0 as u32);
}

fn hid_kbd_report_get_keycode(report: mut ref i64, slot: u32) -> u32 {
  if slot >= (6 as u32) {
    return 0 as u32;
  }
  return buf_read_byte(report, 2 as u32 + slot);
}

fn hid_mouse_report_get_buttons(report: mut ref i64) -> u32 {
  return buf_read_byte(report, 0 as u32);
}

fn hid_mouse_report_get_dx(report: mut ref i64) -> i64 {
  let raw: u32 = buf_read_byte(report, 1 as u32);
  return if raw >= (128 as u32) { (raw as i64) - 256 } else { raw as i64 };
}

fn hid_mouse_report_get_dy(report: mut ref i64) -> i64 {
  let raw: u32 = buf_read_byte(report, 2 as u32);
  return if raw >= (128 as u32) { (raw as i64) - 256 } else { raw as i64 };
}

// Round 57: bmRequestType=0x20 (host-to-device, CLASS, device),
// bRequest=0x00, wValue=0, wIndex=0, wLength=cmd_len -- the standardized
// USB Bluetooth HCI Command transport, per the Bluetooth Core
// Specification's own "USB Transport Layer" section (confirmed against
// Linux's btusb.c, whose default/non-vendor-quirk path uses exactly
// these same values: `cmdreq_type = USB_TYPE_CLASS; cmdreq = 0x00`).
// The DATA stage carries the raw HCI command packet (opcode + param
// length + params, built by hci_build_command below).
fn dwc2_build_hci_command_setup(cmd_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x20 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, cmd_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (cmd_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

fn dwc2_hci_send_command(devaddr: u32, mps: u32, cmd_buf: mut ref i64, cmd_len: u32) -> i64 {
  let _ = dwc2_build_hci_command_setup(cmd_len);
  return dwc2_control_out(devaddr, mps, cmd_buf, cmd_len);
}

// Round 57: HCI packet building/parsing, factored into pure functions
// (no MMIO, no USB -- only buffer reads/writes and arithmetic) for the
// SAME reason lan9512_build_tx_header/lan9512_rx_status_has_error/
// frame_len were (see that comment): test/host_harness/ can exercise
// these directly against hand-computed expected byte layouts from the
// Bluetooth Core Specification, which is the part of this backend that
// genuinely doesn't need real hardware to verify.
//
// HCI command packet (Bluetooth Core Spec, Vol 4 Part E §5.4.1):
// [Opcode (2 bytes, little-endian)][Parameter_Total_Length (1
// byte)][Parameters...]. Opcode = (OGF << 10) | OCF -- OGF (OpCode
// Group Field) occupies the top 6 bits, OCF (OpCode Command Field) the
// bottom 10.
fn hci_build_opcode(ogf: u32, ocf: u32) -> u32 {
  return (ogf << (10 as u32)) | ocf;
}

fn hci_build_command(out_buf: mut ref i64, opcode: u32, params_buf: mut ref i64, params_len: u32) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, opcode & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 1 as u32, (opcode >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 2 as u32, params_len & (0xFF as u32));
  let i: u32 = 0 as u32;
  while i < params_len {
    let b: u32 = buf_read_byte(params_buf, i);
    let _ = buf_write_byte(out_buf, 3 as u32 + i, b);
    i = i + (1 as u32);
  }
  return (3 as i64) + (params_len as i64);
}

// HCI_Reset (Bluetooth Core Spec Vol 4 Part E §7.3.2): OGF=0x03 (Host
// Control & Baseband), OCF=0x0003, no parameters -- the standard first
// command sent to any HCI controller. Writes the full 3-byte command
// packet (no params to append) directly.
fn hci_build_reset_command(out_buf: mut ref i64) -> i64 {
  let opcode: u32 = hci_build_opcode(0x03 as u32, 0x0003 as u32);
  let _ = buf_write_byte(out_buf, 0 as u32, opcode & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 1 as u32, (opcode >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 2 as u32, 0 as u32);
  return 3;
}

// LE_Set_Scan_Parameters (Bluetooth Core Spec Vol 4 Part E §7.8.10):
// OGF=0x08 (LE Controller), OCF=0x000B, 7 parameter bytes: LE_Scan_Type
// (1, 0x00=passive/0x01=active), LE_Scan_Interval (2, LE),
// LE_Scan_Window (2, LE), Own_Address_Type (1), Scanning_Filter_Policy
// (1).
fn hci_build_le_set_scan_parameters_command(out_buf: mut ref i64, scan_type: u32, scan_interval: u32, scan_window: u32, own_addr_type: u32, filter_policy: u32) -> i64 {
  let opcode: u32 = hci_build_opcode(0x08 as u32, 0x000B as u32);
  let _ = buf_write_byte(out_buf, 0 as u32, opcode & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 1 as u32, (opcode >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 2 as u32, 7 as u32);
  let _ = buf_write_byte(out_buf, 3 as u32, scan_type & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 4 as u32, scan_interval & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 5 as u32, (scan_interval >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 6 as u32, scan_window & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 7 as u32, (scan_window >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 8 as u32, own_addr_type & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 9 as u32, filter_policy & (0xFF as u32));
  return 10;
}

// LE_Set_Scan_Enable (Bluetooth Core Spec Vol 4 Part E §7.8.11):
// OGF=0x08, OCF=0x000C, 2 parameter bytes: LE_Scan_Enable (1),
// Filter_Duplicates (1).
fn hci_build_le_set_scan_enable_command(out_buf: mut ref i64, scan_enable: u32, filter_duplicates: u32) -> i64 {
  let opcode: u32 = hci_build_opcode(0x08 as u32, 0x000C as u32);
  let _ = buf_write_byte(out_buf, 0 as u32, opcode & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 1 as u32, (opcode >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 2 as u32, 2 as u32);
  let _ = buf_write_byte(out_buf, 3 as u32, scan_enable & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 4 as u32, filter_duplicates & (0xFF as u32));
  return 5;
}

// HCI event packet (Bluetooth Core Spec Vol 4 Part E §5.4.4):
// [Event_Code (1 byte)][Parameter_Total_Length (1 byte)][Parameters...].
fn hci_event_code(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 0 as u32);
}

fn hci_event_param_len(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 1 as u32);
}

// Command Complete event (§7.7.14): Event_Code=0x0E, params =
// [Num_HCI_Command_Packets (1)][Command_Opcode (2, LE)][Return_
// Parameters...]. Every simple command this driver sends (HCI_Reset,
// LE_Set_Scan_Parameters, LE_Set_Scan_Enable) returns a single-byte
// Status as its first (and only) return parameter, at byte offset 5.
fn hci_event_is_command_complete(event_buf: mut ref i64) -> u32 {
  if hci_event_code(event_buf) == (0x0E as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

fn hci_cmd_complete_opcode(event_buf: mut ref i64) -> u32 {
  let lo: u32 = buf_read_byte(event_buf, 3 as u32);
  let hi: u32 = buf_read_byte(event_buf, 4 as u32);
  return lo | (hi << (8 as u32));
}

fn hci_cmd_complete_status(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 5 as u32);
}

// Round 66: connection establishment -- the prerequisite everything
// above L2CAP (docs/TODO.md's own "not started" BLE item) actually
// needs, and genuinely missing before this round despite the HCI
// transport itself being done (round 57): scanning alone never yields
// a connection handle, and L2CAP/ATT/GATT all run over an established
// connection's ACL data channel. LE_Create_Connection (§7.8.12):
// OGF=0x08, OCF=0x000D, 25 parameter bytes: LE_Scan_Interval (2, LE),
// LE_Scan_Window (2, LE), Initiator_Filter_Policy (1), Peer_Address_
// Type (1), Peer_Address (6), Own_Address_Type (1), Conn_Interval_Min
// (2, LE), Conn_Interval_Max (2, LE), Conn_Latency (2, LE),
// Supervision_Timeout (2, LE), Min/Max_CE_Length (2 each, LE).
fn hci_build_le_create_connection_command(out_buf: mut ref i64, scan_interval: u32, scan_window: u32, filter_policy: u32, peer_addr_type: u32, peer_addr: mut ref i64, own_addr_type: u32, conn_interval_min: u32, conn_interval_max: u32, conn_latency: u32, supervision_timeout: u32) -> i64 {
  let opcode: u32 = hci_build_opcode(0x08 as u32, 0x000D as u32);
  let _ = buf_write_byte(out_buf, 0 as u32, opcode & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 1 as u32, (opcode >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(out_buf, 2 as u32, 25 as u32);
  let _ = buf_write_u16_le(out_buf, 3, scan_interval);
  let _ = buf_write_u16_le(out_buf, 5, scan_window);
  let _ = buf_write_byte(out_buf, 7 as u32, filter_policy);
  let _ = buf_write_byte(out_buf, 8 as u32, peer_addr_type);
  let i: i64 = 0;
  while i < 6 {
    let b: u32 = buf_read_byte(peer_addr, i as u32);
    let _ = buf_write_byte(out_buf, (9 + i) as u32, b);
    i = i + 1;
  }
  let _ = buf_write_byte(out_buf, 15 as u32, own_addr_type);
  let _ = buf_write_u16_le(out_buf, 16, conn_interval_min);
  let _ = buf_write_u16_le(out_buf, 18, conn_interval_max);
  let _ = buf_write_u16_le(out_buf, 20, conn_latency);
  let _ = buf_write_u16_le(out_buf, 22, supervision_timeout);
  let _ = buf_write_u16_le(out_buf, 24, 0 as u32); // Min_CE_Length -- no
                                                     // preference
  let _ = buf_write_u16_le(out_buf, 26, 0 as u32); // Max_CE_Length --
                                                     // no preference
  return 28;
}

// LE_Create_Connection is unusual among the commands this driver has
// sent so far: the controller answers with Command Status (§7.7.15,
// Event_Code=0x0F -- "accepted, working on it," NOT Command Complete)
// immediately, then the REAL outcome arrives later, asynchronously, as
// an LE Connection Complete event -- a genuine two-step protocol,
// unlike HCI_Reset/LE_Set_Scan_*'s single synchronous round trip.
fn hci_event_is_command_status(event_buf: mut ref i64) -> u32 {
  if hci_event_code(event_buf) == (0x0F as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

fn hci_cmd_status_status(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 2 as u32);
}

fn hci_cmd_status_opcode(event_buf: mut ref i64) -> u32 {
  return buf_read_u16_le(event_buf, 4);
}

// LE Meta Event (§7.7.65): Event_Code=0x3E, params =
// [Subevent_Code (1)][Subevent parameters...]. Every LE-specific
// asynchronous event (connection complete, advertising reports, etc.)
// is a subevent of this one wrapper event, not its own top-level
// event code -- checked separately from hci_event_is_command_complete/
// _status above since this is neither of those shapes.
fn hci_event_is_le_meta(event_buf: mut ref i64) -> u32 {
  if hci_event_code(event_buf) == (0x3E as u32) {
    return 1 as u32;
  }
  return 0 as u32;
}

fn hci_le_meta_subevent_code(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 2 as u32);
}

// LE Connection Complete (§7.7.65.1): Subevent_Code=0x01, params =
// [Status (1)][Connection_Handle (2, LE)][Role (1)][Peer_Address_Type
// (1)][Peer_Address (6)][Conn_Interval (2, LE)][Conn_Latency (2, LE)]
// [Supervision_Timeout (2, LE)][Master_Clock_Accuracy (1)], all offset
// by the 3-byte [Event_Code][Param_Len][Subevent_Code] header above.
fn hci_le_conn_complete_status(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 3 as u32);
}

fn hci_le_conn_complete_handle(event_buf: mut ref i64) -> u32 {
  return buf_read_u16_le(event_buf, 4);
}

fn hci_le_conn_complete_role(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 6 as u32);
}

fn hci_le_conn_complete_peer_addr_type(event_buf: mut ref i64) -> u32 {
  return buf_read_byte(event_buf, 7 as u32);
}

fn hci_le_conn_complete_peer_addr(event_buf: mut ref i64, out_addr: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let b: u32 = buf_read_byte(event_buf, (8 + i) as u32);
    let _ = buf_write_byte(out_addr, i as u32, b);
    i = i + 1;
  }
  return 0;
}

// Round 57: sends one HCI command and polls the interrupt endpoint
// (bounded, not `while true`, matching this project's own established
// hardware-poll discipline) for its Command Complete event, matching it
// against the command's own opcode -- a real HCI controller can
// interleave OTHER events (e.g. an unrelated advertising report)
// between a command and its own completion, so this checks the opcode
// field rather than trusting "the very next event must be mine."
// Returns the event's Status byte (0 = success, matching every HCI
// return-parameter convention) on a matched Command Complete, or
// 0xFFFFFFFF if no matching completion arrived within the poll bound
// (expected and harmless under QEMU, where nothing ever answers --see
// hci_reset_and_scan's own comment for why this whole function is
// necessarily untested end-to-end today).
fn hci_send_command_and_wait_complete(devaddr: u32, mps: u32, intr_mps: u32, cmd_buf: mut ref i64, cmd_len: u32, expected_opcode: u32) -> u32 {
  let send_status: i64 = dwc2_hci_send_command(devaddr, mps, cmd_buf, cmd_len);
  if send_status != 0 {
    return 0xFFFFFFFF as u32;
  }
  let event_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let tries: i64 = 0;
  while tries < 20 {
    let event_len: i64 = dwc2_hci_interrupt_in(devaddr, intr_mps, event_buf, intr_mps as i64);
    if event_len > 0 {
      if hci_event_is_command_complete(event_buf) == (1 as u32) {
        if hci_cmd_complete_opcode(event_buf) == expected_opcode {
          return hci_cmd_complete_status(event_buf);
        }
      }
    }
    tries = tries + 1;
  }
  return 0xFFFFFFFF as u32;
}

// Round 57: HCI transport bring-up milestone -- HCI_Reset, then LE_Set_
// Scan_Parameters, then LE_Set_Scan_Enable, matching this project's own
// TODO.md scoping ("HCI transport + reset/scan/connect first, a real,
// demonstrable milestone on its own"). Scan parameters: passive
// scanning (type=0x00, no scan request PDUs sent), interval=window=
// 0x0010 (10ms, a conservative default well within spec range), own
// address type=public (0x00), no filter policy (0x00) -- reasonable
// defaults for a first working scan, not tuned for any specific use
// case yet. Enable=1, filter_duplicates=0 (report every advertisement,
// not just the first from each device) -- the more useful default for
// initially proving scanning works at all.
//
// IMPORTANT, stated plainly like lan9512_reset_and_init's own comment:
// this cannot be live-verified under QEMU. Unlike LAN9512 (where a
// real chip similarly can't be QEMU-tested, but CDC-ECM sits alongside
// it as a REAL, live-testable stand-in for the surrounding USB
// enumeration/transport plumbing), Bluetooth has no such stand-in
// available at all -- QEMU's own `usb-bt-dongle` device (which
// implemented exactly this USB HCI transport) was deprecated in 2018
// and removed from modern QEMU entirely (confirmed: not present in
// this environment's `qemu-system-arm -device help`, and via the
// upstream deprecation/removal history). This function is written
// directly against the Bluetooth Core Specification's own USB
// Transport Layer definition and cross-checked against Linux's
// btusb.c reference driver, compiled and exercised for crashes/hangs
// against a bounded poll loop, but has never received a real HCI
// event in response to anything it sends. Pending real Pi 1B
// hardware-in-loop testing (with an actual USB Bluetooth dongle
// attached) before this can be called proven rather than "written to
// spec" -- same honesty bar as the LAN9512 backend.
fn hci_reset_and_scan(devaddr: u32, mps: u32) -> i64 {
  let intr_mps: u32 = usb_bt_get_intr_in_mps();
  let cmd_buf: mut ref i64 = dhruva_alloc_bytes(16);

  let reset_len: i64 = hci_build_reset_command(cmd_buf);
  let reset_opcode: u32 = hci_build_opcode(0x03 as u32, 0x0003 as u32);
  let reset_status: u32 = hci_send_command_and_wait_complete(devaddr, mps, intr_mps, cmd_buf, reset_len as u32, reset_opcode);
  let _ = uart_puts("USB: HCI_Reset status=");
  let _ = uart_put_hex32(reset_status);
  let _ = uart_puts(" (0=success, 0xFFFFFFFF=no response -- expected under QEMU, see this function's own comment)\n");
  if reset_status != (0 as u32) {
    return 0 - 1;
  }

  let scan_params_len: i64 = hci_build_le_set_scan_parameters_command(cmd_buf, 0x00 as u32, 0x0010 as u32, 0x0010 as u32, 0x00 as u32, 0x00 as u32);
  let scan_params_opcode: u32 = hci_build_opcode(0x08 as u32, 0x000B as u32);
  let scan_params_status: u32 = hci_send_command_and_wait_complete(devaddr, mps, intr_mps, cmd_buf, scan_params_len as u32, scan_params_opcode);
  let _ = uart_puts("USB: LE_Set_Scan_Parameters status=");
  let _ = uart_put_hex32(scan_params_status);
  let _ = uart_puts("\n");
  if scan_params_status != (0 as u32) {
    return 0 - 1;
  }

  let scan_enable_len: i64 = hci_build_le_set_scan_enable_command(cmd_buf, 1 as u32, 0 as u32);
  let scan_enable_opcode: u32 = hci_build_opcode(0x08 as u32, 0x000C as u32);
  let scan_enable_status: u32 = hci_send_command_and_wait_complete(devaddr, mps, intr_mps, cmd_buf, scan_enable_len as u32, scan_enable_opcode);
  let _ = uart_puts("USB: LE_Set_Scan_Enable status=");
  let _ = uart_put_hex32(scan_enable_status);
  let _ = uart_puts("\n");
  return 0;
}

// Bulk-Only Transport command/status framing (USB Mass Storage Class
// Bulk-Only Transport spec, section 5). CBW is 31 bytes, all fields
// little-endian (see buf_write_u32_le's own comment on why this
// project needed a distinct helper from its existing network-byte-
// order ones): dCBWSignature (fixed 0x43425355, "USBC" on the wire),
// dCBWTag (arbitrary, echoed back in the CSW so a caller can confirm
// the status belongs to this exact command), dCBWDataTransferLength,
// bmCBWFlags (data stage direction, meaningless when length is 0),
// bCBWLUN, bCBWCBLength (length of the real SCSI CDB that follows),
// then the 16-byte CBWCB itself (zero-padded).
fn bot_build_cbw(out_buf: mut ref i64, tag: u32, data_len: u32, flags: u32, cb_len: u32, cdb: mut ref i64, cdb_len: i64) -> i64 {
  let _ = buf_write_u32_le(out_buf, 0, 0x43425355 as u32);
  let _ = buf_write_u32_le(out_buf, 4, tag);
  let _ = buf_write_u32_le(out_buf, 8, data_len);
  let _ = buf_write_byte(out_buf, 12 as u32, flags);
  let _ = buf_write_byte(out_buf, 13 as u32, 0 as u32); // LUN 0 -- the
                                                          // only one
                                                          // this
                                                          // project
                                                          // targets
  let _ = buf_write_byte(out_buf, 14 as u32, cb_len);
  let i: i64 = 0;
  while i < 16 {
    let b: u32 = if i < cdb_len { buf_read_byte(cdb, i as u32) } else { 0 as u32 };
    let _ = buf_write_byte(out_buf, (15 + i) as u32, b);
    i = i + 1;
  }
  return 0;
}

// Round 34: generic BOT SCSI command round trip -- CBW out (declaring
// data_len bytes of data in whichever direction is_write says, or
// data_len=0 for a command with no data stage at all), the data stage
// itself if data_len > 0, then CSW in. Round 33's own usb_msd_test_
// unit_ready originally inlined this exact shape for TEST UNIT READY
// alone (data_len=0); round 34 factored it out as usb_msd_scsi_
// command_in once INQUIRY/READ CAPACITY(10) needed the identical
// IN-direction shape. Round 35 generalized it further (renamed
// accordingly) to also cover WRITE(10)'s OUT data stage, once that
// needed the same shape with the direction flipped and a real
// DMA-capable buffer to move a full sector through (see dwc2_bulk_
// out/in's own comment on usb_bulk_data_scratch). Returns bCSWStatus
// (0=success, 1=command failed, 2=phase error) on a well-formed CSW,
// or -1 on any transport failure, a short data-stage transfer, or a
// malformed/mismatched CSW (wrong signature or tag) -- same "reject,
// don't guess" posture as every other wire-format check in this
// project.
fn usb_msd_scsi_command(devaddr: u32, cdb: mut ref i64, cdb_len: i64, tag: u32, data_len: u32, is_write: i64, data: mut ref i64) -> i64 {
  let out_mps: u32 = usb_msd_get_bulk_out_mps();
  let in_mps: u32 = usb_msd_get_bulk_in_mps();
  let flags: u32 = if (data_len > (0 as u32)) && (is_write == 0) { 0x80 as u32 } else { 0 as u32 }; // bit7: IN
  let cbw: mut ref i64 = dhruva_alloc_bytes(31);
  let _ = bot_build_cbw(cbw, tag, data_len, flags, cdb_len as u32, cdb, cdb_len);
  let out_status: i64 = dwc2_bulk_out(devaddr, out_mps, cbw, 31);
  if out_status != 0 {
    let _ = uart_puts("USB: BOT CBW send failed\n");
    return 0 - 1;
  }

  if data_len > (0 as u32) {
    if is_write == 1 {
      let data_status: i64 = dwc2_bulk_out(devaddr, out_mps, data, data_len as i64);
      if data_status != 0 {
        let _ = uart_puts("USB: BOT data-out stage failed\n");
        return 0 - 1;
      }
    } else {
      let data_status: i64 = dwc2_bulk_in(devaddr, in_mps, data, data_len as i64);
      if data_status != (data_len as i64) {
        let _ = uart_puts("USB: BOT data-in stage failed\n");
        return 0 - 1;
      }
    }
  }

  let csw: mut ref i64 = dhruva_alloc_bytes(13);
  let in_status: i64 = dwc2_bulk_in(devaddr, in_mps, csw, 13);
  if in_status != (13 as i64) {
    let _ = uart_puts("USB: BOT CSW receive failed\n");
    return 0 - 1;
  }
  let csw_sig: u32 = buf_read_u32_le(csw, 0);
  let csw_tag: u32 = buf_read_u32_le(csw, 4);
  let csw_status: u32 = buf_read_byte(csw, 12 as u32);
  if csw_sig != (0x53425355 as u32) {
    let _ = uart_puts("USB: BOT CSW bad signature\n");
    return 0 - 1;
  }
  if csw_tag != tag {
    let _ = uart_puts("USB: BOT CSW tag mismatch\n");
    return 0 - 1;
  }
  return csw_status as i64;
}

// Round 33's live milestone: TEST UNIT READY (SCSI opcode 0x00, a
// fixed 6-byte all-zero CDB -- the simplest possible SCSI command,
// with no data stage at all) sent through a real CBW/CSW round trip
// over the bulk endpoints this same boot's config-descriptor parse
// discovered. Proves the whole bulk-transfer/BOT chain end to end --
// toggle tracking, endpoint direction, CBW/CSW framing.
fn usb_msd_test_unit_ready(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(6); // all-zero: opcode 0
                                                  // (TEST UNIT READY),
                                                  // LUN/reserved/
                                                  // control all 0
  let tag: u32 = 0x54555230 as u32; // "TUR0", just a recognizable,
                                      // non-zero tag value
  // Passing cdb again as the (unused) out_data buffer: data_len=0
  // means usb_msd_scsi_command_in's own data-stage block never
  // touches it, so reusing the already-allocated cdb avoids a
  // pointless extra allocation for a buffer that's guaranteed dead.
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 6, tag, 0 as u32, 0, cdb);
  if csw_status < 0 {
    return csw_status;
  }
  let _ = uart_puts("USB: BOT TEST UNIT READY csw_status=");
  let _ = uart_put_hex32(csw_status as u32);
  if csw_status == 0 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    // A real device can legitimately report "not ready" (status=1) --
    // QEMU's usb-storage backend answers success once a real backing
    // image is attached, but this is still a genuine, well-formed BOT
    // round trip either way, not a driver failure -- only signal loud
    // FAIL-style attention for a transport-level problem (handled by
    // the two checks above), not a normal SCSI-level status.
    let _ = uart_puts(" (not ready or check condition -- transport itself OK)\n");
  }
  return csw_status;
}

// Round 34: SCSI INQUIRY (opcode 0x12) -- unlike TEST UNIT READY,
// this has a real 36-byte data-IN stage, the first this driver
// exercises. CDB byte 4 (allocation length) is a single byte here, so
// unlike READ CAPACITY(10)'s response below there's no endianness
// question for the request itself; the RESPONSE data, like every
// other SCSI data-in payload, is big-endian/most-significant-byte-
// first where it has multi-byte fields at all (INQUIRY's own don't,
// beyond the two fixed ASCII strings printed below) -- see READ_
// CAPACITY10's own comment for where that actually matters. Standard
// INQUIRY response layout: byte 0 bits[4:0] = peripheral device type,
// bytes 8-15 = vendor identification (8 ASCII chars), bytes 16-31 =
// product identification (16 ASCII chars).
fn usb_msd_inquiry(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(6);
  let _ = buf_write_byte(cdb, 0 as u32, 0x12 as u32); // INQUIRY
  let _ = buf_write_byte(cdb, 4 as u32, 36 as u32);   // allocation length
  let tag: u32 = 0x494E5130 as u32; // "INQ0"
  let data: mut ref i64 = dhruva_alloc_bytes(36);
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 6, tag, 36 as u32, 0, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: INQUIRY failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  let periph_type: u32 = buf_read_byte(data, 0 as u32) & (0x1F as u32);
  let _ = uart_puts("USB: INQUIRY peripheral_type=");
  let _ = uart_put_hex32(periph_type);
  let _ = uart_puts(" vendor=\"");
  let vi: i64 = 0;
  while vi < 8 {
    let b: u32 = buf_read_byte(data, (8 + vi) as u32);
    let _ = uart_putc(b as i64);
    vi = vi + 1;
  }
  let _ = uart_puts("\" product=\"");
  let pi: i64 = 0;
  while pi < 16 {
    let b: u32 = buf_read_byte(data, (16 + pi) as u32);
    let _ = uart_putc(b as i64);
    pi = pi + 1;
  }
  let _ = uart_puts("\" (PASS)\n");
  return 0;
}

// Round 34: SCSI READ CAPACITY(10) (opcode 0x25) -- a fixed 10-byte
// CDB (opcode plus 9 zero bytes; no allocation-length field at all,
// the response is always exactly 8 bytes), returning the device's
// last valid LBA and its block size. BOTH 4-byte response fields are
// big-endian -- SCSI's own wire convention for multi-byte data,
// confirmed against the SCSI Block Commands spec before writing this,
// distinct from (and easy to confuse with) the BOT wrapper's own
// little-endian CBW/CSW fields bot_build_cbw/usb_msd_scsi_command_in
// already handle -- reused this project's EXISTING buf_read_u32_be
// (built for Ethernet/IP/TCP/UDP's own big-endian fields) rather than
// the new buf_read_u32_le added for the BOT wrapper, precisely because
// this is the one place in the whole BOT/SCSI chain where the byte
// order actually flips back to big-endian.
fn usb_msd_read_capacity10(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10); // all-zero except opcode
  let _ = buf_write_byte(cdb, 0 as u32, 0x25 as u32); // READ CAPACITY(10)
  let tag: u32 = 0x52433130 as u32; // "RC10"
  let data: mut ref i64 = dhruva_alloc_bytes(8);
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 8 as u32, 0, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: READ CAPACITY(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  let last_lba: u32 = buf_read_u32_be(data, 0);
  let block_len: u32 = buf_read_u32_be(data, 4);
  let _ = uart_puts("USB: READ CAPACITY(10) last_lba=");
  let _ = uart_put_hex32(last_lba);
  let _ = uart_puts(" block_len=");
  let _ = uart_put_hex32(block_len);
  let _ = uart_puts(" (PASS)\n");
  return 0;
}

// Round 35: SCSI READ(10) (opcode 0x28) -- moves exactly one 512-byte
// block (this project's own established block-size convention
// throughout: the SD driver, the FS layer, and netif's own queue
// slots all already use 512 everywhere) starting at LBA lba into
// out_data (caller-owned, >= 512 bytes). CDB fields beyond the opcode
// are big-endian, same SCSI wire convention as READ CAPACITY(10)'s
// own response. This is the first command whose data stage needed
// usb_bulk_data_scratch's real 512-byte capacity (round 34's CDB/CSW
// traffic never exceeded 64 bytes).
fn usb_msd_read10(devaddr: u32, lba: u32, out_data: mut ref i64) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10);
  let _ = buf_write_byte(cdb, 0 as u32, 0x28 as u32); // READ(10)
  let _ = buf_write_u32_be(cdb, 2, lba);
  let _ = buf_write_u16_be(cdb, 7, 1 as u32); // transfer length: 1 block
  let tag: u32 = 0x52443130 as u32; // "RD10"
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 512 as u32, 0, out_data);
  if csw_status != 0 {
    let _ = uart_puts("USB: READ(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  return 0;
}

// Round 35: SCSI WRITE(10) (opcode 0x2A) -- same CDB layout as
// READ(10) above, same one-512-byte-block scope, data stage direction
// flipped to OUT (usb_msd_scsi_command's is_write=1 path).
fn usb_msd_write10(devaddr: u32, lba: u32, data: mut ref i64) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10);
  let _ = buf_write_byte(cdb, 0 as u32, 0x2A as u32); // WRITE(10)
  let _ = buf_write_u32_be(cdb, 2, lba);
  let _ = buf_write_u16_be(cdb, 7, 1 as u32);
  let tag: u32 = 0x57523130 as u32; // "WR10"
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 512 as u32, 1, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: WRITE(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  return 0;
}

// Round 35's live milestone: a real READ(10)/WRITE(10) round trip --
// write a real pattern to a real sector, read it back, and confirm
// the bytes actually match, not just that both transports reported
// success. LBA 100 is arbitrary but safely inside this project's own
// 8MB test image (16384 total 512-byte blocks) and far from block 0,
// where a real filesystem would keep boot-sector/partition-table
// metadata this driver doesn't parse or care about. Reuses
// test_fill_pattern/test_compare_buffers -- the SAME generic
// pattern-fill/compare helpers the SD driver's own 8-block round-trip
// sweep already uses for the identical shape of check, rather than
// writing a second, duplicate byte-compare loop.
fn usb_msd_read10_write10_check(devaddr: u32) -> i64 {
  let lba: u32 = 100 as u32;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = test_fill_pattern(write_buf, 512);
  let write_status: i64 = usb_msd_write10(devaddr, lba, write_buf);
  if write_status != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, write_status=");
    let _ = uart_put_hex32(write_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let read_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let read_status: i64 = usb_msd_read10(devaddr, lba, read_buf);
  if read_status != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, read_status=");
    let _ = uart_put_hex32(read_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, 512);
  if mismatch != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, data mismatch)\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: WRITE(10)/READ(10) round trip lba=");
  let _ = uart_put_hex32(lba);
  let _ = uart_puts(" (PASS)\n");
  return 0;
}

// Round 36's live milestone: prove dharafs_block_read/dharafs_block_write
// (this round's own new block-device abstraction, see its comment
// right after sdhost_write_block) genuinely work against the USB mass
// storage backend too, not just SDHOST -- every real FS operation's
// own permanent default, completely untouched by this check.
// Temporarily flips dharafs_state's own block-device selector to USB mass
// storage, writes a real pattern to a block through the SAME
// abstraction dharafs_init/dharafs_append_raw/dharafs_compact/etc. call, reads it
// back through it, byte-compares, then restores the selector to
// SDHOST before returning -- this project's real FS never runs with
// anything but SDHOST selected; only this one self-check ever flips
// it, and only for the duration of these two calls. LBA 200 (distinct
// from round 35's own LBA 100, so their host-side backing-image bytes
// never interfere with each other) is arbitrary but safely inside the
// 8MB test image.
fn dharafs_block_dev_self_check() -> i64 {
  let lba: i64 = 200;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = test_fill_pattern(write_buf, 512);

  let _ = dharafs_state_set_block_dev(1 as u32);
  let write_status: i64 = dharafs_block_write(lba, write_buf);
  let read_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let read_status: i64 = dharafs_block_read(lba, read_buf);
  let _ = dharafs_state_set_block_dev(0 as u32); // restore before anything
                                              // else can observe it

  if write_status != 0 {
    let _ = uart_puts("USB: dharafs_block_write via FS abstraction (FAIL, write_status=");
    let _ = uart_put_hex32(write_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  if read_status != 0 {
    let _ = uart_puts("USB: dharafs_block_read via FS abstraction (FAIL, read_status=");
    let _ = uart_put_hex32(read_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, 512);
  if mismatch != 0 {
    let _ = uart_puts("USB: dharafs_block_read/write via FS abstraction (FAIL, data mismatch)\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: dharafs_block_read/write via FS abstraction (PASS -- USB mass storage now a real FS backend)\n");
  return 0;
}

// The address every device answers at before the host assigns it a
// real one. Two real addresses get handed out across this driver's
// whole enumeration sequence -- 1 for whatever sits directly on the
// DWC2 root port (raspi1ap's controller always has a synthetic root
// hub there, confirmed live and byte-for-byte against QEMU's own
// hw/usb/dev-hub.c), 2 for whatever's actually plugged into that
// hub's first downstream port. No general allocator needed for more
// than that yet -- this project's own QEMU testing never attaches
// more than one real device at a time.
fn dwc2_hub_addr() -> u32 {
  return 1 as u32;
}
fn dwc2_downstream_addr() -> u32 {
  return 2 as u32;
}
fn dwc2_hub_port1() -> u32 {
  return 1 as u32;
}
// Round 23 (real-hardware-only prep, 2026-08-28): this project's own
// documented real target, the LAN9512 combo hub/Ethernet chip every
// Pi 1 Model B actually has (BCM2835 itself has no native Ethernet
// MAC), has exactly two downstream USB PHYs -- confirmed against
// Microchip's own LAN9512/LAN9512i datasheet. See dwc2_enumerate_
// downstream's own comment for why both ports get tried.
fn dwc2_hub_port2() -> u32 {
  return 2 as u32;
}

// Powers on and resets one hub downstream port, polling for the hub's
// own PORT_RESET completion rather than trusting a fixed delay.
//
// BUG (round 14 audit, 2026-08-28): this function's own comment
// (see the header comment on hub_feature_port_enable et al.) states
// the design principle in so many words -- "PORT_RESET's own
// completion has to be observed via the port's status/change bits
// rather than assumed from timing alone" -- but the code used to do
// exactly the thing that comment says it doesn't: one fixed delay,
// then a SINGLE GET_PORT_STATUS read, trusting wPortStatus's ENABLE
// bit immediately with no check that the hub had actually finished
// processing the reset yet. That's a real gap, not just a stale
// comment: unlike the ROOT port (HPRT0's ENA bit is set synchronously
// by the model itself during the very same RST-deassert MMIO write,
// per dwc2_port_reset's own extensively-verified comment), a
// downstream hub is a separate device that processes SET_PORT_
// FEATURE(PORT_RESET) asynchronously -- there's no guarantee its
// internal port state machine has finished resetting by the time the
// control transfer's STATUS stage completes on the wire, only that
// the REQUEST was received. This only worked at all because QEMU's
// emulated hub happens to finish fast enough within one 50000-unit
// delay; it would not be robust against a real hub, or even a
// differently-timed emulated one. Fixed by actually polling
// wPortChange's C_PORT_RESET bit (bit4, 0x10 -- a completely
// different numbering space from the SET/CLEAR_PORT_FEATURE feature
// selectors just above, which is why this couldn't just reuse
// hub_feature_c_port_reset()'s own value of 20) until it's genuinely
// observed set, bounded (not `while true`) like every other poll
// loop in this codebase.
//
// Returns 0 if the port came up connected+enabled, 1 if it's simply
// not connected (a normal condition -- the caller may try another
// port), -1 on a genuine hub communication failure (worth aborting
// on, not worth trying another port for).
fn dwc2_hub_bring_up_port(hub_addr: u32, hub_mps: u32, port: u32) -> i64 {
  let _ = dwc2_hub_set_port_feature(hub_addr, hub_mps, port, hub_feature_port_power());
  let _ = delay(50000);
  let _ = dwc2_hub_set_port_feature(hub_addr, hub_mps, port, hub_feature_port_reset());
  let _ = delay(50000);

  let status_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let c_port_reset_bit: u32 = 0x10 as u32; // wPortChange bit4
  let reset_seen: i64 = 0;
  let port_status: u32 = 0 as u32;
  let poll_iter: i64 = 0;
  while (poll_iter < 20) && (reset_seen == 0) {
    let status_result: i64 = dwc2_hub_get_port_status(hub_addr, hub_mps, port, status_buf);
    if status_result != 0 {
      let _ = uart_puts("USB: hub GET_PORT_STATUS failed\n");
      return 0 - 1;
    }
    let change_lo: u32 = buf_read_byte(status_buf, 2 as u32);
    let change_hi: u32 = buf_read_byte(status_buf, 3 as u32);
    let port_change: u32 = change_lo | (change_hi << (8 as u32));
    if (port_change & c_port_reset_bit) != (0 as u32) {
      reset_seen = 1;
      let status_lo: u32 = buf_read_byte(status_buf, 0 as u32);
      let status_hi: u32 = buf_read_byte(status_buf, 1 as u32);
      port_status = status_lo | (status_hi << (8 as u32));
    } else {
      let _ = delay(50000);
    }
    poll_iter = poll_iter + 1;
  }
  if reset_seen == 0 {
    let _ = uart_puts("USB: hub port never reported PORT_RESET complete\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: hub port status=");
  let _ = uart_put_hex32(port_status);
  let _ = uart_puts("\n");

  let _ = dwc2_hub_clear_port_feature(hub_addr, hub_mps, port, hub_feature_c_port_reset());
  let _ = dwc2_hub_clear_port_feature(hub_addr, hub_mps, port, hub_feature_c_port_connection());

  // PORT_CONNECTION=bit0, PORT_ENABLE=bit1.
  if (port_status & (0x3 as u32)) != (0x3 as u32) {
    return 1;
  }
  return 0;
}

// Tries hub downstream port 1, then port 2, and enumerates whatever
// answers at address 0 behind whichever one actually has a device
// (a fresh, independent per-device address space -- the hub itself
// already moved to dwc2_hub_addr(), so address 0 unambiguously means
// "the downstream device" from this point on: `usb_find_device`'s own
// address-0-first lookup against the hub falls through to the hub
// class's recursive `find_device` once the hub's own addr no longer
// matches, per QEMU's hw/usb/core.c/bus.c -- confirmed by reading
// that dispatch chain before assuming a control transfer "through" a
// hub would just work). Mirrors dwc2_probe_device0's own root-port
// sequence closely on purpose: same shape of problem (bring a port
// up, then enumerate whatever answers at address 0 through it), just
// reached via hub class requests (SET_PORT_FEATURE/GET_PORT_STATUS)
// instead of HPRT0's raw register bits. Which port ends up carrying
// the device doesn't matter beyond this point -- once a port is
// enabled, address-0 control transfers reach whatever's plugged into
// it regardless of the port number, so nothing below needs to know
// which one it was.
//
// hub_mps is the hub's OWN bMaxPacketSize0, learned by the caller
// (dwc2_probe_device0) from its device descriptor fetch and passed in
// here -- round 23 audit, 2026-08-28 (real-hardware-only prep): this
// used to be a hardcoded literal 8 with a comment claiming it was
// "learned from dwc2_probe_device0's own hub descriptor fetch," which
// was misleading -- nothing actually threaded that learned value
// here, the literal just happened to match QEMU's own synthetic hub
// model, which does report bMaxPacketSize0=8. A real hub reports
// something else: confirmed against this project's real target, the
// LAN9512 combo hub/Ethernet chip every Pi 1 Model B actually has
// (BCM2835 has no native Ethernet MAC), whose hub function enumerates
// with idVendor:idProduct 0424:9512 and bMaxPacketSize0=64 -- every
// control transfer this function makes to the hub itself would have
// silently miscalculated its own transfer size against real hardware.
// The same "derive from the single learned source of truth, don't
// hardcode a number that merely matches today" fix round 11 already
// applied to netif_get_mtu().
//
// Round 23 also generalizes port 1 -> port 1-then-2: LAN9512 has
// exactly two downstream USB PHYs (confirmed against Microchip's own
// datasheet), and its internally-wired Ethernet function's specific
// port number is EEPROM-configured per board design, not a fixed
// constant ("the downstream ports... can be reordered... to support
// multiple platform designs," per that same datasheet) -- hardcoding
// "port 1 only" risks silently never finding a real device wired to
// port 2. QEMU's own synthetic root hub here only ever exposes one
// addressable port (confirmed empirically: attaching a second QEMU
// USB device at port=2 on this same bus fails with "port 2 ... not
// found"), so the port-2 fallback path is correct by inspection
// against the real datasheet, not verified behaviorally the way
// everything else in this project is -- the same category of gap as
// this project's own DVFS-wattage and USB-timing caveats elsewhere,
// flagged rather than silently assumed away. Costs nothing when
// nothing's there: the existing "not connected" handling already
// covers a genuinely empty port 2 cleanly.
fn dwc2_enumerate_downstream(hub_mps: u32) -> i64 {
  let hub_addr: u32 = dwc2_hub_addr();

  let bring_up_result: i64 = dwc2_hub_bring_up_port(hub_addr, hub_mps, dwc2_hub_port1());
  let final_result: i64 = bring_up_result;
  if bring_up_result == 1 {
    final_result = dwc2_hub_bring_up_port(hub_addr, hub_mps, dwc2_hub_port2());
  }
  if final_result != 0 {
    let _ = uart_puts("USB: no downstream device (checked both hub ports)\n");
    return 0 - 1;
  }

  let ddesc8: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = dwc2_build_get_device_descriptor_setup(8 as u32);
  let dstatus0: i64 = dwc2_control_in(0 as u32, 8 as u32, 8 as u32, ddesc8);
  if dstatus0 != 0 {
    let _ = uart_puts("USB: downstream GET_DESCRIPTOR(Device) failed\n");
    return 0 - 1;
  }
  let dmps0: u32 = buf_read_byte(ddesc8, 7 as u32);

  let downstream_addr: u32 = dwc2_downstream_addr();
  let _ = dwc2_build_set_address_setup(downstream_addr);
  let daddr_status: i64 = dwc2_control_no_data(0 as u32, dmps0);
  if daddr_status != 0 {
    let _ = uart_puts("USB: downstream SET_ADDRESS failed\n");
    return 0 - 1;
  }
  let _ = delay(50000);

  let ddesc18: mut ref i64 = dhruva_alloc_bytes(18);
  let _ = dwc2_build_get_device_descriptor_setup(18 as u32);
  let dstatus1: i64 = dwc2_control_in(downstream_addr, dmps0, 18 as u32, ddesc18);
  if dstatus1 != 0 {
    let _ = uart_puts("USB: downstream GET_DESCRIPTOR(Device) at new address failed\n");
    return 0 - 1;
  }
  let dblength: u32 = buf_read_byte(ddesc18, 0 as u32);
  let dbdesctype: u32 = buf_read_byte(ddesc18, 1 as u32);
  let dvendor_lo: u32 = buf_read_byte(ddesc18, 8 as u32);
  let dvendor_hi: u32 = buf_read_byte(ddesc18, 9 as u32);
  let dproduct_lo: u32 = buf_read_byte(ddesc18, 10 as u32);
  let dproduct_hi: u32 = buf_read_byte(ddesc18, 11 as u32);
  let d_id_vendor: u32 = dvendor_lo | (dvendor_hi << (8 as u32));
  let d_id_product: u32 = dproduct_lo | (dproduct_hi << (8 as u32));

  let _ = uart_puts("USB: enumerated downstream device addr=");
  let _ = uart_put_hex32(downstream_addr);
  let _ = uart_puts(" bMaxPacketSize0=");
  let _ = uart_put_hex32(dmps0);
  let _ = uart_puts(" idVendor=");
  let _ = uart_put_hex32(d_id_vendor);
  let _ = uart_puts(" idProduct=");
  let _ = uart_put_hex32(d_id_product);
  if (dblength != (18 as u32)) || (dbdesctype != (1 as u32)) {
    let _ = uart_puts(" (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }
  let _ = uart_puts(" (PASS)\n");

  // Round 56: SMSC LAN9512/9514's Ethernet function has no standard
  // USB class to detect it by (unlike CDC-ECM) -- Microchip/SMSC's own
  // device table (confirmed against Linux's smsc95xx.c `products[]`)
  // lists both 0xec00 and 0x9904 as valid PIDs for this exact chip
  // family, depending on EEPROM-strapped mode. Computed here, before
  // configuration, and threaded through dwc2_fetch_and_set_
  // configuration so its descriptor walk knows to capture this
  // device's bulk endpoints unconditionally rather than gating on an
  // interface class check that a vendor-specific device will never
  // match.
  let is_lan9512: u32 = if (d_id_vendor == (0x0424 as u32)) && ((d_id_product == (0xec00 as u32)) || (d_id_product == (0x9904 as u32))) { 1 as u32 } else { 0 as u32 };

  // Round 58: USB WiFi (Realtek RTL8188CU/RTL8192CU family) detection
  // by idVendor:idProduct, same shape as is_lan9512 above -- this
  // chipset's own USB interface is entirely vendor-specific (class
  // 0xFF), so there is no interface-class check to add to dwc2_fetch_
  // and_set_configuration's descriptor walk the way CDC-ECM/Bluetooth
  // HCI got one; detection happens here, independent of anything the
  // config descriptor says, matching LAN9512's own reasoning.
  let is_rtl8188cu: u32 = if (d_id_vendor == (0x0BDA as u32)) && (d_id_product == (0x8176 as u32)) { 1 as u32 } else { 0 as u32 };

  // Round 24 (WiFi dongle enumeration prep, 2026-08-28): every device
  // this driver enumerates -- LAN9512's own Ethernet function today,
  // a real WiFi dongle eventually -- needs to actually reach the
  // Configured state before its endpoints are usable for anything.
  // See dwc2_fetch_and_set_configuration's own comment for the full
  // story; this is the downstream device's own configuration step,
  // the same one dwc2_probe_device0 does for whatever sits on the
  // root port.
  let config_status: i64 = dwc2_fetch_and_set_configuration(downstream_addr, dmps0, 0 as u32, is_lan9512);
  if config_status != 0 {
    return config_status;
  }
  // Round 58: no config-descriptor walk needed for this device (see
  // is_rtl8188cu's own comment) -- probe it directly now that it's
  // configured.
  if is_rtl8188cu == (1 as u32) {
    let _ = rtl8188cu_probe(downstream_addr, dmps0);
  }
  // Round 56: index 0 might not be a configuration this driver knows
  // how to use at all (found live: QEMU's usb-net device's index 0 is
  // its RNDIS config, which this driver deliberately doesn't drive --
  // see dwc2_build_get_config_descriptor_setup's own comment). Retry
  // once with index 1 if nothing recognizable turned up. A device with
  // only one configuration simply fails this second GET_DESCRIPTOR
  // (there's no index 1 to return), which dwc2_fetch_and_set_
  // configuration already reports as a plain failure -- harmless here,
  // since config_retry_status is only consulted to decide whether to
  // keep the classification results from THIS attempt, not to abort
  // enumeration outright (index 0's own SET_CONFIGURATION, from the
  // call above, already succeeded and left the device in a valid,
  // if unrecognized, configured state).
  if (usb_msd_get_bot() == (0 as u32)) && (usb_net_get_kind() == (0 as u32)) {
    let _ = dwc2_fetch_and_set_configuration(downstream_addr, dmps0, 1 as u32, is_lan9512);
  }
  // Round 33: if that configuration step just found a mass-storage
  // (BOT) interface, prove the new bulk-transfer/BOT chain live right
  // here, the same "verify live at boot, not just self-test" pattern
  // every USB round in this project has followed -- gated on usb_msd_
  // get_bot() so a usb-net (or any non-mass-storage) device's own
  // enumeration is completely unaffected.
  if usb_msd_get_bot() == (1 as u32) {
    // A SCSI device commonly reports CHECK CONDITION / Unit Attention
    // on the very first command after attach (a standard "something
    // changed since you last talked to me" signal, not a real
    // failure) -- confirmed live under QEMU's own usb-storage model:
    // the first TEST UNIT READY reported csw_status=1, the second
    // (identical) call reported csw_status=0. Retrying once, bounded
    // (not `while true`), matches this project's own established
    // polling discipline and real SCSI initiator convention. This
    // also happens to be a genuine second exercise of the bulk-
    // transfer data-toggle tracking across a full extra CBW-out/
    // CSW-in round trip -- exactly the kind of repeat-transfer
    // scenario a toggle bug would show up in.
    let first_status: i64 = usb_msd_test_unit_ready(downstream_addr);
    if first_status != 0 {
      let _ = usb_msd_test_unit_ready(downstream_addr);
    }
    // Round 34: two more SCSI commands over the same live bulk
    // endpoints, both exercising a real data-IN stage (TEST UNIT
    // READY above has none) -- INQUIRY for device identification,
    // READ CAPACITY(10) for the device's real sector count/size,
    // needed before any future round can actually read/write a real
    // sector.
    let _ = usb_msd_inquiry(downstream_addr);
    let _ = usb_msd_read_capacity10(downstream_addr);
    // Round 35: the actual point of this whole feature -- a real
    // sector write, then a real sector read back, over the bulk
    // endpoints this same boot's config-descriptor parse discovered.
    let _ = usb_msd_read10_write10_check(downstream_addr);
    // Round 36: prove the FS layer's own block-device abstraction
    // (dharafs_block_read/dharafs_block_write) genuinely works against this
    // same device, not just the low-level usb_msd_read10/write10
    // primitives round 35 already proved.
    let _ = dharafs_block_dev_self_check();
  }
  return 0;
}

// First real enumeration milestone: fetch the first 8 bytes of device
// address 0's device descriptor (every USB device answers at address
// 0 before a host assigns it a real one), confirm the two fixed
// fields a genuine device descriptor always has -- bLength=18 (byte 0)
// and bDescriptorType=1/DEVICE (byte 1) -- then assign it a real
// address (SET_ADDRESS) and re-fetch the FULL 18-byte descriptor from
// that new address, confirming addressing itself actually worked (a
// device that silently ignored SET_ADDRESS but still happened to
// answer at address 0 forever would otherwise look identical to a
// success). Prints idVendor/idProduct (bytes 8-9/10-11, little-endian)
// from the final full descriptor -- the two fields that actually
// identify which real device this is, the natural next thing an
// enumeration milestone should be able to show. A transfer
// "succeeding" but returning garbage bytes would be a much worse
// silent failure than an honest error return, the same reasoning
// behind every checksum/validation check elsewhere in this project.
fn dwc2_probe_device0() -> i64 {
  let desc8: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = dwc2_build_get_device_descriptor_setup(8 as u32);
  let status0: i64 = dwc2_control_in(0 as u32, 8 as u32, 8 as u32, desc8);
  if status0 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Device) transfer failed\n");
    return 0 - 1;
  }
  let blength0: u32 = buf_read_byte(desc8, 0 as u32);
  let bdesctype0: u32 = buf_read_byte(desc8, 1 as u32);
  let mps0: u32 = buf_read_byte(desc8, 7 as u32);
  if (blength0 != (18 as u32)) || (bdesctype0 != (1 as u32)) {
    let _ = uart_puts("USB: device0 descriptor probe (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }

  let new_addr: u32 = dwc2_hub_addr();
  let _ = dwc2_build_set_address_setup(new_addr);
  let addr_status: i64 = dwc2_control_no_data(0 as u32, mps0);
  if addr_status != 0 {
    let _ = uart_puts("USB: SET_ADDRESS transfer failed\n");
    return 0 - 1;
  }
  // Real hardware/most devices need a short settle time after SET_
  // ADDRESS before answering at the new address -- bounded, matching
  // this project's own established pattern for any post-hardware-
  // action settle wait (the port reset sequence earlier uses the
  // same shape).
  let _ = delay(50000);

  let desc18: mut ref i64 = dhruva_alloc_bytes(18);
  let _ = dwc2_build_get_device_descriptor_setup(18 as u32);
  let status1: i64 = dwc2_control_in(new_addr, mps0, 18 as u32, desc18);
  if status1 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Device) at new address failed\n");
    return 0 - 1;
  }
  let blength1: u32 = buf_read_byte(desc18, 0 as u32);
  let bdesctype1: u32 = buf_read_byte(desc18, 1 as u32);
  let vendor_lo: u32 = buf_read_byte(desc18, 8 as u32);
  let vendor_hi: u32 = buf_read_byte(desc18, 9 as u32);
  let product_lo: u32 = buf_read_byte(desc18, 10 as u32);
  let product_hi: u32 = buf_read_byte(desc18, 11 as u32);
  let id_vendor: u32 = vendor_lo | (vendor_hi << (8 as u32));
  let id_product: u32 = product_lo | (product_hi << (8 as u32));

  let _ = uart_puts("USB: enumerated device addr=");
  let _ = uart_put_hex32(new_addr);
  let _ = uart_puts(" bMaxPacketSize0=");
  let _ = uart_put_hex32(mps0);
  let _ = uart_puts(" idVendor=");
  let _ = uart_put_hex32(id_vendor);
  let _ = uart_puts(" idProduct=");
  let _ = uart_put_hex32(id_product);
  if (blength1 != (18 as u32)) || (bdesctype1 != (1 as u32)) {
    let _ = uart_puts(" (FAIL, bad bLength/bDescriptorType after SET_ADDRESS)\n");
    return 0 - 1;
  }
  let _ = uart_puts(" (PASS)\n");

  // Round 24 (WiFi dongle enumeration prep, 2026-08-28): the hub
  // itself needs to reach the Configured state too, same as any other
  // device -- USB 2.0 spec chapter 11 hub-class requests (SET_PORT_
  // FEATURE/GET_PORT_STATUS, already in live use one call below) are
  // never actually specified as requiring it, and QEMU's own
  // synthetic hub has always answered them regardless, which is
  // exactly why this gap went unnoticed through round 14's hub-
  // enumeration work -- but per spec this is still the correct order
  // of operations, and a real hub is under no obligation to be as
  // forgiving as QEMU's model about it.
  let config_status: i64 = dwc2_fetch_and_set_configuration(new_addr, mps0, 0 as u32, 0 as u32);
  if config_status != 0 {
    return 0 - 1;
  }
  return dwc2_enumerate_downstream(mps0);
}

// Phase 2 priority-inversion demo. All three tasks share one mutex
// (ceiling = 0, HIGH's own priority -- the highest priority of any
// task that will ever lock it). None of the three ever calls
// yield_now (gone since Step B) -- the timer tick preempts freely
// whenever a strictly higher *effective* priority task is ready.
//
// task_c (LOW) holds the mutex for a real stretch of wall-clock time
// (the delay() inside its critical section) specifically so
// task_b (MEDIUM)'s frequent 1-tick sleep is likely to expire *during*
// that window at least once per run. Without the ceiling protocol,
// that's exactly the classic failure: MEDIUM (priority 1) would
// preempt LOW (priority 2) the instant it's ready, LOW could never
// finish and release, and task_a (HIGH, priority 0) -- which also
// wants the same mutex -- would be blocked not just by LOW's bounded
// critical section but by however long MEDIUM feels like running:
// unbounded inversion via a task that doesn't even touch the
// resource. With it, LOW's dhruva_prio_lock(0) call boosts LOW to
// priority 0 for the duration -- tied with HIGH's own true priority,
// and scheduler_pick_next's "ties favor the incumbent" rule means
// neither MEDIUM nor HIGH preempts LOW while it holds the lock, no
// matter how many tick-driven scheduling decisions happen in between.
// The bound on how long HIGH can be kept waiting is now just LOW's
// own critical-section length -- provable, not open-ended.
#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_a() -> i64 {
  while true {
    let _ = task_sleep_ticks(3);
    let _ = uart_puts("HIGH: waking, requesting resource\n");
    let _ = dhruva_prio_lock(0);
    let _ = uart_puts("HIGH: acquired resource\n");
    let _ = dhruva_prio_unlock(0);
    let _ = uart_puts("HIGH: released resource\n");
  }
  return 0;
}

#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_b() -> i64 {
  while true {
    let _ = task_sleep_ticks(1);
    let _ = uart_puts("MEDIUM: running (never touches the resource)\n");
  }
  return 0;
}

#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_c() -> i64 {
  while true {
    let _ = dhruva_prio_lock(0);
    let _ = uart_puts("LOW: locked, entering critical section\n");
    let _ = delay(3000000);
    let _ = uart_puts("LOW: leaving critical section, unlocking\n");
    let _ = dhruva_prio_unlock(2);
    let _ = task_sleep_ticks(2);
  }
  return 0;
}

// Phase 5 step 1: classical power governor -- "board-specific: the
// Phase 5 DVFS frequency/voltage *tables*" per DHRUVA_ARCHITECTURE.md
// §0's own framing (the algorithm below is the portable baseline; the
// actual MHz numbers are per-board). Three fixed levels, not a
// finer-grained table: this is a demonstration governor proving the
// architecture (deterministic, run-queue-depth-driven, fully
// QEMU-testable for logic per §7 Phase 5), not a tuned production one.
// BCM2835's ARM core on a Pi 1 Model B (ARM1176JZF-S) documents a
// settable range roughly 250-700MHz via the VideoCore mailbox's own
// "set clock rate" property tag (see governor_apply below).
fn governor_freq_low() -> i64 {
  return 250;
}
fn governor_freq_mid() -> i64 {
  return 450;
}
fn governor_freq_high() -> i64 {
  return 700;
}

// Maps run-queue depth (how many of the 5 real tasks -- HIGH/MEDIUM/
// LOW/GC/SHELL, not counting idle itself -- are ready RIGHT NOW; see
// scheduler_ready_count's own comment) to a desired frequency level.
// Deliberately a pure function with no I/O or hardware access at all:
// fully deterministic and unit-testable under QEMU regardless of
// whether governor_apply's actual mailbox write has any real effect
// in emulation (it doesn't -- QEMU doesn't model wattage, only timing;
// see DHRUVA_ARCHITECTURE.md §7 Phase 5's own caveat about this).
fn governor_desired_freq_mhz(ready_count: i64) -> i64 {
  if ready_count <= 1 {
    return governor_freq_low();
  }
  if ready_count <= 3 {
    return governor_freq_mid();
  }
  return governor_freq_high();
}

// Boot-time self-test, the same discipline as eval_self_test above:
// deterministic pure logic like this needs no live interactive input
// to verify, unlike governor_apply's own real-hardware effect.
fn governor_self_test(ready_count: i64, expected_mhz: i64) -> i64 {
  let got: i64 = governor_desired_freq_mhz(ready_count);
  let _ = uart_puts("GOVERNOR: ready_count=");
  let _ = uart_put_i64(ready_count);
  let _ = uart_puts(" -> ");
  let _ = uart_put_i64(got);
  let _ = uart_puts("MHz");
  if got == expected_mhz {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expected ");
    let _ = uart_put_i64(expected_mhz);
    let _ = uart_puts(")\n");
  }
  return 0;
}

// Phase 5 step 2: additive, fixed-cost smoothed scoring function --
// DHRUVA_ARCHITECTURE.md §7 Phase 5 step 2 ("offline-trained, fixed-
// cost scoring function re-ranking best-effort tasks and DVFS steps
// only... always wcet_cycles-bounded itself... deliberately not a
// neural network"). Weights below were fit OFFLINE (power/
// train_governor.py, a small integer grid search against a fixed
// synthetic best-effort workload replay -- run once, at development
// time, on the host; nothing about this runs, trains, or infers
// on-device) and hand-copied here as plain constants. At runtime this
// is 4 multiplies, 3 adds, and one integer divide -- always the same
// four operations regardless of input, trivially WCET-bounded, and
// never consulted for hard-RT dispatch (DVFS/best-effort only, exactly
// like step 1).
//
// What it actually buys over step 1's instantaneous-sample governor:
// step 1 reacts identically to a single-tick noise spike and genuine
// sustained load, since it only ever looks at the current sample.
// Averaging over a short history (most recent sample weighted
// heaviest, oldest lightest) damps a one-tick spike -- by the time a
// real hardware DVFS transition would complete, a one-tick blip is
// already over -- while still climbing for load that actually
// persists across several samples. Verified via power/train_governor.py
// against DHRUVA_ARCHITECTURE.md §7 Phase 5's own fixed workload
// replay: 25% fewer DVFS transitions, 16% less total MHz-time, while
// still reaching the HIGH level during the replay's sustained burst.
//
// The honest cost of this, not just the win: smoothing necessarily
// trades away some responsiveness. The same replay shows a real load
// plateau (4 ticks at a MEDIUM-triggering level) mostly staying
// suppressed at LOW, only crossing to MEDIUM on the last of those 4
// ticks -- a genuine bias/lag any moving-average governor accepts in
// exchange for not thrashing on noise, not a bug in this
// implementation specifically. See the boot-time replay self-test
// below for the exact numbers, reproduced live under QEMU.
fn governor_v2_weight0() -> i64 {
  return 6;
}
fn governor_v2_weight1() -> i64 {
  return 6;
}
fn governor_v2_weight2() -> i64 {
  return 3;
}
fn governor_v2_weight3() -> i64 {
  return 1;
}
fn governor_v2_divisor() -> i64 {
  return 16;
}

// Pure function -- takes the 4 history samples as explicit arguments
// rather than reading governor_state.S's persistent window itself, so
// it's directly replay-testable with synthetic inputs exactly like
// governor_desired_freq_mhz (v1) already is, with no hidden state to
// reset between test cases.
fn governor_desired_freq_mhz_v2(h0: i64, h1: i64, h2: i64, h3: i64) -> i64 {
  let w0: i64 = governor_v2_weight0();
  let w1: i64 = governor_v2_weight1();
  let w2: i64 = governor_v2_weight2();
  let w3: i64 = governor_v2_weight3();
  let divisor: i64 = governor_v2_divisor();
  let score: i64 = (w0 * h0 + w1 * h1 + w2 * h2 + w3 * h3) / divisor;
  return governor_desired_freq_mhz(score);
}

// Live governor step -- called from task_d (idle) below, deliberately
// NOT from the timer tick/ISR path: governor_apply_freq_mhz's mailbox
// round-trip is real hardware I/O with its own (bounded, but nonzero)
// latency, and this project's whole architecture keeps anything like
// that off the hard-RT dispatch path on purpose (see
// DHRUVA_ARCHITECTURE.md §7 Phase 5: "never consulted for hard-RT
// dispatch"). Tying it to idle specifically is a real, acknowledged
// simplification, not a full production design: it means an upward
// frequency step (system suddenly gets busy) only gets applied the
// next time idle happens to run, not instantly -- acceptable for a
// step-1 demonstration governor per the architecture doc's own
// framing ("classical governor first"), less so for a tuned one.
// BUG (round 13 audit, 2026-08-27): this used to print hex instead of
// decimal, reasoning that uart_put_i64 "allocates scratch space via
// dhruva_alloc_bytes" and task_d (this function's only caller) is
// #[no_heap]. That premise went stale at some point (uart_put_i64
// hasn't allocated on every call for a while now -- it reads a
// persistent scratch buffer via uart_digits_scratch_get instead, set
// up once at boot; see uart_put_i64's own comment) and nobody updated
// this one to match, leaving the one governor log line that actually
// matters live (this one) printing hex while every other governor
// print in this file (governor_self_test, governor_replay_test) uses
// plain decimal MHz -- forcing a reader to mentally convert hex to
// make sense of it, the only place in this subsystem that needed to.
// Confirmed empirically, not just by re-reading uart_put_i64: this
// file still builds and runs correctly calling it here, proving
// vani's own #[no_heap] checker doesn't reject it (it wouldn't have
// compiled at all if it did). Switched to uart_put_i64 for consistency
// with every other governor print. Only prints on an actual level
// change, not every idle wake, since governor_get_last_applied_mhz
// gives a cheap way to skip the mailbox round-trip (and the log spam)
// entirely when nothing changed.
fn governor_step() -> i64 {
  let ready: i64 = scheduler_ready_count();
  // Step 2 live: push the real sample into the smoothing window and
  // decide from the smoothed score, not the raw instantaneous sample
  // -- v1 (governor_desired_freq_mhz) stays fully intact and directly
  // callable (the self-test above and the replay test below both
  // still use it), per the architecture's own "additive, not a
  // replacement" framing; this is just which one actually drives the
  // live hardware call now that step 2 is proven better on the fixed
  // replay.
  let _ = governor_history_push(ready);
  let h0: i64 = governor_history_get0();
  let h1: i64 = governor_history_get1();
  let h2: i64 = governor_history_get2();
  let h3: i64 = governor_history_get3();
  let desired: i64 = governor_desired_freq_mhz_v2(h0, h1, h2, h3);
  let last: i64 = governor_get_last_applied_mhz();
  if desired != last {
    let status: i64 = governor_apply_freq_mhz(desired);
    if status == 0 {
      let _ = governor_set_last_applied_mhz(desired);
    }
    let _ = uart_puts("GOVERNOR: step ready=");
    let _ = uart_put_i64(ready);
    let _ = uart_puts(" desired_mhz=");
    let _ = uart_put_i64(desired);
    let _ = uart_puts(" apply_status=");
    let _ = uart_put_i64(status);
    let _ = uart_puts("\n");
  }
  return 0;
}

// Phase 5 step 2's actual milestone (DHRUVA_ARCHITECTURE.md §7 Phase 5:
// "measured scheduling/idle-time improvement over step-1 alone, on a
// fixed best-effort workload replay under QEMU") -- replays the EXACT
// same 30-sample synthetic workload power/train_governor.py trained
// against (kept in sync by hand; there's no way to literally share an
// array between a host Python script and a vani program, which is
// itself the whole point of "offline training, on-device only ever
// runs the fixed result") through both v1 (instantaneous) and v2
// (smoothed) governors, counting DVFS transitions and total MHz-time
// for each, live, under QEMU, at boot.
fn governor_replay_test() -> i64 {
  let workload: mut ref i64 = dhruva_alloc_bytes(30);
  let _ = buf_write_byte(workload, 0 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 1 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 2 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 3 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 4 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 5 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 6 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 7 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 8 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 9 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 10 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 11 as u32, 4 as u32);
  let _ = buf_write_byte(workload, 12 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 13 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 14 as u32, 4 as u32);
  let _ = buf_write_byte(workload, 15 as u32, 3 as u32);
  let _ = buf_write_byte(workload, 16 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 17 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 18 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 19 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 20 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 21 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 22 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 23 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 24 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 25 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 26 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 27 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 28 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 29 as u32, 0 as u32);

  let v1_transitions: i64 = 0;
  let v1_mhz_time: i64 = 0;
  let v1_prev_level: i64 = 0 - 1; // sentinel: no previous level yet
  let i: i64 = 0;
  while i < 30 {
    let sample: i64 = buf_read_byte(workload, i as u32) as i64;
    let level: i64 = governor_desired_freq_mhz(sample);
    v1_mhz_time = v1_mhz_time + level;
    if (v1_prev_level >= 0) && (level != v1_prev_level) {
      v1_transitions = v1_transitions + 1;
    }
    v1_prev_level = level;
    i = i + 1;
  }

  // Uses the SAME persistent history governor_step() will later use
  // live -- reset before and after so neither the replay's own
  // synthetic samples leak into real operation, nor (in principle) a
  // prior live run's state leaks into this test.
  let _ = governor_history_reset();
  let v2_transitions: i64 = 0;
  let v2_mhz_time: i64 = 0;
  let v2_prev_level: i64 = 0 - 1;
  let j: i64 = 0;
  while j < 30 {
    let sample2: i64 = buf_read_byte(workload, j as u32) as i64;
    let _ = governor_history_push(sample2);
    let h0: i64 = governor_history_get0();
    let h1: i64 = governor_history_get1();
    let h2: i64 = governor_history_get2();
    let h3: i64 = governor_history_get3();
    let level2: i64 = governor_desired_freq_mhz_v2(h0, h1, h2, h3);
    v2_mhz_time = v2_mhz_time + level2;
    if (v2_prev_level >= 0) && (level2 != v2_prev_level) {
      v2_transitions = v2_transitions + 1;
    }
    v2_prev_level = level2;
    j = j + 1;
  }
  let _ = governor_history_reset();

  let _ = uart_puts("GOVERNOR REPLAY: v1 transitions=");
  let _ = uart_put_i64(v1_transitions);
  let _ = uart_puts(" mhz_time=");
  let _ = uart_put_i64(v1_mhz_time);
  let _ = uart_puts("\n");
  let _ = uart_puts("GOVERNOR REPLAY: v2 transitions=");
  let _ = uart_put_i64(v2_transitions);
  let _ = uart_puts(" mhz_time=");
  let _ = uart_put_i64(v2_mhz_time);
  let _ = uart_puts("\n");

  if (v2_transitions < v1_transitions) && (v2_mhz_time < v1_mhz_time) {
    let _ = uart_puts("GOVERNOR REPLAY: v2 improves over v1 (PASS)\n");
  } else {
    let _ = uart_puts("GOVERNOR REPLAY: v2 did NOT improve over v1 (FAIL)\n");
  }
  return 0;
}

// Idle: always ready, lowest priority, never sleeps. Only ever runs
// when HIGH/MEDIUM/LOW are all genuinely asleep at the same moment --
// seeing "idle" in the log at all is a real, useful signal that the
// scheduler correctly fell through every real task's readiness check
// rather than a sign of anything wrong.
//
// Phase 5 task #1 -- "race to idle": the old body busy-waited via
// delay()'s pure spin loop, burning cycles (and, on real hardware,
// power) doing nothing between prints. cpu_wfi() actually halts
// instruction fetch until the next interrupt (the 500ms timer tick, if
// nothing else preempts sooner) instead of spinning -- the real
// hardware benefit QEMU can't put a wattage number on (see
// DHRUVA_ARCHITECTURE.md §7 Phase 5's own caveat), but the scheduling
// behavior itself (idle genuinely blocking rather than burning a fixed
// cycle count every pass) is real and observable here too.
#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_d() -> i64 {
  while true {
    let _ = uart_puts("idle\n");
    let _ = governor_step();
    let _ = cpu_wfi();
  }
  return 0;
}

// Task #5: GC/compaction, running as its own dedicated best-effort
// task -- priority 3 (below every hard-RT task, above idle; see
// context_switch.S's start_multitasking comment for the reserved-band
// reasoning), never on the hard-RT path. Deliberately NOT #[no_heap]
// (unlike task_a/b/c/d above): dharafs_compact's re-appends genuinely need
// dhruva_alloc_bytes, and that's fine here specifically because this
// task can never preempt or block anything hard-RT -- the same
// compiler boundary that forbids heap allocation in an ISR or a
// hard-RT task doesn't need to (and structurally can't usefully)
// forbid it in a task whose whole job is best-effort background work.
// Sleeps far longer between passes than any hard-RT task's own
// period (dharafs_compact's own short-log check already makes a pass with
// nothing to reclaim cheap, but there's no reason to even attempt one
// every tick).
// Round 27 (2026-08-28): also this project's periodic maintenance
// heartbeat for the DHCP client -- see the comment on kernel_main's
// own live dhcp_client_start call for why nothing had ever done this
// before now. Folded into task_e rather than given a dedicated task:
// this project's scheduler has a hardcoded 6-task table
// (context_switch.S's sleep_until_table, scheduler_ready_count's own
// "6 tasks" comment), so adding a 7th would mean touching scheduler
// internals for a periodic poll that fits naturally into an already-
// existing best-effort loop instead. task_e is the right home
// specifically because it's already the one task whose whole job is
// "not hard-RT, needs heap, tolerates a multi-tick sleep between
// passes" -- exactly DHCP's own requirements too.
//
// Known, real limitation this creates rather than just theorizes
// about: netif has ONE shared FIFO queue with no per-protocol demux
// (see socket_udp_recv/icmp_poll/dhcp_client_poll/tcp_conn_poll's own
// comments on this already-accepted tradeoff) -- before this round,
// only self-tests (which run strictly sequentially, one at a time,
// before any task exists) ever touched it live. Now task_e's own
// periodic dhcp_client_poll and the shell's own live network commands
// -- `ping`'s icmp_poll (round 26), `tcpecho`'s tcp_conn_poll (round
// 29), and `udpecho`'s own inlined socket_udp_recv polling (round 30)
// -- are genuinely concurrent, independently-scheduled live consumers
// of that same queue -- any one of them can dequeue-and-drop a frame
// another was actually waiting for. Not fixed here
// (a real per-protocol receive path is a separate, larger redesign);
// flagged honestly rather than silently shipped as if it were fully
// safe.
// BUG (round 27 audit): #[bounded_stack(bytes=1024)] was already too
// tight for this task's own pre-existing dharafs_compact chain in
// principle (never actually caught, since nothing before this round
// added a deeper call from here) -- adding dhcp_client_poll's own
// chain (dhcp_client_check_lease -> udp_send -> udp_build ->
// udp_checksum) pushed the compiler's own static worst-case analysis
// past it for real: 1120 bytes via that exact chain, caught at
// compile time, not silently left as a real-hardware-only risk the
// way an unchecked stack depth normally would be. Raised to 2048 --
// matching task_f's own already-established bound -- for headroom,
// not just the bare minimum.
// BUG (round 69 audit): the same class of thing happened again --
// DharaFS media encryption's round-69 AEAD upgrade means
// dharafs_compact's own dharafs_block_read can now reach all the way
// down through dharafs_crypto_decrypt_block -> chacha20_poly1305_
// decrypt -> poly1305_mac, a materially deeper chain than the old
// plain-ChaCha20 transform it replaced; the compiler's own static
// analysis caught this at compile time (2052 bytes needed, budget was
// 2048), not silently left as a real-hardware-only risk. Raised to
// 4096 for real headroom against the next addition to this same
// chain, not just the bare 4 bytes actually needed today.
#[no_mangle]
#[bounded_stack(bytes=4096)]
fn task_e() -> i64 {
  let gc_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_path_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let compact_data_buf: mut ref i64 = dhruva_alloc_bytes(4096);
  let dhcp_my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(dhcp_my_mac);
  while true {
    let _ = task_sleep_ticks(20);
    // Round 76: docs/RTOS_GAP_ANALYSIS.md's own "No concurrency lock
    // protecting DharaFS's own shared state" gap -- task_e (this
    // task) and task_f (the shell) both call into DharaFS with
    // nothing preventing a timer-tick preemption from interrupting
    // one task's FS operation mid-update and resuming a DIFFERENT
    // task's own FS call before the first finishes. Ceiling=2 (not
    // this task's own priority, 3): task_fsq (the FS request queue
    // dispatcher, round 67) also calls into DharaFS at priority 2,
    // numerically higher than task_e/task_f's shared priority 3 --
    // the ceiling must cover the HIGHEST priority of any real
    // contender, or task_fsq could still preempt this critical
    // section (see task_fsq's own matching lock below, and
    // shell_dispatch's call site in task_f, for the other two
    // contenders this same ceiling protects against).
    let _ = dhruva_prio_lock(2);
    // Live proof the boost genuinely happened, not just that the call
    // compiles -- current_eff_prio() is the same real accessor task_c's
    // own long-established dhruva_prio_lock demo already uses to prove
    // its own boost live. Printed once per pass (every 20 ticks), not
    // removed after verification, since it costs nothing ongoing and
    // gives any future round real evidence this lock is actually
    // engaging, not silently a no-op if e.g. a future refactor ever
    // reordered these calls relative to the DharaFS work they guard.
    let _ = uart_puts("GC: entering DharaFS critical section, eff_prio=");
    let _ = uart_put_hex32(current_eff_prio());
    let _ = uart_puts("\n");
    let _ = dharafs_compact(compact_buf, compact_path_buf, compact_data_buf);
    let gc_mode_len: i64 = dharafs_read("/config/mode", gc_buf);
    let _ = uart_puts("GC: compaction pass, /config/mode = \"");
    let _ = dharafs_print_data(gc_buf, gc_mode_len);
    let _ = uart_puts("\"\n");
    let _ = dhruva_prio_unlock(3);
    let _ = uart_puts("GC: left DharaFS critical section, eff_prio=");
    let _ = uart_put_hex32(current_eff_prio());
    let _ = uart_puts("\n");
    let _ = dhcp_client_poll(dhcp_my_mac);
  }
  return 0;
}

// Task #9: interactive shell (ls/cat/rm/write), the vani REPL entry
// point's supporting infrastructure -- everything below this comment
// through task_f parses and dispatches one already-received line out
// of shell_state.S's line buffer (irq_dispatch, in real IRQ context,
// is what actually fills it one byte at a time; see uart_rx_irq_init).
//
// Returns the index one past the first space in buf[start..line_len),
// or line_len itself if there's no space in that range -- "the rest of
// the line" then trivially reduces to the empty range [line_len, line_len).
fn shell_find_space(buf: mut ref i64, start: i64, line_len: i64) -> i64 {
  let i: i64 = start;
  while i < line_len {
    let c: u32 = buf_read_byte(buf, i as u32);
    if c == (32 as u32) {
      return i;
    }
    i = i + 1;
  }
  return line_len;
}

// True iff buf[start..end) is byte-for-byte equal to the literal
// `word` -- the only way to test a runtime line buffer against a
// known command name, since word is a Str literal (str_byte_at) and
// buf is raw shell input (buf_read_byte), two different representations
// with no shared comparison built into the language itself.
fn shell_word_matches(buf: mut ref i64, start: i64, end: i64, word: Str) -> i64 {
  let wlen: i64 = str_len_bytes(word);
  if (end - start) != wlen {
    return 0;
  }
  let i: i64 = 0;
  let ok: i64 = 1;
  while i < wlen {
    let a: u32 = buf_read_byte(buf, (start + i) as u32);
    let b: u32 = str_byte_at(word, i) as u32;
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }
  return ok;
}

fn shell_copy_range(buf: mut ref i64, start: i64, end: i64, out_buf: mut ref i64) -> i64 {
  let n: i64 = end - start;
  let i: i64 = 0;
  while i < n {
    let c: u32 = buf_read_byte(buf, (start + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, c);
    i = i + 1;
  }
  return n;
}

// Round 42: minimal ASCII-decimal parser for shell command arguments
// (chmod's mode, su's uid/gid) -- a plain digit-by-digit accumulator,
// same directness as this file's other shell helpers rather than
// reaching for eval_expr_raw (that evaluator handles arithmetic
// expressions, not bare unsigned integers, and building a Str just to
// hand to a richer parser would be more machinery than this needs).
// Returns -1 if the range is empty or contains a non-digit.
fn shell_parse_decimal(buf: mut ref i64, start: i64, end: i64) -> i64 {
  if start >= end {
    return 0 - 1;
  }
  // 10 digits comfortably covers any real uid/gid/mode value while
  // staying nowhere near i64 overflow (max i64 has 19 digits) --
  // rejecting outright rather than letting a pathological input reach
  // the accumulator below and trap.
  if (end - start) > 10 {
    return 0 - 1;
  }
  let value: i64 = 0;
  let i: i64 = start;
  while i < end {
    let c: u32 = buf_read_byte(buf, i as u32);
    if (c < (48 as u32)) || (c > (57 as u32)) {
      return 0 - 1;
    }
    value = (value * 10) + ((c - (48 as u32)) as i64);
    i = i + 1;
  }
  return value;
}

// Task #10: minimal arithmetic expression evaluator -- +, -, *, /,
// parentheses, standard precedence, integers -- wired into the shell
// as `eval <expr>`. The closest thing to a "vani REPL entry point"
// achievable on bare metal: vanic itself is a host Rust program and
// can't be embedded on target. Deliberately an ITERATIVE two-stack
// (values + operators) evaluator, not recursive descent: this project
// has already hit real friction with vani's v1 checkers around
// anything not statically bounded (the UART drain loop's `while` vs
// `for`, `#[interrupt]`'s outright ban on recursion) -- a hand-rolled
// explicit-stack algorithm with a fixed max depth sidesteps that whole
// class of question instead of hoping recursion through shell_dispatch
// (already #[bounded_stack]-constrained via task_f) happens to check
// out.
//
// Values are stored as u32 words with manual sign-extension on read
// (`eval_to_i64`): `buf_write_u32`/`buf_read_u32` are u32-native, and
// vani's own `as` cast from u32 to i64 zero-extends rather than sign-
// extends, which would silently turn a stored -5 into a large positive
// number on the way back out -- every other buffer-based value in this
// file is a block number, length, or checksum, all non-negative, so
// this is the first place that gap actually mattered.

// True iff the low bit of `raw` marks it as negative (bit 31 set),
// reversing the zero-extension `as u32 -> i64` would otherwise do.
fn eval_to_i64(raw: u32) -> i64 {
  if (raw & (0x80000000 as u32)) != (0 as u32) {
    return (raw as i64) - 4294967296;
  }
  return raw as i64;
}

// BUG found in round 2's audit: the values stack below used to store
// each number as a single u32 word (4 bytes/slot) via
// `buf_write_u32(values, slot*4, n as u32)` -- silently truncating any
// value outside +-2 billion the instant it was pushed, before any
// arithmetic in eval_apply ever ran. `eval "999999999999*999999999999"`
// produced a wrong SILENT answer (no error, no hang) because both
// operands were already corrupted to small values before the multiply,
// so the multiply itself never overflowed. Fixed by storing each i64 as
// a hi/lo u32 pair, 8 bytes apart (verified round-trip for both large
// positive and negative values via a standalone test against the real
// vani-compiler on this ARM target). The `ops` stack is NOT affected --
// it only ever holds small ASCII operator codes (43/45/42/47/40), so
// its own `eval_to_i64(buf_read_u32(ops, ...))` call sites are
// unchanged.
fn eval_write_value(values: mut ref i64, slot: i64, n: i64) -> i64 {
  let lo: u32 = n as u32;
  let hi: u32 = (n >> 32) as u32;
  let _ = buf_write_u32(values, (slot * 8) as u32, lo);
  let _ = buf_write_u32(values, (slot * 8 + 4) as u32, hi);
  return 0;
}

fn eval_read_value(values: mut ref i64, slot: i64) -> i64 {
  let lo: u32 = buf_read_u32(values, (slot * 8) as u32);
  let hi: u32 = buf_read_u32(values, (slot * 8 + 4) as u32);
  return ((hi as i64) << 32) | ((lo as i64) & 4294967295);
}

fn eval_prec(op: i64) -> i64 {
  if (op == (42 as i64)) || (op == (47 as i64)) { // '*' '/'
    return 2;
  }
  if (op == (43 as i64)) || (op == (45 as i64)) { // '+' '-'
    return 1;
  }
  return 0;
}

fn eval_has_error(error_buf: mut ref i64) -> u32 {
  return buf_read_u32(error_buf, 0 as u32);
}

// BUG (found via audit, 2026-08-27, two layers deep): this function
// used to compute a+b/a-b/a*b directly (to compare against
// i64_saturating_add/sub/mul and detect overflow after the fact) and
// rely on vani's own compiler-inserted overflow trap to either not
// fire (silent wraparound, caught by the saturating comparison) or, if
// it ever DID fire, at least not be reached because the values stack
// (see eval_write_value/eval_read_value above) was truncating every
// operand to u32 before it got this far, so no real overflow was ever
// actually happening at this layer. Fixing the values-stack truncation
// bug first exposed the real problem underneath: once a and b actually
// carry their full, correct magnitude, computing the plain `a * b` for
// "999999999999*999999999999" HANGS THE ENTIRE KERNEL FOREVER on this
// exact ARM target/build (confirmed live -- QEMU output stops dead at
// that exact self-test line and never resumes even after 60s, whereas
// the identical `999999999999*999999999999` compiled standalone via
// `vanic run` panics-and-exits(3) instead of hanging; ARM-native
// codegen and lli-interpreted bitcode disagree on whether/how the trap
// fires -- a vani-compiler-level gap, out of scope to fix here).
// runtime_stubs.c's exit() is an infinite halt loop with no OS to
// return to, so ANY trap firing on this path freezes the whole kernel,
// not just the "eval" command that triggered it -- computing the
// overflowing operation at all, even just to compare it against a safe
// saturating result afterward, is not survivable here.
//
// Fixed by never executing an operation that can overflow in the first
// place: i64_add_would_overflow/i64_sub_would_overflow/
// i64_mul_would_overflow below decide purely from a and b, using only
// subtractions/comparisons/divisions that are themselves provably safe
// across the full i64 domain (see each function's own comment), and
// the real +/-/* only ever runs once that check has already proven it
// cannot overflow.
fn i64_add_would_overflow(a: i64, b: i64) -> i64 {
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  if b > 0 {
    // b>0 here, so i64_max - b is in [0, i64_max-1] -- never overflows.
    if a > (i64_max - b) {
      return 1;
    }
    return 0;
  }
  if b < 0 {
    // b<0 here (down to i64_min); i64_min - b is in [i64_min+1, -1]
    // for b > i64_min, and exactly 0 for b == i64_min -- never
    // overflows either way.
    if a < (i64_min - b) {
      return 1;
    }
    return 0;
  }
  return 0; // b == 0 never overflows
}

fn i64_sub_would_overflow(a: i64, b: i64) -> i64 {
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  if b < 0 {
    // b<0 here, so i64_max + b is in [-1, i64_max-1] -- never overflows.
    if a > (i64_max + b) {
      return 1;
    }
    return 0;
  }
  if b > 0 {
    // b>0 here, so i64_min + b is in [i64_min+1, -1] -- never overflows.
    if a < (i64_min + b) {
      return 1;
    }
    return 0;
  }
  return 0; // b == 0 never overflows
}

fn i64_mul_would_overflow(a: i64, b: i64) -> i64 {
  if (a == 0) || (b == 0) {
    return 0;
  }
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  // i64_min is the one value that can't be negated (-i64_min doesn't
  // fit in i64) -- handled explicitly so the abs_a/abs_b step below
  // never has to negate it.
  if a == i64_min {
    if b == 1 {
      return 0;
    }
    return 1;
  }
  if b == i64_min {
    if a == 1 {
      return 0;
    }
    return 1;
  }
  let abs_a: i64 = a;
  if a < 0 {
    abs_a = 0 - a;
  }
  let abs_b: i64 = b;
  if b < 0 {
    abs_b = 0 - b;
  }
  // abs_a * abs_b overflows i64 iff abs_a > i64_max / abs_b (both
  // sides already known positive and neither is i64_min at this
  // point, so this division is always safe).
  if abs_a > (i64_max / abs_b) {
    return 1;
  }
  return 0;
}

fn eval_apply(op: i64, a: i64, b: i64, error_buf: mut ref i64) -> i64 {
  if op == (43 as i64) { // '+'
    if i64_add_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a + b;
  }
  if op == (45 as i64) { // '-'
    if i64_sub_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a - b;
  }
  if op == (42 as i64) { // '*'
    if i64_mul_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a * b;
  }
  if op == (47 as i64) { // '/'
    if b == 0 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    // i64::MIN / -1 is the one division that itself overflows (the
    // mathematical result, 2^63, doesn't fit in i64) -- not caught by
    // the b==0 check above, and (per this function's own history
    // above) a raw division trap here would hit the exact same "no OS
    // to return to" hang risk as +/-/* did.
    if (a == (0 - 9223372036854775807 - 1)) && (b == (0 - 1)) {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a / b;
  }
  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
  return 0;
}

// Evaluates buf[0..expr_len) as an arithmetic expression. error_buf[0]
// is set to 1 on any malformed input, unbalanced parens, stack overflow
// (more than 16 nested values/operators -- generous for anything that
// fits in the shell's own 128-byte line buffer), or division by zero;
// the returned i64 is meaningless whenever error_buf[0] is nonzero.
fn eval_expr_raw(buf: mut ref i64, expr_len: i64, error_buf: mut ref i64) -> i64 {
  let _ = buf_write_u32(error_buf, 0 as u32, 0 as u32);
  let values: mut ref i64 = eval_values_scratch_get(); // 16 slots * 8 bytes (see eval_write_value/eval_read_value)
  let ops: mut ref i64 = eval_ops_scratch_get();
  let vtop: i64 = 0;
  let otop: i64 = 0;
  let i: i64 = 0;
  // true if the NEXT token should start a value (a number, '(', or a
  // unary '-') rather than a binary operator or ')' -- what tells
  // "3 - 4" (binary) apart from "3 * -4" (unary) at the same '-' byte.
  let expect_value: i64 = 1;

  while (i < expr_len) && (eval_has_error(error_buf) == 0) {
    let c: u32 = buf_read_byte(buf, i as u32);
    if c == (32 as u32) {
      i = i + 1;
    } else {
      if (c >= (48 as u32)) && (c <= (57 as u32)) {
        let n: i64 = 0;
        // Same overflow-detection fix as eval_apply's own comment
        // explains in full -- a long enough digit run (e.g. 25+
        // digits) overflows i64 here too, before the value even
        // reaches an operator, and this build's overflow trap
        // doesn't reliably fire on this target either.
        while (i < expr_len) && (buf_read_byte(buf, i as u32) >= (48 as u32)) && (buf_read_byte(buf, i as u32) <= (57 as u32)) && (eval_has_error(error_buf) == 0) {
          let d: u32 = buf_read_byte(buf, i as u32);
          let digit: i64 = (d - (48 as u32)) as i64;
          // n and digit are always >= 0 here, so (i64_max - digit) can
          // never overflow (digit is at most 9) -- same "check before
          // you compute" discipline as eval_apply's i64_*_would_overflow
          // helpers, needed for the identical reason: actually computing
          // n*10+digit before checking it can hang the whole kernel on
          // this target once it truly overflows (see eval_apply's own
          // comment for the full story).
          if n > ((9223372036854775807 - digit) / 10) {
            let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
          } else {
            n = n * 10 + digit;
          }
          i = i + 1;
        }
        if vtop >= 16 {
          let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
        } else {
          let _ = eval_write_value(values, vtop, n);
          vtop = vtop + 1;
          expect_value = 0;
        }
      } else {
        if c == (40 as u32) { // '('
          if otop >= 16 {
            let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
          } else {
            let _ = buf_write_u32(ops, (otop * 4) as u32, 40 as u32);
            otop = otop + 1;
            i = i + 1;
            expect_value = 1;
          }
        } else {
          if c == (41 as u32) { // ')'
            let found_open: i64 = 0;
            while (otop > 0) && (found_open == 0) && (eval_has_error(error_buf) == 0) {
              let top_op: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
              if top_op == (40 as u32) {
                otop = otop - 1;
                found_open = 1;
              } else {
                if vtop < 2 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let b: i64 = eval_read_value(values, vtop - 1);
                  let a: i64 = eval_read_value(values, vtop - 2);
                  vtop = vtop - 2;
                  otop = otop - 1;
                  let r: i64 = eval_apply(top_op as i64, a, b, error_buf);
                  let _ = eval_write_value(values, vtop, r);
                  vtop = vtop + 1;
                }
              }
            }
            if found_open == 0 {
              let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
            } else {
              i = i + 1;
              expect_value = 0;
            }
          } else {
            if (c == (43 as u32)) || (c == (45 as u32)) || (c == (42 as u32)) || (c == (47 as u32)) {
              if (expect_value == 1) && (c == (45 as u32)) {
                // Unary minus: push a 0 operand so "-4" becomes the
                // equivalent binary expression "0 - 4".
                if vtop >= 16 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let _ = eval_write_value(values, vtop, 0);
                  vtop = vtop + 1;
                }
              } else {
                if expect_value == 1 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                }
              }
              if eval_has_error(error_buf) == 0 {
                let op_i: i64 = c as i64;
                while (otop > 0) && (eval_has_error(error_buf) == 0) && (eval_prec(eval_to_i64(buf_read_u32(ops, ((otop - 1) * 4) as u32))) >= eval_prec(op_i)) {
                  let top_op2: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
                  if vtop < 2 {
                    let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                  } else {
                    let b2: i64 = eval_read_value(values, vtop - 1);
                    let a2: i64 = eval_read_value(values, vtop - 2);
                    vtop = vtop - 2;
                    otop = otop - 1;
                    let r2: i64 = eval_apply(top_op2 as i64, a2, b2, error_buf);
                    let _ = eval_write_value(values, vtop, r2);
                    vtop = vtop + 1;
                  }
                }
                if otop >= 16 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let _ = buf_write_u32(ops, (otop * 4) as u32, op_i as u32);
                  otop = otop + 1;
                  i = i + 1;
                  expect_value = 1;
                }
              }
            } else {
              let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
            }
          }
        }
      }
    }
  }

  while (otop > 0) && (eval_has_error(error_buf) == 0) {
    let top_op3: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
    if top_op3 == (40 as u32) {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32); // unbalanced '('
    } else {
      if vtop < 2 {
        let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      } else {
        let b3: i64 = eval_read_value(values, vtop - 1);
        let a3: i64 = eval_read_value(values, vtop - 2);
        vtop = vtop - 2;
        otop = otop - 1;
        let r3: i64 = eval_apply(top_op3 as i64, a3, b3, error_buf);
        let _ = eval_write_value(values, vtop, r3);
        vtop = vtop + 1;
      }
    }
  }

  if (vtop != 1) || (eval_has_error(error_buf) != 0) {
    let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
    return 0;
  }
  return eval_read_value(values, 0);
}

// Boot-time self-test for eval_expr_raw, run from kernel_main() below
// with a fixed set of hand-picked cases -- the same "verify at boot,
// print PASS/FAIL, read the log" discipline every other kernel_main
// self-test in this file already uses, and the ONLY verification
// available for this feature in this sandbox: end-to-end interactive
// testing (typing "eval 2+3" at the shell and reading the reply) is
// blocked by a QEMU/environment issue where stdin never reaches either
// BCM2835 UART's hardware FIFO at all (see task #9's memory writeup) --
// nothing to do with this evaluator's own correctness, which this
// self-test can still fully exercise via a Str literal converted to a
// buffer, the same conversion dharafs_append does for its own path/data
// arguments.
fn eval_self_test(expr: Str, expected: i64, expect_error: i64) -> i64 {
  let expr_len: i64 = str_len_bytes(expr);
  let expr_buf: mut ref i64 = dharafs_data_scratch_get(); // 4096 bytes (round 39), ample for a 128-byte expr; unused by FS during eval
  let i: i64 = 0;
  while i < expr_len {
    let _ = buf_write_byte(expr_buf, i as u32, str_byte_at(expr, i) as u32);
    i = i + 1;
  }
  let error_buf: mut ref i64 = dharafs_path_scratch_get(); // 32 bytes, ample for a 4-byte flag; unused by FS during eval
  let result: i64 = eval_expr_raw(expr_buf, expr_len, error_buf);
  let got_error: u32 = eval_has_error(error_buf);

  let _ = uart_puts("EVAL: \"");
  let _ = uart_puts(expr);
  let _ = uart_puts("\" = ");
  if got_error != (0 as u32) {
    let _ = uart_puts("error");
  } else {
    let _ = uart_put_i64(result);
  }

  let ok: i64 = 0;
  if (expect_error == 1) && (got_error != (0 as u32)) {
    ok = 1;
  }
  if (expect_error == 0) && (got_error == (0 as u32)) && (result == expected) {
    ok = 1;
  }
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expected ");
    if expect_error == 1 {
      let _ = uart_puts("error");
    } else {
      let _ = uart_put_i64(expected);
    }
    let _ = uart_puts(")\n");
  }
  return 0;
}

// Round 60: `fw add|list|flush|default`, factored out of shell_
// dispatch itself (see its own call site's comment for why -- the
// compiler's #[bounded_stack] check on task_f caught this needing to
// be a separate function, not a design choice made up front).
fn shell_dispatch_fw(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  if cmd_end >= line_len {
    let _ = uart_puts("usage: fw <add|list|flush|default> ...\n");
    return 0;
  }
  let sub_start: i64 = cmd_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);

  if shell_word_matches(line_buf, sub_start, sub_end, "flush") == 1 {
    let _ = fw_flush();
    let _ = uart_puts("ok\n");
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "list") == 1 {
    let _ = uart_puts("default policy: ");
    let _ = uart_puts(if fw_get_default_policy() == (1 as u32) { "allow" } else { "deny" });
    let _ = uart_puts("\n");
    let count: u32 = fw_get_rule_count();
    let fi: u32 = 0 as u32;
    while fi < count {
      let r_proto: u32 = fw_get_rule_proto(fi);
      let r_action: u32 = fw_get_rule_action(fi);
      let _ = uart_puts(if r_action == (1 as u32) { "allow " } else { "deny " });
      let _ = uart_puts(if r_proto == (0 as u32) { "any" } else { if r_proto == (1 as u32) { "icmp" } else { if r_proto == (6 as u32) { "tcp" } else { "udp" } } });
      let _ = uart_puts(" src=");
      if fw_get_rule_src_ip_valid(fi) == (1 as u32) {
        let _ = uart_put_ip(fw_get_rule_src_ip(fi));
      } else {
        let _ = uart_puts("any");
      }
      let _ = uart_puts(" dst_port=");
      if fw_get_rule_dst_port_valid(fi) == (1 as u32) {
        let _ = uart_put_i64(fw_get_rule_dst_port(fi) as i64);
      } else {
        let _ = uart_puts("any");
      }
      let _ = uart_puts("\n");
      fi = fi + (1 as u32);
    }
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "default") == 1 {
    if sub_end >= line_len {
      let _ = uart_puts("usage: fw default <allow|deny>\n");
      return 0;
    }
    let pol_start: i64 = sub_end + 1;
    let pol_end: i64 = shell_find_space(line_buf, pol_start, line_len);
    if shell_word_matches(line_buf, pol_start, pol_end, "allow") == 1 {
      let _ = fw_set_default_policy(1 as u32);
      let _ = uart_puts("ok\n");
      return 0;
    }
    if shell_word_matches(line_buf, pol_start, pol_end, "deny") == 1 {
      let _ = fw_set_default_policy(0 as u32);
      let _ = uart_puts("ok\n");
      return 0;
    }
    let _ = uart_puts("usage: fw default <allow|deny>\n");
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "add") == 1 {
    if sub_end >= line_len {
      let _ = uart_puts("usage: fw add <allow|deny> <any|icmp|tcp|udp> <src_ip|any> <dst_port|any>\n");
      return 0;
    }
    let act_start: i64 = sub_end + 1;
    let act_end: i64 = shell_find_space(line_buf, act_start, line_len);
    let action: i64 = if shell_word_matches(line_buf, act_start, act_end, "allow") == 1 {
      1
    } else {
      if shell_word_matches(line_buf, act_start, act_end, "deny") == 1 { 0 } else { 0 - 1 }
    };
    if (action == (0 - 1)) || (act_end >= line_len) {
      let _ = uart_puts("usage: fw add <allow|deny> <any|icmp|tcp|udp> <src_ip|any> <dst_port|any>\n");
      return 0;
    }

    let proto_start: i64 = act_end + 1;
    let proto_end: i64 = shell_find_space(line_buf, proto_start, line_len);
    let proto: i64 = if shell_word_matches(line_buf, proto_start, proto_end, "any") == 1 {
      0
    } else {
      if shell_word_matches(line_buf, proto_start, proto_end, "icmp") == 1 {
        1
      } else {
        if shell_word_matches(line_buf, proto_start, proto_end, "tcp") == 1 {
          6
        } else {
          if shell_word_matches(line_buf, proto_start, proto_end, "udp") == 1 { 17 } else { 0 - 1 }
        }
      }
    };
    if (proto == (0 - 1)) || (proto_end >= line_len) {
      let _ = uart_puts("usage: fw add <allow|deny> <any|icmp|tcp|udp> <src_ip|any> <dst_port|any>\n");
      return 0;
    }

    let ip_start: i64 = proto_end + 1;
    let ip_end: i64 = shell_find_space(line_buf, ip_start, line_len);
    let src_ip: u32 = 0 as u32;
    let src_ip_valid: u32 = 0 as u32;
    if shell_word_matches(line_buf, ip_start, ip_end, "any") == 1 {
      src_ip_valid = 0 as u32;
    } else {
      let parsed_ip: i64 = ip_parse_dotted_quad(line_buf, ip_start, ip_end);
      if parsed_ip < 0 {
        let _ = uart_puts("fw: invalid src IP\n");
        return 0;
      }
      src_ip = parsed_ip as u32;
      src_ip_valid = 1 as u32;
    }
    if ip_end >= line_len {
      let _ = uart_puts("usage: fw add <allow|deny> <any|icmp|tcp|udp> <src_ip|any> <dst_port|any>\n");
      return 0;
    }

    let port_start: i64 = ip_end + 1;
    let port_end: i64 = shell_find_space(line_buf, port_start, line_len);
    let dst_port: u32 = 0 as u32;
    let dst_port_valid: u32 = 0 as u32;
    if shell_word_matches(line_buf, port_start, port_end, "any") == 1 {
      dst_port_valid = 0 as u32;
    } else {
      let parsed_port: i64 = shell_parse_decimal(line_buf, port_start, port_end);
      if parsed_port < 0 {
        let _ = uart_puts("fw: invalid dst port\n");
        return 0;
      }
      dst_port = parsed_port as u32;
      dst_port_valid = 1 as u32;
    }

    let add_status: u32 = fw_add_rule(proto as u32, src_ip, src_ip_valid, dst_port, dst_port_valid, action as u32);
    if add_status == (0 as u32) {
      let _ = uart_puts("ok\n");
    } else {
      let _ = uart_puts("fw: rule table full (max 8)\n");
    }
    return 0;
  }

  let _ = uart_puts("usage: fw <add|list|flush|default> ...\n");
  return 0;
}

// Real authentication: switch the active user/group context (round 42
// behavior), now gated by a real password check whenever the target
// uid has EVER had one set via `passwd` below -- see this function's
// own call site in shell_dispatch for the full design rationale
// (opt-in per-account protection, not a full boot-time login flow).
// Factored into its own function for the same reason
// shell_dispatch_fw was: task_f's own #[bounded_stack] budget is
// shared with a pre-existing, unrelated deep call chain
// (dharafs_rename_raw_checked -> ... -> dwc2_base), and this
// function's own local bindings inlined directly into shell_dispatch
// pushed that chain's worst case over budget.
fn shell_dispatch_su(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  if cmd_end >= line_len {
    let _ = uart_puts("usage: su <uid> <gid> [password]\n");
    return 0;
  }
  let uid_start: i64 = cmd_end + 1;
  let uid_end: i64 = shell_find_space(line_buf, uid_start, line_len);
  if uid_end >= line_len {
    let _ = uart_puts("usage: su <uid> <gid> [password]\n");
    return 0;
  }
  let gid_start: i64 = uid_end + 1;
  let gid_end: i64 = shell_find_space(line_buf, gid_start, line_len);
  let uid: i64 = shell_parse_decimal(line_buf, uid_start, uid_end);
  let gid: i64 = shell_parse_decimal(line_buf, gid_start, gid_end);
  if (uid < 0) || (gid < 0) {
    let _ = uart_puts("usage: su <uid> <gid> [password] (uid/gid non-negative integers)\n");
    return 0;
  }

  let slot: i64 = auth_find_slot(uid as u32);
  if slot >= (0 as i64) {
    let now: u32 = scheduler_get_tick_count();
    let lockout: u32 = auth_get_lockout_until(slot as u32);
    if now < lockout {
      let _ = uart_puts("su: account locked, try again later\n");
      return 0;
    }
    if gid_end >= line_len {
      let _ = uart_puts("su: password required\n");
      return 0;
    }
    let pw_start: i64 = gid_end + 1;
    let pw_end: i64 = shell_find_space(line_buf, pw_start, line_len);
    let pw_len: i64 = pw_end - pw_start;
    if pw_len == 0 {
      let _ = uart_puts("su: password required\n");
      return 0;
    }
    let pw_buf: mut ref i64 = passwd_scratch_ptr();
    let _ = shell_copy_range(line_buf, pw_start, pw_end, pw_buf);

    let salt_ptr: mut ref i64 = auth_salt_ptr(slot as u32);
    let computed: mut ref i64 = su_hash_scratch_ptr();
    // See pbkdf2_auth_iterations's own comment for the real, measured
    // tradeoff behind this iteration count (round 68 -- the bug that
    // used to cap this at 200 is fixed and closed; a priority-ceiling
    // boost tried against the OLD bug measured NOT to reliably fix it,
    // now moot along with the bug itself).
    let _ = pbkdf2_hmac_sha256(pw_buf, pw_len, salt_ptr, 16, pbkdf2_auth_iterations(), computed);
    let stored: mut ref i64 = auth_hash_ptr(slot as u32);
    if hmac_sha256_bytes_equal(computed, stored, 32) == 0 {
      let fails: u32 = auth_get_fail_count(slot as u32) + (1 as u32);
      let _ = auth_set_fail_count(slot as u32, fails);
      if fails >= auth_max_fail_attempts() {
        let _ = auth_set_lockout_until(slot as u32, now + auth_lockout_ticks());
        let _ = uart_puts("su: authentication failed, account locked\n");
      } else {
        let _ = uart_puts("su: authentication failed\n");
      }
      return 0;
    }
    let _ = auth_set_fail_count(slot as u32, 0 as u32);
  }

  let _ = dharafs_user_set(uid as u32, gid as u32);
  let _ = uart_puts("ok\n");
  return 0;
}

// Real authentication: set (or change) a uid's password. Only root
// or the uid itself may do this -- a non-root, non-self caller gets
// a plain permission-denied, matching this shell's existing
// enforcement style elsewhere. The password is the single word
// immediately after uid (no embedded spaces -- a real, accepted MVP
// limitation, not a silent gap: see docs/TODO.md's own note on why
// a full multi-turn "Enter password:" prompt was deliberately not
// built this round). Never stores the password itself -- only a
// fresh random-ish salt (see auth_salt_nonce_next's own comment on
// why this project has no real RNG) and its PBKDF2-HMAC-SHA256
// output. Factored into its own function for the same
// #[bounded_stack] reason as shell_dispatch_su above.
fn shell_dispatch_passwd(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  if cmd_end >= line_len {
    let _ = uart_puts("usage: passwd <uid> <new_password>\n");
    return 0;
  }
  let uid_start: i64 = cmd_end + 1;
  let uid_end: i64 = shell_find_space(line_buf, uid_start, line_len);
  if uid_end >= line_len {
    let _ = uart_puts("usage: passwd <uid> <new_password>\n");
    return 0;
  }
  let uid: i64 = shell_parse_decimal(line_buf, uid_start, uid_end);
  if uid < 0 {
    let _ = uart_puts("usage: passwd <uid> <new_password> (uid a non-negative integer)\n");
    return 0;
  }

  let caller_uid: u32 = dharafs_user_get_uid();
  if (caller_uid != (0 as u32)) && (caller_uid != (uid as u32)) {
    let _ = uart_puts("passwd: permission denied\n");
    return 0;
  }

  let pw_start: i64 = uid_end + 1;
  let pw_end: i64 = shell_find_space(line_buf, pw_start, line_len);
  let pw_len: i64 = pw_end - pw_start;
  if pw_len == 0 {
    let _ = uart_puts("usage: passwd <uid> <new_password>\n");
    return 0;
  }
  if pw_len > 64 {
    let _ = uart_puts("passwd: password too long (max 64 bytes)\n");
    return 0;
  }
  let pw_buf: mut ref i64 = passwd_scratch_ptr();
  let _ = shell_copy_range(line_buf, pw_start, pw_end, pw_buf);

  if auth_is_weak_password(pw_buf, pw_len) == 1 {
    let _ = uart_puts("passwd: password too weak (min 8 characters, not a common password)\n");
    return 0;
  }

  let slot: i64 = auth_find_slot(uid as u32);
  if slot < (0 as i64) {
    slot = auth_find_free_slot();
    if slot < (0 as i64) {
      let _ = uart_puts("passwd: user table full\n");
      return 0;
    }
    let _ = auth_set_uid(slot as u32, uid as u32);
  }

  // Salt only needs to be UNIQUE, not secret -- this project has no
  // real randomness source anywhere (same honest limitation the DHCP
  // client's own xid already documents). auth_salt_nonce_next()
  // guarantees uniqueness across passwd calls even within the same
  // tick; mixing in tick_count and uid gives every slot's salt a
  // genuinely different value even if the nonce counter were ever
  // reset, without claiming this is cryptographically secure
  // randomness -- it explicitly is not.
  let salt_ptr: mut ref i64 = auth_salt_ptr(slot as u32);
  let nonce: u32 = auth_salt_nonce_next();
  let tick: u32 = scheduler_get_tick_count();
  let _ = buf_write_u32_be(salt_ptr, 0, nonce);
  let _ = buf_write_u32_be(salt_ptr, 4, tick);
  let _ = buf_write_u32_be(salt_ptr, 8, uid as u32);
  let _ = buf_write_u32_be(salt_ptr, 12, nonce ^ tick);

  let hash_ptr: mut ref i64 = auth_hash_ptr(slot as u32);
  // See pbkdf2_auth_iterations's own comment for the real, measured
  // tradeoff behind this iteration count.
  let _ = pbkdf2_hmac_sha256(pw_buf, pw_len, salt_ptr, 16, pbkdf2_auth_iterations(), hash_ptr);

  let _ = auth_set_fail_count(slot as u32, 0 as u32);
  let _ = auth_set_lockout_until(slot as u32, 0 as u32);

  let _ = uart_puts("ok\n");
  return 0;
}

// Round 51/62: shell front end for every fault-injection type this
// project has. `fault alloc <n>` (round 51) deliberately triggers the
// SAME real, unrecoverable dhruva_alloc_bytes OOM-fatal halt a genuine
// heap exhaustion would -- there is deliberately no confirmation
// prompt and no way to disarm it once the countdown reaches zero,
// matching round 45's own "no OOM, no surprises" mandate empirically
// under QEMU. `fault write <n>` (round 62) forces the Nth subsequent
// real SD write to fail without touching hardware. `fault irqburst
// <n>` (round 62) jumps tick_count forward by n extra ticks on the
// very next real timer tick -- a "slow ISR catching up" time warp, NOT
// a simulation of n real, distinct preemption events (see
// fault_irqburst_take's own comment for why that's a deliberate scope
// limit). `fault netdrop <n>` (round 62) silently discards the next n
// outgoing network frames while reporting success, exercising
// existing TCP timeout/retransmission logic on demand.
fn shell_dispatch_fault(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  let usage: Str = "usage: fault alloc|write|irqburst|netdrop <n>\n";
  if cmd_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let sub_start: i64 = cmd_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);
  if sub_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let n_start: i64 = sub_end + 1;
  let n_end: i64 = shell_find_space(line_buf, n_start, line_len);
  let n: i64 = shell_parse_decimal(line_buf, n_start, n_end);
  if n <= 0 {
    let _ = uart_puts("usage: n must be a positive integer\n");
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "alloc") == 1 {
    let _ = dhruva_fault_inject_alloc_arm(n);
    let _ = uart_puts("armed: will halt with a FATAL diagnostic after ");
    let _ = uart_put_i64(n);
    let _ = uart_puts(" more allocation(s).\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "write") == 1 {
    let _ = fault_write_countdown_set(n as u32);
    let _ = uart_puts("armed: the ");
    let _ = uart_put_i64(n);
    let _ = uart_puts("th subsequent SD write will fail.\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "irqburst") == 1 {
    let _ = fault_irqburst_countdown_set(n as u32);
    let _ = uart_puts("armed: the next timer tick will jump the clock forward by ");
    let _ = uart_put_i64(n);
    let _ = uart_puts(" extra tick(s).\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "netdrop") == 1 {
    let _ = fault_netdrop_countdown_set(n as u32);
    let _ = uart_puts("armed: the ");
    let _ = uart_put_i64(n);
    let _ = uart_puts("th subsequent outgoing network frame will be silently dropped.\n");
    return 0;
  }
  let _ = uart_puts(usage);
  return 0;
}

// Round 69: runtime toggle for DharaFS media (at-rest) encryption,
// wired straight to dharafs_crypto_get_enabled/set_enabled -- the
// same pair the self-check above already flips internally, now
// exposed to a real user. `on`/`off` take effect immediately for
// every subsequent dharafs_block_read/write (no reboot, no re-mount
// step needed, since encryption lives entirely in that one choke
// point). Turning this on mid-session does NOT retroactively encrypt
// blocks already on disk -- they keep their existing write-counter
// (0 if never protected) and are read back as plaintext until next
// written, exactly the same graceful legacy-passthrough behavior
// documented above dharafs_crypto_decrypt_block.
fn shell_dispatch_crypto(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  let usage: Str = "usage: crypto on|off|status\n";
  if cmd_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let sub_start: i64 = cmd_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);

  if shell_word_matches(line_buf, sub_start, sub_end, "on") == 1 {
    let _ = dharafs_crypto_set_enabled(1 as u32);
    let _ = uart_puts("DharaFS media encryption: ON (AEAD, tamper-detected)\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "off") == 1 {
    let _ = dharafs_crypto_set_enabled(0 as u32);
    let _ = uart_puts("DharaFS media encryption: OFF\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "status") == 1 {
    if dharafs_crypto_get_enabled() == (1 as u32) {
      let _ = uart_puts("DharaFS media encryption: ON (AEAD, tamper-detected)\n");
    } else {
      let _ = uart_puts("DharaFS media encryption: OFF\n");
    }
    return 0;
  }
  let _ = uart_puts(usage);
  return 0;
}

// Round 71: shell front end for general-purpose GPIO (see the driver
// functions and their own header comment above `gpio_self_check`).
// `<pin>` is a plain decimal 0-53 (the SoC's full real register
// width) -- no validation against what a specific board's header
// actually exposes, same "the peripheral register doesn't care"
// posture the driver functions themselves take.
fn shell_dispatch_gpio(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  let usage: Str = "usage: gpio <pin> in|out|read|write <0|1>|pull none|up|down\n";
  if cmd_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let pin_start: i64 = cmd_end + 1;
  let pin_end: i64 = shell_find_space(line_buf, pin_start, line_len);
  let pin: i64 = shell_parse_decimal(line_buf, pin_start, pin_end);
  if (pin < 0) || (pin > 53) || (pin_end >= line_len) {
    let _ = uart_puts(usage);
    return 0;
  }

  let sub_start: i64 = pin_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);

  if shell_word_matches(line_buf, sub_start, sub_end, "in") == 1 {
    let _ = gpio_set_function(pin, 0 as u32);
    let _ = uart_puts("ok\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "out") == 1 {
    let _ = gpio_set_function(pin, 1 as u32);
    let _ = uart_puts("ok\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "read") == 1 {
    let level: u32 = gpio_read(pin);
    let _ = uart_puts("gpio ");
    let _ = uart_put_i64(pin);
    let _ = uart_puts(" = ");
    let _ = uart_put_i64(level as i64);
    let _ = uart_puts("\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "write") == 1 {
    if sub_end >= line_len {
      let _ = uart_puts(usage);
      return 0;
    }
    let val_start: i64 = sub_end + 1;
    let val_end: i64 = shell_find_space(line_buf, val_start, line_len);
    let val: i64 = shell_parse_decimal(line_buf, val_start, val_end);
    let _ = gpio_write(pin, if val != 0 { 1 as u32 } else { 0 as u32 });
    let _ = uart_puts("ok\n");
    return 0;
  }
  if shell_word_matches(line_buf, sub_start, sub_end, "pull") == 1 {
    if sub_end >= line_len {
      let _ = uart_puts(usage);
      return 0;
    }
    let pull_start: i64 = sub_end + 1;
    let pull_end: i64 = shell_find_space(line_buf, pull_start, line_len);
    let pull: u32 = if shell_word_matches(line_buf, pull_start, pull_end, "up") == 1 {
      2 as u32
    } else {
      if shell_word_matches(line_buf, pull_start, pull_end, "down") == 1 { 1 as u32 } else { 0 as u32 }
    };
    let _ = gpio_set_pull(pin, pull);
    let _ = uart_puts("ok (not verifiable under QEMU -- see docs/TODO.md)\n");
    return 0;
  }
  let _ = uart_puts(usage);
  return 0;
}

// Round 71: shell front end for the HDMI framebuffer (see fb_init's
// own header comment above for the mailbox protocol/verification
// scope). `fill` takes plain decimal R/G/B (0-255 each), not a hex
// color code -- reuses shell_parse_decimal directly rather than
// adding a new hex-string parser this shell doesn't otherwise need.
fn shell_dispatch_fb(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  let usage: Str = "usage: fb init <w> <h> <bpp>|status|fill <x> <y> <r> <g> <b>\n";
  if cmd_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let sub_start: i64 = cmd_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);

  if shell_word_matches(line_buf, sub_start, sub_end, "status") == 1 {
    let _ = uart_puts("fb: base=0x");
    let _ = uart_put_hex32(fb_base_get() as u32);
    let _ = uart_puts(" size=0x");
    let _ = uart_put_hex32(fb_size_get() as u32);
    let _ = uart_puts(" pitch=0x");
    let _ = uart_put_hex32(fb_pitch_get() as u32);
    let _ = uart_puts("\n");
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "init") == 1 {
    if sub_end >= line_len {
      let _ = uart_puts(usage);
      return 0;
    }
    let w_start: i64 = sub_end + 1;
    let w_end: i64 = shell_find_space(line_buf, w_start, line_len);
    let h_start: i64 = w_end + 1;
    let h_end: i64 = shell_find_space(line_buf, h_start, line_len);
    let bpp_start: i64 = h_end + 1;
    let bpp_end: i64 = shell_find_space(line_buf, bpp_start, line_len);
    if (w_end >= line_len) || (h_end >= line_len) {
      let _ = uart_puts(usage);
      return 0;
    }
    let w: i64 = shell_parse_decimal(line_buf, w_start, w_end);
    let h: i64 = shell_parse_decimal(line_buf, h_start, h_end);
    let bpp: i64 = shell_parse_decimal(line_buf, bpp_start, bpp_end);
    let status: i64 = fb_init(w, h, if bpp > 0 { bpp } else { 32 });
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      let _ = uart_puts("error\n");
    }
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "fill") == 1 {
    let x_start: i64 = sub_end + 1;
    let x_end: i64 = shell_find_space(line_buf, x_start, line_len);
    let y_start: i64 = x_end + 1;
    let y_end: i64 = shell_find_space(line_buf, y_start, line_len);
    let r_start: i64 = y_end + 1;
    let r_end: i64 = shell_find_space(line_buf, r_start, line_len);
    let g_start: i64 = r_end + 1;
    let g_end: i64 = shell_find_space(line_buf, g_start, line_len);
    let b_start: i64 = g_end + 1;
    let b_end: i64 = shell_find_space(line_buf, b_start, line_len);
    if (x_end >= line_len) || (y_end >= line_len) || (r_end >= line_len) || (g_end >= line_len) {
      let _ = uart_puts(usage);
      return 0;
    }
    let x: i64 = shell_parse_decimal(line_buf, x_start, x_end);
    let y: i64 = shell_parse_decimal(line_buf, y_start, y_end);
    let r: u32 = (shell_parse_decimal(line_buf, r_start, r_end) & 255) as u32;
    let g: u32 = (shell_parse_decimal(line_buf, g_start, g_end) & 255) as u32;
    let b: u32 = (shell_parse_decimal(line_buf, b_start, b_end) & 255) as u32;
    // pixo=1 (RGB, set by fb_init) means byte0=R,byte1=G,byte2=B in
    // memory -- a native little-endian 32-bit word write therefore
    // packs them as r | (g<<8) | (b<<16).
    let color: u32 = r | (g << (8 as u32)) | (b << (16 as u32));
    let _ = fb_fill_pixel(x, y, color);
    let _ = uart_puts("ok\n");
    return 0;
  }
  let _ = uart_puts(usage);
  return 0;
}

// Round 71: shell front end for USB HID (keyboard/mouse) -- one
// bounded interrupt-IN poll per `hid poll` invocation (a handful of
// tries, same "never hang on hardware/a device that just isn't
// talking" bound this project's other interrupt-poll call sites
// already use, e.g. hci_send_command_and_wait_complete's own 20-try
// loop), decoding and printing whatever boot-protocol report comes
// back based on usb_hid_get_kind(). No continuous background polling
// task -- an on-demand shell command is lower-risk (nothing new
// touching the scheduler) and matches this project's own existing
// precedent for interrupt-transfer polling (BT's own HCI event
// polling is also only ever invoked synchronously from within a
// specific command flow, never from a periodic background task).
fn shell_dispatch_hid(line_buf: mut ref i64, cmd_end: i64, line_len: i64) -> i64 {
  let usage: Str = "usage: hid poll|status\n";
  if cmd_end >= line_len {
    let _ = uart_puts(usage);
    return 0;
  }
  let sub_start: i64 = cmd_end + 1;
  let sub_end: i64 = shell_find_space(line_buf, sub_start, line_len);

  if shell_word_matches(line_buf, sub_start, sub_end, "status") == 1 {
    let kind: u32 = usb_hid_get_kind();
    if kind == (0 as u32) {
      let _ = uart_puts("hid: no device detected\n");
    } else {
      let _ = uart_puts("hid: ");
      if kind == (1 as u32) {
        let _ = uart_puts("keyboard");
      } else {
        let _ = uart_puts("mouse");
      }
      let _ = uart_puts(" (boot protocol), intr_in_ep=");
      let _ = uart_put_hex32(usb_hid_get_intr_in_epaddr());
      let _ = uart_puts(" mps=");
      let _ = uart_put_hex32(usb_hid_get_intr_in_mps());
      let _ = uart_puts("\n");
    }
    return 0;
  }

  if shell_word_matches(line_buf, sub_start, sub_end, "poll") == 1 {
    let kind: u32 = usb_hid_get_kind();
    if kind == (0 as u32) {
      let _ = uart_puts("hid: no device detected\n");
      return 0;
    }
    let mps: u32 = usb_hid_get_intr_in_mps();
    let report: mut ref i64 = dhruva_alloc_bytes(8);
    let tries: i64 = 0;
    let got_len: i64 = 0 - 1;
    while (tries < 20) && (got_len < 0) {
      got_len = dwc2_hid_interrupt_in(dwc2_downstream_addr(), mps, report, mps as i64);
      tries = tries + 1;
    }
    if got_len < 0 {
      let _ = uart_puts("hid: no report received (timed out)\n");
      return 0;
    }
    if kind == (1 as u32) {
      let _ = uart_puts("hid keyboard: modifiers=0x");
      let _ = uart_put_hex_byte(hid_kbd_report_get_modifiers(report));
      let _ = uart_puts(" keys=");
      let s: i64 = 0;
      while s < 6 {
        let kc: u32 = hid_kbd_report_get_keycode(report, s as u32);
        if kc != (0 as u32) {
          let _ = uart_put_hex_byte(kc);
          let _ = uart_puts(" ");
        }
        s = s + 1;
      }
      let _ = uart_puts("\n");
    } else {
      let _ = uart_puts("hid mouse: buttons=0x");
      let _ = uart_put_hex_byte(hid_mouse_report_get_buttons(report));
      let _ = uart_puts(" dx=");
      let _ = uart_put_i64(hid_mouse_report_get_dx(report));
      let _ = uart_puts(" dy=");
      let _ = uart_put_i64(hid_mouse_report_get_dy(report));
      let _ = uart_puts("\n");
    }
    return 0;
  }
  let _ = uart_puts(usage);
  return 0;
}

// Parses and runs exactly one already-complete shell line. Deliberately
// NOT #[no_heap] (same reasoning as task_e's GC pass above): every
// scratch buffer here is a fresh dhruva_alloc_bytes, and this task can
// never preempt or block anything on the hard-RT path, so the
// restriction that protects that path doesn't need to apply here too.
fn shell_dispatch() -> i64 {
  let line_len: i64 = shell_get_line_len() as i64;
  if line_len == 0 {
    return 0;
  }
  let line_buf: mut ref i64 = shell_line_scratch_get();
  let i: i64 = 0;
  while i < line_len {
    let c: u32 = shell_get_line_byte(i as u32);
    let _ = buf_write_byte(line_buf, i as u32, c);
    i = i + 1;
  }

  let cmd_end: i64 = shell_find_space(line_buf, 0, line_len);

  if shell_word_matches(line_buf, 0, cmd_end, "ls") == 1 {
    // Round 42: bare "ls" keeps its original flat, every-live-record
    // behavior unchanged (phase4_milestone.py's own "ls shows
    // /milestone/note" check depends on that exact full-path output).
    // "ls <dir>" is new -- real single-level directory listing via
    // dharafs_list_dir, distinguishing files from subdirectories instead
    // of printing every full path flatly.
    if cmd_end >= line_len {
      let _ = dharafs_list("");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    if path_len == 0 {
      let _ = dharafs_list("");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    // dharafs_list_dir_raw (not the Str-based dharafs_list_dir) directly -- same
    // raw-buffer boundary reasoning as cat/write/rm above: the shell
    // only ever has a path as bytes copied out of its line buffer,
    // with no Str form to build from arbitrary bytes.
    let dir_buf: mut ref i64 = dharafs_dir_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, dir_buf);
    let dummy: mut ref i64 = dharafs_stat_scratch_get();
    let _ = dharafs_list_dir_raw(dir_buf, path_len, dummy, 0);
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "cat") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: cat <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    // BUG (round 12 audit, 2026-08-27): a double space right after the
    // command name (e.g. "cat  /foo") used to parse as a legitimate,
    // silently EMPTY path (path_start landed exactly on the second
    // space, so shell_find_space returned immediately) rather than
    // failing the same way a genuinely missing argument already does
    // above -- the intended path was silently swallowed instead of
    // ever being looked at. Harmless for `cat` specifically (an empty
    // path just reports "(not found)"), but the identical parsing gap
    // in `rm`/`write` right below is worse: it silently succeeds
    // ("ok") while writing a real, permanently-wasted record keyed to
    // an empty path, misleading the user into thinking their actual
    // command ran. Fixed uniformly across all three path-taking
    // commands with the same "usage" rejection an outright-missing
    // argument already gets.
    if path_len == 0 {
      let _ = uart_puts("usage: cat <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let out_buf: mut ref i64 = dharafs_data_scratch_get();
    // Round 42: permission-checked, as the current shell user
    // (dharafs_user_get_uid/gid) -- not the raw, unchecked primitive.
    let data_len: i64 = dharafs_read_raw_checked(path_buf, path_len, out_buf, dharafs_user_get_uid(), dharafs_user_get_gid());
    if data_len == (0 - 2) {
      let _ = uart_puts("permission denied\n");
    } else {
      if data_len < 0 {
        let _ = uart_puts("(not found)\n");
      } else {
        let _ = dharafs_print_data(out_buf, data_len);
        let _ = uart_puts("\n");
      }
    }
    return 0;
  }

  // Round 48: same as `cat` above, but also verifies a companion
  // SHA-256 digest at <path>.sha256 if `writev` ever wrote one for
  // this path (see dharafs_read_verified_checked's own comment --
  // verification is opt-in per path, not mandatory for every read).
  if shell_word_matches(line_buf, 0, cmd_end, "catv") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: catv <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    if path_len == 0 {
      let _ = uart_puts("usage: catv <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let out_buf: mut ref i64 = dharafs_data_scratch_get();
    let data_len: i64 = dharafs_read_verified_checked(path_buf, path_len, out_buf, dharafs_user_get_uid(), dharafs_user_get_gid());
    if data_len == (0 - 2) {
      let _ = uart_puts("permission denied\n");
    } else {
      if data_len == (0 - 3) {
        let _ = uart_puts("INTEGRITY FAILURE: data does not match stored digest\n");
      } else {
        if data_len < 0 {
          let _ = uart_puts("(not found)\n");
        } else {
          let _ = dharafs_print_data(out_buf, data_len);
          let _ = uart_puts("\n");
        }
      }
    }
    return 0;
  }

  // Round 67: PKI raw public-key trust -- checks <path> against a
  // companion <path>.sig using the compile-time-pinned Ed25519 key
  // (pki_init/boot/pki_state.S), not a per-file digest the writer
  // controls (catv's own SHA-256 model above) -- the signature can
  // only have been produced by whoever holds the matching PRIVATE
  // key, which this shell has no access to and no way to create.
  if shell_word_matches(line_buf, 0, cmd_end, "verify") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: verify <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    if path_len == 0 {
      let _ = uart_puts("usage: verify <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let result: i64 = pki_verify_file_raw(path_buf, path_len);
    if result == 1 {
      let _ = uart_puts("VALID: signature verifies against the pinned key\n");
    } else {
      if result == 0 {
        let _ = uart_puts("INVALID: signature does not verify\n");
      } else {
        let _ = uart_puts("error: file or companion .sig not found\n");
      }
    }
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "rm") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: rm <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    // See cat's own identical fix above for why this check exists --
    // here specifically, a double-space typo used to silently write a
    // real, wasted tombstone record keyed to an empty path while still
    // reporting "ok", as if the user's actual `rm` had succeeded.
    if path_len == 0 {
      let _ = uart_puts("usage: rm <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let status: i64 = dharafs_delete_raw_checked(path_buf, path_len, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 4) {
          let _ = uart_puts("error: blocked (immutable or append-only)\n");
        } else {
          let _ = uart_puts("error\n");
        }
      }
    }
    return 0;
  }

  // Round 47: DharaFS's first rename -- see dharafs_rename_raw_checked's
  // own comment for the permission model (write permission on the old
  // path, AND on the new path too if it already exists).
  if shell_word_matches(line_buf, 0, cmd_end, "mv") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: mv <old-path> <new-path>\n");
      return 0;
    }
    let old_start: i64 = cmd_end + 1;
    let old_end: i64 = shell_find_space(line_buf, old_start, line_len);
    if old_end >= line_len {
      let _ = uart_puts("usage: mv <old-path> <new-path>\n");
      return 0;
    }
    let old_len: i64 = old_end - old_start;
    if old_len == 0 {
      let _ = uart_puts("usage: mv <old-path> <new-path>\n");
      return 0;
    }
    if old_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let new_start: i64 = old_end + 1;
    let new_end: i64 = shell_find_space(line_buf, new_start, line_len);
    let new_len: i64 = new_end - new_start;
    if new_len == 0 {
      let _ = uart_puts("usage: mv <old-path> <new-path>\n");
      return 0;
    }
    if new_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let old_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, old_start, old_end, old_buf);
    // Two paths need to be live at once here -- old_buf already claims
    // the one shared dharafs_path_scratch slot cat/rm/write also use,
    // so new_buf gets its own dedicated PERSISTENT scratch buffer
    // (dharafs_rename_new_path_scratch), same reasoning as dharafs_
    // rename's own comment. BUG FIX: this used to be a fresh dhruva_
    // alloc_bytes(32) here, leaking 32 bytes on every single `mv`.
    let new_buf: mut ref i64 = dharafs_rename_new_path_scratch_get();
    let _ = shell_copy_range(line_buf, new_start, new_end, new_buf);
    let status: i64 = dharafs_rename_raw_checked(old_buf, old_len, new_buf, new_len, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 4) {
          let _ = uart_puts("error: blocked (immutable source, or destination is immutable/append-only)\n");
        } else {
          let _ = uart_puts("error\n");
        }
      }
    }
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "write") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    // See cat's own identical fix above for why this check exists --
    // here specifically, a double-space typo right after "write" used
    // to silently write real, permanent data keyed to an empty path
    // while still reporting "ok", as if it had gone to the path the
    // user actually typed. (path_end >= line_len above already rejects
    // a double space right before the text, e.g. "write /path  " with
    // no text following, but not this earlier one.)
    if path_len == 0 {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let text_start: i64 = path_end + 1;
    let text_len: i64 = line_len - text_start;
    // Round 39: matches dharafs_file_max_len(), though in practice the
    // shell's own 128-byte line buffer (shell_line_scratch) already
    // makes this unreachable -- kept accurate to the real FS-layer cap
    // regardless, rather than left stale at the old 464-byte number.
    if text_len > (dharafs_file_max_len() as i64) {
      let _ = uart_puts("error: text too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let data_buf: mut ref i64 = dharafs_data_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, data_buf);
    let status: i64 = dharafs_write_raw_checked(path_buf, path_len, data_buf, text_len, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 4) {
          let _ = uart_puts("error: blocked (immutable, or not a valid append-only extension)\n");
        } else {
          let _ = uart_puts("error\n");
        }
      }
    }
    return 0;
  }

  // Round 48: same parsing/limits as `write` above, but also stores a
  // SHA-256 digest at <path>.sha256 (dharafs_write_verified_raw) --
  // see that function's own comment for why this is a companion
  // record rather than a change to the on-disk block format.
  if shell_word_matches(line_buf, 0, cmd_end, "writev") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: writev <path> <text>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: writev <path> <text>\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    if path_len == 0 {
      let _ = uart_puts("usage: writev <path> <text>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let text_start: i64 = path_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (dharafs_file_max_len() as i64) {
      let _ = uart_puts("error: text too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let data_buf: mut ref i64 = dharafs_data_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, data_buf);
    let status: i64 = dharafs_write_verified_checked(path_buf, path_len, data_buf, text_len, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 1) {
          let _ = uart_puts("error: path too long for a companion digest (max 25 bytes)\n");
        } else {
          if status == (0 - 4) {
            let _ = uart_puts("error: blocked (immutable, or not a valid append-only extension)\n");
          } else {
            let _ = uart_puts("error\n");
          }
        }
      }
    }
    return 0;
  }

  // Round 49: append-only log convenience API -- see dharafs_log_
  // append_raw's own comment for the on-disk layout (numbered /logs/
  // <name>-NNNN.log files + a small /logs/<name>.hdr header).
  if shell_word_matches(line_buf, 0, cmd_end, "log") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: log <name> <text>\n");
      return 0;
    }
    let name_start: i64 = cmd_end + 1;
    let name_end: i64 = shell_find_space(line_buf, name_start, line_len);
    if name_end >= line_len {
      let _ = uart_puts("usage: log <name> <text>\n");
      return 0;
    }
    let name_len: i64 = name_end - name_start;
    if name_len == 0 {
      let _ = uart_puts("usage: log <name> <text>\n");
      return 0;
    }
    let text_start: i64 = name_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > dharafs_log_record_max_len() {
      let _ = uart_puts("error: record too long (max 512 bytes)\n");
      return 0;
    }
    let name_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, name_start, name_end, name_buf);
    let record_buf: mut ref i64 = dharafs_data_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, record_buf);
    let status: i64 = dharafs_log_append_raw(name_buf, name_len, record_buf, text_len, dharafs_user_get_uid(), dharafs_user_get_gid(), dharafs_default_mode());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 1) {
        let _ = uart_puts("error: log name too long\n");
      } else {
        let _ = uart_puts("error\n");
      }
    }
    return 0;
  }

  // Round 42: show the active permission-check context. Dhruva has no
  // login yet, so this is always uid 0 (root) unless a session used
  // `su` (below) to switch it.
  if shell_word_matches(line_buf, 0, cmd_end, "id") == 1 {
    let _ = uart_puts("uid=");
    let _ = uart_put_i64(dharafs_user_get_uid() as i64);
    let _ = uart_puts(" gid=");
    let _ = uart_put_i64(dharafs_user_get_gid() as i64);
    let _ = uart_puts("\n");
    return 0;
  }

  // Round 42: switch the active user/group context, so cat/write/rm's
  // permission checks (and dharafs_append's owner-on-create default) run
  // as someone other than root -- the only way to exercise real
  // enforcement from the live shell rather than just self-tests,
  // since there's no login flow to arrive as a non-root user through.
  //
  // Real authentication (added same round as passwd below): if the
  // target uid has EVER had a password set via `passwd`, su now
  // genuinely requires it -- checked against the stored PBKDF2-
  // HMAC-SHA256 hash, with 3-strike per-account rate limiting. A uid
  // that has NEVER had a password configured keeps today's original
  // unconditional behavior unchanged -- an explicit, honest "opt-in
  // protection per-account" design (see docs/TODO.md's own fork #1:
  // gating su only, not a full boot-time login flow), not a silent
  // behavior change that would break every self-test/script relying
  // on su working with zero setup.
  if shell_word_matches(line_buf, 0, cmd_end, "su") == 1 {
    return shell_dispatch_su(line_buf, cmd_end, line_len);
  }

  // Real authentication: set (or change) a uid's password.
  if shell_word_matches(line_buf, 0, cmd_end, "passwd") == 1 {
    return shell_dispatch_passwd(line_buf, cmd_end, line_len);
  }

  // Round 42: change an existing file's permission bits. Mode is a
  // plain decimal number matching the standard octal bit layout (e.g.
  // 420 = 0o644 = rw-r--r--) -- see dharafs_check_permission's own comment
  // for the exact bit assignment. Requires the file to already exist;
  // ownership is unaffected (see dharafs_chmod's own doc comment).
  if shell_word_matches(line_buf, 0, cmd_end, "chmod") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    if (path_len == 0) || (path_len > 32) {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let mode_start: i64 = path_end + 1;
    let mode_end: i64 = shell_find_space(line_buf, mode_start, line_len);
    let mode: i64 = shell_parse_decimal(line_buf, mode_start, mode_end);
    if mode < 0 {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    // BUG FIX: this used to reimplement dharafs_chmod's own "stat,
    // read, re-append" shape directly against path_buf with NO
    // permission check at all -- any uid could chmod any file. Now
    // goes through dharafs_chmod_checked (owner-or-root), the real
    // enforcement boundary, same as cat/rm/write/mv already do for
    // their own operations.
    let status: i64 = dharafs_chmod_checked(path_buf, path_len, mode as u32, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 1) {
          let _ = uart_puts("(not found)\n");
        } else {
          let _ = uart_puts("error\n");
        }
      }
    }
    return 0;
  }

  // BUG FIX: dharafs_chown existed but had no shell command and no
  // permission check -- see dharafs_chown_checked's own comment (ROOT
  // ONLY, no owner exemption, matching real strict POSIX chown()).
  if shell_word_matches(line_buf, 0, cmd_end, "chown") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: chown <path> <uid> <gid>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: chown <path> <uid> <gid>\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    if (path_len == 0) || (path_len > 32) {
      let _ = uart_puts("usage: chown <path> <uid> <gid>\n");
      return 0;
    }
    let uid_start: i64 = path_end + 1;
    let uid_end: i64 = shell_find_space(line_buf, uid_start, line_len);
    if uid_end >= line_len {
      let _ = uart_puts("usage: chown <path> <uid> <gid>\n");
      return 0;
    }
    let gid_start: i64 = uid_end + 1;
    let gid_end: i64 = shell_find_space(line_buf, gid_start, line_len);
    let new_uid: i64 = shell_parse_decimal(line_buf, uid_start, uid_end);
    let new_gid: i64 = shell_parse_decimal(line_buf, gid_start, gid_end);
    if (new_uid < 0) || (new_gid < 0) {
      let _ = uart_puts("usage: chown <path> <uid> <gid> (both non-negative integers)\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let status: i64 = dharafs_chown_checked(path_buf, path_len, new_uid as u32, new_gid as u32, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        if status == (0 - 1) {
          let _ = uart_puts("(not found)\n");
        } else {
          let _ = uart_puts("error\n");
        }
      }
    }
    return 0;
  }

  // Round 50: `attr <path>` alone queries the current immutable/
  // append/system flags; `attr <path> <flag> <on|off>` changes one.
  // See dharafs_set_attr_raw's own comment for the permission model
  // (owner-or-root, and a non-root owner can't clear immutable/append
  // once set).
  if shell_word_matches(line_buf, 0, cmd_end, "attr") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: attr <path> [<immutable|append|system> <on|off>]\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    if (path_len == 0) || (path_len > 32) {
      let _ = uart_puts("usage: attr <path> [<immutable|append|system> <on|off>]\n");
      return 0;
    }
    let path_buf: mut ref i64 = dharafs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);

    if path_end >= line_len {
      let current: i64 = dharafs_get_attr_raw(path_buf, path_len);
      if current < 0 {
        let _ = uart_puts("(not found)\n");
        return 0;
      }
      let cur_u: u32 = current as u32;
      let _ = uart_puts("immutable=");
      let _ = uart_puts(if (cur_u & dharafs_attr_immutable()) != (0 as u32) { "on" } else { "off" });
      let _ = uart_puts(" append=");
      let _ = uart_puts(if (cur_u & dharafs_attr_append_only()) != (0 as u32) { "on" } else { "off" });
      let _ = uart_puts(" system=");
      let _ = uart_puts(if (cur_u & dharafs_attr_system()) != (0 as u32) { "on" } else { "off" });
      let _ = uart_puts("\n");
      return 0;
    }

    let flag_start: i64 = path_end + 1;
    let flag_end: i64 = shell_find_space(line_buf, flag_start, line_len);
    if flag_end >= line_len {
      let _ = uart_puts("usage: attr <path> [<immutable|append|system> <on|off>]\n");
      return 0;
    }
    let flag_bit: u32 = if shell_word_matches(line_buf, flag_start, flag_end, "immutable") == 1 {
      dharafs_attr_immutable()
    } else {
      if shell_word_matches(line_buf, flag_start, flag_end, "append") == 1 {
        dharafs_attr_append_only()
      } else {
        if shell_word_matches(line_buf, flag_start, flag_end, "system") == 1 {
          dharafs_attr_system()
        } else {
          0 as u32
        }
      }
    };
    if flag_bit == (0 as u32) {
      let _ = uart_puts("usage: attr <path> [<immutable|append|system> <on|off>]\n");
      return 0;
    }
    let onoff_start: i64 = flag_end + 1;
    let onoff_end: i64 = shell_find_space(line_buf, onoff_start, line_len);
    let turning_on: i64 = if shell_word_matches(line_buf, onoff_start, onoff_end, "on") == 1 {
      1
    } else {
      if shell_word_matches(line_buf, onoff_start, onoff_end, "off") == 1 { 0 } else { 0 - 1 }
    };
    if turning_on == (0 - 1) {
      let _ = uart_puts("usage: attr <path> [<immutable|append|system> <on|off>]\n");
      return 0;
    }
    let current2: i64 = dharafs_get_attr_raw(path_buf, path_len);
    if current2 < 0 {
      let _ = uart_puts("(not found)\n");
      return 0;
    }
    let not_flag_bit: u32 = flag_bit ^ (0xFFFFFFFF as u32);
    let new_attr: u32 = if turning_on == 1 { (current2 as u32) | flag_bit } else { (current2 as u32) & not_flag_bit };
    let status2: i64 = dharafs_set_attr_raw(path_buf, path_len, new_attr, dharafs_user_get_uid(), dharafs_user_get_gid());
    if status2 == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status2 == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        let _ = uart_puts("error\n");
      }
    }
    return 0;
  }

  // Round 60: packet filtering shell command family. Factored into its
  // own function (not inlined here like `attr` above) specifically
  // because inlining it pushed task_f's own #[bounded_stack] analysis
  // over budget -- the compiler's own static worst-case-stack-depth
  // check caught this at build time, not a runtime surprise. A
  // separate function keeps this block's own locals out of shell_
  // dispatch's frame entirely.
  if shell_word_matches(line_buf, 0, cmd_end, "fw") == 1 {
    return shell_dispatch_fw(line_buf, cmd_end, line_len);
  }

  if shell_word_matches(line_buf, 0, cmd_end, "crypto") == 1 {
    return shell_dispatch_crypto(line_buf, cmd_end, line_len);
  }

  if shell_word_matches(line_buf, 0, cmd_end, "gpio") == 1 {
    return shell_dispatch_gpio(line_buf, cmd_end, line_len);
  }

  if shell_word_matches(line_buf, 0, cmd_end, "fb") == 1 {
    return shell_dispatch_fb(line_buf, cmd_end, line_len);
  }

  if shell_word_matches(line_buf, 0, cmd_end, "hid") == 1 {
    return shell_dispatch_hid(line_buf, cmd_end, line_len);
  }

  if shell_word_matches(line_buf, 0, cmd_end, "eval") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: eval <expr>\n");
      return 0;
    }
    let expr_start: i64 = cmd_end + 1;
    let expr_len: i64 = line_len - expr_start;
    let expr_buf: mut ref i64 = dharafs_data_scratch_get();
    let _ = shell_copy_range(line_buf, expr_start, line_len, expr_buf);
    let error_buf: mut ref i64 = dharafs_path_scratch_get();
    let result: i64 = eval_expr_raw(expr_buf, expr_len, error_buf);
    if eval_has_error(error_buf) != (0 as u32) {
      let _ = uart_puts("error\n");
    } else {
      let _ = uart_put_i64(result);
      let _ = uart_puts("\n");
    }
    return 0;
  }

  // Round 26: a real, interactively-typeable "ping" command -- the
  // first live caller of round 22's own arp_resolve_start/poll (built
  // that round, self-tested on its own merits, but never wired into
  // anything that actually used it) and round 25's icmp_ping_start/
  // poll. src_ip is whatever DHCP has actually leased (0.0.0.0/
  // "unset" if nothing has bound yet, same as any real host with no
  // configured address) rather than a fixed constant.
  if shell_word_matches(line_buf, 0, cmd_end, "ping") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: ping <a.b.c.d>\n");
      return 0;
    }
    let ip_start: i64 = cmd_end + 1;
    let ip_end: i64 = shell_find_space(line_buf, ip_start, line_len);
    let ip_len: i64 = ip_end - ip_start;
    // Same double-space-typo rejection round 12 already established
    // uniformly for cat/rm/write -- a missing argument and an empty
    // one right after the command name must both be caught the same
    // way, not just the former.
    if ip_len == 0 {
      let _ = uart_puts("usage: ping <a.b.c.d>\n");
      return 0;
    }
    let dst_ip_parsed: i64 = ip_parse_dotted_quad(line_buf, ip_start, ip_end);
    if dst_ip_parsed < 0 {
      let _ = uart_puts("ping: invalid IP address\n");
      return 0;
    }
    let dst_ip: u32 = dst_ip_parsed as u32;
    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let my_ip: u32 = dhcp_state_get_leased_ip();

    let dst_mac: mut ref i64 = shell_ping_dst_mac_scratch_get();
    let resolved: i64 = 0;
    if dst_ip == my_ip {
      // Pinging yourself never needs real ARP resolution -- same
      // loopback shortcut every self-test in this project's own
      // networking layer already uses, and (under QEMU specifically)
      // the ONLY case that can ever actually succeed, since there is
      // no real second host on this project's only tested link to
      // answer an ARP request for anything else.
      let mi: i64 = 0;
      while mi < 6 {
        let mb: u32 = buf_read_byte(my_mac, mi as u32);
        let _ = buf_write_byte(dst_mac, mi as u32, mb);
        mi = mi + 1;
      }
      resolved = 1;
    } else {
      if arp_cache_lookup(dst_ip, dst_mac) == 1 {
        resolved = 1;
      } else {
        // Correct by design for real hardware, not verifiable under
        // QEMU (same honest-limitation category rounds 23/24 already
        // established) -- nothing will ever answer this request under
        // QEMU's loopback-only netif, so this bounded wait always
        // runs its full course and reports "could not resolve" for
        // any dst_ip other than my_ip when tested here. Bounded (not
        // `while true`), matching every other poll loop in this
        // codebase.
        let _ = arp_resolve_start(my_mac, my_ip, dst_ip);
        let arp_iter: i64 = 0;
        while (arp_iter < 20) && (resolved == 0) {
          let arp_result: i64 = arp_resolve_poll(dst_ip);
          if arp_result == 1 {
            if arp_cache_lookup(dst_ip, dst_mac) == 1 {
              resolved = 1;
            }
          } else {
            let _ = delay(50000);
          }
          arp_iter = arp_iter + 1;
        }
      }
    }
    if resolved == 0 {
      let _ = uart_puts("ping: could not resolve ");
      let _ = uart_put_ip(dst_ip);
      let _ = uart_puts("\n");
      return 0;
    }

    let identifier: u32 = 0x0042 as u32;
    let seq: u32 = 1 as u32;
    let payload: mut ref i64 = shell_ping_payload_scratch_get();
    let _ = buf_write_byte(payload, 0 as u32, 112 as u32); // "ping"
    let _ = buf_write_byte(payload, 1 as u32, 105 as u32);
    let _ = buf_write_byte(payload, 2 as u32, 110 as u32);
    let _ = buf_write_byte(payload, 3 as u32, 103 as u32);

    let send_status: i64 = icmp_ping_start(my_mac, dst_mac, my_ip, dst_ip, identifier, seq, payload, 4);
    if send_status != 0 {
      let _ = uart_puts("ping: send failed\n");
      return 0;
    }
    let _ = uart_puts("PING ");
    let _ = uart_put_ip(dst_ip);
    let _ = uart_puts("\n");

    // Bounded wait for the reply -- icmp_poll's own live auto-
    // responder is what actually answers a self-ping (it dequeues our
    // own just-sent request on an earlier iteration of this same
    // loop, exactly like icmp_self_test's own two-poll pattern, just
    // generalized into a retry loop here instead of two fixed calls).
    let recv_payload: mut ref i64 = shell_ping_recv_payload_scratch_get();
    let recv_meta: mut ref i64 = shell_ping_recv_meta_scratch_get();
    let got_reply: i64 = 0;
    let poll_iter: i64 = 0;
    while (poll_iter < 20) && (got_reply == 0) {
      let poll_result: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
      if poll_result >= 0 {
        let reply_identifier: u32 = buf_read_u16_be(recv_meta, 4);
        let reply_seq: u32 = buf_read_u16_be(recv_meta, 6);
        if (reply_identifier == identifier) && (reply_seq == seq) {
          got_reply = 1;
        }
      }
      if got_reply == 0 {
        let _ = delay(50000);
      }
      poll_iter = poll_iter + 1;
    }
    if got_reply == 1 {
      let _ = uart_puts("reply from ");
      let _ = uart_put_ip(buf_read_u32_be(recv_meta, 0));
      let _ = uart_puts(" seq=");
      let _ = uart_put_i64(seq as i64);
      let _ = uart_puts("\n");
    } else {
      let _ = uart_puts("ping: no reply\n");
    }
    return 0;
  }

  // Round 28: a live network-status command -- until now, the only
  // way to see what round 27's own live DHCP client or netif's own
  // MAC actually reported this boot was scrolling back through boot
  // log output; nothing let a user ask "what's my network state
  // right now" interactively. Deliberately just reads and prints
  // existing state (dhcp_state_get_client_state/leased_ip/lease_time,
  // netif_get_mac) rather than performing any network activity of its
  // own, so it's always safe to run regardless of what else is
  // happening on netif's own shared queue (see task_e's own comment
  // on that queue's concurrent-consumer hazard) and fully
  // deterministic to test.
  if shell_word_matches(line_buf, 0, cmd_end, "ifconfig") == 1 {
    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let _ = uart_puts("mac ");
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(my_mac, mi as u32);
      let _ = uart_put_hex_byte(mb);
      if mi < 5 {
        let _ = uart_puts(":");
      }
      mi = mi + 1;
    }
    let _ = uart_puts("\n");

    let client_state: u32 = dhcp_state_get_client_state();
    let _ = uart_puts("dhcp state=");
    // Mutually exclusive by construction (client_state is only ever
    // set to one of these six named constants) -- separate top-level
    // checks rather than an if/else-if chain, matching this file's
    // own established style for multi-way state dispatch (see
    // dhcp_client_poll's own message-type branches).
    if client_state == dhcp_state_init() { let _ = uart_puts("INIT"); }
    if client_state == dhcp_state_selecting() { let _ = uart_puts("SELECTING"); }
    if client_state == dhcp_state_requesting() { let _ = uart_puts("REQUESTING"); }
    if client_state == dhcp_state_bound() { let _ = uart_puts("BOUND"); }
    if client_state == dhcp_state_renewing() { let _ = uart_puts("RENEWING"); }
    if client_state == dhcp_state_rebinding() { let _ = uart_puts("REBINDING"); }
    let _ = uart_puts(" ip=");
    let _ = uart_put_ip(dhcp_state_get_leased_ip());
    let lease_time: u32 = dhcp_state_get_lease_time();
    if lease_time != (0 as u32) {
      let _ = uart_puts(" lease=");
      let _ = uart_put_i64(lease_time as i64);
      let _ = uart_puts("s");
    }
    let _ = uart_puts("\n");
    return 0;
  }

  // Round 31: a read-only diagnostic exposing two pieces of state that
  // are already genuinely live (the ARP cache, driven by `ping` since
  // round 26; TCP connection slots, driven by `tcpecho` since round
  // 29) but that a user could previously only infer from a command's
  // side effects, never inspect directly. Unlike ping/tcpecho/udpecho,
  // this sends no traffic of its own -- pure state dump via the
  // existing arp_cache_get_*/tcp_conn_get_* accessors, same "expose
  // what's already there, don't add new protocol plumbing" shape as
  // ifconfig above.
  if shell_word_matches(line_buf, 0, cmd_end, "netstat") == 1 {
    let _ = uart_puts("ARP cache:\n");
    let arp_count: u32 = arp_cache_get_count();
    let ai: u32 = 0 as u32;
    while ai < arp_count {
      let _ = uart_puts("  ");
      let _ = uart_put_ip(arp_cache_get_ip(ai));
      let _ = uart_puts(" -> ");
      let macs: mut ref i64 = arp_cache_get_macs_buf();
      let base: u32 = ai * (6 as u32);
      let mi: i64 = 0;
      while mi < 6 {
        let mb: u32 = buf_read_byte(macs, base + (mi as u32));
        let _ = uart_put_hex_byte(mb);
        if mi < 5 {
          let _ = uart_puts(":");
        }
        mi = mi + 1;
      }
      let _ = uart_puts("\n");
      ai = ai + (1 as u32);
    }
    if arp_count == (0 as u32) {
      let _ = uart_puts("  (empty)\n");
    }

    let _ = uart_puts("TCP connections:\n");
    let conn_id: u32 = 0 as u32;
    while conn_id < (2 as u32) {
      let state: u32 = tcp_conn_get_state(conn_id);
      let _ = uart_puts("  conn ");
      let _ = uart_put_i64(conn_id as i64);
      let _ = uart_puts(" state=");
      // Mutually exclusive by construction, same style as ifconfig's
      // own dhcp_state_get_client_state() dispatch above.
      if state == tcp_state_closed() { let _ = uart_puts("CLOSED"); }
      if state == tcp_state_syn_sent() { let _ = uart_puts("SYN_SENT"); }
      if state == tcp_state_syn_rcvd() { let _ = uart_puts("SYN_RCVD"); }
      if state == tcp_state_established() { let _ = uart_puts("ESTABLISHED"); }
      if state == tcp_state_fin_wait() { let _ = uart_puts("FIN_WAIT"); }
      if state == tcp_state_closed_final() { let _ = uart_puts("CLOSED_FINAL"); }
      if state == tcp_state_closing() { let _ = uart_puts("CLOSING"); }
      let _ = uart_puts(" local=");
      let _ = uart_put_ip(tcp_conn_get_local_ip(conn_id));
      let _ = uart_puts(":");
      let _ = uart_put_i64(tcp_conn_get_local_port(conn_id) as i64);
      let _ = uart_puts(" remote=");
      let _ = uart_put_ip(tcp_conn_get_remote_ip(conn_id));
      let _ = uart_puts(":");
      let _ = uart_put_i64(tcp_conn_get_remote_port(conn_id) as i64);
      let _ = uart_puts("\n");
      conn_id = conn_id + (1 as u32);
    }
    return 0;
  }

  // Round 46: the cheapest possible first step of the "Darshana"
  // observability backlog (docs/TODO.md) -- nearly every number here
  // already existed as a live extern accessor (heap usage from round
  // 10's own headroom self-test, the governor's frequency history,
  // the scheduler's own tick/ready-task counters); this just formats
  // what's already there into one readable report, same "expose what's
  // already there" shape as ifconfig/netstat above. Deadline-miss and
  // per-task event counters are deliberately NOT included yet -- this
  // project has no deadline/budget concept for a task today (see
  // docs/TODO.md's own "per-task deadline/budget model" backlog item),
  // and inventing a fake always-zero counter here would be actively
  // misleading rather than merely incomplete. Round 51's event-counter
  // work is the real place those numbers belong.
  if shell_word_matches(line_buf, 0, cmd_end, "diagnose") == 1 {
    let _ = uart_puts("DhruvaOS diagnose\n");

    let ticks: u32 = scheduler_get_tick_count();
    let _ = uart_puts("  uptime_ticks: ");
    let _ = uart_put_i64(ticks as i64);
    let _ = uart_puts("\n");

    let ready: i64 = scheduler_ready_count();
    let _ = uart_puts("  scheduler ready: ");
    let _ = uart_put_i64(ready);
    let _ = uart_puts(" task(s)\n");

    let used: i64 = dhruva_heap_used_bytes();
    let capacity: i64 = 786432; // DHRUVA_HEAP_BYTES, runtime_stubs.c (round 68: 256KB -> 768KB) -- same constant heap_usage_self_test uses
    let pct: i64 = (used * 100) / capacity;
    let _ = uart_puts("  heap: ");
    let _ = uart_put_i64(used);
    let _ = uart_puts(" / ");
    let _ = uart_put_i64(capacity);
    let _ = uart_puts(" bytes (");
    let _ = uart_put_i64(pct);
    // Never-freed bump allocator by design (see feedback_dhruva_
    // never_free_heap_pattern) -- "used" only ever grows, so this
    // figure is already this boot's own high-water mark, not merely
    // a current snapshot.
    let _ = uart_puts("% used, high-water mark since boot)\n");

    let cur_mhz: i64 = governor_get_last_applied_mhz();
    let _ = uart_puts("  cpu freq: ");
    let _ = uart_put_i64(cur_mhz);
    let _ = uart_puts(" MHz (recent history: ");
    let _ = uart_put_i64(governor_history_get0());
    let _ = uart_puts(", ");
    let _ = uart_put_i64(governor_history_get1());
    let _ = uart_puts(", ");
    let _ = uart_put_i64(governor_history_get2());
    let _ = uart_puts(", ");
    let _ = uart_put_i64(governor_history_get3());
    let _ = uart_puts(")\n");

    // Round 51: the first two real event counters -- see docs/TODO.md
    // for why context-switch/IRQ/mutex counters aren't here yet
    // (touching the scheduler/interrupt assembly is materially larger
    // scope, deliberately deferred rather than half-done here).
    let _ = uart_puts("  allocations: ");
    let _ = uart_put_i64(dhruva_alloc_count_get());
    let _ = uart_puts(" total (never-freed bump allocator)\n");
    let _ = uart_puts("  FS commits: ");
    let _ = uart_put_i64(dharafs_commit_count_get() as i64);
    let _ = uart_puts(" total (successful dharafs_block_write calls)\n");

    // Round 53: real scheduler/interrupt activity counters -- see
    // docs/TODO.md for why a deadline/priority-inversion model isn't
    // here yet (needs a real timing-constrained workload to mean
    // anything; these three don't, they're real regardless of what
    // the running tasks actually do).
    let _ = uart_puts("  context switches: ");
    let _ = uart_put_i64(context_switch_count_get());
    let _ = uart_puts(" total (scheduler_pick_next picked a DIFFERENT task)\n");
    let _ = uart_puts("  IRQs serviced: ");
    let _ = uart_put_i64(irq_count_get());
    let _ = uart_puts(" total (timer tick + UART RX combined)\n");
    let _ = uart_puts("  prio_lock calls: ");
    let _ = uart_put_i64(prio_lock_count_get());
    let _ = uart_puts(" total (ceiling-protected critical section entries)\n");

    // Round 59: the "remaining, not done" note on round 55's real
    // blocking mutex -- now that dhruva_mutex_lock/unlock give a
    // genuine wait queue something CAN actually happen to measure
    // (unlike the ceiling protocol above, ties into no scheduling-
    // visible signal by construction). mutex_contention_count only
    // counts genuine blocks, not every lock call (an uncontended
    // acquire is not "inversion" of any kind -- nothing to log).
    let _ = uart_puts("  mutex contentions: ");
    let _ = uart_put_i64(mutex_contention_count_get());
    let _ = uart_puts(" total (dhruva_mutex_lock calls that actually blocked)\n");
    let _ = uart_puts("  mutex worst-case wait: ");
    let _ = uart_put_i64(mutex_wait_worst_ticks_get());
    let _ = uart_puts(" ticks\n");

    // Round 66: recent history, oldest to newest -- one sample per
    // real tick, up to the last 32 (~16 seconds at the 500ms tick
    // period), answering "what was activity like recently" rather
    // than just the running totals above. See diag_ring_state.S's own
    // header comment for the full design (why this samples the
    // existing counters instead of instrumenting their increment
    // sites directly).
    let hist_count: i64 = diag_ring_get_count();
    let _ = uart_puts("  recent history (");
    let _ = uart_put_i64(hist_count);
    let _ = uart_puts(" of last 32 ticks, oldest first): tick/ctxsw/irqs/priolock\n");
    let hi: i64 = 0;
    while hi < hist_count {
      let phys: i64 = diag_ring_physical_index(hi);
      let _ = uart_puts("    ");
      let _ = uart_put_i64(diag_ring_get_tick_at(phys));
      let _ = uart_puts("/");
      let _ = uart_put_i64(diag_ring_get_ctxsw_at(phys));
      let _ = uart_puts("/");
      let _ = uart_put_i64(diag_ring_get_irqs_at(phys));
      let _ = uart_puts("/");
      let _ = uart_put_i64(diag_ring_get_priolock_at(phys));
      let _ = uart_puts("\n");
      hi = hi + 1;
    }
    return 0;
  }

  // Round 51/62: fault injection. Factored into its own function (not
  // inlined here) for the same reason shell_dispatch_fw/_su/_passwd
  // already are -- task_f's own #[bounded_stack] budget, a real
  // compiler-enforced check, not a style preference.
  if shell_word_matches(line_buf, 0, cmd_end, "fault") == 1 {
    return shell_dispatch_fault(line_buf, cmd_end, line_len);
  }

  // Round 29: gives the entire TCP connection API (round 22's own
  // feature ledger flagged this as the single biggest "correct, never
  // used live" gap left in this project) a real, self-contained live
  // caller -- the same self-talk-over-loopback trick `ping` already
  // uses for ICMP, generalized to a full three-way handshake, one
  // data transfer, and a full close, all driven through the real
  // netif queue via tcp_conn_poll rather than tcp_conn_self_test's own
  // hand-fed frames. Uses connection slots 0 (client) and 1 (server),
  // the same fixed pair every TCP self-test already uses -- both
  // start fresh every call via active_open/passive_open's own state
  // resets, so there's no leftover state from a prior self-test or a
  // prior `tcpecho` run to worry about. 127.0.0.1 and dedicated
  // ports (54322/7777, distinct from any self-test's own port
  // numbers) are used purely so a boot log reading this output is
  // never confused with a self-test's own traffic -- this is still a
  // pure loopback round trip regardless of which addresses are used.
  if shell_word_matches(line_buf, 0, cmd_end, "tcpecho") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: tcpecho <text>\n");
      return 0;
    }
    let text_start: i64 = cmd_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (64 as i64) {
      let _ = uart_puts("error: text too long (max 64)\n");
      return 0;
    }
    let payload: mut ref i64 = shell_tcpecho_payload_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, payload);

    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let client_id: u32 = 0 as u32;
    let server_id: u32 = 1 as u32;
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54322 as u32;
    let server_port: u32 = 7777 as u32;

    let _ = tcp_conn_passive_open(server_id, loop_ip, server_port);
    let isn: u32 = scheduler_get_tick_count() + (1000 as u32);
    let open_status: i64 = tcp_conn_active_open(client_id, my_mac, my_mac, loop_ip, loop_ip, client_port, server_port, isn);
    if open_status != 0 {
      let _ = uart_puts("tcpecho: SYN send failed\n");
      return 0;
    }

    // Handshake: SYN -> server, SYN-ACK -> client, final ACK -> server
    // is exactly 3 frames -- bounded well past that for margin, same
    // "bounded, not `while true`" discipline every poll loop in this
    // project already follows.
    let scratch: mut ref i64 = shell_tcp_poll_scratch_get();
    let handshake_iter: i64 = 0;
    while (handshake_iter < 10) && ((tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established())) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      handshake_iter = handshake_iter + 1;
    }
    if (tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established()) {
      let _ = uart_puts("tcpecho: handshake failed\n");
      return 0;
    }

    let send_status: i64 = tcp_conn_send_data(client_id, my_mac, my_mac, payload, text_len);
    if send_status != 0 {
      let _ = uart_puts("tcpecho: send failed\n");
      return 0;
    }

    // Data + echo is exactly 2 frames (client's data segment, the
    // server's echoed reply) -- tcp_conn_poll's own auto-responder
    // (see its comment) is what actually sends the second one.
    let recv_payload: mut ref i64 = shell_tcpecho_recv_payload_scratch_get();
    let echoed: i64 = 0 - 1;
    let data_iter: i64 = 0;
    while (data_iter < 10) && (echoed < 0) {
      let poll_result: i64 = tcp_conn_poll(my_mac, recv_payload, 64);
      if poll_result > 0 {
        echoed = poll_result;
      }
      data_iter = data_iter + 1;
    }

    let _ = tcp_conn_close(client_id, my_mac, my_mac);
    let close_iter: i64 = 0;
    while (close_iter < 10) && (tcp_conn_get_state(client_id) != tcp_state_closed_final()) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      close_iter = close_iter + 1;
    }

    if echoed < 0 {
      let _ = uart_puts("tcpecho: no echo received\n");
      return 0;
    }
    let _ = uart_puts("tcpecho: echoed \"");
    let _ = dharafs_print_data(recv_payload, echoed);
    let _ = uart_puts("\"\n");
    return 0;
  }

  // A TLS-shaped counterpart to tcpecho, above: same self-connect-
  // over-loopback shape, but the round trip runs through the real
  // tls_connect/tls_accept/tls_send/tls_recv API (see that section's
  // own header comment for the concurrency model and its scope
  // limits) instead of bare TCP -- the user's own text genuinely gets
  // encrypted, sent as TLS application data over a real TCP
  // connection, decrypted by the "server" role, echoed back
  // encrypted, and decrypted again here before printing.
  if shell_word_matches(line_buf, 0, cmd_end, "tlsecho") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: tlsecho <text>\n");
      return 0;
    }
    let text_start: i64 = cmd_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (64 as i64) {
      let _ = uart_puts("error: text too long (max 64)\n");
      return 0;
    }
    let payload: mut ref i64 = tls_client_msg_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, payload);

    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let client_id: u32 = 0 as u32;
    let server_id: u32 = 1 as u32;
    let loop_ip: u32 = 0x7F000001 as u32;
    let client_port: u32 = 54325 as u32;
    let server_port: u32 = 8443 as u32;

    let _ = tcp_conn_passive_open(server_id, loop_ip, server_port);
    let isn: u32 = scheduler_get_tick_count() + (2000 as u32);
    let open_status: i64 = tcp_conn_active_open(client_id, my_mac, my_mac, loop_ip, loop_ip, client_port, server_port, isn);
    if open_status != 0 {
      let _ = uart_puts("tlsecho: SYN send failed\n");
      return 0;
    }

    let scratch: mut ref i64 = shell_tcp_poll_scratch_get();
    let handshake_iter: i64 = 0;
    while (handshake_iter < 10) && ((tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established())) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      handshake_iter = handshake_iter + 1;
    }
    if (tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established()) {
      let _ = uart_puts("tlsecho: TCP handshake failed\n");
      return 0;
    }

    let connect_status: i64 = tls_connect(client_id, server_id, my_mac);
    if connect_status != 0 {
      let _ = uart_puts("tlsecho: TLS handshake failed\n");
      return 0;
    }
    let accept_status: i64 = tls_accept(server_id, client_id, my_mac);
    if accept_status != 0 {
      let _ = uart_puts("tlsecho: TLS server-side accept failed\n");
      return 0;
    }

    let c_ap_key: mut ref i64 = tls_c_ap_key_get();
    let c_ap_iv: mut ref i64 = tls_c_ap_iv_get();
    let _ = tls_send(client_id, server_id, my_mac, c_ap_key, c_ap_iv, payload, text_len, tls_server_rx_buf_get(), tls_server_rx_len_get());

    let dec: mut ref i64 = tls_decrypted_scratch_get();
    let dec_len: i64 = tls_recv(tls_server_rx_buf_get(), tls_server_rx_len_get(), c_ap_key, c_ap_iv, dec);
    if dec_len < 0 {
      let _ = uart_puts("tlsecho: server failed to decrypt client message\n");
      return 0;
    }

    let s_ap_key: mut ref i64 = tls_s_ap_key_get();
    let s_ap_iv: mut ref i64 = tls_s_ap_iv_get();
    let _ = tls_send(server_id, client_id, my_mac, s_ap_key, s_ap_iv, dec, dec_len, tls_client_rx_buf_get(), tls_client_rx_len_get());

    let echoed_buf: mut ref i64 = tls_server_reply_get();
    let echoed_len: i64 = tls_recv(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_ap_key, s_ap_iv, echoed_buf);
    if echoed_len < 0 {
      let _ = uart_puts("tlsecho: client failed to decrypt server echo\n");
      return 0;
    }

    let _ = tcp_conn_close(client_id, my_mac, my_mac);
    let close_iter: i64 = 0;
    while (close_iter < 10) && (tcp_conn_get_state(client_id) != tcp_state_closed_final()) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      close_iter = close_iter + 1;
    }

    let _ = uart_puts("tlsecho: echoed over real TLS 1.3 \"");
    let _ = dharafs_print_data(echoed_buf, echoed_len);
    let _ = uart_puts("\"\n");
    return 0;
  }

  // Round 30: the last major "correct, never used live" gap the
  // feature ledger flagged -- socket_udp_send/socket_udp_recv (Phase
  // 6's own socket-style API, see socket_udp_send's comment) had run
  // only inside udp_self_test's hand-fed traffic since round 21 added
  // the ARP-cache-hit requirement. UDP is connectionless, so unlike
  // tcp_conn_poll there's no per-connection state to route by --
  // instead this builds a tiny, self-contained "echo service"
  // entirely within this one command: every queued UDP datagram is
  // read via socket_udp_recv's own reported metadata (out_meta's
  // dst_port, not a separate frame parse), and if it's addressed to
  // the fixed echo_port, it's answered immediately, right here, the
  // same "no separate caller involvement" shape icmp_poll/
  // tcp_conn_poll's own auto-responders already established -- just
  // inlined rather than factored into a standalone *_poll function,
  // since there's no ongoing connection state for a caller elsewhere
  // to also need access to. 127.0.0.1 and dedicated ports (54323/7778,
  // distinct from udp_self_test's own 12345/7 and tcpecho's
  // 54322/7777) keep this obviously a distinct live round trip in the
  // boot log, not a rerun of that self-test.
  if shell_word_matches(line_buf, 0, cmd_end, "udpecho") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: udpecho <text>\n");
      return 0;
    }
    let text_start: i64 = cmd_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (64 as i64) {
      let _ = uart_puts("error: text too long (max 64)\n");
      return 0;
    }
    let payload: mut ref i64 = shell_udpecho_payload_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, payload);

    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54323 as u32;
    let echo_port: u32 = 7778 as u32;

    // socket_udp_send requires a real ARP-cache hit (round 21) -- for
    // a genuine off-loopback peer this would only ever succeed after a
    // live arp_resolve_start/poll round trip like `ping` runs, but for
    // this self-talk case the "peer" is ourselves, so inserting our
    // own MAC once up front stands in for that, matching udp_self_
    // test's own established precedent for the identical requirement.
    let _ = arp_cache_insert(loop_ip, my_mac);

    let send_status: i64 = socket_udp_send(my_mac, loop_ip, loop_ip, client_port, echo_port, payload, text_len);
    if send_status != 0 {
      let _ = uart_puts("udpecho: send failed (destination not ARP-resolved)\n");
      return 0;
    }

    let recv_payload: mut ref i64 = shell_udpecho_recv_payload_scratch_get();
    let recv_meta: mut ref i64 = shell_udpecho_recv_meta_scratch_get();
    let echoed: i64 = 0 - 1;
    let poll_iter: i64 = 0;
    while (poll_iter < 10) && (echoed < 0) {
      let recv_len: i64 = socket_udp_recv(recv_payload, recv_meta, 64);
      if recv_len >= 0 {
        let dst_port: u32 = buf_read_u16_be(recv_meta, 6);
        if dst_port == echo_port {
          let src_port: u32 = buf_read_u16_be(recv_meta, 4);
          let _ = socket_udp_send(my_mac, loop_ip, loop_ip, echo_port, src_port, recv_payload, recv_len);
        }
        if dst_port == client_port {
          echoed = recv_len;
        }
      }
      poll_iter = poll_iter + 1;
    }

    if echoed < 0 {
      let _ = uart_puts("udpecho: no echo received\n");
      return 0;
    }
    let _ = uart_puts("udpecho: echoed \"");
    let _ = dharafs_print_data(recv_payload, echoed);
    let _ = uart_puts("\"\n");
    return 0;
  }

  // Round 37: proves TCP retransmission recovers a REAL simulated
  // packet loss, live -- not just that the state machine reacts
  // correctly to hand-fed frames (the boot-time self-tests already
  // cover that; this needs the real timer tick to actually elapse,
  // which no boot-time self-test can ever observe since it runs
  // before timer_ic_init/start_multitasking, hence this being a shell
  // command like tcpecho/udpecho rather than another self-test).
  // Sends the client's SYN, then deliberately dequeues-and-drops that
  // exact frame before the server side ever sees it -- simulating a
  // real lost segment directly, the same technique docs/TODO.md's own
  // retransmission item called for, since this project's loopback
  // netif never drops anything on its own. Sleeps out the real 2-
  // second RTO (tcp_rtx_timeout_ticks) so tcp_conn_check_retransmit's
  // own tick-based deadline genuinely elapses, then polls normally --
  // the retransmitted SYN (sent by tcp_conn_poll's own retransmit
  // check) reaches the server through the same shared queue every
  // other live TCP/UDP/ICMP command already uses, completing the
  // handshake despite the induced loss.
  if shell_word_matches(line_buf, 0, cmd_end, "tcprtx") == 1 {
    let my_mac: mut ref i64 = shell_my_mac_scratch_get();
    let _ = netif_get_mac(my_mac);
    let client_id: u32 = 0 as u32;
    let server_id: u32 = 1 as u32;
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54324 as u32;
    let server_port: u32 = 7779 as u32;

    let _ = tcp_conn_passive_open(server_id, loop_ip, server_port);
    let isn: u32 = scheduler_get_tick_count() + (2000 as u32);
    let open_status: i64 = tcp_conn_active_open(client_id, my_mac, my_mac, loop_ip, loop_ip, client_port, server_port, isn);
    if open_status != 0 {
      let _ = uart_puts("tcprtx: SYN send failed\n");
      return 0;
    }

    // Deliberately drain the queue here -- normally this dequeues our
    // own just-sent SYN directly. If task_e's own periodic
    // dhcp_client_poll happens to preempt in the brief window between
    // active_open sending the SYN and this drain (the same shared-
    // netif-queue hazard task_e's own comment documents, and
    // netif_queue_contention_self_test proves the mechanism of), it
    // may have already dequeued-and-dropped the SYN itself, leaving
    // this call to find an empty queue. Either way the SYN is now
    // genuinely gone -- exactly the condition this test needs -- so
    // this isn't treated as a failure, just two different paths to
    // the same real loss.
    let drop_buf: mut ref i64 = shell_tcprtx_drop_buf_scratch_get();
    let _ = netif_recv_frame(drop_buf, 64);

    let _ = task_sleep_ticks((tcp_rtx_timeout_ticks() + (1 as u32)) as i64);

    let scratch: mut ref i64 = shell_tcp_poll_scratch_get();
    let handshake_iter: i64 = 0;
    while (handshake_iter < 10) && ((tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established())) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      handshake_iter = handshake_iter + 1;
    }

    if (tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established()) {
      let _ = uart_puts("tcprtx: handshake failed to recover after simulated SYN loss\n");
      return 0;
    }
    let rtx_count: u32 = tcp_conn_get_rtx_count(client_id);
    if rtx_count == (0 as u32) {
      let _ = uart_puts("tcprtx: handshake completed but no retransmit was observed (test didn't exercise what it claims to)\n");
      return 0;
    }
    let _ = uart_puts("tcprtx: recovered from simulated SYN loss via retransmission, retries=");
    let _ = uart_put_hex32(rtx_count);
    let _ = uart_puts(" (PASS)\n");
    return 0;
  }

  let _ = uart_puts("unknown command (try ls/cat/catv/rm/mv/write/writev/log/attr/chmod/chown/eval/ping/ifconfig/netstat/diagnose/fault/tcpecho/udpecho/tcprtx)\n");
  return 0;
}

// Lowest-priority best-effort task alongside GC (task_e) -- same
// reserved band, priority 3 (see context_switch.S's start_multitasking
// comment). Polls shell_get_line_ready() rather than blocking on it:
// there's no "wake me when ready" primitive here, just the same
// sleep-then-recheck pattern task_c/task_d already use elsewhere.
//
// BUG (round 30 audit): #[bounded_stack(bytes=2048)] was already too
// tight once `udpecho`'s own locals were added to shell_dispatch --
// compiler-reported worst case 2184 bytes via chain task_f ->
// shell_dispatch -> tcp_conn_poll -> tcp_conn_handle_segment ->
// tcp_send_segment -> tcp_build_header -> tcp_checksum ->
// buf_read_u16_be (the same class of real, compile-time-caught
// violation round 27's task_e comment documents in full -- this is
// its second occurrence). Raised to 4096, well past the reported
// worst case, to leave headroom for future shell commands rather than
// only barely clearing today's exact number.
//
// Round 67: the new `verify` shell command's own call chain (task_f
// -> shell_dispatch -> pki_verify_file_raw -> ... -> ed25519_verify
// -> point decompression's own modular-sqrt computation) reported a
// new worst case of 4172 bytes, past the round-30 budget again --
// same bug class, not a new one. Raised to 6144 at the time.
//
// Round 67, same day: `tlsecho`'s own call chain (task_f ->
// shell_dispatch -> tls_connect -> tls_service -> [either
// tls_server_process_client_hello or tls_client_try_process_flight]
// -> ... -> tcp_send_segment -> netif_send_frame -> dwc2_net_bulk_out
// -> ...) is deep enough that a REAL Data Abort (wild pointer values
// in the fault registers, not a null/near-null address -- the
// signature of actual stack corruption, not a caught-early guard-page
// hit) reproduced live under QEMU even though this checker reported
// only 5064 bytes worst-case for it -- comfortably UNDER the 6144
// budget in effect at the time. This is the SAME "checker is a
// conservative estimator, not an exact analysis, and has
// underestimated a real overflow before" bug class round 60's own
// task_custom_demo investigation already documented (see that
// function's own comment below) -- not a new discovery, but the
// second time it's bitten a real caller. Since the checker's own
// number can't be trusted as a ceiling, the fix here is two-part:
// task_f's own REAL allocated stack (task_f_init_stack's own
// stack_f_bytes below) doubled from 16384 to 32768 bytes -- trivially
// affordable on any real target this project runs on -- and this
// annotation raised to 12288, real headroom both above the reported
// 5064 AND with margin left in the doubled real allocation for
// whatever the checker is still failing to see.
#[no_mangle]
#[bounded_stack(bytes=12288)]
fn task_f() -> i64 {
  while true {
    let ready: u32 = shell_get_line_ready();
    if ready == (0 as u32) {
      let _ = task_sleep_ticks(2);
    } else {
      // Round 76: shell_dispatch handles every command, most of which
      // touch DharaFS's shared state (ls/cat/write/rm/mkdir/stat/...)
      // -- ceiling=2 matches task_e's own DharaFS-critical-section lock
      // and task_fsq's, see task_e's own comment on why 2 (task_fsq's
      // real priority), not 3 (task_f/task_e's own shared priority).
      // Wrapping the WHOLE dispatch, not just the FS-touching commands
      // individually, is deliberate: simpler and provably correct
      // (impossible to miss a future command that touches DharaFS),
      // at the cost of briefly locking during non-FS commands too
      // (eval/ping/ifconfig/...) -- negligible, since the lock is held
      // only for this one command's own short duration either way.
      let _ = dhruva_prio_lock(2);
      let _ = shell_dispatch();
      let _ = dhruva_prio_unlock(3);
      let _ = shell_clear_line();
    }
  }
  return 0;
}

// Round 54's own live demonstration of task_create: a genuinely
// dynamically-created task, not one of the 6 built in at compile time
// -- proves entry_fn (a real vani function passed as a value) actually
// runs correctly when the scheduler switches to a slot task_create
// populated at runtime, not just that the API compiles. Priority 3,
// the same best-effort band GC/SHELL already share -- an ordinary new
// task has no reason to outrank the existing hard-RT demo.
#[no_mangle]
#[bounded_stack(bytes=512)]
fn task_custom_demo() -> i64 {
  while true {
    let _ = task_sleep_ticks(7);
    let _ = uart_puts("CUSTOM: dynamically-created task running\n");
  }
  return 0;
}

// Round 55's own live demonstration of dhruva_mutex_lock/unlock: two
// more dynamically-created tasks (task_create again), sharing demo
// mutex 0. task_mutex_demo_high runs at priority 0 (same band as the
// real HIGH task) and genuinely BLOCKS in dhruva_mutex_lock whenever
// task_mutex_demo_low (priority 2, same band as real LOW) already
// holds it -- proven live by the UART trace showing a real gap between
// "requesting" and "acquired", not an immediate acquire.
//
// Deterministic contention, not a timing coincidence: task_mutex_demo_
// low holds the mutex ACROSS a task_sleep_ticks(5) call (simulating a
// slow operation performed while holding the lock -- the mutex stays
// "owned" the whole time it's asleep, exactly like a real blocking I/O
// call made under a lock). task_mutex_demo_high requests the mutex
// every 2 ticks. Since 2 < 5, by the pigeonhole principle at least one
// of HIGH's periodic 2-tick-spaced attempts is GUARANTEED to land
// inside any 5-tick hold window, regardless of phase -- so this isn't
// probabilistic, it reproduces every single cycle. Without priority
// inheritance, this is exactly classic priority inversion (a priority-2
// holder delaying a priority-0 waiter for the full 5-tick hold). With
// it, task_mutex_demo_low's own eff_prio genuinely reads 0 (via
// current_eff_prio(), printed live right after waking, before release)
// whenever HIGH did contend during the hold -- provable, not just
// asserted.
#[no_mangle]
#[bounded_stack(bytes=512)]
fn task_mutex_demo_low() -> i64 {
  while true {
    let _ = task_sleep_ticks(2);
    let _ = uart_puts("MUTEX-LOW: requesting demo mutex (own base prio=2)\n");
    let _ = dhruva_mutex_lock(0 as u32);
    let _ = uart_puts("MUTEX-LOW: holding demo mutex, now sleeping 5 ticks while still holding it\n");
    let _ = task_sleep_ticks(5);
    let boosted: u32 = current_eff_prio();
    let _ = uart_puts("MUTEX-LOW: woke up still holding demo mutex, eff_prio now=");
    let _ = uart_put_i64(boosted as i64);
    let _ = uart_puts("\n");
    let _ = uart_puts("MUTEX-LOW: releasing demo mutex\n");
    let _ = dhruva_mutex_unlock(0 as u32);
  }
  return 0;
}

#[no_mangle]
#[bounded_stack(bytes=512)]
fn task_mutex_demo_high() -> i64 {
  while true {
    let _ = task_sleep_ticks(2);
    let _ = uart_puts("MUTEX-HIGH: requesting demo mutex\n");
    let _ = dhruva_mutex_lock(0 as u32);
    let _ = uart_puts("MUTEX-HIGH: acquired demo mutex\n");
    let _ = dhruva_mutex_unlock(0 as u32);
    let _ = uart_puts("MUTEX-HIGH: released demo mutex\n");
  }
  return 0;
}

// Round 99 -- SHA-256 migrated to the shared, hardware-agnostic
// `crypto_hash` kosh package (see project memory
// project_dhruva_round98_crypto_generification_2026_09_06 and
// project_dhruva_generic_crypto_packages_x509_scope_2026_09_06). This
// closes the "whatever's on Pi 4 should be on Pi 1 too" gap for
// SHA-256 specifically: rather than this file maintaining its own
// hand-rolled ARM32 heap-based implementation (originally round 41,
// hardened round 65 against a real long-lived-scratch-pointer
// register-corruption bug -- see that history preserved in
// vani-crypto-hash's own git log if ever needed) alongside a SEPARATE
// hand-rolled AArch64 fixed-array implementation on the Pi 4/5 side
// (rounds 85/94-97), both now consume ONE shared implementation.
//
// The package's own core (`sha256_init`/`sha256_update`/
// `sha256_finalize`, `Sha256Ctx`) is fixed-array/heap-free, whereas
// this file's every OTHER caller still holds messages as heap
// pointers (`mut ref i64` via `dhruva_alloc_bytes`) -- `sha256_hash`
// below is now a thin ADAPTER, not the algorithm itself: it copies
// the heap buffer into the package's own `[u8; 256]` stream chunks
// (looping as many times as needed, so there's no length cap despite
// each individual chunk being fixed-size -- this is exactly what the
// package's v0.2.0 streaming API was added for, see its own README),
// feeds them through `sha256_update`, and copies the resulting
// 32-byte digest back into the caller's own heap `out` buffer. Every
// one of this file's 17 existing `sha256_hash` call sites (DharaFS
// verified-write digests, HMAC, TLS transcript hashing, etc.) keeps
// the exact same signature and needed ZERO changes.
//
// `sha256_bytes_equal` below is untouched -- a generic byte-buffer
// comparator with no dependency on the SHA-256 algorithm itself, so
// nothing about this migration affects it.
//
// Deleted entirely (now living in vani-crypto-hash instead):
// sha256_wrap_add32, sha256_rotr32, sha256_k_init, sha256_h_init,
// sha256_read_be32, sha256_write_be32, sha256_compress, and the old
// scratch-based sha256_hash body. The now-unused
// sha256_padded/h/k/w_scratch_set persistent-buffer allocations
// (boot/scratch_state.S) were also removed from this file's own
// boot-time init sequence -- nothing calls those accessors anymore.
use "../vendor/crypto_hash/src/core.vani";

fn sha256_hash(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  let ctx: Sha256Ctx = sha256_init();
  let offset: i64 = 0;
  while offset < msg_len {
    let remaining: i64 = msg_len - offset;
    let chunk_n: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = zero256_bytes();
    let i: i64 = 0;
    while i < chunk_n {
      chunk[i] = buf_read_byte(msg, (offset + i) as u32) as u8;
      i = i + 1;
    }
    ctx = sha256_update(ref ctx, mut ref chunk, chunk_n);
    offset = offset + chunk_n;
  }
  let digest: [u8; 32] = sha256_finalize(ref ctx);
  let j: i64 = 0;
  while j < 32 {
    let _ = buf_write_byte(out, j as u32, digest[j] as u32);
    j = j + 1;
  }
  return 0;
}


fn sha256_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Three FIPS 180-4 / NIST known-answer vectors: the empty string, the
// "abc" worked example from the spec itself, and a 56-byte message
// whose padding lands exactly on a second 64-byte block -- the one
// case a single-block-only implementation would get wrong.
fn sha256_self_test() -> i64 {
  let ok: i64 = 1;

  let msg0: mut ref i64 = dhruva_alloc_bytes(1);
  let out0: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg0, 0, out0);
  let exp0: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp0, 0 as u32, 0xe3 as u32);
  let _ = buf_write_byte(exp0, 1 as u32, 0xb0 as u32);
  let _ = buf_write_byte(exp0, 2 as u32, 0xc4 as u32);
  let _ = buf_write_byte(exp0, 3 as u32, 0x42 as u32);
  let _ = buf_write_byte(exp0, 4 as u32, 0x98 as u32);
  let _ = buf_write_byte(exp0, 5 as u32, 0xfc as u32);
  let _ = buf_write_byte(exp0, 6 as u32, 0x1c as u32);
  let _ = buf_write_byte(exp0, 7 as u32, 0x14 as u32);
  let _ = buf_write_byte(exp0, 8 as u32, 0x9a as u32);
  let _ = buf_write_byte(exp0, 9 as u32, 0xfb as u32);
  let _ = buf_write_byte(exp0, 10 as u32, 0xf4 as u32);
  let _ = buf_write_byte(exp0, 11 as u32, 0xc8 as u32);
  let _ = buf_write_byte(exp0, 12 as u32, 0x99 as u32);
  let _ = buf_write_byte(exp0, 13 as u32, 0x6f as u32);
  let _ = buf_write_byte(exp0, 14 as u32, 0xb9 as u32);
  let _ = buf_write_byte(exp0, 15 as u32, 0x24 as u32);
  let _ = buf_write_byte(exp0, 16 as u32, 0x27 as u32);
  let _ = buf_write_byte(exp0, 17 as u32, 0xae as u32);
  let _ = buf_write_byte(exp0, 18 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp0, 19 as u32, 0xe4 as u32);
  let _ = buf_write_byte(exp0, 20 as u32, 0x64 as u32);
  let _ = buf_write_byte(exp0, 21 as u32, 0x9b as u32);
  let _ = buf_write_byte(exp0, 22 as u32, 0x93 as u32);
  let _ = buf_write_byte(exp0, 23 as u32, 0x4c as u32);
  let _ = buf_write_byte(exp0, 24 as u32, 0xa4 as u32);
  let _ = buf_write_byte(exp0, 25 as u32, 0x95 as u32);
  let _ = buf_write_byte(exp0, 26 as u32, 0x99 as u32);
  let _ = buf_write_byte(exp0, 27 as u32, 0x1b as u32);
  let _ = buf_write_byte(exp0, 28 as u32, 0x78 as u32);
  let _ = buf_write_byte(exp0, 29 as u32, 0x52 as u32);
  let _ = buf_write_byte(exp0, 30 as u32, 0xb8 as u32);
  let _ = buf_write_byte(exp0, 31 as u32, 0x55 as u32);
  if sha256_bytes_equal(out0, exp0, 32) == 0 { ok = 0; }

  let msg1: mut ref i64 = dhruva_alloc_bytes(3);
  let _ = buf_write_byte(msg1, 0 as u32, 97 as u32);
  let _ = buf_write_byte(msg1, 1 as u32, 98 as u32);
  let _ = buf_write_byte(msg1, 2 as u32, 99 as u32);
  let out1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg1, 3, out1);
  let exp1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp1, 0 as u32, 0xba as u32);
  let _ = buf_write_byte(exp1, 1 as u32, 0x78 as u32);
  let _ = buf_write_byte(exp1, 2 as u32, 0x16 as u32);
  let _ = buf_write_byte(exp1, 3 as u32, 0xbf as u32);
  let _ = buf_write_byte(exp1, 4 as u32, 0x8f as u32);
  let _ = buf_write_byte(exp1, 5 as u32, 0x01 as u32);
  let _ = buf_write_byte(exp1, 6 as u32, 0xcf as u32);
  let _ = buf_write_byte(exp1, 7 as u32, 0xea as u32);
  let _ = buf_write_byte(exp1, 8 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp1, 9 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp1, 10 as u32, 0x40 as u32);
  let _ = buf_write_byte(exp1, 11 as u32, 0xde as u32);
  let _ = buf_write_byte(exp1, 12 as u32, 0x5d as u32);
  let _ = buf_write_byte(exp1, 13 as u32, 0xae as u32);
  let _ = buf_write_byte(exp1, 14 as u32, 0x22 as u32);
  let _ = buf_write_byte(exp1, 15 as u32, 0x23 as u32);
  let _ = buf_write_byte(exp1, 16 as u32, 0xb0 as u32);
  let _ = buf_write_byte(exp1, 17 as u32, 0x03 as u32);
  let _ = buf_write_byte(exp1, 18 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp1, 19 as u32, 0xa3 as u32);
  let _ = buf_write_byte(exp1, 20 as u32, 0x96 as u32);
  let _ = buf_write_byte(exp1, 21 as u32, 0x17 as u32);
  let _ = buf_write_byte(exp1, 22 as u32, 0x7a as u32);
  let _ = buf_write_byte(exp1, 23 as u32, 0x9c as u32);
  let _ = buf_write_byte(exp1, 24 as u32, 0xb4 as u32);
  let _ = buf_write_byte(exp1, 25 as u32, 0x10 as u32);
  let _ = buf_write_byte(exp1, 26 as u32, 0xff as u32);
  let _ = buf_write_byte(exp1, 27 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp1, 28 as u32, 0xf2 as u32);
  let _ = buf_write_byte(exp1, 29 as u32, 0x00 as u32);
  let _ = buf_write_byte(exp1, 30 as u32, 0x15 as u32);
  let _ = buf_write_byte(exp1, 31 as u32, 0xad as u32);
  if sha256_bytes_equal(out1, exp1, 32) == 0 { ok = 0; }

  let s2: Str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  let len2: i64 = str_len_bytes(s2);
  let msg2: mut ref i64 = dhruva_alloc_bytes(len2);
  let i2: i64 = 0;
  while i2 < len2 {
    let _ = buf_write_byte(msg2, i2 as u32, str_byte_at(s2, i2) as u32);
    i2 = i2 + 1;
  }
  let out2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg2, len2, out2);
  let exp2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp2, 0 as u32, 0x24 as u32);
  let _ = buf_write_byte(exp2, 1 as u32, 0x8d as u32);
  let _ = buf_write_byte(exp2, 2 as u32, 0x6a as u32);
  let _ = buf_write_byte(exp2, 3 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp2, 4 as u32, 0xd2 as u32);
  let _ = buf_write_byte(exp2, 5 as u32, 0x06 as u32);
  let _ = buf_write_byte(exp2, 6 as u32, 0x38 as u32);
  let _ = buf_write_byte(exp2, 7 as u32, 0xb8 as u32);
  let _ = buf_write_byte(exp2, 8 as u32, 0xe5 as u32);
  let _ = buf_write_byte(exp2, 9 as u32, 0xc0 as u32);
  let _ = buf_write_byte(exp2, 10 as u32, 0x26 as u32);
  let _ = buf_write_byte(exp2, 11 as u32, 0x93 as u32);
  let _ = buf_write_byte(exp2, 12 as u32, 0x0c as u32);
  let _ = buf_write_byte(exp2, 13 as u32, 0x3e as u32);
  let _ = buf_write_byte(exp2, 14 as u32, 0x60 as u32);
  let _ = buf_write_byte(exp2, 15 as u32, 0x39 as u32);
  let _ = buf_write_byte(exp2, 16 as u32, 0xa3 as u32);
  let _ = buf_write_byte(exp2, 17 as u32, 0x3c as u32);
  let _ = buf_write_byte(exp2, 18 as u32, 0xe4 as u32);
  let _ = buf_write_byte(exp2, 19 as u32, 0x59 as u32);
  let _ = buf_write_byte(exp2, 20 as u32, 0x64 as u32);
  let _ = buf_write_byte(exp2, 21 as u32, 0xff as u32);
  let _ = buf_write_byte(exp2, 22 as u32, 0x21 as u32);
  let _ = buf_write_byte(exp2, 23 as u32, 0x67 as u32);
  let _ = buf_write_byte(exp2, 24 as u32, 0xf6 as u32);
  let _ = buf_write_byte(exp2, 25 as u32, 0xec as u32);
  let _ = buf_write_byte(exp2, 26 as u32, 0xed as u32);
  let _ = buf_write_byte(exp2, 27 as u32, 0xd4 as u32);
  let _ = buf_write_byte(exp2, 28 as u32, 0x19 as u32);
  let _ = buf_write_byte(exp2, 29 as u32, 0xdb as u32);
  let _ = buf_write_byte(exp2, 30 as u32, 0x06 as u32);
  let _ = buf_write_byte(exp2, 31 as u32, 0xc1 as u32);
  if sha256_bytes_equal(out2, exp2, 32) == 0 { ok = 0; }

  let _ = uart_puts("CRYPTO: SHA-256 vs 3 NIST/FIPS-180-4 KATs (empty, \"abc\", 2-block)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Reads `byte_count` bytes' worth of hex-ASCII pairs (2 chars per
// byte, no separators) out of `hex` and writes the decoded bytes into
// `dst` -- lets a known-answer test vector be written as one compact
// string literal (vani string literals are valid `mut ref i64` byte
// buffers, same as every `shell_word_matches(line_buf, ..., "ping")`
// call already relies on) instead of one buf_write_byte call per byte
// the way sha256_self_test's own vectors above were written before
// this helper existed -- not retrofitted onto those to avoid
// unrelated churn, but used for every KAT this round adds.
fn write_hex_string(dst: mut ref i64, hex: Str, byte_count: i64) -> i64 {
  let i: i64 = 0;
  while i < byte_count {
    let hi: u32 = hex_ascii_to_nibble(str_byte_at(hex, i * 2) as u32);
    let lo: u32 = hex_ascii_to_nibble(str_byte_at(hex, (i * 2) + 1) as u32);
    let _ = buf_write_byte(dst, i as u32, (hi << (4 as u32)) | lo);
    i = i + 1;
  }
  return 0;
}

// Same "Str literal -> real mut ref i64 byte buffer" copy every
// dharafs_append/_write path call already does for path/data
// arguments -- needed here so plain string literals ("password",
// "Hi There", ...) can be handed to hmac_sha256/pbkdf2_hmac_sha256,
// which (like every other real crypto/network primitive in this
// codebase) operate on raw buffers, not the Str type shell-parsing
// code uses.
fn str_copy_to_buf(s: Str, out: mut ref i64) -> i64 {
  let n: i64 = str_len_bytes(s);
  let i: i64 = 0;
  while i < n {
    let _ = buf_write_byte(out, i as u32, str_byte_at(s, i) as u32);
    i = i + 1;
  }
  return 0;
}

// Real authentication's own crypto layer: HMAC-SHA256 (RFC 2104) on
// top of round 41's SHA-256, then PBKDF2-HMAC-SHA256 (RFC 8018) on top
// of that -- the "pragmatic choice... not a from-scratch Argon2 port"
// docs/TODO.md's own scoping note for this feature calls for.
//
// K' construction: keys longer than the 64-byte SHA-256 block size are
// hashed down to 32 bytes first (then zero-padded to 64); shorter keys
// are zero-padded directly -- both branches per RFC 2104 §2.
//
// msg_len is capped at 64 bytes by hmac_msg_scratch's own 128-byte size
// (64-byte pad block + msg) -- comfortably covers every real caller
// here (PBKDF2's own salt+4-byte-counter or bare 32-byte U values, and
// any real password), so this rejects rather than silently overflows
// scratch for anything larger, same "reject, don't guess" posture
// every other bounds check in this codebase already uses.
fn hmac_sha256(key: mut ref i64, key_len: i64, msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  if msg_len > 64 {
    return 0 - 1;
  }
  let key_block: mut ref i64 = hmac_key_block_ptr();
  let i: i64 = 0;
  if key_len > 64 {
    let _ = sha256_hash(key, key_len, key_block);
    i = 32;
  } else {
    while i < key_len {
      let _ = buf_write_byte(key_block, i as u32, buf_read_byte(key, i as u32));
      i = i + 1;
    }
  }
  while i < 64 {
    let _ = buf_write_byte(key_block, i as u32, 0 as u32);
    i = i + 1;
  }

  let msg_scratch: mut ref i64 = hmac_msg_scratch_ptr();
  i = 0;
  while i < 64 {
    let kb: u32 = buf_read_byte(key_block, i as u32);
    let _ = buf_write_byte(msg_scratch, i as u32, kb ^ (0x36 as u32));
    i = i + 1;
  }
  i = 0;
  while i < msg_len {
    let _ = buf_write_byte(msg_scratch, (64 + i) as u32, buf_read_byte(msg, i as u32));
    i = i + 1;
  }
  let inner_hash: mut ref i64 = hmac_inner_hash_ptr();
  let _ = sha256_hash(msg_scratch, 64 + msg_len, inner_hash);

  i = 0;
  while i < 64 {
    let kb2: u32 = buf_read_byte(key_block, i as u32);
    let _ = buf_write_byte(msg_scratch, i as u32, kb2 ^ (0x5c as u32));
    i = i + 1;
  }
  i = 0;
  while i < 32 {
    let _ = buf_write_byte(msg_scratch, (64 + i) as u32, buf_read_byte(inner_hash, i as u32));
    i = i + 1;
  }
  let _ = sha256_hash(msg_scratch, 96, out);
  return 0;
}

fn hmac_sha256_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Two RFC 4231/general-purpose HMAC-SHA256 known-answer vectors,
// independently verified against Python's own hmac/hashlib (not
// hand-derived, not copied from memory alone) before writing this
// test: a 20-byte all-0x0b key (RFC 4231 test case 1's own key shape)
// with an 8-byte message exercises the "key already <= block size"
// path; a 3-byte key with a 44-byte message exercises the same path
// with a longer message (both stay under hmac_sha256's own 64-byte
// msg_len cap). Neither exercises the "key > 64 bytes, hash it down
// first" branch -- that path is exactly SHA-256's own already-proven
// sha256_hash logic, re-verified indirectly by every other KAT in
// this file, not a new untested code path of its own.
fn hmac_sha256_self_test() -> i64 {
  let ok: i64 = 1;

  let key1: mut ref i64 = dhruva_alloc_bytes(20);
  let _ = write_hex_string(key1, "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", 20);
  let msg1: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = str_copy_to_buf("Hi There", msg1);
  let out1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = hmac_sha256(key1, 20, msg1, 8, out1);
  let exp1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = write_hex_string(exp1, "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", 32);
  if hmac_sha256_bytes_equal(out1, exp1, 32) == 0 { ok = 0; }

  let key2: mut ref i64 = dhruva_alloc_bytes(3);
  let _ = str_copy_to_buf("key", key2);
  let msg2: mut ref i64 = dhruva_alloc_bytes(43);
  let _ = str_copy_to_buf("The quick brown fox jumps over the lazy dog", msg2);
  let out2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = hmac_sha256(key2, 3, msg2, 43, out2);
  let exp2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = write_hex_string(exp2, "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", 32);
  if hmac_sha256_bytes_equal(out2, exp2, 32) == 0 { ok = 0; }

  let _ = uart_puts("CRYPTO: HMAC-SHA256 vs 2 KATs (RFC-4231-shaped key, longer message)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// PBKDF2-HMAC-SHA256 (RFC 8018 §5.2), specialized to dkLen == hLen ==
// 32 bytes (SHA-256's own output size) -- real authentication only
// ever needs exactly one 32-byte derived key, never a longer one, so
// this skips PBKDF2's general multi-block DK concatenation entirely:
// with dkLen == hLen there is exactly one block, T_1, and DK == T_1.
// T_1 = U_1 xor U_2 xor ... xor U_c, where U_1 = HMAC(password, salt ||
// INT_32_BE(1)) and U_i = HMAC(password, U_{i-1}) for i > 1.
//
// salt_len is capped at 32 bytes by pbkdf2_salt_ctr_scratch's own
// 36-byte size (32-byte salt + 4-byte block-index counter) --
// comfortably covers this project's own 16-byte salts.
fn pbkdf2_hmac_sha256(password: mut ref i64, password_len: i64, salt: mut ref i64, salt_len: i64, iterations: i64, out: mut ref i64) -> i64 {
  if salt_len > 32 {
    return 0 - 1;
  }
  let sc: mut ref i64 = pbkdf2_salt_ctr_ptr();
  let i: i64 = 0;
  while i < salt_len {
    let _ = buf_write_byte(sc, i as u32, buf_read_byte(salt, i as u32));
    i = i + 1;
  }
  let _ = buf_write_byte(sc, salt_len as u32, 0 as u32);
  let _ = buf_write_byte(sc, (salt_len + 1) as u32, 0 as u32);
  let _ = buf_write_byte(sc, (salt_len + 2) as u32, 0 as u32);
  let _ = buf_write_byte(sc, (salt_len + 3) as u32, 1 as u32);

  let u: mut ref i64 = pbkdf2_u_ptr();
  let _ = hmac_sha256(password, password_len, sc, salt_len + 4, u);

  let t: mut ref i64 = pbkdf2_t_ptr();
  i = 0;
  while i < 32 {
    let _ = buf_write_byte(t, i as u32, buf_read_byte(u, i as u32));
    i = i + 1;
  }

  let iter: i64 = 1;
  while iter < iterations {
    // Safe to alias msg==out==u here: hmac_sha256 fully copies msg into
    // its own persistent scratch before it ever writes a single byte
    // of `out` (see its own body -- the msg copy loop runs to
    // completion, THEN sha256_hash writes into `out` only at its very
    // end), so U_i overwriting the U_{i-1} it was computed from is not
    // a read-after-write hazard.
    let _ = hmac_sha256(password, password_len, u, 32, u);
    let j: i64 = 0;
    while j < 32 {
      let tb: u32 = buf_read_byte(t, j as u32);
      let ub: u32 = buf_read_byte(u, j as u32);
      let _ = buf_write_byte(t, j as u32, tb ^ ub);
      j = j + 1;
    }
    iter = iter + 1;
  }

  i = 0;
  while i < 32 {
    let _ = buf_write_byte(out, i as u32, buf_read_byte(t, i as u32));
    i = i + 1;
  }
  return 0;
}

// Three PBKDF2-HMAC-SHA256 known-answer vectors (independently
// verified against Python's own hashlib.pbkdf2_hmac, not hand-derived)
// -- iteration counts 1 and 2 exercise the "T = U1" and "T = U1 xor U2"
// shapes directly; 4096 is a real, commonly-cited PBKDF2 vector at a
// non-trivial iteration count, giving actual confidence the loop is
// correct at scale, not just for the first couple of steps.
fn pbkdf2_hmac_sha256_self_test() -> i64 {
  let ok: i64 = 1;
  let password: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = str_copy_to_buf("password", password);
  let salt: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = str_copy_to_buf("salt", salt);

  let out1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = pbkdf2_hmac_sha256(password, 8, salt, 4, 1, out1);
  let exp1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = write_hex_string(exp1, "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b", 32);
  if hmac_sha256_bytes_equal(out1, exp1, 32) == 0 { ok = 0; }

  let out2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = pbkdf2_hmac_sha256(password, 8, salt, 4, 2, out2);
  let exp2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = write_hex_string(exp2, "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43", 32);
  if hmac_sha256_bytes_equal(out2, exp2, 32) == 0 { ok = 0; }

  let out3: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = pbkdf2_hmac_sha256(password, 8, salt, 4, 4096, out3);
  let exp3: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = write_hex_string(exp3, "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a", 32);
  if hmac_sha256_bytes_equal(out3, exp3, 32) == 0 { ok = 0; }

  let _ = uart_puts("CRYPTO: PBKDF2-HMAC-SHA256 vs 3 KATs (iterations=1,2,4096)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// PBKDF2-HMAC-SHA256 iteration count for real authentication.
//
// Round 68 (2026-09-04): raised 200 -> 20000, now that the bug that
// used to force 200 is fixed (root-caused: irq_entry.S's saved-lr/
// resume-pc conflation, see that file's own header comment and this
// round's docs/TODO.md writeup) and closed (verified two independent
// ways: a 190-boot black-box reproduction sweep, and a direct re-run
// of round 63's own scoped hardware-watchpoint check -- 56,708
// sha256_compress calls, zero hits). 200 was never a security/
// usability tradeoff -- it was the ceiling that bug left standing.
//
// 20000 IS a genuine, deliberate tradeoff, chosen from real measured
// numbers on this exact target (arm1176jzf-s under QEMU's raspi1ap,
// no hardware SHA acceleration), not copied from guidance written for
// different hardware. OWASP's current PBKDF2-HMAC-SHA256 minimum
// (600,000+) was measured directly on this build and would cost
// several minutes per `passwd`/`su` call -- not a usable interactive
// command at any plausible real-hardware speedup from this QEMU
// timing. Measured live (steady-state `su`, i.e. NOT including the
// one-time cost of the shell itself finishing boot):
//   200      ~0.95s  (the old, bug-limited value)
//   10,000   ~6.5s   (already proven safe -- this exact count is what
//                      dharafs_crypto_key_init runs every single boot,
//                      single-threaded, media-encryption key derivation)
//   20,000   ~12.8s  (THIS value)
//   100,000  ~60.3s  (also tested clean, zero crashes -- confirms the
//                      round-68 fix holds under sustained, non-yielding
//                      synchronous computation, not just short bursts --
//                      rejected purely on interactive-latency grounds)
// Throughput converges to a clean, predictable ~1550-1650 iterations/
// sec once fixed per-command overhead (shell dispatch latency, task_f's
// own poll granularity) is amortized -- confirmed via three separate
// measured points, not assumed linear from one.
//
// 20,000 is a real, historically-recognized "strong" PBKDF2 iteration
// count (matches NIST SP 800-132's long-cited minimum recommendation,
// and was standard industry practice for years before OWASP's 2023
// escalation to 600,000) -- a 100x improvement over the old 200, at a
// latency (~13s) for a rare, deliberate, security-sensitive operation
// (changing or verifying a password) that doesn't read as "the device
// hung." Not the theoretical maximum available (100,000 tested clean
// too, for anyone revisiting this tradeoff later with a higher latency
// budget), but a real, defensible, measured choice for THIS hardware,
// not an aspirational number this target can't actually deliver.
fn pbkdf2_auth_iterations() -> i64 {
  return 20000;
}

// Real authentication's own small helpers: find/allocate a user
// table slot, compare a raw buffer against a Str (for the weak-
// password blocklist), and the blocklist check itself.
fn auth_find_slot(uid: u32) -> i64 {
  let i: u32 = 0 as u32;
  while i < (8 as u32) {
    if auth_get_uid(i) == uid {
      return i as i64;
    }
    i = i + (1 as u32);
  }
  return 0 - 1;
}

fn auth_find_free_slot() -> i64 {
  let i: u32 = 0 as u32;
  while i < (8 as u32) {
    if auth_get_uid(i) == (0xFFFFFFFF as u32) {
      return i as i64;
    }
    i = i + (1 as u32);
  }
  return 0 - 1;
}

fn buf_equals_str(buf: mut ref i64, buf_len: i64, s: Str) -> i64 {
  let slen: i64 = str_len_bytes(s);
  if buf_len != slen {
    return 0;
  }
  let i: i64 = 0;
  while i < slen {
    if buf_read_byte(buf, i as u32) != (str_byte_at(s, i) as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// NIST SP 800-63B: length matters more than character-class
// complexity (minimum 8 here), checked against a small known-weak
// blocklist. A REPRESENTATIVE small sample (not the "few hundred
// entries" the TODO's own scoping note suggests would be meaningful
// for a real deployment) -- demonstrating the mechanism honestly
// within this round's own scope, not claiming production-grade
// coverage. Every entry is itself >= 8 characters so the length check
// above doesn't make them redundant.
fn auth_is_weak_password(pw: mut ref i64, pw_len: i64) -> i64 {
  if pw_len < 8 {
    return 1;
  }
  if buf_equals_str(pw, pw_len, "password") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "12345678") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "qwertyui") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "letmein1") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "changeme") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "admin123") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "welcome1") == 1 { return 1; }
  if buf_equals_str(pw, pw_len, "iloveyou") == 1 { return 1; }
  return 0;
}

// Failed-attempt rate limiting: 3 strikes locks the account for 20
// ticks (10s at this project's 500ms tick). Per-slot, not global --
// see boot/auth_state.S's own file comment on why a lockout on one
// user must not also block a different user.
fn auth_lockout_ticks() -> u32 {
  return 20 as u32;
}
fn auth_max_fail_attempts() -> u32 {
  return 3 as u32;
}

// Round 44: ChaCha20 (RFC 8439). Round 102 migrated this to the
// shared `chacha20_poly1305` kosh package (the only crypto primitive
// in this project's generification roadmap with no Pi 4/5-side
// counterpart to extract from -- built fresh from this file's own
// original implementation instead, round 101).
//
// chacha20_bytes_equal below is untouched -- a generic byte-buffer
// comparator with no dependency on ChaCha20 itself, same reasoning as
// sha256_bytes_equal's own comment.
//
// Deleted entirely (now living in vani-chacha20-poly1305 instead):
// chacha20_rotl32, chacha20_quarter_round, chacha20_block, the old
// scratch-based chacha20_encrypt, poly1305_read_u32_le/write_u32_le,
// poly1305_mac, poly1305_verify_constant_time, and chacha20_poly1305_
// build_mac_data/encrypt/decrypt (all replaced by `_heap`-suffixed
// adapters further down calling the package's own streaming
// primitives -- Pi 1's real TLS records, up to 2048 bytes, exceed the
// package's own 512-byte one-shot convenience-layer cap, so the
// adapters use `chacha20_xor_chunk`/`Poly1305Ctx` directly rather
// than the package's own capped `chacha20_encrypt`/`poly1305_mac`).
use "../vendor/chacha20_poly1305/src/core.vani";


fn chacha20_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Round 67's own Poly1305 (RFC 8439 section 2.5) implementation --
// poly1305_read_u32_le/write_u32_le, poly1305_mac, and
// poly1305_verify_constant_time -- now lives in the `chacha20_
// poly1305` package instead (see the `use` above this file's own
// chacha20_bytes_equal, and this file's `_heap` adapters further
// down).



// Round 99 -- SHA-512 migrated to the shared `crypto_hash` kosh
// package too, in the SAME pass as SHA-256 above: `use`-including the
// package pulls in its sha512_* functions right alongside its
// sha256_* ones (they're one package), so this file's own separate
// sha512_hash/sha512_compress/etc. would collide with the package's
// identically-named functions regardless of whether SHA-512 itself
// was in scope for this round -- migrating both together was the
// only option once SHA-256 needed the package at all. Same adapter
// shape as sha256_hash above: the package's own core is fixed-array/
// heap-free; this thin wrapper bridges this file's heap-pointer
// (`mut ref i64`) call sites by looping the message through the
// package's streaming `[u8; 256]`-chunk API. Every one of this
// file's existing sha512_hash call sites (Ed25519's own secret-
// expand/sign/verify, the self-test) keeps its exact signature.
//
// sha512_bytes_equal below is untouched, same reasoning as
// sha256_bytes_equal's own comment.
//
// Deleted entirely (now living in vani-crypto-hash instead):
// sha512_rotr64, sha512_read_u64, sha512_write_u64,
// sha512_write_u64_val, sha512_read_be64, sha512_write_be64,
// sha512_k_init, sha512_h_init, sha512_compress, and the old
// scratch-based sha512_hash body. sha512_k_init's own boot-time
// allocation call was also removed from this file's own boot-time
// init sequence (see that call site's own comment).
fn sha512_hash(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  let ctx: Sha512Ctx = sha512_init();
  let offset: i64 = 0;
  while offset < msg_len {
    let remaining: i64 = msg_len - offset;
    let chunk_n: i64 = if remaining < 256 { remaining } else { 256 };
    let chunk: [u8; 256] = zero256_bytes();
    let i: i64 = 0;
    while i < chunk_n {
      chunk[i] = buf_read_byte(msg, (offset + i) as u32) as u8;
      i = i + 1;
    }
    ctx = sha512_update(ref ctx, mut ref chunk, chunk_n);
    offset = offset + chunk_n;
  }
  let digest: [u8; 64] = sha512_finalize(ref ctx);
  let j: i64 = 0;
  while j < 64 {
    let _ = buf_write_byte(out, j as u32, digest[j] as u32);
    j = j + 1;
  }
  return 0;
}

fn sha512_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Round 100 -- Ed25519 migrated to the shared `curve25519` kosh
// package (see project memory project_dhruva_round100_pi1_curve25519_
// migration and project_dhruva_generic_crypto_packages_x509_scope).
// Deleted this file's own ~700-line hand-rolled point-arithmetic
// implementation (ed25519_get_bit_lsb_first/msb_first, scalar_mod_l_
// raw, scalar_add_mod_l, scalar_mul_mod_l, point_add, point_mul,
// point_equal, sqrt_candidate, point_compress, recover_x,
// point_decompress, secret_expand -- all internal-only, zero external
// callers) -- see kernel_main.vani's own git history if that
// algorithm-level detail is ever needed again, it isn't lost, just
// not duplicated here anymore. `ed25519_init` (the persistent d/2d/
// sqrt_m1/L/G constant setup) is gone too -- the package's own
// constants are compile-time literals, no init step at all.
//
// Kept as `_heap`-suffixed adapters (bridging this file's heap-
// pointer `mut ref i64` callers to the package's fixed-array API) --
// NOT reusing the original names directly, because `use`'s flat
// namespace (the BUG-234 workaround, same as round 99's SHA
// migration) would collide with the package's own identically-named
// `ed25519_secret_to_public`/`sign`/`verify`. Every external caller
// (PKI's own pki_verify_raw, 3 TLS server-identity blocks) updated to
// the new names -- see those call sites' own diffs. `ed25519_self_
// test` itself keeps its ORIGINAL name unchanged -- `core.vani` (the
// primitives-only variant this file `use`s, see below) deliberately
// excludes its own same-named self-test, so there's no collision.
//
// The package's own `ed25519_sign`/`verify` cap `msg` at 512 bytes
// (a practical stack-buffer size; hashing itself has no length cap,
// it streams -- see curve25519's own `ed25519_hash_2block_msg`).
// Comfortably covers every real caller here (TLS 1.3's own
// CertificateVerify signed-content is a fixed 130 bytes) with
// generous headroom, well under this file's own OLD 4096-byte
// theoretical ceiling that no real caller ever approached.
use "../vendor/curve25519/src/core.vani";

fn ed25519_secret_to_public_heap(secret: mut ref i64, out_pub: mut ref i64) -> i64 {
  let secret_arr: [u8; 32] = ed25519_zero32_bytes();
  let i: i64 = 0;
  while i < 32 {
    secret_arr[i] = buf_read_byte(secret, i as u32) as u8;
    i = i + 1;
  }
  let pub_arr: [u8; 32] = ed25519_secret_to_public(ref secret_arr);
  let j: i64 = 0;
  while j < 32 {
    let _ = buf_write_byte(out_pub, j as u32, pub_arr[j] as u32);
    j = j + 1;
  }
  return 0;
}

fn ed25519_sign_heap(secret: mut ref i64, msg: mut ref i64, msg_len: i64, out_sig: mut ref i64) -> i64 {
  let secret_arr: [u8; 32] = ed25519_zero32_bytes();
  let i: i64 = 0;
  while i < 32 {
    secret_arr[i] = buf_read_byte(secret, i as u32) as u8;
    i = i + 1;
  }
  let msg_arr: [u8; 512] = ed25519_zero512_bytes();
  let mi: i64 = 0;
  while mi < msg_len {
    msg_arr[mi] = buf_read_byte(msg, mi as u32) as u8;
    mi = mi + 1;
  }
  let sig_arr: [u8; 64] = ed25519_sign(ref secret_arr, ref msg_arr, msg_len);
  let j: i64 = 0;
  while j < 64 {
    let _ = buf_write_byte(out_sig, j as u32, sig_arr[j] as u32);
    j = j + 1;
  }
  return 0;
}

fn ed25519_verify_heap(pubkey: mut ref i64, msg: mut ref i64, msg_len: i64, sig: mut ref i64) -> i64 {
  let pubkey_arr: [u8; 32] = ed25519_zero32_bytes();
  let i: i64 = 0;
  while i < 32 {
    pubkey_arr[i] = buf_read_byte(pubkey, i as u32) as u8;
    i = i + 1;
  }
  let msg_arr: [u8; 512] = ed25519_zero512_bytes();
  let mi: i64 = 0;
  while mi < msg_len {
    msg_arr[mi] = buf_read_byte(msg, mi as u32) as u8;
    mi = mi + 1;
  }
  let sig_arr: [u8; 64] = ed25519_zero64_bytes();
  let si: i64 = 0;
  while si < 64 {
    sig_arr[si] = buf_read_byte(sig, si as u32) as u8;
    si = si + 1;
  }
  return ed25519_verify(ref pubkey_arr, ref msg_arr, msg_len, ref sig_arr);
}

// RFC 8032-shaped known-answer check reusing a real, independently-
// verified (cryptography library) run -- same discipline as X25519's
// own self-test, for the same reason (a 32/64-byte value is exactly
// the kind of thing a memorized transcription could silently corrupt
// with no way to notice; this project's own derivation/verification
// script is the source of truth, not memory). seed is deliberately
// the trivial 0,1,2,...,31 sequence -- easy to eyeball-verify nothing
// got mixed up between this file and the script that generated it.
fn ed25519_self_test() -> i64 {
  let ok: i64 = 1;

  let seed: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(seed, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(seed, 1 as u32, 0x01 as u32);
  let _ = buf_write_byte(seed, 2 as u32, 0x02 as u32);
  let _ = buf_write_byte(seed, 3 as u32, 0x03 as u32);
  let _ = buf_write_byte(seed, 4 as u32, 0x04 as u32);
  let _ = buf_write_byte(seed, 5 as u32, 0x05 as u32);
  let _ = buf_write_byte(seed, 6 as u32, 0x06 as u32);
  let _ = buf_write_byte(seed, 7 as u32, 0x07 as u32);
  let _ = buf_write_byte(seed, 8 as u32, 0x08 as u32);
  let _ = buf_write_byte(seed, 9 as u32, 0x09 as u32);
  let _ = buf_write_byte(seed, 10 as u32, 0x0a as u32);
  let _ = buf_write_byte(seed, 11 as u32, 0x0b as u32);
  let _ = buf_write_byte(seed, 12 as u32, 0x0c as u32);
  let _ = buf_write_byte(seed, 13 as u32, 0x0d as u32);
  let _ = buf_write_byte(seed, 14 as u32, 0x0e as u32);
  let _ = buf_write_byte(seed, 15 as u32, 0x0f as u32);
  let _ = buf_write_byte(seed, 16 as u32, 0x10 as u32);
  let _ = buf_write_byte(seed, 17 as u32, 0x11 as u32);
  let _ = buf_write_byte(seed, 18 as u32, 0x12 as u32);
  let _ = buf_write_byte(seed, 19 as u32, 0x13 as u32);
  let _ = buf_write_byte(seed, 20 as u32, 0x14 as u32);
  let _ = buf_write_byte(seed, 21 as u32, 0x15 as u32);
  let _ = buf_write_byte(seed, 22 as u32, 0x16 as u32);
  let _ = buf_write_byte(seed, 23 as u32, 0x17 as u32);
  let _ = buf_write_byte(seed, 24 as u32, 0x18 as u32);
  let _ = buf_write_byte(seed, 25 as u32, 0x19 as u32);
  let _ = buf_write_byte(seed, 26 as u32, 0x1a as u32);
  let _ = buf_write_byte(seed, 27 as u32, 0x1b as u32);
  let _ = buf_write_byte(seed, 28 as u32, 0x1c as u32);
  let _ = buf_write_byte(seed, 29 as u32, 0x1d as u32);
  let _ = buf_write_byte(seed, 30 as u32, 0x1e as u32);
  let _ = buf_write_byte(seed, 31 as u32, 0x1f as u32);

  let msg_str: Str = "Dhruva Ed25519 test message";
  let msg_len: i64 = str_len_bytes(msg_str);
  let msg: mut ref i64 = dhruva_alloc_bytes(msg_len);
  let mi: i64 = 0;
  while mi < msg_len {
    let _ = buf_write_byte(msg, mi as u32, str_byte_at(msg_str, mi) as u32);
    mi = mi + 1;
  }

  let expected_pub: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(expected_pub, 0 as u32, 0x03 as u32);
  let _ = buf_write_byte(expected_pub, 1 as u32, 0xa1 as u32);
  let _ = buf_write_byte(expected_pub, 2 as u32, 0x07 as u32);
  let _ = buf_write_byte(expected_pub, 3 as u32, 0xbf as u32);
  let _ = buf_write_byte(expected_pub, 4 as u32, 0xf3 as u32);
  let _ = buf_write_byte(expected_pub, 5 as u32, 0xce as u32);
  let _ = buf_write_byte(expected_pub, 6 as u32, 0x10 as u32);
  let _ = buf_write_byte(expected_pub, 7 as u32, 0xbe as u32);
  let _ = buf_write_byte(expected_pub, 8 as u32, 0x1d as u32);
  let _ = buf_write_byte(expected_pub, 9 as u32, 0x70 as u32);
  let _ = buf_write_byte(expected_pub, 10 as u32, 0xdd as u32);
  let _ = buf_write_byte(expected_pub, 11 as u32, 0x18 as u32);
