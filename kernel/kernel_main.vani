  let _ = buf_write_byte(expected_ct, 32 as u32, 0x83 as u32);
  let _ = buf_write_byte(expected_ct, 33 as u32, 0xe1 as u32);
  let _ = buf_write_byte(expected_ct, 34 as u32, 0x48 as u32);
  let _ = buf_write_byte(expected_ct, 35 as u32, 0xdf as u32);
  let _ = buf_write_byte(expected_ct, 36 as u32, 0xc6 as u32);
  let _ = buf_write_byte(expected_ct, 37 as u32, 0x7b as u32);
  let _ = buf_write_byte(expected_ct, 38 as u32, 0xc9 as u32);
  let _ = buf_write_byte(expected_ct, 39 as u32, 0xfd as u32);
  let _ = buf_write_byte(expected_ct, 40 as u32, 0x45 as u32);
  let _ = buf_write_byte(expected_ct, 41 as u32, 0x51 as u32);
  let _ = buf_write_byte(expected_ct, 42 as u32, 0x1f as u32);
  let _ = buf_write_byte(expected_ct, 43 as u32, 0xab as u32);
  let _ = buf_write_byte(expected_ct, 44 as u32, 0x0c as u32);
  let _ = buf_write_byte(expected_ct, 45 as u32, 0xfa as u32);
  let _ = buf_write_byte(expected_ct, 46 as u32, 0xe8 as u32);
  let _ = buf_write_byte(expected_ct, 47 as u32, 0x03 as u32);
  let _ = buf_write_byte(expected_ct, 48 as u32, 0x0a as u32);
  let _ = buf_write_byte(expected_ct, 49 as u32, 0xec as u32);
  let _ = buf_write_byte(expected_ct, 50 as u32, 0xcc as u32);
  let _ = buf_write_byte(expected_ct, 51 as u32, 0x54 as u32);
  let _ = buf_write_byte(expected_ct, 52 as u32, 0x8d as u32);
  let _ = buf_write_byte(expected_ct, 53 as u32, 0x49 as u32);
  let _ = buf_write_byte(expected_ct, 54 as u32, 0xdc as u32);
  let _ = buf_write_byte(expected_ct, 55 as u32, 0xaa as u32);
  let _ = buf_write_byte(expected_ct, 56 as u32, 0x24 as u32);
  let _ = buf_write_byte(expected_ct, 57 as u32, 0x98 as u32);
  let _ = buf_write_byte(expected_ct, 58 as u32, 0xbb as u32);
  let _ = buf_write_byte(expected_ct, 59 as u32, 0x68 as u32);
  let _ = buf_write_byte(expected_ct, 60 as u32, 0xe5 as u32);
  let _ = buf_write_byte(expected_ct, 61 as u32, 0x21 as u32);
  let _ = buf_write_byte(expected_ct, 62 as u32, 0xfa as u32);
  let _ = buf_write_byte(expected_ct, 63 as u32, 0xb7 as u32);
  let _ = buf_write_byte(expected_ct, 64 as u32, 0x0b as u32);
  let _ = buf_write_byte(expected_ct, 65 as u32, 0x01 as u32);
  let _ = buf_write_byte(expected_ct, 66 as u32, 0x9c as u32);
  let _ = buf_write_byte(expected_ct, 67 as u32, 0xb9 as u32);
  let _ = buf_write_byte(expected_ct, 68 as u32, 0x8a as u32);
  let _ = buf_write_byte(expected_ct, 69 as u32, 0x7b as u32);
  let _ = buf_write_byte(expected_ct, 70 as u32, 0x0d as u32);
  let expected_tag: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(expected_tag, 0 as u32, 0xaa as u32);
  let _ = buf_write_byte(expected_tag, 1 as u32, 0x2c as u32);
  let _ = buf_write_byte(expected_tag, 2 as u32, 0x8c as u32);
  let _ = buf_write_byte(expected_tag, 3 as u32, 0xed as u32);
  let _ = buf_write_byte(expected_tag, 4 as u32, 0x9c as u32);
  let _ = buf_write_byte(expected_tag, 5 as u32, 0xf4 as u32);
  let _ = buf_write_byte(expected_tag, 6 as u32, 0xb0 as u32);
  let _ = buf_write_byte(expected_tag, 7 as u32, 0x6d as u32);
  let _ = buf_write_byte(expected_tag, 8 as u32, 0xc3 as u32);
  let _ = buf_write_byte(expected_tag, 9 as u32, 0x85 as u32);
  let _ = buf_write_byte(expected_tag, 10 as u32, 0x27 as u32);
  let _ = buf_write_byte(expected_tag, 11 as u32, 0x4f as u32);
  let _ = buf_write_byte(expected_tag, 12 as u32, 0x52 as u32);
  let _ = buf_write_byte(expected_tag, 13 as u32, 0x06 as u32);
  let _ = buf_write_byte(expected_tag, 14 as u32, 0x5e as u32);
  let _ = buf_write_byte(expected_tag, 15 as u32, 0x11 as u32);

  let out_ct: mut ref i64 = dhruva_alloc_bytes(plaintext_len);
  let out_tag: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = chacha20_poly1305_encrypt_heap(key, nonce, aad, 6, plaintext, plaintext_len, out_ct, out_tag);
  if chacha20_bytes_equal(out_ct, expected_ct, plaintext_len) == 0 {
    ok = 0;
  }
  if chacha20_bytes_equal(out_tag, expected_tag, 16) == 0 {
    ok = 0;
  }

  // Decrypt round trip: the real ciphertext+tag must decrypt back to
  // the original plaintext.
  let out_pt: mut ref i64 = dhruva_alloc_bytes(plaintext_len);
  let dec_status: i64 = chacha20_poly1305_decrypt_heap(key, nonce, aad, 6, out_ct, plaintext_len, out_tag, out_pt);
  if dec_status != 0 {
    ok = 0;
  }
  if chacha20_bytes_equal(out_pt, plaintext, plaintext_len) == 0 {
    ok = 0;
  }

  // A tampered ciphertext must fail tag verification and NOT decrypt.
  let bad_ct: mut ref i64 = dhruva_alloc_bytes(plaintext_len);
  let bi: i64 = 0;
  while bi < plaintext_len {
    let _ = buf_write_byte(bad_ct, bi as u32, buf_read_byte(out_ct, bi as u32));
    bi = bi + 1;
  }
  let _ = buf_write_byte(bad_ct, 0 as u32, buf_read_byte(bad_ct, 0 as u32) ^ (1 as u32));
  let bad_out_pt: mut ref i64 = dhruva_alloc_bytes(plaintext_len);
  let bad_dec_status: i64 = chacha20_poly1305_decrypt_heap(key, nonce, aad, 6, bad_ct, plaintext_len, out_tag, bad_out_pt);
  if bad_dec_status == 0 {
    ok = 0; // tampered ciphertext must NOT verify
  }

  // HKDF
  let salt: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(salt, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(salt, 1 as u32, 0x01 as u32);
  let _ = buf_write_byte(salt, 2 as u32, 0x02 as u32);
