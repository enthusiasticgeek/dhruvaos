  let _ = buf_write_byte(expected1, 18 as u32, 0xbd as u32);
  let _ = buf_write_byte(expected1, 19 as u32, 0x16 as u32);
  let _ = buf_write_byte(expected1, 20 as u32, 0x19 as u32);
  let _ = buf_write_byte(expected1, 21 as u32, 0x9f as u32);
  let _ = buf_write_byte(expected1, 22 as u32, 0x97 as u32);
  let _ = buf_write_byte(expected1, 23 as u32, 0x76 as u32);
  let _ = buf_write_byte(expected1, 24 as u32, 0x26 as u32);
  let _ = buf_write_byte(expected1, 25 as u32, 0x26 as u32);
  let _ = buf_write_byte(expected1, 26 as u32, 0x82 as u32);
  let _ = buf_write_byte(expected1, 27 as u32, 0x42 as u32);
  let _ = buf_write_byte(expected1, 28 as u32, 0x05 as u32);
  let _ = buf_write_byte(expected1, 29 as u32, 0xe1 as u32);
  let _ = buf_write_byte(expected1, 30 as u32, 0x7f as u32);
  let _ = buf_write_byte(expected1, 31 as u32, 0x69 as u32);

  let out1: mut ref i64 = dhruva_alloc_bytes(32);
  let k_copy1: mut ref i64 = dhruva_alloc_bytes(32);
  let ci: i64 = 0;
  while ci < 32 {
    let _ = buf_write_byte(k_copy1, ci as u32, buf_read_byte(k, ci as u32));
    ci = ci + 1;
  }
  let _ = x25519_scalarmult_heap(k_copy1, basepoint, out1);
  if chacha20_bytes_equal(out1, expected1, 32) == 0 {
    ok = 0;
  }

  // Test 2: arbitrary u-coordinate multiplication (the other party's
  // own public key), i.e. the actual DH agreement step -- same k,
  // different u-coordinate and expected output, from the same
  // verified run.
  let u2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(u2, 0 as u32, 0x20 as u32);
  let _ = buf_write_byte(u2, 1 as u32, 0xc9 as u32);
  let _ = buf_write_byte(u2, 2 as u32, 0xb8 as u32);
  let _ = buf_write_byte(u2, 3 as u32, 0x13 as u32);
  let _ = buf_write_byte(u2, 4 as u32, 0x92 as u32);
  let _ = buf_write_byte(u2, 5 as u32, 0xa4 as u32);
  let _ = buf_write_byte(u2, 6 as u32, 0x6b as u32);
  let _ = buf_write_byte(u2, 7 as u32, 0x37 as u32);
  let _ = buf_write_byte(u2, 8 as u32, 0xd9 as u32);
  let _ = buf_write_byte(u2, 9 as u32, 0xa5 as u32);
  let _ = buf_write_byte(u2, 10 as u32, 0xd5 as u32);
  let _ = buf_write_byte(u2, 11 as u32, 0xc1 as u32);
  let _ = buf_write_byte(u2, 12 as u32, 0xf5 as u32);
  let _ = buf_write_byte(u2, 13 as u32, 0x73 as u32);
  let _ = buf_write_byte(u2, 14 as u32, 0x7c as u32);
  let _ = buf_write_byte(u2, 15 as u32, 0xca as u32);
  let _ = buf_write_byte(u2, 16 as u32, 0x4f as u32);
  let _ = buf_write_byte(u2, 17 as u32, 0xc9 as u32);
  let _ = buf_write_byte(u2, 18 as u32, 0x71 as u32);
  let _ = buf_write_byte(u2, 19 as u32, 0x21 as u32);
  let _ = buf_write_byte(u2, 20 as u32, 0x89 as u32);
  let _ = buf_write_byte(u2, 21 as u32, 0xc0 as u32);
  let _ = buf_write_byte(u2, 22 as u32, 0xf1 as u32);
  let _ = buf_write_byte(u2, 23 as u32, 0x84 as u32);
  let _ = buf_write_byte(u2, 24 as u32, 0x23 as u32);
  let _ = buf_write_byte(u2, 25 as u32, 0x35 as u32);
  let _ = buf_write_byte(u2, 26 as u32, 0xec as u32);
  let _ = buf_write_byte(u2, 27 as u32, 0x89 as u32);
  let _ = buf_write_byte(u2, 28 as u32, 0xbd as u32);
  let _ = buf_write_byte(u2, 29 as u32, 0xeb as u32);
  let _ = buf_write_byte(u2, 30 as u32, 0xca as u32);
  let _ = buf_write_byte(u2, 31 as u32, 0x0d as u32);

  let expected2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(expected2, 0 as u32, 0x12 as u32);
  let _ = buf_write_byte(expected2, 1 as u32, 0x8e as u32);
  let _ = buf_write_byte(expected2, 2 as u32, 0x3d as u32);
  let _ = buf_write_byte(expected2, 3 as u32, 0x71 as u32);
  let _ = buf_write_byte(expected2, 4 as u32, 0x61 as u32);
  let _ = buf_write_byte(expected2, 5 as u32, 0x9e as u32);
  let _ = buf_write_byte(expected2, 6 as u32, 0x52 as u32);
  let _ = buf_write_byte(expected2, 7 as u32, 0x72 as u32);
  let _ = buf_write_byte(expected2, 8 as u32, 0x04 as u32);
  let _ = buf_write_byte(expected2, 9 as u32, 0x99 as u32);
  let _ = buf_write_byte(expected2, 10 as u32, 0x1f as u32);
  let _ = buf_write_byte(expected2, 11 as u32, 0x8a as u32);
  let _ = buf_write_byte(expected2, 12 as u32, 0x5c as u32);
  let _ = buf_write_byte(expected2, 13 as u32, 0x80 as u32);
  let _ = buf_write_byte(expected2, 14 as u32, 0x68 as u32);
  let _ = buf_write_byte(expected2, 15 as u32, 0x2d as u32);
  let _ = buf_write_byte(expected2, 16 as u32, 0x74 as u32);
  let _ = buf_write_byte(expected2, 17 as u32, 0xea as u32);
  let _ = buf_write_byte(expected2, 18 as u32, 0xa2 as u32);
  let _ = buf_write_byte(expected2, 19 as u32, 0xda as u32);
  let _ = buf_write_byte(expected2, 20 as u32, 0x8a as u32);
  let _ = buf_write_byte(expected2, 21 as u32, 0xde as u32);
  let _ = buf_write_byte(expected2, 22 as u32, 0x5c as u32);
  let _ = buf_write_byte(expected2, 23 as u32, 0xcc as u32);
  let _ = buf_write_byte(expected2, 24 as u32, 0xaa as u32);
  let _ = buf_write_byte(expected2, 25 as u32, 0xdb as u32);
  let _ = buf_write_byte(expected2, 26 as u32, 0x7a as u32);
  let _ = buf_write_byte(expected2, 27 as u32, 0xfa as u32);
  let _ = buf_write_byte(expected2, 28 as u32, 0xc3 as u32);
  let _ = buf_write_byte(expected2, 29 as u32, 0xcc as u32);
  let _ = buf_write_byte(expected2, 30 as u32, 0xc6 as u32);
  let _ = buf_write_byte(expected2, 31 as u32, 0x66 as u32);

  let out2: mut ref i64 = dhruva_alloc_bytes(32);
  let k_copy2: mut ref i64 = dhruva_alloc_bytes(32);
  let di: i64 = 0;
  while di < 32 {
    let _ = buf_write_byte(k_copy2, di as u32, buf_read_byte(k, di as u32));
    di = di + 1;
  }
  let _ = x25519_scalarmult_heap(k_copy2, u2, out2);
  if chacha20_bytes_equal(out2, expected2, 32) == 0 {
    ok = 0;
  }

  let _ = uart_puts("CRYPTO: X25519 vs a real, independently-verified reference (base-point + DH agreement)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Early-warning canary for the exact heap-exhaustion bug class this
// project has now hit twice (once in dharafs_compact's own per-pass leak,
// once in round 10's DHCP self-tests tipping total boot-time usage
// over the top -- see runtime_stubs.c's own dhruva_alloc_bytes comment
// for that second incident's full story). Every dhruva_alloc_bytes
// call so far in kernel_main (every scratch buffer, every task stack)
// has already happened by the time this runs, but task_e's own first-
// run setup (gc_buf/compact_buf/compact_path_buf/compact_data_buf,
// ~1520 bytes) and any other task's own one-time first-run allocations
// haven't yet -- so this checks for real headroom beyond what's
// already used, not just "did we not crash yet". Graded, not just
// informational: a future round adding enough self-test buffers to
// eat into this margin gets a loud, specific self-test FAILURE at
// boot instead of a silent reboot loop that only phase4_milestone.py
// (or worse, nothing) happens to notice.
fn heap_usage_self_test() -> i64 {
  let used: i64 = dhruva_heap_used_bytes();
  let capacity: i64 = 786432; // DHRUVA_HEAP_BYTES, runtime_stubs.c (round 68: 256KB -> 768KB)
  let headroom: i64 = capacity - used;
  let min_headroom: i64 = 16384; // generous margin for future rounds
  let _ = uart_puts("HEAP: used=");
  let _ = uart_put_i64(used);
  let _ = uart_puts(" capacity=");
  let _ = uart_put_i64(capacity);
  let _ = uart_puts(" headroom=");
  let _ = uart_put_i64(headroom);
  if headroom >= min_headroom {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expect headroom >= 16384)\n");
  }
  return 0;
}

#[no_mangle]
fn kernel_main() -> i64 {
  let _ = uart_init();
  let _ = uart_puts("Dhruva Phase 2: fixed-priority scheduling + priority ceiling\n");

  // Shared, persistent scratch buffers for the FS layer, shell
  // dispatch, eval, and uart_put_i64 -- allocated exactly once, here,
  // before anything that uses them ever runs. See scratch_state.S's
  // own doc comment for why these exist and why sharing them across
  // call sites is safe.
  let _ = dharafs_sd_scratch_set(dhruva_alloc_bytes(512));
  let _ = dharafs_path_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_data_scratch_set(dhruva_alloc_bytes(4096));
  let _ = dharafs_stat_scratch_set(dhruva_alloc_bytes(12));
  let _ = dharafs_dir_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_log_path_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_log_header_path_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_log_header_data_scratch_set(dhruva_alloc_bytes(8));
  let _ = dharafs_log_existing_scratch_set(dhruva_alloc_bytes(4096));
  let _ = dharafs_log_combined_scratch_set(dhruva_alloc_bytes(4096));
  let _ = dharafs_verified_companion_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_verified_digest_a_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_verified_digest_b_scratch_set(dhruva_alloc_bytes(32));
  let _ = dharafs_appendonly_check_scratch_set(dhruva_alloc_bytes(4096));
  let _ = dharafs_rename_new_path_scratch_set(dhruva_alloc_bytes(32));
  let _ = gatt_send_scratch_set(dhruva_alloc_bytes(256));
  let _ = gatt_recv_scratch_set(dhruva_alloc_bytes(256));
  let _ = shell_my_mac_scratch_set(dhruva_alloc_bytes(8));
  let _ = shell_ping_dst_mac_scratch_set(dhruva_alloc_bytes(8));
  let _ = shell_ping_payload_scratch_set(dhruva_alloc_bytes(4));
  let _ = shell_ping_recv_payload_scratch_set(dhruva_alloc_bytes(4));
  let _ = shell_ping_recv_meta_scratch_set(dhruva_alloc_bytes(8));
  let _ = shell_tcpecho_payload_scratch_set(dhruva_alloc_bytes(64));
  let _ = shell_tcp_poll_scratch_set(dhruva_alloc_bytes(512));
  let _ = shell_tcpecho_recv_payload_scratch_set(dhruva_alloc_bytes(64));
  let _ = shell_udpecho_payload_scratch_set(dhruva_alloc_bytes(64));
  let _ = shell_udpecho_recv_payload_scratch_set(dhruva_alloc_bytes(64));
  let _ = shell_udpecho_recv_meta_scratch_set(dhruva_alloc_bytes(8));
  let _ = shell_tcprtx_drop_buf_scratch_set(dhruva_alloc_bytes(64));
  // Round 99: sha256_padded/h/k/w_scratch, sha512_h/k/w/padded_
  // scratch, and both sha256_k_init/sha512_k_init boot-time
  // allocations removed -- SHA-256/512 now use the crypto_hash
  // package's stack-based streaming API, no persistent scratch needed.
  let _ = pki_pinned_key_set(dhruva_alloc_bytes(32));
  let _ = pki_sig_path_scratch_set(dhruva_alloc_bytes(40));
  let _ = pki_sig_data_scratch_set(dhruva_alloc_bytes(64));
  // Round 102: aead_state/working/keystream/block_scratch/otk/
  // mac_data/computed_tag boot-time allocations removed -- ChaCha20-
  // Poly1305 now uses the chacha20_poly1305 package's stack-based
  // streaming primitives (chacha20_xor_chunk/Poly1305Ctx), no
  // persistent scratch needed, same shape as round 99/100's SHA/
  // Ed25519 migrations.
  let _ = hkdf_hmac_key_block_set(dhruva_alloc_bytes(64));
  let _ = hkdf_hmac_msg_scratch_set(dhruva_alloc_bytes(320));
  let _ = hkdf_hmac_inner_hash_set(dhruva_alloc_bytes(32));
  let _ = hkdf_t_scratch_set(dhruva_alloc_bytes(32));
  let _ = hkdf_hmac_input_scratch_set(dhruva_alloc_bytes(320));
  let _ = keccak_state_set(dhruva_alloc_bytes(200));
  let _ = keccak_temp_set(dhruva_alloc_bytes(200));
  let _ = keccak_c_set(dhruva_alloc_bytes(40));
  let _ = keccak_d_set(dhruva_alloc_bytes(40));
  let _ = keccak_rc_set(dhruva_alloc_bytes(192));
  let _ = keccak_rho_set(dhruva_alloc_bytes(100));
  let _ = keccak_pi_dest_set(dhruva_alloc_bytes(100));
  let _ = keccak_pad_scratch_set(dhruva_alloc_bytes(896));
  let _ = keccak_init();
  let _ = pki_init();
  let _ = mlkem_zetas_set(dhruva_alloc_bytes(512));
  let _ = mlkem_gammas_set(dhruva_alloc_bytes(512));
  let _ = mlkem_a00_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_a01_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_a10_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_a11_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_s0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_s1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_e0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_e1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_t0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_t1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_r0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_r1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_enc_e1_0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_enc_e1_1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_u0_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_u1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_v_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_mu_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_w_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_e2_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_acc_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_tmp1_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_tmp2_set(dhruva_alloc_bytes(1024));
  let _ = mlkem_rho_set(dhruva_alloc_bytes(32));
  let _ = mlkem_sigma_set(dhruva_alloc_bytes(32));
  let _ = mlkem_prf_out_set(dhruva_alloc_bytes(192));
  let _ = mlkem_xof_out_set(dhruva_alloc_bytes(840));
  let _ = mlkem_h_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_z_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_mprime_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_kprime_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_rprime_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_kbar_buf_set(dhruva_alloc_bytes(32));
  let _ = mlkem_ekpke_buf_set(dhruva_alloc_bytes(800));
  let _ = mlkem_cprime_buf_set(dhruva_alloc_bytes(768));
  let _ = mlkem_init();
  let _ = tls_client_random_set(dhruva_alloc_bytes(32));
  let _ = tls_server_random_set(dhruva_alloc_bytes(32));
  let _ = tls_client_x25519_priv_set(dhruva_alloc_bytes(32));
  let _ = tls_client_x25519_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_server_x25519_priv_set(dhruva_alloc_bytes(32));
  let _ = tls_server_x25519_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_shared_secret_set(dhruva_alloc_bytes(32));
  let _ = tls_server_id_priv_set(dhruva_alloc_bytes(32));
  let _ = tls_server_id_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_early_secret_set(dhruva_alloc_bytes(32));
  let _ = tls_derived_es_set(dhruva_alloc_bytes(32));
  let _ = tls_handshake_secret_set(dhruva_alloc_bytes(32));
  let _ = tls_c_hs_traffic_set(dhruva_alloc_bytes(32));
  let _ = tls_s_hs_traffic_set(dhruva_alloc_bytes(32));
  let _ = tls_c_hs_key_set(dhruva_alloc_bytes(32));
  let _ = tls_c_hs_iv_set(dhruva_alloc_bytes(12));
  let _ = tls_s_hs_key_set(dhruva_alloc_bytes(32));
  let _ = tls_s_hs_iv_set(dhruva_alloc_bytes(12));
  let _ = tls_derived_hs_set(dhruva_alloc_bytes(32));
  let _ = tls_master_secret_set(dhruva_alloc_bytes(32));
  let _ = tls_c_ap_traffic_set(dhruva_alloc_bytes(32));
  let _ = tls_s_ap_traffic_set(dhruva_alloc_bytes(32));
  let _ = tls_c_ap_key_set(dhruva_alloc_bytes(32));
  let _ = tls_c_ap_iv_set(dhruva_alloc_bytes(12));
  let _ = tls_s_ap_key_set(dhruva_alloc_bytes(32));
  let _ = tls_s_ap_iv_set(dhruva_alloc_bytes(12));
  let _ = tls_transcript_set(dhruva_alloc_bytes(2048));
  let _ = tls_ch_set(dhruva_alloc_bytes(256));
  let _ = tls_sh_set(dhruva_alloc_bytes(256));
  let _ = tls_ee_set(dhruva_alloc_bytes(16));
  let _ = tls_cert_set(dhruva_alloc_bytes(64));
  let _ = tls_cv_set(dhruva_alloc_bytes(128));
  let _ = tls_s_fin_set(dhruva_alloc_bytes(64));
  let _ = tls_c_fin_set(dhruva_alloc_bytes(64));
  let _ = tls_hash_scratch_set(dhruva_alloc_bytes(32));
  let _ = tls_hkdf_label_scratch_set(dhruva_alloc_bytes(128));
  let _ = tls_cv_signed_content_set(dhruva_alloc_bytes(160));
  let _ = tls_finished_key_scratch_set(dhruva_alloc_bytes(32));
  let _ = tls_record_scratch_set(dhruva_alloc_bytes(2048));
  let _ = tls_record_aad_set(dhruva_alloc_bytes(16));
  let _ = tls_record_nonce_set(dhruva_alloc_bytes(16));
  let _ = tls_content_scratch_set(dhruva_alloc_bytes(2048));
  let _ = tls_tag_in_set(dhruva_alloc_bytes(16));
  let _ = tls_rec_buf_set(dhruva_alloc_bytes(2048));
  let _ = tls_client_msg_set(dhruva_alloc_bytes(64));
  let _ = tls_server_reply_set(dhruva_alloc_bytes(64));
  let _ = tls_decrypted_scratch_set(dhruva_alloc_bytes(2048));
  let _ = tls_client_rx_buf_set(dhruva_alloc_bytes(2048));
  let _ = tls_client_rx_len_set(dhruva_alloc_bytes(4));
  let _ = tls_server_rx_buf_set(dhruva_alloc_bytes(2048));
  let _ = tls_server_rx_len_set(dhruva_alloc_bytes(4));
  let _ = tls_frame_scratch_set(dhruva_alloc_bytes(1514));
  let _ = tls_chunk_scratch_set(dhruva_alloc_bytes(64));
  let _ = tls_recv_chunk_scratch_set(dhruva_alloc_bytes(64));
  let _ = tls_ack_scratch_set(dhruva_alloc_bytes(8));
  let _ = tls_ch_record_set(dhruva_alloc_bytes(128));
  let _ = tls_sh_record_set(dhruva_alloc_bytes(128));
  let _ = tls_parsed_client_random_set(dhruva_alloc_bytes(32));
  let _ = tls_parsed_client_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_parsed_server_random_set(dhruva_alloc_bytes(32));
  let _ = tls_parsed_server_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_flight_combined_set(dhruva_alloc_bytes(512));
  let _ = tls_parsed_server_id_pub_set(dhruva_alloc_bytes(32));
  let _ = tls_client_phase_set(dhruva_alloc_bytes(4));
  let _ = tls_server_phase_set(dhruva_alloc_bytes(4));
  let _ = tls_cert_hash_set(dhruva_alloc_bytes(32));
  let _ = tls_cv_sig_set(dhruva_alloc_bytes(64));
  let _ = tls_s_verify_data_set(dhruva_alloc_bytes(32));
  let _ = tls_c_verify_data_set(dhruva_alloc_bytes(32));
  let _ = tls_basepoint_set(dhruva_alloc_bytes(32));
  let _ = tls_zero32_set(dhruva_alloc_bytes(32));
  let _ = tls_transcript_len_set(dhruva_alloc_bytes(4));
  let _ = tls_t_len_sh_set(dhruva_alloc_bytes(4));
  let _ = tls_t_len_cert_set(dhruva_alloc_bytes(4));
  let _ = tls_t_len_cv_set(dhruva_alloc_bytes(4));
  let _ = tls_t_len_s_fin_set(dhruva_alloc_bytes(4));
  let _ = poly1305_block_scratch_set(dhruva_alloc_bytes(16));
  let _ = shell_line_scratch_set(dhruva_alloc_bytes(128));
  let _ = eval_values_scratch_set(dhruva_alloc_bytes(128));
  let _ = eval_ops_scratch_set(dhruva_alloc_bytes(64));
  let _ = uart_digits_scratch_set(dhruva_alloc_bytes(24));
  let _ = dwc2_dma_scratch_set(dhruva_alloc_bytes(128));
  let _ = usb_bulk_data_scratch_set(dhruva_alloc_bytes(512));
  let _ = tcp_empty_payload_scratch_set(dhruva_alloc_bytes(1));
  let _ = net_send_scratch_set(dhruva_alloc_bytes(netif_frame_slot_size()));
  let _ = net_recv_scratch_set(dhruva_alloc_bytes(netif_frame_slot_size()));
  let _ = udp_send_arp_scratch_set(dhruva_alloc_bytes(6));
  let _ = arp_resolve_scratch_set(dhruva_alloc_bytes(64));
  let _ = dhcp_server_mac_scratch_set(dhruva_alloc_bytes(6));
  let _ = arp_resolve_mac_scratch_set(dhruva_alloc_bytes(6));
  let _ = dhcp_payload_scratch_set(dhruva_alloc_bytes(300));
  let _ = dhcp_frame_scratch_set(dhruva_alloc_bytes(netif_frame_slot_size()));
  let _ = dhcp_bcast_mac_scratch_set(dhruva_alloc_bytes(8));

  let _ = sdhost_cmd_timed_out_self_test();

  // BUG (round 15 audit, 2026-08-28): sdhost_init's own return value
  // (RCA on success, -1 on a newly-detected command timeout -- see
  // sdhost_cmd_timed_out's own comment) used to be discarded entirely
  // here, same as every individual command inside sdhost_init used to
  // discard its own status. Even after fixing detection inside
  // sdhost_init itself, a failure would have stayed completely
  // invisible one level up -- boot would have silently continued into
  // dharafs_init() and beyond against a card that was never actually
  // brought up, with nothing in the log to explain why every later SD
  // operation was failing. Reported the same way dwc2_init's own
  // status already is, just below.
  let sd_status: i64 = sdhost_init();
  if sd_status < 0 {
    let _ = uart_puts("SD: sdhost_init FAILED (see the timeout message above for which command)\n");
  }

  // Task #3 verification: write+read+compare across several distinct
  // blocks, to confirm the driver holds up across many consecutive
  // data commands, not just a single lucky pair. Uses blocks near the
  // top of dharafs_init's scan range (2040-2047, just under its 2048 cap),
  // not 0-7 -- task #4's filesystem grows forward from block 1, so
  // low block numbers are real, live log data as of this same boot,
  // not a spare scratch area to overwrite with test patterns.
  let sd_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let sd_buf2: mut ref i64 = dhruva_alloc_bytes(512);
  let sd_blk: i64 = 2040;
  let sd_any_fail: i64 = 0;
  while sd_blk < 2048 {
    let _ = test_fill_pattern(sd_buf, 512);
    let sd_wr: i64 = sdhost_write_block(sd_blk, sd_buf);
    let sd_rd: i64 = sdhost_read_block(sd_blk, sd_buf2);
    let sd_mismatch: i64 = test_compare_buffers(sd_buf, sd_buf2, 512);
    if (sd_wr != 0) || (sd_rd != 0) || (sd_mismatch != 0) {
      sd_any_fail = 1;
    }
    sd_blk = sd_blk + 1;
  }
  let _ = uart_puts("SD: 8-block round-trip sweep any_fail=");
  let _ = uart_put_hex32(sd_any_fail as u32);
  let _ = uart_puts("\n");

  // Task #4 verification: append several path/value pairs, overwrite
  // one path with a newer value, confirm reads see the latest write
  // per path (not the first, not a mix) and an unrelated path is
  // unaffected.
  let _ = dharafs_init();

  // Report what recovery alone found, BEFORE any fresh writes this
  // boot might make -- test/power_yank.py checks exactly this line
  // against a deliberately torn image. Reading it only after the
  // fresh dharafs_append calls just below would defeat the whole test:
  // those calls run unconditionally every boot and would silently
  // paper over whatever recovery actually did with brand new records.
  let recovery_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let recovery_len: i64 = dharafs_read("/config/mode", recovery_buf);
  let _ = uart_puts("DharaFS: post-recovery /config/mode = \"");
  if recovery_len >= 0 {
    let _ = dharafs_print_data(recovery_buf, recovery_len);
  } else {
    let _ = uart_puts("(not found)");
  }
  let _ = uart_puts("\"\n");

  let _ = dharafs_append("/config/mode", "auto");
  let _ = dharafs_append("/config/name", "dhruva");
  let _ = dharafs_append("/config/mode", "manual");
  let dharafs_out: mut ref i64 = dhruva_alloc_bytes(512);

  let mode_len: i64 = dharafs_read("/config/mode", dharafs_out);
  let _ = uart_puts("DharaFS: /config/mode = \"");
  let _ = dharafs_print_data(dharafs_out, mode_len);
  let _ = uart_puts("\" (expect \"manual\")\n");

  let name_len: i64 = dharafs_read("/config/name", dharafs_out);
  let _ = uart_puts("DharaFS: /config/name = \"");
  let _ = dharafs_print_data(dharafs_out, name_len);
  let _ = uart_puts("\" (expect \"dhruva\")\n");

  let missing_len: i64 = dharafs_read("/config/missing", dharafs_out);
  let _ = uart_puts("DharaFS: /config/missing lookup result=");
  let _ = uart_put_hex32(missing_len as u32);
  let _ = uart_puts(" (expect FFFFFFFF, i.e. -1, not found)\n");

  // Task #5 verification: pile up several more dead versions of the
  // same path, run one compaction pass, confirm reads still see the
  // correct latest value afterward and log_start actually advanced
  // (i.e. compaction did real work, not a no-op).
  let _ = dharafs_append("/config/mode", "override1");
  let _ = dharafs_append("/config/mode", "override2");
  let _ = dharafs_append("/config/mode", "final");
  let log_start_before: u32 = dharafs_state_get_log_start();
  let next_block_before: u32 = dharafs_state_get_next_block();
  let compact_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_path_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let compact_data_buf: mut ref i64 = dhruva_alloc_bytes(4096);
  let _ = dharafs_compact(compact_buf, compact_path_buf, compact_data_buf);
  let log_start_after: u32 = dharafs_state_get_log_start();
  let next_block_after: u32 = dharafs_state_get_next_block();
  let _ = uart_puts("DharaFS: compact log_start ");
  let _ = uart_put_hex32(log_start_before);
  let _ = uart_puts(" -> ");
  let _ = uart_put_hex32(log_start_after);
  let _ = uart_puts(", next_block ");
  let _ = uart_put_hex32(next_block_before);
  let _ = uart_puts(" -> ");
  let _ = uart_put_hex32(next_block_after);
  let _ = uart_puts("\n");

  let mode_len2: i64 = dharafs_read("/config/mode", dharafs_out);
  let _ = uart_puts("DharaFS: post-compact /config/mode = \"");
  let _ = dharafs_print_data(dharafs_out, mode_len2);
  let _ = uart_puts("\" (expect \"final\")\n");

  let name_len2: i64 = dharafs_read("/config/name", dharafs_out);
  let _ = uart_puts("DharaFS: post-compact /config/name = \"");
  let _ = dharafs_print_data(dharafs_out, name_len2);
  let _ = uart_puts("\" (expect \"dhruva\")\n");

  // Leave task_e (GC) real work to find on its own first scheduled
  // wake-up, rather than only ever seeing an already-compacted log
  // from the manual pass above.
  let _ = dharafs_append("/config/mode", "post-compact-1");
  let _ = dharafs_append("/config/mode", "post-compact-2");

  // Task #8 verification: prefix-scan listing and tombstone delete.
  let _ = uart_puts("DharaFS: ls /config/ (expect mode, name):\n");
  let _ = dharafs_list("/config/");
  let _ = dharafs_delete("/config/name");
  let _ = uart_puts("DharaFS: ls /config/ after deleting name (expect only mode):\n");
  let _ = dharafs_list("/config/");
  let deleted_len: i64 = dharafs_read("/config/name", dharafs_out);
  let _ = uart_puts("DharaFS: read of deleted /config/name result=");
  let _ = uart_put_hex32(deleted_len as u32);
  let _ = uart_puts(" (expect FFFFFFFF, i.e. -1, not found)\n");

  // Round 39: multi-block files + journaling hardening.
  let _ = dharafs_multiblock_self_test();
  let _ = dharafs_multiblock_crash_consistency_self_test();

  // Round 77: dharafs_compact's own resumable, per-call-bounded pass.
  let _ = dharafs_compact_resumable_self_test();

  // Round 42: directory hierarchy + owner/group/other rwx permissions.
  let _ = dharafs_permissions_self_test();
  let _ = dharafs_directory_hierarchy_self_test();

  // Task #10 verification: eval_expr_raw, via boot-time self-test
  // rather than live shell input (see eval_self_test's own comment).
  // Round 72: shell input echo, with su/passwd password-mode suppression.
  let _ = shell_echo_self_test();

  let _ = eval_self_test("2+3", 5, 0);
  let _ = eval_self_test("2 + 3 * 4", 14, 0);
  let _ = eval_self_test("(2+3)*4", 20, 0);
  let _ = eval_self_test("10-2-3", 5, 0);
  let _ = eval_self_test("2*(3+4*(5-1))", 38, 0);
  let _ = eval_self_test("-5+10", 5, 0);
  let _ = eval_self_test("100/3", 33, 0);
  let _ = eval_self_test("10/0", 0, 1);
  let _ = eval_self_test("(1+2", 0, 1);
  // Round 2 audit regression: values stack used to store each number as
  // a truncating single u32 word, silently corrupting operands beyond
  // +-2 billion before eval_apply ever saw them -- this used to return
  // a wrong silent answer (no error) instead of correctly detecting
  // overflow. Also exercises a large-but-in-range value end to end to
  // confirm the hi/lo split round-trips correctly, not just the
  // overflow-rejection path.
  let _ = eval_self_test("999999999999*999999999999", 0, 1);
  let _ = eval_self_test("5000000000+5000000000", 10000000000, 0);

  // Round 6 audit regression: uart_put_i64 used to negate its whole
  // input up front, which overflows for exactly one value, i64::MIN --
  // see uart_put_i64's own comment for why that's a real hang/wrong-
  // answer risk on this target, not just theoretical. No caller passes
  // i64::MIN today, but this is a general-purpose print helper, so
  // this exercises it directly rather than only through whatever
  // happens to call it elsewhere.
  let _ = uart_puts("UART: uart_put_i64(i64::MIN)=");
  let _ = uart_put_i64(0 - 9223372036854775807 - 1);
  let _ = uart_puts(" (expect -9223372036854775808)\n");

  // Phase 5 verification: governor_desired_freq_mhz's threshold
  // boundaries, via boot-time self-test rather than live introspection
  // (scheduler_ready_count() only means anything once start_multitasking
  // has handed off, at the very end of this function -- deterministic
  // logic like this needs no live task juggling to check).
  let _ = governor_self_test(0, 250);
  let _ = governor_self_test(1, 250);
  let _ = governor_self_test(2, 450);
  let _ = governor_self_test(3, 450);
  let _ = governor_self_test(4, 700);
  let _ = governor_self_test(5, 700);
  let _ = governor_replay_test();

  // Round 60: packet filtering's own default policy -- .bss's own
  // zero-init would otherwise leave fw_default_policy at 0 (deny),
  // which would silently break every self-test below that calls
  // netif_recv_frame (all of them go through filter_check_frame now)
  // before a single `fw` rule has ever been added. Explicitly allow
  // by default, matching this project's existing permissive stance
  // (nothing to protect against until a rule is actually configured).
  let _ = fw_set_default_policy(1 as u32);

  // Phase 6 verification: netif's own loopback implementation.
  let _ = netif_init();
  let _ = netif_self_test();
  let _ = filter_self_test();
  let _ = filter_outgoing_self_test();
  let _ = arp_self_test();
  let _ = arp_resolve_self_test();
  let _ = ipv4_self_test();
  let _ = ip_parse_self_test();
  let _ = icmp_self_test();
  let _ = udp_self_test();
  let _ = udp_send_unresolved_self_test();
  let _ = udp_recv_bounds_self_test();
  let _ = udp_checksum_reject_self_test();
  let _ = tcp_self_test();
  let _ = tcp_conn_self_test();
  let _ = tcp_conn_recv_bounds_self_test();
  let _ = tcp_conn_simultaneous_open_self_test();
  let _ = tcp_conn_simultaneous_close_self_test();
  let _ = tcp_conn_window_enforcement_self_test();
  let _ = dhcp_self_test();
  let _ = dhcp_renewal_self_test();
  let _ = dhcp_nak_self_test();
  let _ = netif_queue_contention_self_test();

  // Round 41: crypto primitives foundation, hash-function half.
  let _ = sha256_self_test();

  // Real authentication: HMAC-SHA256/PBKDF2-HMAC-SHA256, built on
  // round 41's SHA-256, ahead of everything su/passwd itself needs.
  let _ = hmac_sha256_self_test();
  let _ = pbkdf2_hmac_sha256_self_test();

  // Round 44: crypto primitives foundation, symmetric-cipher half.
  let _ = chacha20_self_test();
  let _ = poly1305_self_test();
  let _ = x25519_self_test();
  let _ = sha512_self_test();
  let _ = ed25519_self_test();
  let _ = pki_self_test();
  let _ = aes128_self_test();
  let _ = aead_hkdf_self_test();
  let _ = keccak_self_test();
  let _ = mlkem_self_test();
  let _ = tls_self_test();
  let _ = tls_tcp_self_test();

  // Media (at-rest) encryption for DharaFS, layered on the ChaCha20
  // cipher above. Key derivation runs once here, single-threaded,
  // before start_multitasking. The self-check needs a working SD
  // controller, already brought up above.
  let _ = dharafs_crypto_key_init();
  let _ = dharafs_encryption_self_check();

  // Round 44's own bignum arithmetic base (bignum_add_raw/sub_raw/
  // mul_raw/etc, and its own bignum_self_test) was deleted round 100
  // -- migrated to the crypto_hash/curve25519 packages' own 8-limb
  // bignum functions instead, exercised indirectly by the X25519/
  // Ed25519 self-tests below rather than a standalone bignum check.

  // Round 71: general-purpose GPIO.
  let _ = gpio_self_check();

  // Round 71: HDMI framebuffer (mailbox property-channel interface).
  let _ = fb_self_check();

  // DWC2 bring-up: only reaches "port enabled" if a USB device is
  // actually attached to this QEMU invocation (`-usb -device
  // usb-net,...` or similar) -- not attaching one is the normal case
  // for every other test in this project, so a nonzero return here is
  // expected and informational, not a failure to alarm on.
  let usb_status: i64 = dwc2_init();
  let _ = uart_puts("USB: dwc2_init status=");
  let _ = uart_put_hex32(usb_status as u32);
  let _ = uart_puts(" (0=device attached+port enabled, nonzero=no device attached)\n");

  let _ = timer_ic_init();
  let _ = uart_rx_irq_init();

  let stack_bytes: i64 = 4096;
  let stack_a: mut ref i64 = dhruva_alloc_stack_guarded(stack_bytes);
  let _ = stack_canary_set_base(0 as u32, stack_a);
  let stack_b: mut ref i64 = dhruva_alloc_stack_guarded(stack_bytes);
  let _ = stack_canary_set_base(1 as u32, stack_b);
  let stack_c: mut ref i64 = dhruva_alloc_stack_guarded(stack_bytes);
  let _ = stack_canary_set_base(2 as u32, stack_c);
  let stack_d: mut ref i64 = dhruva_alloc_stack_guarded(stack_bytes);
  let _ = stack_canary_set_base(3 as u32, stack_d);
  // BUG (round 4 audit, 2026-08-27): task_e was still allocated the
  // same stock 4096 bytes every non-FS task gets, even though this
  // very file's own task_f comment right below already names task_e
  // as sharing task_f's "similarly-deep chain" -- dharafs_compact calls
  // through the same FS/SD block layer (dharafs_state_get_log_start/
  // next_block, sdhost_read_block/write_block) that overflowed task_f's
  // stock stack the instant a UART RX IRQ landed mid-call-chain. task_e
  // never hit this live only because no test so far happened to have a
  // UART RX interrupt (which fires whenever a character is typed at the
  // shell, completely independent of which task is actually running at
  // that instant) land while task_e -- not task_f -- was the one
  // currently executing deep in dharafs_compact. That's a timing accident,
  // not a structural difference between the two tasks: IRQ frames build
  // on whichever task's own SVC stack happens to be current when the
  // interrupt fires (the same Phase 2 IRQ-vs-SVC-stack design task_f's
  // fix explains), so task_e was exposed to the identical worst case
  // the whole time. Given the task_f fix, matched here rather than
  // bisected down to something merely plausible: same task, same class
  // of call chain, same fix.
  // EXPERIMENT (2026-09-03, range-check crash investigation) REVERTED:
  // briefly raised to 32768 while chasing a live crash misattributed
  // to task_e -- start_multitasking's own sp_table layout is 0-indexed
  // (task 0=a=HIGH ... task 4=e=GC, task 5=f=SHELL), so "current_task=5"
  // in that crash report was actually task_f (SHELL/tlsecho), not
  // task_e. Back to the original, still-justified 16384.
  let stack_e_bytes: i64 = 16384;
  let stack_e: mut ref i64 = dhruva_alloc_stack_guarded(stack_e_bytes);
  let _ = stack_canary_set_base(4 as u32, stack_e);
  // BUG (task #9, found via the same event-driven interactive test):
  // task_f's real stack was originally the same 4096 bytes every other
  // task gets, matching its #[bounded_stack(bytes=2048)] claim with
  // room to spare on paper. In practice it hung the whole system --
  // total silence, no reboot -- the instant a UART RX interrupt landed
  // while task_f was deep in shell_dispatch -> dharafs_list ->
  // dharafs_find_latest_block_raw -> sdhost_read_block. Root cause: this
  // project's IRQ frames build on the INTERRUPTED task's own SVC stack
  // (the Phase 2 IRQ-vs-SVC-stack fix), so the real worst case for any
  // interruptible task is its own deepest call chain PLUS whatever the
  // preempting ISR needs on top -- not accounted for by #[bounded_
  // stack]'s static, interrupt-oblivious analysis. task_e's own
  // similarly-deep chain happened to never overflow its stock 4096
  // bytes, purely because it had only ever been preempted by the
  // routine timer tick before task_f's shell gave it UART RX exposure
  // too. Confirmed by raising just this one task's real allocation to
  // 16384 (4x) and watching the exact same hang disappear -- kept at
  // that confirmed-safe value rather than bisected down to something
  // merely plausible.
  // Round 68 (this investigation): raised twice more, 32768 -> 65536
  // -> 262144. Code-reading (not GDB) found the real root cause class:
  // this project's #[bounded_stack] checker is a documented
  // "conservative estimator, not an exact analysis" that has now
  // underestimated a real worst case FIVE separate times (task_f round
  // 9, task_e round 27, task_custom_demo round 60, task_f/tlsecho
  // round 67, and again at 65536 bytes earlier THIS round) -- every
  // prior fix was an empirical size bump with no guarantee the new
  // number was actually enough, since the checker's own gap (doesn't
  // add the preempting ISR's own worst-case usage on top of a task's
  // deepest call chain -- see task_f's round-9 comment above) was
  // never closed. The 65536-byte attempt earlier this round still
  // crashed -- deterministically, on the FIRST interactive tlsecho
  // invocation, no interrupt-timing luck needed at all, which is a
  // stronger signal than any prior incident that this call chain's own
  // true worst case (both TLS roles, X25519, bignum, all in one
  // synchronous chain) is genuinely large, not just occasionally
  // pushed over by a badly-timed ISR. 262144 is 4x that failed
  // attempt, and DHRUVA_HEAP_BYTES (runtime_stubs.c) was raised
  // 256KB->768KB in the same round specifically to give this room
  // without re-tripping heap_usage_self_test's own headroom check --
  // stack_canary_set_base below (see boot/stack_canary.S) is the
  // structural half of this fix regardless of whether this number
  // turns out to be the last one needed: it can't prevent an overflow,
  // but it makes the NEXT one detectable within one tick and by name,
  // instead of manifesting as an unrelated wild-pointer crash
  // arbitrarily far downstream the way every one of these incidents
  // did before it existed.
  let stack_f_bytes: i64 = 262144;
  let stack_f: mut ref i64 = dhruva_alloc_stack_guarded(stack_f_bytes);
  let _ = stack_canary_set_base(5 as u32, stack_f);
  let sp_a: mut ref i64 = task_a_init_stack(stack_a, stack_bytes);
  let sp_b: mut ref i64 = task_b_init_stack(stack_b, stack_bytes);
  let sp_c: mut ref i64 = task_c_init_stack(stack_c, stack_bytes);
  let sp_d: mut ref i64 = task_d_init_stack(stack_d, stack_bytes);
  let sp_e: mut ref i64 = task_e_init_stack(stack_e, stack_e_bytes);
  let sp_f: mut ref i64 = task_f_init_stack(stack_f, stack_f_bytes);

  // Round 54: live demonstration of the new task_create API -- a
  // genuinely dynamically-created 7th task, not one of the 6 built in
  // at compile time. dhruva_alloc_bytes here is a one-time boot
  // allocation (matches every other task's own stack allocation
  // above), not a per-call pattern.
  //
  // task_table_init() MUST run before this first task_create() call
  // (and before start_multitasking) -- it seeds eff_prio_table's
  // free-slot sentinel (255) for indices 6-15, which .bss's own
  // zero-init does not do. Calling task_create() before this ran
  // found every slot reading 0 (not 255), so it always returned "no
  // free slot" -- see task_table_init's own comment in
  // context_switch.S for the full story.
  let _ = task_table_init();

  // Real authentication: seed the user-credential table's own
  // "empty" sentinel before anything (passwd/su) can touch it --
  // same "seed the sentinel first" discipline as task_table_init
  // just above.
  let _ = auth_table_init();

  // Round 60 crash investigation: was 512 bytes (matching this fn's own
  // #[bounded_stack(bytes=512)] budget exactly, with zero headroom --
  // unlike EVERY other task in this project, which all get generous
  // multiples of their own verified worst case (task_a-d: 4096 bytes;
  // task_e/f: 16384). Confirmed via a live crash (Data Abort, near-
  // null/wild fault addresses, "current_task=6" i.e. this exact task)
  // that reproduces far FASTER when this allocation is shrunk further
  // (128 bytes crashes within ~60s vs. 512 bytes taking 150-550s) --
  // direct empirical proof this is a real stack overflow, even though
  // the static #[bounded_stack] checker's own (admittedly approximate,
  // "conservative estimator, not an exact analysis" per its own docs)
  // model reports only ~220 bytes of real worst-case usage for this
  // function. Raised to match every other task's own established
  // "verified minimum, plus real headroom" convention rather than
  // trusting the bare static minimum -- see docs/TODO.md for the full
  // investigation writeup.
  let custom_stack_bytes: u32 = 4096 as u32;
  let custom_stack: mut ref i64 = dhruva_alloc_stack_guarded(custom_stack_bytes as i64);
  let _ = stack_canary_set_base(6 as u32, custom_stack);
  let custom_task_id: u32 = task_create(task_custom_demo, custom_stack, custom_stack_bytes, 3 as u32);
  let _ = uart_puts("task_create: new task id=");
  let _ = uart_put_i64(custom_task_id as i64);
  let _ = uart_puts("\n");

  // Round 55: live demonstration of the new dhruva_mutex_lock/unlock
  // blocking-mutex-with-inheritance primitive (see its own comment in
  // context_switch.S, and task_mutex_demo_low/high's own comment
  // above). Two more dynamically-created tasks, same one-time-
  // allocation-per-task-stack pattern as task_custom_demo above.
  // Round 60: same fix, same reasoning as custom_stack_bytes above --
  // was 512 bytes with zero headroom, raised to match project convention.
  let mutex_low_stack_bytes: u32 = 4096 as u32;
  let mutex_low_stack: mut ref i64 = dhruva_alloc_stack_guarded(mutex_low_stack_bytes as i64);
  let _ = stack_canary_set_base(7 as u32, mutex_low_stack);
  let mutex_low_task_id: u32 = task_create(task_mutex_demo_low, mutex_low_stack, mutex_low_stack_bytes, 2 as u32);
  let mutex_high_stack_bytes: u32 = 4096 as u32;
  let mutex_high_stack: mut ref i64 = dhruva_alloc_stack_guarded(mutex_high_stack_bytes as i64);
  let _ = stack_canary_set_base(8 as u32, mutex_high_stack);
  let mutex_high_task_id: u32 = task_create(task_mutex_demo_high, mutex_high_stack, mutex_high_stack_bytes, 0 as u32);
  let _ = uart_puts("task_create: mutex demo task ids=");
  let _ = uart_put_i64(mutex_low_task_id as i64);
  let _ = uart_puts(",");
  let _ = uart_put_i64(mutex_high_task_id as i64);
  let _ = uart_puts("\n");

  // Priority-aware FS request queue's own dedicated drain task -- low
  // priority (same tier as task_gc's compaction, tier 2), same
  // dynamically-created-via-task_create pattern as the demo tasks
  // just above. Entirely opt-in: nothing here changes any EXISTING
  // synchronous dharafs_* call site.
  let _ = dharafs_queue_reset();
  let fsq_stack_bytes: u32 = 4096 as u32;
  let fsq_stack: mut ref i64 = dhruva_alloc_stack_guarded(fsq_stack_bytes as i64);
  let _ = stack_canary_set_base(9 as u32, fsq_stack);
  let fsq_task_id: u32 = task_create(task_fsq, fsq_stack, fsq_stack_bytes, 2 as u32);
  let _ = uart_puts("task_create: fsqueue dispatcher task id=");
  let _ = uart_put_i64(fsq_task_id as i64);
  let _ = uart_puts("\n");

  let _ = uart_puts("PASS\n");

  // BUG (round 26 audit, found by actually driving the new shell
  // `ping` command interactively rather than just its self-test):
  // arp_self_test/udp_self_test/dhcp_self_test/dhcp_renewal_self_test
  // all insert real entries into the ONE live ARP cache (arp_cache_
  // insert), and nothing ever cleared it afterward -- every one of
  // those test entries stays there for the rest of this boot,
  // silently available to `ping`'s own arp_cache_lookup. dhcp_self_
  // test's own synthetic server sits at 192.168.1.1, mapped to a
  // fake MAC (0xAA repeated) -- one of the single most common real
  // LAN gateway addresses. On real hardware, `ping 192.168.1.1`
  // typed at the shell after boot would silently "succeed" against
  // that leftover fake test MAC instead of ever issuing a real ARP
  // request for whatever's actually at that address -- invisible
  // under QEMU, where nothing real is on the other end to expose the
  // wrong answer, but a real, live correctness gap for anything
  // downstream of `ping`'s own arp_cache_lookup that trusts the
  // result.
  //
  // Fixed by resetting arp_cache_count directly, NOT by re-calling
  // arp_cache_init() -- that function only reallocates the cache's
  // own MAC-bytes buffer (arp_cache_set_macs_buf), it does not touch
  // arp_cache_count or the parallel IP array at all, so calling it a
  // second time here would have left every stale IP entry still
  // "found" by arp_cache_lookup (which only ever looks at entries
  // below arp_cache_count), just now paired with a fresh all-zero MAC
  // instead of the old fake one -- an even worse silent wrong answer,
  // caught here before it shipped rather than discovered as a second
  // bug on top of the first. Resetting count to 0 alone is correct
  // and sufficient: arp_cache_lookup's own loop bound means an empty
  // count makes every stale MAC/IP-array byte unreachable regardless
  // of what's still sitting in them, and arp_cache_insert starts
  // overwriting cleanly from index 0 again on the next real entry.
  let _ = arp_cache_set_count(0 as u32);
  let _ = arp_cache_set_next_slot(0 as u32);
  let _ = heap_usage_self_test();

  // Round 27 (2026-08-28): actually start real DHCP address
  // acquisition -- dhcp_client_start/dhcp_client_poll have existed
  // since round 9, been fixed and extended twice since (round 10's
  // NAK handling, round 22's full RFC 2131 lease renewal), and every
  // single call to them anywhere in this codebase before this line
  // was from a self-test that always finishes by resetting the state
  // machine back to INIT (dhcp_nak_self_test's own final branch is
  // the last DHCP self-test that runs) -- the same "correct, fully
  // built, never actually used live" pattern rounds 8/11/21 already
  // found and fixed for other subsystems, just for the single most
  // complete protocol layer in this whole project. xid varies run to
  // run via scheduler_get_tick_count(), matching dhcp_client_start's
  // own comment on what a caller should supply (this driver has no
  // random-number source). task_e's own periodic dhcp_client_poll
  // call (see that function's own comment) is what actually drives
  // this forward from here -- DISCOVER goes out now, but nothing
  // ever answers it under QEMU (no real DHCP server exists on this
  // project's loopback-only netif), so this permanently sits in
  // SELECTING under the only testing method this project has --
  // correct by design for real hardware, not something QEMU can
  // verify end to end, the same honest-limitation category rounds
  // 23/24/26 already established.
  let boot_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(boot_mac);
  let dhcp_boot_status: i64 = dhcp_client_start(boot_mac, scheduler_get_tick_count());
  let _ = uart_puts("DHCP: client_start status=");
  let _ = uart_put_hex32(dhcp_boot_status as u32);
  let _ = uart_puts(" (0=DISCOVER sent, state=SELECTING)\n");

  // watchdog_init() would belong here, right before handing off to the
  // scheduler -- see watchdog_arm's comment for why it isn't actually
  // called under QEMU's raspi1ap.
  //
  // Never returns. start_multitasking's own restore sets CPSR (via
  // the fake frame's spsr=0x13) with interrupts already enabled, so
  // there's no separate enable_irqs() call needed here -- interrupts
  // stay masked for all of kernel_main's own setup above, and turn on
  // exactly when task_a first runs.
  let _ = start_multitasking(sp_a, sp_b, sp_c, sp_d, sp_e, sp_f);

  // Unreachable, but kernel_main must still type-check as returning i64.
  return 0;
}

// Required by the compiler even though boot.S never calls it -- the
// real entry point is kernel_main, reached via boot.S's _start.
fn main() -> i64 {
  return 0;
}
