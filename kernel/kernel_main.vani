fn mlkem_buf_copy(src: mut ref i64, src_off: i64, dst: mut ref i64, dst_off: i64, n: i64) -> i64 {
  let ci: i64 = 0;
  while ci < n {
    let cb: u32 = buf_read_byte(src, (src_off + ci) as u32);
    let _ = buf_write_byte(dst, (dst_off + ci) as u32, cb);
    ci = ci + 1;
  }
  return 0;
}

fn mlkem_poly_add(a: mut ref i64, b: mut ref i64, out: mut ref i64) -> i64 {
  let pai: i64 = 0;
  while pai < 256 {
    let av: u32 = buf_read_u32(a, (pai * 4) as u32);
    let bv: u32 = buf_read_u32(b, (pai * 4) as u32);
    let _ = buf_write_u32(out, (pai * 4) as u32, (av + bv) % (3329 as u32));
    pai = pai + 1;
  }
  return 0;
}

fn mlkem_poly_sub(a: mut ref i64, b: mut ref i64, out: mut ref i64) -> i64 {
  let psi: i64 = 0;
  while psi < 256 {
    let av: u32 = buf_read_u32(a, (psi * 4) as u32);
    let bv: u32 = buf_read_u32(b, (psi * 4) as u32);
    let _ = buf_write_u32(out, (psi * 4) as u32, (av + (3329 as u32) - bv) % (3329 as u32));
    psi = psi + 1;
  }
  return 0;
}

// FIPS 203 Algorithm 9 (NTT), in-place. zetas[k] = 17^bitrev7(k) mod q,
// precomputed by mlkem_init from the exact same derivation verified
// byte-exact against kyber-py's reference in the scratchpad Python spike.
fn mlkem_ntt(f: mut ref i64) -> i64 {
  let zetas: mut ref i64 = mlkem_zetas_get();
  let ntt_k: i64 = 1;
  let ntt_len: i64 = 128;
  while ntt_len >= 2 {
    let ntt_start: i64 = 0;
    while ntt_start < 256 {
      let zeta: u32 = buf_read_u32(zetas, (ntt_k * 4) as u32);
      ntt_k = ntt_k + 1;
      let ntt_j: i64 = ntt_start;
      while ntt_j < ntt_start + ntt_len {
        let fjl: u32 = buf_read_u32(f, ((ntt_j + ntt_len) * 4) as u32);
        let t: u32 = (zeta * fjl) % (3329 as u32);
        let fj: u32 = buf_read_u32(f, (ntt_j * 4) as u32);
        let newjl: u32 = (fj + (3329 as u32) - t) % (3329 as u32);
        let newj: u32 = (fj + t) % (3329 as u32);
        let _ = buf_write_u32(f, ((ntt_j + ntt_len) * 4) as u32, newjl);
        let _ = buf_write_u32(f, (ntt_j * 4) as u32, newj);
        ntt_j = ntt_j + 1;
      }
      ntt_start = ntt_start + 2 * ntt_len;
    }
    ntt_len = ntt_len / 2;
  }
  return 0;
}

// FIPS 203 Algorithm 10 (NTT^-1), in-place; final pass scales by
// 3303 = 128^-1 mod 3329.
fn mlkem_ntt_inv(f: mut ref i64) -> i64 {
  let zetas: mut ref i64 = mlkem_zetas_get();
  let inv_k: i64 = 127;
  let inv_len: i64 = 2;
  while inv_len <= 128 {
    let inv_start: i64 = 0;
    while inv_start < 256 {
      let zeta: u32 = buf_read_u32(zetas, (inv_k * 4) as u32);
      inv_k = inv_k - 1;
      let inv_j: i64 = inv_start;
      while inv_j < inv_start + inv_len {
        let t: u32 = buf_read_u32(f, (inv_j * 4) as u32);
        let fjl: u32 = buf_read_u32(f, ((inv_j + inv_len) * 4) as u32);
        let newj: u32 = (t + fjl) % (3329 as u32);
        let diff: u32 = (fjl + (3329 as u32) - t) % (3329 as u32);
        let newjl: u32 = (zeta * diff) % (3329 as u32);
        let _ = buf_write_u32(f, (inv_j * 4) as u32, newj);
        let _ = buf_write_u32(f, ((inv_j + inv_len) * 4) as u32, newjl);
        inv_j = inv_j + 1;
      }
      inv_start = inv_start + 2 * inv_len;
    }
    inv_len = inv_len * 2;
  }
  let scale_i: i64 = 0;
  while scale_i < 256 {
    let x: u32 = buf_read_u32(f, (scale_i * 4) as u32);
    let scaled: u32 = (x * (3303 as u32)) % (3329 as u32);
    let _ = buf_write_u32(f, (scale_i * 4) as u32, scaled);
    scale_i = scale_i + 1;
  }
  return 0;
}

// FIPS 203 Algorithm 11 (MultiplyNTTs), base-case multiplication of
// degree-1 pairs mod (X^2 - gamma_i).
fn mlkem_multiply_ntts(f: mut ref i64, g: mut ref i64, out: mut ref i64) -> i64 {
  let gammas: mut ref i64 = mlkem_gammas_get();
  let mi: i64 = 0;
  while mi < 128 {
    let a0: u32 = buf_read_u32(f, (2 * mi * 4) as u32);
    let a1: u32 = buf_read_u32(f, ((2 * mi + 1) * 4) as u32);
    let b0: u32 = buf_read_u32(g, (2 * mi * 4) as u32);
    let b1: u32 = buf_read_u32(g, ((2 * mi + 1) * 4) as u32);
    let gamma: u32 = buf_read_u32(gammas, (mi * 4) as u32);
    let c0a: u32 = (a0 * b0) % (3329 as u32);
    let c0b: u32 = (((a1 * b1) % (3329 as u32)) * gamma) % (3329 as u32);
    let c0: u32 = (c0a + c0b) % (3329 as u32);
    let c1a: u32 = (a0 * b1) % (3329 as u32);
    let c1b: u32 = (a1 * b0) % (3329 as u32);
    let c1: u32 = (c1a + c1b) % (3329 as u32);
    let _ = buf_write_u32(out, (2 * mi * 4) as u32, c0);
    let _ = buf_write_u32(out, ((2 * mi + 1) * 4) as u32, c1);
    mi = mi + 1;
  }
  return 0;
}

// Generic FIPS 203 ByteEncode_d: packs 256 coefficients (each < mod_val)
// into d-bit little-endian-bit-order fields, written starting at
// out_offset. 256*d is always a multiple of 8 for d in {12,10,4,1}, so
// there is never a leftover partial byte to flush.
fn mlkem_byte_encode(poly: mut ref i64, d: i64, mod_val: u32, out: mut ref i64, out_offset: i64) -> i64 {
  let be_bitbuf: u32 = 0 as u32;
  let be_bitcount: i64 = 0;
  let be_pos: i64 = out_offset;
  let be_i: i64 = 0;
  while be_i < 256 {
    let coeff: u32 = buf_read_u32(poly, (be_i * 4) as u32) % mod_val;
    be_bitbuf = be_bitbuf | (coeff << (be_bitcount as u32));
    be_bitcount = be_bitcount + d;
    while be_bitcount >= 8 {
      let outbyte: u32 = be_bitbuf & (255 as u32);
      let _ = buf_write_byte(out, be_pos as u32, outbyte);
      be_pos = be_pos + 1;
      be_bitbuf = be_bitbuf >> (8 as u32);
      be_bitcount = be_bitcount - 8;
    }
    be_i = be_i + 1;
  }
  return 0;
}

// Generic FIPS 203 ByteDecode_d, reading from in_offset within `inbuf`.
fn mlkem_byte_decode(inbuf: mut ref i64, in_offset: i64, d: i64, mod_val: u32, poly: mut ref i64) -> i64 {
  let bd_bitbuf: u32 = 0 as u32;
  let bd_bitcount: i64 = 0;
  let bd_pos: i64 = in_offset;
  let bd_mask: u32 = ((1 as u32) << (d as u32)) - (1 as u32);
  let bd_i: i64 = 0;
  while bd_i < 256 {
    while bd_bitcount < d {
      let inbyte: u32 = buf_read_byte(inbuf, bd_pos as u32);
      bd_pos = bd_pos + 1;
      bd_bitbuf = bd_bitbuf | (inbyte << (bd_bitcount as u32));
      bd_bitcount = bd_bitcount + 8;
    }
    let coeff: u32 = (bd_bitbuf & bd_mask) % mod_val;
    let _ = buf_write_u32(poly, (bd_i * 4) as u32, coeff);
    bd_bitbuf = bd_bitbuf >> (d as u32);
    bd_bitcount = bd_bitcount - d;
    bd_i = bd_i + 1;
  }
  return 0;
}

fn mlkem_compress_poly(f: mut ref i64, d: i64, out: mut ref i64) -> i64 {
  let cp_m: u32 = (1 as u32) << (d as u32);
  let cp_i: i64 = 0;
  while cp_i < 256 {
    let x: u32 = buf_read_u32(f, (cp_i * 4) as u32);
    let num: u32 = x * cp_m + (1664 as u32);
    let q: u32 = num / (3329 as u32);
    let c: u32 = q % cp_m;
    let _ = buf_write_u32(out, (cp_i * 4) as u32, c);
    cp_i = cp_i + 1;
  }
  return 0;
}

fn mlkem_decompress_poly(f: mut ref i64, d: i64, out: mut ref i64) -> i64 {
  let dp_half: u32 = (1 as u32) << ((d - 1) as u32);
  let dp_i: i64 = 0;
  while dp_i < 256 {
    let y: u32 = buf_read_u32(f, (dp_i * 4) as u32);
    let num: u32 = y * (3329 as u32) + dp_half;
    let val: u32 = num >> (d as u32);
    let _ = buf_write_u32(out, (dp_i * 4) as u32, val);
    dp_i = dp_i + 1;
  }
  return 0;
}

// mu = Decompress_1(BytesToBits(m)): each message bit maps directly to
// 0 or 1665 (= Decompress(1,1)), so this folds bit-extraction and
// decompression into one pass instead of building an intermediate bit array.
fn mlkem_msg_to_poly(m: mut ref i64, out: mut ref i64) -> i64 {
  let mp_i: i64 = 0;
  while mp_i < 256 {
    let byte_idx: i64 = mp_i / 8;
    let bit_idx: i64 = mp_i % 8;
    let byteval: u32 = buf_read_byte(m, byte_idx as u32);
    let bit: u32 = (byteval >> (bit_idx as u32)) & (1 as u32);
    let val: u32 = if bit == (1 as u32) { 1665 as u32 } else { 0 as u32 };
    let _ = buf_write_u32(out, (mp_i * 4) as u32, val);
    mp_i = mp_i + 1;
  }
  return 0;
}

// Reverse of mlkem_msg_to_poly: Compress_1 each coefficient to a bit,
// packed LSB-first into 32 bytes.
fn mlkem_poly_to_msg(w: mut ref i64, out: mut ref i64) -> i64 {
  let zi: i64 = 0;
  while zi < 32 {
    let _ = buf_write_byte(out, zi as u32, 0 as u32);
    zi = zi + 1;
  }
  let pm_j: i64 = 0;
  while pm_j < 256 {
    let x: u32 = buf_read_u32(w, (pm_j * 4) as u32);
    let num: u32 = x * (2 as u32) + (1664 as u32);
    let q: u32 = num / (3329 as u32);
    let bit: u32 = q % (2 as u32);
    if bit == (1 as u32) {
      let byte_idx: i64 = pm_j / 8;
      let bit_idx: i64 = pm_j % 8;
      let cur: u32 = buf_read_byte(out, byte_idx as u32);
      let _ = buf_write_byte(out, byte_idx as u32, cur | ((1 as u32) << (bit_idx as u32)));
    }
    pm_j = pm_j + 1;
  }
  return 0;
}

// PRF_eta(s, b) = SHAKE256(s || b, 64*eta). Uses mlkem_tmp1 purely as
// transient concatenation scratch -- never held live across a call to
// any other mlkem_* helper.
fn mlkem_prf(eta: i64, s: mut ref i64, b: u32, out: mut ref i64) -> i64 {
  let prf_tmp: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(s, 0, prf_tmp, 0, 32);
  let _ = buf_write_byte(prf_tmp, 32 as u32, b);
  let out_len: i64 = 64 * eta;
  return shake256_squeeze(prf_tmp, 33, out, out_len);
}

// XOF(rho, i, j) = SHAKE128(rho || i || j, 840) -- 840 bytes is a
// generous stream for 256-coefficient rejection sampling (see
// mlkem_sample_ntt), matching the scratchpad Python spike.
fn mlkem_xof(rho: mut ref i64, i_byte: u32, j_byte: u32, out: mut ref i64) -> i64 {
  let xof_tmp: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(rho, 0, xof_tmp, 0, 32);
  let _ = buf_write_byte(xof_tmp, 32 as u32, i_byte);
  let _ = buf_write_byte(xof_tmp, 33 as u32, j_byte);
  return shake128_squeeze(xof_tmp, 34, out, 840);
}

// FIPS 203 Algorithm 7 (SampleNTT): rejection-sample 12-bit values < q
// from a byte stream, 3 bytes -> up to 2 candidates.
fn mlkem_sample_ntt(stream: mut ref i64, out: mut ref i64) -> i64 {
  let sn_count: i64 = 0;
  let sn_pos: i64 = 0;
  while sn_count < 256 {
    let b0: u32 = buf_read_byte(stream, sn_pos as u32);
    let b1: u32 = buf_read_byte(stream, (sn_pos + 1) as u32);
    let b2: u32 = buf_read_byte(stream, (sn_pos + 2) as u32);
    sn_pos = sn_pos + 3;
    let d1: u32 = b0 | ((b1 & (15 as u32)) << (8 as u32));
    let d2: u32 = (b1 >> (4 as u32)) | (b2 << (4 as u32));
    if d1 < (3329 as u32) {
      if sn_count < 256 {
        let _ = buf_write_u32(out, (sn_count * 4) as u32, d1);
        sn_count = sn_count + 1;
      }
    }
    if d2 < (3329 as u32) {
      if sn_count < 256 {
        let _ = buf_write_u32(out, (sn_count * 4) as u32, d2);
        sn_count = sn_count + 1;
      }
    }
  }
  return 0;
}

// FIPS 203 Algorithm 8 (SamplePolyCBD_eta) from a PRF output stream.
fn mlkem_sample_poly_cbd(stream: mut ref i64, eta: i64, out: mut ref i64) -> i64 {
  let cbd_i: i64 = 0;
  while cbd_i < 256 {
    let x: i64 = 0;
    let xa: i64 = 0;
    while xa < eta {
      let xbitpos: i64 = 2 * cbd_i * eta + xa;
      let xbyte_idx: i64 = xbitpos / 8;
      let xbit_idx: i64 = xbitpos % 8;
      let xbyteval: u32 = buf_read_byte(stream, xbyte_idx as u32);
      let xbit: u32 = (xbyteval >> (xbit_idx as u32)) & (1 as u32);
      x = x + (xbit as i64);
      xa = xa + 1;
    }
    let y: i64 = 0;
    let ya: i64 = 0;
    while ya < eta {
      let ybitpos: i64 = 2 * cbd_i * eta + eta + ya;
      let ybyte_idx: i64 = ybitpos / 8;
      let ybit_idx: i64 = ybitpos % 8;
      let ybyteval: u32 = buf_read_byte(stream, ybyte_idx as u32);
      let ybit: u32 = (ybyteval >> (ybit_idx as u32)) & (1 as u32);
      y = y + (ybit as i64);
      ya = ya + 1;
    }
    let diff: i64 = x - y;
    let val: u32 = ((diff + 3329) % 3329) as u32;
    let _ = buf_write_u32(out, (cbd_i * 4) as u32, val);
    cbd_i = cbd_i + 1;
  }
  return 0;
}

// G(msg) = SHA3-512(msg), split into two 32-byte halves. Uses
// mlkem_tmp2 purely as transient hash-output scratch.
fn mlkem_g(msg: mut ref i64, msg_len: i64, out_a: mut ref i64, out_b: mut ref i64) -> i64 {
  let g_full: mut ref i64 = mlkem_tmp2_get();
  let _ = sha3_512_hash(msg, msg_len, g_full);
  let ga_i: i64 = 0;
  while ga_i < 32 {
    let _ = buf_write_byte(out_a, ga_i as u32, buf_read_byte(g_full, ga_i as u32));
    ga_i = ga_i + 1;
  }
  let gb_i: i64 = 0;
  while gb_i < 32 {
    let _ = buf_write_byte(out_b, gb_i as u32, buf_read_byte(g_full, (32 + gb_i) as u32));
    gb_i = gb_i + 1;
  }
  return 0;
}

fn mlkem_h(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  return sha3_256_hash(msg, msg_len, out);
}

fn mlkem_j(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  return shake256_squeeze(msg, msg_len, out, 32);
}

// K=2 (fixed for ML-KEM-512) matrix generation: A_hat[i][j] =
// SampleNTT(XOF(rho, j, i)), matching FIPS 203's generate_matrix with
// transpose=False -- both K-PKE KeyGen and Encrypt call it this same
// way, with Encrypt applying the transpose at USE time (reading
// A_hat[j][i] instead of A_hat[i][j]) rather than at generation time.
fn mlkem_generate_matrix(rho: mut ref i64) -> i64 {
  let gm_xof: mut ref i64 = mlkem_xof_out_get();
  let a00: mut ref i64 = mlkem_a00_get();
  let a01: mut ref i64 = mlkem_a01_get();
  let a10: mut ref i64 = mlkem_a10_get();
  let a11: mut ref i64 = mlkem_a11_get();
  let _ = mlkem_xof(rho, 0 as u32, 0 as u32, gm_xof);
  let _ = mlkem_sample_ntt(gm_xof, a00);
  let _ = mlkem_xof(rho, 1 as u32, 0 as u32, gm_xof);
  let _ = mlkem_sample_ntt(gm_xof, a01);
  let _ = mlkem_xof(rho, 0 as u32, 1 as u32, gm_xof);
  let _ = mlkem_sample_ntt(gm_xof, a10);
  let _ = mlkem_xof(rho, 1 as u32, 1 as u32, gm_xof);
  let _ = mlkem_sample_ntt(gm_xof, a11);
  return 0;
}

// FIPS 203 Algorithm 13 (K-PKE.KeyGen), K=2 explicitly unrolled.
// out_ek: 800 bytes (t0||t1||rho). out_dk: dk_pke only, 768 bytes
// (s_hat0||s_hat1) -- callers building a full ML-KEM dk pass a larger
// buffer and this writes just its first 768 bytes.
fn mlkem_k_pke_keygen(d: mut ref i64, out_ek: mut ref i64, out_dk: mut ref i64) -> i64 {
  let kg_tmp: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(d, 0, kg_tmp, 0, 32);
  let _ = buf_write_byte(kg_tmp, 32 as u32, 2 as u32);
  let rho: mut ref i64 = mlkem_rho_get();
  let sigma: mut ref i64 = mlkem_sigma_get();
  let _ = mlkem_g(kg_tmp, 33, rho, sigma);

  let _ = mlkem_generate_matrix(rho);
  let a00: mut ref i64 = mlkem_a00_get();
  let a01: mut ref i64 = mlkem_a01_get();
  let a10: mut ref i64 = mlkem_a10_get();
  let a11: mut ref i64 = mlkem_a11_get();

  let prf_out: mut ref i64 = mlkem_prf_out_get();
  let s0: mut ref i64 = mlkem_s0_get();
  let s1: mut ref i64 = mlkem_s1_get();
  let e0: mut ref i64 = mlkem_e0_get();
  let e1: mut ref i64 = mlkem_e1_get();
  let _ = mlkem_prf(3, sigma, 0 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, s0);
  let _ = mlkem_prf(3, sigma, 1 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, s1);
  let _ = mlkem_prf(3, sigma, 2 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, e0);
  let _ = mlkem_prf(3, sigma, 3 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, e1);

  let _ = mlkem_ntt(s0);
  let _ = mlkem_ntt(s1);
  let _ = mlkem_ntt(e0);
  let _ = mlkem_ntt(e1);

  let acc: mut ref i64 = mlkem_acc_get();
  let w: mut ref i64 = mlkem_w_get();
  let t0: mut ref i64 = mlkem_t0_get();
  let t1: mut ref i64 = mlkem_t1_get();

  let _ = mlkem_multiply_ntts(a00, s0, acc);
  let _ = mlkem_multiply_ntts(a01, s1, w);
  let _ = mlkem_poly_add(acc, w, acc);
  let _ = mlkem_poly_add(acc, e0, t0);

  let _ = mlkem_multiply_ntts(a10, s0, acc);
  let _ = mlkem_multiply_ntts(a11, s1, w);
  let _ = mlkem_poly_add(acc, w, acc);
  let _ = mlkem_poly_add(acc, e1, t1);

  let _ = mlkem_byte_encode(t0, 12, 3329 as u32, out_ek, 0);
  let _ = mlkem_byte_encode(t1, 12, 3329 as u32, out_ek, 384);
  let _ = mlkem_buf_copy(rho, 0, out_ek, 768, 32);
  let _ = mlkem_byte_encode(s0, 12, 3329 as u32, out_dk, 0);
  let _ = mlkem_byte_encode(s1, 12, 3329 as u32, out_dk, 384);
  return 0;
}

// FIPS 203 Algorithm 14 (K-PKE.Encrypt), K=2 explicitly unrolled.
// ek: 800 bytes. m, r_seed: 32 bytes each. out_c: 768 bytes (c1||c2).
fn mlkem_k_pke_encrypt(ek: mut ref i64, m: mut ref i64, r_seed: mut ref i64, out_c: mut ref i64) -> i64 {
  let t0: mut ref i64 = mlkem_t0_get();
  let t1: mut ref i64 = mlkem_t1_get();
  let rho: mut ref i64 = mlkem_rho_get();
  let _ = mlkem_byte_decode(ek, 0, 12, 3329 as u32, t0);
  let _ = mlkem_byte_decode(ek, 384, 12, 3329 as u32, t1);
  let _ = mlkem_buf_copy(ek, 768, rho, 0, 32);

  let _ = mlkem_generate_matrix(rho);
  let a00: mut ref i64 = mlkem_a00_get();
  let a01: mut ref i64 = mlkem_a01_get();
  let a10: mut ref i64 = mlkem_a10_get();
  let a11: mut ref i64 = mlkem_a11_get();

  let prf_out: mut ref i64 = mlkem_prf_out_get();
  let r0: mut ref i64 = mlkem_r0_get();
  let r1: mut ref i64 = mlkem_r1_get();
  let ee1_0: mut ref i64 = mlkem_enc_e1_0_get();
  let ee1_1: mut ref i64 = mlkem_enc_e1_1_get();
  let e2: mut ref i64 = mlkem_e2_get();
  let _ = mlkem_prf(3, r_seed, 0 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, r0);
  let _ = mlkem_prf(3, r_seed, 1 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 3, r1);
  let _ = mlkem_prf(2, r_seed, 2 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 2, ee1_0);
  let _ = mlkem_prf(2, r_seed, 3 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 2, ee1_1);
  let _ = mlkem_prf(2, r_seed, 4 as u32, prf_out);
  let _ = mlkem_sample_poly_cbd(prf_out, 2, e2);

  let _ = mlkem_ntt(r0);
  let _ = mlkem_ntt(r1);

  let acc: mut ref i64 = mlkem_acc_get();
  let w: mut ref i64 = mlkem_w_get();
  let u0: mut ref i64 = mlkem_u0_get();
  let u1: mut ref i64 = mlkem_u1_get();

  let _ = mlkem_multiply_ntts(a00, r0, acc);
  let _ = mlkem_multiply_ntts(a10, r1, w);
  let _ = mlkem_poly_add(acc, w, acc);
  let _ = mlkem_ntt_inv(acc);
  let _ = mlkem_poly_add(acc, ee1_0, u0);

  let _ = mlkem_multiply_ntts(a01, r0, acc);
  let _ = mlkem_multiply_ntts(a11, r1, w);
  let _ = mlkem_poly_add(acc, w, acc);
  let _ = mlkem_ntt_inv(acc);
  let _ = mlkem_poly_add(acc, ee1_1, u1);

  let mu: mut ref i64 = mlkem_mu_get();
  let _ = mlkem_msg_to_poly(m, mu);

  let _ = mlkem_multiply_ntts(t0, r0, acc);
  let _ = mlkem_multiply_ntts(t1, r1, w);
  let _ = mlkem_poly_add(acc, w, acc);
  let _ = mlkem_ntt_inv(acc);
  let _ = mlkem_poly_add(acc, e2, acc);
  let v: mut ref i64 = mlkem_v_get();
  let _ = mlkem_poly_add(acc, mu, v);

  let _ = mlkem_compress_poly(u0, 10, w);
  let _ = mlkem_byte_encode(w, 10, 1024 as u32, out_c, 0);
  let _ = mlkem_compress_poly(u1, 10, w);
  let _ = mlkem_byte_encode(w, 10, 1024 as u32, out_c, 320);
  let _ = mlkem_compress_poly(v, 4, w);
  let _ = mlkem_byte_encode(w, 4, 16 as u32, out_c, 640);
  return 0;
}

// FIPS 203 Algorithm 15 (K-PKE.Decrypt), K=2 explicitly unrolled.
// dk: 768 bytes (dk_pke, or the first 768 bytes of a full ML-KEM dk).
// c: 768 bytes. out_m: 32 bytes.
fn mlkem_k_pke_decrypt(dk: mut ref i64, c: mut ref i64, out_m: mut ref i64) -> i64 {
  let u0: mut ref i64 = mlkem_u0_get();
  let u1: mut ref i64 = mlkem_u1_get();
  let v: mut ref i64 = mlkem_v_get();
  let w: mut ref i64 = mlkem_w_get();

  let _ = mlkem_byte_decode(c, 0, 10, 1024 as u32, w);
  let _ = mlkem_decompress_poly(w, 10, u0);
  let _ = mlkem_byte_decode(c, 320, 10, 1024 as u32, w);
  let _ = mlkem_decompress_poly(w, 10, u1);
  let _ = mlkem_byte_decode(c, 640, 4, 16 as u32, w);
  let _ = mlkem_decompress_poly(w, 4, v);

  let s0: mut ref i64 = mlkem_s0_get();
  let s1: mut ref i64 = mlkem_s1_get();
  let _ = mlkem_byte_decode(dk, 0, 12, 3329 as u32, s0);
  let _ = mlkem_byte_decode(dk, 384, 12, 3329 as u32, s1);

  let _ = mlkem_ntt(u0);
  let _ = mlkem_ntt(u1);

  let acc: mut ref i64 = mlkem_acc_get();
  let wacc: mut ref i64 = mlkem_e2_get();
  let _ = mlkem_multiply_ntts(s0, u0, acc);
  let _ = mlkem_multiply_ntts(s1, u1, wacc);
  let _ = mlkem_poly_add(acc, wacc, acc);
  let _ = mlkem_ntt_inv(acc);

  let wfinal: mut ref i64 = mlkem_enc_e1_0_get();
  let _ = mlkem_poly_sub(v, acc, wfinal);
  let _ = mlkem_poly_to_msg(wfinal, out_m);
  return 0;
}

// FIPS 203 Algorithm 16 (ML-KEM.KeyGen_internal). d, z: 32 bytes each.
// out_ek: 800 bytes. out_dk: 1632 bytes (dk_pke||ek_pke||H(ek)||z).
fn mlkem_keygen_internal(d: mut ref i64, z: mut ref i64, out_ek: mut ref i64, out_dk: mut ref i64) -> i64 {
  let _ = mlkem_k_pke_keygen(d, out_ek, out_dk);
  let h: mut ref i64 = mlkem_h_buf_get();
  let _ = mlkem_h(out_ek, 800, h);
  let _ = mlkem_buf_copy(out_ek, 0, out_dk, 768, 800);
  let _ = mlkem_buf_copy(h, 0, out_dk, 1568, 32);
  let _ = mlkem_buf_copy(z, 0, out_dk, 1600, 32);
  return 0;
}

// FIPS 203 Algorithm 17 (ML-KEM.Encaps_internal). ek: 800 bytes.
// m: 32 bytes. out_K: 32 bytes. out_c: 768 bytes.
fn mlkem_encaps_internal(ek: mut ref i64, m: mut ref i64, out_k: mut ref i64, out_c: mut ref i64) -> i64 {
  let h: mut ref i64 = mlkem_h_buf_get();
  let _ = mlkem_h(ek, 800, h);
  let cat: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(m, 0, cat, 0, 32);
  let _ = mlkem_buf_copy(h, 0, cat, 32, 32);
  let r: mut ref i64 = mlkem_rprime_buf_get();
  let _ = mlkem_g(cat, 64, out_k, r);
  let _ = mlkem_k_pke_encrypt(ek, m, r, out_c);
  return 0;
}

// FIPS 203 Algorithm 18 (ML-KEM.Decaps_internal), including the
// implicit-rejection substitution that resists chosen-ciphertext
// attacks: on any ciphertext re-encryption mismatch, the returned key
// is K_bar = J(z||c) instead of the (attacker-influenced) decrypted
// key. dk: 1632 bytes. c: 768 bytes. out_K: 32 bytes.
fn mlkem_decaps_internal(dk: mut ref i64, c: mut ref i64, out_k: mut ref i64) -> i64 {
  let h: mut ref i64 = mlkem_h_buf_get();
  let _ = mlkem_buf_copy(dk, 1568, h, 0, 32);
  let z: mut ref i64 = mlkem_z_buf_get();
  let _ = mlkem_buf_copy(dk, 1600, z, 0, 32);

  let m_prime: mut ref i64 = mlkem_mprime_buf_get();
  let _ = mlkem_k_pke_decrypt(dk, c, m_prime);

  let cat1: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(m_prime, 0, cat1, 0, 32);
  let _ = mlkem_buf_copy(h, 0, cat1, 32, 32);
  let k_prime: mut ref i64 = mlkem_kprime_buf_get();
  let r_prime: mut ref i64 = mlkem_rprime_buf_get();
  let _ = mlkem_g(cat1, 64, k_prime, r_prime);

  let cat2: mut ref i64 = mlkem_tmp1_get();
  let _ = mlkem_buf_copy(z, 0, cat2, 0, 32);
  let _ = mlkem_buf_copy(c, 0, cat2, 32, 768);
  let k_bar: mut ref i64 = mlkem_kbar_buf_get();
  let _ = mlkem_j(cat2, 800, k_bar);

  let ek_pke: mut ref i64 = mlkem_ekpke_buf_get();
  let _ = mlkem_buf_copy(dk, 768, ek_pke, 0, 800);
  let c_prime: mut ref i64 = mlkem_cprime_buf_get();
  let _ = mlkem_k_pke_encrypt(ek_pke, m_prime, r_prime, c_prime);

  let eq: i64 = keccak_bytes_equal(c, c_prime, 768);
  if eq == 1 {
    let _ = mlkem_buf_copy(k_prime, 0, out_k, 0, 32);
  } else {
    let _ = mlkem_buf_copy(k_bar, 0, out_k, 0, 32);
  }
  return 0;
}

// Round-trip self-test: deterministic seed bytes (no external RNG in
// this environment), keygen -> encaps -> decaps, assert the
// decapsulated key matches the encapsulated one. This is an internal
// consistency check for the ARM-compiled code (catches buffer sizing,
// aliasing, and off-by-one bugs); the algorithm's byte-exact match
// against FIPS 203 / kyber-py is separately verified in
// test/host_harness against a real known-answer vector.
fn mlkem_self_test() -> i64 {
  let _ = mlkem_init();

  let d: mut ref i64 = dhruva_alloc_bytes(32);
  let z: mut ref i64 = dhruva_alloc_bytes(32);
  let m: mut ref i64 = dhruva_alloc_bytes(32);
  let seed_i: i64 = 0;
  while seed_i < 32 {
    let _ = buf_write_byte(d, seed_i as u32, (seed_i * 7 + 1) as u32);
    let _ = buf_write_byte(z, seed_i as u32, (seed_i * 11 + 3) as u32);
    let _ = buf_write_byte(m, seed_i as u32, (seed_i * 13 + 5) as u32);
    seed_i = seed_i + 1;
  }

  let ek: mut ref i64 = dhruva_alloc_bytes(800);
  let dk: mut ref i64 = dhruva_alloc_bytes(1632);
  let _ = mlkem_keygen_internal(d, z, ek, dk);

  let k1: mut ref i64 = dhruva_alloc_bytes(32);
  let c: mut ref i64 = dhruva_alloc_bytes(768);
  let _ = mlkem_encaps_internal(ek, m, k1, c);

  let k2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = mlkem_decaps_internal(dk, c, k2);

  let ok: i64 = keccak_bytes_equal(k1, k2, 32);
  let _ = uart_puts("CRYPTO: ML-KEM-512 (FIPS 203) round-trip self-test");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return ok;
}

// Scoped-down TLS 1.3 (RFC 8446) handshake + record layer:
// TLS_CHACHA20_POLY1305_SHA256 cipher suite only, x25519 key exchange
// only, ed25519 signatures only, RFC 7250 raw public keys
// (server-authenticated only, no client cert, no session
// resumption/PSK/0-RTT/renegotiation). Verified against a from-
// scratch Python reference (tls13_ref.py) that itself checks byte-
// exact against the `cryptography` library's own X25519/Ed25519/
// ChaCha20Poly1305 primitives -- same discipline as every other
// primitive this round. Message shapes here are all FIXED size given
// this scope (single cipher suite/group/sigalg, no variable-length
// extensions), so lengths below are literal constants derived by
// hand from the wire format, not computed dynamically.

fn tls_copy(dst: mut ref i64, dst_off: i64, src: mut ref i64, src_off: i64, n: i64) -> i64 {
  let ci: i64 = 0;
  while ci < n {
    let _ = buf_write_byte(dst, (dst_off + ci) as u32, buf_read_byte(src, (src_off + ci) as u32));
    ci = ci + 1;
  }
  return dst_off + n;
}

fn tls_put_u8(buf: mut ref i64, off: i64, v: u32) -> i64 {
  let _ = buf_write_byte(buf, off as u32, v & (255 as u32));
  return off + 1;
}

fn tls_put_u16(buf: mut ref i64, off: i64, v: u32) -> i64 {
  let _ = buf_write_byte(buf, off as u32, (v >> (8 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 1) as u32, v & (255 as u32));
  return off + 2;
}

fn tls_put_u24(buf: mut ref i64, off: i64, v: i64) -> i64 {
  let vu: u32 = v as u32;
  let _ = buf_write_byte(buf, off as u32, (vu >> (16 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 1) as u32, (vu >> (8 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 2) as u32, vu & (255 as u32));
  return off + 3;
}

fn tls_x25519_basepoint(out: mut ref i64) -> i64 {
  let bi: i64 = 0;
  while bi < 32 {
    let _ = buf_write_byte(out, bi as u32, 0 as u32);
    bi = bi + 1;
  }
  let _ = buf_write_byte(out, 0 as u32, 9 as u32);
  return 0;
}

// --- Handshake message builders (RFC 8446 4.1.2/4.1.3/4.3.1/4.3.2/4.4.4) ---
// Wire layout and byte counts are documented in this round's own
// tls13_ref.py, which builds the identical structure and was used to
// derive every literal length constant below.

fn tls_build_client_hello(client_random: mut ref i64, client_pub: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 1 as u32);
  o = tls_put_u24(out, o, 108);
  o = tls_put_u16(out, o, 0x0303 as u32);
  o = tls_copy(out, o, client_random, 0, 32);
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_put_u16(out, o, 2 as u32);
  o = tls_put_u16(out, o, 0x1303 as u32);
  o = tls_put_u8(out, o, 1 as u32);
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_put_u16(out, o, 65 as u32);
  o = tls_put_u16(out, o, 43 as u32);
  o = tls_put_u16(out, o, 3 as u32);
  o = tls_put_u8(out, o, 2 as u32);
  o = tls_put_u16(out, o, 0x0304 as u32);
  o = tls_put_u16(out, o, 10 as u32);
  o = tls_put_u16(out, o, 4 as u32);
  o = tls_put_u16(out, o, 2 as u32);
  o = tls_put_u16(out, o, 0x001D as u32);
  o = tls_put_u16(out, o, 13 as u32);
  o = tls_put_u16(out, o, 4 as u32);
  o = tls_put_u16(out, o, 2 as u32);
  o = tls_put_u16(out, o, 0x0807 as u32);
  o = tls_put_u16(out, o, 51 as u32);
  o = tls_put_u16(out, o, 38 as u32);
  o = tls_put_u16(out, o, 36 as u32);
  o = tls_put_u16(out, o, 0x001D as u32);
  o = tls_put_u16(out, o, 32 as u32);
  o = tls_copy(out, o, client_pub, 0, 32);
  return o;
}

fn tls_build_server_hello(server_random: mut ref i64, server_pub: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 2 as u32);
  o = tls_put_u24(out, o, 86);
  o = tls_put_u16(out, o, 0x0303 as u32);
  o = tls_copy(out, o, server_random, 0, 32);
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_put_u16(out, o, 0x1303 as u32);
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_put_u16(out, o, 46 as u32);
  o = tls_put_u16(out, o, 43 as u32);
  o = tls_put_u16(out, o, 2 as u32);
  o = tls_put_u16(out, o, 0x0304 as u32);
  o = tls_put_u16(out, o, 51 as u32);
  o = tls_put_u16(out, o, 36 as u32);
  o = tls_put_u16(out, o, 0x001D as u32);
  o = tls_put_u16(out, o, 32 as u32);
  o = tls_copy(out, o, server_pub, 0, 32);
  return o;
}

fn tls_build_encrypted_extensions(out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 8 as u32);
  o = tls_put_u24(out, o, 2);
  o = tls_put_u16(out, o, 0 as u32);
  return o;
}

fn tls_build_certificate(raw_pubkey: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 11 as u32);
  o = tls_put_u24(out, o, 41);
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_put_u24(out, o, 37);
  o = tls_put_u24(out, o, 32);
  o = tls_copy(out, o, raw_pubkey, 0, 32);
  o = tls_put_u16(out, o, 0 as u32);
  return o;
}

fn tls_build_certificate_verify(sig: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 15 as u32);
  o = tls_put_u24(out, o, 68);
  o = tls_put_u16(out, o, 0x0807 as u32);
  o = tls_put_u16(out, o, 64 as u32);
  o = tls_copy(out, o, sig, 0, 64);
  return o;
}

fn tls_build_finished(verify_data: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 20 as u32);
  o = tls_put_u24(out, o, 32);
  o = tls_copy(out, o, verify_data, 0, 32);
  return o;
}

// RFC 8446 4.4.3: 64 spaces || context string || 0x00 || transcript hash.
fn tls_certverify_signed_content(transcript_hash: mut ref i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  let pad_i: i64 = 0;
  while pad_i < 64 {
    let _ = buf_write_byte(out, o as u32, 0x20 as u32);
    o = o + 1;
    pad_i = pad_i + 1;
  }
  let ctx: Str = "TLS 1.3, server CertificateVerify";
  let ctx_len: i64 = str_len_bytes(ctx);
  let ctx_i: i64 = 0;
  while ctx_i < ctx_len {
    let _ = buf_write_byte(out, (o + ctx_i) as u32, str_byte_at(ctx, ctx_i) as u32);
    ctx_i = ctx_i + 1;
  }
  o = o + ctx_len;
  o = tls_put_u8(out, o, 0 as u32);
  o = tls_copy(out, o, transcript_hash, 0, 32);
  return o;
}

// --- Key schedule (RFC 8446 7.1) ---

// HKDF-Expand-Label(Secret, Label, Context, Length). `label` excludes
// the "tls13 " prefix (added here); `context` is `context_len` raw
// bytes (already-hashed transcript, or empty for "key"/"iv"/
// "finished" derivations).
fn tls_hkdf_expand_label(secret: mut ref i64, label: Str, context: mut ref i64, context_len: i64, length: i64, out: mut ref i64) -> i64 {
  let hl: mut ref i64 = tls_hkdf_label_scratch_get();
  let o: i64 = 0;
  o = tls_put_u16(hl, o, length as u32);
  let prefix: Str = "tls13 ";
  let prefix_len: i64 = str_len_bytes(prefix);
  let label_len: i64 = str_len_bytes(label);
  let full_label_len: i64 = prefix_len + label_len;
  o = tls_put_u8(hl, o, full_label_len as u32);
  let pfx_i: i64 = 0;
  while pfx_i < prefix_len {
    let _ = buf_write_byte(hl, (o + pfx_i) as u32, str_byte_at(prefix, pfx_i) as u32);
    pfx_i = pfx_i + 1;
  }
  o = o + prefix_len;
  let lbl_i: i64 = 0;
  while lbl_i < label_len {
    let _ = buf_write_byte(hl, (o + lbl_i) as u32, str_byte_at(label, lbl_i) as u32);
    lbl_i = lbl_i + 1;
  }
  o = o + label_len;
  o = tls_put_u8(hl, o, context_len as u32);
  o = tls_copy(hl, o, context, 0, context_len);

  let t_scratch: mut ref i64 = hkdf_t_scratch_get();
  let hmac_input_scratch: mut ref i64 = hkdf_hmac_input_scratch_get();
  return hkdf_expand(secret, 32, hl, o, length, t_scratch, hmac_input_scratch, out);
}

// Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret,
// Label, Transcript-Hash(Messages), Hash.length).
fn tls_derive_secret(secret: mut ref i64, label: Str, transcript: mut ref i64, transcript_len: i64, out: mut ref i64) -> i64 {
  let th: mut ref i64 = tls_hash_scratch_get();
  let _ = sha256_hash(transcript, transcript_len, th);
  return tls_hkdf_expand_label(secret, label, th, 32, 32, out);
}

fn tls_derive_traffic_keys(secret: mut ref i64, out_key: mut ref i64, out_iv: mut ref i64) -> i64 {
  let dummy: mut ref i64 = tls_hash_scratch_get();
  let _ = tls_hkdf_expand_label(secret, "key", dummy, 0, 32, out_key);
  let _ = tls_hkdf_expand_label(secret, "iv", dummy, 0, 12, out_iv);
  return 0;
}

// finished_key = HKDF-Expand-Label(BaseKey, "finished", "", 32);
// verify_data = HMAC(finished_key, Transcript-Hash(Messages)).
fn tls_finished_verify_data(traffic_secret: mut ref i64, transcript: mut ref i64, transcript_len: i64, out: mut ref i64) -> i64 {
  let fk: mut ref i64 = tls_finished_key_scratch_get();
  let dummy: mut ref i64 = tls_hash_scratch_get();
  let _ = tls_hkdf_expand_label(traffic_secret, "finished", dummy, 0, 32, fk);
  let th: mut ref i64 = tls_hash_scratch_get();
  let _ = sha256_hash(transcript, transcript_len, th);
  return hmac_sha256(fk, 32, th, 32, out);
}

// --- Record layer (RFC 8446 5.2/5.3) ---

// nonce = static_iv XOR (seq_num, big-endian, zero-padded to 12
// bytes) -- since seq never exceeds a handful of records here, only
// the low 4 bytes of the 12-byte padded form are ever nonzero.
fn tls_record_nonce(static_iv: mut ref i64, seq: u32, out_nonce: mut ref i64) -> i64 {
  let _ = tls_copy(out_nonce, 0, static_iv, 0, 8);
  let b3: u32 = (seq >> (24 as u32)) & (255 as u32);
  let b2: u32 = (seq >> (16 as u32)) & (255 as u32);
  let b1: u32 = (seq >> (8 as u32)) & (255 as u32);
  let b0: u32 = seq & (255 as u32);
  let iv8: u32 = buf_read_byte(static_iv, 8 as u32);
  let iv9: u32 = buf_read_byte(static_iv, 9 as u32);
  let iv10: u32 = buf_read_byte(static_iv, 10 as u32);
  let iv11: u32 = buf_read_byte(static_iv, 11 as u32);
  let _ = buf_write_byte(out_nonce, 8 as u32, iv8 ^ b3);
  let _ = buf_write_byte(out_nonce, 9 as u32, iv9 ^ b2);
  let _ = buf_write_byte(out_nonce, 10 as u32, iv10 ^ b1);
  let _ = buf_write_byte(out_nonce, 11 as u32, iv11 ^ b0);
  return 0;
}

// TLSInnerPlaintext = content || real_content_type (no padding);
// AAD = the 5-byte TLSCiphertext header (opaque_type=0x17,
// legacy_record_version=0x0303, length). Returns the total record
// length (5-byte header + ciphertext + 16-byte tag) written to
// `out_record`.
fn tls_encrypt_record(key: mut ref i64, static_iv: mut ref i64, seq: u32, content: mut ref i64, content_len: i64, content_type: u32, out_record: mut ref i64) -> i64 {
  let inner: mut ref i64 = tls_content_scratch_get();
  let _ = tls_copy(inner, 0, content, 0, content_len);
  let _ = buf_write_byte(inner, content_len as u32, content_type);
  let inner_len: i64 = content_len + 1;

  let aad: mut ref i64 = tls_record_aad_get();
  let record_len_field: i64 = inner_len + 16;
  let _ = buf_write_byte(aad, 0 as u32, 0x17 as u32);
  let _ = buf_write_byte(aad, 1 as u32, 0x03 as u32);
  let _ = buf_write_byte(aad, 2 as u32, 0x03 as u32);
  let _ = buf_write_byte(aad, 3 as u32, ((record_len_field / 256) as u32) & (255 as u32));
  let _ = buf_write_byte(aad, 4 as u32, (record_len_field as u32) & (255 as u32));

  let nonce: mut ref i64 = tls_record_nonce_get();
  let _ = tls_record_nonce(static_iv, seq, nonce);

  let _ = tls_copy(out_record, 0, aad, 0, 5);

  let ct_out: mut ref i64 = tls_record_scratch_get();
  let tag_out: mut ref i64 = tls_tag_in_get();
  let _ = chacha20_poly1305_encrypt_heap(key, nonce, aad, 5, inner, inner_len, ct_out, tag_out);
  let _ = tls_copy(out_record, 5, ct_out, 0, inner_len);
  let _ = tls_copy(out_record, 5 + inner_len, tag_out, 0, 16);
  return 5 + inner_len + 16;
}

// Decrypts `record` (record_len bytes) and verifies its inner content
// type equals `expected_content_type` -- "reject, don't guess" for a
// type mismatch, same posture as every other integrity check in this
// codebase. Returns content_len on success, -1 on tag failure, wrong
// type, or a malformed (too-short) record.
fn tls_decrypt_record(key: mut ref i64, static_iv: mut ref i64, seq: u32, rec_data: mut ref i64, record_len: i64, expected_content_type: u32, out_content: mut ref i64) -> i64 {
  let ct_len: i64 = record_len - 5 - 16;
  if ct_len < 0 {
    return 0 - 1;
  }
  let header: mut ref i64 = tls_record_aad_get();
  let _ = tls_copy(header, 0, rec_data, 0, 5);
  let ct_scratch: mut ref i64 = tls_record_scratch_get();
  let _ = tls_copy(ct_scratch, 0, rec_data, 5, ct_len);
  let tag_in: mut ref i64 = tls_tag_in_get();
  let _ = tls_copy(tag_in, 0, rec_data, 5 + ct_len, 16);

  let nonce: mut ref i64 = tls_record_nonce_get();
  let _ = tls_record_nonce(static_iv, seq, nonce);

  let inner: mut ref i64 = tls_content_scratch_get();
  let rc: i64 = chacha20_poly1305_decrypt_heap(key, nonce, header, 5, ct_scratch, ct_len, tag_in, inner);
  if rc != 0 {
    return 0 - 1;
  }
  let content_len: i64 = ct_len - 1;
  let content_type: u32 = buf_read_byte(inner, content_len as u32);
  if content_type != expected_content_type {
    return 0 - 1;
  }
  let _ = tls_copy(out_content, 0, inner, 0, content_len);
  return content_len;
}

// Live, both-roles TLS 1.3 handshake + application-data round trip
// (scoped per this round's own header comment: TLS_CHACHA20_
// POLY1305_SHA256 / x25519 / ed25519 / RFC 7250 raw public keys).
// Deterministic seeds (no RNG in this environment) chosen to exactly
// match tls13_ref.py's own __main__ block, so this is verifiable
// end-to-end against that Python reference -- the byte-exact KAT
// itself lives in test/host_harness (key-schedule secrets + every
// record), this function proves the same logic also runs correctly
// as real, live, both-directions protocol execution on real ARM
// under QEMU (client and server roles both executed here, since this
// is a self-test of the crypto/protocol logic, not of the live TCP
// transport integration -- see docs/TODO.md for that follow-on scope).
fn tls_self_test() -> i64 {
  let ok: i64 = 1;

  let zero32: mut ref i64 = dhruva_alloc_bytes(32);
  let zi: i64 = 0;
  while zi < 32 {
    let _ = buf_write_byte(zero32, zi as u32, 0 as u32);
    zi = zi + 1;
  }

  let client_random: mut ref i64 = tls_client_random_get();
  let _ = write_hex_string(client_random, "0104070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e", 32);
  let server_random: mut ref i64 = tls_server_random_get();
  let _ = write_hex_string(server_random, "02070c11161b20252a2f34393e43484d52575c61666b70757a7f84898e93989d", 32);
  let client_priv: mut ref i64 = tls_client_x25519_priv_get();
  let _ = write_hex_string(client_priv, "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc", 32);
  let server_priv: mut ref i64 = tls_server_x25519_priv_get();
  let _ = write_hex_string(server_priv, "040f1a25303b46515c67727d88939ea9b4bfcad5e0ebf6010c17222d38434e59", 32);
  let server_id_priv: mut ref i64 = tls_server_id_priv_get();
  let _ = write_hex_string(server_id_priv, "05121f2c394653606d7a8794a1aebbc8d5e2effc091623303d4a5764717e8b98", 32);

  let basepoint: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_x25519_basepoint(basepoint);

  let client_pub: mut ref i64 = tls_client_x25519_pub_get();
  let _ = x25519_scalarmult_heap(client_priv, basepoint, client_pub);
  let server_pub: mut ref i64 = tls_server_x25519_pub_get();
  let _ = x25519_scalarmult_heap(server_priv, basepoint, server_pub);

  let shared_c: mut ref i64 = tls_shared_secret_get();
  let _ = x25519_scalarmult_heap(client_priv, server_pub, shared_c);
  let shared_s: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = x25519_scalarmult_heap(server_priv, client_pub, shared_s);
  if keccak_bytes_equal(shared_c, shared_s, 32) != 1 { ok = 0; }

  let server_id_pub: mut ref i64 = tls_server_id_pub_get();
  let _ = ed25519_secret_to_public_heap(server_id_priv, server_id_pub);

  // --- ClientHello / ServerHello ---
  let ch: mut ref i64 = tls_ch_get();
  let ch_len: i64 = tls_build_client_hello(client_random, client_pub, ch);
  let sh: mut ref i64 = tls_sh_get();
  let sh_len: i64 = tls_build_server_hello(server_random, server_pub, sh);

  let transcript: mut ref i64 = tls_transcript_get();
  let t_len_0: i64 = tls_copy(transcript, 0, ch, 0, ch_len);
  let t_len_sh: i64 = tls_copy(transcript, t_len_0, sh, 0, sh_len);

  // --- Key schedule through handshake traffic secrets ---
  let early_secret: mut ref i64 = tls_early_secret_get();
  let _ = hkdf_extract(zero32, 32, zero32, 32, early_secret);
  let derived_es: mut ref i64 = tls_derived_es_get();
  let _ = tls_derive_secret(early_secret, "derived", zero32, 0, derived_es);
  let handshake_secret: mut ref i64 = tls_handshake_secret_get();
  let _ = hkdf_extract(derived_es, 32, shared_c, 32, handshake_secret);

  let c_hs_traffic: mut ref i64 = tls_c_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "c hs traffic", transcript, t_len_sh, c_hs_traffic);
  let s_hs_traffic: mut ref i64 = tls_s_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "s hs traffic", transcript, t_len_sh, s_hs_traffic);

  let c_hs_key: mut ref i64 = tls_c_hs_key_get();
  let c_hs_iv: mut ref i64 = tls_c_hs_iv_get();
  let _ = tls_derive_traffic_keys(c_hs_traffic, c_hs_key, c_hs_iv);
  let s_hs_key: mut ref i64 = tls_s_hs_key_get();
  let s_hs_iv: mut ref i64 = tls_s_hs_iv_get();
  let _ = tls_derive_traffic_keys(s_hs_traffic, s_hs_key, s_hs_iv);

  // --- Server's encrypted flight: EncryptedExtensions, Certificate,
  // CertificateVerify, Finished ---
  let ee: mut ref i64 = tls_ee_get();
  let ee_len: i64 = tls_build_encrypted_extensions(ee);
  let cert: mut ref i64 = tls_cert_get();
  let cert_len: i64 = tls_build_certificate(server_id_pub, cert);

  let t_len_ee: i64 = tls_copy(transcript, t_len_sh, ee, 0, ee_len);
  let t_len_cert: i64 = tls_copy(transcript, t_len_ee, cert, 0, cert_len);

  let cert_transcript_hash: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(transcript, t_len_cert, cert_transcript_hash);
  let cv_content: mut ref i64 = tls_cv_signed_content_get();
  let cv_content_len: i64 = tls_certverify_signed_content(cert_transcript_hash, cv_content);
  let cv_sig: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = ed25519_sign_heap(server_id_priv, cv_content, cv_content_len, cv_sig);
  let cv: mut ref i64 = tls_cv_get();
  let cv_len: i64 = tls_build_certificate_verify(cv_sig, cv);

  let t_len_cv: i64 = tls_copy(transcript, t_len_cert, cv, 0, cv_len);
  let s_verify_data: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, s_verify_data);
  let s_fin: mut ref i64 = tls_s_fin_get();
  let s_fin_len: i64 = tls_build_finished(s_verify_data, s_fin);
  let t_len_s_fin: i64 = tls_copy(transcript, t_len_cv, s_fin, 0, s_fin_len);

  // --- Server encrypts, client decrypts + checks each message ---
  let rec_buf: mut ref i64 = tls_rec_buf_get();
  let dec_buf: mut ref i64 = tls_decrypted_scratch_get();

  let rec_len_ee: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 0 as u32, ee, ee_len, 22 as u32, rec_buf);
  let dec_len_ee: i64 = tls_decrypt_record(s_hs_key, s_hs_iv, 0 as u32, rec_buf, rec_len_ee, 22 as u32, dec_buf);
  if (dec_len_ee != ee_len) || (keccak_bytes_equal(dec_buf, ee, ee_len) != 1) { ok = 0; }

  let rec_len_cert: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 1 as u32, cert, cert_len, 22 as u32, rec_buf);
  let dec_len_cert: i64 = tls_decrypt_record(s_hs_key, s_hs_iv, 1 as u32, rec_buf, rec_len_cert, 22 as u32, dec_buf);
  if (dec_len_cert != cert_len) || (keccak_bytes_equal(dec_buf, cert, cert_len) != 1) { ok = 0; }

  let rec_len_cv: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 2 as u32, cv, cv_len, 22 as u32, rec_buf);
  let dec_len_cv: i64 = tls_decrypt_record(s_hs_key, s_hs_iv, 2 as u32, rec_buf, rec_len_cv, 22 as u32, dec_buf);
  if (dec_len_cv != cv_len) || (keccak_bytes_equal(dec_buf, cv, cv_len) != 1) { ok = 0; }

  let rec_len_s_fin: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 3 as u32, s_fin, s_fin_len, 22 as u32, rec_buf);
  let dec_len_s_fin: i64 = tls_decrypt_record(s_hs_key, s_hs_iv, 3 as u32, rec_buf, rec_len_s_fin, 22 as u32, dec_buf);
  if (dec_len_s_fin != s_fin_len) || (keccak_bytes_equal(dec_buf, s_fin, s_fin_len) != 1) { ok = 0; }

  // Tamper check: a corrupted handshake record must fail to decrypt.
  let saved_byte: u32 = buf_read_byte(rec_buf, 5 as u32);
  let _ = buf_write_byte(rec_buf, 5 as u32, saved_byte ^ (0xff as u32));
  let tamper_rc: i64 = tls_decrypt_record(s_hs_key, s_hs_iv, 3 as u32, rec_buf, rec_len_s_fin, 22 as u32, dec_buf);
  if tamper_rc >= 0 { ok = 0; }

  // --- Client verifies CertificateVerify against the (self-test-
  // known) server identity public key -- RFC 7250 pinned-key trust,
  // same model as pki_verify_raw. ---
  let recomputed_cv_content: mut ref i64 = dhruva_alloc_bytes(cv_content_len);
  let _ = tls_certverify_signed_content(cert_transcript_hash, recomputed_cv_content);
  if ed25519_verify_heap(server_id_pub, recomputed_cv_content, cv_content_len, cv_sig) != 1 { ok = 0; }

  // --- Client verifies server Finished ---
  let s_verify_data_check: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, s_verify_data_check);
  if keccak_bytes_equal(s_verify_data_check, s_verify_data, 32) != 1 { ok = 0; }

  // --- Client Finished ---
  let c_verify_data: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(c_hs_traffic, transcript, t_len_s_fin, c_verify_data);
  let c_fin: mut ref i64 = tls_c_fin_get();
  let c_fin_len: i64 = tls_build_finished(c_verify_data, c_fin);

  let rec_len_c_fin: i64 = tls_encrypt_record(c_hs_key, c_hs_iv, 0 as u32, c_fin, c_fin_len, 22 as u32, rec_buf);
  let dec_len_c_fin: i64 = tls_decrypt_record(c_hs_key, c_hs_iv, 0 as u32, rec_buf, rec_len_c_fin, 22 as u32, dec_buf);
  if (dec_len_c_fin != c_fin_len) || (keccak_bytes_equal(dec_buf, c_fin, c_fin_len) != 1) { ok = 0; }

  let c_verify_data_check: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(c_hs_traffic, transcript, t_len_s_fin, c_verify_data_check);
  if keccak_bytes_equal(c_verify_data_check, c_verify_data, 32) != 1 { ok = 0; }

  // --- Application traffic secrets (Master Secret derived from the
  // SAME Handshake Secret, transcript through server Finished only --
  // client Finished is never part of this derivation per RFC 8446). ---
  let derived_hs: mut ref i64 = tls_derived_hs_get();
  let _ = tls_derive_secret(handshake_secret, "derived", zero32, 0, derived_hs);
  let master_secret: mut ref i64 = tls_master_secret_get();
  let _ = hkdf_extract(derived_hs, 32, zero32, 32, master_secret);

  let c_ap_traffic: mut ref i64 = tls_c_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "c ap traffic", transcript, t_len_s_fin, c_ap_traffic);
  let s_ap_traffic: mut ref i64 = tls_s_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "s ap traffic", transcript, t_len_s_fin, s_ap_traffic);

  let c_ap_key: mut ref i64 = tls_c_ap_key_get();
  let c_ap_iv: mut ref i64 = tls_c_ap_iv_get();
  let _ = tls_derive_traffic_keys(c_ap_traffic, c_ap_key, c_ap_iv);
  let s_ap_key: mut ref i64 = tls_s_ap_key_get();
  let s_ap_iv: mut ref i64 = tls_s_ap_iv_get();
  let _ = tls_derive_traffic_keys(s_ap_traffic, s_ap_key, s_ap_iv);

  // --- Application data round trip, both directions ---
  let client_msg: mut ref i64 = tls_client_msg_get();
  let client_msg_str: Str = "dhruva-tls-client-hello-app-data";
  let _ = str_copy_to_buf(client_msg_str, client_msg);
  let client_msg_len: i64 = str_len_bytes(client_msg_str);

  let server_reply: mut ref i64 = tls_server_reply_get();
  let server_reply_str: Str = "dhruva-tls-server-reply-app-data";
  let _ = str_copy_to_buf(server_reply_str, server_reply);
  let server_reply_len: i64 = str_len_bytes(server_reply_str);

  let rec_len_c_msg: i64 = tls_encrypt_record(c_ap_key, c_ap_iv, 0 as u32, client_msg, client_msg_len, 23 as u32, rec_buf);
  let dec_len_c_msg: i64 = tls_decrypt_record(c_ap_key, c_ap_iv, 0 as u32, rec_buf, rec_len_c_msg, 23 as u32, dec_buf);
  if (dec_len_c_msg != client_msg_len) || (keccak_bytes_equal(dec_buf, client_msg, client_msg_len) != 1) { ok = 0; }

  let rec_len_s_reply: i64 = tls_encrypt_record(s_ap_key, s_ap_iv, 0 as u32, server_reply, server_reply_len, 23 as u32, rec_buf);
  let dec_len_s_reply: i64 = tls_decrypt_record(s_ap_key, s_ap_iv, 0 as u32, rec_buf, rec_len_s_reply, 23 as u32, dec_buf);
  if (dec_len_s_reply != server_reply_len) || (keccak_bytes_equal(dec_buf, server_reply, server_reply_len) != 1) { ok = 0; }

  let _ = uart_puts("CRYPTO: TLS 1.3 (TLS_CHACHA20_POLY1305_SHA256, x25519, RFC 7250 raw pubkeys) live handshake + app data round trip");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return ok;
}

// Wiring TLS 1.3's handshake/record layer (tls13_core.vani, above)
// into the LIVE TCP transport (tcp_conn_* -- real loopback netif
// frames, real 3-way handshake, real ACKs). tcp_conn_send_data caps
// payload_len at 64 bytes (its own retransmit-buffer capacity,
// tcp_conn_rtx_buf in tcp_state.S) -- a proven, already-shipped limit
// this file works WITHIN rather than widens (touching that buffer's
// capacity for this one new caller's convenience would be exactly the
// kind of risk this project's own "don't touch working code without a
// real forcing need" discipline warns against), so every TLS message
// here is fragmented into <=64-byte TCP sends and reassembled on the
// receiving side from a running byte accumulator -- genuinely
// realistic, since TCP itself gives no message-boundary guarantees at
// all; a version that assumed record-aligned delivery would break the
// first time fragmentation actually happened.
//
// ClientHello/ServerHello are wrapped in a real (unencrypted)
// TLSPlaintext record (RFC 8446 5.1: content type 0x16, legacy
// version, 2-byte length) here -- tls13_core.vani's own buffer-to-
// buffer self-test didn't need this framing (both sides already knew
// each message's exact length), but the live transport does, since
// the receiver has no other way to know when a complete message has
// arrived out of an arbitrary stream of 64-byte fragments.

fn tls_wrap_plaintext_record(handshake_msg: mut ref i64, handshake_msg_len: i64, out: mut ref i64) -> i64 {
  let o: i64 = 0;
  o = tls_put_u8(out, o, 0x16 as u32);
  o = tls_put_u16(out, o, 0x0303 as u32);
  o = tls_put_u16(out, o, handshake_msg_len as u32);
  o = tls_copy(out, o, handshake_msg, 0, handshake_msg_len);
  return o;
}

// Appends `new_len` bytes to the rx accumulator, whose current length
// lives in the first 4 bytes of `rx_len_buf` (a persistent counter,
// not a real buffer -- lets this state survive across many separate
// calls without threading a length parameter through every layer of
// the send/pump/extract chain above it).
fn tls_rx_feed(rx_buf: mut ref i64, rx_len_buf: mut ref i64, new_data: mut ref i64, new_len: i64) -> i64 {
  let cur_len: i64 = buf_read_u32(rx_len_buf, 0 as u32) as i64;
  let _ = tls_copy(rx_buf, cur_len, new_data, 0, new_len);
  let new_total: i64 = cur_len + new_len;
  let _ = buf_write_u32(rx_len_buf, 0 as u32, new_total as u32);
  return new_total;
}

// Peeks at the 5-byte header; if a full record's worth of bytes
// hasn't arrived yet, returns -1 and leaves the accumulator
// untouched (the caller is expected to feed more data and retry).
// Once a full record IS available, always consumes and shifts the
// remainder down -- even on a decrypt/tag failure -- so a bad record
// can never wedge the accumulator into retrying the same bytes
// forever.
fn tls_rx_try_extract_plaintext(rx_buf: mut ref i64, rx_len_buf: mut ref i64, out_content: mut ref i64) -> i64 {
  let cur_len: i64 = buf_read_u32(rx_len_buf, 0 as u32) as i64;
  if cur_len < 5 {
    return 0 - 1;
  }
  let b3: u32 = buf_read_byte(rx_buf, 3 as u32);
  let b4: u32 = buf_read_byte(rx_buf, 4 as u32);
  let declared_len: i64 = ((b3 * (256 as u32)) + b4) as i64;
  let total_needed: i64 = 5 + declared_len;
  if cur_len < total_needed {
    return 0 - 1;
  }
  let _ = tls_copy(out_content, 0, rx_buf, 5, declared_len);
  let remaining: i64 = cur_len - total_needed;
  let _ = tls_copy(rx_buf, 0, rx_buf, total_needed, remaining);
  let _ = buf_write_u32(rx_len_buf, 0 as u32, remaining as u32);
  return declared_len;
}

// Same shape as tls_rx_try_extract_plaintext, but for an AEAD-
// protected TLSCiphertext record (tls_decrypt_record does the actual
// AEAD verify + decrypt once a full record is available).
fn tls_rx_try_extract(rx_buf: mut ref i64, rx_len_buf: mut ref i64, key: mut ref i64, static_iv: mut ref i64, seq: u32, expected_content_type: u32, out_content: mut ref i64) -> i64 {
  let cur_len: i64 = buf_read_u32(rx_len_buf, 0 as u32) as i64;
  if cur_len < 5 {
    return 0 - 1;
  }
  let b3: u32 = buf_read_byte(rx_buf, 3 as u32);
  let b4: u32 = buf_read_byte(rx_buf, 4 as u32);
  let declared_len: i64 = ((b3 * (256 as u32)) + b4) as i64;
  let total_needed: i64 = 5 + declared_len;
  if cur_len < total_needed {
    return 0 - 1;
  }
  let content_len: i64 = tls_decrypt_record(key, static_iv, seq, rx_buf, total_needed, expected_content_type, out_content);
  let remaining: i64 = cur_len - total_needed;
  let _ = tls_copy(rx_buf, 0, rx_buf, total_needed, remaining);
  let _ = buf_write_u32(rx_len_buf, 0 as u32, remaining as u32);
  return content_len;
}

// Fixed byte offsets, valid only for this codebase's own fixed-shape
// ClientHello/ServerHello/Certificate (single cipher suite/group/
// sigalg, see tls13_core.vani's own header comment) -- not a general
// TLS parser, matching this whole effort's explicitly scoped-down
// interop target.
fn tls_parse_client_hello(ch: mut ref i64, out_random: mut ref i64, out_pub: mut ref i64) -> i64 {
  let _ = tls_copy(out_random, 0, ch, 6, 32);
  let _ = tls_copy(out_pub, 0, ch, 80, 32);
  return 0;
}

fn tls_parse_server_hello(sh: mut ref i64, out_random: mut ref i64, out_pub: mut ref i64) -> i64 {
  let _ = tls_copy(out_random, 0, sh, 6, 32);
  let _ = tls_copy(out_pub, 0, sh, 58, 32);
  return 0;
}

fn tls_parse_certificate_pubkey(cert: mut ref i64, out_pub: mut ref i64) -> i64 {
  let _ = tls_copy(out_pub, 0, cert, 11, 32);
  return 0;
}

// Pulls exactly one queued frame off the (loopback) netif and feeds
// it to `to_id`'s TCP state machine -- `tcp_conn_handle_segment`
// itself sends whatever reply that segment provokes (SYN-ACK, a data
// ACK, ...) right back onto the netif as a side effect, matching
// tcp_conn_self_test's own established pattern.
fn tls_deliver_one_frame(to_id: u32, my_mac: mut ref i64, out_payload: mut ref i64, max_len: i64) -> i64 {
  let frame: mut ref i64 = tls_frame_scratch_get();
  let flen: i64 = netif_recv_frame(frame, 1514);
  if flen <= 0 {
    return 0 - 1;
  }
  return tcp_conn_handle_segment(to_id, frame, flen, my_mac, my_mac, out_payload, max_len);
}

// Sends one <=64-byte chunk on `sender_id`, delivers the resulting
// data segment to `receiver_id` (feeding any payload it carries into
// the receiver's rx accumulator), then delivers the receiver's own
// ACK-of-that-data back to the sender -- keeps both sides' TCP state
// (sequence numbers, retransmit timer) consistent exactly the way a
// real two-party exchange would, not a one-sided shortcut.
fn tls_send_chunk_and_pump(sender_id: u32, receiver_id: u32, my_mac: mut ref i64, chunk: mut ref i64, chunk_len: i64, receiver_rx_buf: mut ref i64, receiver_rx_len_buf: mut ref i64) -> i64 {
  let send_status: i64 = tcp_conn_send_data(sender_id, my_mac, my_mac, chunk, chunk_len);
  if send_status != 0 {
    return 0 - 1;
  }
  let recv_scratch: mut ref i64 = tls_recv_chunk_scratch_get();
  let recv_len: i64 = tls_deliver_one_frame(receiver_id, my_mac, recv_scratch, 64);
  if recv_len > 0 {
    let _ = tls_rx_feed(receiver_rx_buf, receiver_rx_len_buf, recv_scratch, recv_len);
  }
  let ack_scratch: mut ref i64 = tls_ack_scratch_get();
  let _ = tls_deliver_one_frame(sender_id, my_mac, ack_scratch, 8);
  return recv_len;
}

// Fragments `data` into <=64-byte chunks (tcp_conn_send_data's own
// hard cap) and drives each one through the full send/deliver/ack-
// back cycle above, in order -- the receiver's rx accumulator ends up
// holding exactly `data`'s bytes regardless of how many TCP segments
// that took, ready for tls_rx_try_extract[_plaintext] to peel real
// TLS records back out of.
fn tls_send_over_tcp(sender_id: u32, receiver_id: u32, my_mac: mut ref i64, data: mut ref i64, data_len: i64, receiver_rx_buf: mut ref i64, receiver_rx_len_buf: mut ref i64) -> i64 {
  let chunk_buf: mut ref i64 = tls_chunk_scratch_get();
  let sent: i64 = 0;
  while sent < data_len {
    let remaining: i64 = data_len - sent;
    let take: i64 = if remaining < 64 { remaining } else { 64 };
    let _ = tls_copy(chunk_buf, 0, data, sent, take);
    let _ = tls_send_chunk_and_pump(sender_id, receiver_id, my_mac, chunk_buf, take, receiver_rx_buf, receiver_rx_len_buf);
    sent = sent + take;
  }
  return sent;
}

// Live, both-roles TLS 1.3 handshake + application-data round trip
// run entirely over the REAL TCP transport: a genuine 3-way TCP
// handshake, every TLS message fragmented into <=64-byte TCP sends
// (tcp_conn_send_data's own real cap) and reassembled from a running
// byte accumulator on the receiving side, real ACKs delivered back to
// the sender, and a real TCP close at the end. This is the "wired
// into the live transport" counterpart to tls_self_test (which proves
// the same crypto/protocol logic buffer-to-buffer, without touching
// TCP at all) -- same deterministic seeds as that function and as
// tls13_ref.py, so this is a genuinely independent proof that the
// SAME derived keys/messages survive real segmentation and
// reassembly, not just a second copy of the same check.
fn tls_tcp_self_test() -> i64 {
  let ok: i64 = 1;

  let _ = buf_write_u32(tls_client_rx_len_get(), 0 as u32, 0 as u32);
  let _ = buf_write_u32(tls_server_rx_len_get(), 0 as u32, 0 as u32);

  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let client_ip: u32 = 0xC0A80111 as u32;
  let server_ip: u32 = 0xC0A80112 as u32;
  let client_port: u32 = 44300 as u32;
  let server_port: u32 = 4433 as u32;

  let _ = tcp_conn_passive_open(server_id, server_ip, server_port);
  let _ = tcp_conn_active_open(client_id, my_mac, my_mac, client_ip, server_ip, client_port, server_port, 9000 as u32);

  // Real 3-way TCP handshake, same shape as tcp_conn_self_test.
  let hs_scratch: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = tls_deliver_one_frame(server_id, my_mac, hs_scratch, 64); // client's SYN
  let _ = tls_deliver_one_frame(client_id, my_mac, hs_scratch, 64); // server's SYN-ACK
  let _ = tls_deliver_one_frame(server_id, my_mac, hs_scratch, 64); // client's final ACK
  if tcp_conn_get_state(client_id) != tcp_state_established() { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_established() { ok = 0; }

  // --- Deterministic key material (matches tls_self_test / tls13_ref.py) ---
  let client_random: mut ref i64 = tls_client_random_get();
  let _ = write_hex_string(client_random, "0104070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e", 32);
  let server_random: mut ref i64 = tls_server_random_get();
  let _ = write_hex_string(server_random, "02070c11161b20252a2f34393e43484d52575c61666b70757a7f84898e93989d", 32);
  let client_priv: mut ref i64 = tls_client_x25519_priv_get();
  let _ = write_hex_string(client_priv, "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc", 32);
  let server_priv: mut ref i64 = tls_server_x25519_priv_get();
  let _ = write_hex_string(server_priv, "040f1a25303b46515c67727d88939ea9b4bfcad5e0ebf6010c17222d38434e59", 32);
  let server_id_priv: mut ref i64 = tls_server_id_priv_get();
  let _ = write_hex_string(server_id_priv, "05121f2c394653606d7a8794a1aebbc8d5e2effc091623303d4a5764717e8b98", 32);

  let basepoint: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_x25519_basepoint(basepoint);
  let client_pub: mut ref i64 = tls_client_x25519_pub_get();
  let _ = x25519_scalarmult_heap(client_priv, basepoint, client_pub);
  let server_pub: mut ref i64 = tls_server_x25519_pub_get();
  let _ = x25519_scalarmult_heap(server_priv, basepoint, server_pub);

  // The client's out-of-band-pinned copy of the server's identity key
  // (RFC 7250 trust model -- same "already known, not discovered" shape
  // as pki_pinned_key).
  let server_id_pub: mut ref i64 = tls_server_id_pub_get();
  let _ = ed25519_secret_to_public_heap(server_id_priv, server_id_pub);

  // --- ClientHello: built, wrapped in a real TLSPlaintext record,
  // fragmented over real TCP to the server. ---
  let ch: mut ref i64 = tls_ch_get();
  let ch_len: i64 = tls_build_client_hello(client_random, client_pub, ch);
  let ch_record: mut ref i64 = tls_ch_record_get();
  let ch_record_len: i64 = tls_wrap_plaintext_record(ch, ch_len, ch_record);
  let _ = tls_send_over_tcp(client_id, server_id, my_mac, ch_record, ch_record_len, tls_server_rx_buf_get(), tls_server_rx_len_get());

  let recv_ch: mut ref i64 = dhruva_alloc_bytes(256);
  let recv_ch_len: i64 = tls_rx_try_extract_plaintext(tls_server_rx_buf_get(), tls_server_rx_len_get(), recv_ch);
  if (recv_ch_len != ch_len) || (keccak_bytes_equal(recv_ch, ch, ch_len) != 1) { ok = 0; }
  let parsed_client_random: mut ref i64 = tls_parsed_client_random_get();
  let parsed_client_pub: mut ref i64 = tls_parsed_client_pub_get();
  let _ = tls_parse_client_hello(recv_ch, parsed_client_random, parsed_client_pub);

  // --- ServerHello, same pattern, other direction. ---
  let sh: mut ref i64 = tls_sh_get();
  let sh_len: i64 = tls_build_server_hello(server_random, server_pub, sh);
  let sh_record: mut ref i64 = tls_sh_record_get();
  let sh_record_len: i64 = tls_wrap_plaintext_record(sh, sh_len, sh_record);
  let _ = tls_send_over_tcp(server_id, client_id, my_mac, sh_record, sh_record_len, tls_client_rx_buf_get(), tls_client_rx_len_get());

  let recv_sh: mut ref i64 = dhruva_alloc_bytes(256);
  let recv_sh_len: i64 = tls_rx_try_extract_plaintext(tls_client_rx_buf_get(), tls_client_rx_len_get(), recv_sh);
  if (recv_sh_len != sh_len) || (keccak_bytes_equal(recv_sh, sh, sh_len) != 1) { ok = 0; }
  let parsed_server_random: mut ref i64 = tls_parsed_server_random_get();
  let parsed_server_pub: mut ref i64 = tls_parsed_server_pub_get();
  let _ = tls_parse_server_hello(recv_sh, parsed_server_random, parsed_server_pub);

  // Shared secret computed from the PARSED peer key each side actually
  // received over the wire, not the locally-generated copy.
  let shared_c: mut ref i64 = tls_shared_secret_get();
  let _ = x25519_scalarmult_heap(client_priv, parsed_server_pub, shared_c);
  let shared_s: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = x25519_scalarmult_heap(server_priv, parsed_client_pub, shared_s);
  if keccak_bytes_equal(shared_c, shared_s, 32) != 1 { ok = 0; }

  let zero32: mut ref i64 = dhruva_alloc_bytes(32);
  let zi: i64 = 0;
  while zi < 32 {
    let _ = buf_write_byte(zero32, zi as u32, 0 as u32);
    zi = zi + 1;
  }

  let transcript: mut ref i64 = tls_transcript_get();
  let t_len_0: i64 = tls_copy(transcript, 0, ch, 0, ch_len);
  let t_len_sh: i64 = tls_copy(transcript, t_len_0, sh, 0, sh_len);

  let early_secret: mut ref i64 = tls_early_secret_get();
  let _ = hkdf_extract(zero32, 32, zero32, 32, early_secret);
  let derived_es: mut ref i64 = tls_derived_es_get();
  let _ = tls_derive_secret(early_secret, "derived", zero32, 0, derived_es);
  let handshake_secret: mut ref i64 = tls_handshake_secret_get();
  let _ = hkdf_extract(derived_es, 32, shared_c, 32, handshake_secret);

  let c_hs_traffic: mut ref i64 = tls_c_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "c hs traffic", transcript, t_len_sh, c_hs_traffic);
  let s_hs_traffic: mut ref i64 = tls_s_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "s hs traffic", transcript, t_len_sh, s_hs_traffic);

  let c_hs_key: mut ref i64 = tls_c_hs_key_get();
  let c_hs_iv: mut ref i64 = tls_c_hs_iv_get();
  let _ = tls_derive_traffic_keys(c_hs_traffic, c_hs_key, c_hs_iv);
  let s_hs_key: mut ref i64 = tls_s_hs_key_get();
  let s_hs_iv: mut ref i64 = tls_s_hs_iv_get();
  let _ = tls_derive_traffic_keys(s_hs_traffic, s_hs_key, s_hs_iv);

  // --- Server's encrypted flight: 4 records built individually, then
  // concatenated and sent as ONE fragmented TCP transfer -- exercises
  // the client's reassembly loop pulling multiple complete records
  // back out of a single accumulated byte stream. ---
  let ee: mut ref i64 = tls_ee_get();
  let ee_len: i64 = tls_build_encrypted_extensions(ee);
  let cert: mut ref i64 = tls_cert_get();
  let cert_len: i64 = tls_build_certificate(server_id_pub, cert);

  let t_len_ee: i64 = tls_copy(transcript, t_len_sh, ee, 0, ee_len);
  let t_len_cert: i64 = tls_copy(transcript, t_len_ee, cert, 0, cert_len);

  let cert_hash: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(transcript, t_len_cert, cert_hash);
  let cv_content: mut ref i64 = tls_cv_signed_content_get();
  let cv_content_len: i64 = tls_certverify_signed_content(cert_hash, cv_content);
  let cv_sig: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = ed25519_sign_heap(server_id_priv, cv_content, cv_content_len, cv_sig);
  let cv: mut ref i64 = tls_cv_get();
  let cv_len: i64 = tls_build_certificate_verify(cv_sig, cv);

  let t_len_cv: i64 = tls_copy(transcript, t_len_cert, cv, 0, cv_len);
  let s_verify_data: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, s_verify_data);
  let s_fin: mut ref i64 = tls_s_fin_get();
  let s_fin_len: i64 = tls_build_finished(s_verify_data, s_fin);
  let t_len_s_fin: i64 = tls_copy(transcript, t_len_cv, s_fin, 0, s_fin_len);

  let flight: mut ref i64 = tls_flight_combined_get();
  let rec_ee_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 0 as u32, ee, ee_len, 22 as u32, flight);

  let rec_cert_scratch: mut ref i64 = dhruva_alloc_bytes(128);
  let rec_cert_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 1 as u32, cert, cert_len, 22 as u32, rec_cert_scratch);
  let flight_len_a: i64 = tls_copy(flight, rec_ee_len, rec_cert_scratch, 0, rec_cert_len);

  let rec_cv_scratch: mut ref i64 = dhruva_alloc_bytes(128);
  let rec_cv_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 2 as u32, cv, cv_len, 22 as u32, rec_cv_scratch);
  let flight_len_b: i64 = tls_copy(flight, flight_len_a, rec_cv_scratch, 0, rec_cv_len);

  let rec_s_fin_scratch: mut ref i64 = dhruva_alloc_bytes(96);
  let rec_s_fin_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 3 as u32, s_fin, s_fin_len, 22 as u32, rec_s_fin_scratch);
  let flight_len: i64 = tls_copy(flight, flight_len_b, rec_s_fin_scratch, 0, rec_s_fin_len);

  let _ = tls_send_over_tcp(server_id, client_id, my_mac, flight, flight_len, tls_client_rx_buf_get(), tls_client_rx_len_get());

  // --- Client reassembles + verifies all 4 records ---
  let dec_ee: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_ee_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 0 as u32, 22 as u32, dec_ee);
  if (dec_ee_len != ee_len) || (keccak_bytes_equal(dec_ee, ee, ee_len) != 1) { ok = 0; }

  let dec_cert: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_cert_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 1 as u32, 22 as u32, dec_cert);
  if (dec_cert_len != cert_len) || (keccak_bytes_equal(dec_cert, cert, cert_len) != 1) { ok = 0; }
  let parsed_server_id_pub: mut ref i64 = tls_parsed_server_id_pub_get();
  let _ = tls_parse_certificate_pubkey(dec_cert, parsed_server_id_pub);
  if keccak_bytes_equal(parsed_server_id_pub, server_id_pub, 32) != 1 { ok = 0; }

  let dec_cv: mut ref i64 = dhruva_alloc_bytes(128);
  let dec_cv_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 2 as u32, 22 as u32, dec_cv);
  if (dec_cv_len != cv_len) || (keccak_bytes_equal(dec_cv, cv, cv_len) != 1) { ok = 0; }

  let dec_s_fin: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_s_fin_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 3 as u32, 22 as u32, dec_s_fin);
  if (dec_s_fin_len != s_fin_len) || (keccak_bytes_equal(dec_s_fin, s_fin, s_fin_len) != 1) { ok = 0; }

  let recomputed_cv_content: mut ref i64 = dhruva_alloc_bytes(cv_content_len);
  let _ = tls_certverify_signed_content(cert_hash, recomputed_cv_content);
  if ed25519_verify_heap(parsed_server_id_pub, recomputed_cv_content, cv_content_len, cv_sig) != 1 { ok = 0; }

  let s_verify_data_check: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, s_verify_data_check);
  if keccak_bytes_equal(s_verify_data_check, s_verify_data, 32) != 1 { ok = 0; }

  // --- Client Finished, over real TCP, server verifies ---
  let c_verify_data: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = tls_finished_verify_data(c_hs_traffic, transcript, t_len_s_fin, c_verify_data);
  let c_fin: mut ref i64 = tls_c_fin_get();
  let c_fin_len: i64 = tls_build_finished(c_verify_data, c_fin);
  let rec_c_fin: mut ref i64 = dhruva_alloc_bytes(96);
  let rec_c_fin_len: i64 = tls_encrypt_record(c_hs_key, c_hs_iv, 0 as u32, c_fin, c_fin_len, 22 as u32, rec_c_fin);
  let _ = tls_send_over_tcp(client_id, server_id, my_mac, rec_c_fin, rec_c_fin_len, tls_server_rx_buf_get(), tls_server_rx_len_get());

  let dec_c_fin: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_c_fin_len: i64 = tls_rx_try_extract(tls_server_rx_buf_get(), tls_server_rx_len_get(), c_hs_key, c_hs_iv, 0 as u32, 22 as u32, dec_c_fin);
  if (dec_c_fin_len != c_fin_len) || (keccak_bytes_equal(dec_c_fin, c_fin, c_fin_len) != 1) { ok = 0; }

  // --- Application traffic secrets ---
  let derived_hs: mut ref i64 = tls_derived_hs_get();
  let _ = tls_derive_secret(handshake_secret, "derived", zero32, 0, derived_hs);
  let master_secret: mut ref i64 = tls_master_secret_get();
  let _ = hkdf_extract(derived_hs, 32, zero32, 32, master_secret);
  let c_ap_traffic: mut ref i64 = tls_c_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "c ap traffic", transcript, t_len_s_fin, c_ap_traffic);
  let s_ap_traffic: mut ref i64 = tls_s_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "s ap traffic", transcript, t_len_s_fin, s_ap_traffic);
  let c_ap_key: mut ref i64 = tls_c_ap_key_get();
  let c_ap_iv: mut ref i64 = tls_c_ap_iv_get();
  let _ = tls_derive_traffic_keys(c_ap_traffic, c_ap_key, c_ap_iv);
  let s_ap_key: mut ref i64 = tls_s_ap_key_get();
  let s_ap_iv: mut ref i64 = tls_s_ap_iv_get();
  let _ = tls_derive_traffic_keys(s_ap_traffic, s_ap_key, s_ap_iv);

  // --- Real application data, both directions, over real TCP ---
  let client_msg: mut ref i64 = tls_client_msg_get();
  let client_msg_str: Str = "dhruva-tls-client-hello-app-data";
  let _ = str_copy_to_buf(client_msg_str, client_msg);
  let client_msg_len: i64 = str_len_bytes(client_msg_str);
  let rec_client_msg: mut ref i64 = dhruva_alloc_bytes(96);
  let rec_client_msg_len: i64 = tls_encrypt_record(c_ap_key, c_ap_iv, 0 as u32, client_msg, client_msg_len, 23 as u32, rec_client_msg);
  let _ = tls_send_over_tcp(client_id, server_id, my_mac, rec_client_msg, rec_client_msg_len, tls_server_rx_buf_get(), tls_server_rx_len_get());
  let dec_client_msg: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_client_msg_len: i64 = tls_rx_try_extract(tls_server_rx_buf_get(), tls_server_rx_len_get(), c_ap_key, c_ap_iv, 0 as u32, 23 as u32, dec_client_msg);
  if (dec_client_msg_len != client_msg_len) || (keccak_bytes_equal(dec_client_msg, client_msg, client_msg_len) != 1) { ok = 0; }

  let server_reply: mut ref i64 = tls_server_reply_get();
  let server_reply_str: Str = "dhruva-tls-server-reply-app-data";
  let _ = str_copy_to_buf(server_reply_str, server_reply);
  let server_reply_len: i64 = str_len_bytes(server_reply_str);
  let rec_server_reply: mut ref i64 = dhruva_alloc_bytes(96);
  let rec_server_reply_len: i64 = tls_encrypt_record(s_ap_key, s_ap_iv, 0 as u32, server_reply, server_reply_len, 23 as u32, rec_server_reply);
  let _ = tls_send_over_tcp(server_id, client_id, my_mac, rec_server_reply, rec_server_reply_len, tls_client_rx_buf_get(), tls_client_rx_len_get());
  let dec_server_reply: mut ref i64 = dhruva_alloc_bytes(64);
  let dec_server_reply_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_ap_key, s_ap_iv, 0 as u32, 23 as u32, dec_server_reply);
  if (dec_server_reply_len != server_reply_len) || (keccak_bytes_equal(dec_server_reply, server_reply, server_reply_len) != 1) { ok = 0; }

  // --- Real TCP close ---
  let close_status: i64 = tcp_conn_close(client_id, my_mac, my_mac);
  if close_status != 0 { ok = 0; }
  let close_scratch: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = tls_deliver_one_frame(server_id, my_mac, close_scratch, 64); // client's FIN+ACK
  if tcp_conn_get_state(server_id) != tcp_state_fin_wait() { ok = 0; }
  let _ = tls_deliver_one_frame(client_id, my_mac, close_scratch, 64); // server's FIN+ACK
  if tcp_conn_get_state(client_id) != tcp_state_closed_final() { ok = 0; }
  let _ = tls_deliver_one_frame(server_id, my_mac, close_scratch, 64); // client's final ACK
  if tcp_conn_get_state(server_id) != tcp_state_closed_final() { ok = 0; }

  let _ = uart_puts("CRYPTO: TLS 1.3 wired into the live TCP transport (real handshake, fragmented sends, record reassembly, real close)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return ok;
}

// A genuinely reusable tls_connect/tls_accept API, callable more than
// once (e.g. from an interactive shell command), unlike
// tls_tcp_self_test's own one-shot inlined orchestration above. Same
// scope as everywhere else in this file (TLS_CHACHA20_POLY1305_SHA256
// / x25519 / ed25519 / RFC 7250 raw public keys, connection slots 0
// (client) and 1 (server) only, one application-data message per
// direction per connection).
//
// Concurrency model: this project's own task scheduler (task_create,
// dhruva_mutex_lock/unlock) is real but not POSIX -- no dynamic
// thread spawning, and its small fixed set of task slots is already
// committed to existing boot-time system tasks. Rather than pull in
// real task-based concurrency for what is fundamentally a same-
// machine loopback connection either way, tls_connect and tls_accept
// both drive the SAME shared step function (tls_service) -- whichever
// side has pending work advances, inline, on every call -- exactly
// the pattern tcp_conn_poll itself already uses for its own client/
// server auto-echo (see that function's own comment). Because sends
// on this loopback transport deliver synchronously (tls_send_over_tcp
// doesn't return until the peer has received and ACKed), a single
// tls_service() call typically advances BOTH sides to completion in
// one shot; the bounded retry loop below exists for correctness (and
// would matter on a less synchronous transport), not because it's
// expected to spin here.
//
// Buffer-reuse note: several intermediate values below (the
// transcript-through-certificate hash, the CertificateVerify signed
// content) are computed once by whichever side gets there first and
// read directly by the other side, rather than independently
// recomputed -- legitimate here because client and server share one
// process's memory (there is no "the client's own belief" distinct
// from "the server's own belief" of the transcript to keep separate).
// The actual cryptographic checks (ed25519_verify, the Finished MAC
// comparison) still run for real against bytes extracted from the
// wire, which is the property that matters.

fn tls_transport_init() -> i64 {
  let zero32: mut ref i64 = tls_zero32_get();
  let zi: i64 = 0;
  while zi < 32 {
    let _ = buf_write_byte(zero32, zi as u32, 0 as u32);
    zi = zi + 1;
  }
  return 0;
}

fn tls_transcript_append(data: mut ref i64, data_len: i64) -> i64 {
  let transcript: mut ref i64 = tls_transcript_get();
  let len_buf: mut ref i64 = tls_transcript_len_get();
  let cur: i64 = buf_read_u32(len_buf, 0 as u32) as i64;
  let new_len: i64 = tls_copy(transcript, cur, data, 0, data_len);
  let _ = buf_write_u32(len_buf, 0 as u32, new_len as u32);
  return new_len;
}

fn tls_derive_handshake_keys() -> i64 {
  let zero32: mut ref i64 = tls_zero32_get();
  let early_secret: mut ref i64 = tls_early_secret_get();
  let _ = hkdf_extract(zero32, 32, zero32, 32, early_secret);
  let derived_es: mut ref i64 = tls_derived_es_get();
  let _ = tls_derive_secret(early_secret, "derived", zero32, 0, derived_es);
  let handshake_secret: mut ref i64 = tls_handshake_secret_get();
  let _ = hkdf_extract(derived_es, 32, tls_shared_secret_get(), 32, handshake_secret);

  let transcript: mut ref i64 = tls_transcript_get();
  let t_len_sh: i64 = buf_read_u32(tls_t_len_sh_get(), 0 as u32) as i64;
  let c_hs_traffic: mut ref i64 = tls_c_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "c hs traffic", transcript, t_len_sh, c_hs_traffic);
  let s_hs_traffic: mut ref i64 = tls_s_hs_traffic_get();
  let _ = tls_derive_secret(handshake_secret, "s hs traffic", transcript, t_len_sh, s_hs_traffic);

  let c_hs_key: mut ref i64 = tls_c_hs_key_get();
  let c_hs_iv: mut ref i64 = tls_c_hs_iv_get();
  let _ = tls_derive_traffic_keys(c_hs_traffic, c_hs_key, c_hs_iv);
  let s_hs_key: mut ref i64 = tls_s_hs_key_get();
  let s_hs_iv: mut ref i64 = tls_s_hs_iv_get();
  let _ = tls_derive_traffic_keys(s_hs_traffic, s_hs_key, s_hs_iv);
  return 0;
}

fn tls_derive_app_keys() -> i64 {
  let zero32: mut ref i64 = tls_zero32_get();
  let handshake_secret: mut ref i64 = tls_handshake_secret_get();
  let derived_hs: mut ref i64 = tls_derived_hs_get();
  let _ = tls_derive_secret(handshake_secret, "derived", zero32, 0, derived_hs);
  let master_secret: mut ref i64 = tls_master_secret_get();
  let _ = hkdf_extract(derived_hs, 32, zero32, 32, master_secret);

  let transcript: mut ref i64 = tls_transcript_get();
  let t_len_s_fin: i64 = buf_read_u32(tls_t_len_s_fin_get(), 0 as u32) as i64;
  let c_ap_traffic: mut ref i64 = tls_c_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "c ap traffic", transcript, t_len_s_fin, c_ap_traffic);
  let s_ap_traffic: mut ref i64 = tls_s_ap_traffic_get();
  let _ = tls_derive_secret(master_secret, "s ap traffic", transcript, t_len_s_fin, s_ap_traffic);

  let c_ap_key: mut ref i64 = tls_c_ap_key_get();
  let c_ap_iv: mut ref i64 = tls_c_ap_iv_get();
  let _ = tls_derive_traffic_keys(c_ap_traffic, c_ap_key, c_ap_iv);
  let s_ap_key: mut ref i64 = tls_s_ap_key_get();
  let s_ap_iv: mut ref i64 = tls_s_ap_iv_get();
  let _ = tls_derive_traffic_keys(s_ap_traffic, s_ap_key, s_ap_iv);
  return 0;
}

// Server's whole reaction to a freshly-received ClientHello: its own
// ephemeral/identity keys, the shared secret, ServerHello, the full
// key schedule through handshake traffic keys, and the entire
// encrypted flight (EncryptedExtensions/Certificate/CertificateVerify/
// Finished), sent as one fragmented transfer.
fn tls_server_process_client_hello(recv_ch: mut ref i64, recv_ch_len: i64, my_mac: mut ref i64, client_id: u32, server_id: u32) -> i64 {
  let parsed_client_random: mut ref i64 = tls_parsed_client_random_get();
  let parsed_client_pub: mut ref i64 = tls_parsed_client_pub_get();
  let _ = tls_parse_client_hello(recv_ch, parsed_client_random, parsed_client_pub);

  let server_random: mut ref i64 = tls_server_random_get();
  let _ = write_hex_string(server_random, "02070c11161b20252a2f34393e43484d52575c61666b70757a7f84898e93989d", 32);
  let server_priv: mut ref i64 = tls_server_x25519_priv_get();
  let _ = write_hex_string(server_priv, "040f1a25303b46515c67727d88939ea9b4bfcad5e0ebf6010c17222d38434e59", 32);
  let server_id_priv: mut ref i64 = tls_server_id_priv_get();
  let _ = write_hex_string(server_id_priv, "05121f2c394653606d7a8794a1aebbc8d5e2effc091623303d4a5764717e8b98", 32);

  let basepoint: mut ref i64 = tls_basepoint_get();
  let _ = tls_x25519_basepoint(basepoint);
  let server_pub: mut ref i64 = tls_server_x25519_pub_get();
  let _ = x25519_scalarmult_heap(server_priv, basepoint, server_pub);
  let shared: mut ref i64 = tls_shared_secret_get();
  let _ = x25519_scalarmult_heap(server_priv, parsed_client_pub, shared);

  let server_id_pub: mut ref i64 = tls_server_id_pub_get();
  let _ = ed25519_secret_to_public_heap(server_id_priv, server_id_pub);

  let sh: mut ref i64 = tls_sh_get();
  let sh_len: i64 = tls_build_server_hello(server_random, server_pub, sh);
  let sh_record: mut ref i64 = tls_sh_record_get();
  let sh_record_len: i64 = tls_wrap_plaintext_record(sh, sh_len, sh_record);
  let _ = tls_send_over_tcp(server_id, client_id, my_mac, sh_record, sh_record_len, tls_client_rx_buf_get(), tls_client_rx_len_get());

  let _ = tls_transcript_append(recv_ch, recv_ch_len);
  let t_len_sh: i64 = tls_transcript_append(sh, sh_len);
  let _ = buf_write_u32(tls_t_len_sh_get(), 0 as u32, t_len_sh as u32);

  let _ = tls_derive_handshake_keys();

  let ee: mut ref i64 = tls_ee_get();
  let ee_len: i64 = tls_build_encrypted_extensions(ee);
  let cert: mut ref i64 = tls_cert_get();
  let cert_len: i64 = tls_build_certificate(server_id_pub, cert);
  let _ = tls_transcript_append(ee, ee_len);
  let t_len_cert: i64 = tls_transcript_append(cert, cert_len);
  let _ = buf_write_u32(tls_t_len_cert_get(), 0 as u32, t_len_cert as u32);

  let transcript: mut ref i64 = tls_transcript_get();
  let cert_hash: mut ref i64 = tls_cert_hash_get();
  let _ = sha256_hash(transcript, t_len_cert, cert_hash);
  let cv_content: mut ref i64 = tls_cv_signed_content_get();
  let cv_content_len: i64 = tls_certverify_signed_content(cert_hash, cv_content);
  let cv_sig: mut ref i64 = tls_cv_sig_get();
  let _ = ed25519_sign_heap(server_id_priv, cv_content, cv_content_len, cv_sig);
  let cv: mut ref i64 = tls_cv_get();
  let cv_len: i64 = tls_build_certificate_verify(cv_sig, cv);
  let t_len_cv: i64 = tls_transcript_append(cv, cv_len);
  let _ = buf_write_u32(tls_t_len_cv_get(), 0 as u32, t_len_cv as u32);

  let s_hs_traffic: mut ref i64 = tls_s_hs_traffic_get();
  let s_verify_data: mut ref i64 = tls_s_verify_data_get();
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, s_verify_data);
  let s_fin: mut ref i64 = tls_s_fin_get();
  let s_fin_len: i64 = tls_build_finished(s_verify_data, s_fin);
  let t_len_s_fin: i64 = tls_transcript_append(s_fin, s_fin_len);
  let _ = buf_write_u32(tls_t_len_s_fin_get(), 0 as u32, t_len_s_fin as u32);

  let s_hs_key: mut ref i64 = tls_s_hs_key_get();
  let s_hs_iv: mut ref i64 = tls_s_hs_iv_get();
  let flight: mut ref i64 = tls_flight_combined_get();
  let rec_ee_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 0 as u32, ee, ee_len, 22 as u32, flight);
  let rec_scratch: mut ref i64 = tls_rec_buf_get();
  let rec_cert_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 1 as u32, cert, cert_len, 22 as u32, rec_scratch);
  let flight_len_a: i64 = tls_copy(flight, rec_ee_len, rec_scratch, 0, rec_cert_len);
  let rec_cv_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 2 as u32, cv, cv_len, 22 as u32, rec_scratch);
  let flight_len_b: i64 = tls_copy(flight, flight_len_a, rec_scratch, 0, rec_cv_len);
  let rec_s_fin_len: i64 = tls_encrypt_record(s_hs_key, s_hs_iv, 3 as u32, s_fin, s_fin_len, 22 as u32, rec_scratch);
  let flight_len: i64 = tls_copy(flight, flight_len_b, rec_scratch, 0, rec_s_fin_len);

  let _ = tls_send_over_tcp(server_id, client_id, my_mac, flight, flight_len, tls_client_rx_buf_get(), tls_client_rx_len_get());
  return 0;
}

// Client's whole reaction once ServerHello + the encrypted flight are
// available in its rx accumulator: parses ServerHello, decrypts and
// checks all 4 flight records (pinned-key check on Certificate,
// CertificateVerify signature check, server Finished MAC check),
// then builds, sends, and derives app keys after client Finished.
// Returns 1 (done, success), 0 (not enough data yet -- retry later),
// or -1 (done, verification failed). Assumes ServerHello and the
// whole flight arrive together, true on this synchronous loopback
// transport (see this section's own header comment) -- a genuinely
// asynchronous transport would need per-record phase tracking this
// doesn't have.
fn tls_client_try_process_flight(my_mac: mut ref i64, client_id: u32, server_id: u32) -> i64 {
  let recv_sh: mut ref i64 = tls_decrypted_scratch_get();
  let recv_sh_len: i64 = tls_rx_try_extract_plaintext(tls_client_rx_buf_get(), tls_client_rx_len_get(), recv_sh);
  if recv_sh_len < 0 {
    return 0;
  }
  let parsed_server_random: mut ref i64 = tls_parsed_server_random_get();
  let parsed_server_pub: mut ref i64 = tls_parsed_server_pub_get();
  let _ = tls_parse_server_hello(recv_sh, parsed_server_random, parsed_server_pub);

  let s_hs_key: mut ref i64 = tls_s_hs_key_get();
  let s_hs_iv: mut ref i64 = tls_s_hs_iv_get();
  let dec: mut ref i64 = tls_decrypted_scratch_get();

  let ee_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 0 as u32, 22 as u32, dec);
  if ee_len < 0 {
    return 0;
  }

  let cert_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 1 as u32, 22 as u32, dec);
  if cert_len < 0 {
    return 0;
  }
  let parsed_server_id_pub: mut ref i64 = tls_parsed_server_id_pub_get();
  let _ = tls_parse_certificate_pubkey(dec, parsed_server_id_pub);
  let pin_ok: i64 = keccak_bytes_equal(parsed_server_id_pub, tls_server_id_pub_get(), 32);

  let cv_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 2 as u32, 22 as u32, dec);
  if cv_len < 0 {
    return 0;
  }
  let recv_sig: mut ref i64 = tls_cv_sig_get();
  let _ = tls_copy(recv_sig, 0, dec, 8, 64);
  let cv_content: mut ref i64 = tls_cv_signed_content_get();
  let verify_ok: i64 = ed25519_verify_heap(parsed_server_id_pub, cv_content, 130, recv_sig);

  let s_fin_len: i64 = tls_rx_try_extract(tls_client_rx_buf_get(), tls_client_rx_len_get(), s_hs_key, s_hs_iv, 3 as u32, 22 as u32, dec);
  if s_fin_len < 0 {
    return 0;
  }
  let s_hs_traffic: mut ref i64 = tls_s_hs_traffic_get();
  let t_len_cv: i64 = buf_read_u32(tls_t_len_cv_get(), 0 as u32) as i64;
  let transcript: mut ref i64 = tls_transcript_get();
  let recomputed_s_verify: mut ref i64 = tls_s_verify_data_get();
  let _ = tls_finished_verify_data(s_hs_traffic, transcript, t_len_cv, recomputed_s_verify);
  let s_fin_ok: i64 = 1;
  let svi: i64 = 0;
  while svi < 32 {
    if buf_read_byte(dec, (4 + svi) as u32) != buf_read_byte(recomputed_s_verify, svi as u32) {
      s_fin_ok = 0;
    }
    svi = svi + 1;
  }

  if (pin_ok != 1) || (verify_ok != 1) || (s_fin_ok != 1) {
    return 0 - 1;
  }

  let c_hs_traffic: mut ref i64 = tls_c_hs_traffic_get();
  let t_len_s_fin: i64 = buf_read_u32(tls_t_len_s_fin_get(), 0 as u32) as i64;
  let c_verify_data: mut ref i64 = tls_c_verify_data_get();
  let _ = tls_finished_verify_data(c_hs_traffic, transcript, t_len_s_fin, c_verify_data);
  let c_fin: mut ref i64 = tls_c_fin_get();
  let c_fin_len: i64 = tls_build_finished(c_verify_data, c_fin);
  let c_hs_key: mut ref i64 = tls_c_hs_key_get();
  let c_hs_iv: mut ref i64 = tls_c_hs_iv_get();
  let rec_buf: mut ref i64 = tls_rec_buf_get();
  let rec_c_fin_len: i64 = tls_encrypt_record(c_hs_key, c_hs_iv, 0 as u32, c_fin, c_fin_len, 22 as u32, rec_buf);
  let _ = tls_send_over_tcp(client_id, server_id, my_mac, rec_buf, rec_c_fin_len, tls_server_rx_buf_get(), tls_server_rx_len_get());

  let _ = tls_derive_app_keys();
  return 1;
}

// The shared step: advances whichever role has pending work. See
// this section's own header comment for why this replaces separate
// independently-blocking client/server implementations.
fn tls_service(my_mac: mut ref i64) -> i64 {
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;

  let frame: mut ref i64 = tls_frame_scratch_get();
  let flen: i64 = netif_recv_frame(frame, 1514);
  if flen > 0 {
    if buf_read_u16_be(frame, 12) == (0x0800 as u32) {
      if ipv4_get_protocol(frame, 14) == (6 as u32) {
        let dst_port: u32 = tcp_get_dst_port(frame, 34);
        let target: u32 = client_id;
        let matched: i64 = 0;
        if dst_port == tcp_conn_get_local_port(client_id) {
          target = client_id;
          matched = 1;
        }
        if dst_port == tcp_conn_get_local_port(server_id) {
          target = server_id;
          matched = 1;
        }
        if matched == 1 {
          let scratch: mut ref i64 = tls_recv_chunk_scratch_get();
          let n: i64 = tcp_conn_handle_segment(target, frame, flen, my_mac, my_mac, scratch, 64);
          if n > 0 {
            if target == client_id {
              let _ = tls_rx_feed(tls_client_rx_buf_get(), tls_client_rx_len_get(), scratch, n);
            } else {
              let _ = tls_rx_feed(tls_server_rx_buf_get(), tls_server_rx_len_get(), scratch, n);
            }
          }
        }
      }
    }
  }

  if buf_read_u32(tls_server_phase_get(), 0 as u32) == (0 as u32) {
    let recv_ch: mut ref i64 = tls_decrypted_scratch_get();
    let recv_ch_len: i64 = tls_rx_try_extract_plaintext(tls_server_rx_buf_get(), tls_server_rx_len_get(), recv_ch);
    if recv_ch_len > 0 {
      let _ = tls_server_process_client_hello(recv_ch, recv_ch_len, my_mac, client_id, server_id);
      let _ = buf_write_u32(tls_server_phase_get(), 0 as u32, 1 as u32);
    }
  }

  if buf_read_u32(tls_client_phase_get(), 0 as u32) == (1 as u32) {
    let result: i64 = tls_client_try_process_flight(my_mac, client_id, server_id);
    if result == 1 {
      let _ = buf_write_u32(tls_client_phase_get(), 0 as u32, 2 as u32);
    }
    if result == (0 - 1) {
      let _ = buf_write_u32(tls_client_phase_get(), 0 as u32, 3 as u32);
    }
  }

  if buf_read_u32(tls_server_phase_get(), 0 as u32) == (1 as u32) {
    let dec: mut ref i64 = tls_decrypted_scratch_get();
    let c_hs_key: mut ref i64 = tls_c_hs_key_get();
    let c_hs_iv: mut ref i64 = tls_c_hs_iv_get();
    let c_fin_len: i64 = tls_rx_try_extract(tls_server_rx_buf_get(), tls_server_rx_len_get(), c_hs_key, c_hs_iv, 0 as u32, 22 as u32, dec);
    if c_fin_len >= 0 {
      let c_hs_traffic: mut ref i64 = tls_c_hs_traffic_get();
      let t_len_s_fin: i64 = buf_read_u32(tls_t_len_s_fin_get(), 0 as u32) as i64;
      let transcript: mut ref i64 = tls_transcript_get();
      let recomputed_c_verify: mut ref i64 = tls_c_verify_data_get();
      let _ = tls_finished_verify_data(c_hs_traffic, transcript, t_len_s_fin, recomputed_c_verify);
      let c_fin_ok: i64 = 1;
      let cvi: i64 = 0;
      while cvi < 32 {
        if buf_read_byte(dec, (4 + cvi) as u32) != buf_read_byte(recomputed_c_verify, cvi as u32) {
          c_fin_ok = 0;
        }
        cvi = cvi + 1;
      }
      if c_fin_ok == 1 {
        let _ = buf_write_u32(tls_server_phase_get(), 0 as u32, 2 as u32);
      } else {
        let _ = buf_write_u32(tls_server_phase_get(), 0 as u32, 3 as u32);
      }
    }
  }

  return 0;
}

// Initiates a fresh TLS 1.3 connection on `client_id` to `server_id`
// (both already-ESTABLISHED TCP connections -- see this section's own
// header comment on connection slots), blocking (bounded retries)
// until the handshake either completes or fails. Resets all
// connection-scoped state first, so a repeated call (e.g. a shell
// command invoked again) starts genuinely fresh.
fn tls_connect(client_id: u32, server_id: u32, my_mac: mut ref i64) -> i64 {
  let _ = tls_transport_init();
  let _ = buf_write_u32(tls_client_phase_get(), 0 as u32, 0 as u32);
  let _ = buf_write_u32(tls_server_phase_get(), 0 as u32, 0 as u32);
  let _ = buf_write_u32(tls_client_rx_len_get(), 0 as u32, 0 as u32);
  let _ = buf_write_u32(tls_server_rx_len_get(), 0 as u32, 0 as u32);
  let _ = buf_write_u32(tls_transcript_len_get(), 0 as u32, 0 as u32);

  let client_random: mut ref i64 = tls_client_random_get();
  let _ = write_hex_string(client_random, "0104070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e", 32);
  let client_priv: mut ref i64 = tls_client_x25519_priv_get();
  let _ = write_hex_string(client_priv, "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc", 32);
  let basepoint: mut ref i64 = tls_basepoint_get();
  let _ = tls_x25519_basepoint(basepoint);
  let client_pub: mut ref i64 = tls_client_x25519_pub_get();
  let _ = x25519_scalarmult_heap(client_priv, basepoint, client_pub);

  let ch: mut ref i64 = tls_ch_get();
  let ch_len: i64 = tls_build_client_hello(client_random, client_pub, ch);
  let ch_record: mut ref i64 = tls_ch_record_get();
  let ch_record_len: i64 = tls_wrap_plaintext_record(ch, ch_len, ch_record);
  let _ = tls_send_over_tcp(client_id, server_id, my_mac, ch_record, ch_record_len, tls_server_rx_buf_get(), tls_server_rx_len_get());
  let _ = buf_write_u32(tls_client_phase_get(), 0 as u32, 1 as u32);

  let iter: i64 = 0;
  while (iter < 10) && (buf_read_u32(tls_client_phase_get(), 0 as u32) == (1 as u32)) {
    let _ = tls_service(my_mac);
    iter = iter + 1;
  }
  if buf_read_u32(tls_client_phase_get(), 0 as u32) != (2 as u32) {
    return 0 - 1;
  }
  return 0;
}

// Completes the server side of whatever handshake is in progress
// (initiated by a peer's own tls_connect), blocking (bounded
// retries) until done or failed. On this synchronous loopback
// transport, tls_connect's own bounded retries already drive the
// server to completion as a side effect of tls_service servicing
// both roles -- calling tls_accept afterward is a real, correctly-
// defined status check (not skipped just because it'd usually be a
// fast no-op here), and is the entry point a listening context would
// use on its own if it were driven independently.
fn tls_accept(_server_id: u32, _client_id: u32, my_mac: mut ref i64) -> i64 {
  let iter: i64 = 0;
  while (iter < 10) && (buf_read_u32(tls_server_phase_get(), 0 as u32) < (2 as u32)) {
    let _ = tls_service(my_mac);
    iter = iter + 1;
  }
  if buf_read_u32(tls_server_phase_get(), 0 as u32) != (2 as u32) {
    return 0 - 1;
  }
  return 0;
}

// Encrypts and sends one application-data message (one per direction
// per connection -- see this section's own header comment).
fn tls_send(sender_id: u32, receiver_id: u32, my_mac: mut ref i64, key: mut ref i64, iv: mut ref i64, plaintext: mut ref i64, plaintext_len: i64, receiver_rx_buf: mut ref i64, receiver_rx_len_buf: mut ref i64) -> i64 {
  let rec_buf: mut ref i64 = tls_rec_buf_get();
  let rec_len: i64 = tls_encrypt_record(key, iv, 0 as u32, plaintext, plaintext_len, 23 as u32, rec_buf);
  let _ = tls_send_over_tcp(sender_id, receiver_id, my_mac, rec_buf, rec_len, receiver_rx_buf, receiver_rx_len_buf);
  return 0;
}

// Decrypts one application-data message already delivered into
// `rx_buf`/`rx_len_buf` by a prior tls_send. Returns the plaintext
// length, or -1 if nothing (complete) is there yet or the AEAD tag
// doesn't verify.
fn tls_recv(rx_buf: mut ref i64, rx_len_buf: mut ref i64, key: mut ref i64, iv: mut ref i64, out_content: mut ref i64) -> i64 {
  return tls_rx_try_extract(rx_buf, rx_len_buf, key, iv, 0 as u32, 23 as u32, out_content);
}

fn pki_self_test() -> i64 {
  let ok: i64 = 1;
  let _ = pki_init();

  let msg_str: Str = "Dhruva PKI demo payload -- config or update content";
  let msg_len: i64 = str_len_bytes(msg_str);
  let msg: mut ref i64 = dhruva_alloc_bytes(msg_len);
  let mi: i64 = 0;
  while mi < msg_len {
    let _ = buf_write_byte(msg, mi as u32, str_byte_at(msg_str, mi) as u32);
    mi = mi + 1;
  }

  let sig: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = buf_write_byte(sig, 0 as u32, 0x51 as u32);
  let _ = buf_write_byte(sig, 1 as u32, 0xfd as u32);
  let _ = buf_write_byte(sig, 2 as u32, 0xcf as u32);
  let _ = buf_write_byte(sig, 3 as u32, 0x0c as u32);
  let _ = buf_write_byte(sig, 4 as u32, 0x1c as u32);
  let _ = buf_write_byte(sig, 5 as u32, 0xf5 as u32);
  let _ = buf_write_byte(sig, 6 as u32, 0x3c as u32);
  let _ = buf_write_byte(sig, 7 as u32, 0x5d as u32);
  let _ = buf_write_byte(sig, 8 as u32, 0x39 as u32);
  let _ = buf_write_byte(sig, 9 as u32, 0x66 as u32);
  let _ = buf_write_byte(sig, 10 as u32, 0x41 as u32);
  let _ = buf_write_byte(sig, 11 as u32, 0x42 as u32);
  let _ = buf_write_byte(sig, 12 as u32, 0x92 as u32);
  let _ = buf_write_byte(sig, 13 as u32, 0x91 as u32);
  let _ = buf_write_byte(sig, 14 as u32, 0x50 as u32);
  let _ = buf_write_byte(sig, 15 as u32, 0xcb as u32);
  let _ = buf_write_byte(sig, 16 as u32, 0xc7 as u32);
  let _ = buf_write_byte(sig, 17 as u32, 0xa5 as u32);
  let _ = buf_write_byte(sig, 18 as u32, 0x93 as u32);
  let _ = buf_write_byte(sig, 19 as u32, 0x97 as u32);
  let _ = buf_write_byte(sig, 20 as u32, 0x50 as u32);
  let _ = buf_write_byte(sig, 21 as u32, 0xec as u32);
  let _ = buf_write_byte(sig, 22 as u32, 0xa1 as u32);
  let _ = buf_write_byte(sig, 23 as u32, 0xff as u32);
  let _ = buf_write_byte(sig, 24 as u32, 0xd5 as u32);
  let _ = buf_write_byte(sig, 25 as u32, 0x74 as u32);
  let _ = buf_write_byte(sig, 26 as u32, 0x5b as u32);
  let _ = buf_write_byte(sig, 27 as u32, 0x8c as u32);
  let _ = buf_write_byte(sig, 28 as u32, 0x24 as u32);
  let _ = buf_write_byte(sig, 29 as u32, 0x21 as u32);
  let _ = buf_write_byte(sig, 30 as u32, 0xe2 as u32);
  let _ = buf_write_byte(sig, 31 as u32, 0x7b as u32);
  let _ = buf_write_byte(sig, 32 as u32, 0x92 as u32);
  let _ = buf_write_byte(sig, 33 as u32, 0xd5 as u32);
  let _ = buf_write_byte(sig, 34 as u32, 0x64 as u32);
  let _ = buf_write_byte(sig, 35 as u32, 0x88 as u32);
  let _ = buf_write_byte(sig, 36 as u32, 0xd3 as u32);
  let _ = buf_write_byte(sig, 37 as u32, 0xc0 as u32);
  let _ = buf_write_byte(sig, 38 as u32, 0x9c as u32);
  let _ = buf_write_byte(sig, 39 as u32, 0x69 as u32);
  let _ = buf_write_byte(sig, 40 as u32, 0x16 as u32);
  let _ = buf_write_byte(sig, 41 as u32, 0x81 as u32);
  let _ = buf_write_byte(sig, 42 as u32, 0xcb as u32);
  let _ = buf_write_byte(sig, 43 as u32, 0x0f as u32);
  let _ = buf_write_byte(sig, 44 as u32, 0x04 as u32);
  let _ = buf_write_byte(sig, 45 as u32, 0x76 as u32);
  let _ = buf_write_byte(sig, 46 as u32, 0x35 as u32);
  let _ = buf_write_byte(sig, 47 as u32, 0x2b as u32);
  let _ = buf_write_byte(sig, 48 as u32, 0x93 as u32);
  let _ = buf_write_byte(sig, 49 as u32, 0xfa as u32);
  let _ = buf_write_byte(sig, 50 as u32, 0x89 as u32);
  let _ = buf_write_byte(sig, 51 as u32, 0x6d as u32);
  let _ = buf_write_byte(sig, 52 as u32, 0xdb as u32);
  let _ = buf_write_byte(sig, 53 as u32, 0x5a as u32);
  let _ = buf_write_byte(sig, 54 as u32, 0x09 as u32);
  let _ = buf_write_byte(sig, 55 as u32, 0xdf as u32);
  let _ = buf_write_byte(sig, 56 as u32, 0xa6 as u32);
  let _ = buf_write_byte(sig, 57 as u32, 0xd2 as u32);
  let _ = buf_write_byte(sig, 58 as u32, 0xfe as u32);
  let _ = buf_write_byte(sig, 59 as u32, 0x5f as u32);
  let _ = buf_write_byte(sig, 60 as u32, 0x7d as u32);
  let _ = buf_write_byte(sig, 61 as u32, 0x52 as u32);
  let _ = buf_write_byte(sig, 62 as u32, 0x7f as u32);
  let _ = buf_write_byte(sig, 63 as u32, 0x05 as u32);

  if pki_verify_raw(msg, msg_len, sig) == 0 {
    ok = 0; // a genuine signature from the matching private key must verify
  }

  let bad_msg: mut ref i64 = dhruva_alloc_bytes(msg_len);
  let bi: i64 = 0;
  while bi < msg_len {
    let _ = buf_write_byte(bad_msg, bi as u32, buf_read_byte(msg, bi as u32));
    bi = bi + 1;
  }
  let _ = buf_write_byte(bad_msg, 0 as u32, buf_read_byte(bad_msg, 0 as u32) ^ (1 as u32));
  if pki_verify_raw(bad_msg, msg_len, sig) == 1 {
    ok = 0; // tampered content must NOT verify against the same signature
  }

  // End-to-end file-based path: write the payload and its companion
  // .sig, verify via the shell-facing pki_verify_file, then corrupt
  // the on-disk content (not the in-memory msg buffer -- exercises
  // the REAL dharafs_read_raw path, not just the raw in-memory check
  // above) and confirm it's now correctly rejected.
  let _ = dharafs_append("/pki/demo", "Dhruva PKI demo payload -- config or update content");
  let sig_path_buf: mut ref i64 = dharafs_path_scratch_get();
  let sp_str: Str = "/pki/demo.sig";
  let sp_len: i64 = str_len_bytes(sp_str);
  let spi: i64 = 0;
  while spi < sp_len {
    let _ = buf_write_byte(sig_path_buf, spi as u32, str_byte_at(sp_str, spi) as u32);
    spi = spi + 1;
  }
  let sig_data_buf: mut ref i64 = dharafs_data_scratch_get();
  let sdi: i64 = 0;
  while sdi < 64 {
    let _ = buf_write_byte(sig_data_buf, sdi as u32, buf_read_byte(sig, sdi as u32));
    sdi = sdi + 1;
  }
  let _ = dharafs_append_raw(sig_path_buf, sp_len, sig_data_buf, 64, dharafs_user_get_uid(), dharafs_user_get_gid(), dharafs_default_mode());

  if pki_verify_file("/pki/demo") == 0 {
    ok = 0; // real file + real companion .sig must verify end to end
  }

  let _ = dharafs_append("/pki/demo", "TAMPERED -- config or update content");
  if pki_verify_file("/pki/demo") == 1 {
    ok = 0; // corrupted on-disk content must NOT verify against the old signature
  }

  if pki_verify_file("/pki/nonexistent") != (0 - 1) {
    ok = 0; // a missing file (and thus missing .sig) is a clean -1, not a crash or a false accept
  }

  let _ = uart_puts("CRYPTO: PKI raw public-key trust (pinned-key verify + real dharafs file round trip)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}




