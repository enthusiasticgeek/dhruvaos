  let _ = buf_write_byte(salt, 13 as u32, 0x0d as u32);
  let _ = buf_write_byte(salt, 14 as u32, 0x0e as u32);
  let _ = buf_write_byte(salt, 15 as u32, 0x0f as u32);
  let ikm: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(ikm, 0 as u32, 0x20 as u32);
  let _ = buf_write_byte(ikm, 1 as u32, 0x21 as u32);
  let _ = buf_write_byte(ikm, 2 as u32, 0x22 as u32);
  let _ = buf_write_byte(ikm, 3 as u32, 0x23 as u32);
  let _ = buf_write_byte(ikm, 4 as u32, 0x24 as u32);
  let _ = buf_write_byte(ikm, 5 as u32, 0x25 as u32);
  let _ = buf_write_byte(ikm, 6 as u32, 0x26 as u32);
  let _ = buf_write_byte(ikm, 7 as u32, 0x27 as u32);
  let _ = buf_write_byte(ikm, 8 as u32, 0x28 as u32);
  let _ = buf_write_byte(ikm, 9 as u32, 0x29 as u32);
  let _ = buf_write_byte(ikm, 10 as u32, 0x2a as u32);
  let _ = buf_write_byte(ikm, 11 as u32, 0x2b as u32);
  let _ = buf_write_byte(ikm, 12 as u32, 0x2c as u32);
  let _ = buf_write_byte(ikm, 13 as u32, 0x2d as u32);
  let _ = buf_write_byte(ikm, 14 as u32, 0x2e as u32);
  let _ = buf_write_byte(ikm, 15 as u32, 0x2f as u32);
  let _ = buf_write_byte(ikm, 16 as u32, 0x30 as u32);
  let _ = buf_write_byte(ikm, 17 as u32, 0x31 as u32);
  let _ = buf_write_byte(ikm, 18 as u32, 0x32 as u32);
  let _ = buf_write_byte(ikm, 19 as u32, 0x33 as u32);
  let _ = buf_write_byte(ikm, 20 as u32, 0x34 as u32);
  let _ = buf_write_byte(ikm, 21 as u32, 0x35 as u32);
  let _ = buf_write_byte(ikm, 22 as u32, 0x36 as u32);
  let _ = buf_write_byte(ikm, 23 as u32, 0x37 as u32);
  let _ = buf_write_byte(ikm, 24 as u32, 0x38 as u32);
  let _ = buf_write_byte(ikm, 25 as u32, 0x39 as u32);
  let _ = buf_write_byte(ikm, 26 as u32, 0x3a as u32);
  let _ = buf_write_byte(ikm, 27 as u32, 0x3b as u32);
  let _ = buf_write_byte(ikm, 28 as u32, 0x3c as u32);
  let _ = buf_write_byte(ikm, 29 as u32, 0x3d as u32);
  let _ = buf_write_byte(ikm, 30 as u32, 0x3e as u32);
  let _ = buf_write_byte(ikm, 31 as u32, 0x3f as u32);
  let info_str: Str = "dhruva hkdf test";
  let info_len: i64 = str_len_bytes(info_str);
  let info: mut ref i64 = dhruva_alloc_bytes(info_len);
  let ii: i64 = 0;
  while ii < info_len {
    let _ = buf_write_byte(info, ii as u32, str_byte_at(info_str, ii) as u32);
    ii = ii + 1;
  }

  let prk_out: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = hkdf_extract(salt, 16, ikm, 32, prk_out);
  let expected_prk: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(expected_prk, 0 as u32, 0x21 as u32);
  let _ = buf_write_byte(expected_prk, 1 as u32, 0xb8 as u32);
  let _ = buf_write_byte(expected_prk, 2 as u32, 0xe8 as u32);
  let _ = buf_write_byte(expected_prk, 3 as u32, 0x92 as u32);
  let _ = buf_write_byte(expected_prk, 4 as u32, 0xbb as u32);
  let _ = buf_write_byte(expected_prk, 5 as u32, 0x84 as u32);
