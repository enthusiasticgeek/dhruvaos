  let _ = buf_write_byte(expected_pub, 18 as u32, 0xd6 as u32);
  let _ = buf_write_byte(expected_pub, 19 as u32, 0x30 as u32);
  let _ = buf_write_byte(expected_pub, 20 as u32, 0x9b as u32);
  let _ = buf_write_byte(expected_pub, 21 as u32, 0xa5 as u32);
  let _ = buf_write_byte(expected_pub, 22 as u32, 0x0d as u32);
  let _ = buf_write_byte(expected_pub, 23 as u32, 0x5f as u32);
  let _ = buf_write_byte(expected_pub, 24 as u32, 0x1d as u32);
  let _ = buf_write_byte(expected_pub, 25 as u32, 0xdc as u32);
  let _ = buf_write_byte(expected_pub, 26 as u32, 0x86 as u32);
  let _ = buf_write_byte(expected_pub, 27 as u32, 0x64 as u32);
  let _ = buf_write_byte(expected_pub, 28 as u32, 0x12 as u32);
  let _ = buf_write_byte(expected_pub, 29 as u32, 0x55 as u32);
  let _ = buf_write_byte(expected_pub, 30 as u32, 0x31 as u32);
  let _ = buf_write_byte(expected_pub, 31 as u32, 0xb8 as u32);

  let expected_sig: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = buf_write_byte(expected_sig, 0 as u32, 0xbb as u32);
  let _ = buf_write_byte(expected_sig, 1 as u32, 0x89 as u32);
  let _ = buf_write_byte(expected_sig, 2 as u32, 0x59 as u32);
  let _ = buf_write_byte(expected_sig, 3 as u32, 0x11 as u32);
  let _ = buf_write_byte(expected_sig, 4 as u32, 0x1f as u32);
  let _ = buf_write_byte(expected_sig, 5 as u32, 0xc8 as u32);
  let _ = buf_write_byte(expected_sig, 6 as u32, 0x7b as u32);
  let _ = buf_write_byte(expected_sig, 7 as u32, 0xf9 as u32);
  let _ = buf_write_byte(expected_sig, 8 as u32, 0x3c as u32);
  let _ = buf_write_byte(expected_sig, 9 as u32, 0x54 as u32);
  let _ = buf_write_byte(expected_sig, 10 as u32, 0xde as u32);
  let _ = buf_write_byte(expected_sig, 11 as u32, 0x30 as u32);
  let _ = buf_write_byte(expected_sig, 12 as u32, 0xfc as u32);
  let _ = buf_write_byte(expected_sig, 13 as u32, 0x11 as u32);
  let _ = buf_write_byte(expected_sig, 14 as u32, 0xf0 as u32);
  let _ = buf_write_byte(expected_sig, 15 as u32, 0x09 as u32);
  let _ = buf_write_byte(expected_sig, 16 as u32, 0x7d as u32);
  let _ = buf_write_byte(expected_sig, 17 as u32, 0x8c as u32);
  let _ = buf_write_byte(expected_sig, 18 as u32, 0xf7 as u32);
  let _ = buf_write_byte(expected_sig, 19 as u32, 0x58 as u32);
  let _ = buf_write_byte(expected_sig, 20 as u32, 0x64 as u32);
  let _ = buf_write_byte(expected_sig, 21 as u32, 0xa2 as u32);
  let _ = buf_write_byte(expected_sig, 22 as u32, 0x7c as u32);
  let _ = buf_write_byte(expected_sig, 23 as u32, 0xb7 as u32);
  let _ = buf_write_byte(expected_sig, 24 as u32, 0x6c as u32);
  let _ = buf_write_byte(expected_sig, 25 as u32, 0x5a as u32);
  let _ = buf_write_byte(expected_sig, 26 as u32, 0x97 as u32);
  let _ = buf_write_byte(expected_sig, 27 as u32, 0x24 as u32);
  let _ = buf_write_byte(expected_sig, 28 as u32, 0x50 as u32);
  let _ = buf_write_byte(expected_sig, 29 as u32, 0x4d as u32);
  let _ = buf_write_byte(expected_sig, 30 as u32, 0x70 as u32);
  let _ = buf_write_byte(expected_sig, 31 as u32, 0x80 as u32);
  let _ = buf_write_byte(expected_sig, 32 as u32, 0xe4 as u32);
  let _ = buf_write_byte(expected_sig, 33 as u32, 0x72 as u32);
  let _ = buf_write_byte(expected_sig, 34 as u32, 0xf9 as u32);
  let _ = buf_write_byte(expected_sig, 35 as u32, 0x86 as u32);
  let _ = buf_write_byte(expected_sig, 36 as u32, 0x71 as u32);
  let _ = buf_write_byte(expected_sig, 37 as u32, 0x16 as u32);
  let _ = buf_write_byte(expected_sig, 38 as u32, 0x1d as u32);
  let _ = buf_write_byte(expected_sig, 39 as u32, 0xb0 as u32);
  let _ = buf_write_byte(expected_sig, 40 as u32, 0x08 as u32);
  let _ = buf_write_byte(expected_sig, 41 as u32, 0x60 as u32);
  let _ = buf_write_byte(expected_sig, 42 as u32, 0xe8 as u32);
  let _ = buf_write_byte(expected_sig, 43 as u32, 0x78 as u32);
  let _ = buf_write_byte(expected_sig, 44 as u32, 0x85 as u32);
  let _ = buf_write_byte(expected_sig, 45 as u32, 0x79 as u32);
  let _ = buf_write_byte(expected_sig, 46 as u32, 0xa0 as u32);
  let _ = buf_write_byte(expected_sig, 47 as u32, 0x63 as u32);
  let _ = buf_write_byte(expected_sig, 48 as u32, 0xa1 as u32);
  let _ = buf_write_byte(expected_sig, 49 as u32, 0x2a as u32);
  let _ = buf_write_byte(expected_sig, 50 as u32, 0x1a as u32);
  let _ = buf_write_byte(expected_sig, 51 as u32, 0xb1 as u32);
  let _ = buf_write_byte(expected_sig, 52 as u32, 0x7a as u32);
  let _ = buf_write_byte(expected_sig, 53 as u32, 0x3e as u32);
  let _ = buf_write_byte(expected_sig, 54 as u32, 0x3f as u32);
  let _ = buf_write_byte(expected_sig, 55 as u32, 0xc7 as u32);
  let _ = buf_write_byte(expected_sig, 56 as u32, 0x08 as u32);
  let _ = buf_write_byte(expected_sig, 57 as u32, 0xb9 as u32);
  let _ = buf_write_byte(expected_sig, 58 as u32, 0x77 as u32);
  let _ = buf_write_byte(expected_sig, 59 as u32, 0xae as u32);
  let _ = buf_write_byte(expected_sig, 60 as u32, 0xd5 as u32);
  let _ = buf_write_byte(expected_sig, 61 as u32, 0xf1 as u32);
  let _ = buf_write_byte(expected_sig, 62 as u32, 0x02 as u32);
  let _ = buf_write_byte(expected_sig, 63 as u32, 0x01 as u32);

  let pub_out: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = ed25519_secret_to_public_heap(seed, pub_out);
  if chacha20_bytes_equal(pub_out, expected_pub, 32) == 0 {
    ok = 0;
  }

  let sig_out: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = ed25519_sign_heap(seed, msg, msg_len, sig_out);
  if chacha20_bytes_equal(sig_out, expected_sig, 64) == 0 {
    ok = 0;
  }

  if ed25519_verify_heap(pub_out, msg, msg_len, sig_out) == 0 {
    ok = 0; // must accept its own valid signature
  }

  // Tamper checks: flip one bit each in the signature and in the
  // message, confirm BOTH are correctly rejected -- the actual
  // security property, not just "produces something".
  let bad_sig: mut ref i64 = dhruva_alloc_bytes(64);
  let bi: i64 = 0;
  while bi < 64 {
    let _ = buf_write_byte(bad_sig, bi as u32, buf_read_byte(sig_out, bi as u32));
    bi = bi + 1;
  }
  let _ = buf_write_byte(bad_sig, 0 as u32, buf_read_byte(bad_sig, 0 as u32) ^ (1 as u32));
  if ed25519_verify_heap(pub_out, msg, msg_len, bad_sig) == 1 {
    ok = 0;
  }

  let bad_msg: mut ref i64 = dhruva_alloc_bytes(msg_len);
  let ci: i64 = 0;
  while ci < msg_len {
    let _ = buf_write_byte(bad_msg, ci as u32, buf_read_byte(msg, ci as u32));
    ci = ci + 1;
  }
  let _ = buf_write_byte(bad_msg, 0 as u32, buf_read_byte(bad_msg, 0 as u32) ^ (1 as u32));
  if ed25519_verify_heap(pub_out, bad_msg, msg_len, sig_out) == 1 {
    ok = 0;
  }

  let _ = uart_puts("CRYPTO: Ed25519 vs a real, independently-verified reference (pubkey+sign+verify+tamper)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}


// Round 67: PKI raw public-key trust -- see boot/pki_state.S's own
// header comment for the full scoping rationale (no X.509/CA chain,
// a compile-time-pinned key never runtime-settable).
fn pki_init() -> i64 {
  let key: mut ref i64 = pki_pinned_key_get();
  let _ = buf_write_byte(key, 0 as u32, 0xe7 as u32);
  let _ = buf_write_byte(key, 1 as u32, 0x34 as u32);
  let _ = buf_write_byte(key, 2 as u32, 0xea as u32);
  let _ = buf_write_byte(key, 3 as u32, 0x6c as u32);
  let _ = buf_write_byte(key, 4 as u32, 0x2b as u32);
  let _ = buf_write_byte(key, 5 as u32, 0x62 as u32);
  let _ = buf_write_byte(key, 6 as u32, 0x57 as u32);
  let _ = buf_write_byte(key, 7 as u32, 0xde as u32);
  let _ = buf_write_byte(key, 8 as u32, 0x72 as u32);
  let _ = buf_write_byte(key, 9 as u32, 0x35 as u32);
  let _ = buf_write_byte(key, 10 as u32, 0x5e as u32);
  let _ = buf_write_byte(key, 11 as u32, 0x47 as u32);
  let _ = buf_write_byte(key, 12 as u32, 0x2a as u32);
  let _ = buf_write_byte(key, 13 as u32, 0xa0 as u32);
  let _ = buf_write_byte(key, 14 as u32, 0x5a as u32);
  let _ = buf_write_byte(key, 15 as u32, 0x4c as u32);
  let _ = buf_write_byte(key, 16 as u32, 0x48 as u32);
  let _ = buf_write_byte(key, 17 as u32, 0x7e as u32);
  let _ = buf_write_byte(key, 18 as u32, 0x6b as u32);
  let _ = buf_write_byte(key, 19 as u32, 0x46 as u32);
  let _ = buf_write_byte(key, 20 as u32, 0x3c as u32);
  let _ = buf_write_byte(key, 21 as u32, 0x02 as u32);
  let _ = buf_write_byte(key, 22 as u32, 0x9e as u32);
  let _ = buf_write_byte(key, 23 as u32, 0xd3 as u32);
  let _ = buf_write_byte(key, 24 as u32, 0x06 as u32);
  let _ = buf_write_byte(key, 25 as u32, 0xdf as u32);
  let _ = buf_write_byte(key, 26 as u32, 0x2f as u32);
  let _ = buf_write_byte(key, 27 as u32, 0x01 as u32);
  let _ = buf_write_byte(key, 28 as u32, 0xb5 as u32);
  let _ = buf_write_byte(key, 29 as u32, 0x63 as u32);
  let _ = buf_write_byte(key, 30 as u32, 0x6b as u32);
  let _ = buf_write_byte(key, 31 as u32, 0x58 as u32);
  return 0;
}

fn pki_verify_raw(data: mut ref i64, data_len: i64, sig: mut ref i64) -> i64 {
  return ed25519_verify_heap(pki_pinned_key_get(), data, data_len, sig);
}

// Verifies the file at `path_buf` (already copied by the caller,
// same convention as dharafs_find_latest_block_raw's own `path_buf`
// parameters) against a companion signature file at `<path>.sig`.
// Returns 1 (valid), 0 (signature present but doesn't verify), or -1
// (path too long, file missing, or no companion .sig file / wrong
// size -- "reject, don't guess" for every one of these, same posture
// as the rest of this codebase's format/bounds checks).
fn pki_verify_file_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  if (path_len <= 0) || (path_len > 32) {
    return 0 - 1;
  }
  let suffix: Str = ".sig";
  let suffix_len: i64 = str_len_bytes(suffix);
  if (path_len + suffix_len) > 32 {
    return 0 - 1;
  }
  let sig_path_buf: mut ref i64 = pki_sig_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(sig_path_buf, i as u32, buf_read_byte(path_buf, i as u32));
    i = i + 1;
  }
  let j: i64 = 0;
  while j < suffix_len {
    let _ = buf_write_byte(sig_path_buf, (path_len + j) as u32, str_byte_at(suffix, j) as u32);
    j = j + 1;
  }
  let sig_path_len: i64 = path_len + suffix_len;

  let data_buf: mut ref i64 = dharafs_data_scratch_get();
  let data_len: i64 = dharafs_read_raw(path_buf, path_len, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }

  let sig_buf: mut ref i64 = pki_sig_data_scratch_get();
  let sig_len: i64 = dharafs_read_raw(sig_path_buf, sig_path_len, sig_buf);
  if sig_len != 64 {
    return 0 - 1;
  }

  return pki_verify_raw(data_buf, data_len, sig_buf);
}

fn pki_verify_file(path: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if (path_len <= 0) || (path_len > 32) {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = dharafs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return pki_verify_file_raw(path_buf, path_len);
}


// Round 67: AES-128, spiked and built per docs/TODO.md's own explicit
// warning -- "the real difficulty is NOT the algorithm itself... it's
// doing it safely on ARMv6" (no AES-NI, and a naive table-based S-box
// leaks the key through cache-timing side channels, a well-documented
// practical attack class). This implementation deliberately has NO
// lookup tables anywhere: the S-box is computed on the fly via
// constant-time GF(2^8) field inversion (Fermat: x^254 = x^-1 in the
// 255-element multiplicative group, via fixed-exponent square-and-
// multiply -- the same pattern field25519_invert/ed25519_sqrt_
// candidate already use, just over GF(2^8) instead of GF(2^255-19))
// plus the standard fixed affine transform. GF(2^8) multiplication
// itself is branchless (a mask-based conditional reduction, same
// technique X25519's own cswap and Poly1305's own g/h select already
// established) rather than the classic "if high bit set, XOR the
// reduction polynomial" formulation, which branches on secret-shaped
// data.
//
// Scope, explicit: AES-128 ENCRYPT only (no decrypt, no key sizes
// beyond 128-bit, no mode of operation/AEAD on top) -- matches this
// entry's own "spike first" framing and the roadmap's own note that
// there is still no live consumer (WPA2/FIPS-TLS aren't being built
// right now). This proves the real question the spike existed to
// answer -- yes, vani's own bitwise u32 operations are suitable for
// genuinely constant-time AES -- and leaves a real, usable, verified
// primitive behind rather than a throwaway experiment.
//
// Verification: a from-scratch Python port of this EXACT algorithm
// (same GF(2^8) construction, same S-box-via-inversion approach)
// checked two ways before any vani code was written: the official
// FIPS-197 Appendix B test vector, byte-exact; and 20 random trials
// against the real `cryptography` library's own AES-128-ECB
// encryptor, byte-exact on all of them. A SEPARATE, independent
// brute-force GF(2^8) inversion (a different multiplication
// implementation entirely) cross-checked the full 256-entry S-box
// against the constant-time construction, confirming the "clever"
// version isn't subtly wrong in a way the FIPS vector alone wouldn't
// catch.

// out = a*b in GF(2^8) (AES's own field, reduction polynomial
// x^8+x^4+x^3+x+1, 0x11B). Branchless: no conditional whose direction
// depends on either operand's actual value.
fn gf256_mul(a: u32, b: u32) -> u32 {
  let result: u32 = 0 as u32;
  let av: u32 = a;
  let i: i64 = 0;
  while i < 8 {
    let bit: u32 = (b >> (i as u32)) & (1 as u32);
    let mask: u32 = wrapping_sub(0 as u32, bit) & (255 as u32);
    result = result ^ (av & mask);
    let hibit: u32 = (av >> (7 as u32)) & (1 as u32);
    let hmask: u32 = wrapping_sub(0 as u32, hibit) & (255 as u32);
    av = ((av << (1 as u32)) ^ ((27 as u32) & hmask)) & (255 as u32);
    i = i + 1;
  }
  return result;
}

// x^254 mod (GF(2^8) field) == x^-1 for x != 0 (0 maps to 0, matching
// the standard AES convention -- the affine step below is what turns
// this into the real S-box, including its own fixed point at 0).
fn gf256_inv(x: u32) -> u32 {
  let result: u32 = 1 as u32;
  let base: u32 = x;
  // 254 = 0b11111110 -- a fixed, known-at-compile-time constant, so
  // its bits are read directly via shift/mask rather than staged
  // through a scratch buffer (which this function, called for every
  // single S-box evaluation throughout key expansion and every round,
  // would otherwise need to allocate freshly on every call -- exactly
  // the per-call dhruva_alloc_bytes bug class this project's own
  // scratch_state.S header comment documents fixing elsewhere).
  let exponent: u32 = 254 as u32;
  let i: i64 = 0;
  while i < 8 {
    if ((exponent >> (i as u32)) & (1 as u32)) == (1 as u32) {
      result = gf256_mul(result, base);
    }
    base = gf256_mul(base, base);
    i = i + 1;
  }
  return result;
}

fn aes_rotl8(x: u32, n: u32) -> u32 {
  return ((x << n) | (x >> ((8 as u32) - n))) & (255 as u32);
}

fn aes_sbox(x: u32) -> u32 {
  let inv: u32 = gf256_inv(x);
  let s: u32 = inv;
  s = s ^ aes_rotl8(inv, 1 as u32);
  s = s ^ aes_rotl8(inv, 2 as u32);
  s = s ^ aes_rotl8(inv, 3 as u32);
  s = s ^ aes_rotl8(inv, 4 as u32);
  s = s ^ (0x63 as u32);
  return s & (255 as u32);
}

// Expands a 16-byte AES-128 key into 176 bytes (44 4-byte words) of
// round keys, written to `w_out`.
fn aes128_key_expansion(key: mut ref i64, w_out: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 16 {
    let _ = buf_write_byte(w_out, i as u32, buf_read_byte(key, i as u32));
    i = i + 1;
  }
  let rcon: u32 = 1 as u32;
  let wi: i64 = 4;
  while wi < 44 {
    let t0: u32 = buf_read_byte(w_out, ((wi - 1) * 4 + 0) as u32);
    let t1: u32 = buf_read_byte(w_out, ((wi - 1) * 4 + 1) as u32);
    let t2: u32 = buf_read_byte(w_out, ((wi - 1) * 4 + 2) as u32);
    let t3: u32 = buf_read_byte(w_out, ((wi - 1) * 4 + 3) as u32);
    if (wi % 4) == 0 {
      // RotWord + SubWord + Rcon
      let r0: u32 = aes_sbox(t1);
      let r1: u32 = aes_sbox(t2);
      let r2: u32 = aes_sbox(t3);
      let r3: u32 = aes_sbox(t0);
      t0 = r0 ^ rcon;
      t1 = r1;
      t2 = r2;
      t3 = r3;
      rcon = gf256_mul(rcon, 2 as u32);
    }
    let p0: u32 = buf_read_byte(w_out, ((wi - 4) * 4 + 0) as u32);
    let p1: u32 = buf_read_byte(w_out, ((wi - 4) * 4 + 1) as u32);
    let p2: u32 = buf_read_byte(w_out, ((wi - 4) * 4 + 2) as u32);
    let p3: u32 = buf_read_byte(w_out, ((wi - 4) * 4 + 3) as u32);
    let _ = buf_write_byte(w_out, (wi * 4 + 0) as u32, p0 ^ t0);
    let _ = buf_write_byte(w_out, (wi * 4 + 1) as u32, p1 ^ t1);
    let _ = buf_write_byte(w_out, (wi * 4 + 2) as u32, p2 ^ t2);
    let _ = buf_write_byte(w_out, (wi * 4 + 3) as u32, p3 ^ t3);
    wi = wi + 1;
  }
  return 0;
}

// state[r + 4*c] ^= w[(round*4+c)*4 + r] for r,c in 0..4 -- AddRoundKey.
fn aes_add_round_key(state: mut ref i64, w: mut ref i64, round: i64) -> i64 {
  let c: i64 = 0;
  while c < 4 {
    let r: i64 = 0;
    while r < 4 {
      let sv: u32 = buf_read_byte(state, (r + 4 * c) as u32);
      let wv: u32 = buf_read_byte(w, ((round * 4 + c) * 4 + r) as u32);
      let _ = buf_write_byte(state, (r + 4 * c) as u32, sv ^ wv);
      r = r + 1;
    }
    c = c + 1;
  }
  return 0;
}

fn aes_sub_bytes(state: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 16 {
    let v: u32 = buf_read_byte(state, i as u32);
    let _ = buf_write_byte(state, i as u32, aes_sbox(v));
    i = i + 1;
  }
  return 0;
}

// Row r (0..4) shifted left by r positions, within each row's own 4
// column-major-strided bytes. Uses a small 4-byte temp per row (not
// the whole 16-byte state) since each row is independent.
fn aes_shift_rows(state: mut ref i64, temp: mut ref i64) -> i64 {
  let r: i64 = 1;
  while r < 4 {
    let c: i64 = 0;
    while c < 4 {
      let src_c: i64 = (c + r) % 4;
      let _ = buf_write_byte(temp, c as u32, buf_read_byte(state, (r + 4 * src_c) as u32));
      c = c + 1;
    }
    let c2: i64 = 0;
    while c2 < 4 {
      let _ = buf_write_byte(state, (r + 4 * c2) as u32, buf_read_byte(temp, c2 as u32));
      c2 = c2 + 1;
    }
    r = r + 1;
  }
  return 0;
}

fn aes_mix_columns(state: mut ref i64) -> i64 {
  let c: i64 = 0;
  while c < 4 {
    let a0: u32 = buf_read_byte(state, (0 + 4 * c) as u32);
    let a1: u32 = buf_read_byte(state, (1 + 4 * c) as u32);
    let a2: u32 = buf_read_byte(state, (2 + 4 * c) as u32);
    let a3: u32 = buf_read_byte(state, (3 + 4 * c) as u32);
    let two: u32 = 2 as u32;
    let three: u32 = 3 as u32;
    let n0: u32 = gf256_mul(a0, two) ^ gf256_mul(a1, three) ^ a2 ^ a3;
    let n1: u32 = a0 ^ gf256_mul(a1, two) ^ gf256_mul(a2, three) ^ a3;
    let n2: u32 = a0 ^ a1 ^ gf256_mul(a2, two) ^ gf256_mul(a3, three);
    let n3: u32 = gf256_mul(a0, three) ^ a1 ^ a2 ^ gf256_mul(a3, two);
    let _ = buf_write_byte(state, (0 + 4 * c) as u32, n0);
    let _ = buf_write_byte(state, (1 + 4 * c) as u32, n1);
    let _ = buf_write_byte(state, (2 + 4 * c) as u32, n2);
    let _ = buf_write_byte(state, (3 + 4 * c) as u32, n3);
    c = c + 1;
  }
  return 0;
}

// One-shot AES-128 single-block ECB encrypt: expands the key fresh
// each call (a caller encrypting many blocks under the same key
// should expand once and reuse -- not built as a separate entry point
// here, no real caller needs it yet; see this section's own header
// comment on scope). `key`/`block`/`out` are 16 bytes each; `w_scratch`
// is a caller-supplied 176-byte buffer for the expanded round keys;
// `state_scratch`/`temp_scratch` are caller-supplied 16-byte and
// 4-byte working buffers respectively.
fn aes128_encrypt_block(key: mut ref i64, block: mut ref i64, out: mut ref i64,
                         w_scratch: mut ref i64, state_scratch: mut ref i64, temp_scratch: mut ref i64) -> i64 {
  let _ = aes128_key_expansion(key, w_scratch);
  let i: i64 = 0;
  while i < 16 {
    let _ = buf_write_byte(state_scratch, i as u32, buf_read_byte(block, i as u32));
    i = i + 1;
  }
  let _ = aes_add_round_key(state_scratch, w_scratch, 0);
  let rnd: i64 = 1;
  while rnd < 10 {
    let _ = aes_sub_bytes(state_scratch);
    let _ = aes_shift_rows(state_scratch, temp_scratch);
    let _ = aes_mix_columns(state_scratch);
    let _ = aes_add_round_key(state_scratch, w_scratch, rnd);
    rnd = rnd + 1;
  }
  let _ = aes_sub_bytes(state_scratch);
  let _ = aes_shift_rows(state_scratch, temp_scratch);
  let _ = aes_add_round_key(state_scratch, w_scratch, 10);
  let j: i64 = 0;
  while j < 16 {
    let _ = buf_write_byte(out, j as u32, buf_read_byte(state_scratch, j as u32));
    j = j + 1;
  }
  return 0;
}


// FIPS-197 Appendix B's own worked example, plus a cross-check that a
// different key produces a different ciphertext for the same
// plaintext (the actual security property, not just "runs") -- same
// verification discipline as every other primitive this round,
// generated by the exact Python spike that verified this GF(2^8)
// construction before any of it was ported (see this section's own
// header comment above aes128_encrypt_block).
fn aes128_self_test() -> i64 {
  let ok: i64 = 1;

  let w_scratch: mut ref i64 = dhruva_alloc_bytes(176);
  let state_scratch: mut ref i64 = dhruva_alloc_bytes(16);
  let temp_scratch: mut ref i64 = dhruva_alloc_bytes(4);

  let key0: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(key0, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(key0, 1 as u32, 0x01 as u32);
  let _ = buf_write_byte(key0, 2 as u32, 0x02 as u32);
  let _ = buf_write_byte(key0, 3 as u32, 0x03 as u32);
  let _ = buf_write_byte(key0, 4 as u32, 0x04 as u32);
  let _ = buf_write_byte(key0, 5 as u32, 0x05 as u32);
  let _ = buf_write_byte(key0, 6 as u32, 0x06 as u32);
  let _ = buf_write_byte(key0, 7 as u32, 0x07 as u32);
  let _ = buf_write_byte(key0, 8 as u32, 0x08 as u32);
  let _ = buf_write_byte(key0, 9 as u32, 0x09 as u32);
  let _ = buf_write_byte(key0, 10 as u32, 0x0a as u32);
  let _ = buf_write_byte(key0, 11 as u32, 0x0b as u32);
  let _ = buf_write_byte(key0, 12 as u32, 0x0c as u32);
  let _ = buf_write_byte(key0, 13 as u32, 0x0d as u32);
  let _ = buf_write_byte(key0, 14 as u32, 0x0e as u32);
  let _ = buf_write_byte(key0, 15 as u32, 0x0f as u32);

  let pt0: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(pt0, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(pt0, 1 as u32, 0x11 as u32);
  let _ = buf_write_byte(pt0, 2 as u32, 0x22 as u32);
  let _ = buf_write_byte(pt0, 3 as u32, 0x33 as u32);
  let _ = buf_write_byte(pt0, 4 as u32, 0x44 as u32);
  let _ = buf_write_byte(pt0, 5 as u32, 0x55 as u32);
  let _ = buf_write_byte(pt0, 6 as u32, 0x66 as u32);
  let _ = buf_write_byte(pt0, 7 as u32, 0x77 as u32);
  let _ = buf_write_byte(pt0, 8 as u32, 0x88 as u32);
  let _ = buf_write_byte(pt0, 9 as u32, 0x99 as u32);
  let _ = buf_write_byte(pt0, 10 as u32, 0xaa as u32);
  let _ = buf_write_byte(pt0, 11 as u32, 0xbb as u32);
  let _ = buf_write_byte(pt0, 12 as u32, 0xcc as u32);
  let _ = buf_write_byte(pt0, 13 as u32, 0xdd as u32);
  let _ = buf_write_byte(pt0, 14 as u32, 0xee as u32);
  let _ = buf_write_byte(pt0, 15 as u32, 0xff as u32);

  let out0: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = aes128_encrypt_block(key0, pt0, out0, w_scratch, state_scratch, temp_scratch);

  let expected0: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(expected0, 0 as u32, 0x69 as u32);
  let _ = buf_write_byte(expected0, 1 as u32, 0xc4 as u32);
  let _ = buf_write_byte(expected0, 2 as u32, 0xe0 as u32);
  let _ = buf_write_byte(expected0, 3 as u32, 0xd8 as u32);
  let _ = buf_write_byte(expected0, 4 as u32, 0x6a as u32);
  let _ = buf_write_byte(expected0, 5 as u32, 0x7b as u32);
  let _ = buf_write_byte(expected0, 6 as u32, 0x04 as u32);
  let _ = buf_write_byte(expected0, 7 as u32, 0x30 as u32);
  let _ = buf_write_byte(expected0, 8 as u32, 0xd8 as u32);
  let _ = buf_write_byte(expected0, 9 as u32, 0xcd as u32);
  let _ = buf_write_byte(expected0, 10 as u32, 0xb7 as u32);
  let _ = buf_write_byte(expected0, 11 as u32, 0x80 as u32);
  let _ = buf_write_byte(expected0, 12 as u32, 0x70 as u32);
  let _ = buf_write_byte(expected0, 13 as u32, 0xb4 as u32);
  let _ = buf_write_byte(expected0, 14 as u32, 0xc5 as u32);
  let _ = buf_write_byte(expected0, 15 as u32, 0x5a as u32);

  if chacha20_bytes_equal(out0, expected0, 16) == 0 {
    ok = 0;
  }

  let key1: mut ref i64 = dhruva_alloc_bytes(16);
  let ki: i64 = 0;
  while ki < 16 {
    let _ = buf_write_byte(key1, ki as u32, buf_read_byte(key0, ki as u32) ^ (1 as u32));
    ki = ki + 1;
  }
  let out1: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = aes128_encrypt_block(key1, pt0, out1, w_scratch, state_scratch, temp_scratch);
  if chacha20_bytes_equal(out0, out1, 16) == 1 {
    ok = 0; // a single flipped key bit produced the SAME ciphertext -- broken
  }

  let _ = uart_puts("CRYPTO: AES-128 (constant-time, table-free S-box) vs FIPS-197 Appendix B");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}


// Round 67: ChaCha20-Poly1305 AEAD (RFC 8439 section 2.8) and HKDF
// (RFC 5869) -- the "crypto machinery" a TLS 1.3 handshake needs on
// top of the ECDHE (X25519) and signature (Ed25519) primitives
// already built this round. Deliberately does NOT include the
// handshake state machine itself (ClientHello/ServerHello framing,
// the full key-schedule sequence, record-layer parsing) -- same
// "smallest real increment, not the whole surface" discipline this
// round has applied throughout (PKI's own raw-key-trust scoping,
// AES's own encrypt-only scoping). This is real, complete,
// independently useful cryptographic machinery on its own, not
// unusable partial plumbing -- an AEAD and a KDF are both needed for
// things well beyond TLS specifically.
//
// Verified via a from-scratch Python port of both constructions,
// checked against the real `cryptography` library before any vani
// code was written: the AEAD (ciphertext AND tag) matches
// ChaCha20Poly1305's own encrypt() output across 20 random trials
// with varying AAD/plaintext lengths (exercising the RFC's own
// pad16 boundary in both directions); HKDF (extract then expand)
// matches the library's own HKDF across 15 random trials with varying
// output lengths, including lengths past one SHA-256 block requiring
// the T(1)||T(2) multi-block expansion path.

// out = (a + b) mod 2^64, written as two 4-byte little-endian words
// -- shared by both the AEAD's own 8-byte length fields below.
fn aead_write_le64(buf: mut ref i64, off: i64, v: i64) -> i64 {
  let vu: u64 = v as u64;
  let i: i64 = 0;
  while i < 8 {
    let b: u32 = ((vu >> ((i * 8) as u64)) & (255 as u64)) as u32;
    let _ = buf_write_byte(buf, (off + i) as u32, b);
    i = i + 1;
  }
  return 0;
}

// Round 102: ChaCha20-Poly1305 AEAD, now a thin heap-pointer adapter
// over the `chacha20_poly1305` package's own STREAMING primitives
// (`chacha20_xor_chunk`, `Poly1305Ctx`/`update`/`finalize`,
// `cp_feed_padded_aad`, `cp_len_trailer`), not its capped 512-byte
// one-shot `chacha20_poly1305_encrypt`/`decrypt` -- Pi 1's own real
// TLS records (`tls_encrypt_record`/`decrypt_record`, up to 2048
// bytes) exceed that cap. `_heap` suffix: same name-collision
// reasoning as every other adapter in this file (rounds 99-100) --
// the package's own `chacha20_poly1305_encrypt`/`decrypt` names are
// already taken by its capped one-shot convenience layer.
fn chacha20_poly1305_encrypt_heap(key: mut ref i64, nonce: mut ref i64, aad: mut ref i64, aad_len: i64, plaintext: mut ref i64, plaintext_len: i64, out_ciphertext: mut ref i64, out_tag: mut ref i64) -> i64 {
  let key_arr: [u8; 32] = [
    buf_read_byte(key, 0 as u32) as u8, buf_read_byte(key, 1 as u32) as u8, buf_read_byte(key, 2 as u32) as u8, buf_read_byte(key, 3 as u32) as u8,
    buf_read_byte(key, 4 as u32) as u8, buf_read_byte(key, 5 as u32) as u8, buf_read_byte(key, 6 as u32) as u8, buf_read_byte(key, 7 as u32) as u8,
    buf_read_byte(key, 8 as u32) as u8, buf_read_byte(key, 9 as u32) as u8, buf_read_byte(key, 10 as u32) as u8, buf_read_byte(key, 11 as u32) as u8,
    buf_read_byte(key, 12 as u32) as u8, buf_read_byte(key, 13 as u32) as u8, buf_read_byte(key, 14 as u32) as u8, buf_read_byte(key, 15 as u32) as u8,
    buf_read_byte(key, 16 as u32) as u8, buf_read_byte(key, 17 as u32) as u8, buf_read_byte(key, 18 as u32) as u8, buf_read_byte(key, 19 as u32) as u8,
    buf_read_byte(key, 20 as u32) as u8, buf_read_byte(key, 21 as u32) as u8, buf_read_byte(key, 22 as u32) as u8, buf_read_byte(key, 23 as u32) as u8,
    buf_read_byte(key, 24 as u32) as u8, buf_read_byte(key, 25 as u32) as u8, buf_read_byte(key, 26 as u32) as u8, buf_read_byte(key, 27 as u32) as u8,
    buf_read_byte(key, 28 as u32) as u8, buf_read_byte(key, 29 as u32) as u8, buf_read_byte(key, 30 as u32) as u8, buf_read_byte(key, 31 as u32) as u8
  ];
  let nonce_arr: [u8; 12] = [
    buf_read_byte(nonce, 0 as u32) as u8, buf_read_byte(nonce, 1 as u32) as u8, buf_read_byte(nonce, 2 as u32) as u8, buf_read_byte(nonce, 3 as u32) as u8,
    buf_read_byte(nonce, 4 as u32) as u8, buf_read_byte(nonce, 5 as u32) as u8, buf_read_byte(nonce, 6 as u32) as u8, buf_read_byte(nonce, 7 as u32) as u8,
    buf_read_byte(nonce, 8 as u32) as u8, buf_read_byte(nonce, 9 as u32) as u8, buf_read_byte(nonce, 10 as u32) as u8, buf_read_byte(nonce, 11 as u32) as u8
  ];
  let aad_arr: [u8; 64] = cp_zero64_bytes();
  let ai: i64 = 0;
  while ai < aad_len {
    aad_arr[ai] = buf_read_byte(aad, ai as u32) as u8;
    ai = ai + 1;
  }

  let block0: [u8; 64] = chacha20_block(ref key_arr, 0 as u32, ref nonce_arr);
  let otk: [u8; 32] = cp_extract32(ref block0);

  let counter: u32 = 1 as u32;
  let offset: i64 = 0;
  while offset < plaintext_len {
    let remaining: i64 = plaintext_len - offset;
    let this_block: i64 = if remaining < 64 { remaining } else { 64 };
    let chunk: [u8; 64] = cp_zero64_bytes();
    let ci: i64 = 0;
    while ci < this_block {
      chunk[ci] = buf_read_byte(plaintext, (offset + ci) as u32) as u8;
      ci = ci + 1;
    }
    let ks_out: [u8; 64] = chacha20_xor_chunk(ref key_arr, ref nonce_arr, counter, ref chunk, this_block);
    let cj: i64 = 0;
    while cj < this_block {
      let _ = buf_write_byte(out_ciphertext, (offset + cj) as u32, ks_out[cj] as u32);
      cj = cj + 1;
    }
    offset = offset + 64;
    counter = wrapping_add(counter, 1 as u32);
  }

  let ctx0: Poly1305Ctx = poly1305_init(ref otk);
  let ctx1: Poly1305Ctx = cp_feed_padded_aad(ctx0, ref aad_arr, aad_len);
  let ctx2: Poly1305Ctx = ctx1;
  let pos: i64 = 0;
  while pos < plaintext_len {
    let remaining2: i64 = plaintext_len - pos;
    let take: i64 = if remaining2 < 256 { remaining2 } else { 256 };
    let mchunk: [u8; 256] = cp_zero256_bytes();
    let mi: i64 = 0;
    while mi < take {
      mchunk[mi] = buf_read_byte(out_ciphertext, (pos + mi) as u32) as u8;
      mi = mi + 1;
    }
    ctx2 = poly1305_update(ref ctx2, ref mchunk, take);
    pos = pos + take;
  }
  let data_pad_len: i64 = (16 - (plaintext_len % 16)) % 16;
  if data_pad_len > 0 {
    let padchunk: [u8; 256] = cp_zero256_bytes();
    ctx2 = poly1305_update(ref ctx2, ref padchunk, data_pad_len);
  }
  let trailer: [u8; 16] = cp_len_trailer(aad_len, plaintext_len);
  let trailer_chunk: [u8; 256] = cp_zero256_bytes();
  let ti: i64 = 0;
  while ti < 16 {
    trailer_chunk[ti] = trailer[ti];
    ti = ti + 1;
  }
  let ctx3: Poly1305Ctx = poly1305_update(ref ctx2, ref trailer_chunk, 16);
  let tag: [u8; 16] = poly1305_finalize(ref ctx3);

  let wi: i64 = 0;
  while wi < 16 {
    let _ = buf_write_byte(out_tag, wi as u32, tag[wi] as u32);
    wi = wi + 1;
  }
  return 0;
}

// Verifies `tag_in` (16 bytes) against `ciphertext`/`aad`, and if
// (and only if) it matches, decrypts into `out_plaintext`. Returns 0
// on success, -1 on a tag mismatch (out_plaintext is left untouched
// -- "reject, don't guess," same posture as every other integrity
// check in this codebase; a caller must never act on decrypted data
// from a call that returned -1). Same `_heap`-over-streaming-
// primitives shape as the encrypt adapter above.
fn chacha20_poly1305_decrypt_heap(key: mut ref i64, nonce: mut ref i64, aad: mut ref i64, aad_len: i64, ciphertext: mut ref i64, ciphertext_len: i64, tag_in: mut ref i64, out_plaintext: mut ref i64) -> i64 {
  let key_arr: [u8; 32] = [
    buf_read_byte(key, 0 as u32) as u8, buf_read_byte(key, 1 as u32) as u8, buf_read_byte(key, 2 as u32) as u8, buf_read_byte(key, 3 as u32) as u8,
    buf_read_byte(key, 4 as u32) as u8, buf_read_byte(key, 5 as u32) as u8, buf_read_byte(key, 6 as u32) as u8, buf_read_byte(key, 7 as u32) as u8,
    buf_read_byte(key, 8 as u32) as u8, buf_read_byte(key, 9 as u32) as u8, buf_read_byte(key, 10 as u32) as u8, buf_read_byte(key, 11 as u32) as u8,
    buf_read_byte(key, 12 as u32) as u8, buf_read_byte(key, 13 as u32) as u8, buf_read_byte(key, 14 as u32) as u8, buf_read_byte(key, 15 as u32) as u8,
    buf_read_byte(key, 16 as u32) as u8, buf_read_byte(key, 17 as u32) as u8, buf_read_byte(key, 18 as u32) as u8, buf_read_byte(key, 19 as u32) as u8,
    buf_read_byte(key, 20 as u32) as u8, buf_read_byte(key, 21 as u32) as u8, buf_read_byte(key, 22 as u32) as u8, buf_read_byte(key, 23 as u32) as u8,
    buf_read_byte(key, 24 as u32) as u8, buf_read_byte(key, 25 as u32) as u8, buf_read_byte(key, 26 as u32) as u8, buf_read_byte(key, 27 as u32) as u8,
    buf_read_byte(key, 28 as u32) as u8, buf_read_byte(key, 29 as u32) as u8, buf_read_byte(key, 30 as u32) as u8, buf_read_byte(key, 31 as u32) as u8
  ];
  let nonce_arr: [u8; 12] = [
    buf_read_byte(nonce, 0 as u32) as u8, buf_read_byte(nonce, 1 as u32) as u8, buf_read_byte(nonce, 2 as u32) as u8, buf_read_byte(nonce, 3 as u32) as u8,
    buf_read_byte(nonce, 4 as u32) as u8, buf_read_byte(nonce, 5 as u32) as u8, buf_read_byte(nonce, 6 as u32) as u8, buf_read_byte(nonce, 7 as u32) as u8,
    buf_read_byte(nonce, 8 as u32) as u8, buf_read_byte(nonce, 9 as u32) as u8, buf_read_byte(nonce, 10 as u32) as u8, buf_read_byte(nonce, 11 as u32) as u8
  ];
  let aad_arr: [u8; 64] = cp_zero64_bytes();
  let ai: i64 = 0;
  while ai < aad_len {
    aad_arr[ai] = buf_read_byte(aad, ai as u32) as u8;
    ai = ai + 1;
  }

  let block0: [u8; 64] = chacha20_block(ref key_arr, 0 as u32, ref nonce_arr);
  let otk: [u8; 32] = cp_extract32(ref block0);

  let ctx0: Poly1305Ctx = poly1305_init(ref otk);
  let ctx1: Poly1305Ctx = cp_feed_padded_aad(ctx0, ref aad_arr, aad_len);
  let ctx2: Poly1305Ctx = ctx1;
  let pos: i64 = 0;
  while pos < ciphertext_len {
    let remaining2: i64 = ciphertext_len - pos;
    let take: i64 = if remaining2 < 256 { remaining2 } else { 256 };
    let mchunk: [u8; 256] = cp_zero256_bytes();
    let mi: i64 = 0;
    while mi < take {
      mchunk[mi] = buf_read_byte(ciphertext, (pos + mi) as u32) as u8;
      mi = mi + 1;
    }
    ctx2 = poly1305_update(ref ctx2, ref mchunk, take);
    pos = pos + take;
  }
  let data_pad_len: i64 = (16 - (ciphertext_len % 16)) % 16;
  if data_pad_len > 0 {
    let padchunk: [u8; 256] = cp_zero256_bytes();
    ctx2 = poly1305_update(ref ctx2, ref padchunk, data_pad_len);
  }
  let trailer: [u8; 16] = cp_len_trailer(aad_len, ciphertext_len);
  let trailer_chunk: [u8; 256] = cp_zero256_bytes();
  let ti: i64 = 0;
  while ti < 16 {
    trailer_chunk[ti] = trailer[ti];
    ti = ti + 1;
  }
  let ctx3: Poly1305Ctx = poly1305_update(ref ctx2, ref trailer_chunk, 16);
  let computed_tag: [u8; 16] = poly1305_finalize(ref ctx3);

  let tag_in_arr: [u8; 16] = [
    buf_read_byte(tag_in, 0 as u32) as u8, buf_read_byte(tag_in, 1 as u32) as u8, buf_read_byte(tag_in, 2 as u32) as u8, buf_read_byte(tag_in, 3 as u32) as u8,
    buf_read_byte(tag_in, 4 as u32) as u8, buf_read_byte(tag_in, 5 as u32) as u8, buf_read_byte(tag_in, 6 as u32) as u8, buf_read_byte(tag_in, 7 as u32) as u8,
    buf_read_byte(tag_in, 8 as u32) as u8, buf_read_byte(tag_in, 9 as u32) as u8, buf_read_byte(tag_in, 10 as u32) as u8, buf_read_byte(tag_in, 11 as u32) as u8,
    buf_read_byte(tag_in, 12 as u32) as u8, buf_read_byte(tag_in, 13 as u32) as u8, buf_read_byte(tag_in, 14 as u32) as u8, buf_read_byte(tag_in, 15 as u32) as u8
  ];
  if poly1305_verify_constant_time(ref computed_tag, ref tag_in_arr) == 0 {
    return 0 - 1;
  }

  let counter: u32 = 1 as u32;
  let offset: i64 = 0;
  while offset < ciphertext_len {
    let remaining3: i64 = ciphertext_len - offset;
    let this_block: i64 = if remaining3 < 64 { remaining3 } else { 64 };
    let chunk: [u8; 64] = cp_zero64_bytes();
    let ci: i64 = 0;
    while ci < this_block {
      chunk[ci] = buf_read_byte(ciphertext, (offset + ci) as u32) as u8;
      ci = ci + 1;
    }
    let ks_out: [u8; 64] = chacha20_xor_chunk(ref key_arr, ref nonce_arr, counter, ref chunk, this_block);
    let cj: i64 = 0;
    while cj < this_block {
      let _ = buf_write_byte(out_plaintext, (offset + cj) as u32, ks_out[cj] as u32);
      cj = cj + 1;
    }
    offset = offset + 64;
    counter = wrapping_add(counter, 1 as u32);
  }
  return 0;
}


// HKDF-Extract (RFC 5869 section 2.2): PRK = HMAC-SHA256(salt, ikm).
// Just hkdf_hmac_sha256 under a name matching the RFC's own
// terminology -- salt plays HMAC's "key" role, ikm its "message" role.
fn hkdf_extract(salt: mut ref i64, salt_len: i64, ikm: mut ref i64, ikm_len: i64, out_prk: mut ref i64) -> i64 {
  return hkdf_hmac_sha256(salt, salt_len, ikm, ikm_len, out_prk);
}

// HKDF-Expand (RFC 5869 section 2.3): T(0) = empty, T(i) =
// HMAC-SHA256(PRK, T(i-1) || info || i), OKM = T(1) || T(2) || ...
// truncated to `out_len` (capped at 256 bytes -- t_scratch's own
// fixed size -- comfortably past anything a SHA-256-based TLS 1.3
// cipher suite's own key schedule ever derives in one call).
fn hkdf_expand(prk: mut ref i64, prk_len: i64, info: mut ref i64, info_len: i64, out_len: i64,
               t_scratch: mut ref i64, hmac_input_scratch: mut ref i64, out: mut ref i64) -> i64 {
  let t_len: i64 = 0;
  let produced: i64 = 0;
  let counter: u32 = 1 as u32;
  while produced < out_len {
    let i: i64 = 0;
    while i < t_len {
      let _ = buf_write_byte(hmac_input_scratch, i as u32, buf_read_byte(t_scratch, i as u32));
      i = i + 1;
    }
    let j: i64 = 0;
    while j < info_len {
      let _ = buf_write_byte(hmac_input_scratch, (t_len + j) as u32, buf_read_byte(info, j as u32));
      j = j + 1;
    }
    let _ = buf_write_byte(hmac_input_scratch, (t_len + info_len) as u32, counter);
    let input_len: i64 = t_len + info_len + 1;

    let _ = hkdf_hmac_sha256(prk, prk_len, hmac_input_scratch, input_len, t_scratch);
    t_len = 32;

    let take: i64 = if (out_len - produced) < 32 { out_len - produced } else { 32 };
    let k: i64 = 0;
    while k < take {
      let _ = buf_write_byte(out, (produced + k) as u32, buf_read_byte(t_scratch, k as u32));
      k = k + 1;
    }
    produced = produced + take;
    counter = counter + (1 as u32);
  }
  return 0;
}

// A separate, larger-capacity HMAC-SHA256, deliberately NOT sharing
// code or scratch with round 61's own `hmac_sha256` (real
// authentication's own security-critical, already-tested primitive,
// capped at msg_len<=64 for its own narrower need) -- HKDF-Expand's
// own per-round HMAC input (T(i-1) || info || counter) can genuinely
// exceed 64 bytes once `info` is TLS-shaped, and touching a proven,
// already-shipped authentication primitive to widen its cap for an
// unrelated caller is exactly the kind of risk this project's own
// "don't touch working code without a real forcing need" discipline
// warns against -- a small amount of duplicated HMAC structure is a
// better trade than that risk. msg_len capped at 256 bytes by
// hkdf_hmac_msg_scratch's own fixed size (64 + 256), comfortably past
// anything HKDF-Expand's own construction above ever builds.
fn hkdf_hmac_sha256(key: mut ref i64, key_len: i64, msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  if msg_len > 256 {
    return 0 - 1;
  }
  let key_block: mut ref i64 = hkdf_hmac_key_block_get();
  let i: i64 = 0;
  if key_len > 64 {
    let _ = sha256_hash(key, key_len, key_block);
    i = 32;
  } else {
    while i < key_len {
      let _ = buf_write_byte(key_block, i as u32, buf_read_byte(key, i as u32));
      i = i + 1;
    }
  }
  while i < 64 {
    let _ = buf_write_byte(key_block, i as u32, 0 as u32);
    i = i + 1;
  }

  let msg_scratch: mut ref i64 = hkdf_hmac_msg_scratch_get();
  i = 0;
  while i < 64 {
    let kb: u32 = buf_read_byte(key_block, i as u32);
    let _ = buf_write_byte(msg_scratch, i as u32, kb ^ (0x36 as u32));
    i = i + 1;
  }
  i = 0;
  while i < msg_len {
    let _ = buf_write_byte(msg_scratch, (64 + i) as u32, buf_read_byte(msg, i as u32));
    i = i + 1;
  }
  let inner_hash: mut ref i64 = hkdf_hmac_inner_hash_get();
  let _ = sha256_hash(msg_scratch, 64 + msg_len, inner_hash);

  i = 0;
  while i < 64 {
    let kb2: u32 = buf_read_byte(key_block, i as u32);
    let _ = buf_write_byte(msg_scratch, i as u32, kb2 ^ (0x5c as u32));
    i = i + 1;
  }
  i = 0;
  while i < 32 {
    let _ = buf_write_byte(msg_scratch, (64 + i) as u32, buf_read_byte(inner_hash, i as u32));
    i = i + 1;
  }
  let _ = sha256_hash(msg_scratch, 96, out);
  return 0;
}


// AEAD and HKDF vectors both generated by the same verified Python
// run as every other primitive this round (cross-checked against the
// real `cryptography` library's own ChaCha20Poly1305/HKDF objects) --
// see this section's own header comment above chacha20_poly1305_
// encrypt for the full methodology.
fn aead_hkdf_self_test() -> i64 {
  let ok: i64 = 1;

  let key: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(key, 0 as u32, 0x00 as u32);
  let _ = buf_write_byte(key, 1 as u32, 0x01 as u32);
  let _ = buf_write_byte(key, 2 as u32, 0x02 as u32);
  let _ = buf_write_byte(key, 3 as u32, 0x03 as u32);
  let _ = buf_write_byte(key, 4 as u32, 0x04 as u32);
  let _ = buf_write_byte(key, 5 as u32, 0x05 as u32);
  let _ = buf_write_byte(key, 6 as u32, 0x06 as u32);
  let _ = buf_write_byte(key, 7 as u32, 0x07 as u32);
  let _ = buf_write_byte(key, 8 as u32, 0x08 as u32);
  let _ = buf_write_byte(key, 9 as u32, 0x09 as u32);
  let _ = buf_write_byte(key, 10 as u32, 0x0a as u32);
  let _ = buf_write_byte(key, 11 as u32, 0x0b as u32);
  let _ = buf_write_byte(key, 12 as u32, 0x0c as u32);
  let _ = buf_write_byte(key, 13 as u32, 0x0d as u32);
  let _ = buf_write_byte(key, 14 as u32, 0x0e as u32);
  let _ = buf_write_byte(key, 15 as u32, 0x0f as u32);
  let _ = buf_write_byte(key, 16 as u32, 0x10 as u32);
  let _ = buf_write_byte(key, 17 as u32, 0x11 as u32);
  let _ = buf_write_byte(key, 18 as u32, 0x12 as u32);
  let _ = buf_write_byte(key, 19 as u32, 0x13 as u32);
  let _ = buf_write_byte(key, 20 as u32, 0x14 as u32);
  let _ = buf_write_byte(key, 21 as u32, 0x15 as u32);
  let _ = buf_write_byte(key, 22 as u32, 0x16 as u32);
  let _ = buf_write_byte(key, 23 as u32, 0x17 as u32);
  let _ = buf_write_byte(key, 24 as u32, 0x18 as u32);
  let _ = buf_write_byte(key, 25 as u32, 0x19 as u32);
  let _ = buf_write_byte(key, 26 as u32, 0x1a as u32);
