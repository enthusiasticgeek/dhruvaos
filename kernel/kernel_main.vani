// श्री।
intent "Dhruva Phase 0-2 -- bare-metal boot + UART hello on BCM2835 (Pi 1 Model B / QEMU raspi1ap), fixed-priority preemptive scheduling across three tasks plus a minimal Immediate Priority Ceiling Protocol mutex demonstrating bounded (not unbounded) priority inversion. Entered from boot/rpi1/boot.S's _start after the stack pointer is set up and BSS is cleared.";

// Context-switch mechanics (boot/context_switch.S) and the tiny amount
// of raw memory allocation they need (boot/rpi1/runtime_stubs.c) are
// necessarily outside vani: a task-to-task context switch needs to save/
// restore raw CPU registers and swap the live stack pointer mid-function,
// which no high-level language's normal control flow can express.
//
// Every address crossing this boundary is `mut ref i64`, not a bare
// `i64` -- corrected 2026-08-25 after finding this was never actually a
// vani limitation. Initial versions of this file used plain `i64`
// because of two wrong assumptions, both disproven by testing the real
// LLVM IR/ARM codegen directly rather than guessing from the first error
// message: (1) that raw pointer types can't cross extern "C" at all --
// false, `ref T`/`mut ref T` cross cleanly as single-register pointers
// (confirmed: `mut ref i64` params/returns lower to plain `i64*` in LLVM
// IR, always exactly one register on this 32-bit target); (2) that a
// second-class reference can't be stored in a `let` and reused across
// several later calls within the same function -- also false, only
// escaping the *enclosing function's* scope is disallowed, and nothing
// here needs that.
//
// This isn't just cleaner -- it fixes a real bug class. vani's `i64` is
// a genuine 64-bit value, and AAPCS passes a 64-bit *scalar* argument as
// a register PAIR (with alignment padding that can silently shift a
// later argument by a register). A pointer never has that problem: it's
// always exactly one register, on any 32-bit target, regardless of how
// many other arguments precede it. Using `mut ref i64` for every
// address here removes the entire "which register is this actually in"
// risk class the earlier plain-i64 version had to work around by hand.
extern "C" fn dhruva_alloc_bytes(n: i64) -> mut ref i64;

// Shared, persistent scratch buffers -- see scratch_state.S's own doc
// comment for why these exist (fs_compact wasn't the only place a
// dhruva_alloc_bytes call was hiding inside something called every GC
// wake or every shell command instead of once at boot).
extern "C" fn fs_sd_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn fs_sd_scratch_get() -> mut ref i64;
extern "C" fn fs_path_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn fs_path_scratch_get() -> mut ref i64;
extern "C" fn fs_data_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn fs_data_scratch_get() -> mut ref i64;
extern "C" fn shell_line_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn shell_line_scratch_get() -> mut ref i64;
extern "C" fn eval_values_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn eval_values_scratch_get() -> mut ref i64;
extern "C" fn eval_ops_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn eval_ops_scratch_get() -> mut ref i64;
extern "C" fn uart_digits_scratch_set(addr: mut ref i64) -> i64;
extern "C" fn uart_digits_scratch_get() -> mut ref i64;
extern "C" fn task_a_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn task_b_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn task_c_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn task_d_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn task_e_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn task_f_init_stack(stack_base: mut ref i64, stack_bytes: i64) -> mut ref i64;
extern "C" fn start_multitasking(sp_a: mut ref i64, sp_b: mut ref i64, sp_c: mut ref i64, sp_d: mut ref i64, sp_e: mut ref i64, sp_f: mut ref i64) -> i64;
// task_a=HIGH(priority 0), task_b=MEDIUM(priority 1), task_c=LOW(priority 2),
// task_d=IDLE(priority 3, always ready, never sleeps) -- the standard
// RTOS answer to "what runs when nothing else is," and load-bearing
// here specifically: without it, scheduler_pick_next's "seed with the
// current task regardless of readiness" fallback (needed so a tied,
// ready incumbent is preferred without special-casing the comparison)
// could silently re-select a task that just called task_sleep_ticks to
// stop running, ignoring its own sleep request entirely. Idle
// guarantees there's always a genuinely ready task to fall back to.
// task_sleep_ticks/dhruva_prio_lock/dhruva_prio_unlock are boot/context_switch.S's
// scheduler primitives -- see that file for why dhruva_prio_lock/unlock need
// no lock-state of their own (the Immediate Priority Ceiling Protocol's
// whole point is that a correctly-assigned ceiling makes an explicit
// lock/wait-queue unnecessary for a single shared resource) while
// task_sleep_ticks needs a full context save (giving up the CPU
// voluntarily is just as real a suspension as being preempted).
// scheduler_switch_from_irq has no vani-side declaration: it's called
// only from hand-written assembly (boot/irq_entry.S), never from a
// vani call chain.
extern "C" fn task_sleep_ticks(ticks: i64) -> i64;
extern "C" fn dhruva_prio_lock(ceiling: i64) -> i64;
extern "C" fn dhruva_prio_unlock(base_priority: i64) -> i64;
// Phase 5: cpu_wfi/scheduler_ready_count -- context_switch.S.
extern "C" fn cpu_wfi() -> i64;
extern "C" fn scheduler_ready_count() -> i64;
