// context_switch.S's own scheduler_pick_next/dhruva_prio_lock, exactly
// the fragile hand-written-asm area this project has already taken two
// real, hard-to-diagnose bugs from).
extern "C" fn diag_ring_push(tick: u32, ctxsw: u32, irqs: u32, priolock: u32) -> i64;
extern "C" fn diag_ring_get_head() -> i64;
extern "C" fn diag_ring_get_count() -> i64;
extern "C" fn diag_ring_get_tick_at(physical_index: i64) -> i64;
extern "C" fn diag_ring_get_ctxsw_at(physical_index: i64) -> i64;
extern "C" fn diag_ring_get_irqs_at(physical_index: i64) -> i64;
extern "C" fn diag_ring_get_priolock_at(physical_index: i64) -> i64;

// Translates a LOGICAL sample index (0 = oldest available, count-1 =
// newest) into the PHYSICAL array slot diag_ring_get_*_at needs --
// deliberately done here in vani rather than in diag_ring_state.S
// itself (see that file's own header comment): before the ring has
// filled (count < 32), the oldest sample is always physical slot 0;
// once full, the oldest sample is wherever `head` currently points
// (about to be overwritten by the next push), and physical slots wrap
// modulo 32 from there.
fn diag_ring_physical_index(logical_index: i64) -> i64 {
  let count: i64 = diag_ring_get_count();
  let head: i64 = diag_ring_get_head();
  let start: i64 = if count < 32 { 0 } else { head };
  return (start + logical_index) % 32;
}
