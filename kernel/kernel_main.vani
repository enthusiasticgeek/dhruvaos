// Round 66: GATT's own discovered-services/characteristics tables --
// see boot/gatt_state.S's own header comment for the full design (why
// every accessor is single-field, at most 2 args). Every index/value
// parameter here is deliberately u32, not i64 -- this project's own
// well-documented AAPCS gotcha (a `mut ref i64`/single-register value
// before an i64 forces the i64 to an even-aligned register pair,
// shifting where a naively-assumed "next argument" actually lands;
// see context_switch_state.S's own task_sleep_ticks comment) means two
// i64 PARAMETERS in a row would place the second one in r2:r3, not r1
// as this file's own two-argument asm accessors (index in r0, value in
// r1, nothing more) actually expect. u32 sidesteps the whole class:
// each stays in exactly one register, matching diag_ring_push's own
// same fix for the identical reason.
extern "C" fn gatt_service_get_count() -> i64;
extern "C" fn gatt_service_set_count(count: u32) -> i64;
extern "C" fn gatt_service_get_start_handle_at(index: u32) -> i64;
extern "C" fn gatt_service_set_start_handle_at(index: u32, value: u32) -> i64;
extern "C" fn gatt_service_get_end_handle_at(index: u32) -> i64;
extern "C" fn gatt_service_set_end_handle_at(index: u32, value: u32) -> i64;
