fn delay(count: i64) -> i64 {
  let i: i64 = 0;
  while i < count {
    i = i + 1;
  }
  return 0;
}

// GPIO alt-function setup for UART0 TXD/RXD on pins 14/15 (BCM2835).
// Real hardware needs this before the PL011 UART will actually drive
// the pins; QEMU's emulated PL011 likely doesn't care, but doing it
// right from the start means this same code works unmodified when this
// boots on the real Model B, not just under QEMU.
fn gpio_uart_alt_init() -> i64 {
  let gpfsel1: i64 = 0x20200004;
  let gppud: i64 = 0x20200094;
  let gppudclk0: i64 = 0x20200098;

  let ra: u32 = mmio_read_u32(gpfsel1);
  // Clear bits 12-17 (pin14 + pin15 function-select fields), then set
  // both to ALT0 (0b100) -- UART0 TXD/RXD.
  let clear_mask: u32 = 0xFFFC0FFF as u32;
  let alt0_bits: u32 = 0x00024000 as u32;
  let ra2: u32 = (ra & clear_mask) | alt0_bits;
  let _ = mmio_write_u32(gpfsel1, ra2);

  let _ = mmio_write_u32(gppud, 0 as u32);
  let _ = delay(150);
  let _ = mmio_write_u32(gppudclk0, 0x0000C000 as u32);
  let _ = delay(150);
  let _ = mmio_write_u32(gppudclk0, 0 as u32);
  return 0;
}

fn uart_init() -> i64 {
  let _ = gpio_uart_alt_init();

  // BUG (round 18 audit, 2026-08-28): gpio_uart_alt_init() just wrote
  // GPIO peripheral registers (GPFSEL1/GPPUD/GPPUDCLK0, base
  // 0x20200000) to mux pins 14/15 onto the PL011 UART -- the writes
  // immediately below are the first access to a genuinely DIFFERENT
  // peripheral (PL011 UART, base 0x20201000). Round 17's "same
  // peripheral always arrives in-order" finding does NOT cover this:
  // that finding only applies WITHIN one peripheral's own registers;
  // this is exactly the case Broadcom's own BCM2835 guidance (see
  // context_switch.S's mem_barrier comment) says DOES need a barrier
  // -- "a memory write barrier before the first write to a
  // peripheral" when switching from one peripheral to another. On
  // real hardware, nothing guaranteed the GPIO mux write had actually
  // landed before UART_CR/IBRD/FBRD/LCRH start programming a
  // peripheral whose pins might not be routed yet. Invisible under
  // QEMU for the same reason every other barrier gap in this project
  // is: TCG never reorders anything.
  let _ = mem_barrier();

  let uart_cr: i64 = 0x20201030;
  let uart_icr: i64 = 0x20201044;
  let uart_ibrd: i64 = 0x20201024;
  let uart_fbrd: i64 = 0x20201028;
  let uart_lcrh: i64 = 0x2020102C;

  let _ = mmio_write_u32(uart_cr, 0 as u32);
  let _ = mmio_write_u32(uart_icr, 0x7FF as u32);
  // 115200 baud @ assumed 3MHz UART clock: IBRD=1, FBRD=40.
  let _ = mmio_write_u32(uart_ibrd, 1 as u32);
  let _ = mmio_write_u32(uart_fbrd, 40 as u32);
  // 8 bits, no parity, 1 stop bit, FIFOs enabled.
  let _ = mmio_write_u32(uart_lcrh, 0x70 as u32);
  // Enable UART + TX + RX.
  let _ = mmio_write_u32(uart_cr, 0x301 as u32);
  return 0;
}

// Phase 4 -- UART0's own interrupt (RX FIFO non-empty), routed through
// the same BCM2835 interrupt controller as the Phase 2 timer, but a
// different GPU IRQ line (57, not 1) landing in the controller's
// SECOND pending/enable register (IRQs 32-63), not the first --
// confirmed against QEMU's own hw/arm/raspi_platform.h source rather
// than assumed, the same discipline every other MMIO peripheral in
// this project has needed. PL011 register offsets (IMSC/RIS/MIS/ICR)
// are the standard ARM PrimeCell UART layout, not BCM2835-specific --
// already load-bearing elsewhere in this file (uart_icr at the same
// 0x44 offset used here, from uart_init/the existing TX path).
fn uart_rx_irq_init() -> i64 {
  let uart_imsc: i64 = 0x20201038;
  // RXIM (bit 4): interrupt whenever the RX FIFO is above its trigger
  // level -- left at the PL011 default (1/8 full), close enough to
  // "every keystroke" for interactive typing at human speed.
  let _ = mmio_write_u32(uart_imsc, 0x10 as u32);

  let ic_enable2: i64 = 0x2000B214;
  // GPU IRQ 57 (UART0) is bit 25 of the controller's second
  // enable/pending register group (IRQs 32-63).
  let _ = mmio_write_u32(ic_enable2, 0x02000000 as u32);
  return 0;
}

fn uart_putc(c: i64) -> i64 {
  let uart_fr: i64 = 0x20201018;
  let uart_dr: i64 = 0x20201000;
  // Wait while the TX FIFO is full (FR bit 5).
  while true {
    let fr: u32 = mmio_read_u32(uart_fr);
    if (fr & (0x20 as u32)) == (0 as u32) {
      break;
    }
  }
  let _ = mmio_write_u8(uart_dr, c as u8);
  return 0;
}

// Best-effort, WCET-safe single-char write for hard-RT contexts:
// uart_putc's own FIFO-full wait loop has no compile-time-provable
// iteration bound (the estimator correctly rejects it under
// #[wcet(...)] for exactly that reason), so this checks the FIFO
// status once and silently drops the byte if it's full rather than
// spinning -- a genuine tradeoff (an occasional missed debug
// character), not a workaround: an ISR that MUST make forward
// progress can never afford to block on a shared peripheral no matter
// how unlikely the wait would be in practice.
fn uart_putc_nonblocking(c: i64) -> i64 {
  let uart_fr: i64 = 0x20201018;
  let uart_dr: i64 = 0x20201000;
  let fr: u32 = mmio_read_u32(uart_fr);
  if (fr & (0x20 as u32)) == (0 as u32) {
    let _ = mmio_write_u8(uart_dr, c as u8);
  }
  return 0;
}

fn uart_puts(s: Str) -> i64 {
  let n: i64 = str_len_bytes(s);
  let i: i64 = 0;
  while i < n {
    let b: i64 = str_byte_at(s, i);
    let _ = uart_putc(b);
    i = i + 1;
  }
  return 0;
}

// Debug helper for bringing up new MMIO peripherals (Phase 3's SD
// driver first): print a u32 as 8 hex digits, most-significant nibble
// first. Not on any hard-RT path, so plain uart_putc's blocking wait
// is fine here (unlike irq_dispatch's uart_putc_nonblocking).
fn uart_put_hex32(v: u32) -> i64 {
  let shift: i64 = 28;
  while shift >= 0 {
    let nibble: u32 = (v >> (shift as u32)) & (0xF as u32);
    let n: i64 = nibble as i64;
    if n < 10 {
      let _ = uart_putc(48 + n);
    } else {
      let _ = uart_putc(55 + n);
    }
    shift = shift - 4;
  }
  return 0;
}

// Round 38: called directly from vectors.S's fault_data_abort/
// fault_prefetch_abort -- see that file's own comment on why these
// exist now (MMU permission faults, this round's own W^X enforcement,
// are a genuinely expected event rather than an unrecoverable bug,
// and a silent halt would make any real page-table mistake here
// undebuggable). #[no_mangle] so assembly can `bl` these by plain
// name, the same convention irq_dispatch/scheduler_switch_from_irq
// already establish. #[no_heap]: both only ever call uart_puts/
// uart_put_hex32 (already proven not to allocate, used from task_d's
// own #[no_heap] idle loop), and a fault handler is exactly the place
// that must never depend on heap state being sane -- the fault itself
// could have been caused by heap corruption. Neither function ever
// returns in practice (the assembly caller always follows with `b .`
// regardless of what these do), so the return value is unused.
//
// Status bits[3:0] == 0b1101 (0xD) identifies a section permission
// fault under the plain (non-remapped, non-LPAE) ARMv6 short-
// descriptor format this project's page table uses -- called out
// explicitly here since it's the ONE fault type this round's own live
// verification deliberately triggers (a write to the read-only code
// section, or an execute attempt from an XN-marked data section) to
// prove W^X is actually enforced, not just present in the table.
fn abort_fault_is_section_permission(status: u32) -> i64 {
  if (status & (0xF as u32)) == (0xD as u32) {
    return 1;
  }
  return 0;
}

#[no_mangle]
#[no_heap]
fn abort_report_data(addr: u32, status: u32) -> i64 {
  let _ = uart_puts("\nFATAL: Data Abort at address ");
  let _ = uart_put_hex32(addr);
  let _ = uart_puts(" status=");
  let _ = uart_put_hex32(status);
  if abort_fault_is_section_permission(status) == 1 {
    let _ = uart_puts(" (section permission fault)");
  }
  let _ = uart_puts(" -- halting\n");
  return 0;
}

#[no_mangle]
#[no_heap]
fn abort_report_prefetch(addr: u32, status: u32) -> i64 {
  let _ = uart_puts("\nFATAL: Prefetch Abort at address ");
  let _ = uart_put_hex32(addr);
  let _ = uart_puts(" status=");
  let _ = uart_put_hex32(status);
  if abort_fault_is_section_permission(status) == 1 {
    let _ = uart_puts(" (section permission fault)");
  }
  let _ = uart_puts(" -- halting\n");
  return 0;
}

// Round 28: same nibble-printing logic as uart_put_hex32 right above,
// just two digits instead of eight -- needed for MAC address
// formatting (AA:BB:CC:DD:EE:FF), where a full 32-bit-wide print
// would be wrong for a single byte.
fn uart_put_hex_byte(v: u32) -> i64 {
  let shift: i64 = 4;
  while shift >= 0 {
    let nibble: u32 = (v >> (shift as u32)) & (0xF as u32);
    let n: i64 = nibble as i64;
    if n < 10 {
      let _ = uart_putc(48 + n);
    } else {
      let _ = uart_putc(55 + n);
    }
    shift = shift - 4;
  }
  return 0;
}

// Task #10: decimal (not hex) printer for eval's results -- a
// calculator that only ever prints hex isn't a useful demo. Iterative,
// not recursive (build the digit string in reverse into a scratch
// buffer, then print it forwards): this project's vani v1 checkers
// have already shown real friction with anything not statically
// bounded (see eval_expr_raw's own header comment), so a fixed-size
// scratch buffer (24 bytes -- comfortably more than i64's own max 20
// decimal digits plus a sign) sidesteps the question entirely rather
// than relying on however deep vani's recursion support actually goes.
// BUG (round 6 audit, 2026-08-27): this function used to negate the
// whole value up front (`value = 0 - value`) to convert a negative
// input into the positive domain before building its digit string.
// i64::MIN is the one i64 value whose own negation overflows -- its
// magnitude (9223372036854775808) is one more than i64::MAX can hold
// -- and unconditionally executing an operation that can overflow,
// rather than checking first, is the exact bug class round 2's audit
// spent a whole pass closing in eval_apply (see i64_mul_would_overflow's
// own comment): confirmed live against the real vani-compiler on this
// target that negating i64::MIN panics ("integer overflow in int64_t
// sub") in `vanic run`'s own interpreter, and this project has already
// separately confirmed that same trap's firing behavior is inconsistent
// between that interpreted context and the actual llc-compiled ARM
// object code this kernel ships as -- meaning the realistic outcomes
// here were either a silent wrong answer (a wraparound negation stays
// negative, so the digit loop below would never run, printing "-0"
// instead of "-9223372036854775808") or a full kernel hang
// (runtime_stubs.c's exit() is an infinite halt loop with no OS to
// return to). No caller passes i64::MIN today, but this is a general-
// purpose print helper used throughout the codebase -- worth closing
// before some future caller does.
//
// Fixed by working in the NEGATIVE domain throughout instead: a
// negative value's own quotient and remainder by 10 always shrink in
// magnitude (never grow), so neither can ever land on something i64
// can't represent, and the single-digit remainder negated at the very
// end (`0 - d`, d always in [-9, 0]) never comes close to overflowing
// either. This avoids ever negating the full value, so i64::MIN prints
// correctly with no special-case needed.
fn uart_put_i64(v: i64) -> i64 {
  let is_neg: i64 = 0;
  if v < 0 {
    is_neg = 1;
  }
  let neg_value: i64 = v;
  if v > 0 {
    neg_value = 0 - v;
  }
  let digits: mut ref i64 = uart_digits_scratch_get();
  let n: i64 = 0;
  if neg_value == 0 {
    let _ = buf_write_byte(digits, 0 as u32, 48 as u32);
    n = 1;
  } else {
    while neg_value < 0 {
      let d: i64 = 0 - (neg_value - ((neg_value / 10) * 10));
      let _ = buf_write_byte(digits, n as u32, (48 + d) as u32);
      n = n + 1;
      neg_value = neg_value / 10;
    }
  }
  if is_neg == 1 {
    let _ = uart_putc(45); // '-'
  }
  let i: i64 = n - 1;
  while i >= 0 {
    let c: u32 = buf_read_byte(digits, i as u32);
    let _ = uart_putc(c as i64);
    i = i - 1;
  }
  return 0;
}

// Phase 2 -- BCM2835 system timer (base 0x20003000) + interrupt
// controller (base 0x2000B000). Timer channel 1 (C1) is free for ARM
// use on real hardware (channels 0 and 2 are reserved for the GPU
// firmware); its compare-match interrupt is IRQ line 1, i.e. bit 1 of
// the IC's "pending 1" / "enable 1" registers. The timer free-runs at
// 1MHz (1 tick = 1 microsecond) -- a fixed property of this peripheral,
// not something Dhruva configures.
extern "C" fn enable_irqs() -> i64;

fn timer_ic_init() -> i64 {
  let timer_cs: i64 = 0x20003000;
  let timer_clo: i64 = 0x20003004;
  let timer_c1: i64 = 0x20003010;
  let ic_enable1: i64 = 0x2000B210;

  // Arm the first compare match 500ms out (500000 us @ 1MHz).
  let now: u32 = mmio_read_u32(timer_clo);
  let interval: u32 = 500000 as u32;
  let first: u32 = now + interval;
  let _ = mmio_write_u32(timer_c1, first);

  // Clear any stale match flag for channel 1 before enabling its IRQ.
  let _ = mmio_write_u32(timer_cs, 2 as u32);

  // BUG (round 19 audit, 2026-08-28): the write above is this
  // function's own stated guarantee ("clear any stale match flag...
  // before enabling its IRQ") -- but timer_cs (system timer, base
  // 0x20003000) and ic_enable1 (interrupt controller, base
  // 0x2000B000) are two different peripherals, and nothing enforced
  // that the clear had actually landed before the enable below
  // reached the IC. A genuinely stale match flag left over from
  // whatever ran before this (or simply a slow-draining posted write)
  // could let IC line 1 come up already pending, firing IRQ1 the
  // instant interrupts are unmasked (start_multitasking's restore,
  // much later in boot) rather than at the first real compare match.
  // In practice CPSR's I-bit stays set for the rest of kernel_main
  // (see this function's own two call sites and start_multitasking's
  // comment), so a huge amount of intervening work almost certainly
  // drains any posted write long before that matters -- but "almost
  // certainly, given how much code runs after this" is exactly the
  // kind of reasoning rounds 16-18 already found isn't a substitute
  // for the barrier Broadcom's own BCM2835 guidance calls for at a
  // cross-peripheral switch (see context_switch.S's mem_barrier
  // comment). uart_rx_irq_init's own IMSC-then-IC_ENABLE2 switch,
  // right next to this one, does NOT need the same fix -- PL011's
  // interrupt line is level-sensitive, re-evaluated live from IMSC &
  // RIS, not a one-shot flag a race could permanently corrupt, so
  // write order between those two specific registers can't lose an
  // event the way it can here.
  let _ = mem_barrier();

  // Enable IC line 1 (timer channel 1's compare-match interrupt).
  let _ = mmio_write_u32(ic_enable1, 2 as u32);
  return 0;
}

// BCM2835 power-management watchdog (base 0x20100000) -- the same
// peripheral real Pi firmware/Linux use to reboot the board on demand
// (bcm2835_wdt) and to recover from a genuinely wedged system. This is
// the *last-resort* answer to "the scheduler locked up and irq_dispatch
// stopped running at all," a failure mode nothing at the vani/scheduler
// level can protect against once it happens -- the intent is exactly
// what Linux's own driver uses it for: arm a countdown, kick it once
// per tick, let the SoC reset itself the instant the kicks stop.
//
// Implemented per the real, documented register semantics (matches
// bcm2835_wdt.c's constants exactly), but NOT wired into kernel_main/
// irq_dispatch's live path -- confirmed empirically that QEMU's
// raspi1ap machine model does not honor PM_WDOG's timeout field at
// all: writing PM_RSTC with WRCFG=FULL_RESET resets the emulated
// machine immediately, regardless of what's in PM_WDOG (tested at both
// a 2-second timeout and the maximum possible 20-bit value, 0xFFFFF --
// both reset within milliseconds; disabling only the PM_RSTC write,
// leaving PM_WDOG alone, restores completely normal operation, which
// isolates the immediate-reset behavior to that one write). Since this
// project tests exclusively via QEMU's raspi1ap, arming this for real
// would make the one and only test method permanently unable to boot
// the system at all -- a hardware-verification gap, not a Dhruva or
// vani-compiler bug, tracked here rather than silently worked around.
// PM_WDOG/PM_RSTC both require a magic password in their top byte on
// every write, or the write is silently ignored -- not optional, not
// a Dhruva convention, this is how the peripheral itself is gated
// against accidental writes.
fn watchdog_arm(timeout_ticks: u32) -> i64 {
  let pm_password: u32 = 0x5A000000 as u32;
  let pm_rstc: i64 = 0x2010001C;
  let pm_wdog: i64 = 0x20100024;
  let wrcfg_clr: u32 = 0xFFFFFFCF as u32;
  let wrcfg_full_reset: u32 = 0x00000020 as u32;

  let _ = mmio_write_u32(pm_wdog, pm_password | (timeout_ticks & (0xFFFFF as u32)));
  let cur: u32 = mmio_read_u32(pm_rstc);
  let _ = mmio_write_u32(pm_rstc, pm_password | (cur & wrcfg_clr) | wrcfg_full_reset);
  return 0;
}

// Ticks run at 65536 Hz (a fixed property of this peripheral, same
// SECS_TO_WDOG_TICKS(x) = x << 16 constant Linux's bcm2835_wdt driver
// uses) -- 2 seconds gives four missed 500ms ticks of margin before a
// reset, generous for jitter but still tight enough to prove the
// watchdog actually does something if irq_dispatch ever stops running.
fn watchdog_init() -> i64 {
  let two_seconds_in_ticks: u32 = 131072 as u32; // 2 << 16
  let _ = watchdog_arm(two_seconds_in_ticks);
  return 0;
}

fn watchdog_kick() -> i64 {
  let two_seconds_in_ticks: u32 = 131072 as u32;
  let _ = watchdog_arm(two_seconds_in_ticks);
  return 0;
}

// Phase 3 -- BCM2835 SDHOST controller (base 0x20202000), the real SD
// interface Pi 1 (and every earlier/simpler Pi) uses -- not the newer
// EMMC/SDHCI interface later boards have. Register semantics are the
// real, documented bcm2835-sdhost hardware protocol (same one Linux's
// own bcm2835-sdhost.c targets), confirmed empirically against QEMU
// before writing any of this: SDEDM/SDHSTS/SDCMD all read back sane,
// documented reset-state values at this exact base before any driver
// code touches them. Unlike the PM watchdog (Phase 2), this peripheral
// is genuinely modeled under QEMU's raspi1ap, not just accepted and
// simplified -- confirmed via the emulator binary itself carrying full
// bcm2835-sdhost read/write/IRQ trace events, not just a stub.
//
// Bring-up only so far: CMD0 (GO_IDLE_STATE), polled rather than
// interrupt-driven, no timeout error path yet. Deliberately not
// wcet-annotated -- sdhost_cmd's poll loop has a real iteration cap
// (unlike Phase 2's uart_putc, which had none and got caught by
// exactly this class of check) but the full init/read/write state
// machine isn't done enough yet to annotate meaningfully; that lands
// once the driver is complete, not incrementally per bring-up step.
fn sdhost_cmd(cmd_and_flags: u32, arg: u32) -> u32 {
  let sdarg: i64 = 0x20202004;
  let sdcmd: i64 = 0x20202000;
  let sdcmd_new_flag: u32 = 0x8000 as u32;
  let _ = mmio_write_u32(sdarg, arg);
  let _ = mmio_write_u32(sdcmd, sdcmd_new_flag | cmd_and_flags);

  // Poll until the controller clears NEW_FLAG (command, and its
  // response if any, complete) or the iteration cap is hit -- capped,
  // not `while true`, specifically so a wedged card can never hang
  // the caller forever the way an unbounded wait would.
  let iter: i64 = 0;
  while iter < 1000000 {
    let v: u32 = mmio_read_u32(sdcmd);
    if (v & sdcmd_new_flag) == (0 as u32) {
      break;
    }
    iter = iter + 1;
  }
  return mmio_read_u32(sdcmd);
}

// BUG (round 15 audit, 2026-08-28): sdhost_init's own command sequence
// below used to discard every sdhost_cmd return value outright (`let
// _ = sdhost_cmd(...)`), self-documented at the time as "no timeout
// error path yet" -- an acknowledged gap, but still a real one. Round
// 5's audit fixed exactly this class of bug one layer up
// (sdhost_read_block/write_block silently treating a software-level
// poll timeout as success, because SDHSTS's own error bits can't
// distinguish "the card genuinely errored" from "sdhost_cmd's own
// 1,000,000-iteration poll gave up before the command ever completed,
// well before the hardware's own much-longer SDTOUT-based timeout
// would have fired"). That exact same gap was still open here, in the
// one-shot commands that bring the card up in the first place --
// arguably higher-stakes than the read/write path, since a wedged
// controller during INIT means every later read/write is operating on
// top of a card that was never actually brought up correctly at all,
// with nothing anywhere in the boot log to say so. This helper is
// sdhost_init's own version of the same check.
fn sdhost_cmd_timed_out(status: u32) -> i64 {
  if (status & (0x8000 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

// Boot-time self-test for the pure detection logic itself. Actually
// triggering a genuine sdhost_cmd timeout under QEMU would mean making
// the emulated card wedge, which isn't something this project has a
// way to simulate (unlike, say, a corrupted network packet, which is
// just bytes this driver builds itself) -- but sdhost_cmd_timed_out is
// a pure function of the raw SDCMD value, directly testable with
// synthetic inputs exactly like governor_desired_freq_mhz or
// eval_apply already are, regardless of whether a real timeout can be
// staged live.
fn sdhost_cmd_timed_out_self_test() -> i64 {
  let ok: i64 = 1;
  if sdhost_cmd_timed_out(0x8000 as u32) != 1 { ok = 0; } // NEW_FLAG still set -> timed out
  if sdhost_cmd_timed_out(0 as u32) != 0 { ok = 0; }      // NEW_FLAG clear -> completed
  if sdhost_cmd_timed_out(0x8001 as u32) != 1 { ok = 0; } // NEW_FLAG set + other bits -> still timed out
  if sdhost_cmd_timed_out(1 as u32) != 0 { ok = 0; }      // other bits set, NEW_FLAG clear -> completed
  let _ = uart_puts("SD: sdhost_cmd_timed_out detects NEW_FLAG correctly");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// BCM2835 GPIO 48-53 (the "SD_*_R" pins) are shared, muxed pins: on
// THESE SPECIFIC pins, hardware alt-function encoding 0b100 (ALT0)
// routes the card to SDHOST, while function-select 0b000 (plain GPIO
// input, the post-reset default) routes it to SDHCI/EMMC instead --
// the same real-hardware pin-muxing GPU firmware configures via
// config.txt before jumping to the ARM kernel on real boards. Nothing
// in this project's boot path plays that firmware role, so the mux
// stays at its SDHCI-routed default until this runs.
//
// Found by reading QEMU's own hw/gpio/bcm2835_gpio.c source after
// sdhost_init's CMD8/ACMD41 sequence kept timing out for no reason
// visible from the SDHOST registers alone: SDCMD/SDHSTS both looked
// completely correct mechanically (real bit values, real semantics,
// confirmed against QEMU's own hw/sd/bcm2835_sdhost.c source too),
// because the actual bug was one level up the emulated hardware
// stack -- the drive attached via `-drive if=sd` was reparented onto
// SDHCI by default, so SDHOST was issuing every command to a bus with
// no card on it at all. First attempt at this fix used bit pattern
// 0b011 (going by the generic "ALT4" naming convention used
// elsewhere, e.g. UART's ALT0=0b100 on GPIO14/15) and still failed --
// QEMU's own gpfsel_set() checks the raw fsel value against a literal
// 4 (0b100) for these pins specifically, which Broadcom's datasheet
// calls "ALT0" here, not "ALT4"; alt-function-number-to-bit-pattern
// mapping is per-pin-group, not a single global convention, and
// re-reading the emulator source directly (not guessing from another
// peripheral's pin group) is what caught the mismatch.
fn gpio_sdhost_alt_init() -> i64 {
  let gpfsel4: i64 = 0x20200010;
  let gpfsel5: i64 = 0x20200014;

  // Pins 48 (bits 24-26) and 49 (bits 27-29) live in GPFSEL4.
  let r4: u32 = mmio_read_u32(gpfsel4);
  let clear_mask4: u32 = 0xC0FFFFFF as u32;
  let sd_alt_bits4: u32 = 0x24000000 as u32; // 0b100 on both pins
  let _ = mmio_write_u32(gpfsel4, (r4 & clear_mask4) | sd_alt_bits4);

  // Pins 50-53 (bits 0-11, 3 bits each) live in GPFSEL5.
  let r5: u32 = mmio_read_u32(gpfsel5);
  let clear_mask5: u32 = 0xFFFFF000 as u32;
  let sd_alt_bits5: u32 = 0x00000924 as u32; // 0b100 on all four pins
  let _ = mmio_write_u32(gpfsel5, (r5 & clear_mask5) | sd_alt_bits5);
  return 0;
}

fn sdhost_init() -> i64 {
  let _ = gpio_sdhost_alt_init();

  // BUG (round 18 audit, 2026-08-28): same real gap uart_init's own
  // comment explains in full -- gpio_sdhost_alt_init() just wrote
  // GPIO peripheral registers (GPFSEL4/GPFSEL5, base 0x20200000) to
  // mux pins 48-53 onto SDHOST, and the writes immediately below are
  // the first access to a genuinely different peripheral (SDHOST,
  // base 0x20202000). This is a real cross-peripheral switch, not the
  // same-peripheral case round 17 already confirmed is safe without a
  // barrier -- higher-stakes here than UART, since this project has
  // already hit a real bug from this exact mux (see
  // gpio_sdhost_alt_init's own header comment: SDHOST issuing
  // commands to a bus with no card on it because the mux was wrong)
  // -- a timing gap on top of a correct mux value would fail the same
  // way, just intermittently instead of always, on real hardware.
  let _ = mem_barrier();

  let sdvdd: i64 = 0x20202030;
  let sdcdiv: i64 = 0x2020200C;
  let sdtout: i64 = 0x20202008;
  let sdhcfg: i64 = 0x20202038;
  let sdhbct: i64 = 0x2020203C;
  let sdhblc: i64 = 0x20202050;
  let sdhsts: i64 = 0x20202020;
  let sdedm: i64 = 0x20202034;

  // Power off, then back on -- a clean, known starting FSM state
  // rather than trusting whatever QEMU's reset default happens to be.
  let _ = mmio_write_u32(sdvdd, 0 as u32);
  let _ = delay(10000);
  let _ = mmio_write_u32(sdvdd, 1 as u32);
  let _ = delay(10000);

  // Identification-speed clock divisor and a generous command
  // timeout -- real-hardware bcm2835-sdhost values, not QEMU-specific
  // tuning.
  let _ = mmio_write_u32(sdcdiv, 0x148 as u32);
  let _ = mmio_write_u32(sdtout, 0xF00000 as u32);
  let _ = mmio_write_u32(sdhbct, 0 as u32);
  let _ = mmio_write_u32(sdhblc, 0 as u32);
  // Interrupts stay disabled -- this driver polls SDCMD/SDHSTS
  // directly, the same way Phase 0-2's own peripherals were brought
  // up before anything needed a real IRQ line.
  let _ = mmio_write_u32(sdhcfg, 0 as u32);

  let sdcmd_no_response: u32 = 0x400 as u32;
  let sdcmd_long_response: u32 = 0x200 as u32;
  let sdcmd_busywait: u32 = 0x800 as u32;
  let sdrsp0: i64 = 0x20202010;

  // CMD0: GO_IDLE_STATE. No response expected.
  let cmd0_status: u32 = sdhost_cmd(sdcmd_no_response, 0 as u32);
  if sdhost_cmd_timed_out(cmd0_status) == 1 {
    let _ = uart_puts("SD: CMD0 (GO_IDLE_STATE) timed out\n");
    return 0 - 1;
  }

  // CMD8: SEND_IF_COND -- 0x1AA = 2.7-3.6V range + the 0xAA check
  // pattern. A card that doesn't echo it back either doesn't
  // implement CMD8 (an old SDSC card -- not supported by this driver
  // yet) or something's wrong with the link; not checked yet, just
  // logged, since the only card this needs to handle right now is
  // QEMU's own `-drive if=sd` image. A genuine software-level timeout
  // (the controller itself wedged, not just an old card that doesn't
  // implement this command) is still a real, distinct failure worth
  // catching -- an unresponsive CMD8 either way means nothing later in
  // this sequence stands a real chance either.
  let cmd8_status: u32 = sdhost_cmd(8 as u32, 0x1AA as u32);
  if sdhost_cmd_timed_out(cmd8_status) == 1 {
    let _ = uart_puts("SD: CMD8 (SEND_IF_COND) timed out\n");
    return 0 - 1;
  }
  let _ = uart_puts("SD: CMD8 RSP0=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdrsp0));
  let _ = uart_puts("\n");

  // ACMD41 loop: CMD55 (APP_CMD) then CMD41 (SD_SEND_OP_COND) with
  // the HCS bit set (this driver only supports SDHC/SDXC-style
  // block-addressed cards) until the card's busy bit (bit 31 of the
  // OCR response) sets, meaning it finished its own internal power-up
  // sequence. Capped iteration count, not `while true` -- same
  // reasoning as sdhost_cmd's own poll loop.
  let ocr_busy: u32 = 0x80000000 as u32;
  let hcs: u32 = 0x40000000 as u32;
  let voltage_window: u32 = 0x00FF8000 as u32;
  let acmd_iter: i64 = 0;
  let ocr: u32 = 0 as u32;
  let acmd41_wedged: i64 = 0;
  while (acmd_iter < 1000) && (acmd41_wedged == 0) {
    let cmd55_status: u32 = sdhost_cmd(55 as u32, 0 as u32);
    let cmd41_status: u32 = sdhost_cmd(41 as u32, hcs | voltage_window);
    // A software-level timeout on either command here is a different,
    // more severe condition than the ordinary "OCR busy bit not set
    // yet" retry this loop already exists to tolerate -- that's the
    // card correctly reporting it isn't ready; a timeout means the
    // controller itself never even completed the command, and
    // retrying against a wedged controller for the remaining
    // iterations would just be a long wait for something that was
    // never going to succeed. Distinguished from the ordinary retry
    // path so it fails fast instead.
    if (sdhost_cmd_timed_out(cmd55_status) == 1) || (sdhost_cmd_timed_out(cmd41_status) == 1) {
      acmd41_wedged = 1;
    } else {
      ocr = mmio_read_u32(sdrsp0);
      if (ocr & ocr_busy) != (0 as u32) {
        break;
      }
      acmd_iter = acmd_iter + 1;
    }
  }
  if acmd41_wedged == 1 {
    let _ = uart_puts("SD: ACMD41 (CMD55/CMD41) timed out\n");
    return 0 - 1;
  }
  let _ = uart_puts("SD: ACMD41 done, OCR=0x");
  let _ = uart_put_hex32(ocr);
  let _ = uart_puts("\n");

  // CMD2: ALL_SEND_CID -- long (136-bit) response. No addressing yet
  // (this is the one open-drain-style "every card on the bus
  // responds" command) -- fine here since exactly one card exists.
  let cmd2_status: u32 = sdhost_cmd(sdcmd_long_response | (2 as u32), 0 as u32);
  if sdhost_cmd_timed_out(cmd2_status) == 1 {
    let _ = uart_puts("SD: CMD2 (ALL_SEND_CID) timed out\n");
    return 0 - 1;
  }

  // CMD3: SEND_RELATIVE_ADDR -- the card publishes its own RCA in the
  // top 16 bits of the (short) response; every later addressed
  // command needs it in that same position, so no shift is needed
  // between reading it here and using it below.
  let cmd3_status: u32 = sdhost_cmd(3 as u32, 0 as u32);
  if sdhost_cmd_timed_out(cmd3_status) == 1 {
    let _ = uart_puts("SD: CMD3 (SEND_RELATIVE_ADDR) timed out\n");
    return 0 - 1;
  }
  let rca: u32 = mmio_read_u32(sdrsp0) & (0xFFFF0000 as u32);

  // CMD9: SEND_CSD -- long response, addressed by the RCA just
  // published. Not parsed yet (card capacity/speed class live here on
  // real hardware) -- deferred until the driver actually needs it.
  let cmd9_status: u32 = sdhost_cmd(sdcmd_long_response | (9 as u32), rca);
  if sdhost_cmd_timed_out(cmd9_status) == 1 {
    let _ = uart_puts("SD: CMD9 (SEND_CSD) timed out\n");
    return 0 - 1;
  }

  // CMD7: SELECT_CARD -- moves the card from stand-by to transfer
  // state; every data command (CMD17/CMD24 etc., task #3) requires
  // this first.
  let cmd7_status: u32 = sdhost_cmd(sdcmd_busywait | (7 as u32), rca);
  if sdhost_cmd_timed_out(cmd7_status) == 1 {
    let _ = uart_puts("SD: CMD7 (SELECT_CARD) timed out\n");
    return 0 - 1;
  }

  // CMD16: SET_BLOCKLEN -- this driver only ever uses 512-byte
  // blocks, set once here rather than before every single read/write.
  let cmd16_status: u32 = sdhost_cmd(16 as u32, 512 as u32);
  if sdhost_cmd_timed_out(cmd16_status) == 1 {
    let _ = uart_puts("SD: CMD16 (SET_BLOCKLEN) timed out\n");
    return 0 - 1;
  }

  // OCR bit 30 (CCS, Card Capacity Status) is only meaningful once
  // ACMD41 reported busy=0 (ready) above -- 1 means SDHC/SDXC
  // (block-addressed), 0 means SDSC (byte-addressed, block_num*512).
  // QEMU's generic SD card model derives this from the attached
  // image's size, not anything this driver controls.
  let ccs_bit: u32 = 0x40000000 as u32;
  let is_sdhc: i64 = if (ocr & ccs_bit) != (0 as u32) { 1 } else { 0 };
  let _ = sd_state_set(rca as i64, is_sdhc);

  let _ = uart_puts("SD: init done, RCA=0x");
  let _ = uart_put_hex32(rca);
  let _ = uart_puts(" is_sdhc=");
  let _ = uart_put_hex32(is_sdhc as u32);
  let _ = uart_puts(" SDHSTS=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdhsts));
  let _ = uart_puts(" SDEDM=0x");
  let _ = uart_put_hex32(mmio_read_u32(sdedm));
  let _ = uart_puts("\n");
  return rca as i64;
}

// CMD17 (READ_SINGLE_BLOCK) / CMD24 (WRITE_BLOCK). block_num is a
// logical 512-byte block index regardless of the card's own
// addressing mode -- SDSC cards want a byte address (block_num*512)
// on the wire, SDHC/SDXC cards want the block number directly; the
// distinction is handled here, once, so nothing above this layer
// (the Phase 3 filesystem, task #4) ever needs to care which kind of
// card it's talking to.
fn sdhost_card_addr(block_num: i64) -> u32 {
  let is_sdhc: i64 = sd_state_get_is_sdhc();
  if is_sdhc != 0 {
    return block_num as u32;
  }
  return (block_num * 512) as u32;
}

// BUG (round 5 audit, 2026-08-27): both functions below computed
// `status`, sdhost_cmd's own return value, then explicitly discarded
// it (`let _ = status;`) and relied purely on SDHSTS's error bits
// (0xF8: REW_TIME_OUT/CMD_TIME_OUT/CRC16/CRC7/FIFO_ERROR) to detect a
// failed transfer. That mask genuinely does cover the hardware's own
// SDTOUT-driven CMD_TIME_OUT condition -- but SDTOUT is configured to
// 0xF00000 (sdhost_init), a real-hardware-timescale value (tens of
// seconds' worth of card-clock cycles at identification speed), while
// sdhost_cmd's own SOFTWARE poll loop gives up after a fixed 1,000,000
// MMIO-read iterations -- far fewer wall-clock seconds under QEMU's
// own MMIO emulation. A card that genuinely never responds would hit
// that software cap and return with NEW_FLAG (bit 0x8000) still SET,
// well before the hardware's own CMD_TIME_OUT bit ever fires --
// meaning `errs` would read 0 (no hardware error yet) and the caller
// would treat a read/write that never actually happened as a success,
// handing the FS layer either a stale/garbage buffer (read) or silent
// data loss with no error reported at all (write). Fixed by checking
// NEW_FLAG in `status` too: still set means sdhost_cmd's own poll gave
// up before the command ever completed, a failure regardless of what
// SDHSTS shows.
fn sdhost_read_block(block_num: i64, buf: mut ref i64) -> i64 {
  let sdhbct: i64 = 0x2020203C;
  let sdhblc: i64 = 0x20202050;
  let sdhsts: i64 = 0x20202020;
  let sdcmd_read: u32 = 0x40 as u32;
  let sdcmd_new_flag: u32 = 0x8000 as u32;

  let addr: u32 = sdhost_card_addr(block_num);
  let status: u32 = sdhost_cmd(sdcmd_read | (17 as u32), addr);
  let _ = mmio_write_u32(sdhbct, 512 as u32);
  let _ = mmio_write_u32(sdhblc, 1 as u32);
  let _ = sdhost_drain_fifo_to_buffer(buf, 128);
  let errs: u32 = mmio_read_u32(sdhsts) & (0xF8 as u32);
  let _ = mmio_write_u32(sdhsts, errs);
  if (status & sdcmd_new_flag) != (0 as u32) {
    return 1;
  }
  if errs != (0 as u32) {
    return 1;
  }
  return 0;
}

fn sdhost_write_block(block_num: i64, buf: mut ref i64) -> i64 {
  let sdhbct: i64 = 0x2020203C;
  let sdhblc: i64 = 0x20202050;
  let sdhsts: i64 = 0x20202020;
  let sdcmd_write: u32 = 0x80 as u32;
  let sdcmd_new_flag: u32 = 0x8000 as u32;

  let addr: u32 = sdhost_card_addr(block_num);
  let status: u32 = sdhost_cmd(sdcmd_write | (24 as u32), addr);
  let _ = mmio_write_u32(sdhbct, 512 as u32);
  let _ = mmio_write_u32(sdhblc, 1 as u32);
  let _ = sdhost_fill_fifo_from_buffer(buf, 128);
  let errs: u32 = mmio_read_u32(sdhsts) & (0xF8 as u32);
  let _ = mmio_write_u32(sdhsts, errs);
  if (status & sdcmd_new_flag) != (0 as u32) {
    return 1;
  }
  if errs != (0 as u32) {
    return 1;
  }
  return 0;
}

// Round 36: block-device abstraction the FS layer's own raw block I/O
// goes through, rather than calling sdhost_read_block/write_block
// directly -- the "block-device abstraction" docs/TODO.md called for,
// built now that a real second backend (USB mass storage's
// usb_msd_read10/write10, rounds 33-35) actually exists to shape it
// against, not speculatively ahead of one. Dispatches on fs_state_
// get_block_dev() (0=SDHOST, the permanent default for every real FS
// operation -- boot self-tests, shell ls/cat/write, phase4_
// milestone.py, all unchanged; 1=USB mass storage, flipped only by
// fs_block_dev_self_check below to prove the abstraction genuinely
// works for both backends without ever touching a real FS operation's
// own backend). dwc2_downstream_addr() is correct here for the same
// reason it's correct everywhere else USB mass storage is used in
// this project: exactly one real device has ever been tested attached
// to the one hub port this driver enumerates.
fn fs_block_read(block_num: i64, buf: mut ref i64) -> i64 {
  if fs_state_get_block_dev() == (1 as u32) {
    return usb_msd_read10(dwc2_downstream_addr(), block_num as u32, buf);
  }
  return sdhost_read_block(block_num, buf);
}

fn fs_block_write(block_num: i64, buf: mut ref i64) -> i64 {
  if fs_state_get_block_dev() == (1 as u32) {
    return usb_msd_write10(dwc2_downstream_addr(), block_num as u32, buf);
  }
  return sdhost_write_block(block_num, buf);
}

// Phase 3 task #4 -- minimal log-structured filesystem. NOT a general
// POSIX filesystem (per DHRUVA_ARCHITECTURE.md's own framing): a
// flat, append-only log of fixed-size (one SD block, 512 bytes),
// checksummed, path-keyed records. Overwriting a path just appends a
// newer record with the same path and a higher sequence number --
// the older one is left in place (reclaiming it is task #5's job,
// running as a low-priority background task, never touching this
// hard-real-time-adjacent append/read path). Block 0 is reserved
// (unused for now -- a natural home for a future superblock, not
// needed yet since fs_init's recovery scan reconstructs everything
// from the log itself).
//
// Record layout (512 bytes):
//   [0:4)   checksum   -- covers [4:512) only, computed fresh on
//                         every read and compared against this
//   [4:8)   seq_num    -- monotonically increasing across every
//                         record ever appended; ties never happen,
//                         so ">=" during recovery is really "the
//                         first one wins if this ever changes"
//   [8:12)  path_len   -- Round 39: 0 is a reserved sentinel marking
//                         this record as a CONTINUATION block, not an
//                         independently-addressable head (fs_append
//                         now rejects a genuine empty path outright,
//                         so this can never collide with a real
//                         record) -- see below.
//   [12:44) path bytes (32-byte max path; enforced on append; unused/
//                       zero on a continuation block)
//   [44:48) data_len   -- on a HEAD block (path_len > 0): the file's
//                         TOTAL logical length across every chained
//                         block. On a CONTINUATION block (path_len ==
//                         0): just THIS block's own chunk length.
//   [48:52) next_block -- Round 39: 0 = this is the last block in the
//                         chain; otherwise the block number of the
//                         next chunk. A file whose data fits in one
//                         block (the common case, and the only case
//                         before this round) is a single head block
//                         with next_block=0, byte-identical in spirit
//                         to the pre-round-39 format.
//   [52:56) owner_uid  -- Round 42: the file's owning user ID (on a
//                         HEAD block; zero/unused on a continuation
//                         block, same convention as path). 0 = root/
//                         superuser -- Dhruva has no login yet, so
//                         everything runs as uid 0 by default; see
//                         fs_user_get_uid()/fs_user_set() for the
//                         current-user context this is checked
//                         against.
//   [56:60) owner_gid  -- Round 42: the file's owning group ID, same
//                         zero-on-continuation convention as owner_uid.
//   [60:64) mode       -- Round 42: Unix-style owner/group/other rwx
//                         permission bits (bit 8 = owner-read down to
//                         bit 0 = other-execute; see
//                         fs_check_permission()). Zero/unused on a
//                         continuation block. New files default to
//                         0x1A4 (0o644, rw-r--r--) via fs_default_
//                         mode() unless fs_append_raw is called with
//                         an explicit mode.
//   [64:512) data bytes (448-byte max payload PER BLOCK; enforced on
//                        append -- a file's own TOTAL length can be up
//                        to fs_file_max_len(), spread across multiple
//                        chained blocks)
//
// Multi-block files (round 39): fs_append_raw writes a chain's blocks
// in REVERSE order -- every continuation chunk first, the head block
// LAST -- so the head's own single-block write is the one atomic
// "commit point" for the whole file. A crash/power-loss before that
// final write leaves only orphaned, unreachable continuation blocks
// (nothing ever finds them without a head pointing in) -- the OLD
// version of the file (or no file at all, if this was the first
// write) is still exactly what fs_find_latest_block_raw returns,
// completely unaffected, the same guarantee single-block writes have
// always had. A crash DURING the head block's own write is caught by
// its own checksum exactly like any other torn write already is. This
// is the actual new crash-consistency risk class docs/TODO.md flagged
// multi-block files as introducing -- solved by never making a new
// chain reachable until it's entirely durable, not by anything new at
// the single-block level.
//
// Why a checksum, not just trusting the write succeeded: this is
// exactly the property test/power_yank.py exists to test -- a write
// interrupted mid-block (power lost, or here, QEMU killed) leaves
// SOME bytes updated and others not, and the checksum is what turns
// "silently corrupt, half-old half-new data" into "this record fails
// validation, ignore it and use whatever the previous valid record
// for this path was." Genuinely torn writes are rejected, not just
// unlikely -- provable by the sweep, not merely hoped for.
fn fs_block_payload_cap() -> i64 {
  return 448;
}
fn fs_file_max_len() -> i64 {
  return 4096;
}

// Round 42: default permission bits for a newly-created file --
// 0x1A4 = 0o644 = rw-r--r-- (owner read+write, group/other read-only).
// A conservative, ordinary default; callers needing something else
// (e.g. an executable or a group-writable shared file) pass an
// explicit mode to fs_append_raw instead.
fn fs_default_mode() -> u32 {
  return 0x1A4 as u32;
}

// Round 42: Unix-style rwx permission check. `mode`'s bit layout
// matches traditional octal permissions: bit 8 = owner-read, 7 =
// owner-write, 6 = owner-execute, 5/4/3 = group r/w/x, 2/1/0 =
// other r/w/x. uid 0 (root) always passes -- Dhruva has no login yet,
// so uid 0 is both "the superuser" and "the only user that exists
// today" (see fs_user_get_uid()/fs_user_set()); real enforcement
// still applies to any other uid a caller explicitly sets, which is
// what the self-test below exercises. Exactly one of want_read/
// want_write/want_exec should be 1 per call (checked independently,
// not combined, so a caller needing both read+write makes two calls).
fn fs_check_permission(owner_uid: u32, owner_gid: u32, mode: u32, req_uid: u32, req_gid: u32, want_read: i64, want_write: i64, _want_exec: i64) -> i64 {
  if req_uid == (0 as u32) {
    return 1;
  }
  let shift: u32 = if req_uid == owner_uid {
    6 as u32
  } else {
    if req_gid == owner_gid { 3 as u32 } else { 0 as u32 }
  };
  let bit: u32 = if want_read == 1 {
    (4 as u32) << shift
  } else {
    if want_write == 1 { (2 as u32) << shift } else { (1 as u32) << shift }
  };
  if (mode & bit) != (0 as u32) {
    return 1;
  }
  return 0;
}
fn fs_init() -> i64 {
  let buf: mut ref i64 = dhruva_alloc_bytes(512);
  let blk: i64 = 1;
  let max_blk: i64 = 2048; // 1MB log region for this v1 -- keeps a
                            // fresh/large device's recovery scan
                            // bounded rather than reading the whole
                            // disk looking for the first free block.
  let highest_seq: u32 = 0 as u32;
  while blk < max_blk {
    let rd_status: i64 = fs_block_read(blk, buf);
    if rd_status != 0 {
      break;
    }
    let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
    let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let this_seq: u32 = buf_read_u32(buf, 4 as u32);
    // A checksum match ALONE isn't enough: buf_checksum's rotate-mix
    // of an all-zero region is itself exactly 0, matching the
    // all-zero stored-checksum field a genuinely unwritten (fresh
    // device, never appended to) block already has -- so an empty
    // block would otherwise look like a perfectly valid, trivially
    // empty record, and recovery would silently scan straight past
    // every real free block instead of stopping at the first one.
    // Every genuine record's sequence number is >= 1 (fs_append never
    // hands out 0), so requiring seq_num != 0 too is what actually
    // distinguishes "real record" from "blank space that happens to
    // checksum-match its own all-zero checksum field." Found by the
    // append cursor landing at block 2040 on a device where nothing
    // had ever been written below that -- exactly where an unrelated
    // test (task #3's SD round-trip sweep) happens to write raw,
    // non-record data, which is what finally failed the checksum
    // check and looked like where the log "ended."
    if (stored_checksum != computed_checksum) || (this_seq == (0 as u32)) {
      break;
    }
    if this_seq > highest_seq {
      highest_seq = this_seq;
    }
    blk = blk + 1;
  }
  let _ = fs_state_set(blk as u32, highest_seq + (1 as u32));
  // log_start always resets to 1 on boot -- it's an in-RAM-only
  // optimization task #5's compaction earns back within a session
  // (fewer blocks to scan), not something persisted across reboots.
  // Recovery has no other safe starting point to trust anyway: with
  // nothing on the card recording where a prior compaction left off,
  // block 1 is the only assumption that can't be wrong.
  let _ = fs_state_set_log_start(1 as u32);
  return 0;
}

// Core append logic against raw buffers, not Str -- shared by
// fs_append (the normal Str-based path) and task #5's compaction,
// which only ever has raw record bytes already read from the card
// (a path/data value living inside someone else's log record has no
// Str form to hand over; there's no vani-level operation that builds
// one from arbitrary bytes, same reasoning as every other raw-buffer
// gap this project has hit at its extern "C" boundaries).
fn fs_append_raw(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, owner_uid: u32, owner_gid: u32, mode: u32) -> i64 {
  if path_len <= 0 {
    return 1; // reserved as the continuation-block sentinel, see
              // fs_init's own header comment -- a genuine empty path
              // is rejected outright so it can never collide with one
  }
  if path_len > 32 {
    return 1;
  }
  if data_len > fs_file_max_len() {
    return 1;
  }

  let cap: i64 = fs_block_payload_cap();
  if data_len <= cap {
    // Single block -- byte-identical in spirit to every pre-round-39
    // record: one head block, next_block=0.
    let buf: mut ref i64 = fs_sd_scratch_get();
    let next_block: u32 = fs_state_get_next_block();
    let next_seq: u32 = fs_state_get_next_seq();

    let _ = buf_write_u32(buf, 4 as u32, next_seq);
    let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
    let i: i64 = 0;
    while i < path_len {
      let b: u32 = buf_read_byte(path_buf, i as u32);
      let _ = buf_write_byte(buf, (12 + i) as u32, b);
      i = i + 1;
    }
    let _ = buf_write_u32(buf, 44 as u32, data_len as u32);
    let _ = buf_write_u32(buf, 48 as u32, 0 as u32); // next_block: none
    let _ = buf_write_u32(buf, 52 as u32, owner_uid);
    let _ = buf_write_u32(buf, 56 as u32, owner_gid);
    let _ = buf_write_u32(buf, 60 as u32, mode);
    let j: i64 = 0;
    while j < data_len {
      let b2: u32 = buf_read_byte(data_buf, j as u32);
      let _ = buf_write_byte(buf, (64 + j) as u32, b2);
      j = j + 1;
    }

    // Checksum last, over everything written above -- covers exactly
    // what a torn write could have left half-updated.
    let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let _ = buf_write_u32(buf, 0 as u32, checksum);

    let wr_status: i64 = fs_block_write(next_block as i64, buf);
    if wr_status != 0 {
      return 1;
    }

    let _ = fs_state_set(next_block + (1 as u32), next_seq + (1 as u32));
    return 0;
  }

  // Multi-block: split into ceil(data_len/cap) chunks, block numbers
  // and sequence numbers allocated up front (chunk i lands at
  // base_block+i regardless of write order), then WRITTEN IN REVERSE
  // -- every continuation chunk first, the head block last -- so the
  // head's own single-block write is the one atomic point at which
  // the whole chain becomes reachable at all. See fs_init's own header
  // comment for the full crash-consistency reasoning.
  let num_chunks: i64 = (data_len + cap - 1) / cap;
  let base_block: u32 = fs_state_get_next_block();
  let base_seq: u32 = fs_state_get_next_seq();

  let chunk_idx: i64 = num_chunks - 1;
  while chunk_idx >= 0 {
    let this_block: u32 = base_block + (chunk_idx as u32);
    let this_seq: u32 = base_seq + (chunk_idx as u32);
    let is_head: i64 = if chunk_idx == 0 { 1 } else { 0 };
    let chunk_offset: i64 = chunk_idx * cap;
    let remaining_from_here: i64 = data_len - chunk_offset;
    let chunk_len: i64 = if remaining_from_here < cap { remaining_from_here } else { cap };
    let is_last_chunk: i64 = if chunk_idx == (num_chunks - 1) { 1 } else { 0 };
    let next_block_field: u32 = if is_last_chunk == 1 { 0 as u32 } else { base_block + ((chunk_idx + 1) as u32) };

    let buf: mut ref i64 = fs_sd_scratch_get();
    let _ = buf_write_u32(buf, 4 as u32, this_seq);
    if is_head == 1 {
      let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
      let i: i64 = 0;
      while i < path_len {
        let b: u32 = buf_read_byte(path_buf, i as u32);
        let _ = buf_write_byte(buf, (12 + i) as u32, b);
        i = i + 1;
      }
      let _ = buf_write_u32(buf, 44 as u32, data_len as u32); // TOTAL length
      let _ = buf_write_u32(buf, 52 as u32, owner_uid);
      let _ = buf_write_u32(buf, 56 as u32, owner_gid);
      let _ = buf_write_u32(buf, 60 as u32, mode);
    } else {
      let _ = buf_write_u32(buf, 8 as u32, 0 as u32); // continuation marker
      let z: i64 = 0;
      while z < 32 {
        let _ = buf_write_byte(buf, (12 + z) as u32, 0 as u32);
        z = z + 1;
      }
      let _ = buf_write_u32(buf, 44 as u32, chunk_len as u32); // THIS chunk's own length
      let _ = buf_write_u32(buf, 52 as u32, 0 as u32);
      let _ = buf_write_u32(buf, 56 as u32, 0 as u32);
      let _ = buf_write_u32(buf, 60 as u32, 0 as u32);
    }
    let _ = buf_write_u32(buf, 48 as u32, next_block_field);
    let j: i64 = 0;
    while j < chunk_len {
      let b2: u32 = buf_read_byte(data_buf, (chunk_offset + j) as u32);
      let _ = buf_write_byte(buf, (64 + j) as u32, b2);
      j = j + 1;
    }

    let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
    let _ = buf_write_u32(buf, 0 as u32, checksum);

    let wr_status: i64 = fs_block_write(this_block as i64, buf);
    if wr_status != 0 {
      // Stop without advancing state -- the next real append reuses
      // base_block and overwrites whatever partial chain was left,
      // same "state only advances on full success" posture as the
      // single-block path above.
      return 1;
    }
    chunk_idx = chunk_idx - 1;
  }

  let _ = fs_state_set(base_block + (num_chunks as u32), base_seq + (num_chunks as u32));
  return 0;
}

// Round 42: preserve-on-overwrite semantics, matching ordinary Unix
// behavior -- writing to an existing file doesn't change its owner/
// group/mode. Looks up the file's current metadata first (fs_stat);
// a genuinely new path gets the current user context (fs_user_get_
// uid/gid) and fs_default_mode() instead. Callers needing full control
// (a specific owner/mode regardless of what a caller session's uid
// is, or task #5's compaction re-carrying an existing record forward
// unchanged) call fs_append_raw directly.
fn fs_append(path: Str, data: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  let data_len: i64 = str_len_bytes(data);
  // Checked here too, not just inside fs_append_raw: these fixed-size
  // temp buffers are sized exactly to the record format's own limits,
  // and the copy loops below would overrun them before fs_append_raw
  // ever got a chance to reject an oversized path/data itself.
  if path_len <= 0 {
    return 1;
  }
  if path_len > 32 {
    return 1;
  }
  if data_len > fs_file_max_len() {
    return 1;
  }
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat(path, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { fs_user_get_uid() };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { fs_user_get_gid() };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { fs_default_mode() };
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  let data_buf: mut ref i64 = fs_data_scratch_get();
  let j: i64 = 0;
  while j < data_len {
    let _ = buf_write_byte(data_buf, j as u32, str_byte_at(data, j) as u32);
    j = j + 1;
  }
  return fs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

// Round 42: permission-enforcing entry points. fs_read_raw/
// fs_append_raw/fs_delete_raw themselves stay UNCHECKED, trusted
// primitives -- fs_compact and fs_list both need to operate across
// every file regardless of ownership for their own housekeeping
// (GC, listing), exactly like a real filesystem's kernel-internal
// paths bypass permission checks that only apply at the user-facing
// syscall boundary. These _checked wrappers are that boundary here;
// the shell's cat/write/rm commands go through them (using fs_user_
// get_uid/gid as the requester), not the raw primitives directly.
//
// Return convention: -1 not found (same as the unchecked functions),
// -2 permission denied (new), else success (data length for read, 0
// for write/delete) -- callers that only cared about "-1 or success"
// before still work unchanged as long as they don't mistake -2 for
// -1's meaning.
fn fs_read_raw_checked(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  let allowed: i64 = fs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 1, 0, 0);
  if allowed == 0 {
    return 0 - 2;
  }
  return fs_read_raw(path_buf, path_len, out_buf);
}

// A brand-new path (fs_stat_raw returns "not found") is always
// writable -- Dhruva has no real directory objects to hold a
// directory-level "who may create files here" permission the way a
// real Unix filesystem would; allowing creation freely is the
// honestly-scoped v1 simplification (noted here rather than silently
// assumed). An EXISTING path's write permission is enforced normally.
fn fs_write_raw_checked(path_buf: mut ref i64, path_len: i64, data_buf: mut ref i64, data_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat_raw(path_buf, path_len, meta_buf);
  let owner_uid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 0 as u32) } else { req_uid };
  let owner_gid: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 4 as u32) } else { req_gid };
  let mode: u32 = if stat_status == 0 { buf_read_u32(meta_buf, 8 as u32) } else { fs_default_mode() };
  if stat_status == 0 {
    let allowed: i64 = fs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
    if allowed == 0 {
      return 0 - 2;
    }
  }
  return fs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

fn fs_delete_raw_checked(path_buf: mut ref i64, path_len: i64, req_uid: u32, req_gid: u32) -> i64 {
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat_raw(path_buf, path_len, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  // Deletion needs write permission, same simplified-from-real-Unix
  // rule fs_write_raw_checked's own comment already explains (a real
  // system checks the containing DIRECTORY's write bit, not the
  // file's own -- Dhruva has no directory objects to check instead).
  let allowed: i64 = fs_check_permission(owner_uid, owner_gid, mode, req_uid, req_gid, 0, 1, 0);
  if allowed == 0 {
    return 0 - 2;
  }
  return fs_delete_raw(path_buf, path_len);
}

// fs_chmod/fs_chown: read the file's full current content + whichever
// half of its metadata isn't changing, then re-append with the new
// metadata -- same "read whole, re-append whole" shape fs_compact's
// own re-carry already uses, not a new mechanism. Returns -1 if the
// path doesn't exist.
fn fs_chmod(path: Str, mode: u32) -> i64 {
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat(path, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
  let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
  let data_buf: mut ref i64 = fs_data_scratch_get();
  let data_len: i64 = fs_read(path, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  let path_len: i64 = str_len_bytes(path);
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode);
}

fn fs_chown(path: Str, uid: u32, gid: u32) -> i64 {
  let meta_buf: mut ref i64 = fs_stat_scratch_get();
  let stat_status: i64 = fs_stat(path, meta_buf);
  if stat_status != 0 {
    return 0 - 1;
  }
  let mode: u32 = buf_read_u32(meta_buf, 8 as u32);
  let data_buf: mut ref i64 = fs_data_scratch_get();
  let data_len: i64 = fs_read(path, data_buf);
  if data_len < 0 {
    return 0 - 1;
  }
  let path_len: i64 = str_len_bytes(path);
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_append_raw(path_buf, path_len, data_buf, data_len, uid, gid, mode);
}

// Core lookup against a raw path buffer, not Str -- same reasoning as
// fs_append_raw: task #5's compaction only ever has a path it just
// read out of someone else's record, with no Str form to construct
// from arbitrary bytes.  The block number of the newest valid record
// matching the path at path_buf[0:path_len), or -1 if none exists.
fn fs_find_latest_block_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  let next_block: u32 = fs_state_get_next_block();
  let log_start: u32 = fs_state_get_log_start();
  let buf: mut ref i64 = fs_sd_scratch_get();
  let best_block: i64 = 0 - 1;
  let best_seq: u32 = 0 as u32;
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = fs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      // Same "checksum match alone isn't enough" reasoning as
      // fs_init's recovery scan -- see that comment for why seq_num
      // != 0 is required too.
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        if (rec_path_len as i64) == path_len {
          let matches: i64 = 1;
          let k: i64 = 0;
          while k < path_len {
            let want: u32 = buf_read_byte(path_buf, k as u32);
            let got: u32 = buf_read_byte(buf, (12 + k) as u32);
            if got != want {
              matches = 0;
            }
            k = k + 1;
          }
          if matches == 1 {
            if rec_seq >= best_seq {
              best_seq = rec_seq;
              best_block = blk;
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return best_block;
}

// Shared by fs_read and task #5's compaction -- exactly the "what's
// actually live" query compaction needs to know what's safe to
// reclaim.
fn fs_find_latest_block(path: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  // No record could ever have a path this long (fs_append rejects it
  // at write time) -- reject here too, before the copy below would
  // overrun the fixed 32-byte temp buffer.
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_find_latest_block_raw(path_buf, path_len);
}

// Task #5: garbage collection / log compaction, run periodically from
// a dedicated low-priority background task (task_gc), never on the
// hard-RT path. Scans the current live region [log_start, next_block)
// once; any record that ISN'T the latest for its path (fs_find_latest_
// block_raw returns some OTHER block) is dead -- superseded by a
// later write already in the log. Every record that IS still live
// gets re-appended (through the exact same crash-safe fs_append_raw
// every normal write goes through) into fresh blocks past the
// current end of the log, and only once every live record has been
// safely re-appended does log_start move forward past the entire
// old region -- at that point everything before it is provably dead
// (an equivalent live copy exists beyond it) and stops being scanned
// by fs_read/fs_find_latest_block_raw for the rest of this boot.
//
// Deliberately NOT free-space reuse: blocks before log_start are
// abandoned, never reclaimed for new writes, in this v1 -- turning
// this into a true circular log (wrapping around to actually reuse
// that space) is real future work, not needed to demonstrate the
// architectural property DHRUVA_ARCHITECTURE.md actually asks for
// here (compaction running safely off the hard-RT path). Also NOT
// persisted across reboots (see fs_state.S's fs_log_start comment) --
// a crash between this compaction's re-appends finishing and its
// final log_start update just means one boot's recovery rescans a
// prefix it didn't strictly need to, never a correctness problem,
// since "latest wins" already tolerates the old and new copies of a
// record coexisting.
// buf/path_buf/data_buf are caller-owned scratch space (512/32/4096
// bytes respectively -- data_buf's cap raised in round 39 to hold a
// full multi-block file's reconstructed content, see fs_read_raw),
// not allocated in here.
//
// BUG (found via a real crash-and-reboot loop under Phase 6's
// checkpoint regression test, not by inspection): this function used
// to call dhruva_alloc_bytes for all three buffers itself, on every
// single call. dhruva_alloc_bytes is a bump allocator that never
// frees (see runtime_stubs.c's own doc comment -- by design, for
// once-at-boot task-stack allocation) -- fine for a function called
// once, but fs_compact() is task_e/GC's main per-pass work, called
// every 20 ticks for as long as the system runs. Once the log grew
// past the "not worth compacting yet" threshold below, every
// subsequent pass leaked another 512+32+464 = 1008 bytes permanently.
// Against the 64KB kernel heap, a long-running session (tens of
// seconds of continuous GC wakeups, easily reached once Phase 6 added
// enough boot-time work to make longer test runs routine) eventually
// exhausted it; dhruva_alloc_bytes returned null, and this function
// wrote straight through it with zero null check -- corrupting
// address 0 (the vector table), so the next interrupt jumped through
// garbage and the whole system reset. Passing the same three buffers
// in from each caller (task_e allocates its copy once, alongside its
// existing gc_buf; kernel_main's own one-off self-test call does the
// same) makes this function's heap footprint bounded regardless of
// how many times it runs.
fn fs_compact(buf: mut ref i64, path_buf: mut ref i64, data_buf: mut ref i64) -> i64 {
  let log_start: u32 = fs_state_get_log_start();
  let old_next_block: u32 = fs_state_get_next_block();

  // Not worth the SD traffic on a short log -- stay genuinely
  // low-cost when there's nothing meaningful to reclaim yet.
  if (old_next_block - log_start) < (4 as u32) {
    return 0;
  }

  // BUG (round 7 audit, 2026-08-27): every carry-forward write below
  // used to discard its own return status (`let _ = fs_append_raw(...)`
  // / `let _ = fs_delete_raw(...)`), and log_start advanced past
  // old_next_block unconditionally once the scan finished -- regardless
  // of whether any of those re-appends actually succeeded. Once
  // log_start moves forward, the old copy of a record stops being
  // scanned by fs_read/fs_find_latest_block_raw/fs_list for the rest
  // of this boot (see this function's own header comment on why that's
  // normally safe: an equivalent live copy exists beyond it). If a
  // single SD write genuinely failed mid-pass -- round 5's audit fixed
  // sdhost_write_block to actually detect that instead of silently
  // reporting success, so this is now a real, live-detectable failure
  // mode, not a hypothetical one -- the "equivalent live copy" premise
  // is false: the new copy was never written, the old copy is about to
  // become unreachable anyway, and that record's data is gone for good.
  // Fixed by tracking every carry-forward's actual result and only
  // advancing log_start if the whole pass was clean; a single failure
  // leaves log_start where it was, so the old (still valid) copies stay
  // reachable and the next compaction pass gets another chance.
  let all_ok: i64 = 1;
  let blk: i64 = log_start as i64;
  while (blk as u32) < old_next_block {
    let rd_status: i64 = fs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        // BUG (found via audit, 2026-08-27): rec_path_len/rec_data_len
        // are on-disk fields covered by the checksum just verified
        // above, so a random bit-flip or torn write is already very
        // likely to be caught there -- but buf_checksum is a simple
        // rotate-mix, not a cryptographic/collision-resistant hash,
        // so a checksum match is strong evidence, not a proof, that
        // these fields weren't corrupted into something out of range.
        // Both used to feed straight into a copy-loop bound with only
        // the tombstone-sentinel check below, no explicit range check
        // against path_buf/data_buf's own real capacity -- the exact
        // same "trust a length field, no bound" shape as the
        // networking-layer bugs found earlier the same day, just with
        // corrupted disk data playing the untrusted-input role instead
        // of a hostile network segment. Skip the record entirely (same
        // as failing the checksum check) rather than guess at
        // truncating it.
        //
        // Round 39: rec_path_len == 0 marks a CONTINUATION block (see
        // fs_init's own header comment) -- skip it here unconditionally.
        // It's never independently live/dead; it gets carried forward
        // correctly as part of its own HEAD block's fs_read_raw/
        // fs_append_raw round trip below, not by being re-appended on
        // its own (which would be meaningless -- a continuation has no
        // path to look up or preserve identity for).
        if (rec_path_len > (0 as u32)) && (rec_path_len <= (32 as u32)) {
        let k: i64 = 0;
        while (k as u32) < rec_path_len {
          let pb: u32 = buf_read_byte(buf, (12 + k) as u32);
          let _ = buf_write_byte(path_buf, k as u32, pb);
          k = k + 1;
        }
        let latest_blk: i64 = fs_find_latest_block_raw(path_buf, rec_path_len as i64);
        if latest_blk == blk {
          // This IS the live copy for its path -- carry it forward.
          // fs_append_raw always targets fs_state_get_next_block(),
          // which by now is already past old_next_block (every
          // earlier iteration's re-append only ever grows it), so
          // this can never write back into the region still being
          // scanned.
          let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
          if rec_data_len == (0xFFFFFFFF as u32) {
            // A live tombstone (fs_delete's newest record for this
            // path) -- carry it forward AS a tombstone, not as a
            // 4-billion-byte "data" copy. Missing this case doesn't
            // just mis-handle a delete: rec_data_len is read directly
            // into the loop bound below when it's a real record, so
            // treating the sentinel as a genuine length turns this
            // into an unbounded copy loop that reads/writes far past
            // data_buf's real allocation -- a real hang (found by GC
            // silently never completing a pass again once this path
            // was ever exercised), not merely a logic error that
            // happens to still terminate wrong.
            let del_status: i64 = fs_delete_raw(path_buf, rec_path_len as i64);
            if del_status != 0 {
              all_ok = 0;
            }
          } else {
            // Round 39: this HEAD block may chain across several
            // blocks now -- reconstruct the FULL logical content via
            // fs_read_raw (the same chain-following, checksum-
            // verifying logic every other caller uses) rather than
            // copying just this one block's own up-to-448-byte chunk,
            // which would silently truncate any multi-block record.
            // fs_read_raw's own internal fs_sd_scratch use doesn't
            // conflict with `buf` here -- separate, caller-owned
            // buffers, and this block's own fields have already been
            // read out above before this call.
            let full_len: i64 = fs_read_raw(path_buf, rec_path_len as i64, data_buf);
            if full_len < 0 {
              all_ok = 0;
            } else {
              // Round 42: preserve the existing owner/group/mode --
              // compaction relocates a record's storage, it must never
              // change who owns it or what it's permitted for. `buf`
              // here is still this HEAD block as read off the card
              // (rec_path_len/etc. above were read from it directly),
              // so its owner_uid/owner_gid/mode fields are still the
              // real, current ones.
              let rec_uid: u32 = buf_read_u32(buf, 52 as u32);
              let rec_gid: u32 = buf_read_u32(buf, 56 as u32);
              let rec_mode: u32 = buf_read_u32(buf, 60 as u32);
              let append_status: i64 = fs_append_raw(path_buf, rec_path_len as i64, data_buf, full_len, rec_uid, rec_gid, rec_mode);
              if append_status != 0 {
                all_ok = 0;
              }
            }
          }
        }
        }
      }
    }
    blk = blk + 1;
  }

  // Everything before old_next_block now has an equivalent live copy
  // at or beyond it (or was already dead) -- safe to stop scanning.
  // Only true if every carry-forward above actually succeeded (see
  // this function's own header comment) -- a failed one leaves its
  // only copy in the region about to be abandoned, so log_start must
  // stay put in that case rather than orphan it.
  if all_ok == 1 {
    let _ = fs_state_set_log_start(old_next_block);
  }
  return 0;
}

// Raw-buffer core, shared by fs_read (below) and anything else that
// only has a path as raw bytes (task #9's shell, over UART into
// shell_line_buf, with no Str form to build from arbitrary runtime
// bytes) -- same reasoning as fs_append_raw/fs_find_latest_block_raw.
// Copies the newest valid record's FULL logical data for `path` into
// out_buf, following the record's own next_block chain (round 39) if
// it spans more than one block, returning the total data length, or
// -1 if no valid record exists at all (never written, its newest
// record is a tombstone, or the chain is corrupt/broken -- reject the
// whole read rather than silently return a truncated prefix, same
// "reject, don't guess" posture as every other bounds check this
// project's storage/networking layers use).
// Round 42: writes the newest valid record's owner_uid/owner_gid/mode
// into meta_buf ([0:4)/[4:8)/[8:12)), or returns -1 if no valid record
// for that path exists. Shares fs_find_latest_block_raw's own lookup
// with fs_read_raw -- deliberately NOT folded into fs_read_raw itself
// (which already has plenty of parameters and a hot, chain-following
// loop); most callers need data OR metadata, rarely both in the same
// call, so a second small lookup here is simpler than threading an
// optional out-param through the read path for the common case that
// doesn't need it.
fn fs_stat_raw(path_buf: mut ref i64, path_len: i64, meta_buf: mut ref i64) -> i64 {
  let blk: i64 = fs_find_latest_block_raw(path_buf, path_len);
  if blk < 0 {
    return 0 - 1;
  }
  let tmp: mut ref i64 = fs_sd_scratch_get();
  let rd_status: i64 = fs_block_read(blk, tmp);
  if rd_status != 0 {
    return 0 - 1;
  }
  let data_len: u32 = buf_read_u32(tmp, 44 as u32);
  if data_len == (0xFFFFFFFF as u32) {
    return 0 - 1; // tombstone -- deleted, same as fs_read_raw's own check
  }
  let _ = buf_write_u32(meta_buf, 0 as u32, buf_read_u32(tmp, 52 as u32));
  let _ = buf_write_u32(meta_buf, 4 as u32, buf_read_u32(tmp, 56 as u32));
  let _ = buf_write_u32(meta_buf, 8 as u32, buf_read_u32(tmp, 60 as u32));
  return 0;
}

fn fs_stat(path: Str, meta_buf: mut ref i64) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len <= 0 {
    return 0 - 1;
  }
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_stat_raw(path_buf, path_len, meta_buf);
}

fn fs_read_raw(path_buf: mut ref i64, path_len: i64, out_buf: mut ref i64) -> i64 {
  let blk: i64 = fs_find_latest_block_raw(path_buf, path_len);
  if blk < 0 {
    return 0 - 1;
  }
  let tmp: mut ref i64 = fs_sd_scratch_get();
  let rd_status: i64 = fs_block_read(blk, tmp);
  if rd_status != 0 {
    return 0 - 1;
  }
  let total_len: u32 = buf_read_u32(tmp, 44 as u32);
  if total_len == (0xFFFFFFFF as u32) {
    return 0 - 1;
  }
  // BUG (found via audit, 2026-08-27): data_len is an on-disk field
  // covered by fs_find_latest_block_raw's own checksum validation,
  // but a checksum match is strong evidence, not proof, against
  // corruption (buf_checksum is a simple rotate-mix, not collision-
  // resistant) -- and out_buf's own real capacity is entirely up to
  // the caller regardless. Reject rather than trust an out-of-range
  // length as a copy-loop bound.
  if (total_len as i64) > fs_file_max_len() {
    return 0 - 1;
  }
  let cap: i64 = fs_block_payload_cap();
  let total_len_i: i64 = total_len as i64;
  let head_chunk: i64 = if total_len_i < cap { total_len_i } else { cap };
  let i: i64 = 0;
  while i < head_chunk {
    let b: u32 = buf_read_byte(tmp, (64 + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let copied: i64 = head_chunk;
  let remaining: i64 = total_len_i - head_chunk;
  let next_blk: i64 = buf_read_u32(tmp, 48 as u32) as i64;

  // Round 39: follow the chain for anything past the head's own
  // 448-byte chunk (Round 42 shrank the per-block payload cap from
  // 460 to make room for owner_uid/owner_gid/mode). Every continuation
  // block gets the SAME "reject,
  // don't guess" checksum/sentinel validation as any other record --
  // a broken or corrupted chain fails the whole read rather than
  // silently handing back a truncated prefix.
  while remaining > 0 {
    if next_blk == 0 {
      return 0 - 1; // chain ended early -- corrupt/broken, reject
    }
    let cont: mut ref i64 = fs_sd_scratch_get();
    if fs_block_read(next_blk, cont) != 0 {
      return 0 - 1;
    }
    let stored_checksum: u32 = buf_read_u32(cont, 0 as u32);
    let computed_checksum: u32 = buf_checksum(cont, 4 as u32, 508 as u32);
    let cont_seq: u32 = buf_read_u32(cont, 4 as u32);
    if (stored_checksum != computed_checksum) || (cont_seq == (0 as u32)) {
      return 0 - 1;
    }
    let cont_path_len: u32 = buf_read_u32(cont, 8 as u32);
    if cont_path_len != (0 as u32) {
      return 0 - 1; // not a continuation marker -- chain is wrong
    }
    let cont_len: i64 = buf_read_u32(cont, 44 as u32) as i64;
    if (cont_len < 0) || (cont_len > cap) {
      return 0 - 1;
    }
    let this_chunk: i64 = if cont_len < remaining { cont_len } else { remaining };
    let k: i64 = 0;
    while k < this_chunk {
      let b2: u32 = buf_read_byte(cont, (64 + k) as u32);
      let _ = buf_write_byte(out_buf, (copied + k) as u32, b2);
      k = k + 1;
    }
    copied = copied + this_chunk;
    remaining = remaining - this_chunk;
    next_blk = buf_read_u32(cont, 48 as u32) as i64;
  }
  return total_len_i;
}

// Copies the newest valid record's data bytes for `path` into
// out_buf, returning the data length, or -1 if no valid record for
// that path exists at all (never written, or its newest record is a
// tombstone -- see fs_delete). Thin Str-to-raw-buffer wrapper around
// fs_read_raw -- the two used to duplicate the entire read/chain-
// follow logic; consolidated once round 39's chain-following made
// that duplication a real maintenance risk, not just a stylistic one.
fn fs_read(path: Str, out_buf: mut ref i64) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len <= 0 {
    return 0 - 1;
  }
  if path_len > 32 {
    return 0 - 1;
  }
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_read_raw(path_buf, path_len, out_buf);
}

// fs_delete: appends a tombstone record for `path` -- a normal,
// crash-safe log entry (same checksum/sequence-number machinery as
// any other write) whose data_len field is the sentinel 0xFFFFFFFF,
// a value no genuine record can ever have (a file's total length is
// capped at fs_file_max_len(), 4096 bytes as of round 39). fs_read/
// fs_list treat the newest tombstone for a path
// exactly like the path never existed; compaction (fs_compact) can
// still find and re-carry a tombstone forward as "the latest record"
// for its path like any other -- deleting something, then compacting,
// correctly keeps it deleted rather than resurrecting an older
// pre-delete version.
fn fs_delete_raw(path_buf: mut ref i64, path_len: i64) -> i64 {
  if path_len <= 0 {
    return 1; // same reserved-sentinel reasoning as fs_append_raw
  }
  if path_len > 32 {
    return 1;
  }
  let buf: mut ref i64 = fs_sd_scratch_get();
  let next_block: u32 = fs_state_get_next_block();
  let next_seq: u32 = fs_state_get_next_seq();

  let _ = buf_write_u32(buf, 4 as u32, next_seq);
  let _ = buf_write_u32(buf, 8 as u32, path_len as u32);
  let i: i64 = 0;
  while i < path_len {
    let b: u32 = buf_read_byte(path_buf, i as u32);
    let _ = buf_write_byte(buf, (12 + i) as u32, b);
    i = i + 1;
  }
  let _ = buf_write_u32(buf, 44 as u32, 0xFFFFFFFF as u32);
  // Round 39: a tombstone never chains -- but buf is fs_sd_scratch, a
  // PERSISTENT reused buffer, so this field must be written explicitly
  // rather than assumed zero; a stale next_block from whatever this
  // buffer last held would otherwise leak into a brand-new record.
  let _ = buf_write_u32(buf, 48 as u32, 0 as u32);
  // Round 42: same stale-scratch-buffer reasoning as next_block above
  // -- a tombstone has no meaningful owner/mode, but fs_sd_scratch is
  // reused, so these must be zeroed explicitly rather than assumed.
  let _ = buf_write_u32(buf, 52 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 56 as u32, 0 as u32);
  let _ = buf_write_u32(buf, 60 as u32, 0 as u32);

  let checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
  let _ = buf_write_u32(buf, 0 as u32, checksum);

  let wr_status: i64 = fs_block_write(next_block as i64, buf);
  if wr_status != 0 {
    return 1;
  }
  let _ = fs_state_set(next_block + (1 as u32), next_seq + (1 as u32));
  return 0;
}

fn fs_delete(path: Str) -> i64 {
  let path_len: i64 = str_len_bytes(path);
  if path_len > 32 {
    return 1;
  }
  let path_buf: mut ref i64 = fs_path_scratch_get();
  let i: i64 = 0;
  while i < path_len {
    let _ = buf_write_byte(path_buf, i as u32, str_byte_at(path, i) as u32);
    i = i + 1;
  }
  return fs_delete_raw(path_buf, path_len);
}

// Round 39's live milestone: write a payload well past the 448-byte
// per-block cap (Round 42 shrank it from 460 to make room for
// owner_uid/owner_gid/mode), confirm it round-trips byte-for-byte
// through fs_append_raw's own chaining (reverse-order write) and
// fs_read_raw's own chain-following read. 1000 bytes needs 3 chunks
// (448+448+104) --
// comfortably past the "needs exactly one continuation" minimum case,
// enough to prove the loop over MULTIPLE chained blocks, not just a
// head-plus-one edge case. Reuses test_fill_pattern/test_compare_
// buffers, the same generic pattern-fill/compare helpers the SD/USB
// mass storage round-trip checks already use, rather than a third
// hand-rolled comparison loop.
fn fs_multiblock_self_test() -> i64 {
  let ok: i64 = 1;
  let file_len: i64 = 1000;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(1000);
  let _ = test_fill_pattern(write_buf, 1000);

  // Raw pattern bytes aren't valid Str/UTF-8 content, so this goes
  // through fs_append_raw/fs_read_raw directly rather than fs_append's
  // own Str-based wrapper, matching every other raw-content self-test
  // in this project.
  let path_buf: mut ref i64 = dhruva_alloc_bytes(16);
  let path_bytes: Str = "/bigfile/data";
  let path_len: i64 = str_len_bytes(path_bytes);
  let pi: i64 = 0;
  while pi < path_len {
    let _ = buf_write_byte(path_buf, pi as u32, str_byte_at(path_bytes, pi) as u32);
    pi = pi + 1;
  }
  let write_status: i64 = fs_append_raw(path_buf, path_len, write_buf, file_len, fs_user_get_uid(), fs_user_get_gid(), fs_default_mode());
  if write_status != 0 {
    ok = 0;
  }

  let read_buf: mut ref i64 = dhruva_alloc_bytes(1000);
  let read_len: i64 = fs_read_raw(path_buf, path_len, read_buf);
  if read_len != file_len {
    ok = 0;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, file_len);
  if mismatch != 0 {
    ok = 0;
  }

  // Overwrite with a DIFFERENT multi-block payload, confirm the
  // lookup correctly follows the NEW chain's head, not a leftover
  // continuation block from the old one (every continuation block's
  // path_len=0 sentinel makes this structurally impossible to get
  // wrong, but proving it live is still the point, not just trusting
  // the design on paper).
  let write_buf2: mut ref i64 = dhruva_alloc_bytes(1000);
  let qi: i64 = 0;
  while qi < 1000 {
    let _ = buf_write_byte(write_buf2, qi as u32, ((qi * 7) & 0xFF) as u32);
    qi = qi + 1;
  }
  let write_status2: i64 = fs_append_raw(path_buf, path_len, write_buf2, file_len, fs_user_get_uid(), fs_user_get_gid(), fs_default_mode());
  if write_status2 != 0 {
    ok = 0;
  }
  let read_buf2: mut ref i64 = dhruva_alloc_bytes(1000);
  let read_len2: i64 = fs_read_raw(path_buf, path_len, read_buf2);
  if read_len2 != file_len {
    ok = 0;
  }
  let mismatch2: i64 = test_compare_buffers(write_buf2, read_buf2, file_len);
  if mismatch2 != 0 {
    ok = 0;
  }

  let _ = uart_puts("FS: multi-block file round trip (1000 bytes, 3 chunks) + overwrite");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 39's journaling-hardening proof: the actual crash-consistency
// claim fs_init's own header comment makes for multi-block files --
// that a crash/power-loss before a new chain's HEAD block is written
// leaves the OLD version of the file completely intact and reachable,
// because the head write is the one atomic point a new chain becomes
// visible at all. This project's own single-threaded, synchronous
// execution can't literally interrupt a write mid-chain the way
// test/power_yank.py does at the QEMU-process level for single-block
// writes -- so this reproduces the EXACT end state such a crash would
// leave instead: a real, valid, checksummed CONTINUATION block
// (path_len=0) written directly to the block number fs_state's own
// next_block would use next, with NO corresponding head ever written
// and fs_state deliberately left untouched (not calling fs_state_set
// IS the simulated crash -- that accounting update, and the real head
// write, are exactly the two things a crash prevents). Gives the
// phantom block an artificially huge sequence number specifically so
// that if it were EVER wrongly visible to a lookup, it would
// incorrectly "win" over the real record -- making this a genuine
// stress case, not a trivially-passing one.
fn fs_multiblock_crash_consistency_self_test() -> i64 {
  let ok: i64 = 1;
  let path: Str = "/crashtest/file";
  let old_value: Str = "safe-old-value";
  let _ = fs_append(path, old_value);

  let phantom_block: i64 = fs_state_get_next_block() as i64;
  let phantom_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = buf_write_u32(phantom_buf, 4 as u32, 999999 as u32); // seq far
                          // higher than any real record so far
  let _ = buf_write_u32(phantom_buf, 8 as u32, 0 as u32); // continuation marker
  let z: i64 = 0;
  while z < 32 {
    let _ = buf_write_byte(phantom_buf, (12 + z) as u32, 0 as u32);
    z = z + 1;
  }
  let _ = buf_write_u32(phantom_buf, 44 as u32, 10 as u32);
  let _ = buf_write_u32(phantom_buf, 48 as u32, 0 as u32); // next_block=0
  let p: i64 = 0;
  while p < 10 {
    let _ = buf_write_byte(phantom_buf, (52 + p) as u32, 88 as u32); // 'X'
    p = p + 1;
  }
  let checksum: u32 = buf_checksum(phantom_buf, 4 as u32, 508 as u32);
  let _ = buf_write_u32(phantom_buf, 0 as u32, checksum);
  let _ = fs_block_write(phantom_block, phantom_buf);
  // Deliberately no fs_state_set call -- see this function's own
  // header comment for why that omission IS the simulated crash.

  let out_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let read_len: i64 = fs_read(path, out_buf);
  let expected_len: i64 = str_len_bytes(old_value);
  if read_len != expected_len {
    ok = 0;
  }
  let ci: i64 = 0;
  while ci < expected_len {
    let want: i64 = str_byte_at(old_value, ci);
    let got: u32 = buf_read_byte(out_buf, ci as u32);
    if (got as i64) != want {
      ok = 0;
    }
    ci = ci + 1;
  }

  let _ = uart_puts("FS: simulated crash mid-multi-block-write leaves old version intact");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Prints every live path (not tombstoned, and the newest record for
// that exact path -- an older, superseded occurrence in the log is
// correctly skipped even though it's still individually valid) whose
// first prefix_len bytes match `prefix`. An empty prefix matches
// every path -- "list everything" -- since matching zero bytes always
// trivially holds. Same "is this occurrence actually the champion for
// its path" check fs_compact uses to decide what's safe to reclaim.
// Round 42: linear membership check into a fixed-capacity "already
// printed" set of path segments, used by fs_list_dir's own
// deduplication below. `seen` holds up to 128 32-byte slots (byte 0 =
// this slot's real length 0-31, bytes 1..31 = the name itself) --
// reuses fs_data_scratch's full 4096 bytes, safe because fs_list_dir
// never touches file DATA itself, only record headers.
fn fs_dirlist_seen_contains(seen: mut ref i64, count: i64, path_buf: mut ref i64, seg_start: i64, seg_len: i64) -> i64 {
  let idx: i64 = 0;
  while idx < count {
    let slot_off: i64 = idx * 32;
    let slot_len: u32 = buf_read_byte(seen, slot_off as u32);
    if (slot_len as i64) == seg_len {
      let matches: i64 = 1;
      let k: i64 = 0;
      while k < seg_len {
        let a: u32 = buf_read_byte(seen, (slot_off + 1 + k) as u32);
        let b: u32 = buf_read_byte(path_buf, (seg_start + k) as u32);
        if a != b {
          matches = 0;
        }
        k = k + 1;
      }
      if matches == 1 {
        return 1;
      }
    }
    idx = idx + 1;
  }
  return 0;
}

// Round 42: does query_buf[0:query_len) exactly equal
// path_buf[seg_start:seg_start+seg_len)? Used by fs_list_dir_raw's
// classify mode (fs_list_dir_classify).
fn fs_dirlist_segment_equals(query_buf: mut ref i64, query_len: i64, path_buf: mut ref i64, seg_start: i64, seg_len: i64) -> i64 {
  if query_len != seg_len {
    return 0;
  }
  let k: i64 = 0;
  while k < seg_len {
    let a: u32 = buf_read_byte(query_buf, k as u32);
    let b: u32 = buf_read_byte(path_buf, (seg_start + k) as u32);
    if a != b {
      return 0;
    }
    k = k + 1;
  }
  return 1;
}

// Round 42: real single-level directory listing -- closes the
// directory-hierarchy half of this TODO item that round 39's
// multi-block-files work explicitly left open. fs_list (below) does a
// flat "every live record whose path starts with this exact prefix"
// scan and prints the whole remaining path -- "/config/mode" and
// "/config/sub/deep" print identically as full paths, with no notion
// that the second one lives in a subdirectory. fs_list_dir instead
// looks only at the FIRST path segment after `dir`, printing a leaf
// file's own name when nothing follows it, or a subdirectory's name
// (deduplicated, however many files actually live under it) with a
// trailing "/" when something does.
//
// `dir_buf`/`dir_len` is a directory path with a leading slash and no
// trailing one ("/config"), or length 0 for the root -- matching how
// every real path in this filesystem already starts with "/". Raw-
// buffer core (not Str) for the same reason fs_append_raw/fs_read_raw
// are: the shell's own "ls <dir>" only ever has the path as bytes
// copied out of its line buffer, with no Str form to build from
// arbitrary bytes (there's no vani-level operation for that). See
// fs_list_dir (below) for the Str-based wrapper self-tests use.
// `query_len > 0` switches this from printing (the shell "ls <dir>"
// use) to a silent, assertable classification query used by
// fs_list_dir_classify/its self-test: does `query_buf[0:query_len)`
// exactly match some live entry's first segment under `dir`, and if
// so is it a leaf file or a subdirectory? Same scan either way --
// splitting this into two near-duplicate functions would risk exactly
// the "the two diverge and only one gets fixed later" drift class
// this project has hit before with duplicated read/chain-follow logic
// (see fs_read's own doc comment on why it got consolidated).
// Returns (query mode only): 0 = no match, 1 = file, 2 = directory.
fn fs_list_dir_raw(dir_buf: mut ref i64, dir_len: i64, query_buf: mut ref i64, query_len: i64) -> i64 {
  let skip_len: i64 = if dir_len == 0 { 1 } else { dir_len + 1 };
  let next_block: u32 = fs_state_get_next_block();
  let log_start: u32 = fs_state_get_log_start();
  let buf: mut ref i64 = fs_sd_scratch_get();
  let seen: mut ref i64 = fs_data_scratch_get();
  let seen_count: i64 = 0;
  let classify_result: i64 = 0;
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = fs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
        let long_enough: i64 = 0;
        if (rec_path_len > (0 as u32)) && ((rec_path_len as i64) > skip_len) {
          long_enough = 1;
        }
        if (long_enough == 1) && (rec_data_len != (0xFFFFFFFF as u32)) {
          let prefix_matches: i64 = 1;
          if dir_len == 0 {
            let first: u32 = buf_read_byte(buf, 12 as u32);
            if first != (47 as u32) {
              prefix_matches = 0;
            }
          } else {
            let k: i64 = 0;
            while k < dir_len {
              let want: u32 = buf_read_byte(dir_buf, k as u32);
              let got: u32 = buf_read_byte(buf, (12 + k) as u32);
              if got != want {
                prefix_matches = 0;
              }
              k = k + 1;
            }
            let slash: u32 = buf_read_byte(buf, (12 + dir_len) as u32);
            if slash != (47 as u32) {
              prefix_matches = 0;
            }
          }
          if (prefix_matches == 1) && (rec_path_len <= (32 as u32)) {
            let path_buf: mut ref i64 = fs_path_scratch_get();
            let m: i64 = 0;
            while (m as u32) < rec_path_len {
              let pb: u32 = buf_read_byte(buf, (12 + m) as u32);
              let _ = buf_write_byte(path_buf, m as u32, pb);
              m = m + 1;
            }
            let latest_blk: i64 = fs_find_latest_block_raw(path_buf, rec_path_len as i64);
            if latest_blk == blk {
              let rec_path_len_i: i64 = rec_path_len as i64;
              let seg_start: i64 = skip_len;
              let seg_end: i64 = seg_start;
              let found_slash: i64 = 0;
              while (seg_end < rec_path_len_i) && (found_slash == 0) {
                let c: u32 = buf_read_byte(path_buf, seg_end as u32);
                if c == (47 as u32) {
                  found_slash = 1;
                } else {
                  seg_end = seg_end + 1;
                }
              }
              let seg_len: i64 = seg_end - seg_start;
              if query_len > 0 {
                let is_match: i64 = fs_dirlist_segment_equals(query_buf, query_len, path_buf, seg_start, seg_len);
                if is_match == 1 {
                  classify_result = if found_slash == 1 { 2 } else { 1 };
                }
              } else {
                if found_slash == 1 {
                  // Subdirectory -- print its name once, however many
                  // live files actually sit underneath it.
                  let already_seen: i64 = fs_dirlist_seen_contains(seen, seen_count, path_buf, seg_start, seg_len);
                  if (already_seen == 0) && (seen_count < 128) {
                    let _ = uart_puts("  ");
                    let p: i64 = seg_start;
                    while p < seg_end {
                      let pc: u32 = buf_read_byte(path_buf, p as u32);
                      let _ = uart_putc(pc as i64);
                      p = p + 1;
                    }
                    let _ = uart_puts("/\n");
                    let slot_off: i64 = seen_count * 32;
                    let _ = buf_write_byte(seen, slot_off as u32, seg_len as u32);
                    let q: i64 = 0;
                    while q < seg_len {
                      let sc: u32 = buf_read_byte(path_buf, (seg_start + q) as u32);
                      let _ = buf_write_byte(seen, (slot_off + 1 + q) as u32, sc);
                      q = q + 1;
                    }
                    seen_count = seen_count + 1;
                  }
                } else {
                  // Leaf file directly in this directory.
                  let _ = uart_puts("  ");
                  let p: i64 = seg_start;
                  while p < seg_end {
                    let pc: u32 = buf_read_byte(path_buf, p as u32);
                    let _ = uart_putc(pc as i64);
                    p = p + 1;
                  }
                  let _ = uart_puts("\n");
                }
              }
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return classify_result;
}

fn fs_list_dir(dir: Str) -> i64 {
  let dir_len: i64 = str_len_bytes(dir);
  if dir_len > 32 {
    return 1;
  }
  let dir_buf: mut ref i64 = fs_dir_scratch_get();
  let i: i64 = 0;
  while i < dir_len {
    let _ = buf_write_byte(dir_buf, i as u32, str_byte_at(dir, i) as u32);
    i = i + 1;
  }
  let dummy: mut ref i64 = fs_stat_scratch_get();
  return fs_list_dir_raw(dir_buf, dir_len, dummy, 0);
}

// Round 42: silent classification query for self-tests -- does
// `segment` exist as an entry directly under `dir`, and is it a leaf
// file (1) or a subdirectory (2)? 0 if no such entry. Real assertable
// coverage for fs_list_dir_raw's segment-splitting/classification
// logic, since the print-oriented fs_list_dir has no return value a
// self-test could check (matching fs_list's own long-standing print-
// only convention -- this project has no UART-capture mechanism in
// self-tests to assert against printed output instead).
fn fs_list_dir_classify(dir: Str, segment: Str) -> i64 {
  let dir_len: i64 = str_len_bytes(dir);
  let seg_len: i64 = str_len_bytes(segment);
  if dir_len > 32 {
    return 0;
  }
  // seg_buf below reuses the 12-byte fs_stat_scratch buffer (nothing
  // else needs a dedicated one just for this) -- plenty for any
  // realistic single path segment, but genuinely a real cap, not an
  // arbitrary one, so enforce it rather than silently overrunning.
  if seg_len > 11 {
    return 0;
  }
  let dir_buf: mut ref i64 = fs_dir_scratch_get();
  let i: i64 = 0;
  while i < dir_len {
    let _ = buf_write_byte(dir_buf, i as u32, str_byte_at(dir, i) as u32);
    i = i + 1;
  }
  let seg_buf: mut ref i64 = fs_stat_scratch_get();
  let j: i64 = 0;
  while j < seg_len {
    let _ = buf_write_byte(seg_buf, j as u32, str_byte_at(segment, j) as u32);
    j = j + 1;
  }
  return fs_list_dir_raw(dir_buf, dir_len, seg_buf, seg_len);
}

// Round 42: real, assertable coverage for the owner/group/other rwx
// permission model -- not just "does it compile", but a genuine
// allowed-vs-denied round trip from a non-root context, plus root's
// bypass and fs_chmod actually changing the outcome. Rebuilds path/
// data scratch buffers fresh before each raw-buffer call rather than
// assuming they survive an intervening Str-based call unclobbered
// (fs_chmod, for one, reuses both internally for its own purposes).
fn fs_permissions_self_test() -> i64 {
  let ok: i64 = 1;
  let _ = fs_user_set(0 as u32, 0 as u32); // start as root, the default

  let _ = fs_append("/perm/rootfile", "secret"); // root, default mode 0o644

  let path1: Str = "/perm/rootfile";
  let path1_len: i64 = str_len_bytes(path1);

  // Non-root, non-owning-group user: mode 644's other-read bit allows
  // reading...
  let _ = fs_user_set(100 as u32, 100 as u32);
  let path1_buf: mut ref i64 = fs_path_scratch_get();
  let i1: i64 = 0;
  while i1 < path1_len {
    let _ = buf_write_byte(path1_buf, i1 as u32, str_byte_at(path1, i1) as u32);
    i1 = i1 + 1;
  }
  let read_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let read_status: i64 = fs_read_raw_checked(path1_buf, path1_len, read_buf, 100 as u32, 100 as u32);
  if read_status < 0 {
    ok = 0;
  }

  // ...but 644 has no other-write bit, so writing is denied.
  let data1: Str = "hacked";
  let data1_len: i64 = str_len_bytes(data1);
  let data1_buf: mut ref i64 = fs_data_scratch_get();
  let j1: i64 = 0;
  while j1 < data1_len {
    let _ = buf_write_byte(data1_buf, j1 as u32, str_byte_at(data1, j1) as u32);
    j1 = j1 + 1;
  }
  let write_status: i64 = fs_write_raw_checked(path1_buf, path1_len, data1_buf, data1_len, 100 as u32, 100 as u32);
  if write_status != (0 - 2) {
    ok = 0;
  }

  // Deletion needs write permission too -- also denied.
  let del_status: i64 = fs_delete_raw_checked(path1_buf, path1_len, 100 as u32, 100 as u32);
  if del_status != (0 - 2) {
    ok = 0;
  }

  // A brand-new path has no existing owner to be denied by -- non-root
  // creation succeeds, and the new file's owner is the REQUESTER
  // (100), not incidentally root, proving fs_write_raw_checked's
  // new-file default actually uses its req_uid/req_gid parameters.
  let path2: Str = "/perm/userfile";
  let path2_len: i64 = str_len_bytes(path2);
  let path2_buf: mut ref i64 = fs_dir_scratch_get();
  let i2: i64 = 0;
  while i2 < path2_len {
    let _ = buf_write_byte(path2_buf, i2 as u32, str_byte_at(path2, i2) as u32);
    i2 = i2 + 1;
  }
  let data2: Str = "mine";
  let data2_len: i64 = str_len_bytes(data2);
  let data2_buf: mut ref i64 = dhruva_alloc_bytes(16);
  let j2: i64 = 0;
  while j2 < data2_len {
    let _ = buf_write_byte(data2_buf, j2 as u32, str_byte_at(data2, j2) as u32);
    j2 = j2 + 1;
  }
  let create_status: i64 = fs_write_raw_checked(path2_buf, path2_len, data2_buf, data2_len, 100 as u32, 100 as u32);
  if create_status != 0 {
    ok = 0;
  }
  let meta_check: mut ref i64 = dhruva_alloc_bytes(12);
  let stat_check: i64 = fs_stat("/perm/userfile", meta_check);
  if stat_check != 0 {
    ok = 0;
  }
  if buf_read_u32(meta_check, 0 as u32) != (100 as u32) {
    ok = 0;
  }

  // Root bypasses every check regardless of mode.
  let _ = fs_user_set(0 as u32, 0 as u32);
  let path1_buf_r: mut ref i64 = fs_path_scratch_get();
  let i3: i64 = 0;
  while i3 < path1_len {
    let _ = buf_write_byte(path1_buf_r, i3 as u32, str_byte_at(path1, i3) as u32);
    i3 = i3 + 1;
  }
  let data1_buf_r: mut ref i64 = fs_data_scratch_get();
  let j3: i64 = 0;
  while j3 < data1_len {
    let _ = buf_write_byte(data1_buf_r, j3 as u32, str_byte_at(data1, j3) as u32);
    j3 = j3 + 1;
  }
  let root_write_status: i64 = fs_write_raw_checked(path1_buf_r, path1_len, data1_buf_r, data1_len, 0 as u32, 0 as u32);
  if root_write_status != 0 {
    ok = 0;
  }

  // fs_chmod loosens rootfile to world-writable (0o666 = 438 decimal);
  // the same non-root write that was denied above now succeeds.
  let _ = fs_chmod("/perm/rootfile", 438 as u32);
  let _ = fs_user_set(100 as u32, 100 as u32);
  let path1_buf2: mut ref i64 = fs_path_scratch_get();
  let i4: i64 = 0;
  while i4 < path1_len {
    let _ = buf_write_byte(path1_buf2, i4 as u32, str_byte_at(path1, i4) as u32);
    i4 = i4 + 1;
  }
  let data1_buf2: mut ref i64 = fs_data_scratch_get();
  let j4: i64 = 0;
  while j4 < data1_len {
    let _ = buf_write_byte(data1_buf2, j4 as u32, str_byte_at(data1, j4) as u32);
    j4 = j4 + 1;
  }
  let write_status2: i64 = fs_write_raw_checked(path1_buf2, path1_len, data1_buf2, data1_len, 100 as u32, 100 as u32);
  if write_status2 != 0 {
    ok = 0;
  }

  // Restore the default root context so later self-tests/the shell
  // don't inherit this test's leftover non-root session.
  let _ = fs_user_set(0 as u32, 0 as u32);

  let _ = uart_puts("FS: permission model (owner/group/other rwx, root bypass, chmod) enforces read/write/delete correctly");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 42: real, assertable coverage for directory-hierarchy
// listing -- fs_list_dir_classify (the query-mode twin of the print-
// oriented fs_list_dir the shell's "ls <dir>" uses) confirms a leaf
// file is classified as a file, a nested path's first segment is
// classified as a directory (not the flat full-path string fs_list's
// own prefix scan would show), and a name that doesn't exist under
// that directory classifies as neither.
fn fs_directory_hierarchy_self_test() -> i64 {
  let ok: i64 = 1;
  let _ = fs_append("/docs/readme", "hello");
  let _ = fs_append("/docs/notes", "abc");
  let _ = fs_append("/docs/sub/deep", "nested");

  if fs_list_dir_classify("/docs", "readme") != 1 {
    ok = 0;
  }
  if fs_list_dir_classify("/docs", "notes") != 1 {
    ok = 0;
  }
  if fs_list_dir_classify("/docs", "sub") != 2 {
    ok = 0;
  }
  // "deep" lives under /docs/sub, not directly under /docs -- must
  // NOT show up as an entry of /docs itself.
  if fs_list_dir_classify("/docs", "deep") != 0 {
    ok = 0;
  }
  // Querying the actual subdirectory directly finds its own leaf file.
  if fs_list_dir_classify("/docs/sub", "deep") != 1 {
    ok = 0;
  }
  // Root-level listing: /docs itself is a top-level directory.
  if fs_list_dir_classify("", "docs") != 2 {
    ok = 0;
  }

  let _ = uart_puts("FS: directory hierarchy (fs_list_dir) distinguishes files from subdirectories");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

fn fs_list(prefix: Str) -> i64 {
  let prefix_len: i64 = str_len_bytes(prefix);
  let next_block: u32 = fs_state_get_next_block();
  let log_start: u32 = fs_state_get_log_start();
  let buf: mut ref i64 = fs_sd_scratch_get();
  let blk: i64 = log_start as i64;
  while (blk as u32) < next_block {
    let rd_status: i64 = fs_block_read(blk, buf);
    if rd_status == 0 {
      let stored_checksum: u32 = buf_read_u32(buf, 0 as u32);
      let computed_checksum: u32 = buf_checksum(buf, 4 as u32, 508 as u32);
      let rec_seq: u32 = buf_read_u32(buf, 4 as u32);
      if (stored_checksum == computed_checksum) && (rec_seq != (0 as u32)) {
        let rec_path_len: u32 = buf_read_u32(buf, 8 as u32);
        let rec_data_len: u32 = buf_read_u32(buf, 44 as u32);
        let long_enough: i64 = 0;
        // Round 39: rec_path_len == 0 marks a continuation block (see
        // fs_init's own header comment), never independently listable
        // -- excluded explicitly rather than relying on the >=
        // prefix_len check below to happen to exclude it (it wouldn't,
        // for an empty "list everything" prefix, prefix_len == 0 too).
        if (rec_path_len > (0 as u32)) && ((rec_path_len as i64) >= prefix_len) {
          long_enough = 1;
        }
        if (long_enough == 1) && (rec_data_len != (0xFFFFFFFF as u32)) {
          let prefix_matches: i64 = 1;
          let k: i64 = 0;
          while k < prefix_len {
            let want: i64 = str_byte_at(prefix, k);
            let got: u32 = buf_read_byte(buf, (12 + k) as u32);
            if (got as i64) != want {
              prefix_matches = 0;
            }
            k = k + 1;
          }
          // BUG (found via audit, 2026-08-27): rec_path_len feeds the
          // copy loop below with only a checksum match backing it --
          // strong evidence against corruption, not proof (see fs_
          // compact's identical fix for the full reasoning). Reject
          // rather than let an out-of-range length overflow fs_path_
          // scratch's real 32-byte capacity.
          if (prefix_matches == 1) && (rec_path_len <= (32 as u32)) {
            // Copy the path out before calling fs_find_latest_block_
            // raw below: it reuses fs_sd_scratch (the same persistent
            // buffer as `buf` above) for its own scan, so `buf`'s
            // current record is only safe to keep reading from up to
            // this point -- everything this branch still needs from it
            // (rec_path_len, and now these bytes) has to be pulled out
            // first. path_buf itself is a separate persistent buffer
            // (fs_path_scratch), untouched by that scan.
            let path_buf: mut ref i64 = fs_path_scratch_get();
            let m: i64 = 0;
            while (m as u32) < rec_path_len {
              let pb: u32 = buf_read_byte(buf, (12 + m) as u32);
              let _ = buf_write_byte(path_buf, m as u32, pb);
              m = m + 1;
            }
            let latest_blk: i64 = fs_find_latest_block_raw(path_buf, rec_path_len as i64);
            if latest_blk == blk {
              let _ = uart_puts("  ");
              let p: i64 = 0;
              while (p as u32) < rec_path_len {
                let pc: u32 = buf_read_byte(path_buf, p as u32);
                let _ = uart_putc(pc as i64);
                p = p + 1;
              }
              let _ = uart_puts("\n");
            }
          }
        }
      }
    }
    blk = blk + 1;
  }
  return 0;
}

fn fs_print_data(buf: mut ref i64, byte_len: i64) -> i64 {
  let i: i64 = 0;
  while i < byte_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = uart_putc(b as i64);
    i = i + 1;
  }
  return 0;
}

// Runs in real IRQ context (called from boot/irq_entry.S's irq_entry,
// itself reached only via the hardware vector table -- never via a
// normal vani call chain). #[interrupt] gets real value here: it
// statically forbids heap allocation, unbounded recursion, lock-
// acquiring calls, and task/parallel-for spawns in this function's
// body -- exactly the set of things that would be genuinely unsafe to
// do from inside an ISR. It does NOT generate any ISR-specific
// codegen (register save/restore, vector entry, interrupt-return
// instruction) -- confirmed by checking all four backends contain no
// reference to the `interrupt` flag at all. That part is entirely
// boot/irq_entry.S and boot/rpi1/vectors.S's job.
#[no_mangle]
#[interrupt(priority=0)]
#[bounded_stack(bytes=1024)]
#[wcet(cycles=100000)]
// BUG (round 4 audit, 2026-08-27): this function's return value used
// to be unconditionally 0, unused by every caller. scheduler_switch_
// from_irq (context_switch.S) -- called from irq_entry.S right after
// this function returns, on EVERY IRQ entry -- increments tick_count
// unconditionally too, even though its own doc comment claims it does
// so "every timer tick, exactly once." Those two facts together are a
// real bug: a UART RX interrupt (fires whenever a character is typed
// at the interactive shell, entirely independent of the 500ms timer)
// advanced tick_count exactly as much as a genuine timer tick did.
// tick_count is this whole scheduler's only notion of elapsed time --
// every task_sleep_ticks call and every sleep_until_table comparison
// is defined in terms of it -- so typing at the shell while any
// task's sleep was pending silently shortened that sleep, system-wide,
// with no relationship to how much real wall-clock time had actually
// passed. Concretely live in this project's own phase4_milestone.py,
// which types multiple shell commands while task_a/b/c's priority-
// inversion demo and task_e's GC pass are running concurrently in the
// background -- exactly the scenario that would speed both up.
// Fixed by returning 1 here iff the timer branch below actually fired
// this call, 0 otherwise, so irq_entry.S can pass that flag through to
// scheduler_switch_from_irq and gate the tick_count increment on it.
fn irq_dispatch() -> i64 {
  let ic_pending1: i64 = 0x2000B204;
  let pending: u32 = mmio_read_u32(ic_pending1);
  let was_timer_tick: i64 = 0;
  if (pending & (2 as u32)) != (0 as u32) {
    let timer_cs: i64 = 0x20003000;
    let timer_clo: i64 = 0x20003004;
    let timer_c1: i64 = 0x20003010;

    // Acknowledge channel 1's match (write-1-to-clear) and reschedule
    // the next one 500ms out, before doing anything else -- if the
    // tick-handling work below ever took long enough to matter, the
    // next deadline should already be armed, not computed late.
    let _ = mmio_write_u32(timer_cs, 2 as u32);
    let now: u32 = mmio_read_u32(timer_clo);
    let interval: u32 = 500000 as u32;
    let next: u32 = now + interval;
    let _ = mmio_write_u32(timer_c1, next);

    // watchdog_kick() would belong here, once per tick -- see
    // watchdog_arm's comment for why it isn't actually called: doing
    // so resets QEMU's raspi1ap immediately rather than arming a real
    // countdown, which would break the only test method this project
    // has.
    //
    // '.' instead of "tick\n": uart_puts's own wait loop makes it
    // unboundable under #[wcet(...)] (see uart_putc_nonblocking's
    // comment) -- a single best-effort byte keeps ticks visible in
    // the log without reintroducing a blocking call to a hard-RT ISR.
    let _ = uart_putc_nonblocking(46);
    was_timer_tick = 1;
  }

  let ic_pending2: i64 = 0x2000B208;
  let pending2: u32 = mmio_read_u32(ic_pending2);
  if (pending2 & (0x02000000 as u32)) != (0 as u32) {
    let uart_fr: i64 = 0x20201018;
    let uart_dr: i64 = 0x20201000;
    let uart_icr: i64 = 0x20201044;
    // Drain the RX FIFO for up to 128 iterations -- shell_line_buf's
    // own capacity (shell_state.S), not the PL011's real 16-byte
    // hardware FIFO depth. A `while` loop here, even one with a
    // literal constant bound checked every iteration, is
    // unconditionally treated as UNBOUNDED by vani's v1 WCET estimator
    // (confirmed in src/safety.rs: `S::While { .. } => None --
    // unbounded, no static iteration count`, with no attempt to prove
    // a bound from the loop body at all) -- only `for i from LOW to
    // HIGH` (vani's own range-for syntax -- not Rust's `0..N`, which
    // the parser rejects) carries a statically-known trip count the
    // estimator can multiply through. `break` was a red herring on the
    // way to finding this: the *first* fix attempt (skip-instead-of-
    // break, still inside a `while`) still failed for the real
    // underlying reason, not the one guessed first.
    //
    // BUG (task #9, found by an event-driven interactive test, not a
    // sleep-timed one -- see shell_interactive_check.py's own header
    // for why the sleep-timed version this replaced was worthless
    // here): 16 iterations undercounts real bursts. QEMU's stdio
    // chardev backend hands a whole typed-then-Entered line to the
    // emulated PL011 as one burst, faster than the guest can service
    // interrupts -- so any line at or past 17 bytes (e.g. "cat
    // /config/mode\r", 17 bytes) left its trailing byte (here, the
    // terminating CR) stuck in the FIFO below the RX interrupt's own
    // trigger threshold, so no further interrupt ever fired to deliver
    // it, shell_line_ready never got set for that line, and every
    // command after the first appeared to vanish without a trace --
    // while the rest of the system (HIGH/MEDIUM/LOW/idle/GC) kept
    // running completely normally throughout, since nothing about this
    // hangs or blocks anything, it just silently stops delivering. 128
    // -- shell_line_buf's own hard cap on how long a line can ever
    // legitimately be -- comfortably covers one full line every time.
    for i from 0 to 128 {
      let fr: u32 = mmio_read_u32(uart_fr);
      if (fr & (0x10 as u32)) == (0 as u32) {
        let c: u32 = mmio_read_u32(uart_dr) & (0xFF as u32);
        let _ = shell_rx_push_char(c);
      }
    }
    // Draining the FIFO above is what actually de-asserts this
    // level-triggered condition; this just clears any stale raw
    // status defensively, same pattern as the timer branch above.
    let _ = mmio_write_u32(uart_icr, 0x10 as u32);
  }
  return was_timer_tick;
}

// Phase 6: network byte order helpers, shared by ARP/IPv4/UDP/TCP
// below. Every multi-byte field in a real network protocol is
// transmitted big-endian ("network byte order"), regardless of the
// host CPU's own endianness -- and ARM1176JZF-S here defaults to
// little-endian, the same as the rest of this project's MMIO/buffer
// code (buf_read_u32/buf_write_u32 from fs_buf.S use plain ldr/str,
// which read/write in the HOST's native order, correct for this
// project's own filesystem records but wrong for anything that has to
// interoperate with a real remote host). These read/write byte-by-byte
// in the correct wire order regardless of host endianness, exactly
// like every multi-byte field already handled by hand in netif's own
// MAC/ethertype writes above -- just named and reusable instead of
// repeated inline each time.
fn buf_write_u16_be(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b1: u32 = value & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  return 0;
}

fn buf_read_u16_be(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  return (b0 << (8 as u32)) | b1;
}

fn buf_write_u32_be(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = (value >> (24 as u32)) & (0xFF as u32);
  let b1: u32 = (value >> (16 as u32)) & (0xFF as u32);
  let b2: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b3: u32 = value & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  let _ = buf_write_byte(buf, (offset + 2) as u32, b2);
  let _ = buf_write_byte(buf, (offset + 3) as u32, b3);
  return 0;
}

fn buf_read_u32_be(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  let b2: u32 = buf_read_byte(buf, (offset + 2) as u32);
  let b3: u32 = buf_read_byte(buf, (offset + 3) as u32);
  return (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3;
}

// Little-endian counterparts to the two above -- every multi-byte
// field this project has built on the wire so far (Ethernet/IP/ICMP/
// UDP/TCP/DHCP) is network byte order (big-endian), but USB's own
// wire format (descriptors, and round 33's Bulk-Only Transport CBW/
// CSW fields) is little-endian throughout, per spec. Kept as their
// own small helpers rather than a byte-order parameter on the BE
// versions, matching this project's own preference for a distinct,
// obviously-named function over a flag that silently changes behavior.
fn buf_write_u32_le(buf: mut ref i64, offset: i64, value: u32) -> i64 {
  let b0: u32 = value & (0xFF as u32);
  let b1: u32 = (value >> (8 as u32)) & (0xFF as u32);
  let b2: u32 = (value >> (16 as u32)) & (0xFF as u32);
  let b3: u32 = (value >> (24 as u32)) & (0xFF as u32);
  let _ = buf_write_byte(buf, offset as u32, b0);
  let _ = buf_write_byte(buf, (offset + 1) as u32, b1);
  let _ = buf_write_byte(buf, (offset + 2) as u32, b2);
  let _ = buf_write_byte(buf, (offset + 3) as u32, b3);
  return 0;
}

fn buf_read_u32_le(buf: mut ref i64, offset: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, offset as u32);
  let b1: u32 = buf_read_byte(buf, (offset + 1) as u32);
  let b2: u32 = buf_read_byte(buf, (offset + 2) as u32);
  let b3: u32 = buf_read_byte(buf, (offset + 3) as u32);
  return b0 | (b1 << (8 as u32)) | (b2 << (16 as u32)) | (b3 << (24 as u32));
}

// Phase 6: generic netif abstraction (DHRUVA_ARCHITECTURE.md §4's own
// "get-go hook": "send/receive a raw frame, MTU, MAC address... just
// an interface, no implementation. Both the LAN9512 wired path and
// the WiFi dongle plug into the same upper-stack path without a
// redesign"). This is the ONE implementation that exists so far: a
// loopback netif, backing everything built on top of it (ARP/IPv4/
// UDP/TCP) for QEMU testing, per §4's own note that no real network
// hardware is emulated for any Pi generation QEMU models. vani has no
// dynamic dispatch -- no way to swap netif implementations at runtime
// via a function-pointer table, since a function's address can't be
// taken as arbitrary integer data (an established finding from this
// project's own Phase 1 work) -- so "the interface" here is a
// naming/layering convention (ARP/IPv4 call netif_send_frame/
// netif_recv_frame by name) rather than a true runtime-swappable
// vtable, consistent with how every other layer in this project
// (fs_*, shell_*) is already structured, and the only netif
// implementation that will ever exist under QEMU regardless of how
// this is designed.
//
// Frames are raw Ethernet: [dst_mac(6)][src_mac(6)][ethertype(2)]
// [payload...] -- the same framing a real hardware netif (LAN9512,
// the WiFi dongle) will need later, so ARP/IPv4 above this get written
// hardware-realistic from the start, not as a loopback-only shortcut.
fn netif_init() -> i64 {
  let buf: mut ref i64 = dhruva_alloc_bytes(2048);
  let _ = netif_set_queue_buf(buf);
  return 0;
}

// Payload MTU: the 512-byte slot (netif_state.S) minus the 14-byte
// Ethernet header -- deliberately not a real 1500-byte Ethernet MTU,
// since nothing this project can test end-to-end under QEMU (no real
// NIC emulated) needs a full-size frame. A real hardware netif
// implementation later would need its own, larger buffers and report
// the real 1500 here instead.
//
// RE-AUDITED (round 20, 2026-08-28), no drift found: ipv4_send/
// udp_send/tcp_send_segment (round 11 fix) still derive their bounds
// from this function alone, still boundary-exact (max payload always
// produces exactly a 512-byte frame, matching netif_send_frame's own
// cutoff with zero slack), and no new hardcoded literal duplicating
// this value has crept back in anywhere since. Receive-side callers
// (socket_udp_recv, tcp_conn_handle_segment, dhcp_client_poll) take
// the caller's real buffer capacity as a required parameter rather
// than re-deriving a number, so they were never exposed to this
// class of drift in the first place -- confirmed every call site's
// allocation still matches what it passes. Also checked dhcp_find_
// option_byte/u32's own TLV parsing (untouched by round 11, since
// that round's scope was send-path bounds only): already correctly
// bounds-checks every option read against `end` before dereferencing,
// including the malicious-opt_len case, so no over-read is possible
// even from a hostile DHCP reply.
fn netif_get_mtu() -> i64 {
  return 498;
}

// Loopback's own placeholder MAC: a locally-administered address (bit
// 1 of the first octet set, per IEEE 802 convention for non-vendor
// addresses) rather than a real vendor OUI, so it can never collide
// with an actual NIC's burned-in address.
fn netif_get_mac(out_buf: mut ref i64) -> i64 {
  let _ = buf_write_byte(out_buf, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(out_buf, 1 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 2 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 3 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 4 as u32, 0 as u32);
  let _ = buf_write_byte(out_buf, 5 as u32, 0x01 as u32);
  return 0;
}

// Sends a raw frame (buf[0..len)) by copying it into the next free
// queue slot. Returns 0 on success, -1 if the queue is already full
// (dropped, matching real best-effort networking behavior under
// congestion -- nothing here can afford to block) or the frame is too
// big for a slot.
fn netif_send_frame(buf: mut ref i64, frame_len: i64) -> i64 {
  if netif_get_count() >= 4 {
    return 0 - 1;
  }
  if frame_len > 512 {
    return 0 - 1;
  }
  let qbuf: mut ref i64 = netif_get_queue_buf();
  let head: i64 = netif_get_head();
  let base: i64 = head * 512;
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(qbuf, (base + i) as u32, b);
    i = i + 1;
  }
  let _ = netif_set_slot_len(head, frame_len);
  let _ = netif_advance_head();
  return 0;
}

// Receives the oldest pending frame into out_buf, returning its
// length, or -1 if nothing is queued OR the queued frame is larger
// than max_len (see below).
//
// BUG (found via audit, 2026-08-27, same shape as round 1's socket_
// udp_recv/tcp_conn_handle_segment fixes, just one layer lower): this
// used to copy up to 512 bytes (a queued frame's real length, valid
// per netif_send_frame's own 512-byte-slot check) into out_buf with
// no idea how big out_buf actually is. Every current caller happens
// to either use a 512-byte buffer (matching the slot size exactly) or
// a smaller one paired with self-generated traffic that never
// actually exceeds it -- but that's a property of today's callers,
// not something this function itself ever enforced. Since all netif
// traffic shares ONE queue, nothing stops a future/different sender's
// larger frame from being the next one a smaller-buffered caller
// dequeues. max_len is now required (no way to ask a dhruva_alloc_
// bytes result its own size at runtime) and a too-large frame is
// dropped (dequeued, not left stuck blocking the queue forever) and
// reported as -1, same "reject, don't guess/truncate" posture as
// every other bounds check this project's networking layer uses.
fn netif_recv_frame(out_buf: mut ref i64, max_len: i64) -> i64 {
  if netif_get_count() <= 0 {
    return 0 - 1;
  }
  let qbuf: mut ref i64 = netif_get_queue_buf();
  let tail: i64 = netif_get_tail();
  let base: i64 = tail * 512;
  let frame_len: i64 = netif_get_slot_len(tail);
  if frame_len > max_len {
    let _ = netif_advance_tail();
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < frame_len {
    let b: u32 = buf_read_byte(qbuf, (base + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let _ = netif_advance_tail();
  return frame_len;
}

// Boot-time self-test: builds a tiny synthetic Ethernet frame
// (broadcast destination, our own loopback MAC as source, ethertype
// 0x0800 = IPv4, payload "hi"), sends it, receives it back, and checks
// every field round-tripped correctly -- plus the empty-queue and
// full-queue edge cases, both real conditions netif_send_frame/
// netif_recv_frame handle explicitly above.
fn netif_self_test() -> i64 {
  let ok: i64 = 1;

  let empty_len: i64 = netif_recv_frame(dhruva_alloc_bytes(64), 64);
  if empty_len != (0 - 1) {
    ok = 0;
  }

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(mac);
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(frame, i as u32, 0xFF as u32); // dst: broadcast
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let mb: u32 = buf_read_byte(mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, mb); // src: our own MAC
    j = j + 1;
  }
  let _ = buf_write_byte(frame, 12 as u32, 0x08 as u32); // ethertype hi (IPv4)
  let _ = buf_write_byte(frame, 13 as u32, 0x00 as u32); // ethertype lo
  let _ = buf_write_byte(frame, 14 as u32, 104 as u32);  // 'h'
  let _ = buf_write_byte(frame, 15 as u32, 105 as u32);  // 'i'

  let send_status: i64 = netif_send_frame(frame, 16);
  if send_status != 0 {
    ok = 0;
  }

  let recv_buf: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_buf, 64);
  if recv_len != 16 {
    ok = 0;
  }
  let et_hi: u32 = buf_read_byte(recv_buf, 12 as u32);
  let et_lo: u32 = buf_read_byte(recv_buf, 13 as u32);
  if (et_hi != (0x08 as u32)) || (et_lo != (0x00 as u32)) {
    ok = 0;
  }
  let c0: u32 = buf_read_byte(recv_buf, 14 as u32);
  let c1: u32 = buf_read_byte(recv_buf, 15 as u32);
  if (c0 != (104 as u32)) || (c1 != (105 as u32)) {
    ok = 0;
  }

  // Queue-full: 4 slots total: send 4 more (filling the queue from
  // empty, since the one above was already drained) then a 5th, which
  // must be dropped.
  let k: i64 = 0;
  while k < 4 {
    let _ = netif_send_frame(frame, 16);
    k = k + 1;
  }
  let overflow_status: i64 = netif_send_frame(frame, 16);
  if overflow_status != (0 - 1) {
    ok = 0;
  }
  // Drain the 4 real frames back out before anything else uses the
  // queue, so this self-test doesn't leave stale frames behind for
  // the ARP/IPv4/UDP self-tests that follow it at boot.
  let m: i64 = 0;
  while m < 4 {
    let _ = netif_recv_frame(recv_buf, 64);
    m = m + 1;
  }

  // Regression test for the missing-destination-capacity fix found by
  // audit (2026-08-27, see netif_recv_frame's own comment): a queued
  // frame larger than the caller's own buffer must be dropped, not
  // used as a copy-loop bound that overflows that buffer. Queues a
  // real 16-byte frame (the same one used above) and asks for it with
  // a deliberately too-small max_len -- it must be rejected AND
  // actually dequeued (so a caller with a too-small buffer can't
  // permanently wedge the queue on a frame it will never fit).
  let small_send_status: i64 = netif_send_frame(frame, 16);
  if small_send_status != 0 {
    ok = 0;
  }
  let too_small_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let too_small_status: i64 = netif_recv_frame(too_small_buf, 4);
  if too_small_status != (0 - 1) {
    ok = 0;
  }
  if netif_get_count() != 0 {
    ok = 0; // must have been dequeued despite being rejected
  }

  let _ = uart_puts("NETIF: loopback send/recv + empty/full edge cases");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: ARP (RFC 826), built directly on netif's own Ethernet
// framing. Field layout (offsets within the full 42-byte frame,
// after netif's own 14-byte dst/src/ethertype header):
//   14-15 hwtype(1=Ethernet)  16-17 ptype(0x0800=IPv4)
//   18 hwlen(6)  19 plen(4)  20-21 op(1=request,2=reply)
//   22-27 sender_mac  28-31 sender_ip
//   32-37 target_mac  38-41 target_ip
// A loopback link doesn't actually need address resolution (there's
// no separate "other host" on the wire to resolve), but the packet
// format and cache logic below are real and directly testable without
// one -- exactly like eval_expr_raw or the governor were verified via
// self-test rather than live input earlier in this project.

fn arp_build_request(out_frame: mut ref i64, my_mac: mut ref i64, my_ip: u32, target_ip: u32) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(out_frame, i as u32, 0xFF as u32); // dst: broadcast
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let mb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(out_frame, (6 + j) as u32, mb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(out_frame, 12, 0x0806 as u32); // ethertype: ARP
  let _ = buf_write_u16_be(out_frame, 14, 1 as u32);      // hwtype: Ethernet
  let _ = buf_write_u16_be(out_frame, 16, 0x0800 as u32); // ptype: IPv4
  let _ = buf_write_byte(out_frame, 18 as u32, 6 as u32);
  let _ = buf_write_byte(out_frame, 19 as u32, 4 as u32);
  let _ = buf_write_u16_be(out_frame, 20, 1 as u32);      // op: request
  let k: i64 = 0;
  while k < 6 {
    let mb2: u32 = buf_read_byte(my_mac, k as u32);
    let _ = buf_write_byte(out_frame, (22 + k) as u32, mb2); // sender mac
    k = k + 1;
  }
  let _ = buf_write_u32_be(out_frame, 28, my_ip);
  let m: i64 = 0;
  while m < 6 {
    let _ = buf_write_byte(out_frame, (32 + m) as u32, 0 as u32); // target mac: unknown
    m = m + 1;
  }
  let _ = buf_write_u32_be(out_frame, 38, target_ip);
  return 42;
}

fn arp_build_reply(out_frame: mut ref i64, my_mac: mut ref i64, my_ip: u32, requester_mac: mut ref i64, requester_ip: u32) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let tb: u32 = buf_read_byte(requester_mac, i as u32);
    let _ = buf_write_byte(out_frame, i as u32, tb); // dst: the requester
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let mb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(out_frame, (6 + j) as u32, mb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(out_frame, 12, 0x0806 as u32);
  let _ = buf_write_u16_be(out_frame, 14, 1 as u32);
  let _ = buf_write_u16_be(out_frame, 16, 0x0800 as u32);
  let _ = buf_write_byte(out_frame, 18 as u32, 6 as u32);
  let _ = buf_write_byte(out_frame, 19 as u32, 4 as u32);
  let _ = buf_write_u16_be(out_frame, 20, 2 as u32);      // op: reply
  let k: i64 = 0;
  while k < 6 {
    let mb2: u32 = buf_read_byte(my_mac, k as u32);
    let _ = buf_write_byte(out_frame, (22 + k) as u32, mb2); // sender: us
    k = k + 1;
  }
  let _ = buf_write_u32_be(out_frame, 28, my_ip);
  let m: i64 = 0;
  while m < 6 {
    let tb2: u32 = buf_read_byte(requester_mac, m as u32);
    let _ = buf_write_byte(out_frame, (32 + m) as u32, tb2); // target: the requester
    m = m + 1;
  }
  let _ = buf_write_u32_be(out_frame, 38, requester_ip);
  return 42;
}

fn arp_get_ethertype(frame: mut ref i64) -> u32 {
  return buf_read_u16_be(frame, 12);
}

fn arp_is_arp_frame(frame: mut ref i64) -> i64 {
  if arp_get_ethertype(frame) == (0x0806 as u32) {
    return 1;
  }
  return 0;
}

fn arp_get_operation(frame: mut ref i64) -> u32 {
  return buf_read_u16_be(frame, 20);
}

fn arp_get_sender_ip(frame: mut ref i64) -> u32 {
  return buf_read_u32_be(frame, 28);
}

fn arp_get_target_ip(frame: mut ref i64) -> u32 {
  return buf_read_u32_be(frame, 38);
}

fn arp_get_sender_mac(frame: mut ref i64, out_mac: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let b: u32 = buf_read_byte(frame, (22 + i) as u32);
    let _ = buf_write_byte(out_mac, i as u32, b);
    i = i + 1;
  }
  return 0;
}

fn arp_cache_init() -> i64 {
  let buf: mut ref i64 = dhruva_alloc_bytes(48);
  let _ = arp_cache_set_macs_buf(buf);
  return 0;
}

// Looks up ip in the cache; if found, copies its MAC into out_mac and
// returns 1; if not found, returns 0 (out_mac left untouched).
fn arp_cache_lookup(ip: u32, out_mac: mut ref i64) -> i64 {
  let count: u32 = arp_cache_get_count();
  let i: u32 = 0 as u32;
  while i < count {
    if arp_cache_get_ip(i) == ip {
      let macs: mut ref i64 = arp_cache_get_macs_buf();
      let base: u32 = i * (6 as u32);
      let j: i64 = 0;
      while j < 6 {
        let b: u32 = buf_read_byte(macs, base + (j as u32));
        let _ = buf_write_byte(out_mac, j as u32, b);
        j = j + 1;
      }
      return 1;
    }
    i = i + (1 as u32);
  }
  return 0;
}

// Inserts/updates an IP -> MAC mapping. Updates in place if the IP is
// already cached; otherwise appends while there's room, or overwrites
// the oldest entry round-robin once full (arp_cache_next_slot) -- a
// demo-scoped cache, not a production one with real aging/timeouts.
fn arp_cache_insert(ip: u32, mac: mut ref i64) -> i64 {
  let count: u32 = arp_cache_get_count();
  let i: u32 = 0 as u32;
  while i < count {
    if arp_cache_get_ip(i) == ip {
      let macs: mut ref i64 = arp_cache_get_macs_buf();
      let base: u32 = i * (6 as u32);
      let j: i64 = 0;
      while j < 6 {
        let b: u32 = buf_read_byte(mac, j as u32);
        let _ = buf_write_byte(macs, base + (j as u32), b);
        j = j + 1;
      }
      return 0;
    }
    i = i + (1 as u32);
  }
  let slot: u32 = 0 as u32;
  if count < (8 as u32) {
    slot = count;
    let _ = arp_cache_set_count(count + (1 as u32));
  } else {
    slot = arp_cache_get_next_slot();
    let next: u32 = (slot + (1 as u32)) & (7 as u32);
    let _ = arp_cache_set_next_slot(next);
  }
  let _ = arp_cache_set_ip(slot, ip);
  let macs2: mut ref i64 = arp_cache_get_macs_buf();
  let base2: u32 = slot * (6 as u32);
  let k: i64 = 0;
  while k < 6 {
    let b2: u32 = buf_read_byte(mac, k as u32);
    let _ = buf_write_byte(macs2, base2 + (k as u32), b2);
    k = k + 1;
  }
  return 0;
}

// Boot-time self-test: build+parse a request and a reply (round-
// tripping every field), then exercise the cache (insert, lookup,
// lookup-miss, and update-in-place -- re-inserting the same IP with a
// different MAC must overwrite, not append a second entry).
fn arp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;     // 192.168.1.1
  let target_ip: u32 = 0xC0A80102 as u32; // 192.168.1.2

  let req_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let req_len: i64 = arp_build_request(req_frame, my_mac, my_ip, target_ip);
  if req_len != 42 {
    ok = 0;
  }
  if arp_is_arp_frame(req_frame) != 1 {
    ok = 0;
  }
  if arp_get_operation(req_frame) != (1 as u32) {
    ok = 0;
  }
  if arp_get_sender_ip(req_frame) != my_ip {
    ok = 0;
  }
  if arp_get_target_ip(req_frame) != target_ip {
    ok = 0;
  }
  let parsed_sender_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = arp_get_sender_mac(req_frame, parsed_sender_mac);
  let mi: i64 = 0;
  while mi < 6 {
    let a: u32 = buf_read_byte(my_mac, mi as u32);
    let b: u32 = buf_read_byte(parsed_sender_mac, mi as u32);
    if a != b {
      ok = 0;
    }
    mi = mi + 1;
  }

  // A peer (192.168.1.2) replying to our request.
  let peer_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 5 as u32, 0x02 as u32);
  let reply_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let reply_len: i64 = arp_build_reply(reply_frame, peer_mac, target_ip, my_mac, my_ip);
  if reply_len != 42 {
    ok = 0;
  }
  if arp_get_operation(reply_frame) != (2 as u32) {
    ok = 0;
  }
  if arp_get_sender_ip(reply_frame) != target_ip {
    ok = 0;
  }

  let _ = arp_cache_init();
  let _ = arp_cache_insert(target_ip, peer_mac);
  let looked_up: mut ref i64 = dhruva_alloc_bytes(8);
  let found: i64 = arp_cache_lookup(target_ip, looked_up);
  if found != 1 {
    ok = 0;
  }
  let ci: i64 = 0;
  while ci < 6 {
    let a2: u32 = buf_read_byte(peer_mac, ci as u32);
    let b2: u32 = buf_read_byte(looked_up, ci as u32);
    if a2 != b2 {
      ok = 0;
    }
    ci = ci + 1;
  }
  let not_found: i64 = arp_cache_lookup(0xDEADBEEF as u32, looked_up);
  if not_found != 0 {
    ok = 0;
  }

  // Re-insert the same IP with a different MAC: must overwrite the
  // existing entry, not grow the cache.
  let peer_mac2: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac2, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac2, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac2, 5 as u32, 0x03 as u32);
  let _ = arp_cache_insert(target_ip, peer_mac2);
  let count_after: u32 = arp_cache_get_count();
  if count_after != (1 as u32) {
    ok = 0;
  }
  let looked_up2: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = arp_cache_lookup(target_ip, looked_up2);
  let last_byte: u32 = buf_read_byte(looked_up2, 5 as u32);
  if last_byte != (0x03 as u32) {
    ok = 0;
  }

  let _ = uart_puts("ARP: build/parse + cache insert/lookup/update");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 22 audit, 2026-08-28: the live ARP resolution round trip
// round 21 explicitly deferred rather than building unboundedly --
// see socket_udp_send's own comment for why a cache MISS there is
// reported as a real failure rather than triggering a live
// resolution attempt mid-call. Built here as its own small,
// poll-based capability instead, matching every other stateful
// protocol in this project's design (DHCP, TCP): a single synchronous
// call structurally cannot wait for a live reply, so resolution is
// split into "send the request" (arp_resolve_start) and a separate
// "check whether a reply has arrived yet" (arp_resolve_poll) the
// caller invokes on its own later poll(s) -- exactly dhcp_client_
// start/dhcp_client_poll's own shape. Not wired into any live caller
// this round; this is the general capability itself, proven on its
// own merits by arp_resolve_self_test below. DHCP's own new lease-
// renewal code (dhcp_client_check_lease) doesn't use this either --
// it learns the server's MAC for free from the ACK frame it already
// received, sidestepping the need for a live round trip for that
// specific, narrower case.
fn arp_resolve_start(my_mac: mut ref i64, my_ip: u32, target_ip: u32) -> i64 {
  let req_frame: mut ref i64 = arp_resolve_scratch_get();
  let req_len: i64 = arp_build_request(req_frame, my_mac, my_ip, target_ip);
  return netif_send_frame(req_frame, req_len);
}

// Dequeues the next queued frame and checks whether it's an ARP
// reply resolving target_ip -- if so, caches it (arp_cache_insert)
// and returns 1. Returns 0 otherwise, whether because nothing was
// queued, the frame wasn't ARP, wasn't a reply, or resolved a
// different address -- same "not every queued frame is mine, drop it
// and move on" tolerance dhcp_client_poll/socket_udp_recv already
// have. This project's netif has one shared FIFO queue with no
// selective peek, so any consumer that finds a frame isn't for it
// has already consumed it regardless of what this function decides
// -- an accepted, pre-existing tradeoff (see socket_udp_recv's own
// comment: "no per-port binding/filtering table exists yet"), not a
// new limitation introduced here.
fn arp_resolve_poll(target_ip: u32) -> i64 {
  let frame: mut ref i64 = arp_resolve_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 64);
  if frame_len < 0 {
    return 0;
  }
  if arp_is_arp_frame(frame) != 1 {
    return 0;
  }
  if arp_get_operation(frame) != (2 as u32) {
    return 0;
  }
  if arp_get_sender_ip(frame) != target_ip {
    return 0;
  }
  let sender_mac: mut ref i64 = arp_resolve_mac_scratch_get();
  let _ = arp_get_sender_mac(frame, sender_mac);
  let _ = arp_cache_insert(target_ip, sender_mac);
  return 1;
}

// Boot-time self-test: no real second host exists in this loopback-
// only environment (same reasoning DHCP's own self-test already
// establishes), so this drains the request arp_resolve_start queues
// on the real netif and sanity-checks it, then manually builds a
// synthetic reply exactly as a real peer would and queues it via the
// real netif, proving arp_resolve_poll picks it up and updates the
// cache correctly -- plus the "nothing arrived yet" and "queued
// frame doesn't match" cases, both real conditions a live caller
// would hit.
fn arp_resolve_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;
  let target_ip: u32 = 0xC0A80105 as u32; // .5, not touched by any earlier self-test

  // Nothing queued yet -- must report "not resolved," not a false
  // positive.
  let none_yet: i64 = arp_resolve_poll(target_ip);
  if none_yet != 0 {
    ok = 0;
  }

  let start_status: i64 = arp_resolve_start(my_mac, my_ip, target_ip);
  if start_status != 0 {
    ok = 0;
  }

  // Drain and sanity-check the request itself before injecting the
  // synthetic reply below, the same "verify what actually went out"
  // discipline dhcp_self_test already uses for its own DISCOVER.
  let req_check: mut ref i64 = dhruva_alloc_bytes(64);
  let req_check_len: i64 = netif_recv_frame(req_check, 64);
  if req_check_len < 0 { ok = 0; }
  if arp_is_arp_frame(req_check) != 1 { ok = 0; }
  if arp_get_operation(req_check) != (1 as u32) { ok = 0; }
  if arp_get_target_ip(req_check) != target_ip { ok = 0; }

  // A peer (192.168.1.5) replying to our request.
  let peer_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(peer_mac, 0 as u32, 0x02 as u32);
  let _ = buf_write_byte(peer_mac, 1 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 2 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 3 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 4 as u32, 0 as u32);
  let _ = buf_write_byte(peer_mac, 5 as u32, 0x05 as u32);
  let reply_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let reply_len: i64 = arp_build_reply(reply_frame, peer_mac, target_ip, my_mac, my_ip);
  let send_status: i64 = netif_send_frame(reply_frame, reply_len);
  if send_status != 0 { ok = 0; }

  let resolved: i64 = arp_resolve_poll(target_ip);
  if resolved != 1 { ok = 0; }
  let looked_up: mut ref i64 = dhruva_alloc_bytes(8);
  let found: i64 = arp_cache_lookup(target_ip, looked_up);
  if found != 1 { ok = 0; }
  if buf_read_byte(looked_up, 5 as u32) != (0x05 as u32) { ok = 0; }

  let _ = uart_puts("ARP: arp_resolve_start/poll live round trip");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: IPv4 (RFC 791), no options (IHL always 5 -- a 20-byte
// header, deliberately not supporting IP options at all: nothing this
// project's own from-scratch stack sends or needs to receive requires
// them, matching the doc's own "scoped like uIP/picoTCP" framing for
// this whole phase). Sits directly on netif's Ethernet framing, no
// new persistent state needed -- unlike ARP's cache, there's nothing
// here that needs to survive across calls, so this stays pure vani
// logic over the existing buf_* helpers with no new assembly file.
//
// Header layout (offsets relative to ip_offset, i.e. 14 bytes into
// the full Ethernet frame for anything netif-backed):
//   0 version(4 bits)+IHL(4 bits)   1 DSCP+ECN (unused, 0)
//   2-3 total length (header+payload)   4-5 identification (unused, 0)
//   6-7 flags+fragment offset (unused, 0 -- no fragmentation support)
//   8 TTL   9 protocol (1=ICMP, 6=TCP, 17=UDP)
//   10-11 header checksum   12-15 source IP   16-19 destination IP

fn ipv4_checksum(frame: mut ref i64, ip_offset: i64) -> u32 {
  let sum: u32 = 0 as u32;
  let i: i64 = 0;
  while i < 20 {
    let word: u32 = buf_read_u16_be(frame, ip_offset + i);
    sum = sum + word;
    i = i + 2;
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  return sum & (0xFFFF as u32);
}

fn ipv4_build_header(frame: mut ref i64, ip_offset: i64, total_len: i64, protocol: u32, src_ip: u32, dst_ip: u32) -> i64 {
  let _ = buf_write_byte(frame, ip_offset as u32, 0x45 as u32); // version 4, IHL 5
  let _ = buf_write_byte(frame, (ip_offset + 1) as u32, 0 as u32);
  let _ = buf_write_u16_be(frame, ip_offset + 2, total_len as u32);
  let _ = buf_write_u16_be(frame, ip_offset + 4, 0 as u32);
  let _ = buf_write_u16_be(frame, ip_offset + 6, 0 as u32);
  let _ = buf_write_byte(frame, (ip_offset + 8) as u32, 64 as u32); // TTL
  let _ = buf_write_byte(frame, (ip_offset + 9) as u32, protocol);
  let _ = buf_write_u16_be(frame, ip_offset + 10, 0 as u32); // checksum placeholder
  let _ = buf_write_u32_be(frame, ip_offset + 12, src_ip);
  let _ = buf_write_u32_be(frame, ip_offset + 16, dst_ip);
  // One's complement of the sum, computed with the checksum field
  // itself still zero -- standard IPv4 checksum construction.
  let checksum: u32 = (ipv4_checksum(frame, ip_offset) ^ (0xFFFF as u32)) & (0xFFFF as u32);
  let _ = buf_write_u16_be(frame, ip_offset + 10, checksum);
  return 20;
}

fn ipv4_get_total_len(frame: mut ref i64, ip_offset: i64) -> u32 {
  return buf_read_u16_be(frame, ip_offset + 2);
}
fn ipv4_get_protocol(frame: mut ref i64, ip_offset: i64) -> u32 {
  return buf_read_byte(frame, (ip_offset + 9) as u32);
}
fn ipv4_get_src_ip(frame: mut ref i64, ip_offset: i64) -> u32 {
  return buf_read_u32_be(frame, ip_offset + 12);
}
fn ipv4_get_dst_ip(frame: mut ref i64, ip_offset: i64) -> u32 {
  return buf_read_u32_be(frame, ip_offset + 16);
}

// A correctly-checksummed header sums (as transmitted, checksum field
// included) to all-ones -- the standard IPv4 checksum verification
// trick, avoiding needing to zero the field out again to re-check it.
fn ipv4_verify_checksum(frame: mut ref i64, ip_offset: i64) -> i64 {
  if ipv4_checksum(frame, ip_offset) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

// Builds a full Ethernet+IPv4 frame around payload[0..payload_len) and
// sends it via netif. Frame layout: [14-byte Ethernet header][20-byte
// IP header][payload].
//
// `frame` is net_send_scratch, not a fresh dhruva_alloc_bytes call --
// see scratch_state.S's own comment on that buffer for why: this
// function (and udp_send/tcp_send_segment right after it) is the
// actual network SEND path, callable many times over a real session,
// not just from a boot self-test.
// BUG (round 9 audit, 2026-08-27): payload_len used to feed straight
// into the copy loop below with no check against net_send_scratch's
// real 512-byte capacity -- netif_send_frame's own `frame_len > 512`
// check runs AFTER this function has already built (and, for an
// oversized payload_len, already overrun) the frame in net_send_
// scratch, so it catches the problem one step too late to actually
// prevent it. Every caller today passes a small, trusted payload_len,
// so not live-hit, but this is the send-side twin of the exact bug
// round 1 already fixed on the receive side (socket_udp_recv/
// tcp_conn_handle_segment trusting a length without checking
// destination capacity) -- worth closing before any future socket-API
// consumer (an echo server turning a received payload_len around into
// a send call, a DHCP client, etc.) can trip it.
//
// BUG (round 11 audit, 2026-08-27): this check's own bound used to be
// a hardcoded literal (478) rather than derived from netif_get_mtu()
// -- netif's own declared, authoritative "how much payload fits above
// the Ethernet layer" answer (DHRUVA_ARCHITECTURE.md's own framing:
// netif is supposed to be "an interface" exactly so higher layers
// don't need to know its internals). A hardcoded number that merely
// happens to match today's netif_get_mtu()-20 arithmetic is a second,
// silently-divergeable source of truth: the moment a real hardware
// netif (LAN9512/WiFi, this project's own documented next step)
// reports a different MTU -- larger (a real 1500-byte Ethernet MTU)
// or, in principle, smaller -- this hardcoded check stops matching
// reality, either rejecting valid traffic or (worse) failing to catch
// an overflow netif_get_mtu() would have correctly flagged. Every
// send-path bound in this file now derives from netif_get_mtu() at
// call time instead.
fn ipv4_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, protocol: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let ipv4_max_payload: i64 = netif_get_mtu() - 20; // netif's own payload budget, minus the 20-byte IP header
  if (payload_len < 0) || (payload_len > ipv4_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let total_len: i64 = 20 + payload_len;
  let _ = ipv4_build_header(frame, 14, total_len, protocol, src_ip, dst_ip);
  let k: i64 = 0;
  while k < payload_len {
    let pb: u32 = buf_read_byte(payload, k as u32);
    let _ = buf_write_byte(frame, (34 + k) as u32, pb); // 14 + 20 = 34
    k = k + 1;
  }
  return netif_send_frame(frame, 34 + payload_len);
}

// Boot-time self-test: send an IPv4 packet over the loopback netif,
// receive it back, and verify every header field plus the checksum
// and payload round-tripped correctly.
fn ipv4_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let payload: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32); // 'i'

  let send_status: i64 = ipv4_send(my_mac, my_mac, src_ip, dst_ip, 17 as u32, payload, 2);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_frame, 64);
  if recv_len != 36 {
    ok = 0;
  }
  if ipv4_get_total_len(recv_frame, 14) != (22 as u32) {
    ok = 0;
  }
  if ipv4_get_protocol(recv_frame, 14) != (17 as u32) {
    ok = 0;
  }
  if ipv4_get_src_ip(recv_frame, 14) != src_ip {
    ok = 0;
  }
  if ipv4_get_dst_ip(recv_frame, 14) != dst_ip {
    ok = 0;
  }
  if ipv4_verify_checksum(recv_frame, 14) != 1 {
    ok = 0;
  }
  let p0: u32 = buf_read_byte(recv_frame, 34 as u32);
  let p1: u32 = buf_read_byte(recv_frame, 35 as u32);
  if (p0 != (104 as u32)) || (p1 != (105 as u32)) {
    ok = 0;
  }

  let _ = uart_puts("IPV4: build/send/recv + checksum verify");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 26 (2026-08-28): dotted-quad IP address string <-> u32
// conversion -- every self-test in this file so far has only ever
// used hex literals (0xC0A80101) for an IP, fine for code but useless
// for an interactive shell command a human actually types. Returns
// the parsed address as a non-negative i64 on success (safe to do,
// since `u32 as i64` zero-extends rather than sign-extends in vani --
// so a genuine 255.255.255.255 still comes back as a large POSITIVE
// i64, never colliding with the -1 error sentinel below) or -1 on any
// malformed input: not exactly
// four dot-separated segments, an empty segment (covers both "a..b.c"
// and a leading/trailing dot), a non-digit character, more than three
// digits in one segment, or any segment's own value exceeding 255.
// Rejecting rather than clamping or guessing matches this project's
// own "reject, don't guess" posture for every other untrusted-input
// parse (DHCP's TLV options, the UDP/TCP length-validation fixes).
fn ip_parse_dotted_quad(buf: mut ref i64, start: i64, end: i64) -> i64 {
  let result: u32 = 0 as u32;
  let octet_val: i64 = 0;
  let octet_digits: i64 = 0;
  let octet_count: i64 = 0;
  let pos: i64 = start;
  while pos < end {
    let c: u32 = buf_read_byte(buf, pos as u32);
    if c == (46 as u32) { // '.'
      if (octet_digits == 0) || (octet_val > (255 as i64)) || (octet_count >= (3 as i64)) {
        return 0 - 1;
      }
      result = (result << (8 as u32)) | (octet_val as u32);
      octet_val = 0;
      octet_digits = 0;
      octet_count = octet_count + 1;
    } else {
      if (c < (48 as u32)) || (c > (57 as u32)) {
        return 0 - 1; // not a digit
      }
      if octet_digits >= (3 as i64) {
        return 0 - 1; // more digits than "255" could ever need
      }
      octet_val = (octet_val * (10 as i64)) + ((c - (48 as u32)) as i64);
      octet_digits = octet_digits + 1;
    }
    pos = pos + 1;
  }
  // The fourth segment has no trailing dot to end it -- checked here,
  // after the loop, against the same rules every other segment above
  // already enforced.
  if (octet_digits == 0) || (octet_val > (255 as i64)) || (octet_count != (3 as i64)) {
    return 0 - 1;
  }
  result = (result << (8 as u32)) | (octet_val as u32);
  return result as i64;
}

// Prints ip in dotted-quad form directly to the UART (no intermediate
// string buffer -- matches this file's own established style of
// printing incrementally via uart_puts/uart_put_i64 rather than
// building a formatted string first).
fn uart_put_ip(ip: u32) -> i64 {
  let a: u32 = (ip >> (24 as u32)) & (0xFF as u32);
  let b: u32 = (ip >> (16 as u32)) & (0xFF as u32);
  let c: u32 = (ip >> (8 as u32)) & (0xFF as u32);
  let d: u32 = ip & (0xFF as u32);
  let _ = uart_put_i64(a as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(b as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(c as i64);
  let _ = uart_puts(".");
  let _ = uart_put_i64(d as i64);
  return 0;
}

// TEST-ONLY: copies a vani string literal's bytes into buf, returning
// its length -- this project's own self-tests everywhere else build
// byte sequences by hand (one buf_write_byte call per byte, e.g.
// udp_self_test's own "hello" payload), which would make eight
// dotted-quad test strings unreadable; str_byte_at/str_len_bytes are
// generic vani builtins, not anything specific to this test.
fn ip_test_write_str(buf: mut ref i64, s: Str) -> i64 {
  let slen: i64 = str_len_bytes(s);
  let i: i64 = 0;
  while i < slen {
    let b: i64 = str_byte_at(s, i);
    let _ = buf_write_byte(buf, i as u32, b as u32);
    i = i + 1;
  }
  return slen;
}

// Boot-time self-test: round-trips several known addresses through
// the parser and confirms the exact reject cases named in
// ip_parse_dotted_quad's own comment are all actually rejected, not
// just the happy path.
fn ip_parse_self_test() -> i64 {
  let ok: i64 = 1;
  let buf: mut ref i64 = dhruva_alloc_bytes(24);

  let l1: i64 = ip_test_write_str(buf, "192.168.1.1");
  if ip_parse_dotted_quad(buf, 0, l1) != (0xC0A80101 as i64) { ok = 0; }

  let l2: i64 = ip_test_write_str(buf, "0.0.0.0");
  if ip_parse_dotted_quad(buf, 0, l2) != 0 { ok = 0; }

  let l3: i64 = ip_test_write_str(buf, "255.255.255.255");
  if ip_parse_dotted_quad(buf, 0, l3) != (0xFFFFFFFF as i64) { ok = 0; }

  let l4: i64 = ip_test_write_str(buf, "256.1.1.1"); // segment > 255
  if ip_parse_dotted_quad(buf, 0, l4) != (0 - 1) { ok = 0; }

  let l5: i64 = ip_test_write_str(buf, "1.2.3"); // too few segments
  if ip_parse_dotted_quad(buf, 0, l5) != (0 - 1) { ok = 0; }

  let l6: i64 = ip_test_write_str(buf, "1.2.3.4.5"); // too many segments
  if ip_parse_dotted_quad(buf, 0, l6) != (0 - 1) { ok = 0; }

  let l7: i64 = ip_test_write_str(buf, "1..3.4"); // empty segment
  if ip_parse_dotted_quad(buf, 0, l7) != (0 - 1) { ok = 0; }

  let l8: i64 = ip_test_write_str(buf, "1.2.3.a"); // non-digit
  if ip_parse_dotted_quad(buf, 0, l8) != (0 - 1) { ok = 0; }

  let _ = uart_puts("IP: dotted-quad parse round-trip + reject cases");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued, round 25 (2026-08-28): ICMP (RFC 792) echo
// request/reply -- "ping," the one basic network capability every
// real IP stack has that this project had never built (protocol
// number 1 was named in a comment on ipv4_get_protocol's own header
// years of rounds ago, but nothing ever implemented it). Sits
// directly on ipv4_build_header/netif exactly like UDP/TCP do, no new
// persistent state, pure vani logic.
//
// Echo message layout (RFC 792, both request type=8 and reply type=0
// share this same shape): type(1) code(1, always 0 for echo)
// checksum(2) identifier(2) sequence(2) [arbitrary data...].
//
// Unlike UDP/TCP's checksum, ICMP's covers no pseudo-header at all --
// just the ICMP message itself, computed and verified the exact same
// "sums to 0xFFFF as transmitted" way ipv4_checksum/ipv4_verify_
// checksum already do for the IP header, not UDP's own RFC-768-
// specific "never transmit a literal 0" special case (that rule is
// UDP's alone; RFC 792 has no equivalent for ICMP).
fn icmp_checksum(frame: mut ref i64, icmp_offset: i64, icmp_len: i64) -> u32 {
  let sum: u32 = 0 as u32;
  let i: i64 = 0;
  while (i + 1) < icmp_len {
    let word: u32 = buf_read_u16_be(frame, icmp_offset + i);
    sum = sum + word;
    i = i + 2;
  }
  if i < icmp_len {
    let b: u32 = buf_read_byte(frame, (icmp_offset + i) as u32);
    sum = sum + (b << (8 as u32)); // odd trailing byte, zero-padded low
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  return sum & (0xFFFF as u32);
}
fn icmp_verify_checksum(frame: mut ref i64, icmp_offset: i64, icmp_len: i64) -> i64 {
  if icmp_checksum(frame, icmp_offset, icmp_len) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

fn icmp_type_echo_reply() -> u32 { return 0 as u32; }
fn icmp_type_echo_request() -> u32 { return 8 as u32; }

// Builds an echo request or reply message (type_val picks which) at
// frame[icmp_offset..), returning its total length (8-byte header +
// payload_len). Shared by both directions -- the only difference
// between a request and its reply is the type byte and which side
// initiated it, everything else about the message shape is identical
// (RFC 792 requires a reply to echo the request's own identifier,
// sequence, and data back verbatim, which this being one shared
// builder makes automatic rather than something a caller could get
// wrong copying by hand).
fn icmp_build_echo(frame: mut ref i64, icmp_offset: i64, type_val: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let _ = buf_write_byte(frame, icmp_offset as u32, type_val);
  let _ = buf_write_byte(frame, (icmp_offset + 1) as u32, 0 as u32); // code
  let _ = buf_write_u16_be(frame, icmp_offset + 2, 0 as u32); // checksum placeholder
  let _ = buf_write_u16_be(frame, icmp_offset + 4, identifier);
  let _ = buf_write_u16_be(frame, icmp_offset + 6, seq);
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (icmp_offset + 8 + i) as u32, b);
    i = i + 1;
  }
  let icmp_len: i64 = 8 + payload_len;
  let checksum: u32 = (icmp_checksum(frame, icmp_offset, icmp_len) ^ (0xFFFF as u32)) & (0xFFFF as u32);
  let _ = buf_write_u16_be(frame, icmp_offset + 2, checksum);
  return icmp_len;
}

fn icmp_get_type(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_byte(frame, icmp_offset as u32);
}
fn icmp_get_identifier(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, icmp_offset + 4);
}
fn icmp_get_sequence(frame: mut ref i64, icmp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, icmp_offset + 6);
}

// Builds a full Ethernet+IPv4+ICMP frame and sends it via netif --
// same shape as ipv4_send/udp_send/tcp_send_segment right around it,
// sharing net_send_scratch for the same reason round 11's own comment
// on that buffer already establishes safe: none of these send
// functions call each other, each independently builds one complete
// frame from scratch.
fn icmp_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, type_val: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let icmp_max_payload: i64 = netif_get_mtu() - 20 - 8; // minus IP header, minus the 8-byte echo header -- same netif_get_mtu()-derivation discipline round 11 established for every other send path
  if (payload_len < 0) || (payload_len > icmp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let icmp_len: i64 = icmp_build_echo(frame, 34, type_val, identifier, seq, payload, payload_len);
  let total_len: i64 = 20 + icmp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 1 as u32, src_ip, dst_ip); // protocol 1 = ICMP
  return netif_send_frame(frame, 14 + total_len);
}

// Sends an echo request -- the "ping" a caller actually issues.
// Doesn't wait for a reply itself (this project's own established
// poll-don't-block design, same reasoning DHCP/TCP/ARP resolution all
// already use): a caller polls icmp_poll separately, as many times as
// it's willing to, to find out whether one ever came back.
fn icmp_ping_start(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, identifier: u32, seq: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  return icmp_send(my_mac, dst_mac, src_ip, dst_ip, icmp_type_echo_request(), identifier, seq, payload, payload_len);
}

// Dequeues the next queued frame and handles it if it's ICMP:
//   - an echo REQUEST addressed to my_ip is answered automatically,
//     right here, the same way a real OS kernel answers ping without
//     any application involvement -- returns -2 (not a payload
//     length, just a "handled, but this isn't a reply for you" signal
//     distinct from both "nothing relevant" and any real length).
//   - an echo REPLY (to anyone, not filtered by identifier/seq -- this
//     project's socket layer doesn't demux by port either, see
//     socket_udp_recv's own comment on why that's an accepted scope
//     limit, not an oversight) copies its payload into out_payload,
//     [src_ip(4 BE)][identifier(2 BE)][seq(2 BE)] into out_meta, and
//     returns the payload length -- the caller checks identifier/seq
//     itself against what it expects.
//   - anything else (non-ICMP, an echo request not addressed to us,
//     a request/reply too large for max_payload_len) is dequeued and
//     dropped, returning -1, same "not every queued frame is mine"
//     tolerance every other live receive path in this project has.
fn icmp_poll(my_mac: mut ref i64, my_ip: u32, out_payload: mut ref i64, max_payload_len: i64, out_meta: mut ref i64) -> i64 {
  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (1 as u32) {
    return 0 - 1;
  }
  let total_len: u32 = ipv4_get_total_len(frame, 14);
  let icmp_len: i64 = (total_len as i64) - 20;
  // Same "reject, don't guess" bounds posture socket_udp_recv/
  // dhcp_client_poll already use: a declared length claiming more
  // than netif actually delivered, or too short to even hold the
  // fixed 8-byte echo header, is dropped outright before anything
  // below trusts it.
  if icmp_len < 8 {
    return 0 - 1;
  }
  if (14 + (total_len as i64)) > frame_len {
    return 0 - 1;
  }
  if ipv4_verify_checksum(frame, 14) != 1 {
    return 0 - 1;
  }
  if icmp_verify_checksum(frame, 34, icmp_len) != 1 {
    return 0 - 1;
  }
  let msg_type: u32 = icmp_get_type(frame, 34);
  let payload_len: i64 = icmp_len - 8;

  if msg_type == icmp_type_echo_request() {
    if ipv4_get_dst_ip(frame, 14) != my_ip {
      return 0 - 1; // not addressed to us -- not this project's to answer
    }
    let src_ip: u32 = ipv4_get_src_ip(frame, 14);
    let src_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(frame, (6 + mi) as u32); // Ethernet src MAC
      let _ = buf_write_byte(src_mac, mi as u32, mb);
      mi = mi + 1;
    }
    let identifier: u32 = icmp_get_identifier(frame, 34);
    let seq: u32 = icmp_get_sequence(frame, 34);
    let echo_payload: mut ref i64 = dhruva_alloc_bytes(56); // 64-byte real-hardware-typical ping payload minus the 8-byte header, generous headroom over anything this project's own self-test sends
    let copy_len: i64 = if payload_len > (56 as i64) { 56 as i64 } else { payload_len };
    let ci: i64 = 0;
    while ci < copy_len {
      let b: u32 = buf_read_byte(frame, (42 + ci) as u32); // 14 + 20 + 8
      let _ = buf_write_byte(echo_payload, ci as u32, b);
      ci = ci + 1;
    }
    let _ = icmp_send(my_mac, src_mac, my_ip, src_ip, icmp_type_echo_reply(), identifier, seq, echo_payload, copy_len);
    return 0 - 2;
  }

  if msg_type == icmp_type_echo_reply() {
    if payload_len > max_payload_len {
      return 0 - 1;
    }
    let pi: i64 = 0;
    while pi < payload_len {
      let b: u32 = buf_read_byte(frame, (42 + pi) as u32);
      let _ = buf_write_byte(out_payload, pi as u32, b);
      pi = pi + 1;
    }
    let src_ip: u32 = ipv4_get_src_ip(frame, 14);
    let identifier: u32 = icmp_get_identifier(frame, 34);
    let seq: u32 = icmp_get_sequence(frame, 34);
    let _ = buf_write_u32_be(out_meta, 0, src_ip);
    let _ = buf_write_u16_be(out_meta, 4, identifier);
    let _ = buf_write_u16_be(out_meta, 6, seq);
    return payload_len;
  }

  return 0 - 1; // some other ICMP type (e.g. destination unreachable) -- not handled yet
}

// Boot-time self-test: pings our OWN IP over the loopback netif.
// Unlike every other self-test in this project's networking layer,
// this one needs no synthetic "other host" at all -- pinging yourself
// is a genuinely real, self-contained round trip: the first poll
// dequeues our own just-sent echo REQUEST and icmp_poll's own live
// auto-responder answers it for real (queuing a real reply, not a
// hand-built stand-in), and the second poll dequeues THAT reply and
// confirms it matches. Also confirms the "unrelated identifier"
// case is reported as a real reply (this layer doesn't demux by
// identifier/seq itself, matching socket_udp_recv's own no-port-
// demux scope) rather than silently dropped.
fn icmp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let my_ip: u32 = 0xC0A80101 as u32;
  let identifier: u32 = 0x1234 as u32;
  let seq: u32 = 1 as u32;

  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 112 as u32); // "ping"
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32);
  let _ = buf_write_byte(payload, 2 as u32, 110 as u32);
  let _ = buf_write_byte(payload, 3 as u32, 103 as u32);

  let send_status: i64 = icmp_ping_start(my_mac, my_mac, my_ip, my_ip, identifier, seq, payload, 4);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);

  // First poll: our own echo REQUEST, auto-answered.
  let poll1: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if poll1 != (0 - 2) {
    ok = 0;
  }

  // Second poll: the reply icmp_poll's own responder just queued.
  let poll2: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if poll2 != 4 {
    ok = 0;
  }
  let i: i64 = 0;
  while i < 4 {
    let a: u32 = buf_read_byte(payload, i as u32);
    let b: u32 = buf_read_byte(recv_payload, i as u32);
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }
  if buf_read_u32_be(recv_meta, 0) != my_ip {
    ok = 0;
  }
  if buf_read_u16_be(recv_meta, 4) != identifier {
    ok = 0;
  }
  if buf_read_u16_be(recv_meta, 6) != seq {
    ok = 0;
  }

  let empty_status: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
  if empty_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("ICMP: ping self over loopback (auto-reply + round trip)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6: UDP (RFC 768), sitting on ipv4_build_header/netif exactly
// like IPv4 sits on netif -- no new persistent state, pure vani logic.
// Header: src_port(2) dst_port(2) length(2, header+data) checksum(2).
//
// The checksum covers a "pseudo-header" (source IP, destination IP,
// a zero byte, the protocol number, and the UDP length) PREPENDED to
// the real UDP header+data before summing -- not because those bytes
// are transmitted twice, but because it's what lets a corrupted IP
// address (not just corrupted UDP bytes) be caught by the receiver,
// per RFC 768's own design. A UDP checksum of exactly 0 is illegal on
// the wire (0 means "no checksum was computed" by convention) --
// RFC 768 requires transmitting 0xFFFF instead in that case.

fn udp_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, udp_offset: i64, udp_len: i64) -> u32 {
  let sum: u32 = 0 as u32;
  sum = sum + ((src_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (src_ip & (0xFFFF as u32));
  sum = sum + ((dst_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (dst_ip & (0xFFFF as u32));
  sum = sum + (17 as u32); // protocol (the pseudo-header's zero byte contributes nothing)
  sum = sum + (udp_len as u32);
  let i: i64 = 0;
  while (i + 1) < udp_len {
    let word: u32 = buf_read_u16_be(frame, udp_offset + i);
    sum = sum + word;
    i = i + 2;
  }
  if i < udp_len {
    let b: u32 = buf_read_byte(frame, (udp_offset + i) as u32);
    sum = sum + (b << (8 as u32)); // odd trailing byte, zero-padded low
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  let result: u32 = (sum ^ (0xFFFF as u32)) & (0xFFFF as u32);
  if result == (0 as u32) {
    return 0xFFFF as u32; // RFC 768: transmit all-ones, never a literal 0
  }
  return result;
}

// BUG (round 8 audit, 2026-08-27): no udp_verify_checksum existed at
// all, and socket_udp_recv (the live UDP receive path) never checked
// an incoming datagram's checksum against anything -- despite every
// other layer in this stack having a working, self-tested verify
// function (ipv4_verify_checksum, tcp_verify_checksum) sitting right
// next to its own build/checksum function. A corrupted UDP datagram
// (bit-flipped in transit -- the exact threat model this project's
// own FS layer takes seriously enough to checksum every record for)
// would be silently accepted and handed to the caller as valid data.
//
// The verify criterion here is NOT the same as tcp_verify_checksum's
// `== 0` -- confirmed by working through the arithmetic (and checked
// against a standalone vani test): udp_checksum has an extra step
// tcp_checksum doesn't (RFC 768's "never transmit a literal 0, send
// 0xFFFF instead" substitution). Re-summing a valid, as-transmitted
// datagram (checksum field included) always folds to exactly 0xFFFF,
// which udp_checksum's own zero-substitution rule then maps back to
// 0xFFFF again (not 0) -- so a valid datagram makes udp_checksum
// return 0xFFFF, matching ipv4_verify_checksum's convention, not
// tcp_verify_checksum's.
fn udp_verify_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, udp_offset: i64, udp_len: i64) -> i64 {
  if udp_checksum(src_ip, dst_ip, frame, udp_offset, udp_len) == (0xFFFF as u32) {
    return 1;
  }
  return 0;
}

// Writes the UDP header+payload at frame[udp_offset..), returning the
// UDP length (header+payload). Caller still has to build the IP
// header around this afterward (see udp_send below) -- kept separate
// so a self-test can exercise header construction without needing a
// full send/recv round trip too.
fn udp_build(frame: mut ref i64, udp_offset: i64, src_port: u32, dst_port: u32, payload: mut ref i64, payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let udp_len: i64 = 8 + payload_len;
  let _ = buf_write_u16_be(frame, udp_offset, src_port);
  let _ = buf_write_u16_be(frame, udp_offset + 2, dst_port);
  let _ = buf_write_u16_be(frame, udp_offset + 4, udp_len as u32);
  let _ = buf_write_u16_be(frame, udp_offset + 6, 0 as u32); // checksum placeholder
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (udp_offset + 8 + i) as u32, b);
    i = i + 1;
  }
  let checksum: u32 = udp_checksum(src_ip, dst_ip, frame, udp_offset, udp_len);
  let _ = buf_write_u16_be(frame, udp_offset + 6, checksum);
  return udp_len;
}

fn udp_get_src_port(frame: mut ref i64, udp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, udp_offset);
}
fn udp_get_dst_port(frame: mut ref i64, udp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, udp_offset + 2);
}
fn udp_get_length(frame: mut ref i64, udp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, udp_offset + 4);
}

// Builds and sends a full Ethernet+IPv4+UDP frame. Offsets are fixed
// (14 for IP, 34 for UDP) since this stack never sends IP options.
// `frame` is net_send_scratch -- see ipv4_send's own comment above.
//
// BUG (round 9 audit, 2026-08-27): same send-side missing-bounds-check
// shape as ipv4_send's own fix above, one layer higher -- payload_len
// fed udp_build's copy loop with nothing checking it against net_send_
// scratch's real 512-byte capacity first.
//
// BUG (round 11 audit, 2026-08-27): same "derive from netif_get_mtu(),
// don't hardcode a number that merely matches it today" fix as
// ipv4_send's own comment explains in full.
fn udp_send(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let udp_max_payload: i64 = netif_get_mtu() - 20 - 8; // minus IP header, minus UDP header
  if (payload_len < 0) || (payload_len > udp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let udp_len: i64 = udp_build(frame, 34, src_port, dst_port, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + udp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 17 as u32, src_ip, dst_ip);
  return netif_send_frame(frame, 14 + total_len);
}

// Phase 6's "small socket-style API" (DHRUVA_ARCHITECTURE.md §4): a
// thin, deliberately minimal wrapper hiding the raw Ethernet/IP/UDP
// plumbing above. This demo stack has exactly one implicit "socket" --
// no per-port binding/filtering table exists yet, so socket_udp_recv
// just reports whatever the next queued UDP frame's own header says
// it's addressed to/from, silently skipping (returning -1 for) any
// non-UDP frame rather than actually demultiplexing by port. A real
// multi-socket implementation would need that; this is enough to
// prove the layers below it end-to-end, per this phase's own scope.
// BUG (round 21 audit, 2026-08-28): this used to hardcode `my_mac` as
// the destination MAC unconditionally -- a loopback-only assumption
// baked directly into the one layer explicitly documented as hiding
// this exact plumbing from callers. It happened to "work" only
// because there is no other real host on this project's only tested
// link: whatever remote_ip claims, the frame still had to physically
// go to yourself to be receivable at all. On real hardware
// (LAN9512/WiFi), a genuinely different peer's MAC has to actually be
// known before a unicast frame can reach it -- arp_cache_lookup/
// arp_cache_insert/arp_build_request/arp_build_reply were all already
// implemented and self-tested (arp_self_test), but had ZERO live
// callers anywhere in the codebase, the same "correct function nobody
// calls" bug class rounds 8 and 11 already found in this file. Fixed
// by requiring the destination to already be ARP-resolved (a cache
// hit) before sending -- matching every other layer in this project's
// established poll-don't-block design (DHCP/TCP never block inside a
// single call waiting on a live round trip either): a synchronous
// send function has no way to synchronously wait for an ARP reply
// without restructuring this whole layer into a stateful poll loop,
// so a cache miss is reported as a real, honest failure (-1, "no
// route to host") rather than silently substituting a MAC that's
// certain to be wrong for any real off-loopback destination.
fn socket_udp_send(my_mac: mut ref i64, local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let dst_mac: mut ref i64 = udp_send_arp_scratch_get();
  if arp_cache_lookup(remote_ip, dst_mac) != 1 {
    return 0 - 1;
  }
  return udp_send(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, payload, payload_len);
}

// Receives the next queued frame; if it's UDP, copies its payload into
// out_payload and writes [src_ip(4, BE)][src_port(2, BE)][dst_port(2,
// BE)] into out_meta (8 bytes), returning the payload length. Returns
// -1 if nothing is queued, the frame isn't UDP, or the segment fails
// the sanity checks below (see the comment at those checks for what
// they guard against and why they're not optional). `frame` is
// net_recv_scratch, not a fresh allocation -- see ipv4_send's own
// comment on the identical fix for the send side.
fn socket_udp_recv(out_payload: mut ref i64, out_meta: mut ref i64, max_payload_len: i64) -> i64 {
  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (17 as u32) {
    return 0 - 1;
  }
  let udp_len: u32 = udp_get_length(frame, 34);
  let payload_len: i64 = (udp_len as i64) - 8;
  // BUG (found via audit, 2026-08-27, never actually triggered since
  // nothing exercises this against real/malformed network input yet):
  // payload_len came entirely from the UDP header's OWN self-reported
  // length field -- untrusted data carried INSIDE the very frame this
  // function is parsing, not validated against anything. A field
  // claiming an absurd length (corrupted on the wire, or crafted, on
  // any real non-loopback link) would drive the copy loop below to
  // read far past frame's real bounds and write far past out_payload's
  // real allocated size -- a heap buffer over-read/overflow, the exact
  // kind of bug a from-scratch network stack has to guard against at
  // exactly this boundary (untrusted bytes off the wire), not trust
  // the way this project trusts its own already-checksummed FS
  // records. Three checks, all required: the declared length can't be
  // negative (a UDP length < 8 doesn't even cover its own header), the
  // declared segment can't claim to extend past what netif actually
  // received (frame_len), and the payload can't be larger than the
  // caller's own out_payload buffer (max_payload_len, now a required
  // parameter -- there is no way to ask a dhruva_alloc_bytes result
  // its own size at runtime, so the caller has to say). Any violation
  // is treated as a malformed/hostile segment and dropped outright,
  // never silently truncated -- same "reject, don't guess" posture as
  // fs_init's own checksum-based recovery scan.
  if payload_len < 0 {
    return 0 - 1;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0 - 1;
  }
  if payload_len > max_payload_len {
    return 0 - 1;
  }
  // BUG (round 8 audit, 2026-08-27): this function never checked the
  // datagram's own checksum against anything -- see udp_verify_
  // checksum's own comment for the full story. Checked here, after
  // the length/bounds validation above (so the checksum is computed
  // over a range already known to be in-bounds) and before the
  // payload copy, same "reject, don't guess" posture as every other
  // check in this function.
  let src_ip_for_checksum: u32 = ipv4_get_src_ip(frame, 14);
  let dst_ip_for_checksum: u32 = ipv4_get_dst_ip(frame, 14);
  if udp_verify_checksum(src_ip_for_checksum, dst_ip_for_checksum, frame, 34, udp_len as i64) != 1 {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(frame, (42 + i) as u32); // 14 + 20 + 8
    let _ = buf_write_byte(out_payload, i as u32, b);
    i = i + 1;
  }
  let src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let src_port: u32 = udp_get_src_port(frame, 34);
  let dst_port: u32 = udp_get_dst_port(frame, 34);
  let _ = buf_write_u32_be(out_meta, 0, src_ip);
  let _ = buf_write_u16_be(out_meta, 4, src_port);
  let _ = buf_write_u16_be(out_meta, 6, dst_port);
  return payload_len;
}

// Boot-time self-test: send a UDP datagram over the loopback netif,
// receive it back through the socket API, and verify the payload,
// port/address metadata, and the empty-queue case afterward.
//
// BUG (round 21 audit, 2026-08-28): socket_udp_send now requires
// remote_ip to already be ARP-resolved (see its own comment for the
// full story) rather than silently sending to itself -- so this test
// pre-populates the cache with arp_cache_insert(remote_ip, my_mac)
// before calling it, standing in for "ARP already happened" the same
// way DHCP's own self-test manually builds a synthetic server reply
// instead of needing a real second host. This tests UDP header
// build/parse/checksum round-tripping specifically; arp_self_test
// already independently covers the ARP mechanics themselves. Depends
// on arp_self_test having already run this boot (it's the one place
// arp_cache_init actually gets called) -- see kernel_main's own call
// order.
fn udp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;
  let local_port: u32 = 12345 as u32;
  let remote_port: u32 = 7 as u32;

  let payload: mut ref i64 = dhruva_alloc_bytes(16);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // "hello"
  let _ = buf_write_byte(payload, 1 as u32, 101 as u32);
  let _ = buf_write_byte(payload, 2 as u32, 108 as u32);
  let _ = buf_write_byte(payload, 3 as u32, 108 as u32);
  let _ = buf_write_byte(payload, 4 as u32, 111 as u32);

  let _ = arp_cache_insert(remote_ip, my_mac);
  let send_status: i64 = socket_udp_send(my_mac, local_ip, remote_ip, local_port, remote_port, payload, 5);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(16);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let recv_len: i64 = socket_udp_recv(recv_payload, recv_meta, 16);
  if recv_len != 5 {
    ok = 0;
  }
  let i: i64 = 0;
  while i < 5 {
    let a: u32 = buf_read_byte(payload, i as u32);
    let b: u32 = buf_read_byte(recv_payload, i as u32);
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }

  let got_src_ip: u32 = buf_read_u32_be(recv_meta, 0);
  let got_src_port: u32 = buf_read_u16_be(recv_meta, 4);
  let got_dst_port: u32 = buf_read_u16_be(recv_meta, 6);
  if got_src_ip != local_ip {
    ok = 0;
  }
  if got_src_port != local_port {
    ok = 0;
  }
  if got_dst_port != remote_port {
    ok = 0;
  }

  let empty_status: i64 = socket_udp_recv(recv_payload, recv_meta, 16);
  if empty_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: socket send/recv over loopback + checksum");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 21's fix (see socket_udp_send's own
// comment): sending to an IP that was never ARP-resolved must be
// rejected outright, not silently sent to whatever MAC happens to be
// convenient (this project's own MAC, the loopback-only shortcut that
// used to sit here unconditionally). Deliberately uses an IP no
// earlier self-test this boot has ever called arp_cache_insert for.
fn udp_send_unresolved_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let never_resolved_ip: u32 = 0xC0A80103 as u32; // .3, never cached
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32);

  let send_status: i64 = socket_udp_send(my_mac, local_ip, never_resolved_ip, 12345 as u32, 7 as u32, payload, 1);
  if send_status != (0 - 1) {
    ok = 0;
  }
  // Confirm the rejection didn't leak a phantom frame onto the queue
  // either -- a caller retrying after resolving the address must see
  // an empty queue, not a stale, wrongly-addressed one from the
  // rejected attempt.
  let drain: mut ref i64 = dhruva_alloc_bytes(16);
  let drain_status: i64 = netif_recv_frame(drain, 16);
  if drain_status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: socket_udp_send rejects an unresolved destination");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for the length-validation fix found by audit
// (2026-08-27, see socket_udp_recv's own comment): a UDP segment
// whose header claims a length far beyond what was actually received
// must be rejected outright, not trusted as a copy-loop bound. Builds
// a real, small, correctly-queued frame (so netif_recv_frame reports
// its true, small length), then corrupts only the UDP header's own
// length field to claim far more data than that -- exactly the shape
// a corrupted-on-the-wire or hostile segment would have on any real
// (non-loopback) link.
fn udp_recv_bounds_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let i: i64 = 0;
  while i < 12 {
    let _ = buf_write_byte(frame, i as u32, 0 as u32); // dst/src MAC, don't care
    i = i + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32);
  let real_udp_len: i64 = udp_build(frame, 34, 1 as u32, 2 as u32, payload, 1, local_ip, remote_ip);
  let real_total_len: i64 = 20 + real_udp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 17 as u32, local_ip, remote_ip);
  let real_frame_len: i64 = 14 + real_total_len; // 14+20+9 = 43 bytes, actually queued

  // Corrupt ONLY the UDP header's own length field (checksum is left
  // stale/mismatched on purpose -- this test targets the length
  // bounds check specifically, not checksum validation; the too-large
  // length is rejected by the bounds check below before checksum
  // verification is even reached. See udp_checksum_reject_self_test
  // right after this function for the checksum-specific case).
  let _ = buf_write_u16_be(frame, 34 + 4, 60000 as u32);

  let send_status: i64 = netif_send_frame(frame, real_frame_len);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let status: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: recv rejects a length field past what was actually received");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 8's checksum-verification fix (see
// udp_verify_checksum's own comment): a UDP datagram with a perfectly
// valid length but corrupted PAYLOAD bytes must now be rejected too --
// before this fix, socket_udp_recv never checked the checksum at all,
// so this exact corruption would have been silently accepted and
// handed to the caller as if it were valid data.
fn udp_checksum_reject_self_test() -> i64 {
  let ok: i64 = 1;
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let i: i64 = 0;
  while i < 12 {
    let _ = buf_write_byte(frame, i as u32, 0 as u32); // dst/src MAC, don't care
    i = i + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 65 as u32); // 'A'
  let real_udp_len: i64 = udp_build(frame, 34, 1 as u32, 2 as u32, payload, 1, local_ip, remote_ip);
  let real_total_len: i64 = 20 + real_udp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 17 as u32, local_ip, remote_ip);
  let real_frame_len: i64 = 14 + real_total_len;

  // Corrupt ONLY the payload byte -- length fields (both IPv4 and UDP)
  // stay correct, so this must pass every bounds check and be rejected
  // by checksum verification specifically.
  let _ = buf_write_byte(frame, 42 as u32, 66 as u32); // 'A' -> 'B', 14+20+8=42

  let send_status: i64 = netif_send_frame(frame, real_frame_len);
  if send_status != 0 {
    ok = 0;
  }

  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let status: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if status != (0 - 1) {
    ok = 0;
  }

  let _ = uart_puts("UDP: recv rejects a datagram with a corrupted checksum");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: TCP (RFC 793), the last protocol layer
// DHRUVA_ARCHITECTURE.md §4 calls for ("ARP, IPv4, UDP, TCP, a small
// socket-style API"). No options (data offset always 5 words/20
// bytes, matching this stack's own "no IP options either" convention
// -- nothing here sends or needs to parse them). This first slice is
// the stateless header layer only (build/parse/checksum), verified by
// its own self-test exactly like ARP/IPv4 were introduced before
// UDP's stateful socket layer landed on top -- the three-way-
// handshake + data-transfer + close connection state machine is
// deliberately a separate, later slice, not attempted in the same
// pass as this header layer.
//
// Header layout (offsets relative to tcp_offset, 34 bytes into a
// netif-backed frame with no IP options, exactly where UDP's own
// header starts):
//   0-1 source port          2-3 destination port
//   4-7 sequence number      8-11 acknowledgment number
//   12 data offset (upper 4 bits, in 32-bit words) + reserved (0)
//   13 flags (bit0=FIN bit1=SYN bit2=RST bit3=PSH bit4=ACK bit5=URG)
//   14-15 window size        16-17 checksum        18-19 urgent ptr (0)
//
// Checksum uses the identical pseudo-header technique as UDP (source
// IP, destination IP, zero byte, protocol=6, TCP segment length) --
// see udp_checksum's own comment for why the pseudo-header matters,
// same reasoning applies verbatim here.

fn tcp_flag_fin() -> u32 { return 0x01 as u32; }
fn tcp_flag_syn() -> u32 { return 0x02 as u32; }
fn tcp_flag_rst() -> u32 { return 0x04 as u32; }
fn tcp_flag_psh() -> u32 { return 0x08 as u32; }
fn tcp_flag_ack() -> u32 { return 0x10 as u32; }

fn tcp_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, tcp_offset: i64, tcp_len: i64) -> u32 {
  let sum: u32 = 0 as u32;
  sum = sum + ((src_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (src_ip & (0xFFFF as u32));
  sum = sum + ((dst_ip >> (16 as u32)) & (0xFFFF as u32));
  sum = sum + (dst_ip & (0xFFFF as u32));
  sum = sum + (6 as u32); // protocol (pseudo-header's zero byte contributes nothing)
  sum = sum + (tcp_len as u32);
  let i: i64 = 0;
  while (i + 1) < tcp_len {
    let word: u32 = buf_read_u16_be(frame, tcp_offset + i);
    sum = sum + word;
    i = i + 2;
  }
  if i < tcp_len {
    let b: u32 = buf_read_byte(frame, (tcp_offset + i) as u32);
    sum = sum + (b << (8 as u32)); // odd trailing byte, zero-padded low
  }
  while (sum >> (16 as u32)) != (0 as u32) {
    sum = (sum & (0xFFFF as u32)) + (sum >> (16 as u32));
  }
  return (sum ^ (0xFFFF as u32)) & (0xFFFF as u32);
}

// Writes the TCP header+payload at frame[tcp_offset..), returning the
// segment length (header+payload). Caller builds the IP header around
// this afterward (see tcp_send_segment below), same split as UDP's
// own udp_build/udp_send for the same reason (a self-test can exercise
// header construction alone without a full send/recv round trip).
fn tcp_build_header(frame: mut ref i64, tcp_offset: i64, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: mut ref i64, payload_len: i64, src_ip: u32, dst_ip: u32) -> i64 {
  let tcp_len: i64 = 20 + payload_len;
  let _ = buf_write_u16_be(frame, tcp_offset, src_port);
  let _ = buf_write_u16_be(frame, tcp_offset + 2, dst_port);
  let _ = buf_write_u32_be(frame, tcp_offset + 4, seq);
  let _ = buf_write_u32_be(frame, tcp_offset + 8, ack);
  let _ = buf_write_byte(frame, (tcp_offset + 12) as u32, 0x50 as u32); // data offset=5, reserved=0
  let _ = buf_write_byte(frame, (tcp_offset + 13) as u32, flags);
  let _ = buf_write_u16_be(frame, tcp_offset + 14, window);
  let _ = buf_write_u16_be(frame, tcp_offset + 16, 0 as u32); // checksum placeholder
  let _ = buf_write_u16_be(frame, tcp_offset + 18, 0 as u32); // urgent pointer, unused
  let i: i64 = 0;
  while i < payload_len {
    let b: u32 = buf_read_byte(payload, i as u32);
    let _ = buf_write_byte(frame, (tcp_offset + 20 + i) as u32, b);
    i = i + 1;
  }
  let checksum: u32 = tcp_checksum(src_ip, dst_ip, frame, tcp_offset, tcp_len);
  let _ = buf_write_u16_be(frame, tcp_offset + 16, checksum);
  return tcp_len;
}

fn tcp_get_src_port(frame: mut ref i64, tcp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, tcp_offset);
}
fn tcp_get_dst_port(frame: mut ref i64, tcp_offset: i64) -> u32 {
  return buf_read_u16_be(frame, tcp_offset + 2);
}
fn tcp_get_seq(frame: mut ref i64, tcp_offset: i64) -> u32 {
  return buf_read_u32_be(frame, tcp_offset + 4);
}
fn tcp_get_ack(frame: mut ref i64, tcp_offset: i64) -> u32 {
  return buf_read_u32_be(frame, tcp_offset + 8);
}
fn tcp_get_flags(frame: mut ref i64, tcp_offset: i64) -> u32 {
  return buf_read_byte(frame, (tcp_offset + 13) as u32);
}
fn tcp_get_data_offset_bytes(frame: mut ref i64, tcp_offset: i64) -> i64 {
  let raw: u32 = buf_read_byte(frame, (tcp_offset + 12) as u32);
  return ((raw >> (4 as u32)) as i64) * 4;
}

// A correctly-checksummed segment's bytes, summed again as
// transmitted (checksum field included, unlike at build time), yield
// exactly zero -- NOT all-ones. This differs from ipv4_verify_
// checksum's own convention on purpose, not by accident: ipv4_
// checksum returns the raw pre-complement sum (its caller,
// ipv4_build_header, does the `^ 0xFFFF` complement itself), so
// summing again including the stored checksum reaches all-ones
// (S + ~S, the defining identity of one's-complement negation).
// tcp_checksum instead complements its OWN running sum internally
// before returning (matching udp_checksum's shape, which this
// function was modeled on) -- so calling it again over the as-
// transmitted bytes computes ~(S + C) = ~(S + ~S) = ~0xFFFF = 0x0000
// instead. Found live: the first version of this function copied
// ipv4_verify_checksum's `== 0xFFFF` comparison without accounting
// for that difference, and failed on every single correctly-built
// segment.
fn tcp_verify_checksum(src_ip: u32, dst_ip: u32, frame: mut ref i64, tcp_offset: i64, tcp_len: i64) -> i64 {
  if tcp_checksum(src_ip, dst_ip, frame, tcp_offset, tcp_len) == (0 as u32) {
    return 1;
  }
  return 0;
}

// Builds a full Ethernet+IPv4+TCP segment and sends it via netif.
// Fixed offsets (14 for IP, 34 for TCP) since this stack never sends
// IP options, matching udp_send's own layout exactly.
//
// BUG (round 9 audit, 2026-08-27): same send-side missing-bounds-check
// shape as ipv4_send/udp_send's own fixes -- payload_len fed tcp_build_
// header's copy loop with nothing checking it against net_send_
// scratch's real 512-byte capacity first.
//
// BUG (round 11 audit, 2026-08-27): same "derive from netif_get_mtu(),
// don't hardcode a number that merely matches it today" fix as
// ipv4_send's own comment explains in full.
fn tcp_send_segment(my_mac: mut ref i64, dst_mac: mut ref i64, src_ip: u32, dst_ip: u32, src_port: u32, dst_port: u32, seq: u32, ack: u32, flags: u32, window: u32, payload: mut ref i64, payload_len: i64) -> i64 {
  let tcp_max_payload: i64 = netif_get_mtu() - 20 - 20; // minus IP header, minus TCP header (no options)
  if (payload_len < 0) || (payload_len > tcp_max_payload) {
    return 0 - 1;
  }
  let frame: mut ref i64 = net_send_scratch_get();
  let i: i64 = 0;
  while i < 6 {
    let db: u32 = buf_read_byte(dst_mac, i as u32);
    let _ = buf_write_byte(frame, i as u32, db);
    i = i + 1;
  }
  let j: i64 = 0;
  while j < 6 {
    let sb: u32 = buf_read_byte(my_mac, j as u32);
    let _ = buf_write_byte(frame, (6 + j) as u32, sb);
    j = j + 1;
  }
  let _ = buf_write_u16_be(frame, 12, 0x0800 as u32); // ethertype: IPv4
  let tcp_len: i64 = tcp_build_header(frame, 34, src_port, dst_port, seq, ack, flags, window, payload, payload_len, src_ip, dst_ip);
  let total_len: i64 = 20 + tcp_len;
  let _ = ipv4_build_header(frame, 14, total_len, 6 as u32, src_ip, dst_ip);
  return netif_send_frame(frame, 14 + total_len);
}

// Boot-time self-test: build/send/receive a single SYN segment over
// the loopback netif and verify every TCP header field, the checksum,
// and the (empty, for a SYN) payload round-tripped correctly -- the
// same "prove the stateless header layer is byte-correct" role
// ipv4_self_test plays for IPv4, before UDP's stateful socket layer
// was introduced on top of ITS header layer. The three-way-handshake/
// data-transfer/close connection state machine gets its own, later
// self-test once that stateful layer exists.
fn tcp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let src_ip: u32 = 0xC0A80101 as u32;
  let dst_ip: u32 = 0xC0A80102 as u32;
  let src_port: u32 = 54321 as u32;
  let dst_port: u32 = 80 as u32;
  let seq: u32 = 1000 as u32;
  let ack: u32 = 0 as u32;
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();

  let send_status: i64 = tcp_send_segment(my_mac, my_mac, src_ip, dst_ip, src_port, dst_port, seq, ack, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
  if send_status != 0 {
    ok = 0;
  }

  let recv_frame: mut ref i64 = dhruva_alloc_bytes(64);
  let recv_len: i64 = netif_recv_frame(recv_frame, 64);
  if recv_len != 54 { // 14 (eth) + 20 (ip) + 20 (tcp), no payload
    ok = 0;
  }
  if tcp_get_src_port(recv_frame, 34) != src_port {
    ok = 0;
  }
  if tcp_get_dst_port(recv_frame, 34) != dst_port {
    ok = 0;
  }
  if tcp_get_seq(recv_frame, 34) != seq {
    ok = 0;
  }
  if tcp_get_ack(recv_frame, 34) != ack {
    ok = 0;
  }
  if tcp_get_flags(recv_frame, 34) != tcp_flag_syn() {
    ok = 0;
  }
  if tcp_get_data_offset_bytes(recv_frame, 34) != 20 {
    ok = 0;
  }
  if tcp_verify_checksum(src_ip, dst_ip, recv_frame, 34, 20) != 1 {
    ok = 0;
  }
  if ipv4_get_protocol(recv_frame, 14) != (6 as u32) {
    ok = 0;
  }

  let _ = uart_puts("TCP: header build/send/recv + checksum verify (SYN)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: the stateful TCP connection state machine --
// three-way handshake, data transfer, and a simplified close, closing
// out DHRUVA_ARCHITECTURE.md §4's "small socket-style API" for TCP.
//
// Deliberately event-driven (one segment in, one reaction out) rather
// than a blocking `tcp_connect()` that internally loops waiting for a
// response: this is a single-threaded environment with no second task
// available to run "the other side" concurrently while a blocking
// call waits, the same reasoning arp_self_test's own design already
// reflects (it never actually blocks on a real request/reply round
// trip either). The self-test below plays traffic cop, manually
// handing each side's own outgoing segment to the OTHER side's
// tcp_conn_handle_segment call -- two independent connection slots
// (boot/tcp_state.S), not one, so both a real "active open" client
// role and a real "passive open" server role can be tracked
// simultaneously.
//
// Deliberately NOT implemented, matching this phase's own "scoped
// like uIP/picoTCP, not full lwIP feature parity" framing: no
// retransmission timers (this stack never drops/reorders its own
// loopback traffic, so nothing here would ever exercise one), no
// simultaneous-open/simultaneous-close edge cases, no window-size
// enforcement (window is always advertised as the maximum and never
// actually consulted), no urgent-pointer handling. A real, useful,
// correctly-sequenced happy-path connection lifecycle, not a
// spec-complete implementation.

fn tcp_state_closed() -> u32 { return 0 as u32; }
fn tcp_state_syn_sent() -> u32 { return 1 as u32; }
fn tcp_state_syn_rcvd() -> u32 { return 2 as u32; }
fn tcp_state_established() -> u32 { return 3 as u32; }
fn tcp_state_fin_wait() -> u32 { return 4 as u32; }
fn tcp_state_closed_final() -> u32 { return 5 as u32; }

// Round 37: retransmission timing constants. 4 ticks (timer_ic_init's
// own 500ms compare interval -- confirmed against that function's own
// comment) = 2 real seconds, short enough for a live test to actually
// wait one out without an excessive delay, long enough to be a real
// timeout rather than firing on ordinary scheduling jitter. 3 retries
// before giving up, matching this project's own established "bounded,
// not forever" polling discipline used everywhere else.
fn tcp_rtx_timeout_ticks() -> u32 {
  return 4 as u32;
}
fn tcp_rtx_max_retries() -> u32 {
  return 3 as u32;
}

// Active open (the connecting/"client" side): records connection
// identity, picks an initial sequence number, and sends the opening
// SYN. Conn moves to SYN_SENT; the handshake only completes once the
// caller feeds a matching SYN-ACK segment into tcp_conn_handle_segment.
// Round 37: also arms the SYN's own retransmission timer -- rtx_len=0
// marks this as a bare-SYN retransmission (no payload buffer needed),
// rtx_seq=initial_seq is what tcp_conn_check_retransmit resends if the
// SYN-ACK never arrives.
fn tcp_conn_active_open(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64, local_ip: u32, remote_ip: u32, local_port: u32, remote_port: u32, initial_seq: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_remote_port(conn_id, remote_port);
  let _ = tcp_conn_set_local_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_remote_seq(conn_id, 0 as u32);
  let _ = tcp_conn_set_state(conn_id, tcp_state_syn_sent());
  let _ = tcp_conn_set_rtx_seq(conn_id, initial_seq);
  let _ = tcp_conn_set_rtx_len(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
  let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
  return tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, initial_seq, 0 as u32, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
}

// Passive open (the listening/"server" side): records only the local
// identity it's willing to accept a connection on -- remote identity
// and sequence numbers get filled in once tcp_conn_handle_segment sees
// the actual incoming SYN. Conn stays CLOSED until then (there's no
// separate LISTEN state in this minimal scope; a CLOSED connection
// with local_port already set is what handle_segment treats as
// "willing to accept").
fn tcp_conn_passive_open(conn_id: u32, local_ip: u32, local_port: u32) -> i64 {
  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_local_port(conn_id, local_port);
  let _ = tcp_conn_set_state(conn_id, tcp_state_closed());
  return 0;
}

// The core state-machine step: given one already-received TCP segment
// (frame, with its IPv4/Ethernet headers still in place at their
// usual fixed offsets) addressed to this connection, takes whatever
// single reaction the current state calls for -- sending at most one
// reply segment via my_mac/dst_mac -- and returns:
//   >= 0  a data segment was accepted; return value is the payload
//         length copied into out_payload (0 for a control-only
//         segment with no data, which is the common case)
//   -1    the segment didn't match anything this state expects
//         (silently ignored, matching a real TCP's own tolerance of
//         duplicate/out-of-order segments in a scope this minimal
//         implementation doesn't attempt to handle)
fn tcp_conn_handle_segment(conn_id: u32, frame: mut ref i64, recv_len: i64, my_mac: mut ref i64, dst_mac: mut ref i64, out_payload: mut ref i64, max_payload_len: i64) -> i64 {
  // BUG (round 8 audit, 2026-08-27): this function -- the live TCP
  // receive path -- never checked an incoming segment's checksum
  // against anything, despite tcp_checksum/tcp_verify_checksum both
  // already existing, working, and self-tested. A corrupted segment
  // (bit-flipped in transit) would be processed as if valid, its
  // flags/seq/ack all trusted outright. Checked here, before any of
  // the state-machine branches below, so it covers every segment type
  // uniformly (a control-only segment's flags could be corrupted just
  // as easily as a data segment's payload) -- same "reject, don't
  // guess" posture as every other check in this networking layer.
  // tcp_len is computed from recv_len (already trusted -- how many
  // bytes netif actually received, per round 1's audit) rather than
  // the segment's own data_offset field, since the checksum has to
  // cover the whole segment as received regardless of which branch
  // below ends up handling it.
  let tcp_seg_len: i64 = recv_len - 34;
  let checksum_src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let checksum_dst_ip: u32 = ipv4_get_dst_ip(frame, 14);
  if tcp_verify_checksum(checksum_src_ip, checksum_dst_ip, frame, 34, tcp_seg_len) != 1 {
    return 0 - 1;
  }
  let state: u32 = tcp_conn_get_state(conn_id);
  let flags: u32 = tcp_get_flags(frame, 34);
  let seg_seq: u32 = tcp_get_seq(frame, 34);
  let seg_ack: u32 = tcp_get_ack(frame, 34);
  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);

  let has_syn: i64 = 0;
  if (flags & tcp_flag_syn()) != (0 as u32) { has_syn = 1; }
  let has_ack: i64 = 0;
  if (flags & tcp_flag_ack()) != (0 as u32) { has_ack = 1; }
  let has_fin: i64 = 0;
  if (flags & tcp_flag_fin()) != (0 as u32) { has_fin = 1; }
  let has_psh: i64 = 0;
  if (flags & tcp_flag_psh()) != (0 as u32) { has_psh = 1; }

  // Passive open, first SYN arriving: only reachable from CLOSED with
  // a local_port already configured by tcp_conn_passive_open.
  if (state == tcp_state_closed()) && (has_syn == 1) && (tcp_get_dst_port(frame, 34) == local_port) {
    let _ = tcp_conn_set_remote_ip(conn_id, ipv4_get_src_ip(frame, 14));
    let _ = tcp_conn_set_remote_port(conn_id, tcp_get_src_port(frame, 34));
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // SYN consumes one seq number
    let server_isn: u32 = 5000 as u32;
    let _ = tcp_conn_set_local_seq(conn_id, server_isn);
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), server_isn, tcp_conn_get_remote_seq(conn_id), tcp_flag_syn() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Active-open side receiving the SYN-ACK: completes with our own
  // final ACK, moving straight to ESTABLISHED (this side never
  // actually waits in a separate "just sent the final ACK" state --
  // once it's sent, the handshake is done from this side's view).
  // Round 37: the peer answered, so whatever SYN retransmission timer
  // active_open armed is no longer needed -- cancel it.
  if (state == tcp_state_syn_sent()) && (has_syn == 1) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let new_local_seq: u32 = tcp_conn_get_local_seq(conn_id) + (1 as u32); // our own SYN consumed one
    let _ = tcp_conn_set_local_seq(conn_id, new_local_seq);
    let _ = tcp_conn_set_state(conn_id, tcp_state_established());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), new_local_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Round 37: simultaneous open -- both sides issue active_open at
  // roughly the same time, so this side is still in SYN_SENT when the
  // peer's own bare SYN (no ACK -- it hasn't seen OUR SYN yet either)
  // arrives instead of a SYN-ACK. Real, spec-legitimate TCP behavior
  // (RFC 793), not a shortcut: answer with SYN+ACK (acknowledging the
  // peer's SYN) and move to SYN_RCVD -- the EXACT state passive_open's
  // own first-SYN branch above already produces, so the existing
  // "Passive-open side receiving the final ACK" branch below already
  // knows how to complete this side's handshake with no further
  // changes needed. Our own local_seq is left exactly as active_open
  // already set it -- our SYN was already sent at that value; nothing
  // here re-sends or re-picks it, matching passive_open's own
  // "server_isn set once" pattern.
  if (state == tcp_state_syn_sent()) && (has_syn == 1) && (has_ack == 0) {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32); // peer answered
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_syn_rcvd());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_syn() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return 0;
  }

  // Passive-open side receiving the final ACK of the handshake.
  if (state == tcp_state_syn_rcvd()) && (has_ack == 1) && (seg_ack == (tcp_conn_get_local_seq(conn_id) + (1 as u32))) {
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32));
    let _ = tcp_conn_set_state(conn_id, tcp_state_established());
    return 0;
  }

  // Established, a data segment arrives in order: copy the payload
  // out, advance what we expect next, and acknowledge it.
  //
  // BUG (found via audit, 2026-08-27, same shape and same "never
  // actually triggered yet" caveat as socket_udp_recv's identical
  // fix -- see that function's own comment for the full reasoning):
  // payload_len came entirely from the segment's OWN self-reported
  // IPv4 total-length field, untrusted data carried inside the frame
  // being parsed, never checked against recv_len (what netif actually
  // received) or against out_payload's real capacity. A malformed or
  // hostile segment on any real link could drive the copy loop to
  // read past frame's real bounds and write past out_payload's real
  // allocation. Same three-fold guard as socket_udp_recv: reject
  // (don't truncate) a negative length, a declared extent past
  // recv_len, or a payload bigger than the caller's own buffer
  // (max_payload_len, now a required parameter for the same reason).
  // data_offset also gets a sanity floor -- a value under 20 bytes
  // isn't a valid TCP header at all (this stack never sends or
  // expects options, so it should always read exactly 20, but a
  // malformed segment could claim otherwise) and would otherwise let
  // the "payload" start being read from inside the header itself.
  if (state == tcp_state_established()) && (has_psh == 1) && (seg_seq == tcp_conn_get_remote_seq(conn_id)) {
    let tcp_len: i64 = ipv4_get_total_len(frame, 14) as i64 - 20;
    let data_offset: i64 = tcp_get_data_offset_bytes(frame, 34);
    let payload_len: i64 = tcp_len - data_offset;
    if data_offset < 20 {
      return 0 - 1;
    }
    if payload_len < 0 {
      return 0 - 1;
    }
    if (34 + data_offset + payload_len) > recv_len {
      return 0 - 1;
    }
    if payload_len > max_payload_len {
      return 0 - 1;
    }
    let i: i64 = 0;
    while i < payload_len {
      let b: u32 = buf_read_byte(frame, (34 + data_offset + i) as u32);
      let _ = buf_write_byte(out_payload, i as u32, b);
      i = i + 1;
    }
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (payload_len as u32));
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    return payload_len;
  }

  // Established, a pure ACK for data we sent. Round 37: if a data
  // retransmission is pending (rtx_deadline != 0) and this ACK covers
  // it (seg_ack has advanced at least to the byte past the pending
  // segment's own last byte), the peer got it -- cancel the timer.
  // rtx_len==0 would mean no data is pending (only a SYN could be,
  // and a SYN's own retransmission is cancelled by the two branches
  // above instead, never here), so this check is naturally a no-op in
  // that case without needing a separate guard.
  if (state == tcp_state_established()) && (has_ack == 1) && (has_fin == 0) && (has_psh == 0) && (has_syn == 0) {
    if tcp_conn_get_rtx_deadline(conn_id) != (0 as u32) {
      let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
      let rtx_len: u32 = tcp_conn_get_rtx_len(conn_id);
      if seg_ack >= (rtx_seq + rtx_len) {
        let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
      }
    }
    return 0;
  }

  // Established, the peer starts closing: this side has nothing more
  // to send either, so it piggybacks its own FIN onto the ACK
  // (a real, legitimate simplified-close shape, not a shortcut this
  // implementation invented) and moves to FIN_WAIT for the final ACK.
  if (state == tcp_state_established()) && (has_fin == 1) {
    let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32)); // FIN consumes one seq number
    let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait());
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack() | tcp_flag_fin(), 65535 as u32, empty_payload, 0);
    let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // our own FIN
    return 0;
  }

  // The initiating closer receiving the peer's response to its own
  // FIN. BUG (found live, via the self-test's own final ACK never
  // showing up in the loopback queue): the peer's response here is
  // the SAME simplified-close shape this side's own ESTABLISHED/FIN
  // branch above produces when IT'S the one responding to a FIN --
  // a single segment carrying BOTH the ACK of this side's FIN AND the
  // peer's own piggybacked closing FIN, not just a bare ACK. The
  // first version of this branch checked only has_ack and moved
  // straight to CLOSED_FINAL, silently never acknowledging the peer's
  // own FIN bit riding along in that same segment -- the peer was
  // then left waiting forever in FIN_WAIT for an ACK that this side
  // never sends. Fixed: if the peer's FIN bit is ALSO set here, send
  // that ACK before considering the connection closed.
  if (state == tcp_state_fin_wait()) && (has_ack == 1) {
    if has_fin == 1 {
      let _ = tcp_conn_set_remote_seq(conn_id, seg_seq + (1 as u32));
      let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
      let _ = tcp_send_segment(my_mac, dst_mac, local_ip, tcp_conn_get_remote_ip(conn_id), local_port, tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_ack(), 65535 as u32, empty_payload, 0);
    }
    let _ = tcp_conn_set_state(conn_id, tcp_state_closed_final());
    return 0;
  }

  return 0 - 1;
}

// Sends one data segment on an ESTABLISHED connection. local_seq
// advances immediately rather than waiting for the peer's ACK to
// confirm it (this project's own segments are never split/coalesced,
// so there's no window/buffering complexity that choice would
// otherwise create). Round 37: also buffers the segment (its starting
// seq + payload bytes) into this connection's own retransmit slot and
// arms the retransmit timer -- tcp_conn_check_retransmit resends it
// if tcp_conn_handle_segment's own "pure ACK" branch never cancels the
// timer in time. payload_len is capped at 64 bytes, tcp_conn_rtx_buf's
// real per-connection capacity (tcp_state.S) -- every real payload
// this project ever sends (tcpecho's own text, capped at 64 bytes by
// the shell command itself) already fits comfortably under that.
fn tcp_conn_send_data(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64, payload: mut ref i64, payload_len: i64) -> i64 {
  if (payload_len < 0) || (payload_len > (64 as i64)) {
    return 0 - 1;
  }
  let seq_before: u32 = tcp_conn_get_local_seq(conn_id);
  let status: i64 = tcp_send_segment(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), seq_before, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, payload, payload_len);
  let _ = tcp_conn_set_local_seq(conn_id, seq_before + (payload_len as u32));
  if status == 0 {
    let rtx_buf: mut ref i64 = tcp_conn_get_rtx_buf(conn_id);
    let i: i64 = 0;
    while i < payload_len {
      let b: u32 = buf_read_byte(payload, i as u32);
      let _ = buf_write_byte(rtx_buf, i as u32, b);
      i = i + 1;
    }
    let _ = tcp_conn_set_rtx_seq(conn_id, seq_before);
    let _ = tcp_conn_set_rtx_len(conn_id, payload_len as u32);
    let _ = tcp_conn_set_rtx_count(conn_id, 0 as u32);
    let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  }
  return status;
}

// Starts closing an ESTABLISHED connection from this side: sends FIN,
// moves to FIN_WAIT. Teardown completes once the caller feeds the
// peer's own FIN+ACK (or separate FIN) back into
// tcp_conn_handle_segment and it in turn produces the final ACK this
// side is waiting for.
fn tcp_conn_close(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64) -> i64 {
  let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
  let status: i64 = tcp_send_segment(my_mac, dst_mac, tcp_conn_get_local_ip(conn_id), tcp_conn_get_remote_ip(conn_id), tcp_conn_get_local_port(conn_id), tcp_conn_get_remote_port(conn_id), tcp_conn_get_local_seq(conn_id), tcp_conn_get_remote_seq(conn_id), tcp_flag_fin() | tcp_flag_ack(), 65535 as u32, empty_payload, 0);
  let _ = tcp_conn_set_local_seq(conn_id, tcp_conn_get_local_seq(conn_id) + (1 as u32)); // FIN consumes one
  let _ = tcp_conn_set_state(conn_id, tcp_state_fin_wait());
  return status;
}

// Round 37: fires whenever a connection's own pending retransmission
// (armed by active_open for a SYN, or send_data for a data segment)
// is actually due -- called from tcp_conn_poll on EVERY poll, for
// BOTH connection slots, regardless of whether a frame was even
// dequeued this call. That "regardless" is the whole point: a LOST
// segment produces no frame at all, so nothing else could ever notice
// the silence and react to it. Returns 0 if nothing was due (including
// "nothing pending" -- the common case), 1 if a retransmission was
// just sent, -1 if this connection just gave up (exceeded
// tcp_rtx_max_retries) -- a SYN give-up resets the connection to
// CLOSED (stuck forever in SYN_SENT otherwise); a data give-up leaves
// the connection's own state alone, since ESTABLISHED is still
// otherwise valid and the caller's own bounded poll loop (see
// tcpecho's own shell command) will simply time out waiting for data
// that never arrives, exactly the honest observable outcome for a
// send that truly never got through.
fn tcp_conn_check_retransmit(conn_id: u32, my_mac: mut ref i64, dst_mac: mut ref i64) -> i64 {
  let deadline: u32 = tcp_conn_get_rtx_deadline(conn_id);
  if deadline == (0 as u32) {
    return 0;
  }
  if scheduler_get_tick_count() < deadline {
    return 0;
  }
  let count: u32 = tcp_conn_get_rtx_count(conn_id);
  if count >= tcp_rtx_max_retries() {
    let _ = tcp_conn_set_rtx_deadline(conn_id, 0 as u32);
    if tcp_conn_get_state(conn_id) == tcp_state_syn_sent() {
      let _ = tcp_conn_set_state(conn_id, tcp_state_closed());
    }
    return 0 - 1;
  }

  let local_ip: u32 = tcp_conn_get_local_ip(conn_id);
  let local_port: u32 = tcp_conn_get_local_port(conn_id);
  let remote_ip: u32 = tcp_conn_get_remote_ip(conn_id);
  let remote_port: u32 = tcp_conn_get_remote_port(conn_id);
  let rtx_seq: u32 = tcp_conn_get_rtx_seq(conn_id);
  let rtx_len: i64 = tcp_conn_get_rtx_len(conn_id) as i64;
  if rtx_len == 0 {
    // Bare-SYN retransmission -- active_open's own SYN never got a
    // reply.
    let empty_payload: mut ref i64 = tcp_empty_payload_scratch_get();
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, 0 as u32, tcp_flag_syn(), 65535 as u32, empty_payload, 0);
  } else {
    // Data-segment retransmission -- send_data's own segment never
    // got acked. Uses the CURRENT remote_seq for the ack field (this
    // side's own view of what it expects next hasn't changed just
    // because a retransmit is happening), same as every other
    // outgoing segment this project builds.
    let rtx_buf: mut ref i64 = tcp_conn_get_rtx_buf(conn_id);
    let _ = tcp_send_segment(my_mac, dst_mac, local_ip, remote_ip, local_port, remote_port, rtx_seq, tcp_conn_get_remote_seq(conn_id), tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, rtx_buf, rtx_len);
  }
  let _ = tcp_conn_set_rtx_count(conn_id, count + (1 as u32));
  let _ = tcp_conn_set_rtx_deadline(conn_id, scheduler_get_tick_count() + tcp_rtx_timeout_ticks());
  return 1;
}

// Round 29 (2026-08-24): the live counterpart to tcp_conn_self_test's
// own hand-driven "traffic cop" role. tcp_conn_active_open/
// passive_open/handle_segment/send_data/close have all existed since
// this whole section was written, fully correct and self-tested, but
// -- like ARP resolve before round 26, and DHCP before round 27 --
// never had a single live caller anywhere in this codebase. This is
// the general-purpose piece that makes one possible: dequeues the
// next queued frame and, if it's TCP addressed to either of this
// project's two connection slots (0=client, 1=server -- the same
// fixed pair tcp_conn_self_test already uses), routes it to
// tcp_conn_handle_segment for that connection instead of the
// self-test's own hardcoded "I already know which frame this is"
// sequencing.
//
// Also the live echo-service responder: if the SERVER connection
// (slot 1) just received real data (a positive return from
// handle_segment, not the 0 every control-only segment produces),
// echoes it straight back via tcp_conn_send_data -- the same "answer
// automatically, no caller involvement" shape icmp_poll's own
// auto-responder already established for ping. Returns -2 for that
// case (matching icmp_poll's own "handled a request, not a reply for
// you" convention), -1 for anything not addressed to either
// connection, and otherwise whatever tcp_conn_handle_segment itself
// returned (>=0 on the client side is a genuine received payload --
// the echoed data coming back, from this round's own only live
// caller's point of view).
//
// Same shared-netif-queue concurrency note task_e's own comment
// already makes for DHCP vs. the shell's ping command: the shell's
// new `tcpecho` command below drives several rounds of this poll
// function back to back, entirely synchronously within one
// shell_dispatch() call -- but nothing stops task_e's own periodic
// dhcp_client_poll from being scheduled in between two of those polls
// and dequeuing a TCP frame tcpecho was actually waiting for. A third
// instance of the same already-accepted, not-yet-solved tradeoff,
// not a new one.
fn tcp_conn_poll(my_mac: mut ref i64, out_payload: mut ref i64, max_payload_len: i64) -> i64 {
  // Round 37: checked on every call, for both connection slots,
  // regardless of whether a frame is even queued below -- a lost
  // segment produces no frame at all, so this is the only thing that
  // can ever notice and react to it.
  let _ = tcp_conn_check_retransmit(0 as u32, my_mac, my_mac);
  let _ = tcp_conn_check_retransmit(1 as u32, my_mac, my_mac);

  let frame: mut ref i64 = net_recv_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0 - 1;
  }
  if ipv4_get_protocol(frame, 14) != (6 as u32) {
    return 0 - 1;
  }
  let dst_port: u32 = tcp_get_dst_port(frame, 34);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let target_conn: u32 = client_id;
  let matched: i64 = 0;
  if dst_port == tcp_conn_get_local_port(client_id) {
    target_conn = client_id;
    matched = 1;
  }
  if dst_port == tcp_conn_get_local_port(server_id) {
    target_conn = server_id;
    matched = 1;
  }
  if matched == 0 {
    return 0 - 1;
  }
  let result: i64 = tcp_conn_handle_segment(target_conn, frame, frame_len, my_mac, my_mac, out_payload, max_payload_len);
  if (target_conn == server_id) && (result > 0) {
    let _ = tcp_conn_send_data(server_id, my_mac, my_mac, out_payload, result);
    return 0 - 2;
  }
  return result;
}

// Boot-time self-test: a complete, real connection lifecycle --
// three-way handshake, one data transfer each direction... actually
// one direction (client-to-server) is enough to prove the data path
// end to end -- and a full close, driven entirely by this function
// acting as traffic cop between connection slot 0 (client/active
// open) and slot 1 (server/passive open), exactly as this section's
// own header comment describes.
fn tcp_conn_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let client_id: u32 = 0 as u32;
  let server_id: u32 = 1 as u32;
  let client_ip: u32 = 0xC0A80101 as u32;
  let server_ip: u32 = 0xC0A80102 as u32;
  let client_port: u32 = 54321 as u32;
  let server_port: u32 = 7 as u32;

  let _ = tcp_conn_passive_open(server_id, server_ip, server_port);
  let _ = tcp_conn_active_open(client_id, my_mac, my_mac, client_ip, server_ip, client_port, server_port, 1000 as u32);

  // Handshake: client's SYN -> server; server's SYN-ACK -> client;
  // client's final ACK -> server.
  let scratch: mut ref i64 = dhruva_alloc_bytes(512);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = netif_recv_frame(f1, 64); // client's SYN
  let s1: i64 = tcp_conn_handle_segment(server_id, f1, l1, my_mac, my_mac, scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }

  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = netif_recv_frame(f2, 64); // server's SYN-ACK
  let s2: i64 = tcp_conn_handle_segment(client_id, f2, l2, my_mac, my_mac, scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }

  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = netif_recv_frame(f3, 64); // client's final ACK
  let s3: i64 = tcp_conn_handle_segment(server_id, f3, l3, my_mac, my_mac, scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }

  if tcp_conn_get_state(client_id) != tcp_state_established() { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_established() { ok = 0; }

  // Data transfer: client sends "hi", server receives + ACKs it.
  let payload: mut ref i64 = dhruva_alloc_bytes(2);
  let _ = buf_write_byte(payload, 0 as u32, 104 as u32); // 'h'
  let _ = buf_write_byte(payload, 1 as u32, 105 as u32); // 'i'
  let send_status: i64 = tcp_conn_send_data(client_id, my_mac, my_mac, payload, 2);
  if send_status != 0 { ok = 0; }

  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = netif_recv_frame(f4, 64); // client's data segment
  let recv_payload: mut ref i64 = dhruva_alloc_bytes(2);
  let recv_len: i64 = tcp_conn_handle_segment(server_id, f4, l4, my_mac, my_mac, recv_payload, 2);
  if (l4 <= 0) || (recv_len != 2) { ok = 0; }
  if (buf_read_byte(recv_payload, 0 as u32) != (104 as u32)) || (buf_read_byte(recv_payload, 1 as u32) != (105 as u32)) {
    ok = 0;
  }

  let f5: mut ref i64 = dhruva_alloc_bytes(64);
  let l5: i64 = netif_recv_frame(f5, 64); // server's ACK of the data
  let s5: i64 = tcp_conn_handle_segment(client_id, f5, l5, my_mac, my_mac, scratch, 512);
  if (l5 <= 0) || (s5 != 0) { ok = 0; }

  // Close: client sends FIN+ACK; server piggybacks its own FIN onto
  // the ACK; client sends the final ACK.
  let close_status: i64 = tcp_conn_close(client_id, my_mac, my_mac);
  if close_status != 0 { ok = 0; }

  let f6: mut ref i64 = dhruva_alloc_bytes(64);
  let l6: i64 = netif_recv_frame(f6, 64); // client's FIN+ACK
  let s6: i64 = tcp_conn_handle_segment(server_id, f6, l6, my_mac, my_mac, scratch, 512);
  if (l6 <= 0) || (s6 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_fin_wait() { ok = 0; }

  let f7: mut ref i64 = dhruva_alloc_bytes(64);
  let l7: i64 = netif_recv_frame(f7, 64); // server's FIN+ACK (piggybacked)
  let s7: i64 = tcp_conn_handle_segment(client_id, f7, l7, my_mac, my_mac, scratch, 512);
  if (l7 <= 0) || (s7 != 0) { ok = 0; }
  if tcp_conn_get_state(client_id) != tcp_state_closed_final() { ok = 0; }

  let f8: mut ref i64 = dhruva_alloc_bytes(64);
  let l8: i64 = netif_recv_frame(f8, 64); // client's final ACK
  let s8: i64 = tcp_conn_handle_segment(server_id, f8, l8, my_mac, my_mac, scratch, 512);
  if (l8 <= 0) || (s8 != 0) { ok = 0; }
  if tcp_conn_get_state(server_id) != tcp_state_closed_final() { ok = 0; }

  let _ = uart_puts("TCP: connection lifecycle (handshake + data + close)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for the length-validation fix found by audit
// (2026-08-27, see tcp_conn_handle_segment's own comment): a TCP data
// segment whose IPv4 header claims a length far beyond what was
// actually received must be rejected, not trusted as a copy-loop
// bound. Drives connection slot 0 directly into ESTABLISHED (a
// white-box setup, not a real handshake -- this test targets the
// data-segment length check specifically) and hands it a real, small,
// correctly-queued segment whose IP total-length field has been
// corrupted to claim far more data than that.
fn tcp_conn_recv_bounds_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_id: u32 = 0 as u32;
  let local_ip: u32 = 0xC0A80101 as u32;
  let remote_ip: u32 = 0xC0A80102 as u32;
  let start_seq: u32 = 9000 as u32;

  let _ = tcp_conn_set_local_ip(conn_id, local_ip);
  let _ = tcp_conn_set_remote_ip(conn_id, remote_ip);
  let _ = tcp_conn_set_local_port(conn_id, 7 as u32);
  let _ = tcp_conn_set_remote_port(conn_id, 54321 as u32);
  let _ = tcp_conn_set_local_seq(conn_id, 1 as u32);
  let _ = tcp_conn_set_remote_seq(conn_id, start_seq);
  let _ = tcp_conn_set_state(conn_id, tcp_state_established());

  let frame: mut ref i64 = dhruva_alloc_bytes(64);
  let payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(payload, 0 as u32, 66 as u32);
  let real_tcp_len: i64 = tcp_build_header(frame, 34, 54321 as u32, 7 as u32, start_seq, 1 as u32, tcp_flag_psh() | tcp_flag_ack(), 65535 as u32, payload, 1, remote_ip, local_ip);
  let real_total_len: i64 = 20 + real_tcp_len;
  let _ = ipv4_build_header(frame, 14, real_total_len, 6 as u32, remote_ip, local_ip);
  let real_frame_len: i64 = 14 + real_total_len; // 14+20+21 = 55 bytes, actually queued

  // Corrupt ONLY the IPv4 header's own total-length field (the field
  // tcp_conn_handle_segment's payload_len calculation actually reads)
  // to claim far more data than was really sent.
  let _ = buf_write_u16_be(frame, 14 + 2, 60000 as u32);

  let scratch: mut ref i64 = dhruva_alloc_bytes(4);
  let status: i64 = tcp_conn_handle_segment(conn_id, frame, real_frame_len, my_mac, my_mac, scratch, 4);
  if status != (0 - 1) {
    ok = 0;
  }
  // The malformed segment must not have been treated as accepted --
  // remote_seq should be untouched (still start_seq, not advanced).
  if tcp_conn_get_remote_seq(conn_id) != start_seq {
    ok = 0;
  }

  let _ = uart_puts("TCP: handle_segment rejects a length field past what was actually received");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 37: simultaneous open (RFC 793) -- both sides call
// active_open (neither is a passive_open listener), so both start out
// in SYN_SENT and each receives the OTHER's bare SYN instead of a
// SYN-ACK. Real, spec-legitimate TCP behavior, not a shortcut this
// implementation invented -- see tcp_conn_handle_segment's own new
// SYN_SENT+bare-SYN branch. Drives this the same "traffic cop" way
// tcp_conn_self_test already does: dequeue each side's own segment
// via netif_recv_frame, hand it directly to the OTHER side's
// handle_segment, and confirm the whole 4-segment exchange (two bare
// SYNs, two SYN+ACKs) still reaches ESTABLISHED on both sides purely
// through the EXISTING SYN_RCVD-handling machinery plus the one new
// branch -- no other state-machine code needed changing for this.
// Also confirms both sides' SYN retransmission timers (armed by
// active_open) end up cancelled once the peer actually answers,
// rather than still ticking down toward a spurious retransmit.
fn tcp_conn_simultaneous_open_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let conn_a: u32 = 0 as u32;
  let conn_b: u32 = 1 as u32;
  let ip_a: u32 = 0xC0A80103 as u32;
  let ip_b: u32 = 0xC0A80104 as u32;
  let port_a: u32 = 54322 as u32;
  let port_b: u32 = 8 as u32;

  let _ = tcp_conn_active_open(conn_a, my_mac, my_mac, ip_a, ip_b, port_a, port_b, 2000 as u32);
  let _ = tcp_conn_active_open(conn_b, my_mac, my_mac, ip_b, ip_a, port_b, port_a, 9000 as u32);

  if tcp_conn_get_rtx_deadline(conn_a) == (0 as u32) { ok = 0; } // SYN rtx armed
  if tcp_conn_get_rtx_deadline(conn_b) == (0 as u32) { ok = 0; }

  let scratch: mut ref i64 = dhruva_alloc_bytes(512);
  let f1: mut ref i64 = dhruva_alloc_bytes(64);
  let l1: i64 = netif_recv_frame(f1, 64); // a's bare SYN
  let s1: i64 = tcp_conn_handle_segment(conn_b, f1, l1, my_mac, my_mac, scratch, 512);
  if (l1 <= 0) || (s1 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_syn_rcvd() { ok = 0; }

  let f2: mut ref i64 = dhruva_alloc_bytes(64);
  let l2: i64 = netif_recv_frame(f2, 64); // b's bare SYN
  let s2: i64 = tcp_conn_handle_segment(conn_a, f2, l2, my_mac, my_mac, scratch, 512);
  if (l2 <= 0) || (s2 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_syn_rcvd() { ok = 0; }

  // Both bare SYNs answered -- neither side should still be waiting to
  // retransmit its own original SYN.
  if tcp_conn_get_rtx_deadline(conn_a) != (0 as u32) { ok = 0; }
  if tcp_conn_get_rtx_deadline(conn_b) != (0 as u32) { ok = 0; }

  let f3: mut ref i64 = dhruva_alloc_bytes(64);
  let l3: i64 = netif_recv_frame(f3, 64); // b's SYN+ACK (answering a's SYN)
  let s3: i64 = tcp_conn_handle_segment(conn_a, f3, l3, my_mac, my_mac, scratch, 512);
  if (l3 <= 0) || (s3 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_a) != tcp_state_established() { ok = 0; }

  let f4: mut ref i64 = dhruva_alloc_bytes(64);
  let l4: i64 = netif_recv_frame(f4, 64); // a's SYN+ACK (answering b's SYN)
  let s4: i64 = tcp_conn_handle_segment(conn_b, f4, l4, my_mac, my_mac, scratch, 512);
  if (l4 <= 0) || (s4 != 0) { ok = 0; }
  if tcp_conn_get_state(conn_b) != tcp_state_established() { ok = 0; }

  let _ = uart_puts("TCP: simultaneous open (both sides active_open) reaches ESTABLISHED");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: DHCP (RFC 2131), a minimal client -- DISCOVER ->
// OFFER -> REQUEST -> ACK, sitting on socket_udp_send/udp_send exactly
// like TCP sits on ipv4_build_header, no new transport of its own.
// Only the client side exists (no server): this stack has no need to
// hand out addresses to anyone.
//
// Message layout (RFC 2131 s2, offsets relative to dhcp_offset, the
// start of the UDP payload):
//   0 op(1, 1=BOOTREQUEST/2=BOOTREPLY)  1 htype(1)  2 hlen(1)  3 hops(1)
//   4-7 xid(4)  8-9 secs(2)  10-11 flags(2, 0x8000=broadcast)
//   12-15 ciaddr(4)  16-19 yiaddr(4)  20-23 siaddr(4)  24-27 giaddr(4)
//   28-43 chaddr(16, only the first 6 bytes -- an Ethernet MAC -- ever
//         used here)  44-107 sname(64, unused)  108-235 file(128, unused)
//   236-239 magic cookie (99.130.83.99, fixed)
//   240+ options: TLV (code(1) len(1) data(len)), 0=Pad (no length
//         byte), 255=End. This client only ever sends/reads option 53
//         (DHCP Message Type, 1 byte), 50 (Requested IP Address, 4
//         bytes), and 54 (Server Identifier, 4 bytes) -- the minimum
//         RFC 2131 s4.3.2 requires for the SELECTING->REQUESTING step.
//
// Client ports are fixed by the protocol, not negotiated: 68 (client)
// and 67 (server). DISCOVER/REQUEST always go out from 0.0.0.0 (no
// address yet) to 255.255.255.255 at the Ethernet broadcast address
// (the server's real MAC isn't known until an OFFER names an IP, and
// this client has no ARP-before-we-have-an-IP path anyway) -- exactly
// what RFC 2131 requires before an address is bound, not a loopback-
// only shortcut.
fn dhcp_op_bootrequest() -> u32 { return 1 as u32; }
fn dhcp_op_bootreply() -> u32 { return 2 as u32; }
fn dhcp_htype_ethernet() -> u32 { return 1 as u32; }
fn dhcp_hlen_ethernet() -> u32 { return 6 as u32; }
fn dhcp_msgtype_discover() -> u32 { return 1 as u32; }
fn dhcp_msgtype_offer() -> u32 { return 2 as u32; }
fn dhcp_msgtype_request() -> u32 { return 3 as u32; }
fn dhcp_msgtype_ack() -> u32 { return 5 as u32; }
fn dhcp_msgtype_nak() -> u32 { return 6 as u32; }
fn dhcp_state_init() -> u32 { return 0 as u32; }
fn dhcp_state_selecting() -> u32 { return 1 as u32; }
fn dhcp_state_requesting() -> u32 { return 2 as u32; }
fn dhcp_state_bound() -> u32 { return 3 as u32; }
// Round 22 (2026-08-28): RFC 2131 s4.4's lease lifecycle, past BOUND
// -- RENEWING (unicasting to the original server after T1) and
// REBINDING (broadcasting after T2 if the server never answered the
// unicast attempt). See dhcp_client_check_lease's own comment for
// the full state machine.
fn dhcp_state_renewing() -> u32 { return 4 as u32; }
fn dhcp_state_rebinding() -> u32 { return 5 as u32; }
fn dhcp_client_port() -> u32 { return 68 as u32; }
fn dhcp_server_port() -> u32 { return 67 as u32; }

// Zero-fills buf[offset..offset+count) -- vani has no memset builtin
// (every buffer-clearing loop in this project writes byte by byte;
// see e.g. fs_compact's own copy loops), needed here for chaddr's
// padding and the sname/file fields every message carries but this
// client never uses.
fn dhcp_zero_range(buf: mut ref i64, offset: i64, count: i64) -> i64 {
  let i: i64 = 0;
  while i < count {
    let _ = buf_write_byte(buf, (offset + i) as u32, 0 as u32);
    i = i + 1;
  }
  return 0;
}

// Writes the 240-byte fixed BOOTP header + magic cookie every DHCP
// message shares, at buf[dhcp_offset..). Shared by both the client's
// own DISCOVER/REQUEST builders (op=BOOTREQUEST, yiaddr/siaddr=0) and
// the self-test's synthetic OFFER/ACK builders (op=BOOTREPLY,
// yiaddr/siaddr set) -- one function, not duplicated per message type,
// since the only real difference between them is which fields are
// zero. Returns 240, the offset where type-specific options begin.
fn dhcp_build_fixed_header(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, op: u32, ciaddr: u32, yiaddr: u32, siaddr: u32) -> i64 {
  let _ = buf_write_byte(buf, dhcp_offset as u32, op);
  let _ = buf_write_byte(buf, (dhcp_offset + 1) as u32, dhcp_htype_ethernet());
  let _ = buf_write_byte(buf, (dhcp_offset + 2) as u32, dhcp_hlen_ethernet());
  let _ = buf_write_byte(buf, (dhcp_offset + 3) as u32, 0 as u32); // hops
  let _ = buf_write_u32_be(buf, dhcp_offset + 4, xid);
  let _ = buf_write_u16_be(buf, dhcp_offset + 8, 0 as u32); // secs
  let _ = buf_write_u16_be(buf, dhcp_offset + 10, 0x8000 as u32); // flags: broadcast
  let _ = buf_write_u32_be(buf, dhcp_offset + 12, ciaddr);
  let _ = buf_write_u32_be(buf, dhcp_offset + 16, yiaddr);
  let _ = buf_write_u32_be(buf, dhcp_offset + 20, siaddr);
  let _ = buf_write_u32_be(buf, dhcp_offset + 24, 0 as u32); // giaddr: no relay agent
  let i: i64 = 0;
  while i < 6 {
    let mb: u32 = buf_read_byte(mac, i as u32);
    let _ = buf_write_byte(buf, (dhcp_offset + 28 + i) as u32, mb);
    i = i + 1;
  }
  let _ = dhcp_zero_range(buf, dhcp_offset + 34, 10); // chaddr padding (16 - 6)
  let _ = dhcp_zero_range(buf, dhcp_offset + 44, 64); // sname
  let _ = dhcp_zero_range(buf, dhcp_offset + 108, 128); // file
  let _ = buf_write_byte(buf, (dhcp_offset + 236) as u32, 99 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 237) as u32, 130 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 238) as u32, 83 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 239) as u32, 99 as u32);
  return 240;
}

fn dhcp_build_discover(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32) -> i64 {
  let _ = dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, dhcp_op_bootrequest(), 0 as u32, 0 as u32, 0 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 240) as u32, 53 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 241) as u32, 1 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 242) as u32, dhcp_msgtype_discover());
  let _ = buf_write_byte(buf, (dhcp_offset + 243) as u32, 255 as u32); // End
  return 244;
}

// RFC 2131 s4.3.2: the REQUEST following an OFFER echoes the offered
// address back via option 50 and names which server it's accepting
// via option 54 -- required so every OTHER server that also offered
// (this client only ever sees one, but a real network can have many)
// knows this client picked someone else and its own offer expired.
fn dhcp_build_request(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, requested_ip: u32, server_ip: u32) -> i64 {
  let _ = dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, dhcp_op_bootrequest(), 0 as u32, 0 as u32, 0 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 240) as u32, 53 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 241) as u32, 1 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 242) as u32, dhcp_msgtype_request());
  let _ = buf_write_byte(buf, (dhcp_offset + 243) as u32, 50 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 244) as u32, 4 as u32);
  let _ = buf_write_u32_be(buf, dhcp_offset + 245, requested_ip);
  let _ = buf_write_byte(buf, (dhcp_offset + 249) as u32, 54 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 250) as u32, 4 as u32);
  let _ = buf_write_u32_be(buf, dhcp_offset + 251, server_ip);
  let _ = buf_write_byte(buf, (dhcp_offset + 255) as u32, 255 as u32); // End
  return 256;
}

// RFC 2131 s4.3.2: the RENEWING/REBINDING REQUEST is a different
// shape from dhcp_build_request's own SELECTING-time broadcast --
// ciaddr is set to the client's own already-leased address (not 0,
// since the client already has an address it's asking to keep), and
// neither option 50 (Requested IP) nor option 54 (Server Identifier)
// are included: ciaddr already conveys the address, and there's no
// "other server" to disambiguate from since this message either goes
// unicast directly to the one server that granted the lease
// (RENEWING) or broadcast with the client fully expecting only its
// own lessor to recognize and renew it (REBINDING). Whether it goes
// out unicast or broadcast is entirely the caller's choice of dst_mac/
// dst_ip -- this builder only knows how to shape the message itself.
fn dhcp_build_renew_request(buf: mut ref i64, dhcp_offset: i64, mac: mut ref i64, xid: u32, ciaddr: u32) -> i64 {
  let _ = dhcp_build_fixed_header(buf, dhcp_offset, mac, xid, dhcp_op_bootrequest(), ciaddr, 0 as u32, 0 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 240) as u32, 53 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 241) as u32, 1 as u32);
  let _ = buf_write_byte(buf, (dhcp_offset + 242) as u32, dhcp_msgtype_request());
  let _ = buf_write_byte(buf, (dhcp_offset + 243) as u32, 255 as u32); // End
  return 244;
}

fn dhcp_get_op(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  return buf_read_byte(buf, dhcp_offset as u32);
}
fn dhcp_get_xid(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  return buf_read_u32_be(buf, dhcp_offset + 4);
}
fn dhcp_get_yiaddr(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  return buf_read_u32_be(buf, dhcp_offset + 16);
}

// Round 22: needed to verify dhcp_build_renew_request's own ciaddr
// field from a self-test -- nothing needed to READ this field before
// this round, since ciaddr was always 0 in every message this client
// built until now.
fn dhcp_get_ciaddr(buf: mut ref i64, dhcp_offset: i64) -> u32 {
  return buf_read_u32_be(buf, dhcp_offset + 12);
}

fn dhcp_verify_magic_cookie(buf: mut ref i64, dhcp_offset: i64) -> i64 {
  let c0: u32 = buf_read_byte(buf, (dhcp_offset + 236) as u32);
  let c1: u32 = buf_read_byte(buf, (dhcp_offset + 237) as u32);
  let c2: u32 = buf_read_byte(buf, (dhcp_offset + 238) as u32);
  let c3: u32 = buf_read_byte(buf, (dhcp_offset + 239) as u32);
  if (c0 == (99 as u32)) && (c1 == (130 as u32)) && (c2 == (83 as u32)) && (c3 == (99 as u32)) {
    return 1;
  }
  return 0;
}

// Scans buf[dhcp_offset+240 .. dhcp_offset+dhcp_len) for `want_code`'s
// single-byte value (option 53, DHCP Message Type). Bounded (max 64
// options), same "capped, not `while true`" posture as every other
// poll/scan loop in this codebase -- a malformed or hostile options
// list with a bad length byte can't spin this forever, and every
// length read is checked against `end` before being trusted as a skip
// distance. Returns -1 if not found, the option is malformed (wrong
// length or truncated), or the scan runs off the end without hitting
// End (255) first.
fn dhcp_find_option_byte(buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> i64 {
  let pos: i64 = dhcp_offset + 240;
  let end: i64 = dhcp_offset + dhcp_len;
  let iter: i64 = 0;
  while (pos < end) && (iter < 64) {
    let code: u32 = buf_read_byte(buf, pos as u32);
    if code == (255 as u32) {
      return 0 - 1;
    }
    if code == (0 as u32) {
      pos = pos + 1;
    } else {
      if (pos + 1) >= end {
        return 0 - 1;
      }
      let opt_len: u32 = buf_read_byte(buf, (pos + 1) as u32);
      if code == want_code {
        if (opt_len != (1 as u32)) || ((pos + 2) >= end) {
          return 0 - 1;
        }
        return buf_read_byte(buf, (pos + 2) as u32) as i64;
      }
      pos = pos + 2 + (opt_len as i64);
    }
    iter = iter + 1;
  }
  return 0 - 1;
}

// Same shape as dhcp_find_option_byte, for a 4-byte option value
// (50=Requested IP, 54=Server Identifier). Returns 0 if not found --
// 0.0.0.0 is never a real address to find here, matching arp_cache's
// own "0 means unused" convention.
fn dhcp_find_option_u32(buf: mut ref i64, dhcp_offset: i64, dhcp_len: i64, want_code: u32) -> u32 {
  let pos: i64 = dhcp_offset + 240;
  let end: i64 = dhcp_offset + dhcp_len;
  let iter: i64 = 0;
  while (pos < end) && (iter < 64) {
    let code: u32 = buf_read_byte(buf, pos as u32);
    if code == (255 as u32) {
      return 0 as u32;
    }
    if code == (0 as u32) {
      pos = pos + 1;
    } else {
      if (pos + 1) >= end {
        return 0 as u32;
      }
      let opt_len: u32 = buf_read_byte(buf, (pos + 1) as u32);
      if code == want_code {
        if (opt_len != (4 as u32)) || ((pos + 2 + 4) > end) {
          return 0 as u32;
        }
        return buf_read_u32_be(buf, pos + 2);
      }
      pos = pos + 2 + (opt_len as i64);
    }
    iter = iter + 1;
  }
  return 0 as u32;
}

fn dhcp_broadcast_mac(out_mac: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 6 {
    let _ = buf_write_byte(out_mac, i as u32, 0xFF as u32);
    i = i + 1;
  }
  return 0;
}

// Starts (or restarts) address acquisition: broadcasts a DHCPDISCOVER
// and moves to SELECTING. xid should differ across separate
// acquisition attempts (RFC 2131 uses it to match replies to the
// request that triggered them) -- this driver has no random-number
// source, so callers supply it (a boot-time tick count, a counter,
// anything that varies run to run is fine; the self-test uses a fixed
// constant since it doesn't need uniqueness across multiple real
// attempts).
fn dhcp_client_start(my_mac: mut ref i64, xid: u32) -> i64 {
  let _ = dhcp_state_set_client_state(dhcp_state_selecting());
  let _ = dhcp_state_set_xid(xid);
  let _ = dhcp_state_set_offered_ip(0 as u32);
  let _ = dhcp_state_set_server_ip(0 as u32);
  // Round 22: a stale lease_time from a prior acquisition cycle must
  // not leak into a fresh DISCOVER attempt and arm a renewal timer
  // for an address this client no longer holds.
  let _ = dhcp_state_set_lease_time(0 as u32);
  let _ = dhcp_state_set_lease_start_tick(0 as u32);

  let payload: mut ref i64 = dhcp_payload_scratch_get();
  let payload_len: i64 = dhcp_build_discover(payload, 0, my_mac, xid);
  let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
  let _ = dhcp_broadcast_mac(bcast_mac);
  let no_ip: u32 = 0 as u32;
  let bcast_ip: u32 = 0xFFFFFFFF as u32;
  return udp_send(my_mac, bcast_mac, no_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
}

// Dequeues and processes the next queued frame if it's a DHCP reply
// relevant to this client's current attempt -- advances SELECTING->
// REQUESTING on a matching OFFER (broadcasting a DHCPREQUEST for the
// offered address) and REQUESTING->BOUND on a matching ACK. Any other
// queued traffic (non-IPv4, non-UDP, wrong port, wrong xid, a
// corrupted checksum, a NAK, an OFFER/ACK arriving in a state that
// doesn't expect one) is dequeued and silently ignored -- the same
// "not every queued frame is mine" tolerance socket_udp_recv already
// has, just with DHCP's own state machine and xid check on top
// (mirroring tcp_conn_handle_segment's own "-1 means this didn't
// match anything this state expects" posture). Returns 1 if a state
// transition happened, 0 if a frame was dequeued but irrelevant, -1
// if nothing was queued.
fn dhcp_client_poll(my_mac: mut ref i64) -> i64 {
  // Round 22: the lease-expiry/renewal timer has to fire on its own
  // schedule regardless of whether a frame happens to be queued right
  // now -- checked first, unconditionally, rather than after the
  // early "nothing queued" return below (which used to skip past
  // everything for the exact case -- no traffic -- this check most
  // needs to run in).
  let lease_transition: i64 = dhcp_client_check_lease(my_mac);
  if lease_transition == 1 {
    return 1;
  }

  let frame: mut ref i64 = dhcp_frame_scratch_get();
  let frame_len: i64 = netif_recv_frame(frame, 512);
  if frame_len < 0 {
    return 0 - 1;
  }
  if buf_read_u16_be(frame, 12) != (0x0800 as u32) {
    return 0;
  }
  if ipv4_get_protocol(frame, 14) != (17 as u32) {
    return 0;
  }
  if udp_get_dst_port(frame, 34) != dhcp_client_port() {
    return 0;
  }
  let udp_len: u32 = udp_get_length(frame, 34);
  let dhcp_len: i64 = (udp_len as i64) - 8;
  // Same "reject, don't guess" bounds posture as socket_udp_recv's own
  // fix: a UDP length claiming more than netif actually delivered, or
  // too short to even hold a DHCP message's fixed header, is dropped
  // outright before anything below trusts it.
  if dhcp_len < 240 {
    return 0;
  }
  if (34 + (udp_len as i64)) > frame_len {
    return 0;
  }
  let src_ip: u32 = ipv4_get_src_ip(frame, 14);
  let dst_ip: u32 = ipv4_get_dst_ip(frame, 14);
  if udp_verify_checksum(src_ip, dst_ip, frame, 34, udp_len as i64) != 1 {
    return 0;
  }
  let dhcp_offset: i64 = 42; // 14 (Ethernet) + 20 (IP) + 8 (UDP)
  if dhcp_verify_magic_cookie(frame, dhcp_offset) != 1 {
    return 0;
  }
  if dhcp_get_op(frame, dhcp_offset) != dhcp_op_bootreply() {
    return 0;
  }
  if dhcp_get_xid(frame, dhcp_offset) != dhcp_state_get_xid() {
    return 0;
  }
  let msg_type: i64 = dhcp_find_option_byte(frame, dhcp_offset, dhcp_len, 53 as u32);
  let client_state: u32 = dhcp_state_get_client_state();

  if (client_state == dhcp_state_selecting()) && (msg_type == (dhcp_msgtype_offer() as i64)) {
    let offered_ip: u32 = dhcp_get_yiaddr(frame, dhcp_offset);
    let server_ip: u32 = dhcp_find_option_u32(frame, dhcp_offset, dhcp_len, 54 as u32);
    if (offered_ip == (0 as u32)) || (server_ip == (0 as u32)) {
      return 0; // malformed offer, missing what's needed to request it
    }
    let _ = dhcp_state_set_offered_ip(offered_ip);
    let _ = dhcp_state_set_server_ip(server_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_requesting());

    let payload: mut ref i64 = dhcp_payload_scratch_get();
    let xid: u32 = dhcp_state_get_xid();
    let payload_len: i64 = dhcp_build_request(payload, 0, my_mac, xid, offered_ip, server_ip);
    let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
    let _ = dhcp_broadcast_mac(bcast_mac);
    let no_ip: u32 = 0 as u32;
    let bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send(my_mac, bcast_mac, no_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    return 1;
  }

  // Round 22: an ACK is expected not just fresh out of REQUESTING but
  // also as the (re)answer to a RENEWING (unicast) or REBINDING
  // (broadcast) lease-renewal attempt -- RFC 2131 s4.4 treats all
  // three the same way, back to BOUND with a refreshed lease.
  let ack_expected: i64 = if (client_state == dhcp_state_requesting()) || (client_state == dhcp_state_renewing()) || (client_state == dhcp_state_rebinding()) { 1 } else { 0 };
  if (ack_expected == 1) && (msg_type == (dhcp_msgtype_ack() as i64)) {
    let leased_ip: u32 = dhcp_get_yiaddr(frame, dhcp_offset);
    if leased_ip == (0 as u32) {
      return 0;
    }
    let _ = dhcp_state_set_leased_ip(leased_ip);
    let _ = dhcp_state_set_client_state(dhcp_state_bound());

    // Round 22: arm (or refresh) the lease-renewal timer from option
    // 51. lease_time staying 0 (the server didn't send option 51) is
    // treated as "no timer armed" -- see dhcp_lease_time's own .bss
    // comment for why that's acceptable rather than a hard error.
    let lease_time: u32 = dhcp_find_option_u32(frame, dhcp_offset, dhcp_len, 51 as u32);
    let _ = dhcp_state_set_lease_time(lease_time);
    let _ = dhcp_state_set_lease_start_tick(scheduler_get_tick_count());

    // Round 22: learn the server's MAC for free from this ACK's own
    // Ethernet source address -- exactly what a real minimal
    // implementation needs to send a later unicast renewal REQUEST
    // without a live ARP round trip (see dhcp_client_check_lease's
    // own comment). Every ACK carries this, not just the very first
    // one, so a RENEWING/REBINDING refresh keeps it current too.
    let server_mac: mut ref i64 = dhcp_server_mac_scratch_get();
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(frame, (6 + mi) as u32);
      let _ = buf_write_byte(server_mac, mi as u32, mb);
      mi = mi + 1;
    }
    let _ = arp_cache_insert(dhcp_state_get_server_ip(), server_mac);

    return 1;
  }

  // BUG (round 10 audit -- a fresh, critical re-read of the DHCP
  // client added last round, specifically requested since it's new,
  // untested-by-a-second-pass code): dhcp_msgtype_nak() was defined
  // but never actually checked anywhere -- a real server can NAK a
  // REQUEST (RFC 2131 s4.3.2: e.g. the offered address became
  // unavailable, or the client's own request was invalid), and this
  // client would have silently ignored it via the catch-all `return 0`
  // below, leaving the state machine stuck in REQUESTING forever with
  // no way to ever reach BOUND again -- a real client MUST handle this
  // per spec, not just the happy-path ACK. Fixed by resetting to INIT
  // (matching RFC 2131 s4.4's guidance to restart the whole process on
  // a NAK) rather than auto-retrying here: this driver has no random-
  // number source and no backoff policy of its own, so -- same
  // "caller decides when" design dhcp_client_start's own xid parameter
  // already uses -- resetting to INIT and leaving it to the caller to
  // call dhcp_client_start again (with a fresh xid) avoids baking in a
  // retry policy this minimal client has no good way to choose itself.
  // Round 22: RFC 2131 s4.4 -- "If the client receives a DHCPNAK
  // message, it cannot reuse its remembered lease and MUST return to
  // INIT," and that applies just as much to a NAK'd RENEWING/
  // REBINDING attempt as to the original REQUESTING one this check
  // already covered.
  let nak_expected: i64 = if (client_state == dhcp_state_requesting()) || (client_state == dhcp_state_renewing()) || (client_state == dhcp_state_rebinding()) { 1 } else { 0 };
  if (nak_expected == 1) && (msg_type == (dhcp_msgtype_nak() as i64)) {
    let _ = dhcp_state_set_client_state(dhcp_state_init());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// RFC 2131 s4.4's lease lifecycle past BOUND, entirely time-driven
// (not frame-driven) -- called unconditionally at the top of every
// dhcp_client_poll, since a lease timeout has nothing to do with
// whether a frame happens to be queued. lease_time == 0 means no
// timer is armed at all (never bound yet this cycle, or the server
// never sent option 51 -- see dhcp_lease_time's own .bss comment).
// All three thresholds (T1, T2, final expiry) are measured as elapsed
// ticks from the SAME lease_start_tick throughout -- per spec, not
// reset at each RENEWING/REBINDING transition. Ticks run at 2/second
// (timer_ic_init's own 500ms compare interval), computed here rather
// than assumed inline so the arithmetic's own units are visible at
// every step: T1 = lease/2, T2 = lease*7/8, both converted from
// seconds to ticks by the same factor.
//
// Deliberately sends at most ONE attempt per threshold (no
// retransmission/backoff while RENEWING) -- matching this client's
// own already-established, deliberate scope everywhere else (neither
// the original DISCOVER nor the original REQUEST retry on their own
// either; a lost renewal attempt is recovered the same way a lost
// DISCOVER always has been, by REBINDING's broadcast fallback or,
// failing that, full re-acquisition from INIT). Returns 1 if a state
// transition happened (matching dhcp_client_poll's own frame-handling
// branches), 0 otherwise.
fn dhcp_client_check_lease(my_mac: mut ref i64) -> i64 {
  let lease_time: u32 = dhcp_state_get_lease_time();
  if lease_time == (0 as u32) {
    return 0;
  }
  let client_state: u32 = dhcp_state_get_client_state();
  if (client_state != dhcp_state_bound()) && (client_state != dhcp_state_renewing()) && (client_state != dhcp_state_rebinding()) {
    return 0;
  }

  let ticks_per_second: i64 = 2;
  let lease_ticks: i64 = (lease_time as i64) * ticks_per_second;
  let t1_ticks: i64 = lease_ticks / 2;
  let t2_ticks: i64 = (lease_ticks * 7) / 8;
  let elapsed_ticks: i64 = (scheduler_get_tick_count() as i64) - (dhcp_state_get_lease_start_tick() as i64);

  if (client_state == dhcp_state_bound()) && (elapsed_ticks >= t1_ticks) {
    // RFC 2131 s4.3.2: renewal is unicast directly to the server that
    // granted the lease. Uses the MAC learned for free from that
    // original ACK's own Ethernet source address (see the ACK-
    // handling branch above) rather than a live ARP round trip --
    // arp_cache_lookup here is a defensive fallback (e.g. an older
    // cache entry evicted by unrelated traffic), not the primary
    // path; a miss here just means this one attempt is skipped, not
    // a hang, since RENEWING's own elapsed-time check above already
    // guarantees forward progress to REBINDING regardless.
    let server_ip: u32 = dhcp_state_get_server_ip();
    let dst_mac: mut ref i64 = dhcp_server_mac_scratch_get();
    if arp_cache_lookup(server_ip, dst_mac) == 1 {
      let payload: mut ref i64 = dhcp_payload_scratch_get();
      let xid: u32 = dhcp_state_get_xid();
      let leased_ip: u32 = dhcp_state_get_leased_ip();
      let payload_len: i64 = dhcp_build_renew_request(payload, 0, my_mac, xid, leased_ip);
      let _ = udp_send(my_mac, dst_mac, leased_ip, server_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    }
    let _ = dhcp_state_set_client_state(dhcp_state_renewing());
    return 1;
  }

  if (client_state == dhcp_state_renewing()) && (elapsed_ticks >= t2_ticks) {
    // RFC 2131 s4.3.2: no answer to the unicast attempt by T2 --
    // broadcast instead, giving ANY server that recognizes this
    // client's lease a chance to renew it, not just the original one.
    let payload: mut ref i64 = dhcp_payload_scratch_get();
    let xid: u32 = dhcp_state_get_xid();
    let leased_ip: u32 = dhcp_state_get_leased_ip();
    let payload_len: i64 = dhcp_build_renew_request(payload, 0, my_mac, xid, leased_ip);
    let bcast_mac: mut ref i64 = dhcp_bcast_mac_scratch_get();
    let _ = dhcp_broadcast_mac(bcast_mac);
    let bcast_ip: u32 = 0xFFFFFFFF as u32;
    let _ = udp_send(my_mac, bcast_mac, leased_ip, bcast_ip, dhcp_client_port(), dhcp_server_port(), payload, payload_len);
    let _ = dhcp_state_set_client_state(dhcp_state_rebinding());
    return 1;
  }

  if (client_state == dhcp_state_rebinding()) && (elapsed_ticks >= lease_ticks) {
    // RFC 2131 s4.4: the lease has genuinely expired with no response
    // at all -- give up the address and restart from scratch, same
    // reset shape as a NAK.
    let _ = dhcp_state_set_client_state(dhcp_state_init());
    let _ = dhcp_state_set_offered_ip(0 as u32);
    let _ = dhcp_state_set_server_ip(0 as u32);
    let _ = dhcp_state_set_leased_ip(0 as u32);
    let _ = dhcp_state_set_lease_time(0 as u32);
    return 1;
  }

  return 0;
}

// Boot-time self-test: no real DHCP server exists in this loopback-
// only environment (same reasoning ARP/TCP's own self-tests already
// establish), so this drives the client through a full DISCOVER ->
// OFFER -> REQUEST -> ACK -> BOUND cycle by manually building the
// server's two replies exactly as a real server would and queuing
// them via the real netif -- proving the client's own state machine
// end to end without needing a real second host.
fn dhcp_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x12345678 as u32;
  let offered_ip: u32 = 0xC0A80164 as u32; // 192.168.1.100
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  let start_status: i64 = dhcp_client_start(my_mac, xid);
  if start_status != 0 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_selecting() { ok = 0; }

  // Drain the client's own broadcast DISCOVER off the loopback queue
  // and sanity-check it before injecting the synthetic OFFER below.
  let discover_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let discover_len: i64 = netif_recv_frame(discover_frame, 512);
  if discover_len < 240 { ok = 0; }
  if dhcp_get_op(discover_frame, 42) != dhcp_op_bootrequest() { ok = 0; }
  if dhcp_find_option_byte(discover_frame, 42, discover_len - 42, 53 as u32) != (dhcp_msgtype_discover() as i64) { ok = 0; }

  // Build the synthetic DHCPOFFER: fixed header (op=BOOTREPLY,
  // yiaddr=offered_ip, siaddr=server_ip, chaddr echoed back per RFC
  // 2131) plus Message-Type + Server-Identifier options.
  let offer_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(offer_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(offer_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(offer_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(offer_msg, 242 as u32, dhcp_msgtype_offer());
  let _ = buf_write_byte(offer_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(offer_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(offer_msg, 245, server_ip);
  let _ = buf_write_byte(offer_msg, 249 as u32, 255 as u32); // End
  let offer_dhcp_len: i64 = 250;

  let offer_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let oi: i64 = 0;
  while oi < 6 {
    let mb: u32 = buf_read_byte(my_mac, oi as u32);
    let _ = buf_write_byte(offer_frame, oi as u32, mb); // dst: us
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 6 {
    let _ = buf_write_byte(offer_frame, (6 + oj) as u32, 0xAA as u32); // src: arbitrary "server" MAC
    oj = oj + 1;
  }
  let _ = buf_write_u16_be(offer_frame, 12, 0x0800 as u32);
  let offer_udp_len: i64 = udp_build(offer_frame, 34, dhcp_server_port(), dhcp_client_port(), offer_msg, offer_dhcp_len, server_ip, bcast_ip);
  let offer_total_len: i64 = 20 + offer_udp_len;
  let _ = ipv4_build_header(offer_frame, 14, offer_total_len, 17 as u32, server_ip, bcast_ip);
  let offer_frame_len: i64 = 14 + offer_total_len;

  let send_status1: i64 = netif_send_frame(offer_frame, offer_frame_len);
  if send_status1 != 0 { ok = 0; }

  let poll1: i64 = dhcp_client_poll(my_mac);
  if poll1 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_requesting() { ok = 0; }
  if dhcp_state_get_offered_ip() != offered_ip { ok = 0; }
  if dhcp_state_get_server_ip() != server_ip { ok = 0; }

  // Drain the client's own broadcast DHCPREQUEST (triggered by the
  // OFFER above) and confirm it correctly echoed the offered address
  // and chosen server back per RFC 2131 s4.3.2.
  let request_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let request_len: i64 = netif_recv_frame(request_frame, 512);
  if request_len < 240 { ok = 0; }
  if dhcp_find_option_byte(request_frame, 42, request_len - 42, 53 as u32) != (dhcp_msgtype_request() as i64) { ok = 0; }
  if dhcp_find_option_u32(request_frame, 42, request_len - 42, 50 as u32) != offered_ip { ok = 0; }
  if dhcp_find_option_u32(request_frame, 42, request_len - 42, 54 as u32) != server_ip { ok = 0; }

  // Build and queue the synthetic DHCPACK.
  let ack_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(ack_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(ack_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(ack_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(ack_msg, 242 as u32, dhcp_msgtype_ack());
  let _ = buf_write_byte(ack_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(ack_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(ack_msg, 245, server_ip);
  let _ = buf_write_byte(ack_msg, 249 as u32, 255 as u32); // End
  let ack_dhcp_len: i64 = 250;

  let ack_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let ai: i64 = 0;
  while ai < 6 {
    let mb2: u32 = buf_read_byte(my_mac, ai as u32);
    let _ = buf_write_byte(ack_frame, ai as u32, mb2);
    ai = ai + 1;
  }
  let aj: i64 = 0;
  while aj < 6 {
    let _ = buf_write_byte(ack_frame, (6 + aj) as u32, 0xAA as u32);
    aj = aj + 1;
  }
  let _ = buf_write_u16_be(ack_frame, 12, 0x0800 as u32);
  let ack_udp_len: i64 = udp_build(ack_frame, 34, dhcp_server_port(), dhcp_client_port(), ack_msg, ack_dhcp_len, server_ip, bcast_ip);
  let ack_total_len: i64 = 20 + ack_udp_len;
  let _ = ipv4_build_header(ack_frame, 14, ack_total_len, 17 as u32, server_ip, bcast_ip);
  let ack_frame_len: i64 = 14 + ack_total_len;

  let send_status2: i64 = netif_send_frame(ack_frame, ack_frame_len);
  if send_status2 != 0 { ok = 0; }

  let poll2: i64 = dhcp_client_poll(my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }
  if dhcp_state_get_leased_ip() != offered_ip { ok = 0; }

  let _ = uart_puts("DHCP: client DISCOVER->OFFER->REQUEST->ACK->BOUND");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 22 audit, 2026-08-28: exercises dhcp_client_check_lease's
// whole state machine (BOUND -T1-> RENEWING -T2-> REBINDING, plus a
// refresh ACK and full expiry) -- the RFC 2131 s4.4 lease lifecycle
// dhcp_self_test above never reaches, since it only ever proves the
// initial acquisition handshake. Starts directly from an
// already-BOUND precondition (set up via the same state-setter
// accessors dhcp_client_poll itself uses) rather than replaying that
// whole handshake again -- dhcp_self_test already independently
// covers it, matching arp_resolve_self_test's own "each self-test
// proves its own concern" reasoning from earlier this round.
//
// Backdates lease_start_tick directly to simulate each threshold
// having elapsed, rather than waiting real wall-clock time for real
// ticks (a boot self-test cannot afford to actually wait out even an
// 8-second lease, let alone a realistic one) -- this project's own
// established way of staging an otherwise-unstageable timing
// condition without adding any test-only mutation of real system
// time (see e.g. sdcard_state.S's TEST-ONLY buffer-pattern helpers
// for the same spirit applied to a different layer). Uses a
// lease_time (8 seconds) chosen specifically so every threshold's
// integer tick math divides evenly at this project's fixed 2-ticks/
// second rate, avoiding any rounding-driven off-by-one between this
// test's own expectations and dhcp_client_check_lease's actual
// arithmetic.
fn dhcp_renewal_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x22334455 as u32;
  let leased_ip: u32 = 0xC0A80165 as u32; // 192.168.1.101
  let server_ip: u32 = 0xC0A80110 as u32; // 192.168.1.16 -- distinct from every other self-test's IPs, avoids any ARP-cache cross-talk
  let lease_time: u32 = 8 as u32; // seconds
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  // Round 22: a known, fixed tick_count baseline -- rather than
  // reading whatever scheduler_get_tick_count() happens to already be
  // this early in boot (plausibly still 0 or 1, since timer_ic_init's
  // very first compare match is 500ms out and self-tests run well
  // before that elapses) and then trying to backdate FROM it via
  // subtraction. Subtracting an assumed margin from a small,
  // uncertain u32 tick_count is exactly the kind of underflow this
  // project's own inconsistent overflow trap has hit for real before
  // (round 2's eval_apply finding) -- this test hung outright the
  // first time it was written that way. Safe to set directly: see
  // scheduler_set_tick_count_test_only's own comment for why (no task
  // exists yet, IRQs stay masked through all of kernel_main's setup).
  // Every threshold below is reached by advancing tick_count FORWARD
  // from this fixed baseline, never by subtracting.
  let baseline_tick: u32 = 1000 as u32;
  let _ = scheduler_set_tick_count_test_only(baseline_tick);

  let _ = dhcp_state_set_client_state(dhcp_state_bound());
  let _ = dhcp_state_set_xid(xid);
  let _ = dhcp_state_set_leased_ip(leased_ip);
  let _ = dhcp_state_set_server_ip(server_ip);
  let _ = dhcp_state_set_lease_time(lease_time);
  let _ = dhcp_state_set_lease_start_tick(baseline_tick);
  let server_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let smi: i64 = 0;
  while smi < 6 {
    let _ = buf_write_byte(server_mac, smi as u32, 0xBB as u32);
    smi = smi + 1;
  }
  let _ = arp_cache_insert(server_ip, server_mac);

  // A fresh lease (elapsed=0) must not renew early.
  let too_early: i64 = dhcp_client_check_lease(my_mac);
  if too_early != 0 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }

  // Simulate T1 (lease_time/2 seconds = lease_time ticks at this
  // project's 2-ticks/second rate) having elapsed.
  let _ = scheduler_set_tick_count_test_only(baseline_tick + lease_time + (1 as u32));
  let renew_transition: i64 = dhcp_client_check_lease(my_mac);
  if renew_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_renewing() { ok = 0; }

  // The renewal REQUEST must go out UNICAST to the server's learned
  // MAC (not broadcast), with ciaddr set and options 50/54 both
  // absent, per RFC 2131 s4.3.2.
  let renew_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let renew_len: i64 = netif_recv_frame(renew_frame, 512);
  if renew_len < 240 { ok = 0; }
  let rmi: i64 = 0;
  while rmi < 6 {
    if buf_read_byte(renew_frame, rmi as u32) != (0xBB as u32) { ok = 0; }
    rmi = rmi + 1;
  }
  if dhcp_find_option_byte(renew_frame, 42, renew_len - 42, 53 as u32) != (dhcp_msgtype_request() as i64) { ok = 0; }
  if dhcp_find_option_u32(renew_frame, 42, renew_len - 42, 50 as u32) != (0 as u32) { ok = 0; }
  if dhcp_get_ciaddr(renew_frame, 42) != leased_ip { ok = 0; }

  // Simulate T2 (lease_time*7/8 seconds = lease_time*7/4 ticks) too --
  // measured from the SAME baseline_tick lease_start_tick was set to
  // above (never reset until a fresh ACK arrives, matching real
  // RFC 2131 semantics), so this advances tick_count further forward
  // from baseline_tick, not from wherever the T1 check left it.
  let t2_ticks_test: u32 = ((lease_time as u32) * (7 as u32)) / (4 as u32);
  let _ = scheduler_set_tick_count_test_only(baseline_tick + t2_ticks_test + (1 as u32));
  let rebind_transition: i64 = dhcp_client_check_lease(my_mac);
  if rebind_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_rebinding() { ok = 0; }

  let rebind_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let rebind_len: i64 = netif_recv_frame(rebind_frame, 512);
  if rebind_len < 240 { ok = 0; }
  let rbi: i64 = 0;
  while rbi < 6 {
    if buf_read_byte(rebind_frame, rbi as u32) != (0xFF as u32) { ok = 0; } // dst: broadcast this time
    rbi = rbi + 1;
  }

  // A real ACK arriving while REBINDING must refresh the lease back
  // to BOUND -- same handling as the original REQUESTING->BOUND
  // transition, just reached via REBINDING this time.
  let ack2_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(ack2_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, leased_ip, server_ip);
  let _ = buf_write_byte(ack2_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(ack2_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(ack2_msg, 242 as u32, dhcp_msgtype_ack());
  let _ = buf_write_byte(ack2_msg, 243 as u32, 51 as u32);
  let _ = buf_write_byte(ack2_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(ack2_msg, 245, lease_time);
  let _ = buf_write_byte(ack2_msg, 249 as u32, 255 as u32); // End
  let ack2_dhcp_len: i64 = 250;

  let ack2_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let a2i: i64 = 0;
  while a2i < 6 {
    let mb3: u32 = buf_read_byte(my_mac, a2i as u32);
    let _ = buf_write_byte(ack2_frame, a2i as u32, mb3);
    a2i = a2i + 1;
  }
  let a2j: i64 = 0;
  while a2j < 6 {
    let _ = buf_write_byte(ack2_frame, (6 + a2j) as u32, 0xBB as u32); // src: same server MAC
    a2j = a2j + 1;
  }
  let _ = buf_write_u16_be(ack2_frame, 12, 0x0800 as u32);
  let ack2_udp_len: i64 = udp_build(ack2_frame, 34, dhcp_server_port(), dhcp_client_port(), ack2_msg, ack2_dhcp_len, server_ip, bcast_ip);
  let ack2_total_len: i64 = 20 + ack2_udp_len;
  let _ = ipv4_build_header(ack2_frame, 14, ack2_total_len, 17 as u32, server_ip, bcast_ip);
  let ack2_frame_len: i64 = 14 + ack2_total_len;
  let send_status3: i64 = netif_send_frame(ack2_frame, ack2_frame_len);
  if send_status3 != 0 { ok = 0; }

  let poll3: i64 = dhcp_client_poll(my_mac);
  if poll3 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_bound() { ok = 0; }
  if dhcp_state_get_lease_time() != lease_time { ok = 0; }

  // Finally: full expiry with no response at all while REBINDING must
  // give up the address, matching a NAK's own reset shape. The
  // refresh ACK above just reset lease_start_tick to whatever
  // tick_count was at that moment (dhcp_client_poll's own ACK-
  // handling branch) -- read it back and advance FORWARD from there
  // (safe: addition, never subtraction) rather than assuming its
  // value.
  let _ = dhcp_state_set_client_state(dhcp_state_rebinding());
  let lease_ticks_test: u32 = (lease_time as u32) * (2 as u32);
  let refreshed_start: u32 = dhcp_state_get_lease_start_tick();
  let _ = scheduler_set_tick_count_test_only(refreshed_start + lease_ticks_test + (1 as u32));
  let expiry_transition: i64 = dhcp_client_check_lease(my_mac);
  if expiry_transition != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_init() { ok = 0; }
  if dhcp_state_get_leased_ip() != (0 as u32) { ok = 0; }

  let _ = uart_puts("DHCP: lease renewal (BOUND->RENEWING unicast->REBINDING broadcast->refresh/expiry)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Regression test for round 10's NAK-handling fix (see
// dhcp_client_poll's own comment): drives the client to REQUESTING
// exactly like dhcp_self_test above, then replies with a synthetic
// DHCPNAK instead of an ACK, confirming the client resets to INIT
// (rather than getting stuck in REQUESTING forever, which is what it
// did before this fix -- a NAK fell through to the catch-all ignore
// path with nothing checking for it).
fn dhcp_nak_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let xid: u32 = 0x87654321 as u32;
  let offered_ip: u32 = 0xC0A80165 as u32; // 192.168.1.101
  let server_ip: u32 = 0xC0A80101 as u32;  // 192.168.1.1
  let bcast_ip: u32 = 0xFFFFFFFF as u32;

  let start_status: i64 = dhcp_client_start(my_mac, xid);
  if start_status != 0 { ok = 0; }

  let discover_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = netif_recv_frame(discover_frame, 512); // drain our own DISCOVER

  let offer_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(offer_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, offered_ip, server_ip);
  let _ = buf_write_byte(offer_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(offer_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(offer_msg, 242 as u32, dhcp_msgtype_offer());
  let _ = buf_write_byte(offer_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(offer_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(offer_msg, 245, server_ip);
  let _ = buf_write_byte(offer_msg, 249 as u32, 255 as u32);
  let offer_dhcp_len: i64 = 250;

  let offer_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let oi: i64 = 0;
  while oi < 6 {
    let mb: u32 = buf_read_byte(my_mac, oi as u32);
    let _ = buf_write_byte(offer_frame, oi as u32, mb);
    oi = oi + 1;
  }
  let oj: i64 = 0;
  while oj < 6 {
    let _ = buf_write_byte(offer_frame, (6 + oj) as u32, 0xAA as u32);
    oj = oj + 1;
  }
  let _ = buf_write_u16_be(offer_frame, 12, 0x0800 as u32);
  let offer_udp_len: i64 = udp_build(offer_frame, 34, dhcp_server_port(), dhcp_client_port(), offer_msg, offer_dhcp_len, server_ip, bcast_ip);
  let offer_total_len: i64 = 20 + offer_udp_len;
  let _ = ipv4_build_header(offer_frame, 14, offer_total_len, 17 as u32, server_ip, bcast_ip);
  let offer_frame_len: i64 = 14 + offer_total_len;
  let _ = netif_send_frame(offer_frame, offer_frame_len);

  let poll1: i64 = dhcp_client_poll(my_mac);
  if poll1 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_requesting() { ok = 0; }

  let request_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = netif_recv_frame(request_frame, 512); // drain our own REQUEST

  // Build and queue a synthetic DHCPNAK -- no yiaddr/siaddr per RFC
  // 2131 s4.3.2 (a NAK carries no offered address, unlike OFFER/ACK).
  let nak_msg: mut ref i64 = dhruva_alloc_bytes(300);
  let _ = dhcp_build_fixed_header(nak_msg, 0, my_mac, xid, dhcp_op_bootreply(), 0 as u32, 0 as u32, 0 as u32);
  let _ = buf_write_byte(nak_msg, 240 as u32, 53 as u32);
  let _ = buf_write_byte(nak_msg, 241 as u32, 1 as u32);
  let _ = buf_write_byte(nak_msg, 242 as u32, dhcp_msgtype_nak());
  let _ = buf_write_byte(nak_msg, 243 as u32, 54 as u32);
  let _ = buf_write_byte(nak_msg, 244 as u32, 4 as u32);
  let _ = buf_write_u32_be(nak_msg, 245, server_ip);
  let _ = buf_write_byte(nak_msg, 249 as u32, 255 as u32);
  let nak_dhcp_len: i64 = 250;

  let nak_frame: mut ref i64 = dhruva_alloc_bytes(512);
  let ni: i64 = 0;
  while ni < 6 {
    let mb3: u32 = buf_read_byte(my_mac, ni as u32);
    let _ = buf_write_byte(nak_frame, ni as u32, mb3);
    ni = ni + 1;
  }
  let nj: i64 = 0;
  while nj < 6 {
    let _ = buf_write_byte(nak_frame, (6 + nj) as u32, 0xAA as u32);
    nj = nj + 1;
  }
  let _ = buf_write_u16_be(nak_frame, 12, 0x0800 as u32);
  let nak_udp_len: i64 = udp_build(nak_frame, 34, dhcp_server_port(), dhcp_client_port(), nak_msg, nak_dhcp_len, server_ip, bcast_ip);
  let nak_total_len: i64 = 20 + nak_udp_len;
  let _ = ipv4_build_header(nak_frame, 14, nak_total_len, 17 as u32, server_ip, bcast_ip);
  let nak_frame_len: i64 = 14 + nak_total_len;

  let send_status: i64 = netif_send_frame(nak_frame, nak_frame_len);
  if send_status != 0 { ok = 0; }

  let poll2: i64 = dhcp_client_poll(my_mac);
  if poll2 != 1 { ok = 0; }
  if dhcp_state_get_client_state() != dhcp_state_init() { ok = 0; }

  let _ = uart_puts("DHCP: client resets to INIT on a DHCPNAK");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Round 32: closes the feature ledger's last open item -- a permanent
// regression test for the shared-netif-queue hazard task_e's own
// comment has documented (and named more live consumers of, rounds
// 27/29/30) since round 27, but that was only ever documented, never
// actually exercised by a test. netif_recv_frame (see its own
// comment) unconditionally dequeues the OLDEST queued frame regardless
// of what the caller actually wants -- every *_poll/*_recv function
// relies on that, checking the frame's own type only AFTER dequeuing
// it, and silently dropping (not requeuing) a mismatch. That's the
// real mechanism behind the live hazard: task_e's periodic
// dhcp_client_poll and the shell's ping/tcpecho/udpecho are
// independently-scheduled concurrent consumers of that same queue, so
// whichever one happens to poll next can steal-and-drop a frame a
// different one was actually waiting for.
//
// Reproducing the live timing-dependent version directly would need
// real preemption luck (and DHCP never receives anything live under
// this project's loopback-only QEMU netif to even compete over -- see
// dhcp_client_poll's own "never actually binds" note). Instead this
// proves the underlying MECHANISM deterministically, with no timing
// dependency at all: queue a real ICMP echo request first, a real UDP
// datagram second (both self-to-self over loopback, reusing the exact
// same already-proven send paths icmp_self_test/udp_self_test/
// icmp_poll/socket_udp_recv individually rely on), then deliberately
// poll for UDP before ICMP. socket_udp_recv dequeues the OLDEST frame
// (the ICMP one), rejects it (protocol != 17), and drops it --
// icmp_poll then dequeues the only frame left (the UDP one), rejects
// it too (protocol != 1), and drops that as well. Neither caller ever
// sees the frame it was actually waiting for, even though both were
// valid and genuinely queued -- exactly the failure mode task_e's
// comment describes, reproduced without needing any specific
// interleaving to get lucky on.
fn netif_queue_contention_self_test() -> i64 {
  let ok: i64 = 1;
  let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(my_mac);
  let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1

  // Drain any leftover queue state from earlier self-tests so the two
  // enqueues below land in a known, empty queue.
  let drain: mut ref i64 = dhruva_alloc_bytes(512);
  let drain_iter: i64 = 0;
  while (drain_iter < 8) && (netif_recv_frame(drain, 512) >= 0) {
    drain_iter = drain_iter + 1;
  }

  // Frame 1, queued first (so it's the oldest -- dequeued first):
  // a real ICMP echo request.
  let icmp_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(icmp_payload, 0 as u32, 104 as u32); // 'h'
  let send1: i64 = icmp_ping_start(my_mac, my_mac, loop_ip, loop_ip, 4242 as u32, 1 as u32, icmp_payload, 1);
  if send1 != 0 {
    ok = 0;
  }

  // Frame 2, queued second: a real UDP datagram. socket_udp_send
  // needs an ARP-cache hit (round 21) -- same self-insert precedent
  // udp_self_test/udpecho already established.
  let _ = arp_cache_insert(loop_ip, my_mac);
  let udp_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let _ = buf_write_byte(udp_payload, 0 as u32, 117 as u32); // 'u'
  let send2: i64 = socket_udp_send(my_mac, loop_ip, loop_ip, 54399 as u32, 54398 as u32, udp_payload, 1);
  if send2 != 0 {
    ok = 0;
  }
  if netif_get_count() != 2 {
    ok = 0; // exactly one frame per send call -- both queued, neither
             // dequeued yet
  }

  // Poll for UDP FIRST, even though the ICMP frame is queued ahead of
  // it -- proves the steal: socket_udp_recv dequeues the oldest frame
  // (ICMP, protocol 1 != 17), rejects it, and drops it. Its own real
  // UDP datagram is still queued behind, unseen by this call.
  let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
  let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let udp_result: i64 = socket_udp_recv(recv_payload, recv_meta, 4);
  if udp_result != (0 - 1) {
    ok = 0; // if this ever starts succeeding, the queue got demuxed
             // by something else -- worth re-examining this test, not
             // silently trusting a changed assumption.
  }

  // Now poll for ICMP -- but its frame was already stolen-and-dropped
  // above. Only the UDP frame is left; icmp_poll rejects (protocol 17
  // != 1) and drops that one too.
  let icmp_meta: mut ref i64 = dhruva_alloc_bytes(8);
  let icmp_result: i64 = icmp_poll(my_mac, loop_ip, recv_payload, 4, icmp_meta);
  if icmp_result != (0 - 1) {
    ok = 0;
  }

  // Both frames are now gone -- neither caller ever got the one it
  // was actually waiting for. This is the hazard, reproduced.
  if netif_get_count() != 0 {
    ok = 0;
  }

  let _ = uart_puts("NETIF: shared-queue contention hazard reproduced as documented");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Phase 6 continued: DWC2 USB host controller bring-up (BCM2835's real
// on-chip USB silicon -- the Pi 1 Model B has no native Ethernet, so
// DHRUVA_ARCHITECTURE.md's whole "real networking" path runs through
// this chip via a USB-attached LAN9512/WiFi/BLE device). Base address
// 0x20980000 and GPU IRQ 9 confirmed directly against QEMU's own
// hw/arm/bcm2835_peripherals.c (USB_OTG_OFFSET=0x980000) and
// include/hw/arm/raspi_platform.h (INTERRUPT_USB=9), not assumed from
// the datasheet alone -- same discipline as every other BCM2835
// peripheral this project has brought up. Register-level behavior
// (which bits are real vs. logged-only no-ops) confirmed against
// QEMU's own hw/usb/hcd-dwc2.c, since a byte-correct driver against
// the datasheet can still hang forever against an emulation that
// doesn't implement everything the datasheet promises (matching
// task #3's SD driver "checked byte-correct and still didn't work"
// lesson) -- specifically:
//   - GRSTCTL (core/host soft reset, FIFO flush) is entirely
//     logged-only in this model; writing it does nothing real, so
//     init here does not wait on or depend on any GRSTCTL self-clear
//     beyond what the register read path already strips immediately.
//   - HPRT0's ENA bit cannot be set directly by writing it -- only a
//     RST=1-then-0 transition while a device is attached makes the
//     model itself set ENA+ENACHG. This is not a polling race to
//     tune; the model's own dwc2_hprt_write only performs that
//     transition-triggered enable exactly once, synchronously.
//   - FIFO/slave-mode transfers are entirely unimplemented (dead
//     no-op registers) in this model -- DMA mode via HCDMA is the
//     only working data path here, so this driver is DMA-only by
//     necessity, not by choice (real hardware supports both, but a
//     driver written for slave mode would never work under this
//     specific QEMU model).
fn dwc2_base() -> i64 {
  return 0x20980000;
}

// GSNPSID (Synopsys ID register, offset 0x40) -- a fixed silicon ID
// QEMU's model reports as a reset-default constant (0x4f54294a). Used
// here purely as a sanity check that MMIO to this address range
// reaches the DWC2 model at all, the same role fs_init's checksum
// check or the SD driver's SDHSTS checks play elsewhere: confirm the
// hardware is really there and responding before trusting anything
// else it reports.
fn dwc2_read_gsnpsid() -> u32 {
  return mmio_read_u32(dwc2_base() + 0x40);
}

// GAHBCFG bit 0 (GLBL_INTR_EN) -- confirmed against hcd-dwc2.c as the
// one bit this model actually gates its IRQ line on (GINTSTS &
// GINTMSK must also be nonzero, but without this bit set the line
// never asserts regardless). This driver polls registers directly
// rather than using the IRQ line for now, but the bit is set anyway
// to match what a real controller expects during bring-up and to
// leave room for a real interrupt-driven path later without an init
// order change.
fn dwc2_enable_global_intr() -> i64 {
  let gahbcfg: i64 = dwc2_base() + 0x08;
  let v: u32 = mmio_read_u32(gahbcfg);
  let _ = mmio_write_u32(gahbcfg, v | (1 as u32));
  return 0;
}

// HPRT0 (offset 0x440) bit layout confirmed against hcd-dwc2.c:
// CONNSTS=bit0 (RO), CONNDET=bit1 (W1C), ENA=bit2 (RO, self-setting
// only), ENACHG=bit3 (W1C), RST=bit8, PWR=bit12, LNSTS=bits[11:10]
// (RO), SPD=bits[18:17] (RO: 0=high,1=full,2=low).
fn dwc2_hprt0_addr() -> i64 {
  return dwc2_base() + 0x440;
}

fn dwc2_port_connected() -> i64 {
  let v: u32 = mmio_read_u32(dwc2_hprt0_addr());
  if (v & (1 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

fn dwc2_port_enabled() -> i64 {
  let v: u32 = mmio_read_u32(dwc2_hprt0_addr());
  if (v & (4 as u32)) != (0 as u32) {
    return 1;
  }
  return 0;
}

// Resets the root port -- the RST=1-then-0 transition is what the
// model actually keys off of (see this section's header comment): it
// synchronously sets ENA+ENACHG itself once a device is attached, so
// there's no separate "wait for enable" poll loop needed here, only a
// bounded settle delay around the transition itself (matching every
// other bounded-not-unbounded wait already established in this
// project's own hard-RT-adjacent code, even though this path isn't
// itself hard-RT). CONNDET/ENACHG are write-1-to-clear status bits --
// cleared explicitly afterward so a later poll can distinguish a NEW
// event from this reset's own leftover flags.
// HPRT0's write-1-to-clear group is FOUR bits, not the three a naive
// reading of the Synopsys databook's "status" vs "control" column
// split might suggest: CONNDET(1), ENA(2), ENACHG(3), OVRCURRCHG(5) --
// confirmed directly against hcd-dwc2.c's dwc2_hreg0_write, which
// applies the exact same old-AND-NOT-written clear transform to all
// four uniformly. ENA looking like a plain RO/self-set status bit
// (true for how it gets SET -- only the model itself can set it, not
// a direct write) is a trap: it can still be WRITTEN BACK TO ZERO by
// including its own current "1" in a later write, since this group's
// write semantics are "write 1 clears, write 0 preserves" regardless
// of which bit. Every write to this register must therefore always
// force this whole 4-bit group to 0 in the value being constructed,
// then OR in only the specific bit(s) actually meant to be cleared
// THIS write -- never carry a freshly-read 1 in any of these four
// bit positions into a subsequent write, or it silently un-sets
// whatever that bit was reporting (this cost one full extra debug
// round-trip to catch: the very first pass here wrote back a freshly-
// read ENA=1 while only intending to clear two unrelated bits, and
// silently turned ENA back off in the same instruction).
fn dwc2_hprt0_w1c_group_mask() -> u32 {
  return 0x2E as u32; // bits 1,2,3,5: CONNDET,ENA,ENACHG,OVRCURRCHG
}

// AUDITED (round 17, 2026-08-28) -- this function's own read/write/
// read/write/read/write sequence against HPRT0, and the read/write
// sequence dwc2_init() runs against GSNPSID/GAHBCFG/HPRT0 on the way
// in, do NOT need a memory barrier (context_switch.S's mem_barrier,
// added round 16 for a genuinely different problem -- see that
// function's own comment). Checked directly against the same
// Broadcom BCM2835 guidance round 16 already cited: "accesses to the
// same peripheral will always arrive and return in-order... it is
// only when switching from one peripheral to another that data can
// arrive out-of-order." GSNPSID, GAHBCFG, and HPRT0 are all registers
// of the one DWC2 IP block at base 0x20980000 -- dwc2_init never
// switches to a different peripheral anywhere on this path, so the
// out-of-order risk that guidance describes doesn't apply here. This
// closes the "HPRT0 reset sequence" half of the open question round
// 16's own mem_barrier comment flagged for a future round.
fn dwc2_port_reset() -> i64 {
  let hprt0: i64 = dwc2_hprt0_addr();
  let w1c_mask: u32 = dwc2_hprt0_w1c_group_mask();

  let not_w1c_mask: u32 = w1c_mask ^ (0xFFFFFFFF as u32);

  // Set RST=1, forcing the w1c group to 0 (preserve, clear nothing).
  let v: u32 = mmio_read_u32(hprt0);
  let _ = mmio_write_u32(hprt0, (v & not_w1c_mask) | (0x100 as u32));
  let _ = delay(50000);

  // Deassert RST, again forcing the w1c group to 0 in the WRITE value
  // -- the model's own RST-transition handler sets ENA+ENACHG itself
  // (unconditionally overriding whatever this write says for those
  // two bits), so there's nothing to OR in here at all.
  let v2: u32 = mmio_read_u32(hprt0);
  let clear_rst: u32 = (0x100 as u32) ^ (0xFFFFFFFF as u32);
  let _ = mmio_write_u32(hprt0, v2 & clear_rst & not_w1c_mask);
  let _ = delay(50000);

  // Acknowledge CONNDET+ENACHG (write 1 to clear just those two),
  // forcing ENA's own bit position to 0 in this write so its current
  // 1 value is PRESERVED, not cleared.
  let v3: u32 = mmio_read_u32(hprt0);
  let ack_bits: u32 = (0x2 as u32) | (0x8 as u32); // CONNDET | ENACHG
  let _ = mmio_write_u32(hprt0, (v3 & not_w1c_mask) | ack_bits);
  return 0;
}

// Brings the controller up far enough to detect and reset an attached
// device's port -- deliberately NOT yet a full enumeration (no
// control transfer, no descriptor read): this is the first verifiable
// slice, matching this project's own "verify each increment under
// QEMU before adding the next" discipline used for every prior
// peripheral. Real hardware value: FALSE for "silicon responds and
// port reaches ENABLED with a device attached", used by the self-test
// below to report pass/fail without the caller needing to inspect
// raw register values.
fn dwc2_init() -> i64 {
  let id: u32 = dwc2_read_gsnpsid();
  let _ = uart_puts("USB: GSNPSID=");
  let _ = uart_put_hex32(id);
  let _ = uart_puts("\n");

  let _ = dwc2_enable_global_intr();

  let connected: i64 = dwc2_port_connected();
  let _ = uart_puts("USB: port connected=");
  let _ = uart_put_hex32(connected as u32);
  let _ = uart_puts("\n");

  if connected == 0 {
    return 0 - 1;
  }

  let _ = dwc2_port_reset();
  let enabled: i64 = dwc2_port_enabled();
  let _ = uart_puts("USB: port enabled after reset=");
  let _ = uart_put_hex32(enabled as u32);
  let _ = uart_puts("\n");

  if enabled == 0 {
    return 0 - 1;
  }
  return dwc2_probe_device0();
}

// Host channel 0 register block: base 0x500, one control-endpoint
// transfer at a time, stride 0x20 unused here since only channel 0 is
// ever used by this driver so far -- confirmed against hcd-dwc2.h's
// own `hreg1[((_ch) << 3) + N]` macros (each `hreg1` word is 4 bytes,
// so `<<3` word-index-shift is a 0x20-byte channel stride).
fn dwc2_hcchar0_addr() -> i64 {
  return dwc2_base() + 0x500;
}
fn dwc2_hcint0_addr() -> i64 {
  return dwc2_base() + 0x508;
}
fn dwc2_hcintmsk0_addr() -> i64 {
  return dwc2_base() + 0x50C;
}
fn dwc2_hctsiz0_addr() -> i64 {
  return dwc2_base() + 0x510;
}
fn dwc2_hcdma0_addr() -> i64 {
  return dwc2_base() + 0x514;
}

// HCCHAR field layout confirmed against hcd-dwc2.c's dwc2_enable_chan
// (CHENA=bit31, DEVADDR=bits[28:22], EPTYPE=bits[19:18] (0=control),
// EPDIR=bit15 (0=out,1=in), EPNUM=bits[14:11], MPS=bits[10:0]).
fn dwc2_build_hcchar(devaddr: u32, eptype: u32, epdir: u32, epnum: u32, mps: u32) -> u32 {
  let chena: u32 = 1 as u32;
  let v: u32 = (chena << (31 as u32))
    | (devaddr << (22 as u32))
    | (eptype << (18 as u32))
    | (epdir << (15 as u32))
    | (epnum << (11 as u32))
    | mps;
  return v;
}

// HCTSIZ field layout confirmed against hcd-dwc2.c (PID=bits[30:29],
// PKTCNT=bits[28:19], XFERSIZE=bits[18:0]). PID encoding for a
// CONTROL endpoint specifically (not the generic non-control 0/1/2/3
// = DATA0/DATA1/DATA2/MDATA scheme): 0=DATA0, 1=DATA2, 2=DATA1,
// 3=SETUP -- this project's own DWC2 register reference (gathered
// directly from hcd-dwc2.c/.h before writing any of this code, same
// discipline as every other peripheral here) confirmed this
// control-specific encoding explicitly, since assuming the generic
// non-control PID numbering here would silently mislabel every DATA1
// packet as DATA2 and vice versa.
fn dwc2_pid_setup() -> u32 {
  return 3 as u32;
}
fn dwc2_pid_data1() -> u32 {
  return 2 as u32;
}

fn dwc2_build_hctsiz(pid: u32, pktcnt: u32, xfersize: u32) -> u32 {
  let v: u32 = (pid << (29 as u32)) | (pktcnt << (19 as u32)) | xfersize;
  return v;
}

// Kicks off whatever channel 0 is already programmed for (HCCHAR/
// HCTSIZ/HCDMA must be set by the caller first) and polls HCINT(0)
// directly for completion -- bounded, not `while true`, matching this
// project's own established pattern for any hardware poll (the
// mailbox property-interface call earlier in this same phase uses the
// identical shape).
//
// Deliberately polls HCINT(0) itself, NOT HAINT: confirmed against
// hcd-dwc2.c's dwc2_update_hc_irq that HAINT's per-channel bit only
// ever reflects `HCINT & HCINTMSK`, and HCINTMSK(0) is 0 (every
// source masked) at reset -- a driver that never explicitly unmasks
// it would see HCINT(0) get the real completion bits from
// dwc2_handle_packet every time, while HAINT stayed permanently 0
// regardless (found the hard way: the very first version of this
// function polled HAINT and timed out on every single transfer, even
// though the transfer itself was completing correctly one MMIO write
// later). Since this driver polls registers directly instead of using
// the IRQ line, there's no need to program HCINTMSK/GINTMSK at all --
// reading the raw, always-current HCINT(0) value sidesteps the whole
// masking mechanism real interrupt-driven code would have to set up.
// Returns the HCINT value observed at completion (0 on a timeout,
// which is not a valid real HCINT value since XFERCOMPL or CHHLTD
// would always be set on a genuine completion -- callers check for
// exactly 0 to distinguish a timeout from a real, if unsuccessful,
// transfer outcome), and always clears whatever HCINT bits it saw
// (write-1-to-clear) before returning.
fn dwc2_wait_chan0_done() -> u32 {
  let hcint0: i64 = dwc2_hcint0_addr();
  let tries: i64 = 0;
  while tries < 1000000 {
    let hi: u32 = mmio_read_u32(hcint0);
    if hi != (0 as u32) {
      let _ = mmio_write_u32(hcint0, hi);
      return hi;
    }
    tries = tries + 1;
  }
  return 0 as u32;
}

// One complete control transfer (SETUP + optional IN data stage +
// zero-length STATUS stage) targeting device address `devaddr`,
// endpoint 0, using `mps` as the control endpoint's max packet size
// (8 is always safe for the very first transfer to any USB device,
// per spec -- every device supports at least an 8-byte EP0 before its
// real bMaxPacketSize0 is even known). Fetches `want_len` bytes of
// whatever descriptor `setup_buf` (already built by the caller into
// dwc2_dma_scratch) requests, copying the result into `out_buf`
// (caller-owned, at least `want_len` bytes). Returns 0 on success, -1
// on any stage failing to complete (channel-halt error bits set, or a
// poll timeout), or on either of the two bad-input cases guarded
// below.
//
// BUG (round 3 audit, 2026-08-27), two findings, both here:
//
// 1. The data stage below programs HCDMA to point straight at
// dwc2_dma_scratch and HCTSIZ's xfersize to `want_len` -- the DWC2
// controller then DMAs that many bytes into dwc2_dma_scratch directly
// in hardware, with nothing on this function's own side checking
// `want_len` against that buffer's actual, fixed 64-byte capacity
// (see scratch_state.S). Every call site today only ever asks for
// 4, 8, or 18 bytes, so this hasn't been hit live, but it's the exact
// same shape of bug rounds 1 and 2 both found and fixed elsewhere
// (netif_recv_frame, socket_udp_recv, tcp_conn_handle_segment, the FS
// layer) -- a length used as a hardware DMA/copy bound with no check
// against the destination's real size -- just with the DMA engine as
// the "writer" instead of a software loop this time. Worth closing
// now rather than after DHRUVA_ARCHITECTURE.md's own planned next
// step (real LAN9512/WiFi/BLE class drivers) adds a config-descriptor
// read whose length comes from the device's own reported wTotalLength
// and quietly exceeds 64.
//
// 2. `mps` is used below as a divisor when computing pktcnt for the
// data stage. Every real call site passes either a fixed 8 (the
// spec-guaranteed-safe default before a device's own MPS is known) or
// `mps0`/`dmps0` -- bMaxPacketSize0 read straight out of a device's
// own descriptor response, i.e. attacker/device-controlled data. A
// misbehaving or malicious device reporting bMaxPacketSize0=0 would
// divide by zero the moment this driver tried its next control
// transfer to that device (the 18-byte full-descriptor re-fetch,
// concretely) -- the exact same "validate untrusted external data
// before using it in an operation that can crash/hang" lesson as
// eval_apply's own division-by-zero guard, just with a USB device
// standing in for shell input this time.
fn dwc2_control_in(devaddr: u32, mps: u32, want_len: u32, out_buf: mut ref i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if want_len > (64 as u32) {
    return 0 - 1;
  }
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  // BUG (round 16 audit, 2026-08-28): the caller already wrote the
  // SETUP packet into dwc2_dma_scratch via plain stores before calling
  // this function -- nothing guaranteed that write had actually
  // reached memory before the HCDMA/HCCHAR writes just below hand this
  // same address off to the DWC2 controller's own DMA engine, a
  // genuinely separate hardware bus master that reads it via its own
  // path, not through the CPU. See mem_barrier's own comment
  // (context_switch.S) for why this is a real gap on real hardware
  // regardless of the MMU/cache state, and why QEMU's own testing
  // can't reveal it. Centralized here rather than at every call site
  // that builds a SETUP packet, matching this function's own existing
  // role as the one choke point every control transfer already goes
  // through.
  let _ = mem_barrier();

  // SETUP stage: the 8-byte request already sits in dwc2_dma_scratch
  // (dma), written by the caller before this call.
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_setup(), 1 as u32, 8 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let setup_result: u32 = dwc2_wait_chan0_done();
  if (setup_result & (1 as u32)) == (0 as u32) {
    return 0 - 1; // XFERCOMPL (bit0) never set -- timeout or error
  }

  // DATA stage (IN): read want_len bytes back into the same DMA
  // buffer, then copy out to the caller's own out_buf.
  //
  // BUG (found via a live STALL on the very first multi-packet
  // transfer this driver ever attempted -- want_len=18 > mps=8):
  // pktcnt must be the real number of MPS-sized packets the transfer
  // needs (ceil(want_len/mps)), not a hardcoded 1. hcd-dwc2.c's own
  // dwc2_handle_packet caps a single packet's actual transfer length
  // to `mps` whenever the overall length is "small" (<=1536 bytes,
  // true for every transfer this driver issues) -- with pktcnt wrongly
  // fixed at 1, the model still marks the WHOLE transfer "done" the
  // instant that single MPS-sized packet lands (pcnt hits 0 via
  // `pcnt -= min(tpcnt, pcnt)` clamping), silently truncating the
  // data stage to just `mps` bytes instead of the real want_len this
  // driver asked for and copied out assuming it got. The device's own
  // control-endpoint state machine, still expecting to send the
  // REMAINING data it hasn't transmitted yet, then sees a premature
  // STATUS token and STALLs it -- a real, spec-shaped protocol
  // violation this driver caused, not a QEMU model quirk. Multi-packet
  // completion itself needs no extra driver-side loop: hcd-dwc2.c's
  // dwc2_enable_chan always schedules its async bottom half after the
  // first packet regardless, and dwc2_work_bh keeps servicing this
  // channel (via p->needs_service) until pcnt/len both reach 0 -- this
  // driver's own poll loop already waits for that same final HCINT,
  // it just needs pktcnt to describe the truth up front.
  let pktcnt: u32 = (want_len + mps - (1 as u32)) / mps;
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), pktcnt, want_len));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 1 as u32, 0 as u32, mps));
  let data_result: u32 = dwc2_wait_chan0_done();
  if (data_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let i: i64 = 0;
  let want_len_i: i64 = want_len as i64;
  while i < want_len_i {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }

  // STATUS stage (OUT, zero-length, DATA1) -- acknowledges the
  // transfer is complete; no data buffer content matters here since
  // xfersize=0 means the model transfers nothing regardless of what
  // HCDMA points at, but a valid pointer is still supplied.
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), 1 as u32, 0 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let status_result: u32 = dwc2_wait_chan0_done();
  if (status_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  return 0;
}

// One control transfer with NO data stage: SETUP, then a zero-length
// STATUS stage in the OPPOSITE direction of the request (IN, since
// every no-data-stage standard request this driver issues -- SET_
// ADDRESS, SET_CONFIGURATION -- is host-to-device). Used for requests
// whose entire effect is encoded in the 8-byte SETUP packet itself,
// with nothing to read back or send afterward.
fn dwc2_control_no_data(devaddr: u32, mps: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  // Same real-hardware DMA-coherency gap dwc2_control_in's own comment
  // explains in full -- the caller already wrote the SETUP packet into
  // dwc2_dma_scratch via plain stores before calling this function.
  let _ = mem_barrier();

  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_setup(), 1 as u32, 8 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 0 as u32, 0 as u32, mps));
  let setup_result: u32 = dwc2_wait_chan0_done();
  if (setup_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }

  // STATUS stage (IN, zero-length, DATA1).
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(dwc2_pid_data1(), 1 as u32, 0 as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 0 as u32, 1 as u32, 0 as u32, mps));
  let status_result: u32 = dwc2_wait_chan0_done();
  if (status_result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  return 0;
}

// Generic SETUP packet builder -- every standard AND class-specific
// request (GET_DESCRIPTOR, SET_ADDRESS, and the hub-class port
// requests below) is just these five fields in the same 8-byte
// layout; the standard-request builders above predate this one and
// are kept as-is (each still correct, just less general) rather than
// churning already-verified code for a cosmetic refactor.
fn dwc2_build_setup(bm_request_type: u32, b_request: u32, w_value: u32, w_index: u32, w_length: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, bm_request_type);
  let _ = buf_write_byte(dma, 1 as u32, b_request);
  let _ = buf_write_byte(dma, 2 as u32, w_value & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (w_value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, w_index & (0xFF as u32));
  let _ = buf_write_byte(dma, 5 as u32, (w_index >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 6 as u32, w_length & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (w_length >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// USB 2.0 spec chapter 11 hub-class port feature selectors (the ones
// this driver actually uses -- ports "power up" reset-disabled by
// default, and PORT_RESET's own completion has to be observed via
// the port's status/change bits rather than assumed from timing
// alone, same "don't trust a bounded delay over a real status check
// where one exists" reasoning as this project's own IPCP/scheduler
// code, just applied to a hub port instead of a task).
fn hub_feature_port_enable() -> u32 { return 1 as u32; }
fn hub_feature_port_reset() -> u32 { return 4 as u32; }
fn hub_feature_port_power() -> u32 { return 8 as u32; }
fn hub_feature_c_port_connection() -> u32 { return 16 as u32; }
fn hub_feature_c_port_reset() -> u32 { return 20 as u32; }

// SET_PORT_FEATURE / CLEAR_PORT_FEATURE / GET_PORT_STATUS -- class-
// specific (not standard) requests, recipient=OTHER (a port, not the
// hub device itself): bmRequestType 0x23 for the two SET/CLEAR
// (host-to-device, class, other) and 0xA3 for GET_PORT_STATUS
// (device-to-host, class, other). `port` is 1-based per spec.
fn dwc2_hub_set_port_feature(hub_addr: u32, hub_mps: u32, port: u32, feature: u32) -> i64 {
  let _ = dwc2_build_setup(0x23 as u32, 3 as u32, feature, port, 0 as u32);
  return dwc2_control_no_data(hub_addr, hub_mps);
}
fn dwc2_hub_clear_port_feature(hub_addr: u32, hub_mps: u32, port: u32, feature: u32) -> i64 {
  let _ = dwc2_build_setup(0x23 as u32, 1 as u32, feature, port, 0 as u32);
  return dwc2_control_no_data(hub_addr, hub_mps);
}
// out_buf must be at least 4 bytes: wPortStatus (bytes 0-1, LE),
// wPortChange (bytes 2-3, LE).
fn dwc2_hub_get_port_status(hub_addr: u32, hub_mps: u32, port: u32, out_buf: mut ref i64) -> i64 {
  let _ = dwc2_build_setup(0xA3 as u32, 0 as u32, 0 as u32, port, 4 as u32);
  return dwc2_control_in(hub_addr, hub_mps, 4 as u32, out_buf);
}

// Builds a standard SET_ADDRESS SETUP packet: bmRequestType=0x00
// (host-to-device, standard, device), bRequest=5, wValue=new_addr,
// wIndex=0, wLength=0. Per USB spec this request is always issued
// TO address 0 (the device hasn't adopted new_addr yet -- it only
// does so after this transfer's STATUS stage completes), regardless
// of what new_addr itself is.
fn dwc2_build_set_address_setup(new_addr: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 5 as u32);
  let _ = buf_write_byte(dma, 2 as u32, new_addr & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (new_addr >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Builds a standard GET_DESCRIPTOR(Device) SETUP packet directly into
// dwc2_dma_scratch: bmRequestType=0x80 (device-to-host, standard,
// device), bRequest=6 (GET_DESCRIPTOR), wValue=0x0100 (type=1/DEVICE,
// index=0), wIndex=0, wLength as given (8 for the very first probe --
// enough to learn bMaxPacketSize0 at byte 7 without assuming the real
// device's MPS in advance).
fn dwc2_build_get_device_descriptor_setup(want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x80 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 6 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 1 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// Round 24 (WiFi dongle enumeration prep, 2026-08-28): same shape as
// dwc2_build_get_device_descriptor_setup right above, but wValue's
// high byte is 2 (CONFIGURATION) instead of 1 (DEVICE) -- everything
// else about a GET_DESCRIPTOR request is identical regardless of
// which descriptor type is being asked for.
fn dwc2_build_get_config_descriptor_setup(want_len: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0x80 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 6 as u32);
  let _ = buf_write_byte(dma, 2 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 3 as u32, 2 as u32);
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, want_len & (0xFF as u32));
  let _ = buf_write_byte(dma, 7 as u32, (want_len >> (8 as u32)) & (0xFF as u32));
  return 0;
}

// Round 24: bmRequestType=0x00 (host-to-device, standard, device),
// bRequest=9 (SET_CONFIGURATION), wValue=config_value, wIndex=0,
// wLength=0 -- a no-data control transfer, same shape as SET_ADDRESS.
// USB 2.0 spec chapter 9.4.7: a device sits in the non-functional
// Address state (it will answer control requests, and nothing else)
// until this request moves it to the Configured state -- every real
// device this driver will eventually need to actually exchange data
// with (a WiFi dongle's bulk/interrupt endpoints, LAN9512's own
// Ethernet bulk endpoints) needs this, not just WiFi specifically.
// Neither dwc2_probe_device0 nor dwc2_enumerate_downstream ever issued
// it before this round -- enumeration got as far as learning a
// device's identity, never as far as making it usable.
fn dwc2_build_set_configuration_setup(config_value: u32) -> i64 {
  let dma: mut ref i64 = dwc2_dma_scratch_get();
  let _ = buf_write_byte(dma, 0 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 1 as u32, 9 as u32);
  let _ = buf_write_byte(dma, 2 as u32, config_value & (0xFF as u32));
  let _ = buf_write_byte(dma, 3 as u32, (config_value >> (8 as u32)) & (0xFF as u32));
  let _ = buf_write_byte(dma, 4 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 5 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 6 as u32, 0 as u32);
  let _ = buf_write_byte(dma, 7 as u32, 0 as u32);
  return 0;
}

// Fetches the configuration descriptor (first its own fixed 9-byte
// header to learn wTotalLength/bConfigurationValue -- the same
// "short fetch to learn a length, then a full fetch" progressive
// pattern dwc2_probe_device0 already uses for the device descriptor
// -- then as much of the full interface/endpoint descriptor chain as
// fits in dwc2_dma_scratch's own 64-byte capacity), walks it counting
// INTERFACE (type 4) and ENDPOINT (type 5) descriptors -- the two
// things a real class driver (WiFi, or LAN9512's own Ethernet
// function) needs to know exist before it can do anything with
// them -- and issues SET_CONFIGURATION so the device actually leaves
// the non-functional Address state. Logs a summary but doesn't keep
// any interface/endpoint descriptor fields around: this is
// enumeration-completeness prep (get every device to a genuinely
// Configured, usable state and prove what's inside its configuration
// is visible), not the start of a class driver -- parsing individual
// endpoint addresses/types into something a future bulk-transfer
// driver would consume is real, separate work for whenever that
// driver actually gets built.
fn dwc2_fetch_and_set_configuration(devaddr: u32, mps: u32) -> i64 {
  let cfg9: mut ref i64 = dhruva_alloc_bytes(9);
  let _ = dwc2_build_get_config_descriptor_setup(9 as u32);
  let status0: i64 = dwc2_control_in(devaddr, mps, 9 as u32, cfg9);
  if status0 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Configuration) short fetch failed\n");
    return 0 - 1;
  }
  let clength: u32 = buf_read_byte(cfg9, 0 as u32);
  let cdesctype: u32 = buf_read_byte(cfg9, 1 as u32);
  if (clength != (9 as u32)) || (cdesctype != (2 as u32)) {
    let _ = uart_puts("USB: config descriptor probe (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }
  let total_lo: u32 = buf_read_byte(cfg9, 2 as u32);
  let total_hi: u32 = buf_read_byte(cfg9, 3 as u32);
  let total_length: u32 = total_lo | (total_hi << (8 as u32));
  let num_interfaces: u32 = buf_read_byte(cfg9, 4 as u32);
  let config_value: u32 = buf_read_byte(cfg9, 5 as u32);

  // dwc2_control_in's own 64-byte cap (round 3 audit -- the DMA
  // scratch buffer's real capacity) means a configuration whose
  // wTotalLength exceeds it can only be read partially here. Grab as
  // much as fits rather than failing outright -- everything counted
  // below still reflects real descriptors, just possibly not all of
  // them for an unusually large configuration (most simple devices,
  // including every one this project can attach under QEMU, fit
  // comfortably under 64 bytes).
  let full_want_len: u32 = if total_length > (64 as u32) { 64 as u32 } else { total_length };
  let truncated: i64 = if total_length > (64 as u32) { 1 } else { 0 };

  let cfgfull: mut ref i64 = dhruva_alloc_bytes(64);
  let _ = dwc2_build_get_config_descriptor_setup(full_want_len);
  let status1: i64 = dwc2_control_in(devaddr, mps, full_want_len, cfgfull);
  if status1 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Configuration) full fetch failed\n");
    return 0 - 1;
  }

  // Standard USB descriptor-chain traversal: each descriptor names its
  // own bLength (byte 0), so an unrecognized bDescriptorType (a
  // class-specific or vendor-specific descriptor, common right after
  // an INTERFACE descriptor for anything more complex than a trivial
  // device) is still skipped correctly rather than misread as
  // something fixed-size. Bounds-checked against full_want_len before
  // every read -- a corrupt or truncated descriptor chain is dropped,
  // not trusted, same "reject, don't guess" posture as every other
  // untrusted-length parse in this project (DHCP's own TLV option
  // parser, most recently).
  // Round 33: while walking this same descriptor chain, also actually
  // extract (not just count) the bulk endpoints of a USB Mass Storage
  // / SCSI / Bulk-Only Transport interface, if one is present --
  // class 0x08 (Mass Storage), subclass 0x06 (SCSI transparent
  // command set), protocol 0x50 (Bulk-Only Transport). cur_iface_is_bot
  // reflects the MOST RECENTLY seen INTERFACE descriptor's class triad
  // and is consulted at each ENDPOINT descriptor that follows it --
  // standard descriptor-chain attribution (endpoints always
  // immediately follow the interface they belong to in a well-formed
  // config descriptor), same walk this loop already does for
  // iface_count/ep_count, just also acting on what it sees instead of
  // only counting it. Reset bot=0 at the top of every call (not just
  // once at boot): this function runs once per newly-enumerated
  // device, and a non-mass-storage device (the hub itself, or a
  // usb-net gadget) must not retain a stale BOT flag/endpoints from
  // a previous call.
  let _ = usb_msd_set_bot(0 as u32);
  let pos: i64 = 0;
  let iface_count: i64 = 0;
  let ep_count: i64 = 0;
  let cur_iface_is_bot: i64 = 0;
  let found_bot: i64 = 0;
  let full_want_len_i: i64 = full_want_len as i64;
  while pos < full_want_len_i {
    let dlen: u32 = buf_read_byte(cfgfull, pos as u32);
    if dlen == (0 as u32) {
      pos = full_want_len_i; // malformed -- stop rather than loop forever
    } else {
      if (pos + 1) >= full_want_len_i {
        pos = full_want_len_i; // truncated -- can't read bDescriptorType
      } else {
        let dtype: u32 = buf_read_byte(cfgfull, (pos + 1) as u32);
        if dtype == (4 as u32) {
          iface_count = iface_count + 1;
          cur_iface_is_bot = 0;
          if (pos + 7) < full_want_len_i {
            let iclass: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let isubclass: u32 = buf_read_byte(cfgfull, (pos + 6) as u32);
            let iproto: u32 = buf_read_byte(cfgfull, (pos + 7) as u32);
            if (iclass == (0x08 as u32)) && (isubclass == (0x06 as u32)) && (iproto == (0x50 as u32)) {
              cur_iface_is_bot = 1;
              found_bot = 1;
            }
          }
        }
        if dtype == (5 as u32) {
          ep_count = ep_count + 1;
          if (cur_iface_is_bot == 1) && ((pos + 5) < full_want_len_i) {
            let ep_addr: u32 = buf_read_byte(cfgfull, (pos + 2) as u32);
            let ep_attr: u32 = buf_read_byte(cfgfull, (pos + 3) as u32);
            let ep_mps_lo: u32 = buf_read_byte(cfgfull, (pos + 4) as u32);
            let ep_mps_hi: u32 = buf_read_byte(cfgfull, (pos + 5) as u32);
            let ep_mps: u32 = ep_mps_lo | (ep_mps_hi << (8 as u32));
            // bmAttributes bits[1:0]: 2 = bulk (0=control, 1=iso,
            // 3=interrupt) -- only bulk endpoints matter for BOT.
            if (ep_attr & (0x03 as u32)) == (0x02 as u32) {
              if (ep_addr & (0x80 as u32)) != (0 as u32) {
                let _ = usb_msd_set_bulk_in_epaddr(ep_addr);
                let _ = usb_msd_set_bulk_in_mps(ep_mps);
              } else {
                let _ = usb_msd_set_bulk_out_epaddr(ep_addr);
                let _ = usb_msd_set_bulk_out_mps(ep_mps);
              }
            }
          }
        }
        pos = pos + (dlen as i64);
      }
    }
  }
  if found_bot == 1 {
    let _ = usb_msd_set_bot(1 as u32);
    // SET_CONFIGURATION (below) resets every endpoint's data toggle
    // to DATA0 per spec -- mirrored here so this driver's own toggle
    // tracking starts in sync with the device's real state.
    let _ = usb_msd_set_in_toggle(0 as u32);
    let _ = usb_msd_set_out_toggle(0 as u32);
    let _ = uart_puts("USB: mass storage (BOT) interface detected, bulk_in_ep=");
    let _ = uart_put_hex32(usb_msd_get_bulk_in_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_msd_get_bulk_in_mps());
    let _ = uart_puts(" bulk_out_ep=");
    let _ = uart_put_hex32(usb_msd_get_bulk_out_epaddr());
    let _ = uart_puts(" mps=");
    let _ = uart_put_hex32(usb_msd_get_bulk_out_mps());
    let _ = uart_puts("\n");
  }

  let _ = uart_puts("USB: config bConfigurationValue=");
  let _ = uart_put_hex32(config_value);
  let _ = uart_puts(" bNumInterfaces=");
  let _ = uart_put_hex32(num_interfaces);
  let _ = uart_puts(" wTotalLength=");
  let _ = uart_put_hex32(total_length);
  let _ = uart_puts(" interfaces_seen=");
  let _ = uart_put_hex32(iface_count as u32);
  let _ = uart_puts(" endpoints_seen=");
  let _ = uart_put_hex32(ep_count as u32);
  if truncated == 1 {
    let _ = uart_puts(" (truncated, exceeds 64-byte scratch)");
  }
  let _ = uart_puts("\n");

  let _ = dwc2_build_set_configuration_setup(config_value);
  let set_status: i64 = dwc2_control_no_data(devaddr, mps);
  if set_status != 0 {
    let _ = uart_puts("USB: SET_CONFIGURATION failed\n");
    return 0 - 1;
  }
  return 0;
}

// Round 33: USB mass storage (Bulk-Only Transport, USB Mass Storage
// Class Bulk-Only Transport spec) bring-up -- the first live caller
// of real bulk transfers anywhere in this project. Every control
// transfer above (dwc2_control_in/no_data) uses a fixed PID encoding
// specific to endpoint 0/control (see dwc2_pid_setup/data1's own
// comment); bulk endpoints use the GENERIC non-control PID/DATA-
// toggle encoding instead (0=DATA0, 1=DATA1 -- not control's 2/3),
// and unlike a control transfer's fixed per-stage toggle, a bulk
// endpoint's toggle must keep alternating correctly across every
// separate transfer for as long as the endpoint stays configured --
// tracked persistently via usb_msd_state.S, reset to DATA0 the moment
// SET_CONFIGURATION establishes the endpoint (see the detection block
// above). Otherwise this reuses dwc2_control_in/no_data's own proven
// channel-0/HCCHAR/HCTSIZ/HCDMA/dwc2_wait_chan0_done plumbing
// unchanged -- the DWC2 controller doesn't care whether channel 0 was
// last used for a control or bulk transfer, only what's programmed
// into it for the transfer about to be kicked off.
fn dwc2_bulk_pid_data0() -> u32 {
  return 0 as u32;
}
fn dwc2_bulk_pid_data1() -> u32 {
  return 1 as u32;
}

// One bulk OUT transfer (host -> device), <= 512 bytes (usb_bulk_
// data_scratch's real capacity -- round 35 raised this from 64, a cap
// that only ever needed to cover a 31-byte CBW, once READ(10)/
// WRITE(10) needed to move a full 512-byte sector through this same
// function. Uses its own dedicated scratch buffer, NOT dwc2_dma_
// scratch (still 64 bytes, still used unchanged by dwc2_control_in/
// no_data -- see usb_bulk_data_scratch_addr's own comment in
// scratch_state.S for why a separate buffer was safer than growing
// the control-transfer one those already-proven functions still use).
fn dwc2_bulk_out(devaddr: u32, mps: u32, buf: mut ref i64, out_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (out_len < 0) || (out_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_msd_get_bulk_out_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let i: i64 = 0;
  while i < out_len {
    let b: u32 = buf_read_byte(buf, i as u32);
    let _ = buf_write_byte(dma, i as u32, b);
    i = i + 1;
  }
  // Same real-hardware DMA-coherency gap dwc2_control_in's own comment
  // explains in full -- buf was just copied into dma via plain stores
  // above, before handing that same address to the DWC2 controller's
  // own DMA engine below.
  let _ = mem_barrier();

  let toggle: u32 = usb_msd_get_out_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if out_len == 0 { 1 as u32 } else { ((out_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, out_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 0 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_msd_set_out_toggle(next_toggle);
  return 0;
}

// One bulk IN transfer (device -> host), <= 512 bytes, same scratch-
// capacity reasoning as dwc2_bulk_out above.
fn dwc2_bulk_in(devaddr: u32, mps: u32, out_buf: mut ref i64, want_len: i64) -> i64 {
  if mps == (0 as u32) {
    return 0 - 1;
  }
  if (want_len < 0) || (want_len > (512 as i64)) {
    return 0 - 1;
  }
  let epaddr: u32 = usb_msd_get_bulk_in_epaddr();
  let epnum: u32 = epaddr & (0x0F as u32);
  let dma: mut ref i64 = usb_bulk_data_scratch_get();
  let hcchar0: i64 = dwc2_hcchar0_addr();
  let hctsiz0: i64 = dwc2_hctsiz0_addr();
  let hcdma0: i64 = dwc2_hcdma0_addr();

  let toggle: u32 = usb_msd_get_in_toggle();
  let pid: u32 = if toggle == (0 as u32) { dwc2_bulk_pid_data0() } else { dwc2_bulk_pid_data1() };
  let pktcnt: u32 = if want_len == 0 { 1 as u32 } else { ((want_len as u32) + mps - (1 as u32)) / mps };
  let _ = mmio_write_u32(hcdma0, ptr_to_u32(dma));
  let _ = mmio_write_u32(hctsiz0, dwc2_build_hctsiz(pid, pktcnt, want_len as u32));
  let _ = mmio_write_u32(hcchar0, dwc2_build_hcchar(devaddr, 2 as u32, 1 as u32, epnum, mps));
  let result: u32 = dwc2_wait_chan0_done();
  if (result & (1 as u32)) == (0 as u32) {
    return 0 - 1;
  }
  let i: i64 = 0;
  while i < want_len {
    let b: u32 = buf_read_byte(dma, i as u32);
    let _ = buf_write_byte(out_buf, i as u32, b);
    i = i + 1;
  }
  let next_toggle: u32 = if toggle == (0 as u32) { 1 as u32 } else { 0 as u32 };
  let _ = usb_msd_set_in_toggle(next_toggle);
  return want_len;
}

// Bulk-Only Transport command/status framing (USB Mass Storage Class
// Bulk-Only Transport spec, section 5). CBW is 31 bytes, all fields
// little-endian (see buf_write_u32_le's own comment on why this
// project needed a distinct helper from its existing network-byte-
// order ones): dCBWSignature (fixed 0x43425355, "USBC" on the wire),
// dCBWTag (arbitrary, echoed back in the CSW so a caller can confirm
// the status belongs to this exact command), dCBWDataTransferLength,
// bmCBWFlags (data stage direction, meaningless when length is 0),
// bCBWLUN, bCBWCBLength (length of the real SCSI CDB that follows),
// then the 16-byte CBWCB itself (zero-padded).
fn bot_build_cbw(out_buf: mut ref i64, tag: u32, data_len: u32, flags: u32, cb_len: u32, cdb: mut ref i64, cdb_len: i64) -> i64 {
  let _ = buf_write_u32_le(out_buf, 0, 0x43425355 as u32);
  let _ = buf_write_u32_le(out_buf, 4, tag);
  let _ = buf_write_u32_le(out_buf, 8, data_len);
  let _ = buf_write_byte(out_buf, 12 as u32, flags);
  let _ = buf_write_byte(out_buf, 13 as u32, 0 as u32); // LUN 0 -- the
                                                          // only one
                                                          // this
                                                          // project
                                                          // targets
  let _ = buf_write_byte(out_buf, 14 as u32, cb_len);
  let i: i64 = 0;
  while i < 16 {
    let b: u32 = if i < cdb_len { buf_read_byte(cdb, i as u32) } else { 0 as u32 };
    let _ = buf_write_byte(out_buf, (15 + i) as u32, b);
    i = i + 1;
  }
  return 0;
}

// Round 34: generic BOT SCSI command round trip -- CBW out (declaring
// data_len bytes of data in whichever direction is_write says, or
// data_len=0 for a command with no data stage at all), the data stage
// itself if data_len > 0, then CSW in. Round 33's own usb_msd_test_
// unit_ready originally inlined this exact shape for TEST UNIT READY
// alone (data_len=0); round 34 factored it out as usb_msd_scsi_
// command_in once INQUIRY/READ CAPACITY(10) needed the identical
// IN-direction shape. Round 35 generalized it further (renamed
// accordingly) to also cover WRITE(10)'s OUT data stage, once that
// needed the same shape with the direction flipped and a real
// DMA-capable buffer to move a full sector through (see dwc2_bulk_
// out/in's own comment on usb_bulk_data_scratch). Returns bCSWStatus
// (0=success, 1=command failed, 2=phase error) on a well-formed CSW,
// or -1 on any transport failure, a short data-stage transfer, or a
// malformed/mismatched CSW (wrong signature or tag) -- same "reject,
// don't guess" posture as every other wire-format check in this
// project.
fn usb_msd_scsi_command(devaddr: u32, cdb: mut ref i64, cdb_len: i64, tag: u32, data_len: u32, is_write: i64, data: mut ref i64) -> i64 {
  let out_mps: u32 = usb_msd_get_bulk_out_mps();
  let in_mps: u32 = usb_msd_get_bulk_in_mps();
  let flags: u32 = if (data_len > (0 as u32)) && (is_write == 0) { 0x80 as u32 } else { 0 as u32 }; // bit7: IN
  let cbw: mut ref i64 = dhruva_alloc_bytes(31);
  let _ = bot_build_cbw(cbw, tag, data_len, flags, cdb_len as u32, cdb, cdb_len);
  let out_status: i64 = dwc2_bulk_out(devaddr, out_mps, cbw, 31);
  if out_status != 0 {
    let _ = uart_puts("USB: BOT CBW send failed\n");
    return 0 - 1;
  }

  if data_len > (0 as u32) {
    if is_write == 1 {
      let data_status: i64 = dwc2_bulk_out(devaddr, out_mps, data, data_len as i64);
      if data_status != 0 {
        let _ = uart_puts("USB: BOT data-out stage failed\n");
        return 0 - 1;
      }
    } else {
      let data_status: i64 = dwc2_bulk_in(devaddr, in_mps, data, data_len as i64);
      if data_status != (data_len as i64) {
        let _ = uart_puts("USB: BOT data-in stage failed\n");
        return 0 - 1;
      }
    }
  }

  let csw: mut ref i64 = dhruva_alloc_bytes(13);
  let in_status: i64 = dwc2_bulk_in(devaddr, in_mps, csw, 13);
  if in_status != (13 as i64) {
    let _ = uart_puts("USB: BOT CSW receive failed\n");
    return 0 - 1;
  }
  let csw_sig: u32 = buf_read_u32_le(csw, 0);
  let csw_tag: u32 = buf_read_u32_le(csw, 4);
  let csw_status: u32 = buf_read_byte(csw, 12 as u32);
  if csw_sig != (0x53425355 as u32) {
    let _ = uart_puts("USB: BOT CSW bad signature\n");
    return 0 - 1;
  }
  if csw_tag != tag {
    let _ = uart_puts("USB: BOT CSW tag mismatch\n");
    return 0 - 1;
  }
  return csw_status as i64;
}

// Round 33's live milestone: TEST UNIT READY (SCSI opcode 0x00, a
// fixed 6-byte all-zero CDB -- the simplest possible SCSI command,
// with no data stage at all) sent through a real CBW/CSW round trip
// over the bulk endpoints this same boot's config-descriptor parse
// discovered. Proves the whole bulk-transfer/BOT chain end to end --
// toggle tracking, endpoint direction, CBW/CSW framing.
fn usb_msd_test_unit_ready(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(6); // all-zero: opcode 0
                                                  // (TEST UNIT READY),
                                                  // LUN/reserved/
                                                  // control all 0
  let tag: u32 = 0x54555230 as u32; // "TUR0", just a recognizable,
                                      // non-zero tag value
  // Passing cdb again as the (unused) out_data buffer: data_len=0
  // means usb_msd_scsi_command_in's own data-stage block never
  // touches it, so reusing the already-allocated cdb avoids a
  // pointless extra allocation for a buffer that's guaranteed dead.
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 6, tag, 0 as u32, 0, cdb);
  if csw_status < 0 {
    return csw_status;
  }
  let _ = uart_puts("USB: BOT TEST UNIT READY csw_status=");
  let _ = uart_put_hex32(csw_status as u32);
  if csw_status == 0 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    // A real device can legitimately report "not ready" (status=1) --
    // QEMU's usb-storage backend answers success once a real backing
    // image is attached, but this is still a genuine, well-formed BOT
    // round trip either way, not a driver failure -- only signal loud
    // FAIL-style attention for a transport-level problem (handled by
    // the two checks above), not a normal SCSI-level status.
    let _ = uart_puts(" (not ready or check condition -- transport itself OK)\n");
  }
  return csw_status;
}

// Round 34: SCSI INQUIRY (opcode 0x12) -- unlike TEST UNIT READY,
// this has a real 36-byte data-IN stage, the first this driver
// exercises. CDB byte 4 (allocation length) is a single byte here, so
// unlike READ CAPACITY(10)'s response below there's no endianness
// question for the request itself; the RESPONSE data, like every
// other SCSI data-in payload, is big-endian/most-significant-byte-
// first where it has multi-byte fields at all (INQUIRY's own don't,
// beyond the two fixed ASCII strings printed below) -- see READ_
// CAPACITY10's own comment for where that actually matters. Standard
// INQUIRY response layout: byte 0 bits[4:0] = peripheral device type,
// bytes 8-15 = vendor identification (8 ASCII chars), bytes 16-31 =
// product identification (16 ASCII chars).
fn usb_msd_inquiry(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(6);
  let _ = buf_write_byte(cdb, 0 as u32, 0x12 as u32); // INQUIRY
  let _ = buf_write_byte(cdb, 4 as u32, 36 as u32);   // allocation length
  let tag: u32 = 0x494E5130 as u32; // "INQ0"
  let data: mut ref i64 = dhruva_alloc_bytes(36);
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 6, tag, 36 as u32, 0, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: INQUIRY failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  let periph_type: u32 = buf_read_byte(data, 0 as u32) & (0x1F as u32);
  let _ = uart_puts("USB: INQUIRY peripheral_type=");
  let _ = uart_put_hex32(periph_type);
  let _ = uart_puts(" vendor=\"");
  let vi: i64 = 0;
  while vi < 8 {
    let b: u32 = buf_read_byte(data, (8 + vi) as u32);
    let _ = uart_putc(b as i64);
    vi = vi + 1;
  }
  let _ = uart_puts("\" product=\"");
  let pi: i64 = 0;
  while pi < 16 {
    let b: u32 = buf_read_byte(data, (16 + pi) as u32);
    let _ = uart_putc(b as i64);
    pi = pi + 1;
  }
  let _ = uart_puts("\" (PASS)\n");
  return 0;
}

// Round 34: SCSI READ CAPACITY(10) (opcode 0x25) -- a fixed 10-byte
// CDB (opcode plus 9 zero bytes; no allocation-length field at all,
// the response is always exactly 8 bytes), returning the device's
// last valid LBA and its block size. BOTH 4-byte response fields are
// big-endian -- SCSI's own wire convention for multi-byte data,
// confirmed against the SCSI Block Commands spec before writing this,
// distinct from (and easy to confuse with) the BOT wrapper's own
// little-endian CBW/CSW fields bot_build_cbw/usb_msd_scsi_command_in
// already handle -- reused this project's EXISTING buf_read_u32_be
// (built for Ethernet/IP/TCP/UDP's own big-endian fields) rather than
// the new buf_read_u32_le added for the BOT wrapper, precisely because
// this is the one place in the whole BOT/SCSI chain where the byte
// order actually flips back to big-endian.
fn usb_msd_read_capacity10(devaddr: u32) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10); // all-zero except opcode
  let _ = buf_write_byte(cdb, 0 as u32, 0x25 as u32); // READ CAPACITY(10)
  let tag: u32 = 0x52433130 as u32; // "RC10"
  let data: mut ref i64 = dhruva_alloc_bytes(8);
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 8 as u32, 0, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: READ CAPACITY(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  let last_lba: u32 = buf_read_u32_be(data, 0);
  let block_len: u32 = buf_read_u32_be(data, 4);
  let _ = uart_puts("USB: READ CAPACITY(10) last_lba=");
  let _ = uart_put_hex32(last_lba);
  let _ = uart_puts(" block_len=");
  let _ = uart_put_hex32(block_len);
  let _ = uart_puts(" (PASS)\n");
  return 0;
}

// Round 35: SCSI READ(10) (opcode 0x28) -- moves exactly one 512-byte
// block (this project's own established block-size convention
// throughout: the SD driver, the FS layer, and netif's own queue
// slots all already use 512 everywhere) starting at LBA lba into
// out_data (caller-owned, >= 512 bytes). CDB fields beyond the opcode
// are big-endian, same SCSI wire convention as READ CAPACITY(10)'s
// own response. This is the first command whose data stage needed
// usb_bulk_data_scratch's real 512-byte capacity (round 34's CDB/CSW
// traffic never exceeded 64 bytes).
fn usb_msd_read10(devaddr: u32, lba: u32, out_data: mut ref i64) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10);
  let _ = buf_write_byte(cdb, 0 as u32, 0x28 as u32); // READ(10)
  let _ = buf_write_u32_be(cdb, 2, lba);
  let _ = buf_write_u16_be(cdb, 7, 1 as u32); // transfer length: 1 block
  let tag: u32 = 0x52443130 as u32; // "RD10"
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 512 as u32, 0, out_data);
  if csw_status != 0 {
    let _ = uart_puts("USB: READ(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  return 0;
}

// Round 35: SCSI WRITE(10) (opcode 0x2A) -- same CDB layout as
// READ(10) above, same one-512-byte-block scope, data stage direction
// flipped to OUT (usb_msd_scsi_command's is_write=1 path).
fn usb_msd_write10(devaddr: u32, lba: u32, data: mut ref i64) -> i64 {
  let cdb: mut ref i64 = dhruva_alloc_bytes(10);
  let _ = buf_write_byte(cdb, 0 as u32, 0x2A as u32); // WRITE(10)
  let _ = buf_write_u32_be(cdb, 2, lba);
  let _ = buf_write_u16_be(cdb, 7, 1 as u32);
  let tag: u32 = 0x57523130 as u32; // "WR10"
  let csw_status: i64 = usb_msd_scsi_command(devaddr, cdb, 10, tag, 512 as u32, 1, data);
  if csw_status != 0 {
    let _ = uart_puts("USB: WRITE(10) failed, csw_status/transport=");
    let _ = uart_put_hex32(csw_status as u32);
    let _ = uart_puts("\n");
    return csw_status;
  }
  return 0;
}

// Round 35's live milestone: a real READ(10)/WRITE(10) round trip --
// write a real pattern to a real sector, read it back, and confirm
// the bytes actually match, not just that both transports reported
// success. LBA 100 is arbitrary but safely inside this project's own
// 8MB test image (16384 total 512-byte blocks) and far from block 0,
// where a real filesystem would keep boot-sector/partition-table
// metadata this driver doesn't parse or care about. Reuses
// test_fill_pattern/test_compare_buffers -- the SAME generic
// pattern-fill/compare helpers the SD driver's own 8-block round-trip
// sweep already uses for the identical shape of check, rather than
// writing a second, duplicate byte-compare loop.
fn usb_msd_read10_write10_check(devaddr: u32) -> i64 {
  let lba: u32 = 100 as u32;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = test_fill_pattern(write_buf, 512);
  let write_status: i64 = usb_msd_write10(devaddr, lba, write_buf);
  if write_status != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, write_status=");
    let _ = uart_put_hex32(write_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let read_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let read_status: i64 = usb_msd_read10(devaddr, lba, read_buf);
  if read_status != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, read_status=");
    let _ = uart_put_hex32(read_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, 512);
  if mismatch != 0 {
    let _ = uart_puts("USB: WRITE(10)/READ(10) round trip (FAIL, data mismatch)\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: WRITE(10)/READ(10) round trip lba=");
  let _ = uart_put_hex32(lba);
  let _ = uart_puts(" (PASS)\n");
  return 0;
}

// Round 36's live milestone: prove fs_block_read/fs_block_write
// (this round's own new block-device abstraction, see its comment
// right after sdhost_write_block) genuinely work against the USB mass
// storage backend too, not just SDHOST -- every real FS operation's
// own permanent default, completely untouched by this check.
// Temporarily flips fs_state's own block-device selector to USB mass
// storage, writes a real pattern to a block through the SAME
// abstraction fs_init/fs_append_raw/fs_compact/etc. call, reads it
// back through it, byte-compares, then restores the selector to
// SDHOST before returning -- this project's real FS never runs with
// anything but SDHOST selected; only this one self-check ever flips
// it, and only for the duration of these two calls. LBA 200 (distinct
// from round 35's own LBA 100, so their host-side backing-image bytes
// never interfere with each other) is arbitrary but safely inside the
// 8MB test image.
fn fs_block_dev_self_check() -> i64 {
  let lba: i64 = 200;
  let write_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let _ = test_fill_pattern(write_buf, 512);

  let _ = fs_state_set_block_dev(1 as u32);
  let write_status: i64 = fs_block_write(lba, write_buf);
  let read_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let read_status: i64 = fs_block_read(lba, read_buf);
  let _ = fs_state_set_block_dev(0 as u32); // restore before anything
                                              // else can observe it

  if write_status != 0 {
    let _ = uart_puts("USB: fs_block_write via FS abstraction (FAIL, write_status=");
    let _ = uart_put_hex32(write_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  if read_status != 0 {
    let _ = uart_puts("USB: fs_block_read via FS abstraction (FAIL, read_status=");
    let _ = uart_put_hex32(read_status as u32);
    let _ = uart_puts(")\n");
    return 0 - 1;
  }
  let mismatch: i64 = test_compare_buffers(write_buf, read_buf, 512);
  if mismatch != 0 {
    let _ = uart_puts("USB: fs_block_read/write via FS abstraction (FAIL, data mismatch)\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: fs_block_read/write via FS abstraction (PASS -- USB mass storage now a real FS backend)\n");
  return 0;
}

// The address every device answers at before the host assigns it a
// real one. Two real addresses get handed out across this driver's
// whole enumeration sequence -- 1 for whatever sits directly on the
// DWC2 root port (raspi1ap's controller always has a synthetic root
// hub there, confirmed live and byte-for-byte against QEMU's own
// hw/usb/dev-hub.c), 2 for whatever's actually plugged into that
// hub's first downstream port. No general allocator needed for more
// than that yet -- this project's own QEMU testing never attaches
// more than one real device at a time.
fn dwc2_hub_addr() -> u32 {
  return 1 as u32;
}
fn dwc2_downstream_addr() -> u32 {
  return 2 as u32;
}
fn dwc2_hub_port1() -> u32 {
  return 1 as u32;
}
// Round 23 (real-hardware-only prep, 2026-08-28): this project's own
// documented real target, the LAN9512 combo hub/Ethernet chip every
// Pi 1 Model B actually has (BCM2835 itself has no native Ethernet
// MAC), has exactly two downstream USB PHYs -- confirmed against
// Microchip's own LAN9512/LAN9512i datasheet. See dwc2_enumerate_
// downstream's own comment for why both ports get tried.
fn dwc2_hub_port2() -> u32 {
  return 2 as u32;
}

// Powers on and resets one hub downstream port, polling for the hub's
// own PORT_RESET completion rather than trusting a fixed delay.
//
// BUG (round 14 audit, 2026-08-28): this function's own comment
// (see the header comment on hub_feature_port_enable et al.) states
// the design principle in so many words -- "PORT_RESET's own
// completion has to be observed via the port's status/change bits
// rather than assumed from timing alone" -- but the code used to do
// exactly the thing that comment says it doesn't: one fixed delay,
// then a SINGLE GET_PORT_STATUS read, trusting wPortStatus's ENABLE
// bit immediately with no check that the hub had actually finished
// processing the reset yet. That's a real gap, not just a stale
// comment: unlike the ROOT port (HPRT0's ENA bit is set synchronously
// by the model itself during the very same RST-deassert MMIO write,
// per dwc2_port_reset's own extensively-verified comment), a
// downstream hub is a separate device that processes SET_PORT_
// FEATURE(PORT_RESET) asynchronously -- there's no guarantee its
// internal port state machine has finished resetting by the time the
// control transfer's STATUS stage completes on the wire, only that
// the REQUEST was received. This only worked at all because QEMU's
// emulated hub happens to finish fast enough within one 50000-unit
// delay; it would not be robust against a real hub, or even a
// differently-timed emulated one. Fixed by actually polling
// wPortChange's C_PORT_RESET bit (bit4, 0x10 -- a completely
// different numbering space from the SET/CLEAR_PORT_FEATURE feature
// selectors just above, which is why this couldn't just reuse
// hub_feature_c_port_reset()'s own value of 20) until it's genuinely
// observed set, bounded (not `while true`) like every other poll
// loop in this codebase.
//
// Returns 0 if the port came up connected+enabled, 1 if it's simply
// not connected (a normal condition -- the caller may try another
// port), -1 on a genuine hub communication failure (worth aborting
// on, not worth trying another port for).
fn dwc2_hub_bring_up_port(hub_addr: u32, hub_mps: u32, port: u32) -> i64 {
  let _ = dwc2_hub_set_port_feature(hub_addr, hub_mps, port, hub_feature_port_power());
  let _ = delay(50000);
  let _ = dwc2_hub_set_port_feature(hub_addr, hub_mps, port, hub_feature_port_reset());
  let _ = delay(50000);

  let status_buf: mut ref i64 = dhruva_alloc_bytes(4);
  let c_port_reset_bit: u32 = 0x10 as u32; // wPortChange bit4
  let reset_seen: i64 = 0;
  let port_status: u32 = 0 as u32;
  let poll_iter: i64 = 0;
  while (poll_iter < 20) && (reset_seen == 0) {
    let status_result: i64 = dwc2_hub_get_port_status(hub_addr, hub_mps, port, status_buf);
    if status_result != 0 {
      let _ = uart_puts("USB: hub GET_PORT_STATUS failed\n");
      return 0 - 1;
    }
    let change_lo: u32 = buf_read_byte(status_buf, 2 as u32);
    let change_hi: u32 = buf_read_byte(status_buf, 3 as u32);
    let port_change: u32 = change_lo | (change_hi << (8 as u32));
    if (port_change & c_port_reset_bit) != (0 as u32) {
      reset_seen = 1;
      let status_lo: u32 = buf_read_byte(status_buf, 0 as u32);
      let status_hi: u32 = buf_read_byte(status_buf, 1 as u32);
      port_status = status_lo | (status_hi << (8 as u32));
    } else {
      let _ = delay(50000);
    }
    poll_iter = poll_iter + 1;
  }
  if reset_seen == 0 {
    let _ = uart_puts("USB: hub port never reported PORT_RESET complete\n");
    return 0 - 1;
  }
  let _ = uart_puts("USB: hub port status=");
  let _ = uart_put_hex32(port_status);
  let _ = uart_puts("\n");

  let _ = dwc2_hub_clear_port_feature(hub_addr, hub_mps, port, hub_feature_c_port_reset());
  let _ = dwc2_hub_clear_port_feature(hub_addr, hub_mps, port, hub_feature_c_port_connection());

  // PORT_CONNECTION=bit0, PORT_ENABLE=bit1.
  if (port_status & (0x3 as u32)) != (0x3 as u32) {
    return 1;
  }
  return 0;
}

// Tries hub downstream port 1, then port 2, and enumerates whatever
// answers at address 0 behind whichever one actually has a device
// (a fresh, independent per-device address space -- the hub itself
// already moved to dwc2_hub_addr(), so address 0 unambiguously means
// "the downstream device" from this point on: `usb_find_device`'s own
// address-0-first lookup against the hub falls through to the hub
// class's recursive `find_device` once the hub's own addr no longer
// matches, per QEMU's hw/usb/core.c/bus.c -- confirmed by reading
// that dispatch chain before assuming a control transfer "through" a
// hub would just work). Mirrors dwc2_probe_device0's own root-port
// sequence closely on purpose: same shape of problem (bring a port
// up, then enumerate whatever answers at address 0 through it), just
// reached via hub class requests (SET_PORT_FEATURE/GET_PORT_STATUS)
// instead of HPRT0's raw register bits. Which port ends up carrying
// the device doesn't matter beyond this point -- once a port is
// enabled, address-0 control transfers reach whatever's plugged into
// it regardless of the port number, so nothing below needs to know
// which one it was.
//
// hub_mps is the hub's OWN bMaxPacketSize0, learned by the caller
// (dwc2_probe_device0) from its device descriptor fetch and passed in
// here -- round 23 audit, 2026-08-28 (real-hardware-only prep): this
// used to be a hardcoded literal 8 with a comment claiming it was
// "learned from dwc2_probe_device0's own hub descriptor fetch," which
// was misleading -- nothing actually threaded that learned value
// here, the literal just happened to match QEMU's own synthetic hub
// model, which does report bMaxPacketSize0=8. A real hub reports
// something else: confirmed against this project's real target, the
// LAN9512 combo hub/Ethernet chip every Pi 1 Model B actually has
// (BCM2835 has no native Ethernet MAC), whose hub function enumerates
// with idVendor:idProduct 0424:9512 and bMaxPacketSize0=64 -- every
// control transfer this function makes to the hub itself would have
// silently miscalculated its own transfer size against real hardware.
// The same "derive from the single learned source of truth, don't
// hardcode a number that merely matches today" fix round 11 already
// applied to netif_get_mtu().
//
// Round 23 also generalizes port 1 -> port 1-then-2: LAN9512 has
// exactly two downstream USB PHYs (confirmed against Microchip's own
// datasheet), and its internally-wired Ethernet function's specific
// port number is EEPROM-configured per board design, not a fixed
// constant ("the downstream ports... can be reordered... to support
// multiple platform designs," per that same datasheet) -- hardcoding
// "port 1 only" risks silently never finding a real device wired to
// port 2. QEMU's own synthetic root hub here only ever exposes one
// addressable port (confirmed empirically: attaching a second QEMU
// USB device at port=2 on this same bus fails with "port 2 ... not
// found"), so the port-2 fallback path is correct by inspection
// against the real datasheet, not verified behaviorally the way
// everything else in this project is -- the same category of gap as
// this project's own DVFS-wattage and USB-timing caveats elsewhere,
// flagged rather than silently assumed away. Costs nothing when
// nothing's there: the existing "not connected" handling already
// covers a genuinely empty port 2 cleanly.
fn dwc2_enumerate_downstream(hub_mps: u32) -> i64 {
  let hub_addr: u32 = dwc2_hub_addr();

  let bring_up_result: i64 = dwc2_hub_bring_up_port(hub_addr, hub_mps, dwc2_hub_port1());
  let final_result: i64 = bring_up_result;
  if bring_up_result == 1 {
    final_result = dwc2_hub_bring_up_port(hub_addr, hub_mps, dwc2_hub_port2());
  }
  if final_result != 0 {
    let _ = uart_puts("USB: no downstream device (checked both hub ports)\n");
    return 0 - 1;
  }

  let ddesc8: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = dwc2_build_get_device_descriptor_setup(8 as u32);
  let dstatus0: i64 = dwc2_control_in(0 as u32, 8 as u32, 8 as u32, ddesc8);
  if dstatus0 != 0 {
    let _ = uart_puts("USB: downstream GET_DESCRIPTOR(Device) failed\n");
    return 0 - 1;
  }
  let dmps0: u32 = buf_read_byte(ddesc8, 7 as u32);

  let downstream_addr: u32 = dwc2_downstream_addr();
  let _ = dwc2_build_set_address_setup(downstream_addr);
  let daddr_status: i64 = dwc2_control_no_data(0 as u32, dmps0);
  if daddr_status != 0 {
    let _ = uart_puts("USB: downstream SET_ADDRESS failed\n");
    return 0 - 1;
  }
  let _ = delay(50000);

  let ddesc18: mut ref i64 = dhruva_alloc_bytes(18);
  let _ = dwc2_build_get_device_descriptor_setup(18 as u32);
  let dstatus1: i64 = dwc2_control_in(downstream_addr, dmps0, 18 as u32, ddesc18);
  if dstatus1 != 0 {
    let _ = uart_puts("USB: downstream GET_DESCRIPTOR(Device) at new address failed\n");
    return 0 - 1;
  }
  let dblength: u32 = buf_read_byte(ddesc18, 0 as u32);
  let dbdesctype: u32 = buf_read_byte(ddesc18, 1 as u32);
  let dvendor_lo: u32 = buf_read_byte(ddesc18, 8 as u32);
  let dvendor_hi: u32 = buf_read_byte(ddesc18, 9 as u32);
  let dproduct_lo: u32 = buf_read_byte(ddesc18, 10 as u32);
  let dproduct_hi: u32 = buf_read_byte(ddesc18, 11 as u32);
  let d_id_vendor: u32 = dvendor_lo | (dvendor_hi << (8 as u32));
  let d_id_product: u32 = dproduct_lo | (dproduct_hi << (8 as u32));

  let _ = uart_puts("USB: enumerated downstream device addr=");
  let _ = uart_put_hex32(downstream_addr);
  let _ = uart_puts(" bMaxPacketSize0=");
  let _ = uart_put_hex32(dmps0);
  let _ = uart_puts(" idVendor=");
  let _ = uart_put_hex32(d_id_vendor);
  let _ = uart_puts(" idProduct=");
  let _ = uart_put_hex32(d_id_product);
  if (dblength != (18 as u32)) || (dbdesctype != (1 as u32)) {
    let _ = uart_puts(" (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }
  let _ = uart_puts(" (PASS)\n");

  // Round 24 (WiFi dongle enumeration prep, 2026-08-28): every device
  // this driver enumerates -- LAN9512's own Ethernet function today,
  // a real WiFi dongle eventually -- needs to actually reach the
  // Configured state before its endpoints are usable for anything.
  // See dwc2_fetch_and_set_configuration's own comment for the full
  // story; this is the downstream device's own configuration step,
  // the same one dwc2_probe_device0 does for whatever sits on the
  // root port.
  let config_status: i64 = dwc2_fetch_and_set_configuration(downstream_addr, dmps0);
  if config_status != 0 {
    return config_status;
  }
  // Round 33: if that configuration step just found a mass-storage
  // (BOT) interface, prove the new bulk-transfer/BOT chain live right
  // here, the same "verify live at boot, not just self-test" pattern
  // every USB round in this project has followed -- gated on usb_msd_
  // get_bot() so a usb-net (or any non-mass-storage) device's own
  // enumeration is completely unaffected.
  if usb_msd_get_bot() == (1 as u32) {
    // A SCSI device commonly reports CHECK CONDITION / Unit Attention
    // on the very first command after attach (a standard "something
    // changed since you last talked to me" signal, not a real
    // failure) -- confirmed live under QEMU's own usb-storage model:
    // the first TEST UNIT READY reported csw_status=1, the second
    // (identical) call reported csw_status=0. Retrying once, bounded
    // (not `while true`), matches this project's own established
    // polling discipline and real SCSI initiator convention. This
    // also happens to be a genuine second exercise of the bulk-
    // transfer data-toggle tracking across a full extra CBW-out/
    // CSW-in round trip -- exactly the kind of repeat-transfer
    // scenario a toggle bug would show up in.
    let first_status: i64 = usb_msd_test_unit_ready(downstream_addr);
    if first_status != 0 {
      let _ = usb_msd_test_unit_ready(downstream_addr);
    }
    // Round 34: two more SCSI commands over the same live bulk
    // endpoints, both exercising a real data-IN stage (TEST UNIT
    // READY above has none) -- INQUIRY for device identification,
    // READ CAPACITY(10) for the device's real sector count/size,
    // needed before any future round can actually read/write a real
    // sector.
    let _ = usb_msd_inquiry(downstream_addr);
    let _ = usb_msd_read_capacity10(downstream_addr);
    // Round 35: the actual point of this whole feature -- a real
    // sector write, then a real sector read back, over the bulk
    // endpoints this same boot's config-descriptor parse discovered.
    let _ = usb_msd_read10_write10_check(downstream_addr);
    // Round 36: prove the FS layer's own block-device abstraction
    // (fs_block_read/fs_block_write) genuinely works against this
    // same device, not just the low-level usb_msd_read10/write10
    // primitives round 35 already proved.
    let _ = fs_block_dev_self_check();
  }
  return 0;
}

// First real enumeration milestone: fetch the first 8 bytes of device
// address 0's device descriptor (every USB device answers at address
// 0 before a host assigns it a real one), confirm the two fixed
// fields a genuine device descriptor always has -- bLength=18 (byte 0)
// and bDescriptorType=1/DEVICE (byte 1) -- then assign it a real
// address (SET_ADDRESS) and re-fetch the FULL 18-byte descriptor from
// that new address, confirming addressing itself actually worked (a
// device that silently ignored SET_ADDRESS but still happened to
// answer at address 0 forever would otherwise look identical to a
// success). Prints idVendor/idProduct (bytes 8-9/10-11, little-endian)
// from the final full descriptor -- the two fields that actually
// identify which real device this is, the natural next thing an
// enumeration milestone should be able to show. A transfer
// "succeeding" but returning garbage bytes would be a much worse
// silent failure than an honest error return, the same reasoning
// behind every checksum/validation check elsewhere in this project.
fn dwc2_probe_device0() -> i64 {
  let desc8: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = dwc2_build_get_device_descriptor_setup(8 as u32);
  let status0: i64 = dwc2_control_in(0 as u32, 8 as u32, 8 as u32, desc8);
  if status0 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Device) transfer failed\n");
    return 0 - 1;
  }
  let blength0: u32 = buf_read_byte(desc8, 0 as u32);
  let bdesctype0: u32 = buf_read_byte(desc8, 1 as u32);
  let mps0: u32 = buf_read_byte(desc8, 7 as u32);
  if (blength0 != (18 as u32)) || (bdesctype0 != (1 as u32)) {
    let _ = uart_puts("USB: device0 descriptor probe (FAIL, bad bLength/bDescriptorType)\n");
    return 0 - 1;
  }

  let new_addr: u32 = dwc2_hub_addr();
  let _ = dwc2_build_set_address_setup(new_addr);
  let addr_status: i64 = dwc2_control_no_data(0 as u32, mps0);
  if addr_status != 0 {
    let _ = uart_puts("USB: SET_ADDRESS transfer failed\n");
    return 0 - 1;
  }
  // Real hardware/most devices need a short settle time after SET_
  // ADDRESS before answering at the new address -- bounded, matching
  // this project's own established pattern for any post-hardware-
  // action settle wait (the port reset sequence earlier uses the
  // same shape).
  let _ = delay(50000);

  let desc18: mut ref i64 = dhruva_alloc_bytes(18);
  let _ = dwc2_build_get_device_descriptor_setup(18 as u32);
  let status1: i64 = dwc2_control_in(new_addr, mps0, 18 as u32, desc18);
  if status1 != 0 {
    let _ = uart_puts("USB: GET_DESCRIPTOR(Device) at new address failed\n");
    return 0 - 1;
  }
  let blength1: u32 = buf_read_byte(desc18, 0 as u32);
  let bdesctype1: u32 = buf_read_byte(desc18, 1 as u32);
  let vendor_lo: u32 = buf_read_byte(desc18, 8 as u32);
  let vendor_hi: u32 = buf_read_byte(desc18, 9 as u32);
  let product_lo: u32 = buf_read_byte(desc18, 10 as u32);
  let product_hi: u32 = buf_read_byte(desc18, 11 as u32);
  let id_vendor: u32 = vendor_lo | (vendor_hi << (8 as u32));
  let id_product: u32 = product_lo | (product_hi << (8 as u32));

  let _ = uart_puts("USB: enumerated device addr=");
  let _ = uart_put_hex32(new_addr);
  let _ = uart_puts(" bMaxPacketSize0=");
  let _ = uart_put_hex32(mps0);
  let _ = uart_puts(" idVendor=");
  let _ = uart_put_hex32(id_vendor);
  let _ = uart_puts(" idProduct=");
  let _ = uart_put_hex32(id_product);
  if (blength1 != (18 as u32)) || (bdesctype1 != (1 as u32)) {
    let _ = uart_puts(" (FAIL, bad bLength/bDescriptorType after SET_ADDRESS)\n");
    return 0 - 1;
  }
  let _ = uart_puts(" (PASS)\n");

  // Round 24 (WiFi dongle enumeration prep, 2026-08-28): the hub
  // itself needs to reach the Configured state too, same as any other
  // device -- USB 2.0 spec chapter 11 hub-class requests (SET_PORT_
  // FEATURE/GET_PORT_STATUS, already in live use one call below) are
  // never actually specified as requiring it, and QEMU's own
  // synthetic hub has always answered them regardless, which is
  // exactly why this gap went unnoticed through round 14's hub-
  // enumeration work -- but per spec this is still the correct order
  // of operations, and a real hub is under no obligation to be as
  // forgiving as QEMU's model about it.
  let config_status: i64 = dwc2_fetch_and_set_configuration(new_addr, mps0);
  if config_status != 0 {
    return 0 - 1;
  }
  return dwc2_enumerate_downstream(mps0);
}

// Phase 2 priority-inversion demo. All three tasks share one mutex
// (ceiling = 0, HIGH's own priority -- the highest priority of any
// task that will ever lock it). None of the three ever calls
// yield_now (gone since Step B) -- the timer tick preempts freely
// whenever a strictly higher *effective* priority task is ready.
//
// task_c (LOW) holds the mutex for a real stretch of wall-clock time
// (the delay() inside its critical section) specifically so
// task_b (MEDIUM)'s frequent 1-tick sleep is likely to expire *during*
// that window at least once per run. Without the ceiling protocol,
// that's exactly the classic failure: MEDIUM (priority 1) would
// preempt LOW (priority 2) the instant it's ready, LOW could never
// finish and release, and task_a (HIGH, priority 0) -- which also
// wants the same mutex -- would be blocked not just by LOW's bounded
// critical section but by however long MEDIUM feels like running:
// unbounded inversion via a task that doesn't even touch the
// resource. With it, LOW's dhruva_prio_lock(0) call boosts LOW to
// priority 0 for the duration -- tied with HIGH's own true priority,
// and scheduler_pick_next's "ties favor the incumbent" rule means
// neither MEDIUM nor HIGH preempts LOW while it holds the lock, no
// matter how many tick-driven scheduling decisions happen in between.
// The bound on how long HIGH can be kept waiting is now just LOW's
// own critical-section length -- provable, not open-ended.
#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_a() -> i64 {
  while true {
    let _ = task_sleep_ticks(3);
    let _ = uart_puts("HIGH: waking, requesting resource\n");
    let _ = dhruva_prio_lock(0);
    let _ = uart_puts("HIGH: acquired resource\n");
    let _ = dhruva_prio_unlock(0);
    let _ = uart_puts("HIGH: released resource\n");
  }
  return 0;
}

#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_b() -> i64 {
  while true {
    let _ = task_sleep_ticks(1);
    let _ = uart_puts("MEDIUM: running (never touches the resource)\n");
  }
  return 0;
}

#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_c() -> i64 {
  while true {
    let _ = dhruva_prio_lock(0);
    let _ = uart_puts("LOW: locked, entering critical section\n");
    let _ = delay(3000000);
    let _ = uart_puts("LOW: leaving critical section, unlocking\n");
    let _ = dhruva_prio_unlock(2);
    let _ = task_sleep_ticks(2);
  }
  return 0;
}

// Phase 5 step 1: classical power governor -- "board-specific: the
// Phase 5 DVFS frequency/voltage *tables*" per DHRUVA_ARCHITECTURE.md
// §0's own framing (the algorithm below is the portable baseline; the
// actual MHz numbers are per-board). Three fixed levels, not a
// finer-grained table: this is a demonstration governor proving the
// architecture (deterministic, run-queue-depth-driven, fully
// QEMU-testable for logic per §7 Phase 5), not a tuned production one.
// BCM2835's ARM core on a Pi 1 Model B (ARM1176JZF-S) documents a
// settable range roughly 250-700MHz via the VideoCore mailbox's own
// "set clock rate" property tag (see governor_apply below).
fn governor_freq_low() -> i64 {
  return 250;
}
fn governor_freq_mid() -> i64 {
  return 450;
}
fn governor_freq_high() -> i64 {
  return 700;
}

// Maps run-queue depth (how many of the 5 real tasks -- HIGH/MEDIUM/
// LOW/GC/SHELL, not counting idle itself -- are ready RIGHT NOW; see
// scheduler_ready_count's own comment) to a desired frequency level.
// Deliberately a pure function with no I/O or hardware access at all:
// fully deterministic and unit-testable under QEMU regardless of
// whether governor_apply's actual mailbox write has any real effect
// in emulation (it doesn't -- QEMU doesn't model wattage, only timing;
// see DHRUVA_ARCHITECTURE.md §7 Phase 5's own caveat about this).
fn governor_desired_freq_mhz(ready_count: i64) -> i64 {
  if ready_count <= 1 {
    return governor_freq_low();
  }
  if ready_count <= 3 {
    return governor_freq_mid();
  }
  return governor_freq_high();
}

// Boot-time self-test, the same discipline as eval_self_test above:
// deterministic pure logic like this needs no live interactive input
// to verify, unlike governor_apply's own real-hardware effect.
fn governor_self_test(ready_count: i64, expected_mhz: i64) -> i64 {
  let got: i64 = governor_desired_freq_mhz(ready_count);
  let _ = uart_puts("GOVERNOR: ready_count=");
  let _ = uart_put_i64(ready_count);
  let _ = uart_puts(" -> ");
  let _ = uart_put_i64(got);
  let _ = uart_puts("MHz");
  if got == expected_mhz {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expected ");
    let _ = uart_put_i64(expected_mhz);
    let _ = uart_puts(")\n");
  }
  return 0;
}

// Phase 5 step 2: additive, fixed-cost smoothed scoring function --
// DHRUVA_ARCHITECTURE.md §7 Phase 5 step 2 ("offline-trained, fixed-
// cost scoring function re-ranking best-effort tasks and DVFS steps
// only... always wcet_cycles-bounded itself... deliberately not a
// neural network"). Weights below were fit OFFLINE (power/
// train_governor.py, a small integer grid search against a fixed
// synthetic best-effort workload replay -- run once, at development
// time, on the host; nothing about this runs, trains, or infers
// on-device) and hand-copied here as plain constants. At runtime this
// is 4 multiplies, 3 adds, and one integer divide -- always the same
// four operations regardless of input, trivially WCET-bounded, and
// never consulted for hard-RT dispatch (DVFS/best-effort only, exactly
// like step 1).
//
// What it actually buys over step 1's instantaneous-sample governor:
// step 1 reacts identically to a single-tick noise spike and genuine
// sustained load, since it only ever looks at the current sample.
// Averaging over a short history (most recent sample weighted
// heaviest, oldest lightest) damps a one-tick spike -- by the time a
// real hardware DVFS transition would complete, a one-tick blip is
// already over -- while still climbing for load that actually
// persists across several samples. Verified via power/train_governor.py
// against DHRUVA_ARCHITECTURE.md §7 Phase 5's own fixed workload
// replay: 25% fewer DVFS transitions, 16% less total MHz-time, while
// still reaching the HIGH level during the replay's sustained burst.
//
// The honest cost of this, not just the win: smoothing necessarily
// trades away some responsiveness. The same replay shows a real load
// plateau (4 ticks at a MEDIUM-triggering level) mostly staying
// suppressed at LOW, only crossing to MEDIUM on the last of those 4
// ticks -- a genuine bias/lag any moving-average governor accepts in
// exchange for not thrashing on noise, not a bug in this
// implementation specifically. See the boot-time replay self-test
// below for the exact numbers, reproduced live under QEMU.
fn governor_v2_weight0() -> i64 {
  return 6;
}
fn governor_v2_weight1() -> i64 {
  return 6;
}
fn governor_v2_weight2() -> i64 {
  return 3;
}
fn governor_v2_weight3() -> i64 {
  return 1;
}
fn governor_v2_divisor() -> i64 {
  return 16;
}

// Pure function -- takes the 4 history samples as explicit arguments
// rather than reading governor_state.S's persistent window itself, so
// it's directly replay-testable with synthetic inputs exactly like
// governor_desired_freq_mhz (v1) already is, with no hidden state to
// reset between test cases.
fn governor_desired_freq_mhz_v2(h0: i64, h1: i64, h2: i64, h3: i64) -> i64 {
  let w0: i64 = governor_v2_weight0();
  let w1: i64 = governor_v2_weight1();
  let w2: i64 = governor_v2_weight2();
  let w3: i64 = governor_v2_weight3();
  let divisor: i64 = governor_v2_divisor();
  let score: i64 = (w0 * h0 + w1 * h1 + w2 * h2 + w3 * h3) / divisor;
  return governor_desired_freq_mhz(score);
}

// Live governor step -- called from task_d (idle) below, deliberately
// NOT from the timer tick/ISR path: governor_apply_freq_mhz's mailbox
// round-trip is real hardware I/O with its own (bounded, but nonzero)
// latency, and this project's whole architecture keeps anything like
// that off the hard-RT dispatch path on purpose (see
// DHRUVA_ARCHITECTURE.md §7 Phase 5: "never consulted for hard-RT
// dispatch"). Tying it to idle specifically is a real, acknowledged
// simplification, not a full production design: it means an upward
// frequency step (system suddenly gets busy) only gets applied the
// next time idle happens to run, not instantly -- acceptable for a
// step-1 demonstration governor per the architecture doc's own
// framing ("classical governor first"), less so for a tuned one.
// BUG (round 13 audit, 2026-08-27): this used to print hex instead of
// decimal, reasoning that uart_put_i64 "allocates scratch space via
// dhruva_alloc_bytes" and task_d (this function's only caller) is
// #[no_heap]. That premise went stale at some point (uart_put_i64
// hasn't allocated on every call for a while now -- it reads a
// persistent scratch buffer via uart_digits_scratch_get instead, set
// up once at boot; see uart_put_i64's own comment) and nobody updated
// this one to match, leaving the one governor log line that actually
// matters live (this one) printing hex while every other governor
// print in this file (governor_self_test, governor_replay_test) uses
// plain decimal MHz -- forcing a reader to mentally convert hex to
// make sense of it, the only place in this subsystem that needed to.
// Confirmed empirically, not just by re-reading uart_put_i64: this
// file still builds and runs correctly calling it here, proving
// vani's own #[no_heap] checker doesn't reject it (it wouldn't have
// compiled at all if it did). Switched to uart_put_i64 for consistency
// with every other governor print. Only prints on an actual level
// change, not every idle wake, since governor_get_last_applied_mhz
// gives a cheap way to skip the mailbox round-trip (and the log spam)
// entirely when nothing changed.
fn governor_step() -> i64 {
  let ready: i64 = scheduler_ready_count();
  // Step 2 live: push the real sample into the smoothing window and
  // decide from the smoothed score, not the raw instantaneous sample
  // -- v1 (governor_desired_freq_mhz) stays fully intact and directly
  // callable (the self-test above and the replay test below both
  // still use it), per the architecture's own "additive, not a
  // replacement" framing; this is just which one actually drives the
  // live hardware call now that step 2 is proven better on the fixed
  // replay.
  let _ = governor_history_push(ready);
  let h0: i64 = governor_history_get0();
  let h1: i64 = governor_history_get1();
  let h2: i64 = governor_history_get2();
  let h3: i64 = governor_history_get3();
  let desired: i64 = governor_desired_freq_mhz_v2(h0, h1, h2, h3);
  let last: i64 = governor_get_last_applied_mhz();
  if desired != last {
    let status: i64 = governor_apply_freq_mhz(desired);
    if status == 0 {
      let _ = governor_set_last_applied_mhz(desired);
    }
    let _ = uart_puts("GOVERNOR: step ready=");
    let _ = uart_put_i64(ready);
    let _ = uart_puts(" desired_mhz=");
    let _ = uart_put_i64(desired);
    let _ = uart_puts(" apply_status=");
    let _ = uart_put_i64(status);
    let _ = uart_puts("\n");
  }
  return 0;
}

// Phase 5 step 2's actual milestone (DHRUVA_ARCHITECTURE.md §7 Phase 5:
// "measured scheduling/idle-time improvement over step-1 alone, on a
// fixed best-effort workload replay under QEMU") -- replays the EXACT
// same 30-sample synthetic workload power/train_governor.py trained
// against (kept in sync by hand; there's no way to literally share an
// array between a host Python script and a vani program, which is
// itself the whole point of "offline training, on-device only ever
// runs the fixed result") through both v1 (instantaneous) and v2
// (smoothed) governors, counting DVFS transitions and total MHz-time
// for each, live, under QEMU, at boot.
fn governor_replay_test() -> i64 {
  let workload: mut ref i64 = dhruva_alloc_bytes(30);
  let _ = buf_write_byte(workload, 0 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 1 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 2 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 3 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 4 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 5 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 6 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 7 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 8 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 9 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 10 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 11 as u32, 4 as u32);
  let _ = buf_write_byte(workload, 12 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 13 as u32, 5 as u32);
  let _ = buf_write_byte(workload, 14 as u32, 4 as u32);
  let _ = buf_write_byte(workload, 15 as u32, 3 as u32);
  let _ = buf_write_byte(workload, 16 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 17 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 18 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 19 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 20 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 21 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 22 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 23 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 24 as u32, 2 as u32);
  let _ = buf_write_byte(workload, 25 as u32, 1 as u32);
  let _ = buf_write_byte(workload, 26 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 27 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 28 as u32, 0 as u32);
  let _ = buf_write_byte(workload, 29 as u32, 0 as u32);

  let v1_transitions: i64 = 0;
  let v1_mhz_time: i64 = 0;
  let v1_prev_level: i64 = 0 - 1; // sentinel: no previous level yet
  let i: i64 = 0;
  while i < 30 {
    let sample: i64 = buf_read_byte(workload, i as u32) as i64;
    let level: i64 = governor_desired_freq_mhz(sample);
    v1_mhz_time = v1_mhz_time + level;
    if (v1_prev_level >= 0) && (level != v1_prev_level) {
      v1_transitions = v1_transitions + 1;
    }
    v1_prev_level = level;
    i = i + 1;
  }

  // Uses the SAME persistent history governor_step() will later use
  // live -- reset before and after so neither the replay's own
  // synthetic samples leak into real operation, nor (in principle) a
  // prior live run's state leaks into this test.
  let _ = governor_history_reset();
  let v2_transitions: i64 = 0;
  let v2_mhz_time: i64 = 0;
  let v2_prev_level: i64 = 0 - 1;
  let j: i64 = 0;
  while j < 30 {
    let sample2: i64 = buf_read_byte(workload, j as u32) as i64;
    let _ = governor_history_push(sample2);
    let h0: i64 = governor_history_get0();
    let h1: i64 = governor_history_get1();
    let h2: i64 = governor_history_get2();
    let h3: i64 = governor_history_get3();
    let level2: i64 = governor_desired_freq_mhz_v2(h0, h1, h2, h3);
    v2_mhz_time = v2_mhz_time + level2;
    if (v2_prev_level >= 0) && (level2 != v2_prev_level) {
      v2_transitions = v2_transitions + 1;
    }
    v2_prev_level = level2;
    j = j + 1;
  }
  let _ = governor_history_reset();

  let _ = uart_puts("GOVERNOR REPLAY: v1 transitions=");
  let _ = uart_put_i64(v1_transitions);
  let _ = uart_puts(" mhz_time=");
  let _ = uart_put_i64(v1_mhz_time);
  let _ = uart_puts("\n");
  let _ = uart_puts("GOVERNOR REPLAY: v2 transitions=");
  let _ = uart_put_i64(v2_transitions);
  let _ = uart_puts(" mhz_time=");
  let _ = uart_put_i64(v2_mhz_time);
  let _ = uart_puts("\n");

  if (v2_transitions < v1_transitions) && (v2_mhz_time < v1_mhz_time) {
    let _ = uart_puts("GOVERNOR REPLAY: v2 improves over v1 (PASS)\n");
  } else {
    let _ = uart_puts("GOVERNOR REPLAY: v2 did NOT improve over v1 (FAIL)\n");
  }
  return 0;
}

// Idle: always ready, lowest priority, never sleeps. Only ever runs
// when HIGH/MEDIUM/LOW are all genuinely asleep at the same moment --
// seeing "idle" in the log at all is a real, useful signal that the
// scheduler correctly fell through every real task's readiness check
// rather than a sign of anything wrong.
//
// Phase 5 task #1 -- "race to idle": the old body busy-waited via
// delay()'s pure spin loop, burning cycles (and, on real hardware,
// power) doing nothing between prints. cpu_wfi() actually halts
// instruction fetch until the next interrupt (the 500ms timer tick, if
// nothing else preempts sooner) instead of spinning -- the real
// hardware benefit QEMU can't put a wattage number on (see
// DHRUVA_ARCHITECTURE.md §7 Phase 5's own caveat), but the scheduling
// behavior itself (idle genuinely blocking rather than burning a fixed
// cycle count every pass) is real and observable here too.
#[no_mangle]
#[no_heap]
#[bounded_stack(bytes=512)]
fn task_d() -> i64 {
  while true {
    let _ = uart_puts("idle\n");
    let _ = governor_step();
    let _ = cpu_wfi();
  }
  return 0;
}

// Task #5: GC/compaction, running as its own dedicated best-effort
// task -- priority 3 (below every hard-RT task, above idle; see
// context_switch.S's start_multitasking comment for the reserved-band
// reasoning), never on the hard-RT path. Deliberately NOT #[no_heap]
// (unlike task_a/b/c/d above): fs_compact's re-appends genuinely need
// dhruva_alloc_bytes, and that's fine here specifically because this
// task can never preempt or block anything hard-RT -- the same
// compiler boundary that forbids heap allocation in an ISR or a
// hard-RT task doesn't need to (and structurally can't usefully)
// forbid it in a task whose whole job is best-effort background work.
// Sleeps far longer between passes than any hard-RT task's own
// period (fs_compact's own short-log check already makes a pass with
// nothing to reclaim cheap, but there's no reason to even attempt one
// every tick).
// Round 27 (2026-08-28): also this project's periodic maintenance
// heartbeat for the DHCP client -- see the comment on kernel_main's
// own live dhcp_client_start call for why nothing had ever done this
// before now. Folded into task_e rather than given a dedicated task:
// this project's scheduler has a hardcoded 6-task table
// (context_switch.S's sleep_until_table, scheduler_ready_count's own
// "6 tasks" comment), so adding a 7th would mean touching scheduler
// internals for a periodic poll that fits naturally into an already-
// existing best-effort loop instead. task_e is the right home
// specifically because it's already the one task whose whole job is
// "not hard-RT, needs heap, tolerates a multi-tick sleep between
// passes" -- exactly DHCP's own requirements too.
//
// Known, real limitation this creates rather than just theorizes
// about: netif has ONE shared FIFO queue with no per-protocol demux
// (see socket_udp_recv/icmp_poll/dhcp_client_poll/tcp_conn_poll's own
// comments on this already-accepted tradeoff) -- before this round,
// only self-tests (which run strictly sequentially, one at a time,
// before any task exists) ever touched it live. Now task_e's own
// periodic dhcp_client_poll and the shell's own live network commands
// -- `ping`'s icmp_poll (round 26), `tcpecho`'s tcp_conn_poll (round
// 29), and `udpecho`'s own inlined socket_udp_recv polling (round 30)
// -- are genuinely concurrent, independently-scheduled live consumers
// of that same queue -- any one of them can dequeue-and-drop a frame
// another was actually waiting for. Not fixed here
// (a real per-protocol receive path is a separate, larger redesign);
// flagged honestly rather than silently shipped as if it were fully
// safe.
// BUG (round 27 audit): #[bounded_stack(bytes=1024)] was already too
// tight for this task's own pre-existing fs_compact chain in
// principle (never actually caught, since nothing before this round
// added a deeper call from here) -- adding dhcp_client_poll's own
// chain (dhcp_client_check_lease -> udp_send -> udp_build ->
// udp_checksum) pushed the compiler's own static worst-case analysis
// past it for real: 1120 bytes via that exact chain, caught at
// compile time, not silently left as a real-hardware-only risk the
// way an unchecked stack depth normally would be. Raised to 2048 --
// matching task_f's own already-established bound -- for headroom,
// not just the bare minimum.
#[no_mangle]
#[bounded_stack(bytes=2048)]
fn task_e() -> i64 {
  let gc_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_path_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let compact_data_buf: mut ref i64 = dhruva_alloc_bytes(4096);
  let dhcp_my_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(dhcp_my_mac);
  while true {
    let _ = task_sleep_ticks(20);
    let _ = fs_compact(compact_buf, compact_path_buf, compact_data_buf);
    let gc_mode_len: i64 = fs_read("/config/mode", gc_buf);
    let _ = uart_puts("GC: compaction pass, /config/mode = \"");
    let _ = fs_print_data(gc_buf, gc_mode_len);
    let _ = uart_puts("\"\n");
    let _ = dhcp_client_poll(dhcp_my_mac);
  }
  return 0;
}

// Task #9: interactive shell (ls/cat/rm/write), the vani REPL entry
// point's supporting infrastructure -- everything below this comment
// through task_f parses and dispatches one already-received line out
// of shell_state.S's line buffer (irq_dispatch, in real IRQ context,
// is what actually fills it one byte at a time; see uart_rx_irq_init).
//
// Returns the index one past the first space in buf[start..line_len),
// or line_len itself if there's no space in that range -- "the rest of
// the line" then trivially reduces to the empty range [line_len, line_len).
fn shell_find_space(buf: mut ref i64, start: i64, line_len: i64) -> i64 {
  let i: i64 = start;
  while i < line_len {
    let c: u32 = buf_read_byte(buf, i as u32);
    if c == (32 as u32) {
      return i;
    }
    i = i + 1;
  }
  return line_len;
}

// True iff buf[start..end) is byte-for-byte equal to the literal
// `word` -- the only way to test a runtime line buffer against a
// known command name, since word is a Str literal (str_byte_at) and
// buf is raw shell input (buf_read_byte), two different representations
// with no shared comparison built into the language itself.
fn shell_word_matches(buf: mut ref i64, start: i64, end: i64, word: Str) -> i64 {
  let wlen: i64 = str_len_bytes(word);
  if (end - start) != wlen {
    return 0;
  }
  let i: i64 = 0;
  let ok: i64 = 1;
  while i < wlen {
    let a: u32 = buf_read_byte(buf, (start + i) as u32);
    let b: u32 = str_byte_at(word, i) as u32;
    if a != b {
      ok = 0;
    }
    i = i + 1;
  }
  return ok;
}

fn shell_copy_range(buf: mut ref i64, start: i64, end: i64, out_buf: mut ref i64) -> i64 {
  let n: i64 = end - start;
  let i: i64 = 0;
  while i < n {
    let c: u32 = buf_read_byte(buf, (start + i) as u32);
    let _ = buf_write_byte(out_buf, i as u32, c);
    i = i + 1;
  }
  return n;
}

// Round 42: minimal ASCII-decimal parser for shell command arguments
// (chmod's mode, su's uid/gid) -- a plain digit-by-digit accumulator,
// same directness as this file's other shell helpers rather than
// reaching for eval_expr_raw (that evaluator handles arithmetic
// expressions, not bare unsigned integers, and building a Str just to
// hand to a richer parser would be more machinery than this needs).
// Returns -1 if the range is empty or contains a non-digit.
fn shell_parse_decimal(buf: mut ref i64, start: i64, end: i64) -> i64 {
  if start >= end {
    return 0 - 1;
  }
  // 10 digits comfortably covers any real uid/gid/mode value while
  // staying nowhere near i64 overflow (max i64 has 19 digits) --
  // rejecting outright rather than letting a pathological input reach
  // the accumulator below and trap.
  if (end - start) > 10 {
    return 0 - 1;
  }
  let value: i64 = 0;
  let i: i64 = start;
  while i < end {
    let c: u32 = buf_read_byte(buf, i as u32);
    if (c < (48 as u32)) || (c > (57 as u32)) {
      return 0 - 1;
    }
    value = (value * 10) + ((c - (48 as u32)) as i64);
    i = i + 1;
  }
  return value;
}

// Task #10: minimal arithmetic expression evaluator -- +, -, *, /,
// parentheses, standard precedence, integers -- wired into the shell
// as `eval <expr>`. The closest thing to a "vani REPL entry point"
// achievable on bare metal: vanic itself is a host Rust program and
// can't be embedded on target. Deliberately an ITERATIVE two-stack
// (values + operators) evaluator, not recursive descent: this project
// has already hit real friction with vani's v1 checkers around
// anything not statically bounded (the UART drain loop's `while` vs
// `for`, `#[interrupt]`'s outright ban on recursion) -- a hand-rolled
// explicit-stack algorithm with a fixed max depth sidesteps that whole
// class of question instead of hoping recursion through shell_dispatch
// (already #[bounded_stack]-constrained via task_f) happens to check
// out.
//
// Values are stored as u32 words with manual sign-extension on read
// (`eval_to_i64`): `buf_write_u32`/`buf_read_u32` are u32-native, and
// vani's own `as` cast from u32 to i64 zero-extends rather than sign-
// extends, which would silently turn a stored -5 into a large positive
// number on the way back out -- every other buffer-based value in this
// file is a block number, length, or checksum, all non-negative, so
// this is the first place that gap actually mattered.

// True iff the low bit of `raw` marks it as negative (bit 31 set),
// reversing the zero-extension `as u32 -> i64` would otherwise do.
fn eval_to_i64(raw: u32) -> i64 {
  if (raw & (0x80000000 as u32)) != (0 as u32) {
    return (raw as i64) - 4294967296;
  }
  return raw as i64;
}

// BUG found in round 2's audit: the values stack below used to store
// each number as a single u32 word (4 bytes/slot) via
// `buf_write_u32(values, slot*4, n as u32)` -- silently truncating any
// value outside +-2 billion the instant it was pushed, before any
// arithmetic in eval_apply ever ran. `eval "999999999999*999999999999"`
// produced a wrong SILENT answer (no error, no hang) because both
// operands were already corrupted to small values before the multiply,
// so the multiply itself never overflowed. Fixed by storing each i64 as
// a hi/lo u32 pair, 8 bytes apart (verified round-trip for both large
// positive and negative values via a standalone test against the real
// vani-compiler on this ARM target). The `ops` stack is NOT affected --
// it only ever holds small ASCII operator codes (43/45/42/47/40), so
// its own `eval_to_i64(buf_read_u32(ops, ...))` call sites are
// unchanged.
fn eval_write_value(values: mut ref i64, slot: i64, n: i64) -> i64 {
  let lo: u32 = n as u32;
  let hi: u32 = (n >> 32) as u32;
  let _ = buf_write_u32(values, (slot * 8) as u32, lo);
  let _ = buf_write_u32(values, (slot * 8 + 4) as u32, hi);
  return 0;
}

fn eval_read_value(values: mut ref i64, slot: i64) -> i64 {
  let lo: u32 = buf_read_u32(values, (slot * 8) as u32);
  let hi: u32 = buf_read_u32(values, (slot * 8 + 4) as u32);
  return ((hi as i64) << 32) | ((lo as i64) & 4294967295);
}

fn eval_prec(op: i64) -> i64 {
  if (op == (42 as i64)) || (op == (47 as i64)) { // '*' '/'
    return 2;
  }
  if (op == (43 as i64)) || (op == (45 as i64)) { // '+' '-'
    return 1;
  }
  return 0;
}

fn eval_has_error(error_buf: mut ref i64) -> u32 {
  return buf_read_u32(error_buf, 0 as u32);
}

// BUG (found via audit, 2026-08-27, two layers deep): this function
// used to compute a+b/a-b/a*b directly (to compare against
// i64_saturating_add/sub/mul and detect overflow after the fact) and
// rely on vani's own compiler-inserted overflow trap to either not
// fire (silent wraparound, caught by the saturating comparison) or, if
// it ever DID fire, at least not be reached because the values stack
// (see eval_write_value/eval_read_value above) was truncating every
// operand to u32 before it got this far, so no real overflow was ever
// actually happening at this layer. Fixing the values-stack truncation
// bug first exposed the real problem underneath: once a and b actually
// carry their full, correct magnitude, computing the plain `a * b` for
// "999999999999*999999999999" HANGS THE ENTIRE KERNEL FOREVER on this
// exact ARM target/build (confirmed live -- QEMU output stops dead at
// that exact self-test line and never resumes even after 60s, whereas
// the identical `999999999999*999999999999` compiled standalone via
// `vanic run` panics-and-exits(3) instead of hanging; ARM-native
// codegen and lli-interpreted bitcode disagree on whether/how the trap
// fires -- a vani-compiler-level gap, out of scope to fix here).
// runtime_stubs.c's exit() is an infinite halt loop with no OS to
// return to, so ANY trap firing on this path freezes the whole kernel,
// not just the "eval" command that triggered it -- computing the
// overflowing operation at all, even just to compare it against a safe
// saturating result afterward, is not survivable here.
//
// Fixed by never executing an operation that can overflow in the first
// place: i64_add_would_overflow/i64_sub_would_overflow/
// i64_mul_would_overflow below decide purely from a and b, using only
// subtractions/comparisons/divisions that are themselves provably safe
// across the full i64 domain (see each function's own comment), and
// the real +/-/* only ever runs once that check has already proven it
// cannot overflow.
fn i64_add_would_overflow(a: i64, b: i64) -> i64 {
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  if b > 0 {
    // b>0 here, so i64_max - b is in [0, i64_max-1] -- never overflows.
    if a > (i64_max - b) {
      return 1;
    }
    return 0;
  }
  if b < 0 {
    // b<0 here (down to i64_min); i64_min - b is in [i64_min+1, -1]
    // for b > i64_min, and exactly 0 for b == i64_min -- never
    // overflows either way.
    if a < (i64_min - b) {
      return 1;
    }
    return 0;
  }
  return 0; // b == 0 never overflows
}

fn i64_sub_would_overflow(a: i64, b: i64) -> i64 {
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  if b < 0 {
    // b<0 here, so i64_max + b is in [-1, i64_max-1] -- never overflows.
    if a > (i64_max + b) {
      return 1;
    }
    return 0;
  }
  if b > 0 {
    // b>0 here, so i64_min + b is in [i64_min+1, -1] -- never overflows.
    if a < (i64_min + b) {
      return 1;
    }
    return 0;
  }
  return 0; // b == 0 never overflows
}

fn i64_mul_would_overflow(a: i64, b: i64) -> i64 {
  if (a == 0) || (b == 0) {
    return 0;
  }
  let i64_max: i64 = 9223372036854775807;
  let i64_min: i64 = 0 - 9223372036854775807 - 1;
  // i64_min is the one value that can't be negated (-i64_min doesn't
  // fit in i64) -- handled explicitly so the abs_a/abs_b step below
  // never has to negate it.
  if a == i64_min {
    if b == 1 {
      return 0;
    }
    return 1;
  }
  if b == i64_min {
    if a == 1 {
      return 0;
    }
    return 1;
  }
  let abs_a: i64 = a;
  if a < 0 {
    abs_a = 0 - a;
  }
  let abs_b: i64 = b;
  if b < 0 {
    abs_b = 0 - b;
  }
  // abs_a * abs_b overflows i64 iff abs_a > i64_max / abs_b (both
  // sides already known positive and neither is i64_min at this
  // point, so this division is always safe).
  if abs_a > (i64_max / abs_b) {
    return 1;
  }
  return 0;
}

fn eval_apply(op: i64, a: i64, b: i64, error_buf: mut ref i64) -> i64 {
  if op == (43 as i64) { // '+'
    if i64_add_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a + b;
  }
  if op == (45 as i64) { // '-'
    if i64_sub_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a - b;
  }
  if op == (42 as i64) { // '*'
    if i64_mul_would_overflow(a, b) == 1 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a * b;
  }
  if op == (47 as i64) { // '/'
    if b == 0 {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    // i64::MIN / -1 is the one division that itself overflows (the
    // mathematical result, 2^63, doesn't fit in i64) -- not caught by
    // the b==0 check above, and (per this function's own history
    // above) a raw division trap here would hit the exact same "no OS
    // to return to" hang risk as +/-/* did.
    if (a == (0 - 9223372036854775807 - 1)) && (b == (0 - 1)) {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      return 0;
    }
    return a / b;
  }
  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
  return 0;
}

// Evaluates buf[0..expr_len) as an arithmetic expression. error_buf[0]
// is set to 1 on any malformed input, unbalanced parens, stack overflow
// (more than 16 nested values/operators -- generous for anything that
// fits in the shell's own 128-byte line buffer), or division by zero;
// the returned i64 is meaningless whenever error_buf[0] is nonzero.
fn eval_expr_raw(buf: mut ref i64, expr_len: i64, error_buf: mut ref i64) -> i64 {
  let _ = buf_write_u32(error_buf, 0 as u32, 0 as u32);
  let values: mut ref i64 = eval_values_scratch_get(); // 16 slots * 8 bytes (see eval_write_value/eval_read_value)
  let ops: mut ref i64 = eval_ops_scratch_get();
  let vtop: i64 = 0;
  let otop: i64 = 0;
  let i: i64 = 0;
  // true if the NEXT token should start a value (a number, '(', or a
  // unary '-') rather than a binary operator or ')' -- what tells
  // "3 - 4" (binary) apart from "3 * -4" (unary) at the same '-' byte.
  let expect_value: i64 = 1;

  while (i < expr_len) && (eval_has_error(error_buf) == 0) {
    let c: u32 = buf_read_byte(buf, i as u32);
    if c == (32 as u32) {
      i = i + 1;
    } else {
      if (c >= (48 as u32)) && (c <= (57 as u32)) {
        let n: i64 = 0;
        // Same overflow-detection fix as eval_apply's own comment
        // explains in full -- a long enough digit run (e.g. 25+
        // digits) overflows i64 here too, before the value even
        // reaches an operator, and this build's overflow trap
        // doesn't reliably fire on this target either.
        while (i < expr_len) && (buf_read_byte(buf, i as u32) >= (48 as u32)) && (buf_read_byte(buf, i as u32) <= (57 as u32)) && (eval_has_error(error_buf) == 0) {
          let d: u32 = buf_read_byte(buf, i as u32);
          let digit: i64 = (d - (48 as u32)) as i64;
          // n and digit are always >= 0 here, so (i64_max - digit) can
          // never overflow (digit is at most 9) -- same "check before
          // you compute" discipline as eval_apply's i64_*_would_overflow
          // helpers, needed for the identical reason: actually computing
          // n*10+digit before checking it can hang the whole kernel on
          // this target once it truly overflows (see eval_apply's own
          // comment for the full story).
          if n > ((9223372036854775807 - digit) / 10) {
            let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
          } else {
            n = n * 10 + digit;
          }
          i = i + 1;
        }
        if vtop >= 16 {
          let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
        } else {
          let _ = eval_write_value(values, vtop, n);
          vtop = vtop + 1;
          expect_value = 0;
        }
      } else {
        if c == (40 as u32) { // '('
          if otop >= 16 {
            let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
          } else {
            let _ = buf_write_u32(ops, (otop * 4) as u32, 40 as u32);
            otop = otop + 1;
            i = i + 1;
            expect_value = 1;
          }
        } else {
          if c == (41 as u32) { // ')'
            let found_open: i64 = 0;
            while (otop > 0) && (found_open == 0) && (eval_has_error(error_buf) == 0) {
              let top_op: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
              if top_op == (40 as u32) {
                otop = otop - 1;
                found_open = 1;
              } else {
                if vtop < 2 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let b: i64 = eval_read_value(values, vtop - 1);
                  let a: i64 = eval_read_value(values, vtop - 2);
                  vtop = vtop - 2;
                  otop = otop - 1;
                  let r: i64 = eval_apply(top_op as i64, a, b, error_buf);
                  let _ = eval_write_value(values, vtop, r);
                  vtop = vtop + 1;
                }
              }
            }
            if found_open == 0 {
              let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
            } else {
              i = i + 1;
              expect_value = 0;
            }
          } else {
            if (c == (43 as u32)) || (c == (45 as u32)) || (c == (42 as u32)) || (c == (47 as u32)) {
              if (expect_value == 1) && (c == (45 as u32)) {
                // Unary minus: push a 0 operand so "-4" becomes the
                // equivalent binary expression "0 - 4".
                if vtop >= 16 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let _ = eval_write_value(values, vtop, 0);
                  vtop = vtop + 1;
                }
              } else {
                if expect_value == 1 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                }
              }
              if eval_has_error(error_buf) == 0 {
                let op_i: i64 = c as i64;
                while (otop > 0) && (eval_has_error(error_buf) == 0) && (eval_prec(eval_to_i64(buf_read_u32(ops, ((otop - 1) * 4) as u32))) >= eval_prec(op_i)) {
                  let top_op2: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
                  if vtop < 2 {
                    let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                  } else {
                    let b2: i64 = eval_read_value(values, vtop - 1);
                    let a2: i64 = eval_read_value(values, vtop - 2);
                    vtop = vtop - 2;
                    otop = otop - 1;
                    let r2: i64 = eval_apply(top_op2 as i64, a2, b2, error_buf);
                    let _ = eval_write_value(values, vtop, r2);
                    vtop = vtop + 1;
                  }
                }
                if otop >= 16 {
                  let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
                } else {
                  let _ = buf_write_u32(ops, (otop * 4) as u32, op_i as u32);
                  otop = otop + 1;
                  i = i + 1;
                  expect_value = 1;
                }
              }
            } else {
              let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
            }
          }
        }
      }
    }
  }

  while (otop > 0) && (eval_has_error(error_buf) == 0) {
    let top_op3: u32 = buf_read_u32(ops, ((otop - 1) * 4) as u32);
    if top_op3 == (40 as u32) {
      let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32); // unbalanced '('
    } else {
      if vtop < 2 {
        let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
      } else {
        let b3: i64 = eval_read_value(values, vtop - 1);
        let a3: i64 = eval_read_value(values, vtop - 2);
        vtop = vtop - 2;
        otop = otop - 1;
        let r3: i64 = eval_apply(top_op3 as i64, a3, b3, error_buf);
        let _ = eval_write_value(values, vtop, r3);
        vtop = vtop + 1;
      }
    }
  }

  if (vtop != 1) || (eval_has_error(error_buf) != 0) {
    let _ = buf_write_u32(error_buf, 0 as u32, 1 as u32);
    return 0;
  }
  return eval_read_value(values, 0);
}

// Boot-time self-test for eval_expr_raw, run from kernel_main() below
// with a fixed set of hand-picked cases -- the same "verify at boot,
// print PASS/FAIL, read the log" discipline every other kernel_main
// self-test in this file already uses, and the ONLY verification
// available for this feature in this sandbox: end-to-end interactive
// testing (typing "eval 2+3" at the shell and reading the reply) is
// blocked by a QEMU/environment issue where stdin never reaches either
// BCM2835 UART's hardware FIFO at all (see task #9's memory writeup) --
// nothing to do with this evaluator's own correctness, which this
// self-test can still fully exercise via a Str literal converted to a
// buffer, the same conversion fs_append does for its own path/data
// arguments.
fn eval_self_test(expr: Str, expected: i64, expect_error: i64) -> i64 {
  let expr_len: i64 = str_len_bytes(expr);
  let expr_buf: mut ref i64 = fs_data_scratch_get(); // 4096 bytes (round 39), ample for a 128-byte expr; unused by FS during eval
  let i: i64 = 0;
  while i < expr_len {
    let _ = buf_write_byte(expr_buf, i as u32, str_byte_at(expr, i) as u32);
    i = i + 1;
  }
  let error_buf: mut ref i64 = fs_path_scratch_get(); // 32 bytes, ample for a 4-byte flag; unused by FS during eval
  let result: i64 = eval_expr_raw(expr_buf, expr_len, error_buf);
  let got_error: u32 = eval_has_error(error_buf);

  let _ = uart_puts("EVAL: \"");
  let _ = uart_puts(expr);
  let _ = uart_puts("\" = ");
  if got_error != (0 as u32) {
    let _ = uart_puts("error");
  } else {
    let _ = uart_put_i64(result);
  }

  let ok: i64 = 0;
  if (expect_error == 1) && (got_error != (0 as u32)) {
    ok = 1;
  }
  if (expect_error == 0) && (got_error == (0 as u32)) && (result == expected) {
    ok = 1;
  }
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expected ");
    if expect_error == 1 {
      let _ = uart_puts("error");
    } else {
      let _ = uart_put_i64(expected);
    }
    let _ = uart_puts(")\n");
  }
  return 0;
}

// Parses and runs exactly one already-complete shell line. Deliberately
// NOT #[no_heap] (same reasoning as task_e's GC pass above): every
// scratch buffer here is a fresh dhruva_alloc_bytes, and this task can
// never preempt or block anything on the hard-RT path, so the
// restriction that protects that path doesn't need to apply here too.
fn shell_dispatch() -> i64 {
  let line_len: i64 = shell_get_line_len() as i64;
  if line_len == 0 {
    return 0;
  }
  let line_buf: mut ref i64 = shell_line_scratch_get();
  let i: i64 = 0;
  while i < line_len {
    let c: u32 = shell_get_line_byte(i as u32);
    let _ = buf_write_byte(line_buf, i as u32, c);
    i = i + 1;
  }

  let cmd_end: i64 = shell_find_space(line_buf, 0, line_len);

  if shell_word_matches(line_buf, 0, cmd_end, "ls") == 1 {
    // Round 42: bare "ls" keeps its original flat, every-live-record
    // behavior unchanged (phase4_milestone.py's own "ls shows
    // /milestone/note" check depends on that exact full-path output).
    // "ls <dir>" is new -- real single-level directory listing via
    // fs_list_dir, distinguishing files from subdirectories instead
    // of printing every full path flatly.
    if cmd_end >= line_len {
      let _ = fs_list("");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    if path_len == 0 {
      let _ = fs_list("");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    // fs_list_dir_raw (not the Str-based fs_list_dir) directly -- same
    // raw-buffer boundary reasoning as cat/write/rm above: the shell
    // only ever has a path as bytes copied out of its line buffer,
    // with no Str form to build from arbitrary bytes.
    let dir_buf: mut ref i64 = fs_dir_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, dir_buf);
    let dummy: mut ref i64 = fs_stat_scratch_get();
    let _ = fs_list_dir_raw(dir_buf, path_len, dummy, 0);
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "cat") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: cat <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    // BUG (round 12 audit, 2026-08-27): a double space right after the
    // command name (e.g. "cat  /foo") used to parse as a legitimate,
    // silently EMPTY path (path_start landed exactly on the second
    // space, so shell_find_space returned immediately) rather than
    // failing the same way a genuinely missing argument already does
    // above -- the intended path was silently swallowed instead of
    // ever being looked at. Harmless for `cat` specifically (an empty
    // path just reports "(not found)"), but the identical parsing gap
    // in `rm`/`write` right below is worse: it silently succeeds
    // ("ok") while writing a real, permanently-wasted record keyed to
    // an empty path, misleading the user into thinking their actual
    // command ran. Fixed uniformly across all three path-taking
    // commands with the same "usage" rejection an outright-missing
    // argument already gets.
    if path_len == 0 {
      let _ = uart_puts("usage: cat <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = fs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let out_buf: mut ref i64 = fs_data_scratch_get();
    // Round 42: permission-checked, as the current shell user
    // (fs_user_get_uid/gid) -- not the raw, unchecked primitive.
    let data_len: i64 = fs_read_raw_checked(path_buf, path_len, out_buf, fs_user_get_uid(), fs_user_get_gid());
    if data_len == (0 - 2) {
      let _ = uart_puts("permission denied\n");
    } else {
      if data_len < 0 {
        let _ = uart_puts("(not found)\n");
      } else {
        let _ = fs_print_data(out_buf, data_len);
        let _ = uart_puts("\n");
      }
    }
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "rm") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: rm <path>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    let path_len: i64 = path_end - path_start;
    // See cat's own identical fix above for why this check exists --
    // here specifically, a double-space typo used to silently write a
    // real, wasted tombstone record keyed to an empty path while still
    // reporting "ok", as if the user's actual `rm` had succeeded.
    if path_len == 0 {
      let _ = uart_puts("usage: rm <path>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = fs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let status: i64 = fs_delete_raw_checked(path_buf, path_len, fs_user_get_uid(), fs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        let _ = uart_puts("error\n");
      }
    }
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "write") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    // See cat's own identical fix above for why this check exists --
    // here specifically, a double-space typo right after "write" used
    // to silently write real, permanent data keyed to an empty path
    // while still reporting "ok", as if it had gone to the path the
    // user actually typed. (path_end >= line_len above already rejects
    // a double space right before the text, e.g. "write /path  " with
    // no text following, but not this earlier one.)
    if path_len == 0 {
      let _ = uart_puts("usage: write <path> <text>\n");
      return 0;
    }
    if path_len > 32 {
      let _ = uart_puts("error: path too long\n");
      return 0;
    }
    let text_start: i64 = path_end + 1;
    let text_len: i64 = line_len - text_start;
    // Round 39: matches fs_file_max_len(), though in practice the
    // shell's own 128-byte line buffer (shell_line_scratch) already
    // makes this unreachable -- kept accurate to the real FS-layer cap
    // regardless, rather than left stale at the old 464-byte number.
    if text_len > (fs_file_max_len() as i64) {
      let _ = uart_puts("error: text too long\n");
      return 0;
    }
    let path_buf: mut ref i64 = fs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    let data_buf: mut ref i64 = fs_data_scratch_get();
    let _ = shell_copy_range(line_buf, text_start, line_len, data_buf);
    let status: i64 = fs_write_raw_checked(path_buf, path_len, data_buf, text_len, fs_user_get_uid(), fs_user_get_gid());
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      if status == (0 - 2) {
        let _ = uart_puts("permission denied\n");
      } else {
        let _ = uart_puts("error\n");
      }
    }
    return 0;
  }

  // Round 42: show the active permission-check context. Dhruva has no
  // login yet, so this is always uid 0 (root) unless a session used
  // `su` (below) to switch it.
  if shell_word_matches(line_buf, 0, cmd_end, "id") == 1 {
    let _ = uart_puts("uid=");
    let _ = uart_put_i64(fs_user_get_uid() as i64);
    let _ = uart_puts(" gid=");
    let _ = uart_put_i64(fs_user_get_gid() as i64);
    let _ = uart_puts("\n");
    return 0;
  }

  // Round 42: switch the active user/group context, so cat/write/rm's
  // permission checks (and fs_append's owner-on-create default) run
  // as someone other than root -- the only way to exercise real
  // enforcement from the live shell rather than just self-tests,
  // since there's no login flow to arrive as a non-root user through.
  if shell_word_matches(line_buf, 0, cmd_end, "su") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: su <uid> <gid>\n");
      return 0;
    }
    let uid_start: i64 = cmd_end + 1;
    let uid_end: i64 = shell_find_space(line_buf, uid_start, line_len);
    if uid_end >= line_len {
      let _ = uart_puts("usage: su <uid> <gid>\n");
      return 0;
    }
    let gid_start: i64 = uid_end + 1;
    let gid_end: i64 = shell_find_space(line_buf, gid_start, line_len);
    let uid: i64 = shell_parse_decimal(line_buf, uid_start, uid_end);
    let gid: i64 = shell_parse_decimal(line_buf, gid_start, gid_end);
    if (uid < 0) || (gid < 0) {
      let _ = uart_puts("usage: su <uid> <gid> (both non-negative integers)\n");
      return 0;
    }
    let _ = fs_user_set(uid as u32, gid as u32);
    let _ = uart_puts("ok\n");
    return 0;
  }

  // Round 42: change an existing file's permission bits. Mode is a
  // plain decimal number matching the standard octal bit layout (e.g.
  // 420 = 0o644 = rw-r--r--) -- see fs_check_permission's own comment
  // for the exact bit assignment. Requires the file to already exist;
  // ownership is unaffected (see fs_chmod's own doc comment).
  if shell_word_matches(line_buf, 0, cmd_end, "chmod") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_start: i64 = cmd_end + 1;
    let path_end: i64 = shell_find_space(line_buf, path_start, line_len);
    if path_end >= line_len {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_len: i64 = path_end - path_start;
    if (path_len == 0) || (path_len > 32) {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let mode_start: i64 = path_end + 1;
    let mode_end: i64 = shell_find_space(line_buf, mode_start, line_len);
    let mode: i64 = shell_parse_decimal(line_buf, mode_start, mode_end);
    if mode < 0 {
      let _ = uart_puts("usage: chmod <path> <mode-decimal, e.g. 420 for rw-r--r-->\n");
      return 0;
    }
    let path_buf: mut ref i64 = fs_path_scratch_get();
    let _ = shell_copy_range(line_buf, path_start, path_end, path_buf);
    // fs_chmod itself takes a Str; the shell only has the path as raw
    // bytes in path_buf -- fs_stat_raw/fs_read_raw/fs_append_raw all
    // work on raw buffers directly, so this reimplements fs_chmod's
    // own three-step "stat, read, re-append" shape against path_buf
    // instead of round-tripping through a Str.
    let meta_buf: mut ref i64 = fs_stat_scratch_get();
    let stat_status: i64 = fs_stat_raw(path_buf, path_len, meta_buf);
    if stat_status != 0 {
      let _ = uart_puts("(not found)\n");
      return 0;
    }
    let owner_uid: u32 = buf_read_u32(meta_buf, 0 as u32);
    let owner_gid: u32 = buf_read_u32(meta_buf, 4 as u32);
    let data_buf: mut ref i64 = fs_data_scratch_get();
    let data_len: i64 = fs_read_raw(path_buf, path_len, data_buf);
    if data_len < 0 {
      let _ = uart_puts("(not found)\n");
      return 0;
    }
    let status: i64 = fs_append_raw(path_buf, path_len, data_buf, data_len, owner_uid, owner_gid, mode as u32);
    if status == 0 {
      let _ = uart_puts("ok\n");
    } else {
      let _ = uart_puts("error\n");
    }
    return 0;
  }

  if shell_word_matches(line_buf, 0, cmd_end, "eval") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: eval <expr>\n");
      return 0;
    }
    let expr_start: i64 = cmd_end + 1;
    let expr_len: i64 = line_len - expr_start;
    let expr_buf: mut ref i64 = fs_data_scratch_get();
    let _ = shell_copy_range(line_buf, expr_start, line_len, expr_buf);
    let error_buf: mut ref i64 = fs_path_scratch_get();
    let result: i64 = eval_expr_raw(expr_buf, expr_len, error_buf);
    if eval_has_error(error_buf) != (0 as u32) {
      let _ = uart_puts("error\n");
    } else {
      let _ = uart_put_i64(result);
      let _ = uart_puts("\n");
    }
    return 0;
  }

  // Round 26: a real, interactively-typeable "ping" command -- the
  // first live caller of round 22's own arp_resolve_start/poll (built
  // that round, self-tested on its own merits, but never wired into
  // anything that actually used it) and round 25's icmp_ping_start/
  // poll. src_ip is whatever DHCP has actually leased (0.0.0.0/
  // "unset" if nothing has bound yet, same as any real host with no
  // configured address) rather than a fixed constant.
  if shell_word_matches(line_buf, 0, cmd_end, "ping") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: ping <a.b.c.d>\n");
      return 0;
    }
    let ip_start: i64 = cmd_end + 1;
    let ip_end: i64 = shell_find_space(line_buf, ip_start, line_len);
    let ip_len: i64 = ip_end - ip_start;
    // Same double-space-typo rejection round 12 already established
    // uniformly for cat/rm/write -- a missing argument and an empty
    // one right after the command name must both be caught the same
    // way, not just the former.
    if ip_len == 0 {
      let _ = uart_puts("usage: ping <a.b.c.d>\n");
      return 0;
    }
    let dst_ip_parsed: i64 = ip_parse_dotted_quad(line_buf, ip_start, ip_end);
    if dst_ip_parsed < 0 {
      let _ = uart_puts("ping: invalid IP address\n");
      return 0;
    }
    let dst_ip: u32 = dst_ip_parsed as u32;
    let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let _ = netif_get_mac(my_mac);
    let my_ip: u32 = dhcp_state_get_leased_ip();

    let dst_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let resolved: i64 = 0;
    if dst_ip == my_ip {
      // Pinging yourself never needs real ARP resolution -- same
      // loopback shortcut every self-test in this project's own
      // networking layer already uses, and (under QEMU specifically)
      // the ONLY case that can ever actually succeed, since there is
      // no real second host on this project's only tested link to
      // answer an ARP request for anything else.
      let mi: i64 = 0;
      while mi < 6 {
        let mb: u32 = buf_read_byte(my_mac, mi as u32);
        let _ = buf_write_byte(dst_mac, mi as u32, mb);
        mi = mi + 1;
      }
      resolved = 1;
    } else {
      if arp_cache_lookup(dst_ip, dst_mac) == 1 {
        resolved = 1;
      } else {
        // Correct by design for real hardware, not verifiable under
        // QEMU (same honest-limitation category rounds 23/24 already
        // established) -- nothing will ever answer this request under
        // QEMU's loopback-only netif, so this bounded wait always
        // runs its full course and reports "could not resolve" for
        // any dst_ip other than my_ip when tested here. Bounded (not
        // `while true`), matching every other poll loop in this
        // codebase.
        let _ = arp_resolve_start(my_mac, my_ip, dst_ip);
        let arp_iter: i64 = 0;
        while (arp_iter < 20) && (resolved == 0) {
          let arp_result: i64 = arp_resolve_poll(dst_ip);
          if arp_result == 1 {
            if arp_cache_lookup(dst_ip, dst_mac) == 1 {
              resolved = 1;
            }
          } else {
            let _ = delay(50000);
          }
          arp_iter = arp_iter + 1;
        }
      }
    }
    if resolved == 0 {
      let _ = uart_puts("ping: could not resolve ");
      let _ = uart_put_ip(dst_ip);
      let _ = uart_puts("\n");
      return 0;
    }

    let identifier: u32 = 0x0042 as u32;
    let seq: u32 = 1 as u32;
    let payload: mut ref i64 = dhruva_alloc_bytes(4);
    let _ = buf_write_byte(payload, 0 as u32, 112 as u32); // "ping"
    let _ = buf_write_byte(payload, 1 as u32, 105 as u32);
    let _ = buf_write_byte(payload, 2 as u32, 110 as u32);
    let _ = buf_write_byte(payload, 3 as u32, 103 as u32);

    let send_status: i64 = icmp_ping_start(my_mac, dst_mac, my_ip, dst_ip, identifier, seq, payload, 4);
    if send_status != 0 {
      let _ = uart_puts("ping: send failed\n");
      return 0;
    }
    let _ = uart_puts("PING ");
    let _ = uart_put_ip(dst_ip);
    let _ = uart_puts("\n");

    // Bounded wait for the reply -- icmp_poll's own live auto-
    // responder is what actually answers a self-ping (it dequeues our
    // own just-sent request on an earlier iteration of this same
    // loop, exactly like icmp_self_test's own two-poll pattern, just
    // generalized into a retry loop here instead of two fixed calls).
    let recv_payload: mut ref i64 = dhruva_alloc_bytes(4);
    let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
    let got_reply: i64 = 0;
    let poll_iter: i64 = 0;
    while (poll_iter < 20) && (got_reply == 0) {
      let poll_result: i64 = icmp_poll(my_mac, my_ip, recv_payload, 4, recv_meta);
      if poll_result >= 0 {
        let reply_identifier: u32 = buf_read_u16_be(recv_meta, 4);
        let reply_seq: u32 = buf_read_u16_be(recv_meta, 6);
        if (reply_identifier == identifier) && (reply_seq == seq) {
          got_reply = 1;
        }
      }
      if got_reply == 0 {
        let _ = delay(50000);
      }
      poll_iter = poll_iter + 1;
    }
    if got_reply == 1 {
      let _ = uart_puts("reply from ");
      let _ = uart_put_ip(buf_read_u32_be(recv_meta, 0));
      let _ = uart_puts(" seq=");
      let _ = uart_put_i64(seq as i64);
      let _ = uart_puts("\n");
    } else {
      let _ = uart_puts("ping: no reply\n");
    }
    return 0;
  }

  // Round 28: a live network-status command -- until now, the only
  // way to see what round 27's own live DHCP client or netif's own
  // MAC actually reported this boot was scrolling back through boot
  // log output; nothing let a user ask "what's my network state
  // right now" interactively. Deliberately just reads and prints
  // existing state (dhcp_state_get_client_state/leased_ip/lease_time,
  // netif_get_mac) rather than performing any network activity of its
  // own, so it's always safe to run regardless of what else is
  // happening on netif's own shared queue (see task_e's own comment
  // on that queue's concurrent-consumer hazard) and fully
  // deterministic to test.
  if shell_word_matches(line_buf, 0, cmd_end, "ifconfig") == 1 {
    let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let _ = netif_get_mac(my_mac);
    let _ = uart_puts("mac ");
    let mi: i64 = 0;
    while mi < 6 {
      let mb: u32 = buf_read_byte(my_mac, mi as u32);
      let _ = uart_put_hex_byte(mb);
      if mi < 5 {
        let _ = uart_puts(":");
      }
      mi = mi + 1;
    }
    let _ = uart_puts("\n");

    let client_state: u32 = dhcp_state_get_client_state();
    let _ = uart_puts("dhcp state=");
    // Mutually exclusive by construction (client_state is only ever
    // set to one of these six named constants) -- separate top-level
    // checks rather than an if/else-if chain, matching this file's
    // own established style for multi-way state dispatch (see
    // dhcp_client_poll's own message-type branches).
    if client_state == dhcp_state_init() { let _ = uart_puts("INIT"); }
    if client_state == dhcp_state_selecting() { let _ = uart_puts("SELECTING"); }
    if client_state == dhcp_state_requesting() { let _ = uart_puts("REQUESTING"); }
    if client_state == dhcp_state_bound() { let _ = uart_puts("BOUND"); }
    if client_state == dhcp_state_renewing() { let _ = uart_puts("RENEWING"); }
    if client_state == dhcp_state_rebinding() { let _ = uart_puts("REBINDING"); }
    let _ = uart_puts(" ip=");
    let _ = uart_put_ip(dhcp_state_get_leased_ip());
    let lease_time: u32 = dhcp_state_get_lease_time();
    if lease_time != (0 as u32) {
      let _ = uart_puts(" lease=");
      let _ = uart_put_i64(lease_time as i64);
      let _ = uart_puts("s");
    }
    let _ = uart_puts("\n");
    return 0;
  }

  // Round 31: a read-only diagnostic exposing two pieces of state that
  // are already genuinely live (the ARP cache, driven by `ping` since
  // round 26; TCP connection slots, driven by `tcpecho` since round
  // 29) but that a user could previously only infer from a command's
  // side effects, never inspect directly. Unlike ping/tcpecho/udpecho,
  // this sends no traffic of its own -- pure state dump via the
  // existing arp_cache_get_*/tcp_conn_get_* accessors, same "expose
  // what's already there, don't add new protocol plumbing" shape as
  // ifconfig above.
  if shell_word_matches(line_buf, 0, cmd_end, "netstat") == 1 {
    let _ = uart_puts("ARP cache:\n");
    let arp_count: u32 = arp_cache_get_count();
    let ai: u32 = 0 as u32;
    while ai < arp_count {
      let _ = uart_puts("  ");
      let _ = uart_put_ip(arp_cache_get_ip(ai));
      let _ = uart_puts(" -> ");
      let macs: mut ref i64 = arp_cache_get_macs_buf();
      let base: u32 = ai * (6 as u32);
      let mi: i64 = 0;
      while mi < 6 {
        let mb: u32 = buf_read_byte(macs, base + (mi as u32));
        let _ = uart_put_hex_byte(mb);
        if mi < 5 {
          let _ = uart_puts(":");
        }
        mi = mi + 1;
      }
      let _ = uart_puts("\n");
      ai = ai + (1 as u32);
    }
    if arp_count == (0 as u32) {
      let _ = uart_puts("  (empty)\n");
    }

    let _ = uart_puts("TCP connections:\n");
    let conn_id: u32 = 0 as u32;
    while conn_id < (2 as u32) {
      let state: u32 = tcp_conn_get_state(conn_id);
      let _ = uart_puts("  conn ");
      let _ = uart_put_i64(conn_id as i64);
      let _ = uart_puts(" state=");
      // Mutually exclusive by construction, same style as ifconfig's
      // own dhcp_state_get_client_state() dispatch above.
      if state == tcp_state_closed() { let _ = uart_puts("CLOSED"); }
      if state == tcp_state_syn_sent() { let _ = uart_puts("SYN_SENT"); }
      if state == tcp_state_syn_rcvd() { let _ = uart_puts("SYN_RCVD"); }
      if state == tcp_state_established() { let _ = uart_puts("ESTABLISHED"); }
      if state == tcp_state_fin_wait() { let _ = uart_puts("FIN_WAIT"); }
      if state == tcp_state_closed_final() { let _ = uart_puts("CLOSED_FINAL"); }
      let _ = uart_puts(" local=");
      let _ = uart_put_ip(tcp_conn_get_local_ip(conn_id));
      let _ = uart_puts(":");
      let _ = uart_put_i64(tcp_conn_get_local_port(conn_id) as i64);
      let _ = uart_puts(" remote=");
      let _ = uart_put_ip(tcp_conn_get_remote_ip(conn_id));
      let _ = uart_puts(":");
      let _ = uart_put_i64(tcp_conn_get_remote_port(conn_id) as i64);
      let _ = uart_puts("\n");
      conn_id = conn_id + (1 as u32);
    }
    return 0;
  }

  // Round 29: gives the entire TCP connection API (round 22's own
  // feature ledger flagged this as the single biggest "correct, never
  // used live" gap left in this project) a real, self-contained live
  // caller -- the same self-talk-over-loopback trick `ping` already
  // uses for ICMP, generalized to a full three-way handshake, one
  // data transfer, and a full close, all driven through the real
  // netif queue via tcp_conn_poll rather than tcp_conn_self_test's own
  // hand-fed frames. Uses connection slots 0 (client) and 1 (server),
  // the same fixed pair every TCP self-test already uses -- both
  // start fresh every call via active_open/passive_open's own state
  // resets, so there's no leftover state from a prior self-test or a
  // prior `tcpecho` run to worry about. 127.0.0.1 and dedicated
  // ports (54322/7777, distinct from any self-test's own port
  // numbers) are used purely so a boot log reading this output is
  // never confused with a self-test's own traffic -- this is still a
  // pure loopback round trip regardless of which addresses are used.
  if shell_word_matches(line_buf, 0, cmd_end, "tcpecho") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: tcpecho <text>\n");
      return 0;
    }
    let text_start: i64 = cmd_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (64 as i64) {
      let _ = uart_puts("error: text too long (max 64)\n");
      return 0;
    }
    let payload: mut ref i64 = dhruva_alloc_bytes(64);
    let _ = shell_copy_range(line_buf, text_start, line_len, payload);

    let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let _ = netif_get_mac(my_mac);
    let client_id: u32 = 0 as u32;
    let server_id: u32 = 1 as u32;
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54322 as u32;
    let server_port: u32 = 7777 as u32;

    let _ = tcp_conn_passive_open(server_id, loop_ip, server_port);
    let isn: u32 = scheduler_get_tick_count() + (1000 as u32);
    let open_status: i64 = tcp_conn_active_open(client_id, my_mac, my_mac, loop_ip, loop_ip, client_port, server_port, isn);
    if open_status != 0 {
      let _ = uart_puts("tcpecho: SYN send failed\n");
      return 0;
    }

    // Handshake: SYN -> server, SYN-ACK -> client, final ACK -> server
    // is exactly 3 frames -- bounded well past that for margin, same
    // "bounded, not `while true`" discipline every poll loop in this
    // project already follows.
    let scratch: mut ref i64 = dhruva_alloc_bytes(512);
    let handshake_iter: i64 = 0;
    while (handshake_iter < 10) && ((tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established())) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      handshake_iter = handshake_iter + 1;
    }
    if (tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established()) {
      let _ = uart_puts("tcpecho: handshake failed\n");
      return 0;
    }

    let send_status: i64 = tcp_conn_send_data(client_id, my_mac, my_mac, payload, text_len);
    if send_status != 0 {
      let _ = uart_puts("tcpecho: send failed\n");
      return 0;
    }

    // Data + echo is exactly 2 frames (client's data segment, the
    // server's echoed reply) -- tcp_conn_poll's own auto-responder
    // (see its comment) is what actually sends the second one.
    let recv_payload: mut ref i64 = dhruva_alloc_bytes(64);
    let echoed: i64 = 0 - 1;
    let data_iter: i64 = 0;
    while (data_iter < 10) && (echoed < 0) {
      let poll_result: i64 = tcp_conn_poll(my_mac, recv_payload, 64);
      if poll_result > 0 {
        echoed = poll_result;
      }
      data_iter = data_iter + 1;
    }

    let _ = tcp_conn_close(client_id, my_mac, my_mac);
    let close_iter: i64 = 0;
    while (close_iter < 10) && (tcp_conn_get_state(client_id) != tcp_state_closed_final()) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      close_iter = close_iter + 1;
    }

    if echoed < 0 {
      let _ = uart_puts("tcpecho: no echo received\n");
      return 0;
    }
    let _ = uart_puts("tcpecho: echoed \"");
    let _ = fs_print_data(recv_payload, echoed);
    let _ = uart_puts("\"\n");
    return 0;
  }

  // Round 30: the last major "correct, never used live" gap the
  // feature ledger flagged -- socket_udp_send/socket_udp_recv (Phase
  // 6's own socket-style API, see socket_udp_send's comment) had run
  // only inside udp_self_test's hand-fed traffic since round 21 added
  // the ARP-cache-hit requirement. UDP is connectionless, so unlike
  // tcp_conn_poll there's no per-connection state to route by --
  // instead this builds a tiny, self-contained "echo service"
  // entirely within this one command: every queued UDP datagram is
  // read via socket_udp_recv's own reported metadata (out_meta's
  // dst_port, not a separate frame parse), and if it's addressed to
  // the fixed echo_port, it's answered immediately, right here, the
  // same "no separate caller involvement" shape icmp_poll/
  // tcp_conn_poll's own auto-responders already established -- just
  // inlined rather than factored into a standalone *_poll function,
  // since there's no ongoing connection state for a caller elsewhere
  // to also need access to. 127.0.0.1 and dedicated ports (54323/7778,
  // distinct from udp_self_test's own 12345/7 and tcpecho's
  // 54322/7777) keep this obviously a distinct live round trip in the
  // boot log, not a rerun of that self-test.
  if shell_word_matches(line_buf, 0, cmd_end, "udpecho") == 1 {
    if cmd_end >= line_len {
      let _ = uart_puts("usage: udpecho <text>\n");
      return 0;
    }
    let text_start: i64 = cmd_end + 1;
    let text_len: i64 = line_len - text_start;
    if text_len > (64 as i64) {
      let _ = uart_puts("error: text too long (max 64)\n");
      return 0;
    }
    let payload: mut ref i64 = dhruva_alloc_bytes(64);
    let _ = shell_copy_range(line_buf, text_start, line_len, payload);

    let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let _ = netif_get_mac(my_mac);
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54323 as u32;
    let echo_port: u32 = 7778 as u32;

    // socket_udp_send requires a real ARP-cache hit (round 21) -- for
    // a genuine off-loopback peer this would only ever succeed after a
    // live arp_resolve_start/poll round trip like `ping` runs, but for
    // this self-talk case the "peer" is ourselves, so inserting our
    // own MAC once up front stands in for that, matching udp_self_
    // test's own established precedent for the identical requirement.
    let _ = arp_cache_insert(loop_ip, my_mac);

    let send_status: i64 = socket_udp_send(my_mac, loop_ip, loop_ip, client_port, echo_port, payload, text_len);
    if send_status != 0 {
      let _ = uart_puts("udpecho: send failed (destination not ARP-resolved)\n");
      return 0;
    }

    let recv_payload: mut ref i64 = dhruva_alloc_bytes(64);
    let recv_meta: mut ref i64 = dhruva_alloc_bytes(8);
    let echoed: i64 = 0 - 1;
    let poll_iter: i64 = 0;
    while (poll_iter < 10) && (echoed < 0) {
      let recv_len: i64 = socket_udp_recv(recv_payload, recv_meta, 64);
      if recv_len >= 0 {
        let dst_port: u32 = buf_read_u16_be(recv_meta, 6);
        if dst_port == echo_port {
          let src_port: u32 = buf_read_u16_be(recv_meta, 4);
          let _ = socket_udp_send(my_mac, loop_ip, loop_ip, echo_port, src_port, recv_payload, recv_len);
        }
        if dst_port == client_port {
          echoed = recv_len;
        }
      }
      poll_iter = poll_iter + 1;
    }

    if echoed < 0 {
      let _ = uart_puts("udpecho: no echo received\n");
      return 0;
    }
    let _ = uart_puts("udpecho: echoed \"");
    let _ = fs_print_data(recv_payload, echoed);
    let _ = uart_puts("\"\n");
    return 0;
  }

  // Round 37: proves TCP retransmission recovers a REAL simulated
  // packet loss, live -- not just that the state machine reacts
  // correctly to hand-fed frames (the boot-time self-tests already
  // cover that; this needs the real timer tick to actually elapse,
  // which no boot-time self-test can ever observe since it runs
  // before timer_ic_init/start_multitasking, hence this being a shell
  // command like tcpecho/udpecho rather than another self-test).
  // Sends the client's SYN, then deliberately dequeues-and-drops that
  // exact frame before the server side ever sees it -- simulating a
  // real lost segment directly, the same technique docs/TODO.md's own
  // retransmission item called for, since this project's loopback
  // netif never drops anything on its own. Sleeps out the real 2-
  // second RTO (tcp_rtx_timeout_ticks) so tcp_conn_check_retransmit's
  // own tick-based deadline genuinely elapses, then polls normally --
  // the retransmitted SYN (sent by tcp_conn_poll's own retransmit
  // check) reaches the server through the same shared queue every
  // other live TCP/UDP/ICMP command already uses, completing the
  // handshake despite the induced loss.
  if shell_word_matches(line_buf, 0, cmd_end, "tcprtx") == 1 {
    let my_mac: mut ref i64 = dhruva_alloc_bytes(8);
    let _ = netif_get_mac(my_mac);
    let client_id: u32 = 0 as u32;
    let server_id: u32 = 1 as u32;
    let loop_ip: u32 = 0x7F000001 as u32; // 127.0.0.1
    let client_port: u32 = 54324 as u32;
    let server_port: u32 = 7779 as u32;

    let _ = tcp_conn_passive_open(server_id, loop_ip, server_port);
    let isn: u32 = scheduler_get_tick_count() + (2000 as u32);
    let open_status: i64 = tcp_conn_active_open(client_id, my_mac, my_mac, loop_ip, loop_ip, client_port, server_port, isn);
    if open_status != 0 {
      let _ = uart_puts("tcprtx: SYN send failed\n");
      return 0;
    }

    // Deliberately drain the queue here -- normally this dequeues our
    // own just-sent SYN directly. If task_e's own periodic
    // dhcp_client_poll happens to preempt in the brief window between
    // active_open sending the SYN and this drain (the same shared-
    // netif-queue hazard task_e's own comment documents, and
    // netif_queue_contention_self_test proves the mechanism of), it
    // may have already dequeued-and-dropped the SYN itself, leaving
    // this call to find an empty queue. Either way the SYN is now
    // genuinely gone -- exactly the condition this test needs -- so
    // this isn't treated as a failure, just two different paths to
    // the same real loss.
    let drop_buf: mut ref i64 = dhruva_alloc_bytes(64);
    let _ = netif_recv_frame(drop_buf, 64);

    let _ = task_sleep_ticks((tcp_rtx_timeout_ticks() + (1 as u32)) as i64);

    let scratch: mut ref i64 = dhruva_alloc_bytes(512);
    let handshake_iter: i64 = 0;
    while (handshake_iter < 10) && ((tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established())) {
      let _ = tcp_conn_poll(my_mac, scratch, 512);
      handshake_iter = handshake_iter + 1;
    }

    if (tcp_conn_get_state(client_id) != tcp_state_established()) || (tcp_conn_get_state(server_id) != tcp_state_established()) {
      let _ = uart_puts("tcprtx: handshake failed to recover after simulated SYN loss\n");
      return 0;
    }
    let rtx_count: u32 = tcp_conn_get_rtx_count(client_id);
    if rtx_count == (0 as u32) {
      let _ = uart_puts("tcprtx: handshake completed but no retransmit was observed (test didn't exercise what it claims to)\n");
      return 0;
    }
    let _ = uart_puts("tcprtx: recovered from simulated SYN loss via retransmission, retries=");
    let _ = uart_put_hex32(rtx_count);
    let _ = uart_puts(" (PASS)\n");
    return 0;
  }

  let _ = uart_puts("unknown command (try ls/cat/rm/write/eval/ping/ifconfig/netstat/tcpecho/udpecho/tcprtx)\n");
  return 0;
}

// Lowest-priority best-effort task alongside GC (task_e) -- same
// reserved band, priority 3 (see context_switch.S's start_multitasking
// comment). Polls shell_get_line_ready() rather than blocking on it:
// there's no "wake me when ready" primitive here, just the same
// sleep-then-recheck pattern task_c/task_d already use elsewhere.
//
// BUG (round 30 audit): #[bounded_stack(bytes=2048)] was already too
// tight once `udpecho`'s own locals were added to shell_dispatch --
// compiler-reported worst case 2184 bytes via chain task_f ->
// shell_dispatch -> tcp_conn_poll -> tcp_conn_handle_segment ->
// tcp_send_segment -> tcp_build_header -> tcp_checksum ->
// buf_read_u16_be (the same class of real, compile-time-caught
// violation round 27's task_e comment documents in full -- this is
// its second occurrence). Raised to 4096, well past the reported
// worst case, to leave headroom for future shell commands rather than
// only barely clearing today's exact number.
#[no_mangle]
#[bounded_stack(bytes=4096)]
fn task_f() -> i64 {
  while true {
    let ready: u32 = shell_get_line_ready();
    if ready == (0 as u32) {
      let _ = task_sleep_ticks(2);
    } else {
      let _ = shell_dispatch();
      let _ = shell_clear_line();
    }
  }
  return 0;
}

// Round 41: SHA-256 (FIPS 180-4), the crypto-primitives-foundation
// security-roadmap item's hash function half (see docs/TODO.md).
// Chosen over any table-driven cipher for the same reason ChaCha20 (a
// later round of this item) is preferred over AES: no S-boxes/lookup
// tables to make constant-time on hardware with no data cache anyway.
//
// vani's checker/runtime traps on u32 addition overflow (confirmed via
// a small standalone spike before committing to this build, exactly as
// docs/TODO.md's own crypto-foundation entry flagged as worth doing) --
// SHA-256's compression function depends completely on wraparound
// (mod 2^32) addition, so every 32-bit add here goes through
// sha256_wrap_add32, which widens to i64 (safely inside i64's range for
// any u32+u32), masks to the low 32 bits, and truncates back to u32,
// rather than using vani's native `+` on u32 operands directly.
fn sha256_wrap_add32(a: u32, b: u32) -> u32 {
  let wide: i64 = (a as i64) + (b as i64);
  return (wide & 4294967295) as u32;
}

fn sha256_rotr32(x: u32, n: u32) -> u32 {
  return (x >> n) | (x << ((32 as u32) - n));
}

// The 64 round constants: first 32 bits of the fractional parts of the
// cube roots of the first 64 primes (FIPS 180-4 section 4.2.2).
fn sha256_k_init(k: mut ref i64) -> i64 {
  let _ = buf_write_u32(k, 0 as u32, 0x428a2f98 as u32);
  let _ = buf_write_u32(k, 4 as u32, 0x71374491 as u32);
  let _ = buf_write_u32(k, 8 as u32, 0xb5c0fbcf as u32);
  let _ = buf_write_u32(k, 12 as u32, 0xe9b5dba5 as u32);
  let _ = buf_write_u32(k, 16 as u32, 0x3956c25b as u32);
  let _ = buf_write_u32(k, 20 as u32, 0x59f111f1 as u32);
  let _ = buf_write_u32(k, 24 as u32, 0x923f82a4 as u32);
  let _ = buf_write_u32(k, 28 as u32, 0xab1c5ed5 as u32);
  let _ = buf_write_u32(k, 32 as u32, 0xd807aa98 as u32);
  let _ = buf_write_u32(k, 36 as u32, 0x12835b01 as u32);
  let _ = buf_write_u32(k, 40 as u32, 0x243185be as u32);
  let _ = buf_write_u32(k, 44 as u32, 0x550c7dc3 as u32);
  let _ = buf_write_u32(k, 48 as u32, 0x72be5d74 as u32);
  let _ = buf_write_u32(k, 52 as u32, 0x80deb1fe as u32);
  let _ = buf_write_u32(k, 56 as u32, 0x9bdc06a7 as u32);
  let _ = buf_write_u32(k, 60 as u32, 0xc19bf174 as u32);
  let _ = buf_write_u32(k, 64 as u32, 0xe49b69c1 as u32);
  let _ = buf_write_u32(k, 68 as u32, 0xefbe4786 as u32);
  let _ = buf_write_u32(k, 72 as u32, 0x0fc19dc6 as u32);
  let _ = buf_write_u32(k, 76 as u32, 0x240ca1cc as u32);
  let _ = buf_write_u32(k, 80 as u32, 0x2de92c6f as u32);
  let _ = buf_write_u32(k, 84 as u32, 0x4a7484aa as u32);
  let _ = buf_write_u32(k, 88 as u32, 0x5cb0a9dc as u32);
  let _ = buf_write_u32(k, 92 as u32, 0x76f988da as u32);
  let _ = buf_write_u32(k, 96 as u32, 0x983e5152 as u32);
  let _ = buf_write_u32(k, 100 as u32, 0xa831c66d as u32);
  let _ = buf_write_u32(k, 104 as u32, 0xb00327c8 as u32);
  let _ = buf_write_u32(k, 108 as u32, 0xbf597fc7 as u32);
  let _ = buf_write_u32(k, 112 as u32, 0xc6e00bf3 as u32);
  let _ = buf_write_u32(k, 116 as u32, 0xd5a79147 as u32);
  let _ = buf_write_u32(k, 120 as u32, 0x06ca6351 as u32);
  let _ = buf_write_u32(k, 124 as u32, 0x14292967 as u32);
  let _ = buf_write_u32(k, 128 as u32, 0x27b70a85 as u32);
  let _ = buf_write_u32(k, 132 as u32, 0x2e1b2138 as u32);
  let _ = buf_write_u32(k, 136 as u32, 0x4d2c6dfc as u32);
  let _ = buf_write_u32(k, 140 as u32, 0x53380d13 as u32);
  let _ = buf_write_u32(k, 144 as u32, 0x650a7354 as u32);
  let _ = buf_write_u32(k, 148 as u32, 0x766a0abb as u32);
  let _ = buf_write_u32(k, 152 as u32, 0x81c2c92e as u32);
  let _ = buf_write_u32(k, 156 as u32, 0x92722c85 as u32);
  let _ = buf_write_u32(k, 160 as u32, 0xa2bfe8a1 as u32);
  let _ = buf_write_u32(k, 164 as u32, 0xa81a664b as u32);
  let _ = buf_write_u32(k, 168 as u32, 0xc24b8b70 as u32);
  let _ = buf_write_u32(k, 172 as u32, 0xc76c51a3 as u32);
  let _ = buf_write_u32(k, 176 as u32, 0xd192e819 as u32);
  let _ = buf_write_u32(k, 180 as u32, 0xd6990624 as u32);
  let _ = buf_write_u32(k, 184 as u32, 0xf40e3585 as u32);
  let _ = buf_write_u32(k, 188 as u32, 0x106aa070 as u32);
  let _ = buf_write_u32(k, 192 as u32, 0x19a4c116 as u32);
  let _ = buf_write_u32(k, 196 as u32, 0x1e376c08 as u32);
  let _ = buf_write_u32(k, 200 as u32, 0x2748774c as u32);
  let _ = buf_write_u32(k, 204 as u32, 0x34b0bcb5 as u32);
  let _ = buf_write_u32(k, 208 as u32, 0x391c0cb3 as u32);
  let _ = buf_write_u32(k, 212 as u32, 0x4ed8aa4a as u32);
  let _ = buf_write_u32(k, 216 as u32, 0x5b9cca4f as u32);
  let _ = buf_write_u32(k, 220 as u32, 0x682e6ff3 as u32);
  let _ = buf_write_u32(k, 224 as u32, 0x748f82ee as u32);
  let _ = buf_write_u32(k, 228 as u32, 0x78a5636f as u32);
  let _ = buf_write_u32(k, 232 as u32, 0x84c87814 as u32);
  let _ = buf_write_u32(k, 236 as u32, 0x8cc70208 as u32);
  let _ = buf_write_u32(k, 240 as u32, 0x90befffa as u32);
  let _ = buf_write_u32(k, 244 as u32, 0xa4506ceb as u32);
  let _ = buf_write_u32(k, 248 as u32, 0xbef9a3f7 as u32);
  let _ = buf_write_u32(k, 252 as u32, 0xc67178f2 as u32);
  return 0;
}

fn sha256_h_init(h: mut ref i64) -> i64 {
  let _ = buf_write_u32(h, 0 as u32, 0x6a09e667 as u32);
  let _ = buf_write_u32(h, 4 as u32, 0xbb67ae85 as u32);
  let _ = buf_write_u32(h, 8 as u32, 0x3c6ef372 as u32);
  let _ = buf_write_u32(h, 12 as u32, 0xa54ff53a as u32);
  let _ = buf_write_u32(h, 16 as u32, 0x510e527f as u32);
  let _ = buf_write_u32(h, 20 as u32, 0x9b05688c as u32);
  let _ = buf_write_u32(h, 24 as u32, 0x1f83d9ab as u32);
  let _ = buf_write_u32(h, 28 as u32, 0x5be0cd19 as u32);
  return 0;
}

// Message bytes are big-endian 32-bit words per FIPS 180-4, unlike
// buf_read_u32/buf_write_u32 (native little-endian, per fs_buf.S's
// plain ldr/str) -- so message-block parsing and digest-byte output
// both go through explicit big-endian byte packing here. The K table,
// H state, and W schedule buffers above are internal-only u32
// containers always read back through the same accessor, so their
// storage order never needs to match FIPS 180-4's wire format.
fn sha256_read_be32(buf: mut ref i64, off: i64) -> u32 {
  let b0: u32 = buf_read_byte(buf, off as u32);
  let b1: u32 = buf_read_byte(buf, (off + 1) as u32);
  let b2: u32 = buf_read_byte(buf, (off + 2) as u32);
  let b3: u32 = buf_read_byte(buf, (off + 3) as u32);
  return (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3;
}

fn sha256_write_be32(buf: mut ref i64, off: i64, v: u32) -> i64 {
  let _ = buf_write_byte(buf, off as u32, (v >> (24 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 1) as u32, (v >> (16 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 2) as u32, (v >> (8 as u32)) & (255 as u32));
  let _ = buf_write_byte(buf, (off + 3) as u32, v & (255 as u32));
  return 0;
}

// Process one 64-byte block starting at byte offset `block_off` inside
// `msg`, folding it into the running state `h` (8 words / 32 bytes).
// `w` is a 256-byte (64-word) message-schedule scratch buffer, `k` the
// 64-word round-constant table from sha256_k_init.
fn sha256_compress(h: mut ref i64, msg: mut ref i64, block_off: i64, w: mut ref i64, k: mut ref i64) -> i64 {
  let i: i64 = 0;
  while i < 16 {
    let word: u32 = sha256_read_be32(msg, block_off + i * 4);
    let _ = buf_write_u32(w, (i * 4) as u32, word);
    i = i + 1;
  }
  i = 16;
  while i < 64 {
    let w15: u32 = buf_read_u32(w, ((i - 15) * 4) as u32);
    let w2: u32 = buf_read_u32(w, ((i - 2) * 4) as u32);
    let w16: u32 = buf_read_u32(w, ((i - 16) * 4) as u32);
    let w7: u32 = buf_read_u32(w, ((i - 7) * 4) as u32);
    let s0: u32 = sha256_rotr32(w15, 7 as u32) ^ sha256_rotr32(w15, 18 as u32) ^ (w15 >> (3 as u32));
    let s1: u32 = sha256_rotr32(w2, 17 as u32) ^ sha256_rotr32(w2, 19 as u32) ^ (w2 >> (10 as u32));
    let wi: u32 = sha256_wrap_add32(sha256_wrap_add32(w16, s0), sha256_wrap_add32(w7, s1));
    let _ = buf_write_u32(w, (i * 4) as u32, wi);
    i = i + 1;
  }

  let a: u32 = buf_read_u32(h, 0 as u32);
  let b: u32 = buf_read_u32(h, 4 as u32);
  let c: u32 = buf_read_u32(h, 8 as u32);
  let d: u32 = buf_read_u32(h, 12 as u32);
  let e: u32 = buf_read_u32(h, 16 as u32);
  let f: u32 = buf_read_u32(h, 20 as u32);
  let g: u32 = buf_read_u32(h, 24 as u32);
  let hh: u32 = buf_read_u32(h, 28 as u32);
  let ones: u32 = 4294967295 as u32;

  i = 0;
  while i < 64 {
    let bige1: u32 = sha256_rotr32(e, 6 as u32) ^ sha256_rotr32(e, 11 as u32) ^ sha256_rotr32(e, 25 as u32);
    let ch: u32 = (e & f) ^ ((e ^ ones) & g);
    let kw: u32 = buf_read_u32(k, (i * 4) as u32);
    let ww: u32 = buf_read_u32(w, (i * 4) as u32);
    let t1: u32 = sha256_wrap_add32(sha256_wrap_add32(hh, bige1), sha256_wrap_add32(ch, sha256_wrap_add32(kw, ww)));
    let bige0: u32 = sha256_rotr32(a, 2 as u32) ^ sha256_rotr32(a, 13 as u32) ^ sha256_rotr32(a, 22 as u32);
    let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
    let t2: u32 = sha256_wrap_add32(bige0, maj);

    hh = g;
    g = f;
    f = e;
    e = sha256_wrap_add32(d, t1);
    d = c;
    c = b;
    b = a;
    a = sha256_wrap_add32(t1, t2);

    i = i + 1;
  }

  let _ = buf_write_u32(h, 0 as u32, sha256_wrap_add32(buf_read_u32(h, 0 as u32), a));
  let _ = buf_write_u32(h, 4 as u32, sha256_wrap_add32(buf_read_u32(h, 4 as u32), b));
  let _ = buf_write_u32(h, 8 as u32, sha256_wrap_add32(buf_read_u32(h, 8 as u32), c));
  let _ = buf_write_u32(h, 12 as u32, sha256_wrap_add32(buf_read_u32(h, 12 as u32), d));
  let _ = buf_write_u32(h, 16 as u32, sha256_wrap_add32(buf_read_u32(h, 16 as u32), e));
  let _ = buf_write_u32(h, 20 as u32, sha256_wrap_add32(buf_read_u32(h, 20 as u32), f));
  let _ = buf_write_u32(h, 24 as u32, sha256_wrap_add32(buf_read_u32(h, 24 as u32), g));
  let _ = buf_write_u32(h, 28 as u32, sha256_wrap_add32(buf_read_u32(h, 28 as u32), hh));
  return 0;
}

// Hashes `msg_len` bytes at `msg` into the 32-byte buffer `out`
// (FIPS 180-4 padding: a single 0x80 byte, zero bytes up to a
// 56-mod-64 boundary, then the original bit-length as a big-endian
// 8-byte integer).
fn sha256_hash(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  let with_one: i64 = msg_len + 1;
  let rem: i64 = with_one % 64;
  let zero_pad: i64 = 0;
  if rem <= 56 {
    zero_pad = 56 - rem;
  } else {
    zero_pad = (64 - rem) + 56;
  }
  let total_len: i64 = with_one + zero_pad + 8;

  let padded: mut ref i64 = dhruva_alloc_bytes(total_len);
  let i: i64 = 0;
  while i < msg_len {
    let _ = buf_write_byte(padded, i as u32, buf_read_byte(msg, i as u32));
    i = i + 1;
  }
  let _ = buf_write_byte(padded, msg_len as u32, 128 as u32);
  i = msg_len + 1;
  while i < (with_one + zero_pad) {
    let _ = buf_write_byte(padded, i as u32, 0 as u32);
    i = i + 1;
  }
  let bit_len: i64 = msg_len * 8;
  let _ = sha256_write_be32(padded, total_len - 8, 0 as u32);
  let _ = sha256_write_be32(padded, total_len - 4, bit_len as u32);

  let h: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_h_init(h);
  let k: mut ref i64 = dhruva_alloc_bytes(256);
  let _ = sha256_k_init(k);
  let w: mut ref i64 = dhruva_alloc_bytes(256);

  let num_blocks: i64 = total_len / 64;
  let blk: i64 = 0;
  while blk < num_blocks {
    let _ = sha256_compress(h, padded, blk * 64, w, k);
    blk = blk + 1;
  }

  let j: i64 = 0;
  while j < 8 {
    let word: u32 = buf_read_u32(h, (j * 4) as u32);
    let _ = sha256_write_be32(out, j * 4, word);
    j = j + 1;
  }
  return 0;
}

fn sha256_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

// Three FIPS 180-4 / NIST known-answer vectors: the empty string, the
// "abc" worked example from the spec itself, and a 56-byte message
// whose padding lands exactly on a second 64-byte block -- the one
// case a single-block-only implementation would get wrong.
fn sha256_self_test() -> i64 {
  let ok: i64 = 1;

  let msg0: mut ref i64 = dhruva_alloc_bytes(1);
  let out0: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg0, 0, out0);
  let exp0: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp0, 0 as u32, 0xe3 as u32);
  let _ = buf_write_byte(exp0, 1 as u32, 0xb0 as u32);
  let _ = buf_write_byte(exp0, 2 as u32, 0xc4 as u32);
  let _ = buf_write_byte(exp0, 3 as u32, 0x42 as u32);
  let _ = buf_write_byte(exp0, 4 as u32, 0x98 as u32);
  let _ = buf_write_byte(exp0, 5 as u32, 0xfc as u32);
  let _ = buf_write_byte(exp0, 6 as u32, 0x1c as u32);
  let _ = buf_write_byte(exp0, 7 as u32, 0x14 as u32);
  let _ = buf_write_byte(exp0, 8 as u32, 0x9a as u32);
  let _ = buf_write_byte(exp0, 9 as u32, 0xfb as u32);
  let _ = buf_write_byte(exp0, 10 as u32, 0xf4 as u32);
  let _ = buf_write_byte(exp0, 11 as u32, 0xc8 as u32);
  let _ = buf_write_byte(exp0, 12 as u32, 0x99 as u32);
  let _ = buf_write_byte(exp0, 13 as u32, 0x6f as u32);
  let _ = buf_write_byte(exp0, 14 as u32, 0xb9 as u32);
  let _ = buf_write_byte(exp0, 15 as u32, 0x24 as u32);
  let _ = buf_write_byte(exp0, 16 as u32, 0x27 as u32);
  let _ = buf_write_byte(exp0, 17 as u32, 0xae as u32);
  let _ = buf_write_byte(exp0, 18 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp0, 19 as u32, 0xe4 as u32);
  let _ = buf_write_byte(exp0, 20 as u32, 0x64 as u32);
  let _ = buf_write_byte(exp0, 21 as u32, 0x9b as u32);
  let _ = buf_write_byte(exp0, 22 as u32, 0x93 as u32);
  let _ = buf_write_byte(exp0, 23 as u32, 0x4c as u32);
  let _ = buf_write_byte(exp0, 24 as u32, 0xa4 as u32);
  let _ = buf_write_byte(exp0, 25 as u32, 0x95 as u32);
  let _ = buf_write_byte(exp0, 26 as u32, 0x99 as u32);
  let _ = buf_write_byte(exp0, 27 as u32, 0x1b as u32);
  let _ = buf_write_byte(exp0, 28 as u32, 0x78 as u32);
  let _ = buf_write_byte(exp0, 29 as u32, 0x52 as u32);
  let _ = buf_write_byte(exp0, 30 as u32, 0xb8 as u32);
  let _ = buf_write_byte(exp0, 31 as u32, 0x55 as u32);
  if sha256_bytes_equal(out0, exp0, 32) == 0 { ok = 0; }

  let msg1: mut ref i64 = dhruva_alloc_bytes(3);
  let _ = buf_write_byte(msg1, 0 as u32, 97 as u32);
  let _ = buf_write_byte(msg1, 1 as u32, 98 as u32);
  let _ = buf_write_byte(msg1, 2 as u32, 99 as u32);
  let out1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg1, 3, out1);
  let exp1: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp1, 0 as u32, 0xba as u32);
  let _ = buf_write_byte(exp1, 1 as u32, 0x78 as u32);
  let _ = buf_write_byte(exp1, 2 as u32, 0x16 as u32);
  let _ = buf_write_byte(exp1, 3 as u32, 0xbf as u32);
  let _ = buf_write_byte(exp1, 4 as u32, 0x8f as u32);
  let _ = buf_write_byte(exp1, 5 as u32, 0x01 as u32);
  let _ = buf_write_byte(exp1, 6 as u32, 0xcf as u32);
  let _ = buf_write_byte(exp1, 7 as u32, 0xea as u32);
  let _ = buf_write_byte(exp1, 8 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp1, 9 as u32, 0x41 as u32);
  let _ = buf_write_byte(exp1, 10 as u32, 0x40 as u32);
  let _ = buf_write_byte(exp1, 11 as u32, 0xde as u32);
  let _ = buf_write_byte(exp1, 12 as u32, 0x5d as u32);
  let _ = buf_write_byte(exp1, 13 as u32, 0xae as u32);
  let _ = buf_write_byte(exp1, 14 as u32, 0x22 as u32);
  let _ = buf_write_byte(exp1, 15 as u32, 0x23 as u32);
  let _ = buf_write_byte(exp1, 16 as u32, 0xb0 as u32);
  let _ = buf_write_byte(exp1, 17 as u32, 0x03 as u32);
  let _ = buf_write_byte(exp1, 18 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp1, 19 as u32, 0xa3 as u32);
  let _ = buf_write_byte(exp1, 20 as u32, 0x96 as u32);
  let _ = buf_write_byte(exp1, 21 as u32, 0x17 as u32);
  let _ = buf_write_byte(exp1, 22 as u32, 0x7a as u32);
  let _ = buf_write_byte(exp1, 23 as u32, 0x9c as u32);
  let _ = buf_write_byte(exp1, 24 as u32, 0xb4 as u32);
  let _ = buf_write_byte(exp1, 25 as u32, 0x10 as u32);
  let _ = buf_write_byte(exp1, 26 as u32, 0xff as u32);
  let _ = buf_write_byte(exp1, 27 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp1, 28 as u32, 0xf2 as u32);
  let _ = buf_write_byte(exp1, 29 as u32, 0x00 as u32);
  let _ = buf_write_byte(exp1, 30 as u32, 0x15 as u32);
  let _ = buf_write_byte(exp1, 31 as u32, 0xad as u32);
  if sha256_bytes_equal(out1, exp1, 32) == 0 { ok = 0; }

  let s2: Str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  let len2: i64 = str_len_bytes(s2);
  let msg2: mut ref i64 = dhruva_alloc_bytes(len2);
  let i2: i64 = 0;
  while i2 < len2 {
    let _ = buf_write_byte(msg2, i2 as u32, str_byte_at(s2, i2) as u32);
    i2 = i2 + 1;
  }
  let out2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = sha256_hash(msg2, len2, out2);
  let exp2: mut ref i64 = dhruva_alloc_bytes(32);
  let _ = buf_write_byte(exp2, 0 as u32, 0x24 as u32);
  let _ = buf_write_byte(exp2, 1 as u32, 0x8d as u32);
  let _ = buf_write_byte(exp2, 2 as u32, 0x6a as u32);
  let _ = buf_write_byte(exp2, 3 as u32, 0x61 as u32);
  let _ = buf_write_byte(exp2, 4 as u32, 0xd2 as u32);
  let _ = buf_write_byte(exp2, 5 as u32, 0x06 as u32);
  let _ = buf_write_byte(exp2, 6 as u32, 0x38 as u32);
  let _ = buf_write_byte(exp2, 7 as u32, 0xb8 as u32);
  let _ = buf_write_byte(exp2, 8 as u32, 0xe5 as u32);
  let _ = buf_write_byte(exp2, 9 as u32, 0xc0 as u32);
  let _ = buf_write_byte(exp2, 10 as u32, 0x26 as u32);
  let _ = buf_write_byte(exp2, 11 as u32, 0x93 as u32);
  let _ = buf_write_byte(exp2, 12 as u32, 0x0c as u32);
  let _ = buf_write_byte(exp2, 13 as u32, 0x3e as u32);
  let _ = buf_write_byte(exp2, 14 as u32, 0x60 as u32);
  let _ = buf_write_byte(exp2, 15 as u32, 0x39 as u32);
  let _ = buf_write_byte(exp2, 16 as u32, 0xa3 as u32);
  let _ = buf_write_byte(exp2, 17 as u32, 0x3c as u32);
  let _ = buf_write_byte(exp2, 18 as u32, 0xe4 as u32);
  let _ = buf_write_byte(exp2, 19 as u32, 0x59 as u32);
  let _ = buf_write_byte(exp2, 20 as u32, 0x64 as u32);
  let _ = buf_write_byte(exp2, 21 as u32, 0xff as u32);
  let _ = buf_write_byte(exp2, 22 as u32, 0x21 as u32);
  let _ = buf_write_byte(exp2, 23 as u32, 0x67 as u32);
  let _ = buf_write_byte(exp2, 24 as u32, 0xf6 as u32);
  let _ = buf_write_byte(exp2, 25 as u32, 0xec as u32);
  let _ = buf_write_byte(exp2, 26 as u32, 0xed as u32);
  let _ = buf_write_byte(exp2, 27 as u32, 0xd4 as u32);
  let _ = buf_write_byte(exp2, 28 as u32, 0x19 as u32);
  let _ = buf_write_byte(exp2, 29 as u32, 0xdb as u32);
  let _ = buf_write_byte(exp2, 30 as u32, 0x06 as u32);
  let _ = buf_write_byte(exp2, 31 as u32, 0xc1 as u32);
  if sha256_bytes_equal(out2, exp2, 32) == 0 { ok = 0; }

  let _ = uart_puts("CRYPTO: SHA-256 vs 3 NIST/FIPS-180-4 KATs (empty, \"abc\", 2-block)");
  if ok == 1 {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL)\n");
  }
  return 0;
}

// Early-warning canary for the exact heap-exhaustion bug class this
// project has now hit twice (once in fs_compact's own per-pass leak,
// once in round 10's DHCP self-tests tipping total boot-time usage
// over the top -- see runtime_stubs.c's own dhruva_alloc_bytes comment
// for that second incident's full story). Every dhruva_alloc_bytes
// call so far in kernel_main (every scratch buffer, every task stack)
// has already happened by the time this runs, but task_e's own first-
// run setup (gc_buf/compact_buf/compact_path_buf/compact_data_buf,
// ~1520 bytes) and any other task's own one-time first-run allocations
// haven't yet -- so this checks for real headroom beyond what's
// already used, not just "did we not crash yet". Graded, not just
// informational: a future round adding enough self-test buffers to
// eat into this margin gets a loud, specific self-test FAILURE at
// boot instead of a silent reboot loop that only phase4_milestone.py
// (or worse, nothing) happens to notice.
fn heap_usage_self_test() -> i64 {
  let used: i64 = dhruva_heap_used_bytes();
  let capacity: i64 = 262144; // DHRUVA_HEAP_BYTES, runtime_stubs.c
  let headroom: i64 = capacity - used;
  let min_headroom: i64 = 16384; // generous margin for future rounds
  let _ = uart_puts("HEAP: used=");
  let _ = uart_put_i64(used);
  let _ = uart_puts(" capacity=");
  let _ = uart_put_i64(capacity);
  let _ = uart_puts(" headroom=");
  let _ = uart_put_i64(headroom);
  if headroom >= min_headroom {
    let _ = uart_puts(" (PASS)\n");
  } else {
    let _ = uart_puts(" (FAIL, expect headroom >= 16384)\n");
  }
  return 0;
}

#[no_mangle]
fn kernel_main() -> i64 {
  let _ = uart_init();
  let _ = uart_puts("Dhruva Phase 2: fixed-priority scheduling + priority ceiling\n");

  // Shared, persistent scratch buffers for the FS layer, shell
  // dispatch, eval, and uart_put_i64 -- allocated exactly once, here,
  // before anything that uses them ever runs. See scratch_state.S's
  // own doc comment for why these exist and why sharing them across
  // call sites is safe.
  let _ = fs_sd_scratch_set(dhruva_alloc_bytes(512));
  let _ = fs_path_scratch_set(dhruva_alloc_bytes(32));
  let _ = fs_data_scratch_set(dhruva_alloc_bytes(4096));
  let _ = fs_stat_scratch_set(dhruva_alloc_bytes(12));
  let _ = fs_dir_scratch_set(dhruva_alloc_bytes(32));
  let _ = shell_line_scratch_set(dhruva_alloc_bytes(128));
  let _ = eval_values_scratch_set(dhruva_alloc_bytes(128));
  let _ = eval_ops_scratch_set(dhruva_alloc_bytes(64));
  let _ = uart_digits_scratch_set(dhruva_alloc_bytes(24));
  let _ = dwc2_dma_scratch_set(dhruva_alloc_bytes(64));
  let _ = usb_bulk_data_scratch_set(dhruva_alloc_bytes(512));
  let _ = tcp_empty_payload_scratch_set(dhruva_alloc_bytes(1));
  let _ = net_send_scratch_set(dhruva_alloc_bytes(512));
  let _ = net_recv_scratch_set(dhruva_alloc_bytes(512));
  let _ = udp_send_arp_scratch_set(dhruva_alloc_bytes(6));
  let _ = arp_resolve_scratch_set(dhruva_alloc_bytes(64));
  let _ = dhcp_server_mac_scratch_set(dhruva_alloc_bytes(6));
  let _ = arp_resolve_mac_scratch_set(dhruva_alloc_bytes(6));
  let _ = dhcp_payload_scratch_set(dhruva_alloc_bytes(300));
  let _ = dhcp_frame_scratch_set(dhruva_alloc_bytes(512));
  let _ = dhcp_bcast_mac_scratch_set(dhruva_alloc_bytes(8));

  let _ = sdhost_cmd_timed_out_self_test();

  // BUG (round 15 audit, 2026-08-28): sdhost_init's own return value
  // (RCA on success, -1 on a newly-detected command timeout -- see
  // sdhost_cmd_timed_out's own comment) used to be discarded entirely
  // here, same as every individual command inside sdhost_init used to
  // discard its own status. Even after fixing detection inside
  // sdhost_init itself, a failure would have stayed completely
  // invisible one level up -- boot would have silently continued into
  // fs_init() and beyond against a card that was never actually
  // brought up, with nothing in the log to explain why every later SD
  // operation was failing. Reported the same way dwc2_init's own
  // status already is, just below.
  let sd_status: i64 = sdhost_init();
  if sd_status < 0 {
    let _ = uart_puts("SD: sdhost_init FAILED (see the timeout message above for which command)\n");
  }

  // Task #3 verification: write+read+compare across several distinct
  // blocks, to confirm the driver holds up across many consecutive
  // data commands, not just a single lucky pair. Uses blocks near the
  // top of fs_init's scan range (2040-2047, just under its 2048 cap),
  // not 0-7 -- task #4's filesystem grows forward from block 1, so
  // low block numbers are real, live log data as of this same boot,
  // not a spare scratch area to overwrite with test patterns.
  let sd_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let sd_buf2: mut ref i64 = dhruva_alloc_bytes(512);
  let sd_blk: i64 = 2040;
  let sd_any_fail: i64 = 0;
  while sd_blk < 2048 {
    let _ = test_fill_pattern(sd_buf, 512);
    let sd_wr: i64 = sdhost_write_block(sd_blk, sd_buf);
    let sd_rd: i64 = sdhost_read_block(sd_blk, sd_buf2);
    let sd_mismatch: i64 = test_compare_buffers(sd_buf, sd_buf2, 512);
    if (sd_wr != 0) || (sd_rd != 0) || (sd_mismatch != 0) {
      sd_any_fail = 1;
    }
    sd_blk = sd_blk + 1;
  }
  let _ = uart_puts("SD: 8-block round-trip sweep any_fail=");
  let _ = uart_put_hex32(sd_any_fail as u32);
  let _ = uart_puts("\n");

  // Task #4 verification: append several path/value pairs, overwrite
  // one path with a newer value, confirm reads see the latest write
  // per path (not the first, not a mix) and an unrelated path is
  // unaffected.
  let _ = fs_init();

  // Report what recovery alone found, BEFORE any fresh writes this
  // boot might make -- test/power_yank.py checks exactly this line
  // against a deliberately torn image. Reading it only after the
  // fresh fs_append calls just below would defeat the whole test:
  // those calls run unconditionally every boot and would silently
  // paper over whatever recovery actually did with brand new records.
  let recovery_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let recovery_len: i64 = fs_read("/config/mode", recovery_buf);
  let _ = uart_puts("FS: post-recovery /config/mode = \"");
  if recovery_len >= 0 {
    let _ = fs_print_data(recovery_buf, recovery_len);
  } else {
    let _ = uart_puts("(not found)");
  }
  let _ = uart_puts("\"\n");

  let _ = fs_append("/config/mode", "auto");
  let _ = fs_append("/config/name", "dhruva");
  let _ = fs_append("/config/mode", "manual");
  let fs_out: mut ref i64 = dhruva_alloc_bytes(512);

  let mode_len: i64 = fs_read("/config/mode", fs_out);
  let _ = uart_puts("FS: /config/mode = \"");
  let _ = fs_print_data(fs_out, mode_len);
  let _ = uart_puts("\" (expect \"manual\")\n");

  let name_len: i64 = fs_read("/config/name", fs_out);
  let _ = uart_puts("FS: /config/name = \"");
  let _ = fs_print_data(fs_out, name_len);
  let _ = uart_puts("\" (expect \"dhruva\")\n");

  let missing_len: i64 = fs_read("/config/missing", fs_out);
  let _ = uart_puts("FS: /config/missing lookup result=");
  let _ = uart_put_hex32(missing_len as u32);
  let _ = uart_puts(" (expect FFFFFFFF, i.e. -1, not found)\n");

  // Task #5 verification: pile up several more dead versions of the
  // same path, run one compaction pass, confirm reads still see the
  // correct latest value afterward and log_start actually advanced
  // (i.e. compaction did real work, not a no-op).
  let _ = fs_append("/config/mode", "override1");
  let _ = fs_append("/config/mode", "override2");
  let _ = fs_append("/config/mode", "final");
  let log_start_before: u32 = fs_state_get_log_start();
  let next_block_before: u32 = fs_state_get_next_block();
  let compact_buf: mut ref i64 = dhruva_alloc_bytes(512);
  let compact_path_buf: mut ref i64 = dhruva_alloc_bytes(32);
  let compact_data_buf: mut ref i64 = dhruva_alloc_bytes(4096);
  let _ = fs_compact(compact_buf, compact_path_buf, compact_data_buf);
  let log_start_after: u32 = fs_state_get_log_start();
  let next_block_after: u32 = fs_state_get_next_block();
  let _ = uart_puts("FS: compact log_start ");
  let _ = uart_put_hex32(log_start_before);
  let _ = uart_puts(" -> ");
  let _ = uart_put_hex32(log_start_after);
  let _ = uart_puts(", next_block ");
  let _ = uart_put_hex32(next_block_before);
  let _ = uart_puts(" -> ");
  let _ = uart_put_hex32(next_block_after);
  let _ = uart_puts("\n");

  let mode_len2: i64 = fs_read("/config/mode", fs_out);
  let _ = uart_puts("FS: post-compact /config/mode = \"");
  let _ = fs_print_data(fs_out, mode_len2);
  let _ = uart_puts("\" (expect \"final\")\n");

  let name_len2: i64 = fs_read("/config/name", fs_out);
  let _ = uart_puts("FS: post-compact /config/name = \"");
  let _ = fs_print_data(fs_out, name_len2);
  let _ = uart_puts("\" (expect \"dhruva\")\n");

  // Leave task_e (GC) real work to find on its own first scheduled
  // wake-up, rather than only ever seeing an already-compacted log
  // from the manual pass above.
  let _ = fs_append("/config/mode", "post-compact-1");
  let _ = fs_append("/config/mode", "post-compact-2");

  // Task #8 verification: prefix-scan listing and tombstone delete.
  let _ = uart_puts("FS: ls /config/ (expect mode, name):\n");
  let _ = fs_list("/config/");
  let _ = fs_delete("/config/name");
  let _ = uart_puts("FS: ls /config/ after deleting name (expect only mode):\n");
  let _ = fs_list("/config/");
  let deleted_len: i64 = fs_read("/config/name", fs_out);
  let _ = uart_puts("FS: read of deleted /config/name result=");
  let _ = uart_put_hex32(deleted_len as u32);
  let _ = uart_puts(" (expect FFFFFFFF, i.e. -1, not found)\n");

  // Round 39: multi-block files + journaling hardening.
  let _ = fs_multiblock_self_test();
  let _ = fs_multiblock_crash_consistency_self_test();

  // Round 42: directory hierarchy + owner/group/other rwx permissions.
  let _ = fs_permissions_self_test();
  let _ = fs_directory_hierarchy_self_test();

  // Task #10 verification: eval_expr_raw, via boot-time self-test
  // rather than live shell input (see eval_self_test's own comment).
  let _ = eval_self_test("2+3", 5, 0);
  let _ = eval_self_test("2 + 3 * 4", 14, 0);
  let _ = eval_self_test("(2+3)*4", 20, 0);
  let _ = eval_self_test("10-2-3", 5, 0);
  let _ = eval_self_test("2*(3+4*(5-1))", 38, 0);
  let _ = eval_self_test("-5+10", 5, 0);
  let _ = eval_self_test("100/3", 33, 0);
  let _ = eval_self_test("10/0", 0, 1);
  let _ = eval_self_test("(1+2", 0, 1);
  // Round 2 audit regression: values stack used to store each number as
  // a truncating single u32 word, silently corrupting operands beyond
  // +-2 billion before eval_apply ever saw them -- this used to return
  // a wrong silent answer (no error) instead of correctly detecting
  // overflow. Also exercises a large-but-in-range value end to end to
  // confirm the hi/lo split round-trips correctly, not just the
  // overflow-rejection path.
  let _ = eval_self_test("999999999999*999999999999", 0, 1);
  let _ = eval_self_test("5000000000+5000000000", 10000000000, 0);

  // Round 6 audit regression: uart_put_i64 used to negate its whole
  // input up front, which overflows for exactly one value, i64::MIN --
  // see uart_put_i64's own comment for why that's a real hang/wrong-
  // answer risk on this target, not just theoretical. No caller passes
  // i64::MIN today, but this is a general-purpose print helper, so
  // this exercises it directly rather than only through whatever
  // happens to call it elsewhere.
  let _ = uart_puts("UART: uart_put_i64(i64::MIN)=");
  let _ = uart_put_i64(0 - 9223372036854775807 - 1);
  let _ = uart_puts(" (expect -9223372036854775808)\n");

  // Phase 5 verification: governor_desired_freq_mhz's threshold
  // boundaries, via boot-time self-test rather than live introspection
  // (scheduler_ready_count() only means anything once start_multitasking
  // has handed off, at the very end of this function -- deterministic
  // logic like this needs no live task juggling to check).
  let _ = governor_self_test(0, 250);
  let _ = governor_self_test(1, 250);
  let _ = governor_self_test(2, 450);
  let _ = governor_self_test(3, 450);
  let _ = governor_self_test(4, 700);
  let _ = governor_self_test(5, 700);
  let _ = governor_replay_test();

  // Phase 6 verification: netif's own loopback implementation.
  let _ = netif_init();
  let _ = netif_self_test();
  let _ = arp_self_test();
  let _ = arp_resolve_self_test();
  let _ = ipv4_self_test();
  let _ = ip_parse_self_test();
  let _ = icmp_self_test();
  let _ = udp_self_test();
  let _ = udp_send_unresolved_self_test();
  let _ = udp_recv_bounds_self_test();
  let _ = udp_checksum_reject_self_test();
  let _ = tcp_self_test();
  let _ = tcp_conn_self_test();
  let _ = tcp_conn_recv_bounds_self_test();
  let _ = tcp_conn_simultaneous_open_self_test();
  let _ = dhcp_self_test();
  let _ = dhcp_renewal_self_test();
  let _ = dhcp_nak_self_test();
  let _ = netif_queue_contention_self_test();

  // Round 41: crypto primitives foundation, hash-function half.
  let _ = sha256_self_test();

  // DWC2 bring-up: only reaches "port enabled" if a USB device is
  // actually attached to this QEMU invocation (`-usb -device
  // usb-net,...` or similar) -- not attaching one is the normal case
  // for every other test in this project, so a nonzero return here is
  // expected and informational, not a failure to alarm on.
  let usb_status: i64 = dwc2_init();
  let _ = uart_puts("USB: dwc2_init status=");
  let _ = uart_put_hex32(usb_status as u32);
  let _ = uart_puts(" (0=device attached+port enabled, nonzero=no device attached)\n");

  let _ = timer_ic_init();
  let _ = uart_rx_irq_init();

  let stack_bytes: i64 = 4096;
  let stack_a: mut ref i64 = dhruva_alloc_bytes(stack_bytes);
  let stack_b: mut ref i64 = dhruva_alloc_bytes(stack_bytes);
  let stack_c: mut ref i64 = dhruva_alloc_bytes(stack_bytes);
  let stack_d: mut ref i64 = dhruva_alloc_bytes(stack_bytes);
  // BUG (round 4 audit, 2026-08-27): task_e was still allocated the
  // same stock 4096 bytes every non-FS task gets, even though this
  // very file's own task_f comment right below already names task_e
  // as sharing task_f's "similarly-deep chain" -- fs_compact calls
  // through the same FS/SD block layer (fs_state_get_log_start/
  // next_block, sdhost_read_block/write_block) that overflowed task_f's
  // stock stack the instant a UART RX IRQ landed mid-call-chain. task_e
  // never hit this live only because no test so far happened to have a
  // UART RX interrupt (which fires whenever a character is typed at the
  // shell, completely independent of which task is actually running at
  // that instant) land while task_e -- not task_f -- was the one
  // currently executing deep in fs_compact. That's a timing accident,
  // not a structural difference between the two tasks: IRQ frames build
  // on whichever task's own SVC stack happens to be current when the
  // interrupt fires (the same Phase 2 IRQ-vs-SVC-stack design task_f's
  // fix explains), so task_e was exposed to the identical worst case
  // the whole time. Given the task_f fix, matched here rather than
  // bisected down to something merely plausible: same task, same class
  // of call chain, same fix.
  let stack_e_bytes: i64 = 16384;
  let stack_e: mut ref i64 = dhruva_alloc_bytes(stack_e_bytes);
  // BUG (task #9, found via the same event-driven interactive test):
  // task_f's real stack was originally the same 4096 bytes every other
  // task gets, matching its #[bounded_stack(bytes=2048)] claim with
  // room to spare on paper. In practice it hung the whole system --
  // total silence, no reboot -- the instant a UART RX interrupt landed
  // while task_f was deep in shell_dispatch -> fs_list ->
  // fs_find_latest_block_raw -> sdhost_read_block. Root cause: this
  // project's IRQ frames build on the INTERRUPTED task's own SVC stack
  // (the Phase 2 IRQ-vs-SVC-stack fix), so the real worst case for any
  // interruptible task is its own deepest call chain PLUS whatever the
  // preempting ISR needs on top -- not accounted for by #[bounded_
  // stack]'s static, interrupt-oblivious analysis. task_e's own
  // similarly-deep chain happened to never overflow its stock 4096
  // bytes, purely because it had only ever been preempted by the
  // routine timer tick before task_f's shell gave it UART RX exposure
  // too. Confirmed by raising just this one task's real allocation to
  // 16384 (4x) and watching the exact same hang disappear -- kept at
  // that confirmed-safe value rather than bisected down to something
  // merely plausible.
  let stack_f_bytes: i64 = 16384;
  let stack_f: mut ref i64 = dhruva_alloc_bytes(stack_f_bytes);
  let sp_a: mut ref i64 = task_a_init_stack(stack_a, stack_bytes);
  let sp_b: mut ref i64 = task_b_init_stack(stack_b, stack_bytes);
  let sp_c: mut ref i64 = task_c_init_stack(stack_c, stack_bytes);
  let sp_d: mut ref i64 = task_d_init_stack(stack_d, stack_bytes);
  let sp_e: mut ref i64 = task_e_init_stack(stack_e, stack_e_bytes);
  let sp_f: mut ref i64 = task_f_init_stack(stack_f, stack_f_bytes);

  let _ = uart_puts("PASS\n");

  // BUG (round 26 audit, found by actually driving the new shell
  // `ping` command interactively rather than just its self-test):
  // arp_self_test/udp_self_test/dhcp_self_test/dhcp_renewal_self_test
  // all insert real entries into the ONE live ARP cache (arp_cache_
  // insert), and nothing ever cleared it afterward -- every one of
  // those test entries stays there for the rest of this boot,
  // silently available to `ping`'s own arp_cache_lookup. dhcp_self_
  // test's own synthetic server sits at 192.168.1.1, mapped to a
  // fake MAC (0xAA repeated) -- one of the single most common real
  // LAN gateway addresses. On real hardware, `ping 192.168.1.1`
  // typed at the shell after boot would silently "succeed" against
  // that leftover fake test MAC instead of ever issuing a real ARP
  // request for whatever's actually at that address -- invisible
  // under QEMU, where nothing real is on the other end to expose the
  // wrong answer, but a real, live correctness gap for anything
  // downstream of `ping`'s own arp_cache_lookup that trusts the
  // result.
  //
  // Fixed by resetting arp_cache_count directly, NOT by re-calling
  // arp_cache_init() -- that function only reallocates the cache's
  // own MAC-bytes buffer (arp_cache_set_macs_buf), it does not touch
  // arp_cache_count or the parallel IP array at all, so calling it a
  // second time here would have left every stale IP entry still
  // "found" by arp_cache_lookup (which only ever looks at entries
  // below arp_cache_count), just now paired with a fresh all-zero MAC
  // instead of the old fake one -- an even worse silent wrong answer,
  // caught here before it shipped rather than discovered as a second
  // bug on top of the first. Resetting count to 0 alone is correct
  // and sufficient: arp_cache_lookup's own loop bound means an empty
  // count makes every stale MAC/IP-array byte unreachable regardless
  // of what's still sitting in them, and arp_cache_insert starts
  // overwriting cleanly from index 0 again on the next real entry.
  let _ = arp_cache_set_count(0 as u32);
  let _ = arp_cache_set_next_slot(0 as u32);
  let _ = heap_usage_self_test();

  // Round 27 (2026-08-28): actually start real DHCP address
  // acquisition -- dhcp_client_start/dhcp_client_poll have existed
  // since round 9, been fixed and extended twice since (round 10's
  // NAK handling, round 22's full RFC 2131 lease renewal), and every
  // single call to them anywhere in this codebase before this line
  // was from a self-test that always finishes by resetting the state
  // machine back to INIT (dhcp_nak_self_test's own final branch is
  // the last DHCP self-test that runs) -- the same "correct, fully
  // built, never actually used live" pattern rounds 8/11/21 already
  // found and fixed for other subsystems, just for the single most
  // complete protocol layer in this whole project. xid varies run to
  // run via scheduler_get_tick_count(), matching dhcp_client_start's
  // own comment on what a caller should supply (this driver has no
  // random-number source). task_e's own periodic dhcp_client_poll
  // call (see that function's own comment) is what actually drives
  // this forward from here -- DISCOVER goes out now, but nothing
  // ever answers it under QEMU (no real DHCP server exists on this
  // project's loopback-only netif), so this permanently sits in
  // SELECTING under the only testing method this project has --
  // correct by design for real hardware, not something QEMU can
  // verify end to end, the same honest-limitation category rounds
  // 23/24/26 already established.
  let boot_mac: mut ref i64 = dhruva_alloc_bytes(8);
  let _ = netif_get_mac(boot_mac);
  let dhcp_boot_status: i64 = dhcp_client_start(boot_mac, scheduler_get_tick_count());
  let _ = uart_puts("DHCP: client_start status=");
  let _ = uart_put_hex32(dhcp_boot_status as u32);
  let _ = uart_puts(" (0=DISCOVER sent, state=SELECTING)\n");

  // watchdog_init() would belong here, right before handing off to the
  // scheduler -- see watchdog_arm's comment for why it isn't actually
  // called under QEMU's raspi1ap.
  //
  // Never returns. start_multitasking's own restore sets CPSR (via
  // the fake frame's spsr=0x13) with interrupts already enabled, so
  // there's no separate enable_irqs() call needed here -- interrupts
  // stay masked for all of kernel_main's own setup above, and turn on
  // exactly when task_a first runs.
  let _ = start_multitasking(sp_a, sp_b, sp_c, sp_d, sp_e, sp_f);

  // Unreachable, but kernel_main must still type-check as returning i64.
  return 0;
}

// Required by the compiler even though boot.S never calls it -- the
// real entry point is kernel_main, reached via boot.S's _start.
fn main() -> i64 {
  return 0;
}
