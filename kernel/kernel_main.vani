  let _ = buf_write_u32(rho, 96 as u32, 14 as u32);
  let pi_dest: mut ref i64 = keccak_pi_dest_get();
  let _ = buf_write_u32(pi_dest, 0 as u32, 0 as u32);
  let _ = buf_write_u32(pi_dest, 4 as u32, 10 as u32);
  let _ = buf_write_u32(pi_dest, 8 as u32, 20 as u32);
  let _ = buf_write_u32(pi_dest, 12 as u32, 5 as u32);
  let _ = buf_write_u32(pi_dest, 16 as u32, 15 as u32);
  let _ = buf_write_u32(pi_dest, 20 as u32, 16 as u32);
  let _ = buf_write_u32(pi_dest, 24 as u32, 1 as u32);
  let _ = buf_write_u32(pi_dest, 28 as u32, 11 as u32);
  let _ = buf_write_u32(pi_dest, 32 as u32, 21 as u32);
  let _ = buf_write_u32(pi_dest, 36 as u32, 6 as u32);
  let _ = buf_write_u32(pi_dest, 40 as u32, 7 as u32);
  let _ = buf_write_u32(pi_dest, 44 as u32, 17 as u32);
  let _ = buf_write_u32(pi_dest, 48 as u32, 2 as u32);
  let _ = buf_write_u32(pi_dest, 52 as u32, 12 as u32);
  let _ = buf_write_u32(pi_dest, 56 as u32, 22 as u32);
  let _ = buf_write_u32(pi_dest, 60 as u32, 23 as u32);
  let _ = buf_write_u32(pi_dest, 64 as u32, 8 as u32);
  let _ = buf_write_u32(pi_dest, 68 as u32, 18 as u32);
  let _ = buf_write_u32(pi_dest, 72 as u32, 3 as u32);
  let _ = buf_write_u32(pi_dest, 76 as u32, 13 as u32);
  let _ = buf_write_u32(pi_dest, 80 as u32, 14 as u32);
  let _ = buf_write_u32(pi_dest, 84 as u32, 24 as u32);
  let _ = buf_write_u32(pi_dest, 88 as u32, 9 as u32);
  let _ = buf_write_u32(pi_dest, 92 as u32, 19 as u32);
  let _ = buf_write_u32(pi_dest, 96 as u32, 4 as u32);
  return 0;
}


// Round 67: Keccak-f[1600] / SHA-3 / SHAKE (FIPS 202) -- PQC's own
// prerequisite (ML-KEM needs SHA3-256, SHA3-512, SHAKE128, SHAKE256
// throughout), a genuinely different hash family from the SHA-2
// family (sha256_hash/sha512_hash) already in this codebase --
// sponge construction over a 1600-bit permutation, not a Merkle-
// Damgard compression function.
//
// Verified via a from-scratch Python port (this exact permutation:
// theta/rho/pi/chi/iota, this exact sponge absorb/squeeze/padding)
// checked against Python's own trusted `hashlib` (SHA3-256, SHA3-512,
// SHAKE128, SHAKE256 are all standard-library, not hand-rolled or
// external) across 30 random trials with varying message and output
// lengths, before any vani code was written. The 24 round constants
// and the 25 rho-rotation/pi-permutation values (keccak_init) were
// computed programmatically from the algorithm's own definition, not
// hand-transcribed from a published table this project has no
// independent way to check -- same discipline as X25519/Ed25519's own
// constants this round.
fn keccak_read_lane(buf: mut ref i64, idx: i64) -> u64 {
  let lo: u32 = buf_read_u32(buf, (idx * 8) as u32);
  let hi: u32 = buf_read_u32(buf, (idx * 8 + 4) as u32);
  return ((hi as u64) << (32 as u64)) | (lo as u64);
}

fn keccak_write_lane(buf: mut ref i64, idx: i64, v: u64) -> i64 {
  let lo: u32 = (v & (4294967295 as u64)) as u32;
  let hi: u32 = (v >> (32 as u64)) as u32;
  let _ = buf_write_u32(buf, (idx * 8) as u32, lo);
  let _ = buf_write_u32(buf, (idx * 8 + 4) as u32, hi);
  return 0;
}

fn keccak_rotl64(x: u64, n: u64) -> u64 {
  if n == (0 as u64) {
    return x;
  }
  return (x << n) | (x >> ((64 as u64) - n));
}

// The 24-round permutation, operating in place on keccak_state.
fn keccak_permute() -> i64 {
  let state: mut ref i64 = keccak_state_get();
  let temp: mut ref i64 = keccak_temp_get();
  let c: mut ref i64 = keccak_c_get();
  let d: mut ref i64 = keccak_d_get();
  let rc: mut ref i64 = keccak_rc_get();
  let rho: mut ref i64 = keccak_rho_get();
  let pi_dest: mut ref i64 = keccak_pi_dest_get();
  let ones: u64 = wrapping_sub(0 as u64, 1 as u64);

  let rnd: i64 = 0;
  while rnd < 24 {
    // theta
    let x: i64 = 0;
    while x < 5 {
      let v0: u64 = keccak_read_lane(state, x);
      let v1: u64 = keccak_read_lane(state, x + 5);
      let v2: u64 = keccak_read_lane(state, x + 10);
      let v3: u64 = keccak_read_lane(state, x + 15);
      let v4: u64 = keccak_read_lane(state, x + 20);
      let cx: u64 = v0 ^ v1 ^ v2 ^ v3 ^ v4;
      let _ = keccak_write_lane(c, x, cx);
      x = x + 1;
    }
    x = 0;
    while x < 5 {
      let cxm1: u64 = keccak_read_lane(c, (x + 4) % 5);
      let cxp1: u64 = keccak_read_lane(c, (x + 1) % 5);
      let dx: u64 = cxm1 ^ keccak_rotl64(cxp1, 1 as u64);
      let _ = keccak_write_lane(d, x, dx);
      x = x + 1;
    }
    let idx: i64 = 0;
    while idx < 25 {
      let dx2: u64 = keccak_read_lane(d, idx % 5);
      let v: u64 = keccak_read_lane(state, idx);
      let _ = keccak_write_lane(state, idx, v ^ dx2);
      idx = idx + 1;
    }

    // rho + pi
    let i2: i64 = 0;
    while i2 < 25 {
      let amt: u32 = buf_read_u32(rho, (i2 * 4) as u32);
      let dest: u32 = buf_read_u32(pi_dest, (i2 * 4) as u32);
      let v2: u64 = keccak_read_lane(state, i2);
      let rotated: u64 = keccak_rotl64(v2, amt as u64);
      let _ = keccak_write_lane(temp, dest as i64, rotated);
      i2 = i2 + 1;
    }

    // chi (per row)
    let y: i64 = 0;
    while y < 5 {
      let row_base: i64 = 5 * y;
      let t0: u64 = keccak_read_lane(temp, row_base + 0);
      let t1: u64 = keccak_read_lane(temp, row_base + 1);
      let t2: u64 = keccak_read_lane(temp, row_base + 2);
      let t3: u64 = keccak_read_lane(temp, row_base + 3);
      let t4: u64 = keccak_read_lane(temp, row_base + 4);
      let n0: u64 = t0 ^ ((t1 ^ ones) & t2);
      let n1: u64 = t1 ^ ((t2 ^ ones) & t3);
      let n2: u64 = t2 ^ ((t3 ^ ones) & t4);
      let n3: u64 = t3 ^ ((t4 ^ ones) & t0);
      let n4: u64 = t4 ^ ((t0 ^ ones) & t1);
      let _ = keccak_write_lane(state, row_base + 0, n0);
      let _ = keccak_write_lane(state, row_base + 1, n1);
      let _ = keccak_write_lane(state, row_base + 2, n2);
      let _ = keccak_write_lane(state, row_base + 3, n3);
      let _ = keccak_write_lane(state, row_base + 4, n4);
      y = y + 1;
    }

    // iota
    let rc_val: u64 = keccak_read_lane(rc, rnd);
    let lane00: u64 = keccak_read_lane(state, 0);
    let _ = keccak_write_lane(state, 0, lane00 ^ rc_val);

    rnd = rnd + 1;
  }
  return 0;
}

// Generic sponge: hashes `input` (input_len bytes) with the given
// `rate` (bytes) and `pad_byte` (0x06 for SHA3-*, 0x1F for SHAKE*),
// squeezing `output_len` bytes into `output`. input_len is capped by
// keccak_pad_scratch's own fixed size (896 bytes -- comfortably past
// ML-KEM's own largest real caller, J's 800-byte z||ciphertext input).
fn keccak_sponge(input: mut ref i64, input_len: i64, rate: i64, pad_byte: u32, output: mut ref i64, output_len: i64) -> i64 {
  let padded: mut ref i64 = keccak_pad_scratch_get();
  let i: i64 = 0;
  while i < input_len {
    let _ = buf_write_byte(padded, i as u32, buf_read_byte(input, i as u32));
    i = i + 1;
  }
  let _ = buf_write_byte(padded, input_len as u32, pad_byte);
  let before_final: i64 = input_len + 1;
  let total_len: i64 = ((before_final + rate - 1) / rate) * rate;
  let j: i64 = before_final;
  while j < total_len {
    let _ = buf_write_byte(padded, j as u32, 0 as u32);
    j = j + 1;
  }
  let last: u32 = buf_read_byte(padded, (total_len - 1) as u32);
  let _ = buf_write_byte(padded, (total_len - 1) as u32, last | (128 as u32));

  let state: mut ref i64 = keccak_state_get();
  let zi: i64 = 0;
  while zi < 200 {
    let _ = buf_write_byte(state, zi as u32, 0 as u32);
    zi = zi + 1;
  }

  let blk: i64 = 0;
  while blk < total_len {
    let bi: i64 = 0;
    while bi < rate {
      let sv: u32 = buf_read_byte(state, bi as u32);
      let pv: u32 = buf_read_byte(padded, (blk + bi) as u32);
      let _ = buf_write_byte(state, bi as u32, sv ^ pv);
      bi = bi + 1;
    }
    let _ = keccak_permute();
    blk = blk + rate;
  }

  let produced: i64 = 0;
  while produced < output_len {
    let remaining: i64 = output_len - produced;
    let take: i64 = if remaining < rate { remaining } else { rate };
    let k: i64 = 0;
    while k < take {
      let _ = buf_write_byte(output, (produced + k) as u32, buf_read_byte(state, k as u32));
      k = k + 1;
    }
    produced = produced + take;
    if produced < output_len {
      let _ = keccak_permute();
    }
  }
  return 0;
}

fn sha3_256_hash(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  return keccak_sponge(msg, msg_len, 136, 0x06 as u32, out, 32);
}

fn sha3_512_hash(msg: mut ref i64, msg_len: i64, out: mut ref i64) -> i64 {
  return keccak_sponge(msg, msg_len, 72, 0x06 as u32, out, 64);
}

fn shake128_squeeze(msg: mut ref i64, msg_len: i64, out: mut ref i64, out_len: i64) -> i64 {
  return keccak_sponge(msg, msg_len, 168, 0x1F as u32, out, out_len);
}

fn shake256_squeeze(msg: mut ref i64, msg_len: i64, out: mut ref i64, out_len: i64) -> i64 {
  return keccak_sponge(msg, msg_len, 136, 0x1F as u32, out, out_len);
}

fn keccak_bytes_equal(a: mut ref i64, b: mut ref i64, n: i64) -> i64 {
  let i: i64 = 0;
  while i < n {
    if buf_read_byte(a, i as u32) != buf_read_byte(b, i as u32) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}


